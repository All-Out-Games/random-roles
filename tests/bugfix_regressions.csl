// Regression coverage for the paid-role movement/visual bugs fixed in July 2026.

test_ggg_transform_spam_releases_movement :: proc() {
	Test.run_admin_command("lobby");
	Test.run_admin_command("r googoo");
	Test.run_admin_command("start");
	Test.wait_seconds(6.0);

	// Before the nest is placed, Transform is slot 2. Queued actions execute one per
	// frame, reproducing the rapid enter/revert spam that used to stack movement reasons.
	Test.use_ability(2);
	Test.use_ability(2);
	Test.use_ability(2);
	Test.use_ability(2);
	Test.use_ability(2);
	Test.use_ability(2);
	Test.wait_seconds(1.0);

	Test.teleport({0, 0});
	Test.move({1, 0});
	Test.wait_seconds(1.0);
	Test.stop_moving();
	Test.assert_player_near("GGG can move after transform spam", {5, 0}, 4.5);
}
