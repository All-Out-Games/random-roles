// fake_nameplate.csl
// ============================================================================
// Reusable fake nameplate drawn in world-space UI.
// Attach Fake_Nameplate to any entity to render a name + optional chat bubble
// that visually matches the engine's built-in player nameplate.
//
// Usage:
//   np := entity.add_component(Fake_Nameplate);
//   np.display_name = "SomePlayer";
//   np.name_color = v4.{1, 1, 1, 1};
//
// Drawing (call from a Player's ao_late_update inside is_local):
//   fake_nameplate_draw_all(this);
// ============================================================================

// ── Constants (world-unit metres, matching existing world-space UI) ──────────

FNPLATE_NAME_SIZE     :: 0.22;
FNPLATE_OUTLINE_THICK :: 4;
FNPLATE_SHADOW_DY     :: -3.0;

// Height above entity origin – engine uses ~1.45 * visual_scale.
FNPLATE_Y_OFFSET :: 1.45;

// Chat bubble constants (world metres).
FNPLATE_MSG_SIZE       :: 0.22;
FNPLATE_MSG_PAD_X      :: 0.12;
FNPLATE_MSG_PAD_Y      :: 0.06;
FNPLATE_MSG_GAP        :: 0.12;
FNPLATE_MSG_WRAP_HALF  :: 2.0;
FNPLATE_MSG_DURATION   :: 6.0;

// ── Component ────────────────────────────────────────────────────────────────

Fake_Nameplate :: class : Component {
    display_name: string;
    name_color:   v4;

    // Extra Y added on top of the default offset (world metres).
    extra_y_offset: float;

    // If true the nameplate is hidden but the component stays alive.
    hidden: bool;

    // Optional chat message (set to "" to clear).
    chat_message:       string;
    chat_message_until: float;

    ao_start :: method() {
        name_color = v4.{1, 1, 1, 1};
    }
}

// ── Public helpers ───────────────────────────────────────────────────────────

fake_nameplate_show_message :: proc(np: Fake_Nameplate, message: string, duration: float = FNPLATE_MSG_DURATION) {
    if np == null return;
    np.chat_message = message;
    np.chat_message_until = get_time() + duration;
}

fake_nameplate_clear_message :: proc(np: Fake_Nameplate) {
    if np == null return;
    np.chat_message = "";
    np.chat_message_until = 0.0;
}

// ── Draw all fake nameplates (call once per frame from local player) ─────────

fake_nameplate_draw_all :: proc(viewer: Player) {
    UI.push_world_draw_context();
    defer UI.pop_draw_context();

    for np: component_iterator(Fake_Nameplate) {
        if np == null continue;
        if np.hidden continue;
        if !#alive(np.entity) continue;
        if np.display_name.count == 0 continue;

        fake_nameplate_draw_one(np, viewer);
    }
}

// ── Draw a single nameplate ──────────────────────────────────────────────────

fake_nameplate_draw_one :: proc(np: Fake_Nameplate, viewer: Player) {
    world_pos := np.entity.world_position;

    // Skip drawing if the nameplate is outside the viewer's LOS light radius
    if viewer != null {
        radii := viewer.get_local_light_radii();
        dist := length(world_pos - viewer.entity.world_position);
        if dist > radii.y return;
    }

    UI.push_z(world_pos.y - 0.0001);
    defer UI.pop_z();

    UI.begin_world_space_ui(np.entity);
    defer UI.end_world_space_ui();

    name_y := world_pos.y + FNPLATE_Y_OFFSET + np.extra_y_offset;
    name_pos := v2.{world_pos.x, name_y};

    // ── Name text ────────────────────────────────────────────────────────
    ts := UI.default_text_settings();
    ts.font = get_asset(Font_Asset, "$AO/fonts/Barlow-Black.ttf");
    ts.size = FNPLATE_NAME_SIZE;
    ts.color = np.name_color;
    ts.halign = .CENTER;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = FNPLATE_OUTLINE_THICK;
    ts.outline_color = v4.{0, 0, 0, 1};
    ts.do_drop_shadow = true;
    ts.drop_shadow_offset = v2.{0, FNPLATE_SHADOW_DY};

    name_rect := Rect{name_pos, name_pos};
    name_rect = UI.text_sync(name_rect, ts, np.display_name);

    // ── Chat bubble ──────────────────────────────────────────────────────
    now := get_time();
    if np.chat_message.count > 0 && now < np.chat_message_until {
        fnplate_draw_chat_bubble(np, name_rect);
    }
}

// ── Internals ────────────────────────────────────────────────────────────────

fnplate_draw_chat_bubble :: proc(np: Fake_Nameplate, name_rect: Rect) {
    bubble_tex := get_asset(Texture_Asset, "$AO/new/Player Chat Bubble/v2/chat_bubble.png");
    tail_tex   := get_asset(Texture_Asset, "$AO/new/Player Chat Bubble/v2/chat_bubble_tail.png");
    if bubble_tex == null || tail_tex == null return;

    msg_ts := UI.default_text_settings();
    msg_ts.font = get_asset(Font_Asset, "$AO/fonts/Barlow-Black.ttf");
    msg_ts.size = FNPLATE_MSG_SIZE;
    msg_ts.color = v4.{0, 0, 0, 1};
    msg_ts.halign = .CENTER;
    msg_ts.valign = .BOTTOM;
    msg_ts.word_wrap = true;

    text_start := name_rect.top_center_rect().grow(0, FNPLATE_MSG_WRAP_HALF, 0, FNPLATE_MSG_WRAP_HALF).offset(0, FNPLATE_MSG_GAP);
    text_rect := UI.text_sync(text_start, msg_ts, np.chat_message);

    // Background behind text.
    bg_rect := text_rect.grow(FNPLATE_MSG_PAD_Y, FNPLATE_MSG_PAD_X, FNPLATE_MSG_PAD_Y, FNPLATE_MSG_PAD_X);

    UI.push_layer_relative(-1);
    defer UI.pop_layer();
    UI.quad(bg_rect, bubble_tex, v4.{1, 1, 1, 1});

    // Tail pointing down to the name.
    tail_rect := bg_rect.bottom_center_rect().grow(0, 0.08, 0.06, 0.08);
    UI.quad(tail_rect, tail_tex, v4.{1, 1, 1, 1});
}
