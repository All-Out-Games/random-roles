import "core:ao"

// Mobile UI: push a higher scale factor on phones/tablets so HUD elements
// are readable without changing the base layout for PC players.
// Pass multiplier > 1.0 to also scale on PC (e.g. for large help panels).
RR_MOBILE_UI_SCALE_PHONE  :: 1.5;
RR_MOBILE_UI_SCALE_TABLET :: 1.2;

rr_push_mobile_ui_scale :: proc(player: Player) -> bool {
	if player == null return false;
	if player.device_kind == .PHONE {
		UI.push_scale_factor(RR_MOBILE_UI_SCALE_PHONE);
		return true;
	}
	if player.device_kind == .TABLET {
		UI.push_scale_factor(RR_MOBILE_UI_SCALE_TABLET);
		return true;
	}
	return false;
}

rr_push_mobile_ui_scale :: proc(player: Player, multiplier: float) -> bool {
	if player == null return false;
	if player.device_kind == .PHONE {
		UI.push_scale_factor(RR_MOBILE_UI_SCALE_PHONE * multiplier);
		return true;
	}
	if player.device_kind == .TABLET {
		UI.push_scale_factor(RR_MOBILE_UI_SCALE_TABLET * multiplier);
		return true;
	}
	if multiplier > 1.0 {
		UI.push_scale_factor(UI.get_current_scale_factor() * multiplier);
		return true;
	}
	return false;
}

rr_pop_mobile_ui_scale :: proc(pushed: bool) {
	if pushed {
		UI.pop_scale_factor();
	}
}

// --- Task SFX helpers (local-only to avoid double-play on host/server) ---
RR_TASK_SFX_TILE_CLICK   :: "sfx/task_click_tile.wav";
RR_TASK_SFX_KEY_PRESS    :: "sfx/ui_type_key.wav";
RR_TASK_SFX_ERROR        :: "sfx/ui_error.wav";
RR_TASK_SFX_BEEP         :: "sfx/button_beep.wav";
RR_TASK_SFX_ZAP          :: "sfx/zap.wav";
RR_TASK_SFX_LEVER        :: "sfx/pull_lever.wav";
RR_TASK_SFX_CATCH        :: "sfx/swing_net_catch.wav";

rr_task_sfx :: proc(player: Player, path: string, volume: float) {
	if player == null return;
	if !player.is_local() return;
	sfx := SFX.default_sfx_desc();
	sfx.set_position(player.entity.world_position);
	sfx.volume = volume;
	sfx.volume_perturb = 0.05;
	sfx.speed_perturb = 0.08;
	// Global SFX mix: everything at 25% volume.
	sfx.volume *= 0.25;
	sfx.volume_perturb *= 0.25;
	rr_play_sfx(path, sfx);
}

NUM_TASKS: int : 10;

// --- Task destinations (registered by Task_Interactable in `scripts/player.csl`) ---
Task_Destination_Entry :: class {
	task_id: string;
	pos: v2;
}

rr_task_destination_entries: List(Task_Destination_Entry);
rr_task_destination_version: int;

rr_register_task_destination :: proc(task_id: string, pos: v2) {
	if task_id.count == 0 {
		return;
	}

	// De-dupe: same task id + (almost) same position.
	for i: 0..rr_task_destination_entries.elements.count-1 {
		e := rr_task_destination_entries.elements[i];
		if e == null {
			continue;
		}
		if e.task_id == task_id && length_squared(e.pos - pos) < 0.0001 {
			return;
		}
	}

	entry := new(Task_Destination_Entry);
	entry.task_id = task_id;
	entry.pos = pos;
	append(ref rr_task_destination_entries, entry);
	rr_task_destination_version += 1;
}

rr_refresh_task_destinations_for_task :: proc(task: Task_Base) {
	if task == null {
		return;
	}
	if task.destinations_version == rr_task_destination_version {
		return;
	}

	task.destinations = List(v2).{};
	for i: 0..rr_task_destination_entries.elements.count-1 {
		e := rr_task_destination_entries.elements[i];
		if e == null {
			continue;
		}
		if e.task_id == task.id {
			append(ref task.destinations, e.pos);
		}
	}
	task.destinations_version = rr_task_destination_version;
}

Task_Base :: class {
	id: string;
	started: bool;
	completed: bool;
	// Incremented every time the task is (re)started. Used by task minigames to
	// detect a new attempt even though `start_attempt` isn't dynamically dispatched.
	attempt_id: int;
	destinations: List(v2);
	destinations_version: int;

	start_attempt :: proc(using this: Task_Base, player: Player) {
		if started {
			return;
		}
		attempt_id += 1;
		started = true;

		// Local-only start SFX (avoid double-play on host/server).
		if player != null && player.is_local() {
			sfx := SFX.default_sfx_desc();
			sfx.set_position(player.entity.world_position);
			sfx.volume = 0.5;
			sfx.volume_perturb = 0.05;
			sfx.speed_perturb = 0.08;
			// Global SFX mix: everything at 25% volume.
			sfx.volume *= 0.25;
			sfx.volume_perturb *= 0.25;
			rr_play_sfx("sfx/button_click.wav", sfx);
		}
	}

	complete_attempt :: proc(using this: Task_Base, player: Player, success: bool) {
		log(format_string("Task % completed: %", .{this.id, success}));
		if completed {
			return;
		}
		if success {
			completed = true;
			// Local-only completion SFX (avoid double-play on host/server).
			if player != null && player.is_local() {
				sfx := SFX.default_sfx_desc();
				sfx.set_position(player.entity.world_position);
				// Half as loud as before.
				sfx.volume = 0.425;
				sfx.volume_perturb = 0.1;
				sfx.speed_perturb = 0.05;
				// Global SFX mix: everything at 25% volume.
				sfx.volume *= 0.25;
				sfx.volume_perturb *= 0.25;
				rr_play_sfx("sfx/task_success.wav", sfx);
			}
		} else {
			player.Notify("You failed the task!");
		}
	}

	// Called when we need to forcibly close a task (e.g. voting starts, or player dies).
	// Default behavior is to allow the task to be started again later.
	cancel_attempt :: proc(using this: Task_Base, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}
		started = false;
	}
}

get_random_task_list :: proc(num_tasks: int, player: Player) -> List(Task_Base) {
	task_list: List(Task_Base);
	// Ensure our shared rng state exists/has been seeded before use.
	rr_refresh_rng_state();
	
	// Build a pool of available task indices
	available_indices: List(int);
	for i: 0..NUM_TASKS-1 {
		append(ref available_indices, i);
	}
	
	// Select 5 unique tasks (or fewer if num_tasks < 5)
	tasks_to_select := min(5, min(num_tasks, NUM_TASKS));
	for i: 0..tasks_to_select-1 {
		// Pick a random index from remaining available tasks
		random_pick := rng_range_int(ref rr_rng_state.value, 0, available_indices.elements.count-1);
		task_to_add_index := available_indices.elements[random_pick];
		
		// Remove the selected index from the pool (swap with last and pop)
		last_idx := available_indices.elements.count - 1;
		available_indices.elements[random_pick] = available_indices.elements[last_idx];
		pop(ref available_indices);
		
		switch task_to_add_index {
			case 0: {
					task := new(Task_Calibrate_Teleporter);
					task.id = "calibrate_teleporter";
					append(ref task_list, task);
				}
			case 1: {
					task := new(Task_Cypher);
					task.id = "cypher";
					append(ref task_list, task);
				}
			case 2: {
					task := new(Task_Anagram_Puzzle);
					task.id = "anagram_puzzle";
					append(ref task_list, task);
				}
			case 3: {
					task := new(Task_Reroute_Power);
					task.id = "reroute_power";
					append(ref task_list, task);
				}
			case 4: {
					task := new(Task_Guide_The_Electron);
					task.id = "guide_the_electron";
					append(ref task_list, task);
				}
			case 5: {
					task := new(Task_Signal_Sync);
					task.id = "signal_sync";
					append(ref task_list, task);
				}
			case 6: {
					task := new(Task_Build_A_Robot);
					task.id = "build_a_robot";
					append(ref task_list, task);
				}
			case 7: {
					task := new(Task_Catching_Butterflies);
					task.id = "catching_butterflies";
					append(ref task_list, task);
				}
			case 8: {
					task := new(Task_Call_Jail_Codes);
					task.id = "jail_codes";
					append(ref task_list, task);
				}
			case 9: {
					task := new(Task_Repair_Laptop);
					task.id = "repair_laptop";
					append(ref task_list, task);
				}
		}
	}
	return task_list;
}

update_tasks :: proc(player: Player) {
	// Close any in-progress task UI when leaving gameplay (meeting/voting/etc).
	// (Ghost civilians are allowed to keep doing tasks while dead.)
	if game_state != Game_State.INGAME {
		if player.is_local_or_server() {
			for i: 0..player.active_tasks.elements.count-1 {
				task := player.active_tasks.elements[i];
				if task.started && !task.completed {
					task.cancel_attempt(player);
				}
			}
		}
		return;
	}
	// Only civilians can do tasks while dead (ghost tasks).
	if player.player_state != Player_State.ALIVE && player.player_type != Player_Type.CIVILIAN {
		if player.is_local_or_server() {
			for i: 0..player.active_tasks.elements.count-1 {
				task := player.active_tasks.elements[i];
				if task.started && !task.completed {
					task.cancel_attempt(player);
				}
			}
		}
		return;
	}

	// Task UIs should render above the progress bar / task list (layer 100).
	UI.push_layer(9700);
	defer UI.pop_layer();

	i := 0;
	while i < player.active_tasks.elements.count {
		task := player.active_tasks.elements[i];
		if task == null {
			i += 1;
			continue;
		}
		//log("%", .{task.#type});
		switch task.#type {
			case Task_Calibrate_Teleporter: task.(Task_Calibrate_Teleporter).update_task(player);
			case Task_Cypher: task.(Task_Cypher).update_task(player);
			case Task_Anagram_Puzzle: task.(Task_Anagram_Puzzle).update_task(player);
			case Task_Reroute_Power: task.(Task_Reroute_Power).update_task(player);
			case Task_Guide_The_Electron: task.(Task_Guide_The_Electron).update_task(player);
			case Task_Signal_Sync: task.(Task_Signal_Sync).update_task(player);
			case Task_Build_A_Robot: task.(Task_Build_A_Robot).update_task(player);
			case Task_Catching_Butterflies: task.(Task_Catching_Butterflies).update_task(player);
			case Task_Repair_Laptop: task.(Task_Repair_Laptop).update_task(player);
			case Task_Prank_3_People: task.(Task_Prank_3_People).update_task(player);
			case Task_Call_Fake_Meeting: task.(Task_Call_Fake_Meeting).update_task(player);
			case Task_GGG_Wrap: task.(Task_GGG_Wrap).update_task(player);
			case Task_Call_Jail_Codes: task.(Task_Call_Jail_Codes).update_task(player);
			case Task_Restart_Generator: task.(Task_Restart_Generator).update_task(player);
			case Task_Enable_Communications: task.(Task_Enable_Communications).update_task(player);
		}
		i += 1;
	}
}

// Computes the total/remaining tasks for the civilian win condition.
// Counts tasks for ALL civilians (alive + dead), matching `all_civilians_completed_tasks()`.
rr_get_civilian_task_counts :: proc(total: ref int, remaining: ref int) {
	total = 0;
	remaining = 0;

	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p.player_state == Player_State.PASSIVE continue;
		if p.player_type != Player_Type.CIVILIAN continue;

		for j: 0..p.active_tasks.elements.count-1 {
			t := p.active_tasks.elements[j];
			if t == null continue;
			total += 1;
			if !t.completed {
				remaining += 1;
			}
		}
	}
}

get_task_display_name :: proc(task_id: string) -> string {
	switch task_id {
		case "calibrate_teleporter":
			return "Calibrate Teleporter";
		case "cypher":
			return "Solve the Cypher";
		case "anagram_puzzle":
			return "Restart System";
		case "reroute_power":
			return "Reroute Power";
		case "guide_the_electron":
			return "Guide the Electron";
		case "signal_sync":
			return "Sync Signals";
		case "build_a_robot":
			return "Build a Robot";
		case "catching_butterflies":
			return "Catching Butterflies";
		case "repair_laptop":
			return "Repair Laptop";
		case "prank_3_people":
			return "Prank 3 people";
		case "call_fake_meeting":
			return "Vote out target";
		case "pyro_burn_1_corpse":
			return "Burn 1 corpse";
		case HACKER_TASK_ID_HACK_TASKS:
			return "Hack tasks";
		case HACKER_TASK_ID_STEAL_IDENTITIES:
			return "Steal identities";
		case "ggg_wrap_3":
			return "Wrap 3 bodies";
		case "jail_codes":
			return "Change jail codes";
		case RR_RESTART_GENERATOR_TASK_ID:
			return "Restart Generator";
		case RR_ENABLE_COMMUNICATIONS_TASK_ID:
			return "Enable Communications";
		case WEREWOLF_INFECT_TO_CURE_TASK_ID:
			return "Infect someone";
		default:
			return task_id;
	}
}

// Standard close button for task minigames.
// Returns true if the task was closed/cancelled this frame.
draw_task_close_button :: proc(window_rect: Rect, player: Player, task: Task_Base) -> bool {
	// Size scales with the task window so it stays readable across resolutions.
	size := window_rect.height() * 0.065;
	if size < 34.0 { size = 34.0; }
	if size > 78.0 { size = 78.0; }
	pad := size * 0.45;

	anchor := window_rect.top_right_rect().offset_unscaled(-pad, -pad);
	btn := anchor.grow_unscaled(size * 0.5, size * 0.5, size * 0.5, size * 0.5);

	UI.push_id("task_close_%", .{task.id});
	defer UI.pop_id();

	bs: Button_Settings = .{};
	rr_ui_apply_button_click_sound(ref bs);
	interact := UI.button(btn, bs, .{}, "");

	close_icon := get_asset(Texture_Asset, "sprites/icons/close_icon.png");
	if close_icon != null {
		// Icon is the button (no background). Draw it big.
		icon_rect := btn.inset(max(2.0, size * 0.06));
		UI.quad(icon_rect.fit_aspect(close_icon.get_aspect()), close_icon, v4.{1, 1, 1, 1});
	} else {
		ts := UI.default_text_settings();
		ts.size = size * 0.8;
		ts.color = v4.{1, 1, 1, 1};
		ts.halign = .CENTER;
		ts.valign = .CENTER;
		ts.do_outline = true;
		ts.outline_thickness = 2;
		ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(btn, ts, "X");
	}

	if interact.clicked {
		task.cancel_attempt(player);
		return true;
	}
	return false;
}

rr_cancel_all_task_attempts :: proc(player: Player) {
	if player == null return;
	for i: 0..player.active_tasks.elements.count-1 {
		task := player.active_tasks.elements[i];
		if task == null continue;
		if task.started && !task.completed {
			task.cancel_attempt(player);
		}
	}
}

rr_ui_draw_nine_slice_panel :: proc(rect: Rect, tex: Texture_Asset, slice_px: float) {
	if tex == null return;

	bs := UI.default_button_settings();
	bs.sprite = tex;
	bs.press_scaling = 1.0;
	bs.color = v4.{1, 1, 1, 1};
	bs.hovered_color = bs.color;
	bs.pressed_color = bs.color;
	bs.disabled_color = bs.color;
	bs.background_color_multiplier = v4.{1, 1, 1, 1};
	bs.nine_slice_data.slice = v4.{slice_px, slice_px, slice_px, slice_px};
	bs.nine_slice_data.slice_scale = 1.0;

	UI.push_disabled(true);
	defer UI.pop_disabled();
	UI.begin_button(rect, bs, {}, ""); { defer UI.end_button(); }
}

rr_ui_draw_nine_slice_panel_color :: proc(rect: Rect, tex: Texture_Asset, slice_px: float, color: v4) {
	if tex == null return;

	bs := UI.default_button_settings();
	bs.sprite = tex;
	bs.press_scaling = 1.0;
	bs.color = color;
	bs.hovered_color = color;
	bs.pressed_color = color;
	bs.disabled_color = color;
	bs.background_color_multiplier = v4.{1, 1, 1, 1};
	bs.nine_slice_data.slice = v4.{slice_px, slice_px, slice_px, slice_px};
	bs.nine_slice_data.slice_scale = 1.0;

	UI.push_disabled(true);
	defer UI.pop_disabled();
	UI.begin_button(rect, bs, {}, ""); { defer UI.end_button(); }
}

rr_draw_civilian_progress_bar :: proc(player: Player) {
	if !player.is_local_or_server() return;

	// Visible during gameplay & voting, hidden in lobby and cinematics.
	if game_state == Game_State.LOBBY       return;
	if game_state == Game_State.ANIM_INTRO  return;
	if game_state == Game_State.ANIM_VOTE_EJECT  return;
	if game_state == Game_State.ANIM_JESTER_WIN  return;
	if game_state == Game_State.ANIM_PYRO_WIN    return;
	if game_state == Game_State.ANIM_VICTORY     return;

	// Mobile scale boost (no-op on PC).
	_pushed_scale := rr_push_mobile_ui_scale(player);
	defer rr_pop_mobile_ui_scale(_pushed_scale);

	// Global civilian task progress (win condition).
	total_tasks := 0;
	remaining_tasks := 0;
	rr_get_civilian_task_counts(ref total_tasks, ref remaining_tasks);

	completed_tasks := total_tasks - remaining_tasks;
	if completed_tasks < 0 { completed_tasks = 0; }

	progress01 := 0.0;
	if total_tasks > 0 {
		progress01 = (completed_tasks.(float)) / (total_tasks.(float));
	}
	progress01 = clamp(progress01, 0.0, 1.0);
	progress_pct := (progress01 * 100.0).(int);

	player_total_tasks := player.active_tasks.elements.count;

	// Layout – centered at top of screen.
	PROGRESS_W :: 380.0;
	PROGRESS_H :: 40.0;
	PROGRESS_SLICE_PX :: 18.0;
	TOP_MARGIN :: 35.0;

	screen := UI.get_safe_screen_rect();
	progress_rect := screen.top_rect().center_rect().offset(0.0, -TOP_MARGIN).grow(0.0, PROGRESS_W * 0.5, PROGRESS_H, PROGRESS_W * 0.5);

	UI.push_layer(100);
	defer UI.pop_layer();

	progress_back := get_asset(Texture_Asset, "ui/task list/task_progress_back.png");
	progress_fill := get_asset(Texture_Asset, "ui/task list/task_progress_fill.png");
	progress_segment := get_asset(Texture_Asset, "ui/task list/task_progress_segment.png");

	// Progress bar background
	rr_ui_draw_nine_slice_panel(progress_rect, progress_back, PROGRESS_SLICE_PX);

	fill_rect := progress_rect.inset(3.0, 3.0, 3.0, 3.0);
	if progress01 > 0.0 {
		fill_subrect := fill_rect.subrect(0.0, 0.0, progress01, 1.0);
		UI.quad(fill_subrect, progress_fill, v4.{1, 1, 1, 1});
	}

	if player_total_tasks > 1 {
		seg_w := max(2.0, fill_rect.height() * (8.0 / 96.0));
		for s: 1..player_total_tasks-1 {
			segment_t := (s.(float)) / (player_total_tasks.(float));
			if progress01 >= segment_t {
				x := lerp(fill_rect.min.x, fill_rect.max.x, segment_t);
				seg_rect := Rect{v2.{x - (seg_w * 0.5), fill_rect.min.y}, v2.{x + (seg_w * 0.5), fill_rect.max.y}};
				UI.quad(seg_rect, progress_segment, v4.{1, 1, 1, 1});
			}
		}
	}

	// "TOTAL PROGRESS" label – top center, above the bar
	label_ts := UI.default_text_settings();
	label_ts.size = 26;
	label_ts.spacing_multiplier = 1.1;
	label_ts.color = v4.{1, 1, 1, 1};
	label_ts.halign = .CENTER;
	label_ts.valign = .BOTTOM;
	label_ts.do_outline = true;
	label_ts.outline_thickness = 6;
	label_ts.outline_color = v4.{0, 0, 0, 1};
	label_ts.do_autofit = true;
	label_ts.autofit_min_size = 14;
	label_ts.autofit_max_size = 26;
	label_rect := progress_rect.top_rect().offset(0.0, -12.0).grow(24, 0, 0, 0);
	UI.text(label_rect, label_ts, "TOTAL PROGRESS");

	// Percentage – bottom center, below the bar
	pct_ts := UI.default_text_settings();
	pct_ts.size = 24;
	pct_ts.color = v4.{1, 1, 1, 1};
	pct_ts.halign = .CENTER;
	pct_ts.valign = .TOP;
	pct_ts.do_outline = true;
	pct_ts.outline_thickness = 6;
	pct_ts.outline_color = v4.{0, 0, 0, 1};
	pct_ts.do_autofit = true;
	pct_ts.autofit_min_size = 14;
	pct_ts.autofit_max_size = 24;
	pct_rect := progress_rect.bottom_rect().offset(0.0, 0.0).grow(0, 0, 20, 0);
	UI.text(pct_rect, pct_ts, format_string("%0%%", .{progress_pct}));
}

// Shared header for all task-list-style panels (tasks, sabotage, role ability panels).
// Draws the task_backing image and label text. Returns the header rect.
// Callers position the list below using: header_rect.bottom_left_rect().grow(0.0, PANEL_W, list_h, 0.0).
rr_draw_task_list_header :: proc(screen: Rect, is_sabotage: bool, player: Player) -> Rect {
	PANEL_W :: 320.0;
	HEADER_H :: 46.0;
	EXTRA_LEFT :: 0.0;

	header_bg := get_asset(Texture_Asset, "ui/task list/task_backing.png");

	// Anchor: top-left of safe screen, offset down when chat is open.
	chat_offset := 0.0;
	if player != null && player.is_chat_open() {
		chat_offset = player.get_chat_rect().height();
	}
	anchor := screen.top_left_rect().offset(0.0, -30.0).offset_unscaled(0.0, -chat_offset);

	// Keep a small visual bleed to the left, but anchor all layout to an on-screen rect.
	header_draw_rect := anchor.grow(0.0, PANEL_W, HEADER_H, EXTRA_LEFT);
	header_draw_rect = header_draw_rect.fit_aspect(header_bg.get_aspect(), .KEEP_WIDTH);
	UI.quad(header_draw_rect, header_bg);
	header_rect := header_draw_rect;
	header_rect.cut_left(EXTRA_LEFT);

	// Text content (pushed right of the extra-left bleed).
	header_content := header_rect.inset(4, 4, 4, 4);

	ts := UI.default_text_settings();
	ts.size = 24;
	ts.halign = .LEFT;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 2;
	ts.outline_color = v4.{0, 0, 0, 1};
	ts.do_autofit = true;
	ts.autofit_min_size = 14;
	ts.autofit_max_size = 24;

	if is_sabotage {
		ts.color = v4.{1, 0.3, 0.3, 1};
		sabotage_content := header_content;
		sabotage_content.cut_left(70.0);
		UI.text(sabotage_content, ts, "SABOTAGE");
	} else {
		// Role name in all caps, colored by team.
		role_name := "CREW";
		role_icon: Texture_Asset;
		if player != null {
			switch player.player_role {
				case .NONE:         role_name = "CREW";
				case .SHERIFF:      { role_name = "SHERIFF";      role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/sheriff_icon.png"); }
				case .DOCTOR:       { role_name = "DOCTOR";       role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/doctor_icon.png"); }
				case .PRESIDENT:    { role_name = "PRESIDENT";    role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/president_icon.png"); }
				case .MOVIE_STAR:   { role_name = "MOVIE STAR";   role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/moviestar_icon.png"); }
				case .CORONER:      { role_name = "CORONER";      role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/coroner_icon.png"); }
				case .PORTAL_MAKER: { role_name = "WARPER";       role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/portalmaker_icon.png"); }
				case .PRANKSTER:    { role_name = "PRANKSTER";    role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/trickster_icon.png"); }
				case .PYROMANIAC:   { role_name = "PYROMANIAC";   role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/pyromaniac_icon.png"); }
				case .HACKER:       { role_name = "HACKER";       role_icon = get_asset(Texture_Asset, "sprites/icons/hacker/game_end.png"); }
				case .PIRATE:       { role_name = "PIRATE";       role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/pirate_icon.png"); }
				case .HITMAN:       { role_name = "HITMAN";       role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/hitman_icon.png"); }
				case .WEREWOLF:     { role_name = "WEREWOLF";     role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/werewolf_icon.png"); }
				case .GOO_GOO_GAGA: { role_name = "GOOGOO GAGA"; role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/goo_goo_icon.png"); }
				case .MIMICER:      { role_name = "MIMICER";     role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/mimicer_icon.png"); }
				case .BIG_CHARLIE:  { role_name = "BIG CHARLIE"; role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/charlie_icon (1).png"); }
				case .LILY_LOVEBRAIDS: { role_name = "LILY"; role_icon = get_asset(Texture_Asset, "sprites/icons/roles_small/lily_icon (1).png"); }
			}
		}

		role_color := v4.{0.1, 1.0, 0.3, 1.0};
		if player != null {
			if player.player_type == Player_Type.TRAITOR {
				role_color = v4.{0.9, 0.2, 0.2, 1.0};
			} else if player.player_type == Player_Type.ANARCHIST {
				role_color = v4.{0.9, 0.6, 0.1, 1.0};
			}
		}

		// Role icon to the left of the text (slightly bigger than the header).
		text_start := header_content;
		if role_icon != null {
			ICON_SIZE :: 32.0;
			ICON_OFFSET :: ICON_SIZE + 5.0;
			text_start.cut_left(ICON_OFFSET * 2);
			icon_rect := header_rect.left_rect().center_rect().offset(ICON_OFFSET, 0.0).grow(ICON_SIZE);
			UI.quad(icon_rect.fit_aspect(role_icon.get_aspect()), role_icon, v4.{1, 1, 1, 1});
		}

		ts.color = role_color;
		role_actual := UI.text_sync(text_start, ts, role_name);
		tasks_rect := text_start.offset_unscaled(role_actual.width() + 5.0, 0.0);
		ts.color = v4.{1, 1, 1, 1};
		UI.text(tasks_rect, ts, "Tasks");
	}

	// Dropdown arrow on the right side of the header (shifted left to make room for ? button).
	if player != null {
		arrow_tex := get_asset(Texture_Asset, "ui/task list/dropdown_arrow.png");
		if arrow_tex != null {
			ARROW_HALF :: 10.0;
			arrow_rect := header_rect.right_rect().center_rect().offset(-22.0, 0.0).grow(ARROW_HALF);
			arrow_rect = arrow_rect.fit_aspect(arrow_tex.get_aspect());

			// Rotate arrow: down when closed, up when open.
			if player.task_list_open {
				UI.push_matrix(Matrix4.rotate_about_point(arrow_rect.center(), 180.0));
				defer UI.pop_matrix();
			}
			UI.quad(arrow_rect, arrow_tex, v4.{1, 1, 1, 1});
		}

		// Clickable overlay on the entire header for toggling.
		UI.push_id("task_list_dropdown");
		defer UI.pop_id();

		toggle_bs := UI.default_button_settings();
		toggle_bs.sprite = core_globals.white_sprite;
		toggle_bs.press_scaling = 1.0;
		toggle_bs.color = v4.{0, 0, 0, 0};
		toggle_bs.hovered_color = v4.{0, 0, 0, 0};
		toggle_bs.pressed_color = v4.{0, 0, 0, 0};
		toggle_bs.disabled_color = v4.{0, 0, 0, 0};
		toggle_bs.background_color_multiplier = v4.{0, 0, 0, 0};

		toggle_result := UI.begin_button(header_rect, toggle_bs, {}, ""); {
			defer UI.end_button();
		}
		if toggle_result.clicked {
			player.task_list_open = !player.task_list_open;
		}

		// ? button at top-right corner — drawn after the toggle so it captures clicks on top.
		HELP_BTN_HALF :: 16.0;
		help_btn_rect := header_rect.top_right_rect().offset(0, -5.0).grow(HELP_BTN_HALF);

		UI.push_id("task_help_btn");
		defer UI.pop_id();

		help_bs := UI.default_button_settings();
		help_bs.sprite = get_asset(Texture_Asset, "ui/info_icon_b.png");
		help_bs.press_scaling = 0.35;
		help_bs.color = v4.{1, 1, 1, 1};
		help_bs.hovered_color = v4.{0.85, 0.85, 0.85, 1};
		help_bs.pressed_color = v4.{0.65, 0.65, 0.65, 1};

		help_ts := UI.default_text_settings();
		
		if UI.button(help_btn_rect, help_bs, UI.default_text_settings(), "").clicked {
			player.task_help_open = !player.task_help_open;
		}
	}

	return header_rect;
}

rr_role_has_abilities :: proc(role: Player_Role, ptype: Player_Type) -> bool {
	if ptype == Player_Type.TRAITOR return true;
	switch role {
		case .SHERIFF:      return true;
		case .DOCTOR:       return true;
		case .MOVIE_STAR:   return true;
		case .CORONER:      return true;
		case .PORTAL_MAKER: return true;
		case .PRANKSTER:    return true;
		case .PYROMANIAC:   return true;
		case .HACKER:       return true;
		case .BIG_CHARLIE:  return true;
		case .PIRATE:       return true;
		case .HITMAN:       return true;
		case .WEREWOLF:     return true;
		case .MIMICER:      return true;
	}
	return false;
}

rr_get_role_description :: proc(role: Player_Role, ptype: Player_Type) -> string {
	if ptype == Player_Type.TRAITOR {
		switch role {
			case .PIRATE:   return "A swashbuckling traitor. Get treasure maps from dead bodies. Dig for buried treasure to unlock new abilities.";
			case .HITMAN:   return "A cold and calculating assassin. Silently snap necks up close. Rack up kills to unlock proximity mines and a long-range sniper rifle.";
			case .WEREWOLF: return "A shape-shifting beast hiding among civilians. Switch between schleem and wolf form. Devour victims as a wolf or drag bodies as a schleem. Earn kills to unlock Infect and Claw.";
			case .GOO_GOO_GAGA: return "A horrifying creature hiding in plain sight. Transform into a monster and wrap dead bodies in tinfoil to unlock powerful abilities. Crawl through vents, lay chocolate traps, and summon decoy swarms.";
			case .MIMICER: return "A shape-shifting predator. Kill civilians and corrupt their corpses at Void Pillars to steal faces. Each stolen face unlocks new powers — Void Lunge, Spew Corruption, and the devastating Unleash.";
			case .BIG_CHARLIE: return "A growing horror. Each kill grants Flesh Mass and spawns a Lil' Nugget. Unlock Slough, Marrow, and Stampede as you grow, then scout through Nuggets like living cameras while your body stands vulnerable.";
			case .LILY_LOVEBRAIDS: return "A predatory weaver. String civilians to track them, then plant your Hair Tree as your permanent base. Feed the tree its requested offerings (corpses, eyes, legs, strung victims) to grow it and unlock stronger abilities — Tea Party, Mind Control, and the ultimate Deathbraid.";
		}
		return "You are a traitor. Sabotage the station, eliminate the civilians, and avoid suspicion. Work with fellow traitors to win.";
	}
	if ptype == Player_Type.ANARCHIST {
		switch role {
			case .PRANKSTER: return "A chaotic wild card. Prank other schleems, call fake emergency meetings and get someone voted it, and when enough chaos is caused, unlock the Jester Win to win!";
			case .PYROMANIAC: return "A fire-obsessed anarchist. Set rooms ablaze and ignite corpses to destroy evidence. Burn enough of the station to unlock World Fire and engulf everything in flames.";
			case .HACKER: return "A sabotage specialist. Trap task stations, steal civilian powers from corpses, cancel emergency councils, and complete the checklist to fire Game Hack.";
			case .BIG_CHARLIE: return "A solo horror. Transform into Big Charlie, birth range-limited Lil' Nuggets, cocoon victims to infect them, then complete the checklist and fire Mass Birth to win.";
		}
		return "You are an anarchist. You win alone by completing your unique objective.";
	}
	switch role {
		case .SHERIFF:      return "The station's law enforcer. You carry a gun and can shoot suspected traitors. Be careful - shooting an innocent civilian has consequences.";
		case .DOCTOR:       return "The civilians' medic. You can resurrect fallen civilians, bringing them back into the game. Use your power wisely to turn the tide.";
		case .PRESIDENT:    return "A high-value civilian. Your votes are worth double, use it to outplay traitors.";
		case .MOVIE_STAR:   return "A beloved celebrity among the civilians. Hand out autographs to other players. Your fame makes you a memorable figure in discussions.";
		case .CORONER:      return "The station's forensic investigator. Collect DNA samples from dead bodies and match them against living players to identify the killers.";
		case .PORTAL_MAKER: return "A spatial engineer who bends space. Place a red portal and a blue portal anywhere on the station. Players who enter one exit through the other.";
	}
	return "You are a civilian. Complete your tasks and work with civilians to identify and vote out the traitors.";
}

Help_Ability_Entry :: struct {
	icon_path: string;
	entry_name: string;
	description: string;
}

rr_get_role_ability_entries :: proc(role: Player_Role, ptype: Player_Type, results: ref [..]Help_Ability_Entry) {
	if ptype == Player_Type.TRAITOR {
		append(ref results, Help_Ability_Entry.{"sprites/icons/kill_ability.png", "Kill", "Eliminate a nearby civilian."});
		append(ref results, Help_Ability_Entry.{"sprites/icons/drag_body_icon.png", "Drag", "Drag a dead body to hide the evidence."});

		switch role {
			case .PIRATE: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/pirate/black_flag.png", "Black Flag", "Plant a flag that blinds nearby enemies with fog."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/pirate/dig_for_treasure.png", "Treasure Map", "Loot a treasure map from a nearby body to reveal a dig spot."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/pirate/flintlock_pistol.png", "Shoot", "Unlocked with treasure. Fire your pistol at range."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/pirate/powder_keg.png", "Powder Keg", "Unlocked with treasure. Place an explosive barrel that detonates after a delay."});
			}
			case .HITMAN: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/hitman/knee_snap.png", "Neck Snap", "Silently eliminate a nearby target. Replaces the default kill."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/hitman/land_mine.png", "Mine", "Unlocked after kills. Place a hidden proximity mine."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/hitman/sniper_rifle.png", "Sniper", "Unlocked after kills. Aim and fire a long-range shot."});
			}
			case .WEREWOLF: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/transform_evil.png", "Transform", "Switch between schleem and wolf form."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/werewolf/devour.png", "Devour", "Wolf form. Consume a nearby body, destroying it completely."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/werewolf/infecting_bite.png", "Infect", "Unlocked after kills. Bite a player to turn them into a mini-werewolf."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/werewolf/claw_slash.png", "Claw", "Unlocked after kills. Wolf form only. Slash at range."});
			}
			case .GOO_GOO_GAGA: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/ggg/Nest_icon.png", "Place Nest", "Place your nest on the map via minimap. Drag bodies to it for nest points."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/transform_evil.png", "Transform", "Free toggle between schleem and creature form. Creature form is faster."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/ggg/kill_wrap_player.png", "Kill", "Both forms. Kills auto-wrap victims. Creature form has extended lunge range."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/ggg/santa_trap.png", "Trap", "Human form. Place a chocolate trap that roots + blinds civilians. Drag them alive to nest for 3 points!"});
				append(ref results, Help_Ability_Entry.{"sprites/icons/ggg/crawl_speedup.png", "Crawl", "1 nest point. Creature form. Shrink and scuttle fast. Boosted during power outage."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/ggg/kill_wrap_player.png", "Foil Whip", "3 nest points. Creature form. Fire a whip that pulls targets to you."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/ggg/swarm.png", "Swarm", "5 nest points. Creature form. Crawlers erupt from nest and root civilians."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/power_outage.png", "Passives", "Hive Mind: +2%% speed per nest point. Night Crawler: boosted crawl in darkness. Radio Hijack: goo goo ga ga during comms sabotage."});
			}
			case .MIMICER: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/transform_evil.png", "Transform", "Toggle between schleem and monster form. Monster form grants 115%% move speed."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/mimicer/prowl.png", "Prowl", "Toggle stealth mode. Move slower, but become near-invisible when close to walls."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/mimicer/kill_purple_slash.png", "Kill", "Eliminate a nearby civilian. Corrupt their corpse at a Void Pillar to steal their face."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/mimicer/void_lunge.png", "Void Lunge", "Unlocked at 1 Stolen Face. Dash forward in monster form and stun players you hit."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/mimicer/mimic.png", "Mimic", "Interact with a Void Pillar to disguise as the stored victim."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/mimicer/spew_corruption.png", "Spew Corruption", "Unlocked at 3 Stolen Faces. Blind and root a nearby target for 10 seconds."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/mimicer/unleash_ultimate.png", "Unleash", "Unlocked at 5 Stolen Faces. One-time ultimate. Place 3 Dark Flame Pillars, then enter ultimate form with a jumpscare scream. Consume pillars to reset all cooldowns. Unlocks Remote Mimic afterwards."});
			}
			case .BIG_CHARLIE: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/abilities/Bone_Snap_Icon.png", "Bone Snap", "Grab and twist a nearby target. Kills grant 1 Flesh Mass and spawn a Lil' Nugget as evidence. 25s cooldown."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/Big_Charlie.png", "Transform", "Toggle between schleem and Big Charlie form. Big Charlie grows larger with each Flesh Mass."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/Lil_Nugget.png", "Scouting", "View through any active Nugget like a security camera. You are frozen and vulnerable while scouting."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/abilities/Slough_Icon.png", "Slough", "1 Flesh Mass. Absorb a nearby Nugget for a speed burst and knockback explosion."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/abilities/Marrow_Icon.png", "Marrow", "2 Flesh Mass. Encase a corpse in a fleshy nest. Blocks investigation, spawns bonus Nuggets, and can be reversed early by Doctor."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/abilities/Stampede_Icon.png", "Stampede", "3 Flesh Mass. All Nuggets charge toward you, trampling players. Absorbed Nuggets trigger a brief Rampage with better kill range and cooldown."});
			}
			case .LILY_LOVEBRAIDS: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/transform_evil.png", "Transform", "Toggle between schleem and Lily form. Lily form moves faster."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/Standard_Kill_Icon.png", "Kill", "Eliminate a nearby civilian."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/String_Icon.png", "String", "Attach a string to a player to track them and fulfill tree requests with them."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/Hair_Tree_Icon.png", "Plant Tree", "One-time. Plant your Hair Tree — your permanent base. Fulfill its requests to grow it and unlock new powers."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/Hair_Tree_Icon.png", "Tree Requests", "Offer in order: Corpse, Eyes, Legs, Alive Player, Legs & Eyes. Each grows the tree and buffs you."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/Braid_Trap_Icon.png", "String Trap", "1 request. Lay a trap — players who walk over it get strung and can be dragged to the tree alive."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/Suction_Tube_Icon.png", "Steal Eyes", "Deploy a machine that temporarily extracts a target's eyes. Pick up the dropped eyes to offer them to the tree."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/Braid_Point_Icon.png", "Steal Legs", "Send a spider to temporarily chomp a target's legs. Pick up the dropped legs to offer them to the tree."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/Dollhouse_Icon.png", "Mind Control", "3 requests. Possess a player and puppet their body. Release to return."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/Tea_Party_Icon.png", "Tea Party", "4 requests. Invite a strung player to tea. They pick 1 of 3 cups — caffeine, poison, or empty."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/lily/Hair_Tree_Icon.png", "Deathbraid", "6 requests. Summon a vortex that pulls in and devours every living player. Ultimate win button."});
			}
		}





		return;
	}

	if ptype == Player_Type.ANARCHIST {
		switch role {
			case .PRANKSTER: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/trickster/prank.png", "Prank", "Prank other players to make them fall!"});
				append(ref results, Help_Ability_Entry.{"sprites/icons/trickster/call_fake.png", "Fake Meeting", "Call a fake emergency meeting, get someone voted out!"});
				append(ref results, Help_Ability_Entry.{"sprites/icons/trickster/jester.png", "Jester Win", "Unlocked after enough chaos. Prank everyone!"});
			}
			case .PYROMANIAC: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/pyro/set_fire.png", "Light Fire", "Set fire to objects in rooms in your task list to put the room on fire."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/pyro/light_corpse.png", "Light Corpse", "Ignite a nearby dead body to destroy evidence."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/pyro/worldfire.png", "World Fire", "Unlocked after burning enough. Engulf the station in flames to win."});
			}
			case .HACKER: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/hacker/hack_task.png", "Hack Task", "Trap a nearby task. The next player to use it is electrocuted and stunned."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/coroner/ability_take_dna.png", "Identity Theft", "Hack a civilian corpse to steal that role's powers."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/communication_outage_icon.png", "Cancel Meeting", "End an emergency council immediately."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/hacker/game_end.png", "Game Hack", "Unlocked after your checklist. Pull everyone to you and win."});
			}
			case .BIG_CHARLIE: {
				append(ref results, Help_Ability_Entry.{"sprites/icons/transform_evil.png", "Transform", "Toggle between schleem and Big Charlie form. Big Charlie form is faster and births Nuggets."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/Lil_Nugget.png", "Birth Nugget", "Big Charlie form. Plant a Lil' Nugget. Non-traitors only see Nuggets when close and can smush them with a 3s interaction."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/Lil_Nugget.png", "Scouting", "Schleem form. View through any active Nugget like a security camera. You are frozen and vulnerable while scouting."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/abilities/Slough_Icon.png", "Flesh Cocoon", "Big Charlie form. Cocoon a nearby victim, then incubate the cocoon with a planted Nugget to infect them."});
				append(ref results, Help_Ability_Entry.{"sprites/icons/big_charlie/abilities/Stampede_Icon.png", "Mass Birth", "Unlocked when you have planted 5 Nuggets and infected 3 players. Use it in Big Charlie form to win."});
			}
		}
		return;
	}

	switch role {
		case .SHERIFF: {
			append(ref results, Help_Ability_Entry.{"sprites/icons/revolver.png", "Shoot", "Fire your gun at a target. Friendly fire has consequences."});
		}
		case .DOCTOR: {
			append(ref results, Help_Ability_Entry.{"sprites/icons/doctor/revive.png", "Resurrect", "Revive a fallen civilian, bringing them back to life."});
		}
		case .MOVIE_STAR: {
			append(ref results, Help_Ability_Entry.{"sprites/icons/movie_star/write_signature.png", "Autograph", "Sign an autograph on the ground that stuns players who walk over it."});
		}
		case .CORONER: {
			append(ref results, Help_Ability_Entry.{"sprites/icons/coroner/ability_take_dna.png", "DNA Sample", "Collect a DNA sample from a dead body."});
			append(ref results, Help_Ability_Entry.{"sprites/icons/coroner/ability_compare_dna.png", "DNA Match", "Compare collected DNA against a living player."});
		}
		case .PORTAL_MAKER: {
			append(ref results, Help_Ability_Entry.{"sprites/icons/portal_maker/red_portal.png", "Red Portal", "Shoot a bolt to place the red end of your portal."});
			append(ref results, Help_Ability_Entry.{"sprites/icons/portal_maker/blue_portal.png", "Blue Portal", "Shoot a bolt to place the blue end of your portal."});
		}
	}
}

rr_get_role_difficulty :: proc(role: Player_Role, ptype: Player_Type) -> int {
	if ptype == Player_Type.TRAITOR {
		switch role {
			case .PIRATE:   return 2;
			case .HITMAN:   return 3;
			case .WEREWOLF: return 2;
			case .GOO_GOO_GAGA: return 3;
			case .MIMICER:      return 3;
			case .LILY_LOVEBRAIDS: return 3;
		}
		return 2;
	}
	if ptype == Player_Type.ANARCHIST {
		switch role {
			case .PRANKSTER:   return 3;
			case .PYROMANIAC:  return 3;
			case .HACKER:      return 3;
			case .BIG_CHARLIE: return 3;
		}
		return 2;
	}
	switch role {
		case .SHERIFF:      return 2;
		case .DOCTOR:       return 2;
		case .PRESIDENT:    return 1;
		case .MOVIE_STAR:   return 1;
		case .CORONER:      return 3;
		case .PORTAL_MAKER: return 2;
	}
	return 1;
}

rr_draw_help_entry_list :: proc(area: Rect, scroll_id: string, entries: ref [..]Help_Ability_Entry) {
	scroll_area := area;
	scroll_bar_area := scroll_area.cut_right(6).inset(2);

	settings: Scroll_View_Settings;
	settings.vertical = true;
	settings.horizontal = false;
	settings.clip_padding = v4.{6, 6, 6, 6};

	sv := UI.push_scroll_view(scroll_area, scroll_id, settings); {
		defer UI.pop_scroll_view();

		sc := sv.content_rect;
		ROW_MIN_H :: 55.0;
		ICON_SIZE :: 32.0;
		ROW_GAP :: 15.0;
		NAME_H :: 26.0;
		ROW_INSET_TOP :: 6.0;
		ROW_INSET_BOTTOM :: 6.0;
		ROW_INSET_SIDE :: 8.0;
		ICON_SLOT_W :: ICON_SIZE * 2.0 + 8.0;

		name_ts := UI.default_text_settings();
		name_ts.size = 30;
		name_ts.color = v4.{1, 1, 1, 1};
		name_ts.halign = .LEFT;
		name_ts.valign = .TOP;
		name_ts.do_outline = true;
		name_ts.outline_thickness = 2;
		name_ts.outline_color = v4.{0, 0, 0, 1};

		desc_ts := UI.default_text_settings();
		desc_ts.size = 22;
		desc_ts.color = v4.{0.8, 0.8, 0.85, 0.85};
		desc_ts.halign = .LEFT;
		desc_ts.valign = .TOP;
		desc_ts.word_wrap = true;
		desc_ts.do_outline = true;
		desc_ts.outline_thickness = 2;
		desc_ts.outline_color = v4.{0, 0, 0, 1};

		for i: 0..entries.count-1 {
			entry := entries[i];

			UI.push_id("help_row_%", {i});
			defer UI.pop_id();

			// Measure the description so each row is tall enough for its text;
			// otherwise long descriptions overflow into the next row.
			has_icon := entry.icon_path.count > 0;
			text_left_pad := ROW_INSET_SIDE;
			if has_icon text_left_pad += ICON_SLOT_W;
			desc_avail_w := sc.width() - text_left_pad - ROW_INSET_SIDE;
			measure_rect := Rect.{ v2.{0, 0}, v2.{desc_avail_w, 10000} };
			desc_h := UI.measure_text(measure_rect, desc_ts, entry.description).height();

			row_h := ROW_INSET_TOP + NAME_H + desc_h + ROW_INSET_BOTTOM;
			if row_h < ROW_MIN_H row_h = ROW_MIN_H;

			row := sc.cut_top(row_h);
			if i < entries.count - 1 {
				sc.cut_top(ROW_GAP);
			}

			row_content := row.inset(ROW_INSET_TOP, ROW_INSET_SIDE, ROW_INSET_BOTTOM, ROW_INSET_SIDE);

			if has_icon {
				icon_slot := row_content.cut_left(ICON_SLOT_W);
				icon_tex := get_asset(Texture_Asset, entry.icon_path);
				if icon_tex != null {
					icon_rect := icon_slot.center_rect().grow(ICON_SIZE);
					UI.quad(icon_rect.fit_aspect(icon_tex.get_aspect()), icon_tex, v4.{1, 1, 1, 1});
				}
			}

			name_row := row_content.cut_top(NAME_H);
			UI.text(name_row, name_ts, entry.entry_name);

			UI.text(row_content, desc_ts, entry.description);
		}
	}

	scroll_bar_rect := sv.compute_scroll_bar_rect(scroll_bar_area);
	UI.quad(scroll_bar_area, core_globals.white_sprite, v4.{0.1, 0.1, 0.1, 0.4});
	UI.quad(scroll_bar_rect, core_globals.white_sprite, v4.{0.4, 0.4, 0.4, 0.6});
}

rr_draw_role_help_panel :: proc(player: Player) {
	if player == null return;
	if !player.task_help_open return;

	UI.push_layer(500);
	defer UI.pop_layer();

	_pushed_scale := rr_push_mobile_ui_scale(player,1.5);
	defer rr_pop_mobile_ui_scale(_pushed_scale);

	full_screen := UI.get_screen_rect();
	UI.quad(full_screen, core_globals.white_sprite, v4.{0, 0, 0, 0.72});

	PANEL_W := full_screen.width() * 0.6;
	PANEL_H := full_screen.height() * 0.75;
	HELP_SLICE_PX :: 16.0;

	help_bg := get_asset(Texture_Asset, "ui/task list/task_help_backing.png");
	safe := UI.get_safe_screen_rect();
	panel_rect := safe.center_rect().grow_unscaled(PANEL_H * 0.5, PANEL_W * 0.5, PANEL_H * 0.5, PANEL_W * 0.5);

	rr_ui_draw_nine_slice_panel_color(panel_rect, help_bg, HELP_SLICE_PX, v4.{1, 1, 1, 0.95});

	UI.push_id("help_close_btn");
	defer UI.pop_id();

	CLOSE_HALF :: 22.0;
	CLOSE_PAD :: 10.0;
	close_btn_rect := panel_rect.top_right_rect().offset(-CLOSE_PAD, -CLOSE_PAD).grow(CLOSE_HALF);

	close_bs := UI.default_button_settings();
	close_bs.sprite = get_asset(Texture_Asset, "sprites/icons/close_icon.png");
	close_bs.press_scaling = 0.35;
	close_bs.color = v4.{1, 1, 1, 0.8};
	close_bs.hovered_color = v4.{1, 1, 1, 1};
	close_bs.pressed_color = v4.{0.6, 0.6, 0.6, 1};

	if UI.button(close_btn_rect, close_bs, UI.default_text_settings(), "").clicked {
		player.task_help_open = false;
	}

	content := panel_rect.inset(20, 24, 20, 24);

	has_abilities := rr_role_has_abilities(player.player_role, player.player_type);

	// --- Resolve role icon (shown in header on both pages) ---
	role_icon := spin_role_to_icon(player.player_role);

	// --- Tab sprite path by player type (same sprite for active/inactive, darker tint when inactive) ---
	tab_path := "$AO/ui/kit/Modal Augments/modal_tabs/tabs_green/tab_trapezoid.png";
	if player.player_type == Player_Type.ANARCHIST {
		tab_path = "$AO/ui/kit/Modal Augments/modal_tabs/tabs_orange/tab_trapezoid.png";
	} else if player.player_type == Player_Type.TRAITOR {
		tab_path = "$AO/ui/kit/Modal Augments/modal_tabs/tabs_red/tab_trapezoid.png";
	}

	// --- Header: bigger icon centered, tabs flanking ---
	ICON_HALF :: 56.0;
	HEADER_H :: 70.0;
	TAB_W :: 150.0;

	header_strip := content.cut_top(HEADER_H);
	content.cut_top(12.0);

	header_width := header_strip.width() * 0.90;

	left_side  := header_strip.cut_left_unscaled(header_width * 0.5);
	right_side := header_strip.cut_right_unscaled(header_width * 0.5);

	if role_icon != null {
		// offset = content inset-top (20) + HEADER_H/2 (31) = 51 → icon center at panel top edge = half out
		star_gold  := get_asset(Texture_Asset, "ui/star_gold 2.png");
		star_empty := get_asset(Texture_Asset, "ui/star_empty2 2.png");
		difficulty := rr_get_role_difficulty(player.player_role, player.player_type);
		STAR_HALF :: 14.0;
		STAR_GAP  :: 6.0;
		stars_anchor := header_strip.bottom_rect().offset(0, STAR_HALF + 4.0);
		for i: 0..2 {
			offset_x := (i.(float) - 1.0) * (STAR_HALF * 2.0 + STAR_GAP);
			star_rect := stars_anchor.offset(offset_x, 0).grow(STAR_HALF);
			star_tex := star_empty;
			if i < difficulty { star_tex = star_gold; }
			if star_tex != null {
				UI.quad(star_rect.fit_aspect(star_tex.get_aspect()), star_tex, v4.{1, 1, 1, 1});
			}
		}
		icon_rect := header_strip.center_rect().offset(0, 51.0).grow(ICON_HALF);
		UI.quad(icon_rect.fit_aspect(role_icon.get_aspect(), .KEEP_HEIGHT), role_icon, v4.{1, 1, 1, 1});
		if player.player_role != Player_Role.NONE {
			name_rect := Rect.{
				v2.{icon_rect.min.x - 40.0, icon_rect.min.y + 6.0},
				v2.{icon_rect.max.x + 40.0, icon_rect.min.y + 34.0}
			};
			name_ts := UI.default_text_settings();
			name_ts.size = 28;
			name_ts.color = get_type_color(player.player_type);
			name_ts.halign = .CENTER;
			name_ts.valign = .CENTER;
			name_ts.do_outline = true;
			name_ts.outline_thickness = 4;
			name_ts.outline_color = v4.{0, 0, 0, 1};
			name_ts.do_autofit = true;
			name_ts.autofit_min_size = 18;
			name_ts.autofit_max_size = 28;
			name_ts.autofit_iters = 4;
			UI.text(name_rect, name_ts, get_role_name(player.player_role));
		}
	}

	// Pre-compute all 4 tab rects from left_side / right_side.
	// Left side uses cut_left (outer→inner), right side uses cut_right (outer→inner).
	role_area := left_side.cut_left(TAB_W).inset(14, 2, 0, 4);
	abil_area := left_side.cut_left(TAB_W).inset(14, 4, 0, 2);
	map_area  := right_side.cut_right(TAB_W).inset(14, 4, 0, 2);
	sab_area  := right_side.cut_right(TAB_W).inset(14, 2, 0, 4);

	if true {
		tab_ts := UI.default_text_settings();
		tab_ts.size = 22;
		tab_ts.color = v4.{1, 1, 1, 1};
		tab_ts.halign = .CENTER;
		tab_ts.valign = .CENTER;
		tab_ts.do_outline = true;
		tab_ts.outline_thickness = 2;
		tab_ts.outline_color = v4.{0, 0, 0, 1};

		tab_sprite      := get_asset(Texture_Asset, tab_path);
		tab_sprite_grey := get_asset(Texture_Asset, "$AO/ui/kit/Modal Augments/modal_tabs/tabs_grey/tab_trapezoid.png");

		tab_bs := UI.default_button_settings();
		tab_bs.press_scaling = 0.4;
		tab_bs.sprite = tab_sprite_grey;

		active_tab_bs := UI.default_button_settings();
		active_tab_bs.sprite = tab_sprite;
		active_tab_bs.press_scaling = 0.4;

		UI.push_id("help_tab_role");
		defer UI.pop_id();
		role_tab_rect := role_area;
		if player.task_help_page == 0 {
			if UI.button(role_tab_rect, active_tab_bs, tab_ts, "Role").clicked {
				player.task_help_page = 0;
			}
		} else {
			if UI.button(role_tab_rect, tab_bs, tab_ts, "Role").clicked {
				player.task_help_page = 0;
			}
		}

		UI.push_id("help_tab_abilities");
		defer UI.pop_id();
		abilities_tab_rect := abil_area;
		if player.task_help_page == 1 {
			if UI.button(abilities_tab_rect, active_tab_bs, tab_ts, "Abilities").clicked {
				player.task_help_page = 1;
			}
		} else {
			if UI.button(abilities_tab_rect, tab_bs, tab_ts, "Abilities").clicked {
				player.task_help_page = 1;
			}
		}
	} else {
		player.task_help_page = 0;
	}

	// --- Right tabs: Sabotages | Map (always visible) ---
	rtab_sprite      := get_asset(Texture_Asset, tab_path);
	rtab_sprite_grey := get_asset(Texture_Asset, "$AO/ui/kit/Modal Augments/modal_tabs/tabs_grey/tab_trapezoid.png");

	rtab_ts := UI.default_text_settings();
	rtab_ts.size = 20;
	rtab_ts.color = v4.{1, 1, 1, 1};
	rtab_ts.halign = .CENTER;
	rtab_ts.valign = .CENTER;
	rtab_ts.do_outline = true;
	rtab_ts.outline_thickness = 2;
	rtab_ts.outline_color = v4.{0, 0, 0, 1};

	rtab_bs := UI.default_button_settings();
	rtab_bs.press_scaling = 0.4;
	rtab_bs.sprite = rtab_sprite_grey;

	rtab_active_bs := UI.default_button_settings();
	rtab_active_bs.sprite = rtab_sprite;
	rtab_active_bs.press_scaling = 0.4;

	page2_label := "Sabotages";
	if player.player_type != Player_Type.TRAITOR {
		page2_label = "Tasks";
	}
	if player.player_role == Player_Role.BIG_CHARLIE {
		page2_label = "Objectives";
	}
	UI.push_id("help_tab_sabotages");
	defer UI.pop_id();
	if player.task_help_page == 2 {
		if UI.button(sab_area, rtab_active_bs, rtab_ts, page2_label).clicked {
			player.task_help_page = 2;
		}
	} else {
		if UI.button(sab_area, rtab_bs, rtab_ts, page2_label).clicked {
			player.task_help_page = 2;
		}
	}

	UI.push_id("help_tab_map");
	defer UI.pop_id();
	if player.task_help_page == 3 {
		if UI.button(map_area, rtab_active_bs, rtab_ts, "Map").clicked {
			player.task_help_page = 3;
		}
	} else {
		if UI.button(map_area, rtab_bs, rtab_ts, "Map").clicked {
			player.task_help_page = 3;
		}
	}

	// ---- Page 0: Role Info ----
	if player.task_help_page == 0 {
		desc := rr_get_role_description(player.player_role, player.player_type);

		desc_ts := UI.default_text_settings();
		desc_ts.size = 28;
		desc_ts.color = v4.{0.9, 0.9, 0.95, 1};
		desc_ts.halign = .CENTER;
		desc_ts.valign = .TOP;
		desc_ts.word_wrap = true;
		desc_ts.do_outline = true;
		desc_ts.outline_thickness = 3;
		desc_ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(content, desc_ts, desc);
	}

	// ---- Page 1: Abilities ----
	if player.task_help_page == 1 {
		ab_entries: [..]Help_Ability_Entry;
		rr_get_role_ability_entries(player.player_role, player.player_type, ref ab_entries);
		if !has_abilities {
			no_ab_ts := UI.default_text_settings();
			no_ab_ts.size = 28;
			no_ab_ts.color = v4.{0.7, 0.7, 0.75, 1};
			no_ab_ts.halign = .CENTER;
			no_ab_ts.valign = .CENTER;
			no_ab_ts.do_outline = true;
			no_ab_ts.outline_thickness = 2;
			no_ab_ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(content, no_ab_ts, "No special abilities for this role.");
		} else {
			rr_draw_help_entry_list(content, "help_abilities_scroll", ref ab_entries);
		}
	}

	// ---- Page 2: Sabotages (traitors) / Tasks (civilians + anarchists) ----
	if player.task_help_page == 2 {
		if player.player_type == Player_Type.TRAITOR {
			sab_entries: [..]Help_Ability_Entry;
		append(ref sab_entries, Help_Ability_Entry.{"sprites/icons/power_outage.png", "Power Outage", "Plunges the map into darkness. Civilians can restart it from Generator room."});
		append(ref sab_entries, Help_Ability_Entry.{"sprites/icons/communication_outage_icon.png", "Comms Outage", "Hides all task information and stop communication. Civilians can stop it from Comms room."});
		append(ref sab_entries, Help_Ability_Entry.{"sprites/icons/doors_lock.png", "Door Lockdown", "All doors are sealed for 10 seconds. Civilians can force doors open. All doors open once cooldown over."});
			rr_draw_help_entry_list(content, "help_sabotages_scroll", ref sab_entries);
		} else {
			task_entries: [..]Help_Ability_Entry;
			if player.player_role == Player_Role.BIG_CHARLIE {
				append(ref task_entries, Help_Ability_Entry.{"sprites/icons/big_charlie/Lil_Nugget.png", "Plant Nuggets", "Transform into Big Charlie, then use Birth Nugget to plant 5 Lil' Nuggets. Non-traitors only see them when close and can smush them."});
				append(ref task_entries, Help_Ability_Entry.{"sprites/icons/big_charlie/abilities/Slough_Icon.png", "Infect Players", "Cocoon a nearby player, then use the cocoon's Incubate interact prompt to send a planted Nugget into it. Hatch 3 different infected players."});
				append(ref task_entries, Help_Ability_Entry.{"sprites/icons/big_charlie/abilities/Stampede_Icon.png", "Fire Mass Birth", "Once 5 Nuggets are planted and 3 players are infected, use Mass Birth in Big Charlie form to start the win cinematic."});
			} else if player.player_role == Player_Role.HACKER {
				append(ref task_entries, Help_Ability_Entry.{"sprites/tasks/repair_laptop/Banned_Laptop solo.png", "Hack Tasks", "Trap task stations around the map."});
				append(ref task_entries, Help_Ability_Entry.{"sprites/icons/coroner/ability_take_dna.png", "Steal Identities", "Hack civilian corpses to steal their powers."});
				append(ref task_entries, Help_Ability_Entry.{"sprites/icons/hacker/game_end.png", "Game Hack", "Use Game Hack after both objectives are complete."});
			} else {
				append(ref task_entries, Help_Ability_Entry.{"", "Calibrate Teleporter", "Drag the reticle to align it with the blinking target zone."});
				append(ref task_entries, Help_Ability_Entry.{"", "Solve the Cypher", "Press the 4 icons in the exact order shown on the display panel."});
				append(ref task_entries, Help_Ability_Entry.{"", "Restart System", "Rearrange the scrambled letters to spell the hidden word."});
				append(ref task_entries, Help_Ability_Entry.{"", "Reroute Power", "Rotate the pipe tiles to form a connected path from left to right."});
				append(ref task_entries, Help_Ability_Entry.{"", "Guide the Electron", "Move the electron left or right to steer it through the gaps."});
				append(ref task_entries, Help_Ability_Entry.{"", "Sync Signals", "Aim the beam at each satellite dish until all signals are synced."});
				append(ref task_entries, Help_Ability_Entry.{"", "Build a Robot", "Drag each robot piece onto the matching spot on the frame."});
				append(ref task_entries, Help_Ability_Entry.{"", "Catching Butterflies", "Tap all the butterflies before they flutter away."});
				append(ref task_entries, Help_Ability_Entry.{"", "Change Jail Codes", "Find and enter the 4-digit code shown on the sticky note nearby."});
				append(ref task_entries, Help_Ability_Entry.{"", "Repair Laptop", "Drag each piece back into its correct slot on the laptop."});
			}
			rr_draw_help_entry_list(content, "help_tasks_scroll", ref task_entries);
		}
	}

	// ---- Page 3: Map ----
	if player.task_help_page == 3 {
		map_entries: [..]Help_Ability_Entry;
		append(ref map_entries, Help_Ability_Entry.{"sprites/icons/call_meeting_icon.png", "Emergency Meeting", "Press button in the Conference hallto call an emergency meeting."});
		append(ref map_entries, Help_Ability_Entry.{"sprites/icons/power_outage.png", "Generator", "The generator can be restarted from the Reactor room during power outages!"});
		append(ref map_entries, Help_Ability_Entry.{"sprites/icons/communication_outage_icon.png", "Comms Console", "Restores communications from the Comms room. Flip the lever to reveal task information again."});
		rr_draw_help_entry_list(content, "help_map_scroll", ref map_entries);
	}
}

update_tasks_ui :: proc(player: Player) {
	// Task UI is drawn during gameplay. Ghost civilians can still complete tasks.
	if !player.is_local_or_server() {
		return;
	}
	if game_state != Game_State.INGAME {
		// If a task attempt UI is open and we leave gameplay (meeting/voting/death),
		// cancel it so the player can see global animations (death, popups, etc.).
		rr_cancel_all_task_attempts(player);
		return;
	}
	if player.player_state != Player_State.ALIVE {
		// Non-civilians can't do tasks while dead.
		if player.player_type != Player_Type.CIVILIAN {
			rr_cancel_all_task_attempts(player);
		}
	}
	// Draw tasks UI at a low layer so it sits behind popups/modals.
	UI.push_layer(100);
	defer UI.pop_layer();

	// Mobile scale boost (no-op on PC).
	_pushed_scale := rr_push_mobile_ui_scale(player);
	defer rr_pop_mobile_ui_scale(_pushed_scale);

	screen := UI.get_safe_screen_rect();

	if !player.task_list_inited {
		player.task_list_inited = true;
		player.task_list_open = true;
	}

	if player.player_state != Player_State.ALIVE && player.player_type != Player_Type.CIVILIAN {
		return;
	}
	if player.active_tasks.elements.count == 0 {
		// During sabotages we may still want to show the sabotage panel even if the
		// player normally has no tasks (e.g. anarchists). Traitors should not be
		// instructed to fix sabotages.
		if player.player_type == Player_Type.TRAITOR {
			header_rect := rr_draw_task_list_header(screen, false, player);
			rr_draw_role_help_panel(player);
			return;
		}
		if !rr_power_outage_active && !rr_comms_outage_active {
			header_rect := rr_draw_task_list_header(screen, false, player);
			rr_draw_role_help_panel(player);
			return;
		}
	}


	// --- Power outage override: show ONLY the generator task for non-traitors ---
	if rr_power_outage_active && player.player_type != Player_Type.TRAITOR {

		// Draw objective arrow to the generator for local player.
		if player.is_local() {
			tutorial_arrow_options := Tutorial_Arrow.default_options();
			dist := length(player.entity.world_position - rr_get_power_outage_generator_pos());
			tutorial_arrow_options.alpha = clamp(1.0 - (dist - 3.0) / 22.0, 0.25, 1.0);
			tutorial_arrow_options.far = true;
			tutorial_arrow_options.near = true;
			tutorial_arrow_options.bob_scale = 0.5;
			tutorial_arrow_options.bob_bias = 1.5;
			rr_draw_tutorial_arrow(player, rr_get_power_outage_generator_pos(), tutorial_arrow_options);
		}

		// Find generator task state (should be injected for everyone by the server).
		gen_task: Task_Base;
		for i: 0..player.active_tasks.elements.count-1 {
			t := player.active_tasks.elements[i];
			if t == null continue;
			if t.id == RR_RESTART_GENERATOR_TASK_ID {
				gen_task = t;
				break;
			}
		}

		task_started := false;
		task_completed := false;
		if gen_task != null {
			task_started = gen_task.started;
			task_completed = gen_task.completed;
		}

		PANEL_W :: 300.0;
		ROW_H :: 32.0;
		LIST_PAD :: 10.0;
		DROPDOWN_SLICE_PX :: 16.0;
		HELP_H :: 42.0;

		list_h := ROW_H + HELP_H + (LIST_PAD * 2.0);

		header_rect := rr_draw_task_list_header(screen, true, player);
		rr_draw_role_help_panel(player);
		if !player.task_list_open { return; }
		list_rect := header_rect.bottom_left_rect().grow(0.0, PANEL_W, list_h, 0.0);

		list_bg := get_asset(Texture_Asset, "ui/task list/task_list_dropdown_area.png");
		checkbox := get_asset(Texture_Asset, "ui/task list/checkbox.png");
		checkbox_filled := get_asset(Texture_Asset, "ui/task list/checkbox_filled.png");

		rr_ui_draw_nine_slice_panel(list_rect, list_bg, DROPDOWN_SLICE_PX);

		list_content := list_rect.inset(LIST_PAD, 10.0, LIST_PAD, 10.0);
		{
			entry_rect := list_content.cut_top(ROW_H);
			entry_content := entry_rect.inset(0.0, 6.0, 0.0, 6.0);
			checkbox_slot := entry_content.cut_left(24.0);
			checkbox_half := 9.0;
			checkbox_rect := checkbox_slot.center_rect().grow(checkbox_half);
			if task_completed {
				UI.quad(checkbox_rect.fit_aspect(checkbox_filled.get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
			} else {
				UI.quad(checkbox_rect.fit_aspect(checkbox.get_aspect()), checkbox, v4.{1, 1, 1, 1});
			}

			task_name := get_task_display_name(RR_RESTART_GENERATOR_TASK_ID);
			task_ts := UI.default_text_settings();
			task_ts.size = 24;
			if task_completed {
				task_ts.color = v4.{0.6, 0.6, 0.6, 1};
			} else {
				task_ts.color = v4.{1, 1, 1, 1};
			}
			task_ts.halign = .LEFT;
			task_ts.valign = .CENTER;
			task_ts.do_outline = true;
			task_ts.outline_thickness = 4;
			task_ts.outline_color = v4.{0.15, 0.15, 0.215, 1};
			task_ts.do_autofit = true;
			task_ts.autofit_min_size = 14;
			task_ts.autofit_max_size = 24;
			UI.text(entry_content.inset(0, 4, 0, 4), task_ts, task_name);
		}

		help_rect := list_content.inset(0, 4, 0, 28);
		help_ts := UI.default_text_settings();
		help_ts.size = 18;
		help_ts.color = v4.{0.9, 0.9, 0.95, 0.7};
		help_ts.halign = .LEFT;
		help_ts.valign = .TOP;
		help_ts.word_wrap = true;
		help_ts.do_outline = true;
		help_ts.outline_thickness = 2;
		help_ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(help_rect, help_ts, "Find the generator and interact to restore power.");

		return;
	}

	// --- Comms outage override: show ONLY the comms restore task for non-traitors ---
	if rr_comms_outage_active && player.player_type != Player_Type.TRAITOR {

		// Draw objective arrow to the comms lever for local player.
		if player.is_local() {
			if world_references != null && world_references.rr_comms_lever_entity != null && #alive(world_references.rr_comms_lever_entity) {
				lever_pos := world_references.rr_comms_lever_entity.world_position;
				tutorial_arrow_options := Tutorial_Arrow.default_options();
				dist := length(player.entity.world_position - lever_pos);
				tutorial_arrow_options.alpha = clamp(1.0 - (dist - 3.0) / 22.0, 0.25, 1.0);
				tutorial_arrow_options.far = true;
				tutorial_arrow_options.near = true;
				tutorial_arrow_options.bob_scale = 0.5;
				tutorial_arrow_options.bob_bias = 1.5;
				rr_draw_tutorial_arrow(player, lever_pos, tutorial_arrow_options);
			}
		}

		// Find comms task state (should be injected for everyone by the server).
		comms_task: Task_Base;
		for i: 0..player.active_tasks.elements.count-1 {
			t := player.active_tasks.elements[i];
			if t == null continue;
			if t.id == RR_ENABLE_COMMUNICATIONS_TASK_ID {
				comms_task = t;
				break;
			}
		}

		task_started := false;
		task_completed := false;
		if comms_task != null {
			task_started = comms_task.started;
			task_completed = comms_task.completed;
		}

		PANEL_W :: 300.0;
		ROW_H :: 32.0;
		LIST_PAD :: 10.0;
		DROPDOWN_SLICE_PX :: 16.0;
		HELP_H :: 42.0;

		list_h := ROW_H + HELP_H + (LIST_PAD * 2.0);

		header_rect := rr_draw_task_list_header(screen, true, player);
		rr_draw_role_help_panel(player);
		if !player.task_list_open { return; }
		list_rect := header_rect.bottom_left_rect().grow(0.0, PANEL_W, list_h, 0.0);

		list_bg := get_asset(Texture_Asset, "ui/task list/task_list_dropdown_area.png");
		checkbox := get_asset(Texture_Asset, "ui/task list/checkbox.png");
		checkbox_filled := get_asset(Texture_Asset, "ui/task list/checkbox_filled.png");

		rr_ui_draw_nine_slice_panel(list_rect, list_bg, DROPDOWN_SLICE_PX);

		list_content := list_rect.inset(LIST_PAD, 10.0, LIST_PAD, 10.0);
		{
			entry_rect := list_content.cut_top(ROW_H);
			entry_content := entry_rect.inset(0.0, 6.0, 0.0, 6.0);
			checkbox_slot := entry_content.cut_left(24.0);
			checkbox_half := 9.0;
			checkbox_rect := checkbox_slot.center_rect().grow(checkbox_half);
			if task_completed {
				UI.quad(checkbox_rect.fit_aspect(checkbox_filled.get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
			} else {
				UI.quad(checkbox_rect.fit_aspect(checkbox.get_aspect()), checkbox, v4.{1, 1, 1, 1});
			}

			task_name := get_task_display_name(RR_ENABLE_COMMUNICATIONS_TASK_ID);
			task_ts := UI.default_text_settings();
			task_ts.size = 24;
			if task_completed {
				task_ts.color = v4.{0.6, 0.6, 0.6, 1};
			} else {
				task_ts.color = v4.{1, 1, 1, 1};
			}
			task_ts.halign = .LEFT;
			task_ts.valign = .CENTER;
			task_ts.do_outline = true;
			task_ts.outline_thickness = 4;
			task_ts.outline_color = v4.{0.15, 0.15, 0.215, 1};
			task_ts.do_autofit = true;
			task_ts.autofit_min_size = 14;
			task_ts.autofit_max_size = 24;
			UI.text(entry_content.inset(0, 4, 0, 4), task_ts, task_name);
		}

		help_rect := list_content.inset(0, 4, 0, 28);
		help_ts := UI.default_text_settings();
		help_ts.size = 18;
		help_ts.color = v4.{0.9, 0.9, 0.95, 0.7};
		help_ts.halign = .LEFT;
		help_ts.valign = .TOP;
		help_ts.word_wrap = true;
		help_ts.do_outline = true;
		help_ts.outline_thickness = 2;
		help_ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(help_rect, help_ts, "Go to Comms (Phota) and flip the lever to restore proximity chat.");

		return;
	}

	if(player.is_local()) {
		tutorial_arrow_options := Tutorial_Arrow.default_options();
		// Show objective arrows both near and far, and keep them readable.
		tutorial_arrow_options.far = false;
		tutorial_arrow_options.near = true;
		tutorial_arrow_options.bob_scale = 0.5;
		tutorial_arrow_options.bob_bias = 1.5;

		// Draw objective arrows toward each task's destination(s).
		for t: 0..player.active_tasks.elements.count-1 {
			task := player.active_tasks.elements[t];
			if task == null {
				continue;
			}
			if task.completed || task.started {
				continue;
			}

			rr_refresh_task_destinations_for_task(task);

			for d: 0..task.destinations.elements.count-1 {
				dist := length(player.entity.world_position - task.destinations.elements[d]);
				tutorial_arrow_options.alpha = clamp(1.0 - (dist - 3.0) / 22.0, 0.25, 1.0);
				rr_draw_tutorial_arrow(player, task.destinations.elements[d], tutorial_arrow_options);
			}
		}
	}

	// Civilians see their normal tasks; anarchist role objectives and infected mini-werewolves use this list too.
	if player.player_type != Player_Type.CIVILIAN && player.player_role != Player_Role.PRANKSTER && player.player_role != Player_Role.PYROMANIAC && player.player_role != Player_Role.HACKER && player.player_role != Player_Role.GOO_GOO_GAGA && player.player_role != Player_Role.BIG_CHARLIE && !player.werewolf_infected {
		return;
	}

	// Player task completion stats
	player_total_tasks := player.active_tasks.elements.count;
	player_completed_tasks := 0;
	for i: 0..player.active_tasks.elements.count-1 {
		t := player.active_tasks.elements[i];
		if t == null continue;
		if t.completed {
			player_completed_tasks += 1;
		}
	}

	// Panel sizing
	PANEL_W :: 300.0;
	ROW_H :: 32.0;
	LIST_PAD :: 10.0;
	DROPDOWN_SLICE_PX :: 16.0;

	// Fake meeting and per-room pyro tasks get an extra sub-row for a subtitle line.
	SUBTITLE_ROW_H :: 18.0;
	extra_h := 0.0;
	for i: 0..player.active_tasks.elements.count-1 {
		t := player.active_tasks.elements[i];
		if t == null continue;
		if t.id == "call_fake_meeting" {
			extra_h += SUBTITLE_ROW_H;
		}
		if t.#type == RR_Pyro_Room_Task {
			extra_h += SUBTITLE_ROW_H + 5.0;
		}
	}
	list_h := (player_total_tasks.(float)) * ROW_H + extra_h + (LIST_PAD * 2.0);

	header_rect := rr_draw_task_list_header(screen, false, player);
	rr_draw_role_help_panel(player);
	list_rect := header_rect.bottom_left_rect().grow(0.0, PANEL_W, list_h, 0.0);

	list_bg := get_asset(Texture_Asset, "ui/task list/task_list_dropdown_area.png");
	checkbox := get_asset(Texture_Asset, "ui/task list/checkbox.png");
	checkbox_filled := get_asset(Texture_Asset, "ui/task list/checkbox_filled.png");

	if !player.task_list_open {
		return;
	}

	// Task list
	rr_ui_draw_nine_slice_panel(list_rect, list_bg, DROPDOWN_SLICE_PX);

	list_content := list_rect.inset(LIST_PAD, 10.0, LIST_PAD, 10.0);
	for i: 0..player.active_tasks.elements.count-1 {
		task := player.active_tasks.elements[i];
		if task == null continue;

		entry_rect := list_content.cut_top(ROW_H);
		if i < player.active_tasks.elements.count-1 {
			list_content.cut_top(2.0);
		}

		entry_content := entry_rect.inset(0.0, 6.0, 0.0, 6.0);
		checkbox_slot := entry_content.cut_left(24.0);
		checkbox_half := 9.0;
		checkbox_rect := checkbox_slot.center_rect().grow(checkbox_half);
		if task.completed {
			UI.quad(checkbox_rect.fit_aspect(checkbox_filled.get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
		} else {
			UI.quad(checkbox_rect.fit_aspect(checkbox.get_aspect()), checkbox, v4.{1, 1, 1, 1});
		}

		task_name := get_task_display_name(task.id);
		task_progress := "";
		prk := player.entity.get_component(Prankster_Module);
		switch task.#type {
			case Task_Prank_3_People: {
				if prk != null { task_progress = format_string("%/3", .{prk.prank_count}); }
			}
			case Task_Call_Fake_Meeting: {
				if prk != null { task_progress = format_string("%/1", .{prk.fake_meetings_called}); }
				// Show the target name as the main text.
				if prk != null && !task.completed && prk.fake_meeting_target_id != 0 {
					target := get_player_by_entity_id(prk.fake_meeting_target_id);
					if target != null && #alive(target.entity) {
						task_name = format_string("Vote out %", .{target.get_username()});
					}
				}
			}
			case RR_Pyro_Room_Task: {
				rt := task.(RR_Pyro_Room_Task);
				task_name = format_string("Burn out % room", .{rt.room_name});
			}
			case Task_GGG_Wrap: {
				gt := task.(Task_GGG_Wrap);
				ggm := player.entity.get_component(GGG_Module);
				ggg_w := 0;
				if ggm != null { ggg_w = ggm.nest_points; }
				task_progress = format_string("%/%", .{ggg_w, gt.goal});
			}
		}
		if task.id == WEREWOLF_INFECT_TO_CURE_TASK_ID {
			done := 0;
			if task.completed { done = 1; }
			task_progress = format_string("%/1", .{done});
		}
		// Pyro objectives (plain Task_Base, matched by id).
		if task.id == "pyro_burn_1_corpse" {
			pyro := player.entity.get_component(Pyro_Module);
			if pyro != null {
				pyro_corpses := pyro.corpses_burned;
				if pyro_corpses != pyro.cached_corpse_progress_val || pyro.cached_corpse_progress_str.count == 0 {
					pyro.cached_corpse_progress_val = pyro_corpses;
					pyro.cached_corpse_progress_str = format_string("%/1", .{pyro_corpses});
				}
				task_progress = pyro.cached_corpse_progress_str;
			}
		}
		if task.id == HACKER_TASK_ID_HACK_TASKS {
			hacker := player.entity.get_component(Hacker_Module);
			if hacker != null {
				task_progress = format_string("%/%", .{min(hacker.hacked_tasks, HACKER_HACK_TASK_GOAL), HACKER_HACK_TASK_GOAL});
			}
		}
		if task.id == HACKER_TASK_ID_STEAL_IDENTITIES {
			hacker := player.entity.get_component(Hacker_Module);
			if hacker != null {
				task_progress = format_string("%/%", .{min(hacker.stolen_identities, HACKER_STEAL_IDENTITY_GOAL), HACKER_STEAL_IDENTITY_GOAL});
			}
		}

		text_rect := entry_content;
		if task_progress.count > 0 && !task.completed {
			progress_w := 60.0;
			progress_rect := text_rect.cut_right(progress_w);

			progress_ts := UI.default_text_settings();
			progress_ts.size = 24;
			progress_ts.color = v4.{1, 1, 1, 1};
			progress_ts.halign = .RIGHT;
			progress_ts.valign = .CENTER;
			progress_ts.do_outline = true;
			progress_ts.outline_thickness = 4;
			progress_ts.outline_color = v4.{0.15, 0.15, 0.215, 1};
			UI.text(progress_rect.inset(0, 4, 0, 4), progress_ts, task_progress);
		}

		task_ts := UI.default_text_settings();
		task_ts.size = 24;
		if task.completed {
			task_ts.color = v4.{0.6, 0.6, 0.6, 1};
		} else {
			task_ts.color = v4.{1, 1, 1, 1};
		}
		task_ts.halign = .LEFT;
		task_ts.valign = .CENTER;
		task_ts.do_outline = true;
		task_ts.outline_thickness = 4;
		task_ts.outline_color = v4.{0.15, 0.15, 0.215, 1};
		task_ts.do_autofit = true;
		task_ts.autofit_min_size = 14;
		task_ts.autofit_max_size = 24;
		UI.text(text_rect.inset(0, 4, 0, 4), task_ts, task_name);

		// Fake meeting task: draw "in a fake meeting" subtitle on a second line.
		if task.id == "call_fake_meeting" {
			subtitle_rect := list_content.cut_top(SUBTITLE_ROW_H);
			// Indent to align with the task text (past the checkbox column).
			subtitle_content := subtitle_rect.inset(0.0, 00.0, 0.0, 50.0);
			sub_ts := UI.default_text_settings();
			sub_ts.size = 18;
			sub_ts.color = v4.{0.65, 0.65, 0.7, 1};
			sub_ts.halign = .LEFT;
			sub_ts.valign = .TOP;
			sub_ts.do_outline = true;
			sub_ts.outline_thickness = 3;
			sub_ts.outline_color = v4.{0.1, 0.1, 0.15, 1};
			UI.text(subtitle_content, sub_ts, "in a fake meeting");
		}

		// Per-room pyro task: draw "- X/Y Objects" subtitle on a second line.
		if task.#type == RR_Pyro_Room_Task && !task.completed {
			rt := task.(RR_Pyro_Room_Task);
			subtitle_rect := list_content.cut_top(SUBTITLE_ROW_H);
			subtitle_content := subtitle_rect.inset(0.0, 0.0, 0.0, 28.0);

			burned := 0;
			total := 0;
			if rt.room_entity != null && #alive(rt.room_entity) {
				room_state := rt.room_entity.get_component(RR_Pyro_Room_Fire_State);
				if room_state != null {
					burned = room_state.burning_props;
					total = room_state.total_props;
				} else {
					// State is created lazily on first ignition; count props directly.
					total = rr_pyro_count_ignitable_props_in_room(rt.room_entity);
				}
			}

			sub_ts := UI.default_text_settings();
			sub_ts.size = 18;
			sub_ts.color = v4.{0.65, 0.65, 0.7, 1};
			sub_ts.halign = .LEFT;
			sub_ts.valign = .TOP;
			sub_ts.do_outline = true;
			sub_ts.outline_thickness = 3;
			sub_ts.outline_color = v4.{0.1, 0.1, 0.15, 1};
			UI.text(subtitle_content, sub_ts, format_string("- %/% Objects", .{burned, total}));
		}
	}
}

// --- Prankster objective ---
Task_Prank_3_People :: class : Task_Base {
	GOAL :: 3;

	update_task :: proc(using this: Task_Prank_3_People, player: Player) {
		// No interactive UI: just track progress and complete when met.
		if completed return;
		prk := player.entity.get_component(Prankster_Module);
		if prk != null && prk.prank_count >= GOAL {
			complete_attempt(this, player, true);
		}
	}
}

Task_Call_Fake_Meeting :: class : Task_Base {
	update_task :: proc(using this: Task_Call_Fake_Meeting, player: Player) {
		if completed return;
		prk := player.entity.get_component(Prankster_Module);
		if prk != null && prk.fake_meetings_called >= 1 {
			complete_attempt(this, player, true);
		}
	}
}

// --- Goo Goo Gaga objectives ---
Task_GGG_Wrap :: class : Task_Base {
	goal: int;

	update_task :: proc(using this: Task_GGG_Wrap, player: Player) {
		if completed return;
		ggm := player.entity.get_component(GGG_Module);
		if ggm != null && ggm.nest_points >= goal {
			complete_attempt(this, player, true);
		}
	}
}

// Normal tasks
Task_Repair_Laptop :: class : Task_Base {
	// Layout / interaction state
	seen_attempt_id: int;
	layout_initialized: bool;
	dragging_idx: int; // -1 = none, else PART_*
	drag_offset: v2;   // mouse_pos - part_center at drag start
	part_pos: [3]v2;   // screen-space centers (same coordinate space as UI mouse)
	part_placed: [3]bool;
	success_time: float; // >0 when solved, before we finalize completion

	// Textures
	table_texture: Texture_Asset;
	laptop_texture: Texture_Asset;
	highest_parts_texture: Texture_Asset;
	cpu_texture: Texture_Asset;
	ram_texture: Texture_Asset;
	battery_texture: Texture_Asset;

	PART_CPU :: 0;
	PART_RAM :: 1;
	PART_BATTERY :: 2;

	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;

	start_attempt :: proc(using this: Task_Repair_Laptop, player: Player) {
		if started {
			return;
		}
		attempt_id += 1;
		started = true;
		seen_attempt_id = attempt_id;
		layout_initialized = false;
		dragging_idx = -1;
		drag_offset = v2.{0.0, 0.0};
		for i: 0..2 {
			part_pos[i] = v2.{0.0, 0.0};
			part_placed[i] = false;
		}
		success_time = 0.0;
	}

	cancel_attempt :: proc(using this: Task_Repair_Laptop, player: Player) {
		if !started return;
		if completed return;
		started = false;
		layout_initialized = false;
		dragging_idx = -1;
		drag_offset = v2.{0.0, 0.0};
		for i: 0..2 {
			part_pos[i] = v2.{0.0, 0.0};
			part_placed[i] = false;
		}
		success_time = 0.0;
	}

	init_textures :: proc(using this: Task_Repair_Laptop) {
		table_texture = get_asset(Texture_Asset, "sprites/tasks/repair_laptop/Banned_Laptoptable solo.png");
		laptop_texture = get_asset(Texture_Asset, "sprites/tasks/repair_laptop/Banned_Laptop solo.png");
		highest_parts_texture = get_asset(Texture_Asset, "sprites/tasks/repair_laptop/Banned_highest parts.png");

		cpu_texture = get_asset(Texture_Asset, "sprites/tasks/repair_laptop/Banned_CPU.png");
		ram_texture = get_asset(Texture_Asset, "sprites/tasks/repair_laptop/Banned_ram.png");
		battery_texture = get_asset(Texture_Asset, "sprites/tasks/repair_laptop/Banned_Laptop Battery.png");
	}

	get_part_texture :: proc(using this: Task_Repair_Laptop, idx: int) -> Texture_Asset {
		switch idx {
			case PART_CPU: return cpu_texture;
			case PART_RAM: return ram_texture;
			case PART_BATTERY: return battery_texture;
			default: return null;
		}
	}

	get_target_rect :: proc(using this: Task_Repair_Laptop, idx: int, laptop_rect: Rect) -> Rect {
		// These rects are authored as percentages of the laptop image, matching template 2.
		switch idx {
			case PART_CPU: {
				return laptop_rect.subrect(0.47, 0.55, 0.69, 0.85);
			}
			case PART_RAM: {
				return laptop_rect.subrect(0.24, 0.38, 0.44, 0.54);
			}
			case PART_BATTERY: {
				return laptop_rect.subrect(0.30, 0.05, 0.86, 0.3);
			}
			default: {
				return laptop_rect.subrect(0.0, 0.0, 0.0, 0.0);
			}
		}
	}

	is_point_in_rect :: proc(p: v2, r: Rect) -> bool {
		if p.x < r.min.x return false;
		if p.x > r.max.x return false;
		if p.y < r.min.y return false;
		if p.y > r.max.y return false;
		return true;
	}

	draw_debug_rect_outline :: proc(r: Rect, thickness: float, color: v4) {
		tex := get_asset(Texture_Asset, "$AO/white.png");
		// Top / bottom
		top := Rect.{v2.{r.min.x, r.max.y - thickness}, v2.{r.max.x, r.max.y}};
		bot := Rect.{v2.{r.min.x, r.min.y}, v2.{r.max.x, r.min.y + thickness}};
		// Left / right
		left := Rect.{v2.{r.min.x, r.min.y}, v2.{r.min.x + thickness, r.max.y}};
		right := Rect.{v2.{r.max.x - thickness, r.min.y}, v2.{r.max.x, r.max.y}};

		UI.quad(top, tex, color);
		UI.quad(bot, tex, color);
		UI.quad(left, tex, color);
		UI.quad(right, tex, color);
	}

	draw_debug_target_rects :: proc(using this: Task_Repair_Laptop, laptop_rect: Rect) {
		th := max(2.0, laptop_rect.height() * 0.006);

		ts := UI.default_text_settings();
		ts.size = max(14.0, laptop_rect.height() * 0.04);
		ts.color = v4.{1, 1, 1, 1};
		ts.halign = .CENTER;
		ts.valign = .CENTER;
		ts.do_outline = true;
		ts.outline_thickness = 2;
		ts.outline_color = v4.{0, 0, 0, 1};

		// CPU
		rcpu := get_target_rect(this, PART_CPU, laptop_rect);
		draw_debug_rect_outline(rcpu, th, v4.{1.0, 0.2, 0.2, 0.95});
		UI.text(rcpu, ts, "CPU");

		// RAM
		rram := get_target_rect(this, PART_RAM, laptop_rect);
		draw_debug_rect_outline(rram, th, v4.{0.2, 0.9, 0.2, 0.95});
		UI.text(rram, ts, "RAM");

		// BATTERY
		rbat := get_target_rect(this, PART_BATTERY, laptop_rect);
		draw_debug_rect_outline(rbat, th, v4.{0.25, 0.55, 1.0, 0.95});
		UI.text(rbat, ts, "BAT");
	}

	draw_part :: proc(using this: Task_Repair_Laptop, idx: int, rect: Rect, is_dragging: bool) -> Interact_Result {
		UI.push_id("rl_part_%", .{idx});
		defer UI.pop_id();

		btn_bs: Button_Settings = .{};
		rr_ui_apply_button_click_sound(ref btn_bs);
		interact := UI.button(rect, btn_bs, .{}, "");

		tex := get_part_texture(this, idx);

		// Optional drop shadow when dragging.
		if is_dragging {
			shadow := rect.offset_unscaled(6, -6);
			UI.quad(shadow, get_asset(Texture_Asset, "$AO/white.png"), v4.{0, 0, 0, 0.25});
		}

		if tex != null {
			UI.quad(rect, tex, .{1, 1, 1, 1});
		}
		return interact;
	}

	update_task :: proc(using this: Task_Repair_Laptop, player: Player) {
		if !started return;
		if completed return;
		if !player.is_local_or_server() return;

		// IMPORTANT: `start_attempt()` is not dynamically dispatched (it is called on `Task_Base`),
		// so we must self-initialize per attempt here. Otherwise fields like `dragging_idx` default
		// to 0 (CPU) and the CPU appears "pre-dragged" and blocks other parts.
		if seen_attempt_id != attempt_id {
			seen_attempt_id = attempt_id;
			layout_initialized = false;
			dragging_idx = -1;
			drag_offset = v2.{0.0, 0.0};
			for i: 0..2 {
				part_pos[i] = v2.{0.0, 0.0};
				part_placed[i] = false;
			}
			success_time = 0.0;
		}

		if table_texture == null {
			init_textures(this);
		}

		// Dim the game behind the minigame.
		screen := UI.get_screen_rect();
		dim := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, dim, .{0.0, 0.0, 0.0, 0.85});

		// Window rect (keep the background aspect so art matches).
		safe := UI.get_safe_screen_rect();
		window := safe.center_rect().grow(320, 620, 320, 620);
		if table_texture != null {
			window = window.fit_aspect(table_texture.get_aspect(), .KEEP_BIGGER);
		}

		// Layout
		art_rect := window;
		// Place laptop near top, leaving table space below for loose parts.
		laptop_rect := art_rect.subrect(0.10, 0.36, 0.90, 0.98).fit_aspect(laptop_texture.get_aspect(), .KEEP_HEIGHT);

		// Initialize part spawn positions once (screen-space).
		if !layout_initialized {
			layout_initialized = true;

			parts_area := art_rect.subrect(0.15, 0.05, 0.85, 0.34);
			// Roughly matches template 1 layout.
			part_pos[PART_RAM] = parts_area.subrect(0.00, 0.25, 0.35, 0.90).center();
			part_pos[PART_CPU] = parts_area.subrect(0.30, 0.15, 0.62, 0.90).center();
			part_pos[PART_BATTERY] = parts_area.subrect(0.55, 0.05, 1.00, 0.55).center();
		}

		// If we're in the success display phase, freeze interaction and finish after a delay.
		if success_time > 0.0 {
			elapsed := get_time() - success_time;
			if elapsed >= SUCCESS_DISPLAY_TIME {
				complete_attempt(this, player, true);
				return;
			}

			// Draw the same scene, just with parts placed.
			if table_texture != null {
				UI.quad(art_rect, table_texture, .{1, 1, 1, 1});
			}
			if laptop_texture != null {
				UI.quad(laptop_rect, laptop_texture, .{1, 1, 1, 1});
			}

			for i: 0..2 {
				if !part_placed[i] continue;
				target := get_target_rect(this, i, laptop_rect);
				tex := get_part_texture(this, i);
				if tex != null {
					r := target.fit_aspect(tex.get_aspect(), .KEEP_BIGGER);
					UI.quad(r, tex, .{1, 1, 1, 1});
				}
			}
			if highest_parts_texture != null {
				UI.quad(laptop_rect, highest_parts_texture, .{1, 1, 1, 1});
			}
			return;
		}

		// --- Draw base scene (background layering) ---
		if table_texture != null {
			UI.quad(art_rect, table_texture, .{1, 1, 1, 1});
		}
		if laptop_texture != null {
			UI.quad(laptop_rect, laptop_texture, .{1, 1, 1, 1});
		}

		// Debug: visualize drop targets on the laptop.
		draw_debug_target_rects(this, laptop_rect);

		// Draw placed parts inside the laptop (below "highest parts").
		for i: 0..2 {
			if !part_placed[i] continue;
			target := get_target_rect(this, i, laptop_rect);
			tex := get_part_texture(this, i);
			if tex != null {
				r := target.fit_aspect(tex.get_aspect(), .KEEP_BIGGER);
				UI.quad(r, tex, .{1, 1, 1, 1});
			}
		}

		// Draw the overlay that should appear above components.
		if highest_parts_texture != null {
			UI.quad(laptop_rect, highest_parts_texture, .{1, 1, 1, 1});
		}

		// Close button (drawn after art so it renders on top).
		if draw_task_close_button(window, player, this) {
			return;
		}

		// Draw + interact with loose parts (drag & drop).
		mouse_pos := get_mouse_screen_position();

		// First pass: non-dragging parts.
		for i: 0..2 {
			if part_placed[i] continue;
			if dragging_idx == i continue;

			tex := get_part_texture(this, i);
			if tex == null continue;

			// Size parts relative to window height so it scales well.
			h := art_rect.height() * 0.16;
			if i == PART_RAM { h = art_rect.height() * 0.12; }
			if i == PART_BATTERY { h = art_rect.height() * 0.14; }
			w := h * tex.get_aspect();
			half := v2.{w * 0.5, h * 0.5};
			rect := Rect.{part_pos[i] - half, part_pos[i] + half};

			interact := draw_part(this, i, rect, false);
			mouse_pos = interact.mouse_position;

			if interact.just_pressed && dragging_idx < 0 {
				dragging_idx = i;
				drag_offset = mouse_pos - part_pos[i];
			}
		}

		// Second pass: dragging part on top.
		if dragging_idx >= 0 && dragging_idx <= 2 && !part_placed[dragging_idx] {
			i := dragging_idx;
			tex := get_part_texture(this, i);
			if tex != null {
				h := art_rect.height() * 0.16;
				if i == PART_RAM { h = art_rect.height() * 0.12; }
				if i == PART_BATTERY { h = art_rect.height() * 0.14; }
				w := h * tex.get_aspect();
				half := v2.{w * 0.5, h * 0.5};
				rect := Rect.{part_pos[i] - half, part_pos[i] + half};

				interact := draw_part(this, i, rect, true);
				mouse_pos = interact.mouse_position;

				// While active, follow the pointer.
				if interact.active {
					part_pos[i] = mouse_pos - drag_offset;
				}

				// On release, snap if we're over the target.
				if interact.released {
					target := get_target_rect(this, i, laptop_rect);
					if is_point_in_rect(part_pos[i], target) {
						part_pos[i] = target.center();
						part_placed[i] = true;
						rr_task_sfx(player, RR_TASK_SFX_TILE_CLICK, 0.6);
					}
					dragging_idx = -1;
				}
			} else {
				dragging_idx = -1;
			}
		}

		// Completion check: once all parts are placed, show the completed template briefly.
		all_placed := true;
		for i: 0..2 {
			if !part_placed[i] {
				all_placed = false;
				break;
			}
		}
		if all_placed {
			success_time = get_time();
		}
	}
}

Task_Call_Jail_Codes :: class : Task_Base {
	// UI/task state
	rng_initialized: bool;
	code_digits: List(int);   // len = CODE_LEN
	input_digits: List(int);  // player's current input
	success_time: float;
	fail_time: float;

	// Textures
	numpad_texture: Texture_Asset;
	button_texture: Texture_Asset;
	button_pressed_texture: Texture_Asset;
	cancel_texture: Texture_Asset;
	cancel_pressed_texture: Texture_Asset;
	enter_texture: Texture_Asset;
	enter_pressed_texture: Texture_Asset;
	post_it_texture: Texture_Asset;
	number_button_textures: [10]Texture_Asset;
	number_hand_textures: [10]Texture_Asset;

	CODE_LEN :: 5;
	FAIL_LOCK_TIME :: 0.75;
	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;

	start_attempt :: proc(using this: Task_Call_Jail_Codes, player: Player) {
		if started {
			return;
		}
		started = true;
		rng_initialized = false;
		code_digits = List(int).{};
		input_digits = List(int).{};
		success_time = 0.0;
		fail_time = 0.0;
	}

	cancel_attempt :: proc(using this: Task_Call_Jail_Codes, player: Player) {
		if !started return;
		if completed return;
		started = false;
		rng_initialized = false;
		code_digits = List(int).{};
		input_digits = List(int).{};
		success_time = 0.0;
		fail_time = 0.0;
	}

	init_textures :: proc(using this: Task_Call_Jail_Codes) {
		numpad_texture = get_asset(Texture_Asset, "sprites/tasks/jail_codes/numpad.png");
		button_texture = get_asset(Texture_Asset, "sprites/tasks/jail_codes/button.png");
		button_pressed_texture = get_asset(Texture_Asset, "sprites/tasks/jail_codes/button_pressed.png");
		cancel_texture = get_asset(Texture_Asset, "sprites/tasks/jail_codes/cancel_button.png");
		cancel_pressed_texture = get_asset(Texture_Asset, "sprites/tasks/jail_codes/cancel_button_pressed.png");
		enter_texture = get_asset(Texture_Asset, "sprites/tasks/jail_codes/enter_button.png");
		enter_pressed_texture = get_asset(Texture_Asset, "sprites/tasks/jail_codes/enter_button_pressed.png");
		post_it_texture = get_asset(Texture_Asset, "sprites/tasks/jail_codes/post_it.png");

		for d: 0..9 {
			number_button_textures[d] = get_asset(Texture_Asset, format_string("sprites/tasks/jail_codes/button_numbers/%.png", .{d}));
			number_hand_textures[d] = get_asset(Texture_Asset, format_string("sprites/tasks/jail_codes/hand_drawn_numbers/%.png", .{d}));
		}
	}

	is_fail_locked :: proc(using this: Task_Call_Jail_Codes) -> bool {
		if fail_time <= 0.0 {
			return false;
		}
		return (get_time() - fail_time) < FAIL_LOCK_TIME;
	}

	init_code :: proc(using this: Task_Call_Jail_Codes) {
		if rng_initialized {
			return;
		}
		rng_initialized = true;
		rr_refresh_rng_state();
		code_digits = List(int).{};
		for i: 0..CODE_LEN-1 {
			append(ref code_digits, rng_range_int(ref rr_rng_state.value, 0, 9));
		}
	}

	clear_input :: proc(using this: Task_Call_Jail_Codes) {
		input_digits = List(int).{};
	}

	is_input_correct :: proc(using this: Task_Call_Jail_Codes) -> bool {
		if code_digits.elements.count != CODE_LEN return false;
		if input_digits.elements.count != CODE_LEN return false;
		for i: 0..CODE_LEN-1 {
			if input_digits.elements[i] != code_digits.elements[i] {
				return false;
			}
		}
		return true;
	}

	handle_digit_press :: proc(using this: Task_Call_Jail_Codes, digit: int) {
		if success_time > 0.0 return;
		if is_fail_locked(this) return;
		if input_digits.elements.count >= CODE_LEN return;
		append(ref input_digits, digit);
	}

	handle_cancel_press :: proc(using this: Task_Call_Jail_Codes) {
		if success_time > 0.0 return;
		if is_fail_locked(this) return;
		clear_input(this);
	}

	handle_enter_press :: proc(using this: Task_Call_Jail_Codes) {
		if success_time > 0.0 return;
		if is_fail_locked(this) return;

		// Require full input length.
		if input_digits.elements.count != CODE_LEN {
			return;
		}

		if is_input_correct(this) {
			success_time = get_time();
		} else {
			fail_time = get_time();
			clear_input(this);
		}
	}

	draw_code_post_it :: proc(using task: Task_Call_Jail_Codes, safe_screen: Rect, window_rect: Rect) {
		if task.post_it_texture == null {
			return;
		}

		// Sticky note anchored to the bottom-right of the device.
		note_w := window_rect.width() * 0.40;
		// Keep it "attached" but inside the screen.
		note_anchor := window_rect.bottom_right_rect().offset_unscaled(-window_rect.width() * 0.02, -window_rect.height() * 0.10);
		note_rect := note_anchor.grow_unscaled(note_w * 0.55, note_w * 0.55, note_w * 0.45, note_w * 0.65);
		note_rect = note_rect.fit_aspect(task.post_it_texture.get_aspect(), .KEEP_WIDTH);

		// Clamp to safe screen so it never clips out.
		margin := 10.0;
		dx := 0.0;
		dy := 0.0;
		if note_rect.max.x > safe_screen.max.x - margin {
			dx = (safe_screen.max.x - margin) - note_rect.max.x;
		}
		if note_rect.min.x < safe_screen.min.x + margin {
			dx = (safe_screen.min.x + margin) - note_rect.min.x;
		}
		if note_rect.max.y > safe_screen.max.y - margin {
			dy = (safe_screen.max.y - margin) - note_rect.max.y;
		}
		if note_rect.min.y < safe_screen.min.y + margin {
			dy = (safe_screen.min.y + margin) - note_rect.min.y;
		}
		note_rect = note_rect.offset_unscaled(dx, dy);

		UI.quad(note_rect, task.post_it_texture, .{1, 1, 1, 1});

		// Code digits on the note (hand-drawn).
		if task.code_digits.elements.count != CODE_LEN {
			return;
		}

		digits_rect := note_rect.inset_unscaled(note_rect.height() * 0.4, note_rect.width() * 0.12, note_rect.height() * 0.4, note_rect.width() * 0.12);
		for i: 0..CODE_LEN-1 {
			d := task.code_digits.elements[i];
			if d < 0 || d > 9 continue;
			tex := task.number_hand_textures[d];
			if tex == null continue;
			cell := digits_rect.subrect(i.(f32) / CODE_LEN.(f32), 0.0, (i.(f32) + 1.0) / CODE_LEN.(f32), 1.0);
			cell = cell.inset_unscaled(6, 2, 6, 2);
			cell = cell.fit_aspect(tex.get_aspect(), .KEEP_HEIGHT);
			UI.quad(cell, tex, .{1, 1, 1, 1});
		}
	}

	draw_jail_codes_ui :: proc(using task: Task_Call_Jail_Codes, player: Player, success_state: bool) {
		screen := UI.get_safe_screen_rect();
		bg := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, bg, .{0.0, 0.0, 0.0, 0.85});

		// Center the device.
		// Match the scale of other tasks (e.g. Task_Cypher uses ~900).
		window_size := 820.0;
		// Nudge up a bit to leave room for the post-it.
		window_rect := screen.center_rect().offset_unscaled(0.0, 30.0).grow(window_size / 2.0);
		window_rect = window_rect.fit_aspect(task.numpad_texture.get_aspect(), .KEEP_HEIGHT);

		// Fail shake for feedback.
		if task.is_fail_locked() && !success_state {
			shake := sin(get_time() * 42.0) * 6.0;
			window_rect = window_rect.offset(shake, 0.0);
		}

		UI.quad(window_rect, task.numpad_texture, success_state ? .{0.15, 0.8, 0.25, 1.0} : task.is_fail_locked() ? .{0.9, 0.15, 0.15, 1.0} : .{1, 1, 1, 1});

		// Close (top-right)
		if draw_task_close_button(window_rect, player, task) {
			return;
		}

		// Sticky note with the code.
		task.draw_code_post_it(screen, window_rect);

		ready := task.code_digits.elements.count == CODE_LEN;
		input_count := task.input_digits.elements.count;
		base_disabled := (!ready) || success_state || task.is_fail_locked();

		// Key grid area (12 slots, 3 cols x 4 rows) inside the device face.
		key_grid := window_rect.subrect(0.12, 0.17, 0.88, 0.9);
		pad_x := key_grid.width() * 0.03;
		pad_y := key_grid.height() * 0.035;

		for row: 0..3 {
			for col: 0..2 {
				// y from top
				y1 := 1.0 - ((row.(f32) + 1.0) / 4.0);
				y2 := 1.0 - (row.(f32) / 4.0);
				x1 := col.(f32) / 3.0;
				x2 := (col.(f32) + 1.0) / 3.0;

				cell := key_grid.subrect(x1, y1, x2, y2);
				cell = cell.inset_unscaled(pad_y, pad_x, pad_y, pad_x);

				is_cancel := (row == 3 && col == 0);
				is_zero := (row == 3 && col == 1);
				is_enter := (row == 3 && col == 2);

				// Determine what we're drawing/handling.
				btn_tex := task.button_texture;
				btn_pressed := task.button_pressed_texture;
				btn_is_digit := true;
				digit := 0;

				if is_cancel {
					btn_tex = task.cancel_texture;
					btn_pressed = task.cancel_pressed_texture;
					btn_is_digit = false;
				} else if is_enter {
					btn_tex = task.enter_texture;
					btn_pressed = task.enter_pressed_texture;
					btn_is_digit = false;
				} else {
					if row < 3 {
						digit = row * 3 + col + 1;
					} else {
						digit = 0;
					}
				}

				UI.push_id("jail_codes_key_%_%", .{row, col});
				defer UI.pop_id();

				// Per-button disabled rules:
				// - Digits: disabled when full (can't enter more), or base disabled
				// - Enter: disabled until exact number of digits entered, or base disabled
				// - Cancel: clears the full input; keep enabled unless base disabled
				disabled := base_disabled;
				if !is_cancel && !is_enter {
					disabled = disabled || (input_count >= CODE_LEN);
				}
				if is_enter {
					disabled = disabled || (input_count != CODE_LEN);
				}

				UI.push_disabled(disabled);
				defer UI.pop_disabled();

				btn_bs: Button_Settings = .{};
				rr_ui_apply_button_click_sound(ref btn_bs);
				interact := UI.button(cell, btn_bs, .{}, "");

				base := btn_tex;
				if interact.active {
					base = btn_pressed;
				}
				btn_rect := cell.fit_aspect(base.get_aspect(), .KEEP_WIDTH);
				UI.quad(btn_rect, base, .{1, 1, 1, 1});

				// Digit overlay.
				if btn_is_digit {
					num_tex := task.number_button_textures[digit];
					if num_tex != null {
						num_rect := btn_rect.inset_unscaled(btn_rect.height() * 0.18, btn_rect.width() * 0.18, btn_rect.height() * 0.18, btn_rect.width() * 0.18);
						num_rect = num_rect.fit_aspect(num_tex.get_aspect(), .KEEP_HEIGHT);
						UI.quad(num_rect, num_tex, .{1, 1, 1, 1});
					}
				}

				if interact.clicked && !disabled {
					if is_cancel {
						task.handle_cancel_press();
					} else if is_enter {
						prev_success := task.success_time;
						prev_fail := task.fail_time;
						task.handle_enter_press();
						if task.success_time > 0.0 && prev_success <= 0.0 {
							rr_task_sfx(player, RR_TASK_SFX_BEEP, 0.7);
						}
						if task.fail_time > prev_fail && task.fail_time > 0.0 {
							rr_task_sfx(player, RR_TASK_SFX_ERROR, 0.6);
						}
					} else {
						task.handle_digit_press(digit);
						rr_task_sfx(player, RR_TASK_SFX_KEY_PRESS, 0.4);
					}
				}
			}
		}
	}

	update_task :: proc(using this: Task_Call_Jail_Codes, player: Player) {
		if !started return;
		if completed return;
		if !player.is_local_or_server() return;

		if numpad_texture == null {
			init_textures(this);
		}
		init_code(this);

		if success_time > 0.0 {
			if (get_time() - success_time) >= SUCCESS_DISPLAY_TIME {
				complete_attempt(this, player, true);
				return;
			}
			draw_jail_codes_ui(this, player, true);
			return;
		}

		draw_jail_codes_ui(this, player, false);
	}
}

// --- Sabotage fix: Enable Communications (injected during Comms Outage) ---
Task_Enable_Communications :: class : Task_Base {
	update_task :: proc(using this: Task_Enable_Communications, player: Player) {
		// Only relevant while comms sabotage is active.
		if !rr_comms_outage_active {
			started = false;
			return;
		}
		if !started {
			return;
		}
		if completed {
			return;
		}
		if !player.is_local_or_server() {
			return;
		}

		// Instant success on interact; server ends sabotage globally.
		complete_attempt(this, player, true);
		if Game.is_server() && rr_comms_outage_active {
			rr_end_comms_outage(player);
		}
	}
}

// --- Sabotage fix: Restart Generator (injected during Power Outage) ---
Task_Restart_Generator :: class : Task_Base {
	// UI state
	layout_initialized: bool;
	grab_offset: v2;
	handle_pos: v2;       // screen-space in pixels (same space as UI mouse)
	handle_home: v2;
	anchor_pos: v2;
	pulls_done: int;
	success_time: float;

	// Textures
	bg_texture: Texture_Asset;
	generator_texture: Texture_Asset;
	handle_texture: Texture_Asset;
	cord_texture: Texture_Asset;
	clock_texture: Texture_Asset;
	ponteiro_texture: Texture_Asset;

	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;
	PULLS_REQUIRED :: 3;

	start_attempt :: proc(using this: Task_Restart_Generator, player: Player) {
		if started {
			return;
		}
		started = true;
		layout_initialized = false;
		grab_offset = v2.{0.0, 0.0};
		handle_pos = v2.{0.0, 0.0};
		handle_home = v2.{0.0, 0.0};
		pulls_done = 0;
		success_time = 0.0;
	}

	cancel_attempt :: proc(using this: Task_Restart_Generator, player: Player) {
		if !started return;
		if completed return;
		started = false;
		layout_initialized = false;
		pulls_done = 0;
		success_time = 0.0;
	}

	init_textures :: proc(using this: Task_Restart_Generator) {
		bg_texture = get_asset(Texture_Asset, "sprites/tasks/generator/wall_bg.png");
		generator_texture = get_asset(Texture_Asset, "sprites/tasks/generator/generator.png");
		handle_texture = get_asset(Texture_Asset, "sprites/tasks/generator/Handle.png");
		cord_texture = get_asset(Texture_Asset, "sprites/tasks/generator/Cord.png");
		clock_texture = get_asset(Texture_Asset, "sprites/tasks/generator/Clock.png");
		ponteiro_texture = get_asset(Texture_Asset, "sprites/tasks/generator/Ponteiro.png");
	}

	init_layout :: proc(using this: Task_Restart_Generator, window_rect: Rect) {
		if layout_initialized {
			return;
		}
		layout_initialized = true;

		w := window_rect.width();
		h := window_rect.height();

		// Positions are based on the provided template.png (tuned for that art).
		// Anchor is where the cord starts at the generator.
		// IMPORTANT: template.png is the "pulled" state, so the HOME position should be
		// near the generator (not pulled).
		// Shifted up/left to land on the generator's gray port.
		anchor_pos = v2.{window_rect.min.x + w * 0.63, window_rect.min.y + h * 0.62};
		handle_home = v2.{anchor_pos.x - w * 0.12, anchor_pos.y + h * 0.02};
		handle_pos = handle_home;
	}

	rotate_about_point :: proc(point: v2, degrees: float) -> Matrix4 {
		return Matrix4.translate(point).multiply(Matrix4.rotate(degrees, v3.{0.0, 0.0, 1.0}).multiply(Matrix4.translate(-point)));
	}

	draw_generator_ui :: proc(using task: Task_Restart_Generator, player: Player, success_state: bool) {
		screen := UI.get_screen_rect();
		bg := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, bg, .{0.0, 0.0, 0.0, 0.85});

		// Task window (match other tasks)
		window_size := 1000.0;
		window_rect := screen.center_rect().grow(window_size / 2.0);
		window_rect = window_rect.fit_aspect(task.bg_texture.get_aspect(), .KEEP_HEIGHT);

		// Draw background wall
		UI.quad(window_rect, task.bg_texture, .{1, 1, 1, 1});

		// Close (top-right)
		if draw_task_close_button(window_rect, player, task) {
			return;
		}

		w := window_rect.width();
		h := window_rect.height();

		// Generator sprite on the right
		gen_h := h * 0.7;
		gen_w := gen_h * task.generator_texture.get_aspect();
		gen_center := v2.{window_rect.min.x + w * 0.80, window_rect.min.y + h * 0.50};
		gen_rect := Rect{gen_center, gen_center}.grow_unscaled(gen_h * 0.5, gen_w * 0.5, gen_h * 0.5, gen_w * 0.5);
		gen_rect = gen_rect.fit_aspect(task.generator_texture.get_aspect(), .KEEP_HEIGHT);
		UI.quad(gen_rect, task.generator_texture, .{1, 1, 1, 1});

		// Clock + pointer (upper-center of generator)
		clock_size := gen_rect.height() * 0.5;
		// Nudge slightly right/down to match the art.
		clock_center := v2.{gen_rect.min.x + gen_rect.width() * 0.58, gen_rect.min.y + gen_rect.height() * 0.6};
		clock_rect := Rect{clock_center, clock_center}.grow_unscaled(clock_size * 0.5, clock_size * 0.5, clock_size * 0.5, clock_size * 0.5);
		clock_rect = clock_rect.fit_aspect(task.clock_texture.get_aspect(), .KEEP_HEIGHT);
		UI.quad(clock_rect, task.clock_texture, .{1, 1, 1, 1});

		// Pointer behavior:
		// - Pull 0: stable at 0
		// - Pull 1/2: stronger wobble (but max angle is still limited)
		// - Pull 3: oscillates through the full 0..45 range (no resting at 45)
		progress01 := clamp((task.pulls_done.(float)) / (PULLS_REQUIRED.(float)), 0.0, 1.0);
		range_max := lerp(0.0, 45.0, progress01);

		freq := 9.0 + task.pulls_done.(float) * 4.0;
		sweep01 := 0.5 + 0.5 * sin(get_time() * freq);
		needle_angle := sweep01 * range_max;

		extra_amp := 0.0;
		if task.pulls_done >= 1 {
			// Emphasize wobble more at pulls 1 & 2.
			extra_amp = 10.0 + task.pulls_done.(float) * 6.0;
		}
		needle_angle = needle_angle + sin(get_time() * (freq * 2.35)) * extra_amp;
		needle_angle = clamp(needle_angle, 0.0, 45.0);

		// Pointer pivot should be bottom-right, not center.
		needle_h := clock_rect.height() * 0.50;
		needle_w := needle_h * task.ponteiro_texture.get_aspect();
		needle_pivot := clock_center - v2{0.0, clock_rect.height() * 0.4}; // bottom-right pivot point
		needle_rect := Rect{needle_pivot, needle_pivot}.grow_unscaled(needle_h, 0.0, 0.0, needle_w);

		UI.push_matrix(rotate_about_point(needle_pivot, -needle_angle));
		{
			UI.quad(needle_rect, task.ponteiro_texture, .{1, 1, 1, 1});
		}
		UI.pop_matrix();

		// Handle sizing
		handle_h := h * 0.52;
		handle_w := handle_h * task.handle_texture.get_aspect();

		// Cord anchor in window space
		anchor := task.anchor_pos;

		// Cord between anchor and the handle's connection point (near right side of the handle)
		handle_attach := task.handle_pos + v2.{handle_w * 0.32, -0.05};
		dir := handle_attach - anchor;
		dist := length(dir);
		if dist < 1.0 { dist = 1.0; }
		angle_deg := to_degrees(atan2(dir.y, dir.x));
		mid := (anchor + handle_attach) * 0.5;

		cord_thickness := h * 0.045;
		if cord_thickness < 7.0 { cord_thickness = 7.0; }
		cord_rect := Rect{mid, mid}.grow_unscaled(cord_thickness * 0.5, dist * 0.5, cord_thickness * 0.5, dist * 0.5);

		UI.quad(cord_rect, task.cord_texture, .{1, 1, 1, 1});

		// Handle interaction (drag left)
		handle_rect := Rect{task.handle_pos, task.handle_pos}.grow_unscaled(handle_h * 0.5, handle_w * 0.5, handle_h * 0.5, handle_w * 0.5);
		handle_rect = handle_rect.fit_aspect(task.handle_texture.get_aspect(), .KEEP_HEIGHT);

		UI.push_id("restart_generator_handle");
		defer UI.pop_id();

		btn_bs: Button_Settings = .{};
		rr_ui_apply_button_click_sound(ref btn_bs);
		interact := UI.button(handle_rect, btn_bs, .{}, "");

		if interact.clicked {
			task.grab_offset = task.handle_pos - interact.mouse_position;
		}

		if interact.active && !success_state {
			desired := interact.mouse_position + task.grab_offset;

			// Constrain to a horizontal pull (matches template behavior).
			desired.y = task.handle_home.y;

			// Clamp: only allow pulling left from home, and stop around the template extent.
			min_x := window_rect.min.x + w * 0.16;
			max_x := task.handle_home.x;
			desired.x = clamp(desired.x, min_x, max_x);

			task.handle_pos = desired;
		}

		// Draw handle sprite
		UI.quad(handle_rect, task.handle_texture, .{1, 1, 1, 1});

		// Pull completion check on release
		if interact.released && !success_state {
			// Success threshold: must pull close to the template "pulled" position.
			// (Template handle is far left.)
			pulled_x := window_rect.min.x + w * 0.18;
			success_pull := task.handle_pos.x <= pulled_x;

			// Snap back regardless
			task.handle_pos = task.handle_home;

			if success_pull {
				task.pulls_done += 1;
				rr_task_sfx(player, RR_TASK_SFX_LEVER, 0.7);
				if task.pulls_done >= PULLS_REQUIRED {
					task.success_time = get_time();
				}
			}
		}

		// Progress UI (bottom)
		info_rect := window_rect.bottom_center_rect().offset(0, 80);
		info_ts := UI.default_text_settings();
		info_ts.size = 46;
		info_ts.color = .{1, 1, 1, 1};
		info_ts.halign = .CENTER;
		info_ts.valign = .CENTER;
		info_ts.do_outline = true;
		info_ts.outline_thickness = 3;
		info_ts.outline_color = .{0, 0, 0, 1};

		if success_state {
			UI.text(info_rect, info_ts, "GENERATOR STARTED!");
		} else {
			UI.text(info_rect, info_ts, "PULL %/%", .{task.pulls_done, PULLS_REQUIRED});
		}
	}

	update_task :: proc(using this: Task_Restart_Generator, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}
		if !player.is_local_or_server() {
			return;
		}

		if bg_texture == null {
			init_textures(this);
		}

		// Success flow
		if success_time > 0.0 {
			elapsed := get_time() - success_time;
			if elapsed >= SUCCESS_DISPLAY_TIME {
				complete_attempt(this, player, true);
				// Server authoritative: ending the outage is global.
				if Game.is_server() && rr_power_outage_active {
					rr_end_power_outage(player);
				}
				return;
			}

			UI.push_layer(9700);
			defer UI.pop_layer();
			draw_generator_ui(this, player, true);
			return;
		}

		// Draw + interaction
		UI.push_layer(9700);
		defer UI.pop_layer();

		// Layout depends on window rect, so init inside draw call context
		screen := UI.get_screen_rect();
		window_size := 1000.0;
		window_rect := screen.center_rect().grow(window_size / 2.0);
		window_rect = window_rect.fit_aspect(bg_texture.get_aspect(), .KEEP_HEIGHT);
		init_layout(this, window_rect);

		draw_generator_ui(this, player, false);
	}
}

Task_Reroute_Power :: class : Task_Base {
	// --- Layout/constants ---
	GRID_W :: 4;
	GRID_H :: 4;
	GRID_CELLS :: GRID_W * GRID_H;

	// Window sizing (KEEP_HEIGHT). Make width a bit slimmer without shrinking height.
	WINDOW_SIZE :: 1000.0;

	// Grid layout (easy knobs)
	GRID_SIZE_FRAC :: 0.68;      // fraction of min(window_w, window_h)
	GRID_OFFSET_X_FRAC :: 0.001;   // fraction of window width
	GRID_OFFSET_Y_FRAC :: 0.091;  // fraction of window height (positive moves up)
	TILE_GAP_FRAC :: 0.0;       // fraction of per-cell size used as gap/inset
	WIRE_INSET_FRAC :: 0.02;     // fraction of per-cell size used as inner inset for wire art
	DRAG_PIECE_SCALE :: 0.90;    // relative to cell size

	// Tile kinds
	TILE_EMPTY :: 0;
	TILE_BLOCKER :: 1;
	TILE_STRAIGHT :: 2;
	TILE_CORNER :: 3;

	// Directions (row 0 is TOP)
	DIR_UP :: 0;
	DIR_RIGHT :: 1;
	DIR_DOWN :: 2;
	DIR_LEFT :: 3;

	// Preset puzzles (no runtime generation)
	PRESET_COUNT :: 5;
	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;

	// --- Textures ---
	bg_texture: Texture_Asset;
	lid_texture: Texture_Asset;
	blocker_texture: Texture_Asset;

	conn_left_texture: Texture_Asset;
	conn_left_on_texture: Texture_Asset;
	conn_right_texture: Texture_Asset;
	conn_right_on_texture: Texture_Asset;

	corner_texture: Texture_Asset;
	corner_on_texture: Texture_Asset;
	straight_h_texture: Texture_Asset;
	straight_h_on_texture: Texture_Asset;
	straight_v_texture: Texture_Asset;
	straight_v_on_texture: Texture_Asset;

	// --- State ---
	rng_initialized: bool;
	generated: bool;
	preset_idx: int;
	start_row: int; // 0..3 (TOP to BOTTOM)
	end_row: int;   // 0..3 (TOP to BOTTOM)

	revealed: [..]bool;
	tile_kind: [..]int; // TILE_*
	tile_rot: [..]int;  // straight: 0=horiz,1=vert ; corner: 0..3 (rot*90)
	// Reused buffers to avoid large stack locals in hot paths.
	connected_cache: [..]bool;
	bfs_queue: [..]int;

	dragging: bool;
	drag_from: int;
	drag_kind: int;
	drag_rot: int;
	drag_offset: v2;
	drag_pos: v2;

	success_time: float;

	start_attempt :: proc(using this: Task_Reroute_Power, player: Player) {
		if started {
			return;
		}
		started = true;
		ensure_grid_buffers(this);
		// Reset UI/puzzle state for a fresh attempt.
		generated = false;
		dragging = false;
		success_time = 0.0;
	}

	ensure_grid_buffers :: proc(using this: Task_Reroute_Power) {
		if revealed.count == GRID_CELLS &&
			tile_kind.count == GRID_CELLS &&
			tile_rot.count == GRID_CELLS &&
			connected_cache.count == GRID_CELLS &&
			bfs_queue.count == GRID_CELLS {
			return;
		}

		revealed.clear();
		tile_kind.clear();
		tile_rot.clear();
		connected_cache.clear();
		bfs_queue.clear();

		for i: 0..GRID_CELLS-1 {
			revealed.append(false);
			tile_kind.append(TILE_EMPTY);
			tile_rot.append(0);
			connected_cache.append(false);
			bfs_queue.append(0);
		}
	}

	init_textures :: proc(using this: Task_Reroute_Power) {
		bg_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_Box.png");
		lid_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_RemovableLid.png");
		blocker_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_Blocker.png");

		conn_left_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_ConnectorLeft.png");
		conn_left_on_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_ConnectorLeftON.png");
		conn_right_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_ConnectorRight.png");
		conn_right_on_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_ConnectorRightON.png");

		corner_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_CornerWires.png");
		corner_on_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_CornerWiresON.png");
		straight_h_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_StraightHoriz.png");
		straight_h_on_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_StraightHorizON.png");
		straight_v_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_StraightVert.png");
		straight_v_on_texture = get_asset(Texture_Asset, "sprites/tasks/electrical_routing/ER_StraightVertON.png");

		// Some ON variants may not exist; fall back safely.
		if conn_left_on_texture == null { conn_left_on_texture = conn_left_texture; }
		if conn_right_on_texture == null { conn_right_on_texture = conn_right_texture; }
		if corner_on_texture == null { corner_on_texture = corner_texture; }
		if straight_h_on_texture == null { straight_h_on_texture = straight_h_texture; }
		if straight_v_on_texture == null { straight_v_on_texture = straight_v_texture; }
	}

	rotate_about_point :: proc(point: v2, degrees: float) -> Matrix4 {
		return Matrix4.translate(point).multiply(Matrix4.rotate(degrees, v3.{0.0, 0.0, 1.0}).multiply(Matrix4.translate(-point)));
	}

	tile_index :: proc(x: int, row: int) -> int {
		return row * GRID_W + x;
	}

	tile_xy :: proc(idx: int, x: ref int, row: ref int) {
		row = idx / GRID_W;
		x = idx - row * GRID_W;
	}

	is_wire_kind :: proc(kind: int) -> bool {
		return kind == TILE_STRAIGHT || kind == TILE_CORNER;
	}

	get_mask_for_piece :: proc(kind: int, rot: int) -> int {
		if kind == TILE_STRAIGHT {
			if rot == 1 {
				// vertical
				return (1 << DIR_UP) | (1 << DIR_DOWN);
			}
			// horizontal
			return (1 << DIR_LEFT) | (1 << DIR_RIGHT);
		}

		if kind == TILE_CORNER {
			r := rot;
			while r < 0 { r += 4; }
			while r >= 4 { r -= 4; }
			// Base corner (rot=0): UP + RIGHT
			if r == 0 { return (1 << DIR_UP) | (1 << DIR_RIGHT); }
			if r == 1 { return (1 << DIR_RIGHT) | (1 << DIR_DOWN); }
			if r == 2 { return (1 << DIR_DOWN) | (1 << DIR_LEFT); }
			return (1 << DIR_LEFT) | (1 << DIR_UP);
		}

		return 0;
	}

	get_tile_mask :: proc(using this: Task_Reroute_Power, idx: int) -> int {
		return get_mask_for_piece(tile_kind[idx], tile_rot[idx]);
	}

	set_tile :: proc(using this: Task_Reroute_Power, idx: int, kind: int, rot: int) {
		if idx < 0 || idx >= GRID_CELLS {
			return;
		}
		tile_kind[idx] = kind;
		tile_rot[idx] = rot;
	}

	apply_preset :: proc(using this: Task_Reroute_Power, which: int) {
		// Clear everything.
		for i: 0..GRID_CELLS-1 {
			revealed[i] = false;
			tile_kind[i] = TILE_EMPTY;
			tile_rot[i] = 0;
		}
		dragging = false;
		success_time = 0.0;

		// NOTE: Row 0 is TOP, row 3 is BOTTOM.
		switch which {
			// Preset 0: bottom-left to top-right (scrambled)
			case 0: {
				start_row = 3;
				end_row = 0;

				set_tile(this, 2, TILE_BLOCKER, 0);
				set_tile(this, 4, TILE_BLOCKER, 0);

				set_tile(this, 1, TILE_CORNER, 1);
				set_tile(this, 3, TILE_CORNER, 3);
				set_tile(this, 6, TILE_CORNER, 3);
				set_tile(this, 9, TILE_CORNER, 1);
				set_tile(this, 12, TILE_STRAIGHT, 0);
				set_tile(this, 14, TILE_CORNER, 1);
				set_tile(this, 15, TILE_CORNER, 3);
			}

			// Preset 1: top-left to bottom-right (scrambled)
			case 1: {
				start_row = 0;
				end_row = 3;

				set_tile(this, 10, TILE_BLOCKER, 0);
				set_tile(this, 13, TILE_BLOCKER, 0);

				set_tile(this, 0, TILE_CORNER, 0);
				set_tile(this, 2, TILE_CORNER, 2);
				set_tile(this, 3, TILE_STRAIGHT, 0);
				set_tile(this, 5, TILE_CORNER, 2);
				set_tile(this, 4, TILE_STRAIGHT, 1);
				set_tile(this, 7, TILE_STRAIGHT, 1);
				set_tile(this, 6, TILE_CORNER, 0);
				set_tile(this, 8, TILE_CORNER, 1);
				set_tile(this, 11, TILE_CORNER, 3);
			}

			// Preset 2: mid-left to mid-right (all corners, scrambled)
			case 2: {
				start_row = 1;
				end_row = 1;

				set_tile(this, 0, TILE_BLOCKER, 0);
				set_tile(this, 15, TILE_BLOCKER, 0);

				// NOTE: This preset must be solvable without rotating pieces (only swapping).
				// The previous corner rotations made it impossible to ever connect left-to-right.
				set_tile(this, 1, TILE_CORNER, 1);
				set_tile(this, 3, TILE_CORNER, 3);
				set_tile(this, 4, TILE_CORNER, 0);
				set_tile(this, 5, TILE_CORNER, 2);
				set_tile(this, 6, TILE_CORNER, 3);
				set_tile(this, 7, TILE_CORNER, 1);
				set_tile(this, 9, TILE_CORNER, 0);
				set_tile(this, 12, TILE_CORNER, 2);
			}

			// Preset 3: mid-left to top-right (includes vertical straight, scrambled)
			case 3: {
				start_row = 2;
				end_row = 0;

				set_tile(this, 5, TILE_BLOCKER, 0);
				set_tile(this, 14, TILE_BLOCKER, 0);

				set_tile(this, 1, TILE_STRAIGHT, 1);
				set_tile(this, 2, TILE_CORNER, 1);
				set_tile(this, 6, TILE_STRAIGHT, 0);
				set_tile(this, 8, TILE_CORNER, 3);
				set_tile(this, 9, TILE_STRAIGHT, 0);
				set_tile(this, 12, TILE_STRAIGHT, 0);
			}

			// Preset 4: mid-left to lower-right (simpler, scrambled)
			case 4: {
				start_row = 1;
				end_row = 2;

				set_tile(this, 0, TILE_BLOCKER, 0);
				set_tile(this, 15, TILE_BLOCKER, 0);

				set_tile(this, 4, TILE_STRAIGHT, 0);
				set_tile(this, 7, TILE_STRAIGHT, 0);
				set_tile(this, 10, TILE_CORNER, 0);
				set_tile(this, 11, TILE_STRAIGHT, 0);
				set_tile(this, 13, TILE_CORNER, 2);
			}

			default: {
				apply_preset(this, 0);
			}
		}
	}

	generate_puzzle :: proc(using this: Task_Reroute_Power) {
		if generated {
			return;
		}
		ensure_grid_buffers(this);
		if !rng_initialized {
			rng_initialized = true;
			rr_refresh_rng_state();
		}

		preset_idx = rng_range_int(ref rr_rng_state.value, 0, PRESET_COUNT-1);
		apply_preset(this, preset_idx);
		generated = true;
	}

	compute_connected_from_left :: proc(using this: Task_Reroute_Power) -> bool {
		for i: 0..GRID_CELLS-1 {
			connected_cache[i] = false;
		}

		start_idx := tile_index(0, start_row);
		end_idx := tile_index(GRID_W-1, end_row);

		if !is_wire_kind(tile_kind[start_idx]) {
			return false;
		}
		start_mask := get_tile_mask(this, start_idx);
		if (start_mask & (1 << DIR_LEFT)) == 0 {
			return false;
		}

		q_head := 0;
		q_tail := 0;

		bfs_queue[q_tail] = start_idx;
		q_tail += 1;
		connected_cache[start_idx] = true;

		while q_head < q_tail {
			cur := bfs_queue[q_head];
			q_head += 1;

			cur_x: int;
			cur_row: int;
			tile_xy(cur, ref cur_x, ref cur_row);

			mask := get_tile_mask(this, cur);
			for dir: 0..3 {
				if (mask & (1 << dir)) == 0 {
					continue;
				}

				nx := cur_x;
				ny := cur_row;
				if dir == DIR_UP { ny -= 1; }
				if dir == DIR_DOWN { ny += 1; }
				if dir == DIR_LEFT { nx -= 1; }
				if dir == DIR_RIGHT { nx += 1; }

				// Outside grid connections: only meaningful for start (left) / end (right)
				if nx < 0 || nx >= GRID_W || ny < 0 || ny >= GRID_H {
					continue;
				}

				nidx := tile_index(nx, ny);
				if !is_wire_kind(tile_kind[nidx]) {
					continue;
				}

				opp := dir + 2;
				if opp >= 4 { opp -= 4; }
				nmask := get_tile_mask(this, nidx);
				if (nmask & (1 << opp)) == 0 {
					continue;
				}

				if !connected_cache[nidx] {
					connected_cache[nidx] = true;
					bfs_queue[q_tail] = nidx;
					q_tail += 1;
				}
			}
		}

		// Solved if we can reach the end cell AND it has a right-facing connection.
		if connected_cache[end_idx] && (get_tile_mask(this, end_idx) & (1 << DIR_RIGHT)) != 0 {
			return true;
		}
		return false;
	}

	point_in_rect :: proc(p: v2, r: Rect) -> bool {
		if p.x < r.min.x return false;
		if p.x > r.max.x return false;
		if p.y < r.min.y return false;
		if p.y > r.max.y return false;
		return true;
	}

	draw_piece :: proc(using this: Task_Reroute_Power, rect: Rect, kind: int, rot: int, is_on: bool) {
		if kind == TILE_STRAIGHT {
			tex := straight_h_texture;
			if rot == 1 {
				tex = straight_v_texture;
				if is_on { tex = straight_v_on_texture; }
			} else {
				if is_on { tex = straight_h_on_texture; }
			}

			r := rect.fit_aspect(tex.get_aspect(), .KEEP_HEIGHT);
			UI.quad(r, tex, .{1, 1, 1, 1});
			return;
		}

		if kind == TILE_CORNER {
			tex := corner_texture;
			if is_on { tex = corner_on_texture; }

			r := rect.fit_aspect(tex.get_aspect(), .KEEP_HEIGHT);
			center := r.center();
			deg := rot.(float) * 90.0;

			UI.push_matrix(rotate_about_point(center, -deg));
			defer UI.pop_matrix();
			UI.quad(r, tex, .{1, 1, 1, 1});
			return;
		}
	}

	draw_reroute_power_ui :: proc(using this: Task_Reroute_Power, player: Player, success_state: bool) {
		screen := UI.get_screen_rect();
		dim := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, dim, .{0.0, 0.0, 0.0, 0.85});

		// Safety: if textures failed to load, don't try to draw UI (can crash native).
		if bg_texture == null || lid_texture == null || blocker_texture == null {
			return;
		}

		window_size := WINDOW_SIZE;
		window_rect := screen.center_rect().grow(window_size / 2.0);
		window_rect = window_rect.fit_aspect(bg_texture.get_aspect(), .KEEP_HEIGHT);

		UI.quad(window_rect, bg_texture, .{1, 1, 1, 1});

		// Close (top-right)
		if draw_task_close_button(window_rect, player, this) {
			return;
		}

		w := window_rect.width();
		h := window_rect.height();

		// Grid rect derived from size + offset knobs.
		grid_size := min(w, h) * GRID_SIZE_FRAC;
		grid_rect := window_rect.center_rect().grow_unscaled(grid_size * 0.5, grid_size * 0.5, grid_size * 0.5, grid_size * 0.5);
		grid_rect = grid_rect.offset_unscaled(w * GRID_OFFSET_X_FRAC, h * GRID_OFFSET_Y_FRAC);

		cell_w := grid_rect.width() / (GRID_W.(float));
		cell_h := grid_rect.height() / (GRID_H.(float));
		cell_size := min(cell_w, cell_h);
		cell_pad := cell_size * TILE_GAP_FRAC;
		wire_inset := cell_size * WIRE_INSET_FRAC;

		// Connectivity highlight
		solved := compute_connected_from_left(this);

		// Connectors (always visible)
		start_idx := tile_index(0, start_row);
		end_idx := tile_index(GRID_W-1, end_row);

		left_on := connected_cache[start_idx];
		right_on := solved;

		conn_h := cell_h * 0.9;
		conn_tex := left_on ? conn_left_on_texture : conn_left_texture;
		conn_w := conn_h * conn_tex.get_aspect();

		// row 0 is TOP, so flip y like other grid UIs.
		y1s := 1.0 - ((start_row.(f32) + 1.0) / GRID_H.(f32));
		y2s := 1.0 - (start_row.(f32) / GRID_H.(f32));
		start_row_rect := grid_rect.subrect(0.0, y1s, 1.0, y2s);
		start_center_y := start_row_rect.center().y;
		left_center := v2.{grid_rect.min.x - conn_w * 0.35, start_center_y};
		left_rect := Rect.{left_center - v2.{conn_w * 0.5, conn_h * 0.5}, left_center + v2.{conn_w * 0.5, conn_h * 0.5}};
		UI.quad(left_rect, conn_tex, .{1, 1, 1, 1});

		conn_tex_r := right_on ? conn_right_on_texture : conn_right_texture;
		conn_w_r := conn_h * conn_tex_r.get_aspect();
		y1e := 1.0 - ((end_row.(f32) + 1.0) / GRID_H.(f32));
		y2e := 1.0 - (end_row.(f32) / GRID_H.(f32));
		end_row_rect := grid_rect.subrect(0.0, y1e, 1.0, y2e);
		end_center_y := end_row_rect.center().y;
		right_center := v2.{grid_rect.max.x + conn_w_r * 0.35, end_center_y};
		right_rect := Rect.{right_center - v2.{conn_w_r * 0.5, conn_h * 0.5}, right_center + v2.{conn_w_r * 0.5, conn_h * 0.5}};
		UI.quad(right_rect, conn_tex_r, .{1, 1, 1, 1});

		// Drag capture: reuse the SAME id as the grabbed tile so input stays active
		// even when the pointer leaves the original tile rect.
		drag_release_pos := v2.{0, 0};
		drag_released := false;
		if dragging {
			UI.push_id("reroute_cell_%", .{drag_from});
			defer UI.pop_id();

			btn_bs: Button_Settings = .{};
			rr_ui_apply_button_click_sound(ref btn_bs);
			interact := UI.button(screen, btn_bs, .{}, "");
			drag_pos = interact.mouse_position + drag_offset;
			if interact.released {
				drag_released = true;
				drag_release_pos = interact.mouse_position;
			}
		}

		// Tiles
		// When dragging or in success-state, draw-only (no buttons) to avoid duplicate ids
		// and to keep pointer capture stable.
		if dragging || success_state {
			for row: 0..GRID_H-1 {
				for col: 0..GRID_W-1 {
					// y from top
					y1 := 1.0 - ((row.(f32) + 1.0) / GRID_H.(f32));
					y2 := 1.0 - (row.(f32) / GRID_H.(f32));
					x1 := col.(f32) / GRID_W.(f32);
					x2 := (col.(f32) + 1.0) / GRID_W.(f32);

					cell := grid_rect.subrect(x1, y1, x2, y2);
					cell = cell.inset_unscaled(cell_pad, cell_pad, cell_pad, cell_pad);

					idx := tile_index(col, row);

					if !revealed[idx] {
						lid := cell.fit_aspect(lid_texture.get_aspect(), .KEEP_HEIGHT);
						UI.quad(lid, lid_texture, .{1, 1, 1, 1});
						continue;
					}

					if tile_kind[idx] == TILE_BLOCKER {
						b := cell.fit_aspect(blocker_texture.get_aspect(), .KEEP_HEIGHT);
						UI.quad(b, blocker_texture, .{1, 1, 1, 1});
						continue;
					}

					if is_wire_kind(tile_kind[idx]) {
						piece_rect := cell.inset_unscaled(wire_inset, wire_inset, wire_inset, wire_inset);
						draw_piece(this, piece_rect, tile_kind[idx], tile_rot[idx], connected_cache[idx]);
					}
				}
			}
		} else {
			for row: 0..GRID_H-1 {
				for col: 0..GRID_W-1 {
					// y from top
					y1 := 1.0 - ((row.(f32) + 1.0) / GRID_H.(f32));
					y2 := 1.0 - (row.(f32) / GRID_H.(f32));
					x1 := col.(f32) / GRID_W.(f32);
					x2 := (col.(f32) + 1.0) / GRID_W.(f32);

					cell := grid_rect.subrect(x1, y1, x2, y2);
					cell = cell.inset_unscaled(cell_pad, cell_pad, cell_pad, cell_pad);

					idx := tile_index(col, row);

					UI.push_id("reroute_cell_%", .{idx});

					btn_bs: Button_Settings = .{};
					rr_ui_apply_button_click_sound(ref btn_bs);
					interact := UI.button(cell, btn_bs, .{}, "");

					if !revealed[idx] {
						// Tap to reveal
						lid := cell.fit_aspect(lid_texture.get_aspect(), .KEEP_HEIGHT);
						UI.quad(lid, lid_texture, .{1, 1, 1, 1});
						if interact.clicked {
							revealed[idx] = true;
							rr_task_sfx(player, RR_TASK_SFX_TILE_CLICK, 0.5);
						}
						UI.pop_id();
						continue;
					}

					// Revealed contents
					if tile_kind[idx] == TILE_BLOCKER {
						b := cell.fit_aspect(blocker_texture.get_aspect(), .KEEP_HEIGHT);
						UI.quad(b, blocker_texture, .{1, 1, 1, 1});
						UI.pop_id();
						continue;
					}

					// Start dragging on press (or click) so it feels like true drag&drop.
					// Some platforms only report "clicked" on release, so allow `active` too.
					if (interact.clicked || interact.active) && is_wire_kind(tile_kind[idx]) {
						dragging = true;
						drag_from = idx;
						drag_kind = tile_kind[idx];
						drag_rot = tile_rot[idx];

						// Remove from board while dragging.
						tile_kind[idx] = TILE_EMPTY;
						tile_rot[idx] = 0;

						drag_offset = (cell.center() - interact.mouse_position);
						drag_pos = interact.mouse_position + drag_offset;
					}

					// Draw wire if present (and not the one currently being dragged).
					if is_wire_kind(tile_kind[idx]) {
						piece_rect := cell.inset_unscaled(wire_inset, wire_inset, wire_inset, wire_inset);
						draw_piece(this, piece_rect, tile_kind[idx], tile_rot[idx], connected_cache[idx]);
					}

					UI.pop_id();
				}
			}
		}

		// Handle drop (after laying out cell rects).
		if dragging && drag_released {
			dropped := false;
			found_target := false;

			// Find target cell under release position (must be revealed and not a blocker).
			for row: 0..GRID_H-1 {
				for col: 0..GRID_W-1 {
					y1 := 1.0 - ((row.(f32) + 1.0) / GRID_H.(f32));
					y2 := 1.0 - (row.(f32) / GRID_H.(f32));
					x1 := col.(f32) / GRID_W.(f32);
					x2 := (col.(f32) + 1.0) / GRID_W.(f32);

					cell := grid_rect.subrect(x1, y1, x2, y2);
					cell = cell.inset_unscaled(cell_pad, cell_pad, cell_pad, cell_pad);

					if !point_in_rect(drag_release_pos, cell) {
						continue;
					}
					found_target = true;

					idx := tile_index(col, row);
					if !revealed[idx] {
						break;
					}
					if tile_kind[idx] == TILE_BLOCKER {
						break;
					}

					// Drop-on-self should just put it back (otherwise it can "swap" with empty
					// and end up clearing itself).
					if idx == drag_from {
						tile_kind[drag_from] = drag_kind;
						tile_rot[drag_from] = drag_rot;
					} else {
						// Swap with target wire (or drop into empty)
						target_kind := tile_kind[idx];
						target_rot := tile_rot[idx];

						tile_kind[idx] = drag_kind;
						tile_rot[idx] = drag_rot;

						tile_kind[drag_from] = target_kind;
						tile_rot[drag_from] = target_rot;
						rr_task_sfx(player, RR_TASK_SFX_TILE_CLICK, 0.5);
					}

					dropped = true;
					break;
				}
				if dropped || found_target {
					break;
				}
			}

			// Invalid drop: return to origin.
			if !dropped {
				tile_kind[drag_from] = drag_kind;
				tile_rot[drag_from] = drag_rot;
			}

			dragging = false;
		}

		// Draw dragged piece on top.
		if dragging {
			tex_h := cell_size * DRAG_PIECE_SCALE;
			// Use a square-ish drag rect centered at drag_pos; then fit by texture aspect.
			drag_rect := Rect.{drag_pos - v2.{tex_h * 0.6, tex_h * 0.6}, drag_pos + v2.{tex_h * 0.6, tex_h * 0.6}};
			draw_piece(this, drag_rect, drag_kind, drag_rot, false);
		}

		// Feedback
		if success_state {
			success_rect := window_rect.cut_top(70).offset(0, 15);
			success_ts := UI.default_text_settings();
			success_ts.size = 56;
			success_ts.color = .{0.3, 1.0, 0.4, 1.0};
			success_ts.halign = .CENTER;
			success_ts.valign = .CENTER;
			UI.text(success_rect, success_ts, "POWER RESTORED!");
		}
	}

	update_task :: proc(using this: Task_Reroute_Power, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}
		if !player.is_local_or_server() {
			return;
		}

		if bg_texture == null {
			init_textures(this);
		}
		generate_puzzle(this);

		now := get_time();
		if success_time > 0.0 {
			if (now - success_time) >= SUCCESS_DISPLAY_TIME {
				complete_attempt(this, player, true);
				return;
			}
			UI.push_layer(9700);
			defer UI.pop_layer();
			draw_reroute_power_ui(this, player, true);
			return;
		}

		// Check completion after any move/reveal; set success_time when solved.
		if compute_connected_from_left(this) {
			success_time = now;
			rr_task_sfx(player, RR_TASK_SFX_ZAP, 0.7);
		}

		UI.push_layer(9700);
		defer UI.pop_layer();
		draw_reroute_power_ui(this, player, false);
	}
}

Task_Guide_The_Electron :: class : Task_Base {
	// UI / lifecycle
	ui_active: bool;
	layout_initialized: bool;
	last_update_time: float;
	success_time: float;
	fail_time: float;

	// Lives
	MAX_LIVES :: 3;
	lives: int;
	seen_attempt_id: int;

	// Assets
	bg_texture: Texture_Asset;
	finish_texture: Texture_Asset;
	start_token_texture: Texture_Asset;
	electron_textures: [3]Texture_Asset;
	wall_textures: [3]Texture_Asset;

	// Gameplay
	rng_initialized: bool;
	rng: u64;
	attempt_seed_counter: u64;

	electron_pos: v2;
	electron_grab_offset: v2;

	COLUMN_COUNT :: 5;
	SEG_MAX :: 48;

	column_x: [..]float;            // world X positions
	// Each column is a repeating list of segments; each segment wraps individually.
	segment_count: int;
	segment_y: [..]float;  // world-space Y centers for each segment (flattened [COLUMN_COUNT * SEG_MAX])
	hole_index: [..]int;            // middle segment to omit (hole is one segment big)

	// Cached sizing for gameplay logic (set in init_layout)
	play_rect_cached: Rect;
	seg_thickness: float;
	seg_length: float;
	seg_draw_length: float; // slightly smaller to prevent overlap
	seg_step: float;
	hole_half: float;
	electron_radius: float;

	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;
	FAIL_FLASH_TIME :: 0.35;

	start_attempt :: proc(using this: Task_Guide_The_Electron, player: Player) {
		if started {
			return;
		}
		started = true;
		ui_active = true;
		layout_initialized = false;
		last_update_time = 0.0;
		success_time = 0.0;
		fail_time = 0.0;
		lives = MAX_LIVES;
		attempt_seed_counter += 1;
		rng_initialized = true;
		rng = rng_seed(rng_root_seed() + player.entity.id + attempt_seed_counter * 7919);
	}

	init_textures :: proc(using this: Task_Guide_The_Electron) {
		bg_texture = get_asset(Texture_Asset, "sprites/tasks/guide_the_electron/bg.png");
		finish_texture = get_asset(Texture_Asset, "sprites/tasks/guide_the_electron/finish_line.png");
		start_token_texture = get_asset(Texture_Asset, "sprites/tasks/guide_the_electron/electron_around_atom.png");

		electron_textures[0] = get_asset(Texture_Asset, "sprites/tasks/guide_the_electron/electron_1.png");
		electron_textures[1] = get_asset(Texture_Asset, "sprites/tasks/guide_the_electron/electron_2.png");
		electron_textures[2] = get_asset(Texture_Asset, "sprites/tasks/guide_the_electron/electron_3.png");

		wall_textures[0] = get_asset(Texture_Asset, "sprites/tasks/guide_the_electron/electric_wall+segment_1.png");
		wall_textures[1] = get_asset(Texture_Asset, "sprites/tasks/guide_the_electron/electric_wall+segment_2.png");
		wall_textures[2] = get_asset(Texture_Asset, "sprites/tasks/guide_the_electron/electric_wall+segment_3.png");
	}

	segment_index :: proc(using this: Task_Guide_The_Electron, column: int, segment: int) -> int {
		return column * SEG_MAX + segment;
	}

	ensure_layout_buffers :: proc(using this: Task_Guide_The_Electron) {
		required_segment_slots := COLUMN_COUNT * SEG_MAX;
		if column_x.count == COLUMN_COUNT &&
			hole_index.count == COLUMN_COUNT &&
			segment_y.count == required_segment_slots {
			return;
		}

		column_x.clear();
		hole_index.clear();
		segment_y.clear();

		for i: 0..COLUMN_COUNT-1 {
			column_x.append(0.0);
			hole_index.append(0);
		}
		for i: 0..required_segment_slots-1 {
			segment_y.append(0.0);
		}
	}

	compute_play_rect :: proc(using this: Task_Guide_The_Electron, window_rect: Rect) -> Rect {
		w := window_rect.width();
		h := window_rect.height();

		// Inner screen area (avoid metal frame). Right side includes the clamp graphics,
		// so keep the inset modest there.
		inset_l := w * 0.040;
		inset_r := w * 0.040;
		inset_b := h * 0.065;
		inset_t := h * 0.075;

		return Rect.{
			v2.{window_rect.min.x + inset_l, window_rect.min.y + inset_b},
			v2.{window_rect.max.x - inset_r, window_rect.max.y - inset_t}
		};
	}

	init_layout :: proc(using this: Task_Guide_The_Electron, window_rect: Rect) {
		if layout_initialized {
			return;
		}
		layout_initialized = true;

		if !rng_initialized {
			rng_initialized = true;
			rng = rng_seed(rng_root_seed() + attempt_seed_counter * 7919);
		}
		ensure_layout_buffers(this);

		play_rect_cached = compute_play_rect(this, window_rect);
		pw := play_rect_cached.width();
		ph := play_rect_cached.height();

		// Electron sizing + initial position (left side)
		e_h := ph * 0.14;
		e_w := e_h * electron_textures[0].get_aspect();
		electron_radius = min(e_w, e_h) * 0.32;

		electron_pos = v2.{play_rect_cached.min.x + pw * 0.13, play_rect_cached.min.y + ph * 0.50};
		electron_grab_offset = v2.{0, 0};

		// Wall segment sizing (we rotate the horizontal sprite 90 degrees to form vertical columns)
		seg_thickness = pw * 0.030;
		if seg_thickness < ph * 0.028 { seg_thickness = ph * 0.028; }
		if seg_thickness > ph * 0.060 { seg_thickness = ph * 0.060; }

		seg_length = seg_thickness * wall_textures[0].get_aspect(); // along Y after rotation
		// One "slot" per segment. Prevent visible overlap by drawing slightly shorter than the slot.
		seg_step = seg_length;
		seg_draw_length = seg_length * 0.98;

		// Hole is exactly one segment slot (middle segment removed).
		hole_half = seg_step * 0.5;

		// Columns between start and finish.
		left_x := play_rect_cached.min.x + pw * 0.38;
		right_x := play_rect_cached.min.x + pw * 0.74;
		denom := (COLUMN_COUNT - 1).(float);
		for i: 0..COLUMN_COUNT-1 {
			t := 0.0;
			if denom > 0.0 {
				t = i.(float) / denom;
			}
			column_x[i] = lerp(left_x, right_x, t);
		}

		// Initialize per-segment positions so each segment can wrap individually.
		segment_count = ((ph + seg_step * 4.0) / seg_step).(int) + 2;
		if segment_count > SEG_MAX { segment_count = SEG_MAX; }
		if segment_count < 7 { segment_count = 7; } // ensure a clear "middle" exists

		middle := segment_count / 2;
		total_span := segment_count.(float) * seg_step;

		for c: 0..COLUMN_COUNT-1 {
			// Random offset of up to half a segment to each column.
			off := rng_range_float(ref rng, -0.5 * seg_step, 0.5 * seg_step);

			// Center the hole around the middle of the play rect.
			hole_center := play_rect_cached.min.y + ph * 0.5 + off;
			start_y := hole_center - middle.(float) * seg_step;

			hole_index[c] = middle;
			for i: 0..segment_count-1 {
				segment_y[segment_index(this, c, i)] = start_y + i.(float) * seg_step;
			}
		}
	}

	draw_rotated_quad :: proc(using this: Task_Guide_The_Electron, rect: Rect, texture: Texture_Asset, degrees: float, color: v4) {
		center := rect.center();
		UI.push_matrix(Matrix4.rotate_about_point(center, degrees));
		defer UI.pop_matrix();
		UI.quad(rect, texture, color);
	}

	clamp_electron_to_play :: proc(using this: Task_Guide_The_Electron, play_rect: Rect) {
		min_x := play_rect.min.x + electron_radius;
		max_x := play_rect.max.x - electron_radius;
		min_y := play_rect.min.y + electron_radius;
		max_y := play_rect.max.y - electron_radius;

		electron_pos.x = clamp(electron_pos.x, min_x, max_x);
		electron_pos.y = clamp(electron_pos.y, min_y, max_y);
	}

	check_circle_aabb_collision :: proc(using this: Task_Guide_The_Electron, center: v2, radius: float, rect: Rect) -> bool {
		dx := 0.0;
		if center.x < rect.min.x {
			dx = rect.min.x - center.x;
		} else if center.x > rect.max.x {
			dx = center.x - rect.max.x;
		}

		dy := 0.0;
		if center.y < rect.min.y {
			dy = rect.min.y - center.y;
		} else if center.y > rect.max.y {
			dy = center.y - rect.max.y;
		}

		return (dx * dx + dy * dy) <= (radius * radius);
	}

	update_task :: proc(using this: Task_Guide_The_Electron, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}
		if !player.is_local_or_server() {
			return;
		}

		if bg_texture == null {
			init_textures(this);
		}

		// Per-attempt init (start_attempt is not dynamically dispatched).
		if seen_attempt_id != attempt_id {
			seen_attempt_id = attempt_id;
			ui_active = true;
			layout_initialized = false;
			last_update_time = 0.0;
			success_time = 0.0;
			fail_time = 0.0;
			lives = MAX_LIVES;
			rng_initialized = false;
		}

		now := get_time();
		dt := 0.0;
		if last_update_time > 0.0 {
			dt = now - last_update_time;
			dt = clamp(dt, 0.0, 0.05);
		}
		last_update_time = now;

		// Modal darkening + task window (match other tasks)
		screen := UI.get_screen_rect();
		modal_bg := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, modal_bg, .{0.0, 0.0, 0.0, 0.85});

		window_size := 1000.0;
		window_rect := screen.center_rect().grow(window_size / 2.0);
		window_rect = window_rect.fit_aspect(bg_texture.get_aspect(), .KEEP_HEIGHT);
		UI.quad(window_rect, bg_texture, .{1, 1, 1, 1});

		// Close (top-right)
		if draw_task_close_button(window_rect, player, this) {
			ui_active = false;
			layout_initialized = false;
			return;
		}

		// Setup layout once (depends on textures)
		init_layout(this, window_rect);

		// Success flow
		if success_time > 0.0 {
			elapsed := now - success_time;
			if elapsed >= SUCCESS_DISPLAY_TIME {
				ui_active = false;
				complete_attempt(this, player, true);
				return;
			}
		}

		play_rect := compute_play_rect(this, window_rect);

		// Keep cached play rect in sync in case resolution/UI scale changes mid-attempt.
		play_rect_cached = play_rect;
	
		// Finish line placement: centered between the two clamp "pointers" on the right side.
		w := window_rect.width();
		h := window_rect.height();
		finish_h := h * 0.55;
		finish_w := finish_h * finish_texture.get_aspect();
		finish_center := v2.{window_rect.min.x + w * 0.84, window_rect.min.y + h * 0.50};
		finish_rect := window_rect.bottom_left_rect()
			.offset_unscaled(finish_center.x - window_rect.min.x, finish_center.y - window_rect.min.y)
			.grow_unscaled(finish_h * 0.5, finish_w * 0.5, finish_h * 0.5, finish_w * 0.5);
		UI.quad(finish_rect, finish_texture, .{1, 1, 1, 1});

		// Lives display (electron tokens on the left side)
		token_h := play_rect.height() * 0.11;
		token_w := token_h * start_token_texture.get_aspect();
		for i: 0..lives-1 {
			t := i.(float);
			pct := 0.42 - t * 0.12;
			p := v2.{play_rect.min.x + play_rect.width() * 0.15, play_rect.min.y + play_rect.height() * (0.5 + pct)};
			r := window_rect.bottom_left_rect()
				.offset_unscaled(p.x - window_rect.min.x, p.y - window_rect.min.y)
				.grow_unscaled(token_h * 0.5, token_w * 0.5, token_h * 0.5, token_w * 0.5);
			UI.quad(r, start_token_texture, .{1, 1, 1, 1});
		}

		// Scroll wall columns upward (segment-by-segment wrapping)
		scroll_speed := play_rect.height() * 0.28;
		total_span := segment_count.(float) * seg_step;
		wrap_y := play_rect.max.y + seg_step * 1.5;
		for c: 0..COLUMN_COUNT-1 {
			for i: 0..segment_count-1 {
				idx := segment_index(this, c, i);
				segment_y[idx] += scroll_speed * dt;
				if segment_y[idx] > wrap_y {
					segment_y[idx] -= total_span;
				}
			}
		}

		// Electron drag interaction
		UI.push_id("guide_the_electron_drag");
		defer UI.pop_id();

		f := get_frame_number();
		e_idx := ((f / 6) % 3).(int);
		e_tex := electron_textures[e_idx];

		e_h := play_rect.height() * 0.14;
		e_w := e_h * e_tex.get_aspect();
		// Keep collision sizing consistent with the current draw size.
		electron_radius = min(e_w, e_h) * 0.32;

		electron_rect := window_rect.bottom_left_rect()
			.offset_unscaled(electron_pos.x - window_rect.min.x, electron_pos.y - window_rect.min.y)
			.grow_unscaled(e_h * 0.5, e_w * 0.5, e_h * 0.5, e_w * 0.5);

		// Make the interaction rect slightly larger than the sprite for touch friendliness.
		grab_pad := max(e_w, e_h) * 0.18;
		grab_rect := electron_rect.grow_unscaled(grab_pad, grab_pad, grab_pad, grab_pad);
		btn_bs: Button_Settings = .{};
		rr_ui_apply_button_click_sound(ref btn_bs);
		interact := UI.button(grab_rect, btn_bs, .{}, "");
		if interact.clicked {
			electron_grab_offset = electron_pos - interact.mouse_position;
		}
		if interact.active && success_time <= 0.0 {
			electron_pos = interact.mouse_position + electron_grab_offset;
			clamp_electron_to_play(this, play_rect);
		}

		// Clip hazards to the inner screen bounds
		UI.push_scissor(play_rect, true);

		// Draw wall segments + collision check
		w_idx := ((f / 5) % 3).(int);
		w_tex := wall_textures[w_idx];

		// Approximate collision radius slightly smaller than visual to feel fair
		col_radius := electron_radius * 0.82;
		collided := false;

		for c: 0..COLUMN_COUNT-1 {
			for i: 0..segment_count-1 {
				if i == hole_index[c] {
					continue; // one segment-sized hole
				}

				seg_y := segment_y[segment_index(this, c, i)];

				seg_center := v2.{column_x[c], seg_y};

				// Build a horizontal rect, rotate 90 degrees to appear vertical.
				base := window_rect.bottom_left_rect().offset_unscaled(seg_center.x - window_rect.min.x, seg_center.y - window_rect.min.y);
				seg_rect := base.grow_unscaled(seg_thickness * 0.5, seg_draw_length * 0.5, seg_thickness * 0.5, seg_draw_length * 0.5);

				draw_rotated_quad(this, seg_rect, w_tex, 90.0, .{1, 1, 1, 1});

				// Collision uses the rotated AABB (vertical)
				col_rect := Rect.{
					v2.{seg_center.x - seg_thickness * 0.5, seg_center.y - seg_draw_length * 0.5},
					v2.{seg_center.x + seg_thickness * 0.5, seg_center.y + seg_draw_length * 0.5}
				};

				if check_circle_aabb_collision(this, electron_pos, col_radius, col_rect) {
					collided = true;
				}
			}
		}

		// Electron is on top of hazards
		UI.quad(electron_rect, e_tex, .{1, 1, 1, 1});

		UI.pop_scissor();

		// Collision response (invulnerable during fail flash so one hit = one life)
		invulnerable := fail_time > 0.0 && (now - fail_time) < FAIL_FLASH_TIME;
		if collided && success_time <= 0.0 && !invulnerable {
			fail_time = now;
			lives -= 1;
			rr_task_sfx(player, RR_TASK_SFX_ZAP, 0.6);

			if lives <= 0 {
				// Out of lives - fail the task.
				ui_active = false;
				complete_attempt(this, player, false);
				return;
			}

			// Reset to start
			electron_pos = v2.{play_rect.min.x + play_rect.width() * 0.13, play_rect.min.y + play_rect.height() * 0.50};
			clamp_electron_to_play(this, play_rect);
		}

		// Success check (electron reaches finish line region)
		if success_time <= 0.0 {
			// hitbox is slightly inset so it feels like reaching the center of the goal
			hit := Rect.{
				v2.{finish_rect.min.x + finish_w * 0.18, finish_rect.min.y + finish_h * 0.18},
				v2.{finish_rect.max.x - finish_w * 0.18, finish_rect.max.y - finish_h * 0.18}
			};
			if electron_pos.x >= hit.min.x && electron_pos.x <= hit.max.x && electron_pos.y >= hit.min.y && electron_pos.y <= hit.max.y {
				success_time = now;
			}
		}

		// Feedback overlays (outside clip)
		if fail_time > 0.0 {
			el := now - fail_time;
			if el <= FAIL_FLASH_TIME {
				t := 1.0 - (el / FAIL_FLASH_TIME);
				UI.quad(play_rect, modal_bg, .{1.0, 0.1, 0.1, 0.22 * t});
			}
		}
		if success_time > 0.0 {
			el := now - success_time;
			t := clamp(el / SUCCESS_DISPLAY_TIME, 0.0, 1.0);
			UI.quad(play_rect, modal_bg, .{0.2, 1.0, 0.3, 0.14 * (1.0 - t)});
		}

	}
}

Task_Catching_Butterflies :: class : Task_Base {
	// Task state
	ui_active: bool;
	layout_initialized: bool;
	rng_initialized: bool;

	last_update_time: float;
	success_time: float;

	// Textures
	backing_texture: Texture_Asset;
	butterfly_body_texture: Texture_Asset;
	wing_blue_texture: Texture_Asset;
	wing_pink_texture: Texture_Asset;
	wing_orange_texture: Texture_Asset;
	net_texture: Texture_Asset;
	net_back_texture: Texture_Asset;

	BUTTERFLY_COUNT :: 6;
	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;

	// Butterflies (screen-space within the task window)
	butterfly_pos: [..]v2;
	butterfly_vel: [..]v2;
	butterfly_angle: [..]float;
	butterfly_color: [..]int; // 0=blue, 1=pink, 2=orange
	butterfly_phase: [..]float;
	butterfly_caught: [..]bool;
	butterfly_catch_time: [..]float;

	// Net physics
	net_handle_pos: v2;
	net_handle_prev_pos: v2;
	net_grab_offset: v2;
	net_tip_pos: v2;
	net_tip_vel: v2;
	net_rest_len: float;
	net_angle_offset: float; // degrees, 0 = straight up
	net_angle_vel: float;    // degrees / second
	last_swing_sfx_time: float;
	swing_sfx_armed: bool;
	swing_sfx_below_rearm_since: float;

	start_attempt :: proc(using this: Task_Catching_Butterflies, player: Player) {
		if started {
			return;
		}
		started = true;
		ui_active = true;
		layout_initialized = false;
		rng_initialized = false;
		last_update_time = 0.0;
		success_time = 0.0;
		last_swing_sfx_time = -10.0;
		swing_sfx_armed = true;
		swing_sfx_below_rearm_since = -1.0;
	}

	init_textures :: proc(using this: Task_Catching_Butterflies) {
		backing_texture = get_asset(Texture_Asset, "sprites/tasks/catching_butterflies/backing.png");
		butterfly_body_texture = get_asset(Texture_Asset, "sprites/tasks/catching_butterflies/butterfly.png");
		wing_blue_texture = get_asset(Texture_Asset, "sprites/tasks/catching_butterflies/butterfly_wing_blue.png");
		wing_pink_texture = get_asset(Texture_Asset, "sprites/tasks/catching_butterflies/butterfly_wing_pink.png");
		wing_orange_texture = get_asset(Texture_Asset, "sprites/tasks/catching_butterflies/butterfly_wing_orange.png");
		net_texture = get_asset(Texture_Asset, "sprites/tasks/catching_butterflies/net.png");
		net_back_texture = get_asset(Texture_Asset, "sprites/tasks/catching_butterflies/net_back.png");
	}

	rotate_about_point :: proc(using this: Task_Catching_Butterflies, point: v2, degrees: float) -> Matrix4 {
		return Matrix4.translate(point).multiply(Matrix4.rotate(degrees, v3.{0.0, 0.0, 1.0}).multiply(Matrix4.translate(-point)));
	}

	rotate_point_about_pivot :: proc(using this: Task_Catching_Butterflies, point: v2, radians: float, pivot: v2) -> v2 {
		p := point - pivot;
		c := cos(radians);
		s := sin(radians);
		return pivot + v2.{p.x * c - p.y * s, p.x * s + p.y * c};
	}

	get_wing_texture :: proc(using this: Task_Catching_Butterflies, color_idx: int) -> Texture_Asset {
		switch color_idx {
			case 0: return wing_blue_texture;
			case 1: return wing_pink_texture;
			case 2: return wing_orange_texture;
			default: return wing_blue_texture;
		}
	}

	ensure_butterfly_buffers :: proc(using this: Task_Catching_Butterflies) {
		if butterfly_pos.count == BUTTERFLY_COUNT &&
			butterfly_vel.count == BUTTERFLY_COUNT &&
			butterfly_angle.count == BUTTERFLY_COUNT &&
			butterfly_color.count == BUTTERFLY_COUNT &&
			butterfly_phase.count == BUTTERFLY_COUNT &&
			butterfly_caught.count == BUTTERFLY_COUNT &&
			butterfly_catch_time.count == BUTTERFLY_COUNT {
			return;
		}

		butterfly_pos.clear();
		butterfly_vel.clear();
		butterfly_angle.clear();
		butterfly_color.clear();
		butterfly_phase.clear();
		butterfly_caught.clear();
		butterfly_catch_time.clear();

		for i: 0..BUTTERFLY_COUNT-1 {
			butterfly_pos.append(v2.{0.0, 0.0});
			butterfly_vel.append(v2.{0.0, 0.0});
			butterfly_angle.append(0.0);
			butterfly_color.append(0);
			butterfly_phase.append(0.0);
			butterfly_caught.append(false);
			butterfly_catch_time.append(0.0);
		}
	}

	init_layout :: proc(using this: Task_Catching_Butterflies, window_rect: Rect) {
		if layout_initialized {
			return;
		}
		layout_initialized = true;

		w := window_rect.width();
		h := window_rect.height();

		// Net starts on the left. IMPORTANT: net_handle_pos is the **bottom-right grab point**
		// of the handle (anchor/pivot for rotation).
		net_handle_pos = v2.{window_rect.min.x + w * 0.32, window_rect.min.y + h * 0.18};
		net_handle_prev_pos = net_handle_pos;
		net_grab_offset = v2.{0.0, 0.0};
		net_rest_len = h * 0.3;
		net_tip_pos = net_handle_pos + v2.{0.0, net_rest_len};
		net_tip_vel = v2.{0.0, 0.0};
		net_angle_offset = 0.0;
		net_angle_vel = 0.0;

		// Butterflies start in the center/right of the window.
		if !rng_initialized {
			rng_initialized = true;
			rr_refresh_rng_state();
		}
		ensure_butterfly_buffers(this);

		for i: 0..BUTTERFLY_COUNT-1 {
			px := window_rect.min.x + w * rng_range_float(ref rr_rng_state.value, 0.42, 0.92);
			py := window_rect.min.y + h * rng_range_float(ref rr_rng_state.value, 0.18, 0.86);
			butterfly_pos[i] = v2.{px, py};

			speed := rng_range_float(ref rr_rng_state.value, h * 0.10, h * 0.18);
			dir_a := rng_range_float(ref rr_rng_state.value, 0.0, 6.2831853);
			butterfly_vel[i] = v2.{cos(dir_a) * speed, sin(dir_a) * speed};
			butterfly_angle[i] = to_degrees(atan2(butterfly_vel[i].y, butterfly_vel[i].x));
			butterfly_color[i] = rng_range_int(ref rr_rng_state.value, 0, 2);
			butterfly_phase[i] = rng_range_float(ref rr_rng_state.value, 0.0, 10.0);
			butterfly_caught[i] = false;
			butterfly_catch_time[i] = 0.0;
		}
	}

	draw_butterfly :: proc(
		using this: Task_Catching_Butterflies,
		window_rect: Rect,
		pos: v2,
		angle_degrees: float,
		wing_texture: Texture_Asset,
		flap_phase: float,
		scale: float,
		alpha: float
	) {
		w := window_rect.width();
		h := window_rect.height();

		body_h := h * 0.07 * scale;
		body_w := body_h * butterfly_body_texture.get_aspect();

		wing_h := body_h * 0.85;
		wing_w := wing_h * wing_texture.get_aspect();

		UI.push_matrix(this.rotate_about_point(pos, angle_degrees));
		defer UI.pop_matrix();

		// Wings (left/right) flap via X scale (imitates a simple 3D fold),
		// and slide slightly toward the body as they "close".
		flap01 := 0.5 + 0.5 * sin(get_time() * 30.0 + flap_phase); // 0..1
		flap_x := 0.1 + 0.9 * flap01; // keep some visible area even when "edge-on"

		base_offset := body_w * 0.55;
		offset := base_offset * (0.35 + 0.65 * flap_x); // closer when flap_x is small

		left_center := pos + v2.{-offset, 0.0};
		right_center := pos + v2.{offset, 0.0};

		left_rect := window_rect.bottom_left_rect().offset_unscaled(left_center.x - window_rect.min.x, left_center.y - window_rect.min.y).grow_unscaled(wing_h * 0.5, wing_w * 0.5, wing_h * 0.5, wing_w * 0.5);
		right_rect := window_rect.bottom_left_rect().offset_unscaled(right_center.x - window_rect.min.x, right_center.y - window_rect.min.y).grow_unscaled(wing_h * 0.5, wing_w * 0.5, wing_h * 0.5, wing_w * 0.5);

		// Mirror the left wing + apply flap X scaling.
		// (Rect scaling is around its center; negative X scale flips horizontally.)
		left_rect = left_rect.scale(-flap_x, 1.0);
		UI.quad(left_rect, wing_texture, .{1, 1, 1, alpha});

		// Right wing just scales in X (no mirror).
		right_rect = right_rect.scale(flap_x, 1.0);
		UI.quad(right_rect, wing_texture, .{1, 1, 1, alpha});

		// Body on top
		body_rect := window_rect.bottom_left_rect().offset_unscaled(pos.x - window_rect.min.x, pos.y - window_rect.min.y).grow_unscaled(body_h * 0.5, body_w * 0.5, body_h * 0.5, body_w * 0.5);
		UI.quad(body_rect, butterfly_body_texture, .{1, 1, 1, alpha});
	}

	update_task :: proc(using this: Task_Catching_Butterflies, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}
		if !player.is_local_or_server() {
			return;
		}

		if backing_texture == null {
			init_textures(this);
		}

		now := get_time();
		dt := 0.0;
		if last_update_time > 0.0 {
			dt = now - last_update_time;
			dt = clamp(dt, 0.0, 0.05);
		}
		last_update_time = now;

		// Draw modal background + backing
		screen := UI.get_screen_rect();
		bg_texture := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, bg_texture, .{0.0, 0.0, 0.0, 0.85});

		window_size := 1000.0;
		window_rect := screen.center_rect().grow(window_size / 2.0);
		window_rect = window_rect.fit_aspect(backing_texture.get_aspect(), .KEEP_HEIGHT);
		UI.quad(window_rect, backing_texture, .{1, 1, 1, 1});

		// Close (top-right)
		if draw_task_close_button(window_rect, player, this) {
			ui_active = false;
			layout_initialized = false;
			return;
		}

		init_layout(this, window_rect);

		// Success flow
		if success_time > 0.0 {
			elapsed := now - success_time;
			if elapsed >= SUCCESS_DISPLAY_TIME {
				ui_active = false;
				complete_attempt(this, player, true);
				return;
			}
		}

		w := window_rect.width();
		h := window_rect.height();

		// --- Net input (grab handle) ---
		// QoL: clicking anywhere inside the task window picks up the handle and
		// moves it to your hand (no need to click the tiny handle hotspot).
		UI.push_id("catching_butterflies_net_grab_area");
		defer UI.pop_id();
		btn_bs: Button_Settings = .{};
		rr_ui_apply_button_click_sound(ref btn_bs);
		interact := UI.button(window_rect, btn_bs, .{}, "");

		// On click, snap the handle to the pointer so it feels like you grabbed it.
		if interact.clicked {
			net_grab_offset = v2.{0.0, 0.0};
			// Reset velocity baseline so this "teleport" doesn't create a giant fling.
			net_handle_prev_pos = interact.mouse_position;
			net_angle_vel = 0.0;
		}

		if interact.active || interact.clicked {
			// Clamp handle to a reasonable region inside the window (left-ish).
			// Since this is the bottom-right anchor, keep it away from the far-left edge
			// so the net (which extends left) doesn't go off-screen too easily.
			min_x := window_rect.min.x + w * 0.15;
			max_x := window_rect.max.x - w * 0.02;
			min_y := window_rect.min.y + h * 0.02;
			max_y := window_rect.min.y + h * 0.65;

			desired := interact.mouse_position + net_grab_offset;
			net_handle_pos.x = clamp(desired.x, min_x, max_x);
			net_handle_pos.y = clamp(desired.y, min_y, max_y);
		}

		// --- Net fake physics (tip spring + inertia) ---
		handle_vel := v2.{0.0, 0.0};
		if dt > 0.0 {
			handle_vel = (net_handle_pos - net_handle_prev_pos) * (1.0 / dt);
		}
		net_handle_prev_pos = net_handle_pos;

		// Angle spring: ONLY driven by X movement so it feels consistent (no weird jumps from Y).
		// This also avoids computing angle from a direction vector that can snap when handle/tip align.
		drive_vx := handle_vel.x;
		if drive_vx > 3000.0 { drive_vx = 3000.0; }
		if drive_vx < -3000.0 { drive_vx = -3000.0; }

		// Convert X velocity into a desired lean angle, then spring toward it.
		// Move right => net leans left (tip lags), so invert sign.
		desired_angle := -drive_vx * 0.02; // px/s -> degrees (tune feel)

		angle_spring := 120.0; // stronger = snappier response
		angle_damp := 18.0;    // higher = less oscillation

		angle_acc := (desired_angle - net_angle_offset) * angle_spring - (net_angle_vel * angle_damp);
		net_angle_vel = net_angle_vel + angle_acc * dt;
		net_angle_offset = net_angle_offset + net_angle_vel * dt;

		max_angle := 40.0;
		if net_angle_offset > max_angle {
			net_angle_offset = max_angle;
			if net_angle_vel > 0.0 { net_angle_vel = 0.0; }
		}
		if net_angle_offset < -max_angle {
			net_angle_offset = -max_angle;
			if net_angle_vel < 0.0 { net_angle_vel = 0.0; }
		}

		// Derived net transform
		net_angle := net_angle_offset; // degrees, 0 = straight up
		rad := to_radians(net_angle);
		// Rotate (0,1) by rad: (x', y') = (-sin(rad), cos(rad))
		net_dir := v2.{-sin(rad), cos(rad)};

		// IMPORTANT: The net should feel like a rigid tool. Use the springy tip ONLY for direction,
		// not for changing the rendered size.
		net_len := net_rest_len;
		net_w := net_len * net_texture.get_aspect();
		base := window_rect.bottom_left_rect().offset_unscaled(net_handle_pos.x - window_rect.min.x, net_handle_pos.y - window_rect.min.y);
		// net_handle_pos is bottom-right => net extends left from the anchor (and up from the anchor).
		net_rect := base.grow_unscaled(net_len, 0.0, 0.0, net_w);

		// Net opening for catching (near the top)
		// IMPORTANT: catch position should match the visible mouth of the net.
		// Since the net rect extends UP and LEFT from the bottom-right handle pivot, the "mouth"
		// is near the top-left corner in local (unrotated) space, then rotated about the pivot.
		mouth_local := net_handle_pos + v2.{0, net_len * 0.8};
		hoop_center := this.rotate_point_about_pivot(mouth_local, rad, net_handle_pos);

		// Only catch if the player is actually moving/sweeping the net a bit (X-only).
		min_sweep_vx := h * 0.12; // px/s
		sweep_vx := abs(handle_vel.x);
		net_sweeping := sweep_vx >= min_sweep_vx;
		// Net swing SFX should only play on larger sweeps, not tiny motion.
		min_swing_sfx_vx := h * 0.22; // px/s
		min_swing_sfx_rearm_vx := h * 0.10; // px/s
		swing_sfx_cooldown := 0.14;
		swing_sfx_rearm_hold_time := 0.10;
		if player != null && player.is_local() {
			if swing_sfx_armed && sweep_vx >= min_swing_sfx_vx && (now - last_swing_sfx_time) >= swing_sfx_cooldown {
				sfx := SFX.default_sfx_desc();
				sfx.set_position(player.entity.world_position);
				sfx.volume = 0.40;
				sfx.volume_perturb = 0.08;
				sfx.speed_perturb = 0.08;
				// Global SFX mix: everything at 25% volume.
				sfx.volume *= 0.25;
				sfx.volume_perturb *= 0.25;
				rr_play_sfx("sfx/swing_net.wav", sfx);
				last_swing_sfx_time = now;
				swing_sfx_armed = false;
				swing_sfx_below_rearm_since = -1.0;
			}
			// Re-arm only after speed stays low for a short hold time,
			// so quick forward/back micro-corrections don't double-trigger.
			if !swing_sfx_armed {
				if sweep_vx <= min_swing_sfx_rearm_vx {
					if swing_sfx_below_rearm_since < 0.0 {
						swing_sfx_below_rearm_since = now;
					}
					if (now - swing_sfx_below_rearm_since) >= swing_sfx_rearm_hold_time {
						swing_sfx_armed = true;
						swing_sfx_below_rearm_since = -1.0;
					}
				} else {
					swing_sfx_below_rearm_since = -1.0;
				}
			}
		}

		hoop_radius := net_w * 0.18;
		if hoop_radius < h * 0.05 {
			hoop_radius = h * 0.05;
		}

		// Draw net back first (so butterflies appear "inside" when caught)
		UI.push_matrix(this.rotate_about_point(net_handle_pos, net_angle));
		{
			//back net is only behind the top of the net (net img is net + handle, back is only net)
			back_rect := net_rect.inset_unscaled(0, 0, net_rect.height() * 0.4, net_rect.width() * 0.4);
			back_rect = back_rect.fit_aspect(net_back_texture.get_aspect(), .KEEP_HEIGHT);
			UI.quad(back_rect, net_back_texture, .{1, 1, 1, 1});
		}
		UI.pop_matrix();

		// --- Butterflies update + draw ---
		flight_min_x := window_rect.min.x + w * 0.38;
		flight_max_x := window_rect.max.x - w * 0.06;
		flight_min_y := window_rect.min.y + h * 0.14;
		flight_max_y := window_rect.max.y - h * 0.12;

		all_caught := true;
		for i: 0..BUTTERFLY_COUNT-1 {
			if !butterfly_caught[i] {
				all_caught = false;
			}
		}

		if success_time <= 0.0 {
			// Only update physics while not in success display
			for i: 0..BUTTERFLY_COUNT-1 {
				if butterfly_caught[i] {
					continue;
				}

				p := butterfly_pos[i];
				v := butterfly_vel[i];

				p = p + v * dt;

				// Soft bounce with a little randomness so it doesn't look robotic.
				if p.x < flight_min_x { p.x = flight_min_x; v.x = abs(v.x); }
				if p.x > flight_max_x { p.x = flight_max_x; v.x = -abs(v.x); }
				if p.y < flight_min_y { p.y = flight_min_y; v.y = abs(v.y); }
				if p.y > flight_max_y { p.y = flight_max_y; v.y = -abs(v.y); }

				// Keep speed in a pleasant range.
				spd := sqrt(v.x * v.x + v.y * v.y);
				min_spd := h * 0.08;
				max_spd := h * 0.20;
				if spd < min_spd && spd > 0.001 {
					v = v * (min_spd / spd);
				}
				if spd > max_spd {
					v = v * (max_spd / spd);
				}

				butterfly_pos[i] = p;
				butterfly_vel[i] = v;
				butterfly_angle[i] = 0;

				// Catch check
				cdx := p.x - hoop_center.x;
				cdy := p.y - hoop_center.y;
				if net_sweeping && (cdx * cdx + cdy * cdy) <= (hoop_radius * hoop_radius) {
					butterfly_caught[i] = true;
					butterfly_catch_time[i] = now;
					rr_task_sfx(player, RR_TASK_SFX_CATCH, 0.5);
				}
			}
		}

		// Draw butterflies (including a brief "caught inside net" moment)
		for i: 0..BUTTERFLY_COUNT-1 {
			wing_tex := get_wing_texture(this, butterfly_color[i]);
			pos := butterfly_pos[i];
			ang := butterfly_angle[i];
			alpha := 1.0;

			if butterfly_caught[i] {
				elapsed := now - butterfly_catch_time[i];
				if elapsed > 0.35 {
					continue;
				}
				// Pull it just inside the hoop.
				pos = hoop_center - net_dir * (hoop_radius * 0.35);
				alpha = clamp(1.0 - (elapsed / 0.35), 0.0, 1.0);
				ang = net_angle;
			}

			draw_butterfly(this, window_rect, pos, ang, wing_tex, butterfly_phase[i], 1.0, alpha);
		}

		// Net front on top
		UI.push_matrix(this.rotate_about_point(net_handle_pos, net_angle));
		{
			UI.quad(net_rect, net_texture, .{1, 1, 1, 1});
		}
		UI.pop_matrix();

		// Completion check + success text
		if success_time <= 0.0 {
			all_caught = true;
			for i: 0..BUTTERFLY_COUNT-1 {
				if !butterfly_caught[i] {
					all_caught = false;
				}
			}
			if all_caught {
				success_time = now;
			}
		}

		if success_time > 0.0 {
			success_rect := window_rect.cut_top(60).offset(0, 10);
			success_ts := UI.default_text_settings();
			success_ts.size = 54;
			success_ts.color = .{0.3, 1.0, 0.4, 1.0};
			success_ts.halign = .CENTER;
			success_ts.valign = .CENTER;
			UI.text(success_rect, success_ts, "ALL BUTTERFLIES CAUGHT!");
		}
	}
}

draw_signal_sync_bar :: proc(
	rect: Rect,
	fill01: float,
	bar_bg: Texture_Asset,
	bar_fill: Texture_Asset,
	bar_frame: Texture_Asset,
	bar_complete: Texture_Asset,
	name_tex: Texture_Asset,
	complete_name_tex: Texture_Asset
) {
	fill01 = clamp(fill01, 0.0, 1.0);

	if fill01 >= 1.0 {
		UI.quad(rect, bar_complete, .{1, 1, 1, 1});
		name_rect := rect.inset_unscaled(rect.height() * 0.10, rect.width() * 0.55, rect.height() * 0.10, rect.width() * 0.02);
		name_rect = name_rect.fit_aspect(complete_name_tex.get_aspect(), .KEEP_HEIGHT);
		UI.quad(name_rect, complete_name_tex, .{1, 1, 1, 1});
		return;
	}

	UI.quad(rect, bar_bg, .{1, 1, 1, 1});

	inner := rect.inset_unscaled(rect.height() * 0.20, rect.width() * 0.08, rect.height() * 0.20, rect.width() * 0.53);
	fill_rect := inner.subrect(0.0, 0.0, fill01, 1.0);
	UI.quad(fill_rect, bar_fill, .{1, 1, 1, 1});

	UI.quad(rect, bar_frame, .{1, 1, 1, 1});

	name_rect := rect.inset_unscaled(rect.height() * 0.10, rect.width() * 0.55, rect.height() * 0.10, rect.width() * 0.02);
	name_rect = name_rect.fit_aspect(name_tex.get_aspect(), .KEEP_HEIGHT);
	UI.quad(name_rect, name_tex, .{1, 1, 1, 1});
}

Task_Signal_Sync :: class : Task_Base {
	// Task state
	ui_active: bool;

	beam_tip_pos: v2; // normalized (0..1) within window
	beam_dir: v2;     // normalized direction (mouse controls direction only)
	beam_len_current: float; // current rendered beam length (pixels), eased toward target

	sat_a_fill: float;
	sat_b_fill: float;
	sat_c_fill: float;

	success_time: float;
	last_update_time: float;

	// Textures
	backing_texture: Texture_Asset;

	satellite_tower_texture: Texture_Asset;
	satellite_dish_texture: Texture_Asset;

	sat_texture: Texture_Asset;
	sat_updating_texture: Texture_Asset;
	sat_updated_texture: Texture_Asset;

	bar_bg_texture: Texture_Asset;
	bar_fill_texture: Texture_Asset;
	bar_frame_texture: Texture_Asset;
	bar_complete_texture: Texture_Asset;

	name_a_texture: Texture_Asset;
	name_b_texture: Texture_Asset;
	name_c_texture: Texture_Asset;
	complete_name_a_texture: Texture_Asset;
	complete_name_b_texture: Texture_Asset;
	complete_name_c_texture: Texture_Asset;

	beam_start_texture: Texture_Asset;
	beam_end_texture: Texture_Asset;
	beam_info_texture: Texture_Asset;
	beam_boost_texture: Texture_Asset;

	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;
	FILL_RATE :: 0.45; // bar fill per second while locked on

	start_attempt :: proc(using this: Task_Signal_Sync, player: Player) {
		if started {
			return;
		}
		started = true;
		ui_active = true;

		beam_tip_pos = .{0.65, 0.55};
		beam_dir = normalize(v2.{1.0, 0.35});
		beam_len_current = 0.0;
		sat_a_fill = 0.0;
		sat_b_fill = 0.0;
		sat_c_fill = 0.0;
		success_time = 0.0;
		last_update_time = 0.0;
	}

	init_textures :: proc(using this: Task_Signal_Sync) {
		backing_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/backing_night.png");
		satellite_tower_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/satellite_tower.png");
		satellite_dish_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/satellite_dish.png");

		sat_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/satellites/satellite.png");
		sat_updating_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/satellites/satellite_updating.png");
		sat_updated_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/satellites/satellite_updated.png");

		bar_bg_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/bar_background.png");
		bar_fill_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/bar.png");
		bar_frame_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/bar_frame.png");
		bar_complete_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/bar_complete.png");

		name_a_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/name_A.png");
		name_b_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/name_B.png");
		name_c_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/name_C.png");
		complete_name_a_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/complete_name_A.png");
		complete_name_b_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/complete_name_B.png");
		complete_name_c_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/bar/complete_name_C.png");

		beam_start_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/beam/beam_start.png");
		beam_end_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/beam/beam_end.png");
		beam_info_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/beam/information_beam.png");
		beam_boost_texture = get_asset(Texture_Asset, "sprites/tasks/signal_sync/beam/information_boost.png");
	}

	update_task :: proc(using this: Task_Signal_Sync, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}
		if !player.is_local_or_server() {
			return;
		}

		if backing_texture == null {
			init_textures(this);
		}

		now := get_time();
		dt := 0.0;
		if last_update_time > 0.0 {
			dt = now - last_update_time;
			dt = clamp(dt, 0.0, 0.05);
		}
		last_update_time = now;

		if success_time > 0.0 {
			if now - success_time >= SUCCESS_DISPLAY_TIME {
				ui_active = false;
				complete_attempt(this, player, true);
				return;
			}
			draw_signal_sync_ui(this, player, true, 0.0);
			return;
		}

		draw_signal_sync_ui(this, player, false, dt);
	}

	rotate_about_point :: proc(point: v2, degrees: float) -> Matrix4 {
		return Matrix4.translate(point).multiply(Matrix4.rotate(degrees, v3.{0.0, 0.0, 1.0}).multiply(Matrix4.translate(-point)));
	}

	rotate_point_about_pivot :: proc(using task: Task_Signal_Sync, point: v2, radians: float, pivot: v2) -> v2 {
		p := point - pivot;
		c := cos(radians);
		s := sin(radians);
		return pivot + v2.{p.x * c - p.y * s, p.x * s + p.y * c};
	}

	// Returns distance along ray (origin + dir * t) until it hits the given axis-aligned rect bounds.
	// Assumes dir is normalized; returns 0.0 if no valid hit.
	ray_rect_distance :: proc(using task: Task_Signal_Sync, origin: v2, dir: v2, rect: Rect) -> float {
		best := 999999.0;
		eps := 0.00001;

		// Hit vertical sides (x = min.x / max.x)
		if abs(dir.x) > eps {
			t1 := (rect.min.x - origin.x) / dir.x;
			if t1 > 0.0 {
				p := origin + dir * t1;
				if p.y >= rect.min.y && p.y <= rect.max.y {
					best = min(best, t1);
				}
			}
			t2 := (rect.max.x - origin.x) / dir.x;
			if t2 > 0.0 {
				p := origin + dir * t2;
				if p.y >= rect.min.y && p.y <= rect.max.y {
					best = min(best, t2);
				}
			}
		}

		// Hit horizontal sides (y = min.y / max.y)
		if abs(dir.y) > eps {
			t3 := (rect.min.y - origin.y) / dir.y;
			if t3 > 0.0 {
				p := origin + dir * t3;
				if p.x >= rect.min.x && p.x <= rect.max.x {
					best = min(best, t3);
				}
			}
			t4 := (rect.max.y - origin.y) / dir.y;
			if t4 > 0.0 {
				p := origin + dir * t4;
				if p.x >= rect.min.x && p.x <= rect.max.x {
					best = min(best, t4);
				}
			}
		}

		if best >= 999998.0 {
			return 0.0;
		}
		return best;
	}

	draw_signal_sync_ui :: proc(using task: Task_Signal_Sync, player: Player, success_state: bool, delta_time: float) {
		screen := UI.get_screen_rect();
		bg_texture := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, bg_texture, .{0.0, 0.0, 0.0, 0.85});

		window_size := 1000.0;
		window_rect := screen.center_rect().grow(window_size / 2.0);
		window_rect = window_rect.fit_aspect(task.backing_texture.get_aspect(), .KEEP_HEIGHT);
		UI.quad(window_rect, task.backing_texture, .{1, 1, 1, 1});

		// Close (top-right)
		if draw_task_close_button(window_rect, player, task) {
			task.ui_active = false;
			return;
		}

		w := window_rect.width();
		h := window_rect.height();

		// Tower + dish (emitter)
		tower_local := v2.{w * 0.173, h * 0.18};
		tower_rect := window_rect.bottom_left_rect().offset_unscaled(tower_local.x, tower_local.y);
		tower_rect = tower_rect.grow_unscaled(h * 0.18, w * 0.17, h * 0.18, w * 0.17);
		tower_rect = tower_rect.fit_aspect(task.satellite_tower_texture.get_aspect(), .KEEP_HEIGHT);

		dish_rect := tower_rect.top_right_rect().grow_unscaled(h * 0.17, w * 0.17, h * 0.17, w * 0.17);
		dish_rect = dish_rect.offset_unscaled(-w * 0.02, -h * 0.05);
		dish_rect = dish_rect.fit_aspect(task.satellite_dish_texture.get_aspect(), .KEEP_HEIGHT);

		// Dish pivot for rotation/aim (middle-left)
		dish_pivot := v2.{dish_rect.min.x, dish_rect.min.y + dish_rect.height() * 0.5};
		emitter_pos := v2.{dish_rect.max.x, dish_rect.min.y + dish_rect.height() * 0.5};

		// Satellites (approx layout matching reference)
		sat_size := h * 0.2;
		sat_a_local := v2.{w * 0.25, h * 0.80};
		sat_b_local := v2.{w * 0.76, h * 0.74};
		sat_c_local := v2.{w * 0.80, h * 0.30};

		sat_a_rect := window_rect.bottom_left_rect().offset_unscaled(sat_a_local.x, sat_a_local.y);
		sat_a_rect = sat_a_rect.grow_unscaled(sat_size / 2.0, sat_size / 2.0, sat_size / 2.0, sat_size / 2.0);
		sat_b_rect := window_rect.bottom_left_rect().offset_unscaled(sat_b_local.x, sat_b_local.y);
		sat_b_rect = sat_b_rect.grow_unscaled(sat_size / 2.0, sat_size / 2.0, sat_size / 2.0, sat_size / 2.0);
		sat_c_rect := window_rect.bottom_left_rect().offset_unscaled(sat_c_local.x, sat_c_local.y);
		sat_c_rect = sat_c_rect.grow_unscaled(sat_size / 2.0, sat_size / 2.0, sat_size / 2.0, sat_size / 2.0);

		sat_a_rect = sat_a_rect.fit_aspect(task.sat_texture.get_aspect(), .KEEP_HEIGHT);
		sat_b_rect = sat_b_rect.fit_aspect(task.sat_texture.get_aspect(), .KEEP_HEIGHT);
		sat_c_rect = sat_c_rect.fit_aspect(task.sat_texture.get_aspect(), .KEEP_HEIGHT);

		sat_a_center := v2.{(sat_a_rect.min.x + sat_a_rect.max.x) * 0.5, (sat_a_rect.min.y + sat_a_rect.max.y) * 0.5};
		sat_b_center := v2.{(sat_b_rect.min.x + sat_b_rect.max.x) * 0.5, (sat_b_rect.min.y + sat_b_rect.max.y) * 0.5};
		sat_c_center := v2.{(sat_c_rect.min.x + sat_c_rect.max.x) * 0.5, (sat_c_rect.min.y + sat_c_rect.max.y) * 0.5};

		// Completion flags (used for target selection + fill gating)
		a_done := task.sat_a_fill >= 1.0;
		b_done := task.sat_b_fill >= 1.0;
		c_done := task.sat_c_fill >= 1.0;

		// Beam aim control (drag anywhere on the window): mouse sets direction, not distance
		if !success_state {
			UI.push_id("signal_sync_drag");
			defer UI.pop_id();
			btn_bs: Button_Settings = .{};
			rr_ui_apply_button_click_sound(ref btn_bs);
			interact := UI.button(window_rect, btn_bs, .{}, "");
			if interact.active {
				// Aim relative to the ROTATION PIVOT (the dish is rotated about this point).
				// This keeps input, rendered beam, and hit-testing in the same coordinate space.
				aim_vec := interact.mouse_position - dish_pivot;
				if length(aim_vec) > 1.0 {
					task.beam_dir = normalize(aim_vec);
				}
			}
		}

		// Dish angle (radians for math, degrees for UI)
		angle_rad := atan2(task.beam_dir.y, task.beam_dir.x);
		dish_angle := to_degrees(angle_rad);

		// IMPORTANT: the beam is rendered under a rotation matrix around dish_pivot, so its true world-space
		// origin is the rotated emitter position (not the unrotated emitter_pos).
		emitter_world := task.rotate_point_about_pivot(emitter_pos, angle_rad, dish_pivot);

		// Default beam length: distance until the ray hits the window bounds.
		// (Old code used min distance to ANY edge, which capped the beam to the nearest edge behind/aside the emitter,
		// preventing it from ever reaching satellites.)
		default_len := task.ray_rect_distance(emitter_world, task.beam_dir, window_rect);
		default_len = default_len - h * 0.03;
		if default_len < 50.0 { default_len = 50.0; }

		// Find the "nearest satellite along the current ray" in WORLD space.
		// This avoids subtle mismatch between the visual ray and the math used for lock-on.
		dir := task.beam_dir; // normalized
		max_t := default_len; // ray length within window bounds

		best_lateral := 999999.0;
		target_id := 0; // 0 none, 1 A, 2 B, 3 C
		target_forward := default_len;

		// Helper-ish pattern: compute forward (projection onto ray) + lateral (perp distance to ray)
		rel_a := sat_a_center - emitter_world;
		a_forward := rel_a.x * dir.x + rel_a.y * dir.y;
		a_lateral := length(rel_a - dir * a_forward);
		if !a_done && a_forward > 0.0 && a_forward <= max_t && a_lateral < best_lateral {
			best_lateral = a_lateral;
			target_id = 1;
			target_forward = a_forward;
		}

		rel_b := sat_b_center - emitter_world;
		b_forward := rel_b.x * dir.x + rel_b.y * dir.y;
		b_lateral := length(rel_b - dir * b_forward);
		if !b_done && b_forward > 0.0 && b_forward <= max_t && b_lateral < best_lateral {
			best_lateral = b_lateral;
			target_id = 2;
			target_forward = b_forward;
		}

		rel_c := sat_c_center - emitter_world;
		c_forward := rel_c.x * dir.x + rel_c.y * dir.y;
		c_lateral := length(rel_c - dir * c_forward);
		if !c_done && c_forward > 0.0 && c_forward <= max_t && c_lateral < best_lateral {
			best_lateral = c_lateral;
			target_id = 3;
			target_forward = c_forward;
		}

		// Beam length behavior:
		// - When NOT aiming near a satellite, keep a stable "idle" length to the window boundary.
		// - When aiming near one, smoothly scale down to that satellite distance.
		acquire_threshold := sat_size * 0.55;
		aim01 := 0.0;
		if target_id != 0 && best_lateral <= acquire_threshold {
			aim01 = clamp((acquire_threshold - best_lateral) / acquire_threshold, 0.0, 1.0);
		}

		idle_len := default_len;
		desired_len := idle_len;
		if target_id != 0 {
			desired_len = idle_len * (1.0 - aim01) + clamp(target_forward, 50.0, idle_len) * aim01;
		}

		if task.beam_len_current <= 0.0 {
			task.beam_len_current = desired_len;
		} else {
			// Smooth step toward desired length
			max_delta := 4000.0 * delta_time;
			diff := desired_len - task.beam_len_current;
			step := clamp(diff, -max_delta, max_delta);
			task.beam_len_current = task.beam_len_current + step;
		}

		// Lock-on checks: require the ray to pass close to the satellite (in local space) and the length to match.
		lateral_threshold := sat_size * 0.35;
		len_tolerance := sat_size * 0.30;
		lock_ok := (target_id != 0) && (best_lateral <= lateral_threshold) && (abs(task.beam_len_current - target_forward) <= len_tolerance);

		a_lock := (!a_done) && lock_ok && target_id == 1;
		b_lock := (!b_done) && lock_ok && target_id == 2;
		c_lock := (!c_done) && lock_ok && target_id == 3;

		if !success_state {
			prev_a := task.sat_a_fill;
			prev_b := task.sat_b_fill;
			prev_c := task.sat_c_fill;
			if a_lock { task.sat_a_fill = clamp(task.sat_a_fill + delta_time * FILL_RATE, 0.0, 1.0); }
			if b_lock { task.sat_b_fill = clamp(task.sat_b_fill + delta_time * FILL_RATE, 0.0, 1.0); }
			if c_lock { task.sat_c_fill = clamp(task.sat_c_fill + delta_time * FILL_RATE, 0.0, 1.0); }
			// Beep when a satellite just finished syncing.
			if (prev_a < 1.0 && task.sat_a_fill >= 1.0) || (prev_b < 1.0 && task.sat_b_fill >= 1.0) || (prev_c < 1.0 && task.sat_c_fill >= 1.0) {
				rr_task_sfx(player, RR_TASK_SFX_BEEP, 0.65);
			}
		}

		// Draw satellites (stateful sprite)
		sat_a_sprite := task.sat_texture;
		sat_b_sprite := task.sat_texture;
		sat_c_sprite := task.sat_texture;
		if a_done { sat_a_sprite = task.sat_updated_texture; } else if a_lock { sat_a_sprite = task.sat_updating_texture; }
		if b_done { sat_b_sprite = task.sat_updated_texture; } else if b_lock { sat_b_sprite = task.sat_updating_texture; }
		if c_done { sat_c_sprite = task.sat_updated_texture; } else if c_lock { sat_c_sprite = task.sat_updating_texture; }

		UI.quad(sat_a_rect, sat_a_sprite, .{1, 1, 1, 1});
		UI.quad(sat_b_rect, sat_b_sprite, .{1, 1, 1, 1});
		UI.quad(sat_c_rect, sat_c_sprite, .{1, 1, 1, 1});

		// Bars + labels
		bar_w := w * 0.34;

		bar_a_center := v2.{window_rect.min.x + w * 0.23, window_rect.min.y + h * 0.93};
		bar_a_rect := window_rect.bottom_left_rect().offset_unscaled(bar_a_center.x - window_rect.min.x, bar_a_center.y - window_rect.min.y).grow_unscaled(bar_w / 2.0, bar_w / 2.0, bar_w / 2.0, bar_w / 2.0);
		bar_a_rect = bar_a_rect.fit_aspect(task.bar_frame_texture.get_aspect(), .KEEP_WIDTH);

		bar_b_center := v2.{window_rect.min.x + w * 0.76, window_rect.min.y + h * 0.86};
		bar_b_rect := window_rect.bottom_left_rect().offset_unscaled(bar_b_center.x - window_rect.min.x, bar_b_center.y - window_rect.min.y).grow_unscaled(bar_w / 2.0, bar_w / 2.0, bar_w / 2.0, bar_w / 2.0);
		bar_b_rect = bar_b_rect.fit_aspect(task.bar_frame_texture.get_aspect(), .KEEP_WIDTH);

		bar_c_center := v2.{window_rect.min.x + w * 0.73, window_rect.min.y + h * 0.44};
		bar_c_rect := window_rect.bottom_left_rect().offset_unscaled(bar_c_center.x - window_rect.min.x, bar_c_center.y - window_rect.min.y).grow_unscaled(bar_w / 2.0, bar_w / 2.0, bar_w / 2.0, bar_w / 2.0);
		bar_c_rect = bar_c_rect.fit_aspect(task.bar_frame_texture.get_aspect(), .KEEP_WIDTH);

		draw_signal_sync_bar(bar_a_rect, task.sat_a_fill, task.bar_bg_texture, task.bar_fill_texture, task.bar_frame_texture, task.bar_complete_texture, task.name_a_texture, task.complete_name_a_texture);
		draw_signal_sync_bar(bar_b_rect, task.sat_b_fill, task.bar_bg_texture, task.bar_fill_texture, task.bar_frame_texture, task.bar_complete_texture, task.name_b_texture, task.complete_name_b_texture);
		draw_signal_sync_bar(bar_c_rect, task.sat_c_fill, task.bar_bg_texture, task.bar_fill_texture, task.bar_frame_texture, task.bar_complete_texture, task.name_c_texture, task.complete_name_c_texture);

		// Rotate the dish towards the current aim direction (pivot: middle-left)
		// Draw the ray INSIDE this rotation scope so it inherits rotation automatically.
		UI.push_matrix(rotate_about_point(dish_pivot, dish_angle));
		{
			beam_distance := task.beam_len_current;
			if beam_distance > 1.0 {
				connected := lock_ok;

				// Start glow at emitter always
				start_size := h * 0.05;
				if connected {
					start_size = h * 0.15;
				}
				start_rect := window_rect.bottom_left_rect().offset_unscaled(emitter_pos.x - window_rect.min.x, emitter_pos.y - window_rect.min.y);
				start_rect = start_rect.grow_unscaled(start_size / 2.0, start_size / 2.0, start_size / 2.0, start_size / 2.0);
				start_rect = start_rect.fit_aspect(task.beam_start_texture.get_aspect(), .KEEP_HEIGHT);
				UI.quad(start_rect, task.beam_start_texture, .{1, 1, 1, 0.9});

				if !connected {
					// FREE AIM (dotted look)
					step := h * 0.04;
					count := (beam_distance / step).(int);
					if count < 6 { count = 6; }
					if count > 40 { count = 40; }

					for i: 0..count {
						t := (i.(float)) / (count.(float));
						px := emitter_pos.x + beam_distance * t;
						py := emitter_pos.y;

						alpha := 0.25 + (sin(get_time() * 10.0 + i.(float) * 0.5) * 0.25);
						alpha = clamp(alpha, 0.15, 0.65);

						seg_size := h * 0.02;
						seg_rect := window_rect.bottom_left_rect().offset_unscaled(px - window_rect.min.x, py - window_rect.min.y).grow(seg_size / 2.0);
						UI.quad(seg_rect, task.beam_end_texture, .{0.8, 1.0, 0.6, alpha});
					}

					tip_pulse := 1.0 + sin(get_time() * 7.0) * 0.08;
					tip_rect := window_rect.bottom_left_rect().offset_unscaled((emitter_pos.x + beam_distance) - window_rect.min.x, emitter_pos.y - window_rect.min.y).grow(h * 0.05 * tip_pulse);
					tip_rect = tip_rect.fit_aspect(task.beam_start_texture.get_aspect(), .KEEP_HEIGHT);
					UI.quad(tip_rect, task.beam_start_texture, .{1, 1, 1, 0.85});
				} else {
					// CONNECTED BEAM (continuous): stretch one beam quad from start to end.
					if target_id != 0 {
						beam_distance = clamp(target_forward, 0.0, beam_distance);
					}

					beam_thickness := h * 0.045;
					x0 := clamp((emitter_pos.x - window_rect.min.x) / w, 0.0, 1.0);
					x1 := clamp((emitter_pos.x + beam_distance - window_rect.min.x) / w, 0.0, 1.0);
					y_center := clamp((emitter_pos.y - window_rect.min.y) / h, 0.0, 1.0);
					y0 := clamp(y_center - (beam_thickness * 0.5) / h, 0.0, 1.0);
					y1 := clamp(y_center + (beam_thickness * 0.5) / h, 0.0, 1.0);

					beam_rect := window_rect.subrect(x0, y0, x1, y1);
					pulse := 0.90 + sin(get_time() * 10.0) * 0.05;
					UI.quad(beam_rect, task.beam_info_texture, .{1, 1, 1, 0.85 * pulse});
					
					ring_step := h * 0.08;
					ring_count := (beam_distance / ring_step).(int);
					if ring_count < 2 { ring_count = 2; }
					if ring_count > 10 { ring_count = 10; }
					for i: 1..ring_count-1 {
						t := (i.(float)) / (ring_count.(float));
						px := emitter_pos.x + beam_distance * t;
						py := emitter_pos.y;

						ring_size := h * (0.1 - (0.05 * t));
						ring_rect := window_rect.bottom_left_rect().offset_unscaled(px - window_rect.min.x, py - window_rect.min.y).grow_unscaled(ring_size / 2.0, ring_size / 2.0, ring_size / 2.0, ring_size / 2.0);
						ring_rect = ring_rect.fit_aspect(task.beam_boost_texture.get_aspect(), .KEEP_WIDTH);
						UI.quad(ring_rect, task.beam_boost_texture, .{1, 1, 1, 0.85});
					}

					// End cap at tip
					end_pulse := 1.0 + sin(get_time() * 7.0) * 0.06;
					end_rect := window_rect.bottom_left_rect().offset_unscaled((emitter_pos.x + beam_distance) - window_rect.min.x, emitter_pos.y - window_rect.min.y).grow(h * 0.05 * end_pulse);
					end_rect = end_rect.fit_aspect(task.beam_end_texture.get_aspect(), .KEEP_HEIGHT);
					UI.quad(end_rect, task.beam_end_texture, .{1, 1, 1, 0.95});
				}
			}

			// Dish on top of the ray
			UI.quad(dish_rect, task.satellite_dish_texture, .{1, 1, 1, 1});
		}
		UI.pop_matrix();
		UI.quad(tower_rect, task.satellite_tower_texture, .{1, 1, 1, 1});
		
		if !success_state {
			if task.sat_a_fill >= 1.0 && task.sat_b_fill >= 1.0 && task.sat_c_fill >= 1.0 {
				task.success_time = get_time();
			}
		}

		if success_state {
			success_rect := window_rect.cut_top(60).offset(0, 10);
			success_ts := UI.default_text_settings();
			success_ts.size = 54;
			success_ts.color = .{0.3, 1.0, 0.4, 1.0};
			success_ts.halign = .CENTER;
			success_ts.valign = .CENTER;
			UI.text(success_rect, success_ts, "SIGNALS SYNCHRONIZED!");
		}
	}
}

Task_Build_A_Robot :: class : Task_Base {
	seen_attempt_id: int;
	layout_initialized: bool;
	dragging_idx: int;
	drag_offset: v2;
	part_pos: [6]v2;
	part_placed: [6]bool;
	success_time: float;

	background_texture: Texture_Asset;
	armature_texture: Texture_Asset;
	head_table_texture: Texture_Asset;
	body_table_texture: Texture_Asset;
	arm_l_table_texture: Texture_Asset;
	arm_r_table_texture: Texture_Asset;
	leg_l_table_texture: Texture_Asset;
	leg_r_table_texture: Texture_Asset;
	head_assembled_texture: Texture_Asset;
	body_assembled_texture: Texture_Asset;
	arm_l_assembled_texture: Texture_Asset;
	arm_r_assembled_texture: Texture_Asset;
	leg_l_assembled_texture: Texture_Asset;
	leg_r_assembled_texture: Texture_Asset;

	PART_HEAD :: 0;
	PART_BODY :: 1;
	PART_ARM_L :: 2;
	PART_ARM_R :: 3;
	PART_LEG_L :: 4;
	PART_LEG_R :: 5;
	SUCCESS_DISPLAY_TIME :: 0.6;

	reset_attempt_state :: proc(using this: Task_Build_A_Robot) {
		layout_initialized = false;
		dragging_idx = -1;
		drag_offset = v2.{0.0, 0.0};
		for i: 0..5 {
			part_pos[i] = v2.{0.0, 0.0};
			part_placed[i] = false;
		}
		success_time = 0.0;
	}

	cancel_attempt :: proc(using this: Task_Build_A_Robot, player: Player) {
		if !started return;
		if completed return;
		started = false;
		reset_attempt_state(this);
	}

	init_textures :: proc(using this: Task_Build_A_Robot) {
		background_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/background.png");
		armature_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/armature.png");

		head_table_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_table/head.png");
		body_table_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_table/body.png");
		arm_l_table_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_table/armL.png");
		arm_r_table_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_table/armR.png");
		leg_l_table_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_table/legL.png");
		leg_r_table_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_table/legR.png");

		head_assembled_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_body/head_assembled.png");
		body_assembled_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_body/body_assembled.png");
		arm_l_assembled_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_body/armL_assembled.png");
		arm_r_assembled_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_body/armR_assembled.png");
		leg_l_assembled_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_body/legL_assembled.png");
		leg_r_assembled_texture = get_asset(Texture_Asset, "sprites/tasks/build_a_robot/parts_on_body/legR_assembled.png");
	}

	get_table_texture :: proc(using this: Task_Build_A_Robot, idx: int) -> Texture_Asset {
		switch idx {
			case PART_HEAD: return head_table_texture;
			case PART_BODY: return body_table_texture;
			case PART_ARM_L: return arm_r_table_texture;
			case PART_ARM_R: return arm_l_table_texture;
			case PART_LEG_L: return leg_l_table_texture;
			case PART_LEG_R: return leg_r_table_texture;
			default: return null;
		}
	}

	get_assembled_texture :: proc(using this: Task_Build_A_Robot, idx: int) -> Texture_Asset {
		switch idx {
			case PART_HEAD: return head_assembled_texture;
			case PART_BODY: return body_assembled_texture;
			case PART_ARM_L: return arm_l_assembled_texture;
			case PART_ARM_R: return arm_r_assembled_texture;
			case PART_LEG_L: return leg_l_assembled_texture;
			case PART_LEG_R: return leg_r_assembled_texture;
			default: return null;
		}
	}

	get_target_rect :: proc(using this: Task_Build_A_Robot, idx: int, art_rect: Rect) -> Rect {
		switch idx {
			case PART_HEAD:  return art_rect.subrect(0.381, 0.672, 0.621, 0.973);
			case PART_BODY:  return art_rect.subrect(0.386, 0.325, 0.616, 0.694);
			case PART_ARM_L: return art_rect.subrect(0.146, 0.342, 0.454, 0.717);
			case PART_ARM_R: return art_rect.subrect(0.546, 0.342, 0.854, 0.717);
			case PART_LEG_L: return art_rect.subrect(0.327, 0.094, 0.477, 0.451);
			case PART_LEG_R: return art_rect.subrect(0.523, 0.094, 0.673, 0.451);
			default: return art_rect.subrect(0.0, 0.0, 0.0, 0.0);
		}
	}

	get_spawn_center :: proc(using this: Task_Build_A_Robot, idx: int, art_rect: Rect) -> v2 {
		x := 0.5;
		y := 0.12;
		switch idx {
			case PART_HEAD:  { x = 0.86; y = 0.16; }
			case PART_BODY:  { x = 0.48; y = 0.10; }
			case PART_ARM_L: { x = 0.18; y = 0.10; }
			case PART_ARM_R: { x = 0.70; y = 0.10; }
			case PART_LEG_L: { x = 0.08; y = 0.22; }
			case PART_LEG_R: { x = 0.95; y = 0.14; }
		}
		return v2.{lerp(art_rect.min.x, art_rect.max.x, x), lerp(art_rect.min.y, art_rect.max.y, y)};
	}

	get_loose_part_height :: proc(using this: Task_Build_A_Robot, idx: int, art_rect: Rect) -> float {
		switch idx {
			case PART_HEAD: return art_rect.height() * 0.20;
			case PART_BODY: return art_rect.height() * 0.22;
			case PART_ARM_L: return art_rect.height() * 0.25;
			case PART_ARM_R: return art_rect.height() * 0.25;
			case PART_LEG_L: return art_rect.height() * 0.23;
			case PART_LEG_R: return art_rect.height() * 0.23;
			default: return art_rect.height() * 0.20;
		}
	}

	is_point_in_rect :: proc(p: v2, r: Rect) -> bool {
		if p.x < r.min.x return false;
		if p.x > r.max.x return false;
		if p.y < r.min.y return false;
		if p.y > r.max.y return false;
		return true;
	}

	draw_rect_outline :: proc(r: Rect, thickness: float, color: v4) {
		tex := get_asset(Texture_Asset, "$AO/white.png");
		top := Rect.{v2.{r.min.x, r.max.y - thickness}, v2.{r.max.x, r.max.y}};
		bot := Rect.{v2.{r.min.x, r.min.y}, v2.{r.max.x, r.min.y + thickness}};
		left := Rect.{v2.{r.min.x, r.min.y}, v2.{r.min.x + thickness, r.max.y}};
		right := Rect.{v2.{r.max.x - thickness, r.min.y}, v2.{r.max.x, r.max.y}};
		UI.quad(top, tex, color);
		UI.quad(bot, tex, color);
		UI.quad(left, tex, color);
		UI.quad(right, tex, color);
	}

	draw_loose_part :: proc(using this: Task_Build_A_Robot, idx: int, rect: Rect, is_dragging: bool) -> Interact_Result {
		UI.push_id("robot_part_%", .{idx});
		defer UI.pop_id();

		btn_bs: Button_Settings = .{};
		rr_ui_apply_button_click_sound(ref btn_bs);
		interact := UI.button(rect, btn_bs, .{}, "");

		if is_dragging {
			shadow := rect.offset_unscaled(7, -7);
			UI.quad(shadow, get_asset(Texture_Asset, "$AO/white.png"), v4.{0, 0, 0, 0.25});
		}

		tex := get_table_texture(this, idx);
		if tex != null {
			UI.quad(rect, tex, v4.{1, 1, 1, 1});
		}
		return interact;
	}

	draw_placed_parts :: proc(using this: Task_Build_A_Robot, art_rect: Rect) {
		draw_order: [6]int = {PART_ARM_L, PART_ARM_R, PART_LEG_L, PART_LEG_R, PART_BODY, PART_HEAD};
		for oi: 0..5 {
			idx := draw_order[oi];
			if !part_placed[idx] continue;
			tex := get_assembled_texture(this, idx);
			if tex == null continue;
			target := get_target_rect(this, idx, art_rect);
			UI.quad(target, tex, v4.{1, 1, 1, 1});
		}
	}

	update_task :: proc(using this: Task_Build_A_Robot, player: Player) {
		if !started return;
		if completed return;
		if !player.is_local_or_server() return;

		if seen_attempt_id != attempt_id {
			seen_attempt_id = attempt_id;
			reset_attempt_state(this);
		}

		if background_texture == null {
			init_textures(this);
		}

		screen := UI.get_screen_rect();
		dim := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, dim, v4.{0.0, 0.0, 0.0, 0.85});

		safe := UI.get_safe_screen_rect();
		window := safe.center_rect().grow(310, 545, 310, 545);
		if background_texture != null {
			window = window.fit_aspect(background_texture.get_aspect(), .KEEP_BIGGER);
		}
		art_rect := window;

		if !layout_initialized {
			layout_initialized = true;
			for i: 0..5 {
				part_pos[i] = get_spawn_center(this, i, art_rect);
			}
		}

		if background_texture != null {
			UI.quad(art_rect, background_texture, v4.{1, 1, 1, 1});
		}

		armature_rect := art_rect.subrect(0.224, 0.132, 0.775, 0.814);
		if armature_texture != null {
			UI.quad(armature_rect, armature_texture, v4.{1, 1, 1, 1});
		}

		if dragging_idx >= 0 && dragging_idx <= 5 {
			target := get_target_rect(this, dragging_idx, art_rect);
			pad := art_rect.height() * 0.015;
			draw_rect_outline(target, max(2.0, pad), v4.{1.0, 0.9, 0.15, 0.85});
		}

		draw_placed_parts(this, art_rect);

		if success_time > 0.0 {
			if get_time() - success_time >= SUCCESS_DISPLAY_TIME {
				complete_attempt(this, player, true);
			}
			return;
		}

		if draw_task_close_button(window, player, this) {
			return;
		}

		mouse_pos := get_mouse_screen_position();

		for i: 0..5 {
			if part_placed[i] continue;
			if dragging_idx == i continue;

			tex := get_table_texture(this, i);
			if tex == null continue;

			h := get_loose_part_height(this, i, art_rect);
			w := h * tex.get_aspect();
			half := v2.{w * 0.5, h * 0.5};
			rect := Rect.{part_pos[i] - half, part_pos[i] + half};

			interact := draw_loose_part(this, i, rect, false);
			mouse_pos = interact.mouse_position;

			if interact.just_pressed && dragging_idx < 0 {
				dragging_idx = i;
				drag_offset = mouse_pos - part_pos[i];
			}
		}

		if dragging_idx >= 0 && dragging_idx <= 5 && !part_placed[dragging_idx] {
			i := dragging_idx;
			tex := get_table_texture(this, i);
			if tex != null {
				h := get_loose_part_height(this, i, art_rect);
				w := h * tex.get_aspect();
				half := v2.{w * 0.5, h * 0.5};
				rect := Rect.{part_pos[i] - half, part_pos[i] + half};

				interact := draw_loose_part(this, i, rect, true);
				mouse_pos = interact.mouse_position;

				if interact.active {
					part_pos[i] = mouse_pos - drag_offset;
				}

				if interact.released {
					target := get_target_rect(this, i, art_rect);
					pad := art_rect.height() * 0.06;
					drop_rect := target.grow_unscaled(pad, pad, pad, pad);
					if is_point_in_rect(part_pos[i], drop_rect) {
						part_pos[i] = target.center();
						part_placed[i] = true;
						rr_task_sfx(player, RR_TASK_SFX_TILE_CLICK, 0.65);
					}
					dragging_idx = -1;
				}
			} else {
				dragging_idx = -1;
			}
		}

		all_placed := true;
		for i: 0..5 {
			if !part_placed[i] {
				all_placed = false;
				break;
			}
		}
		if all_placed {
			success_time = get_time();
		}
	}
}

Task_Anagram_Puzzle :: class : Task_Base {
	// Task state
	ui_active: bool;
	rng_initialized: bool;

	// Target
	target_word: string;
	target_len: int;

	// Display strings
	note_1_word: string;
	note_2_word: string;
	note_3_word: string;
	note_4_word: string;

	// Note layout (normalized 0..1 within window_rect)
	note_1_pos: v2;
	note_2_pos: v2;
	note_3_pos: v2;
	note_4_pos: v2;
	note_1_angle: float;
	note_2_angle: float;
	note_3_angle: float;
	note_4_angle: float;

	// Player input (typed characters as ASCII bytes)
	input_chars: List(u8);

	success_time: float;
	fail_time: float;

	// Textures
	anagram_bg_texture: Texture_Asset;
	monitor_line_texture: Texture_Asset;

	FAIL_LOCK_TIME :: 0.75;
	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;

	start_attempt :: proc(using this: Task_Anagram_Puzzle, player: Player) {
		if started {
			return;
		}
		started = true;
		ui_active = true;

		rng_initialized = false;
		target_word = "";
		target_len = 0;
		note_1_word = "";
		note_2_word = "";
		note_3_word = "";
		note_4_word = "";

		input_chars = List(u8).{};
		success_time = 0.0;
		fail_time = 0.0;
	}

	init_textures :: proc(using this: Task_Anagram_Puzzle) {
		anagram_bg_texture = get_asset(Texture_Asset, "sprites/tasks/anagram/anagram_bg.png");
		monitor_line_texture = get_asset(Texture_Asset, "sprites/tasks/anagram/monitor_line.png");
	}

	get_word :: proc(word_idx: int) -> string {
		// Keep these as actual strings (what you gave), but we display/compare as uppercase via byte normalization.
		switch word_idx {
			case 0: return "Allout";
			case 1: return "Random";
			case 2: return "Game";
			case 3: return "Vote";
			case 4: return "Water";
			case 5: return "Hotdog";
			case 6: return "Task";
			case 7: return "Fish";
			case 8: return "Six";
			case 9: return "Seven";
			case 10: return "Coffee";
			case 11: return "Juice";
			case 12: return "Foot";
			case 13: return "Meme";
			default: return "";
		}
	}

	word_count :: proc() -> int { return 14; }

	uppercase_ascii :: proc(ch: u8) -> u8 {
		// 'a'..'z' => 'A'..'Z'
		if ch >= 97 && ch <= 122 {
			return ch - 32;
		}
		return ch;
	}

	char_to_string :: proc(using task: Task_Anagram_Puzzle, ch: u8) -> string {
		c := uppercase_ascii(ch);
		// Avoid per-call fixed-array allocation by mapping directly.
		switch c {
			case 65: return "A";
			case 66: return "B";
			case 67: return "C";
			case 68: return "D";
			case 69: return "E";
			case 70: return "F";
			case 71: return "G";
			case 72: return "H";
			case 73: return "I";
			case 74: return "J";
			case 75: return "K";
			case 76: return "L";
			case 77: return "M";
			case 78: return "N";
			case 79: return "O";
			case 80: return "P";
			case 81: return "Q";
			case 82: return "R";
			case 83: return "S";
			case 84: return "T";
			case 85: return "U";
			case 86: return "V";
			case 87: return "W";
			case 88: return "X";
			case 89: return "Y";
			case 90: return "Z";
		}
		return "?";
	}

	strings_equal_ascii :: proc(a: string, b: string) -> bool {
		if a.count != b.count {
			return false;
		}
		for i: 0..a.count-1 {
			if uppercase_ascii(a[i]) != uppercase_ascii(b[i]) {
				return false;
			}
		}
		return true;
	}

	uppercase_word :: proc(using task: Task_Anagram_Puzzle, word: string) -> string {
		out := "";
		for i: 0..word.count-1 {
			ch := word[i];
			out = format_string("%0%", .{out, task.char_to_string(ch)});
		}
		return out;
	}

	pick_random_word_of_length :: proc(target_len: int, exclude_a: int, exclude_b: int, exclude_c: int) -> int {
		candidates: List(int);
		for i: 0..word_count()-1 {
			if i == exclude_a || i == exclude_b || i == exclude_c {
				continue;
			}
			if get_word(i).count == target_len {
				append(ref candidates, i);
			}
		}
		if candidates.elements.count == 0 {
			return 0;
		}
		pick := rng_range_int(ref rr_rng_state.value, 0, candidates.elements.count-1);
		return candidates.elements[pick];
	}

	init_puzzle :: proc(using this: Task_Anagram_Puzzle) {
		if rng_initialized {
			return;
		}
		rng_initialized = true;
		rr_refresh_rng_state();

		// Pick target word
		target_idx := rng_range_int(ref rr_rng_state.value, 0, word_count()-1);
		target_word = get_word(target_idx);
		target_len = target_word.count;

		// Pick 3 other lengths (all different, and different than target_len)
		lengths: List(int);
		append(ref lengths, 3);
		append(ref lengths, 4);
		append(ref lengths, 5);
		append(ref lengths, 6);

		// Remove target_len from lengths
		for i: 0..lengths.elements.count-1 {
			if lengths.elements[i] == target_len {
				last := lengths.elements.count - 1;
				lengths.elements[i] = lengths.elements[last];
				pop(ref lengths);
				break;
			}
		}

		// Shuffle remaining lengths
		for i: 0..lengths.elements.count-1 {
			j := rng_range_int(ref rr_rng_state.value, i, lengths.elements.count-1);
			tmp := lengths.elements[i];
			lengths.elements[i] = lengths.elements[j];
			lengths.elements[j] = tmp;
		}

		decoy_1_idx := pick_random_word_of_length(lengths.elements[0], target_idx, -1, -1);
		decoy_2_idx := pick_random_word_of_length(lengths.elements[1], target_idx, decoy_1_idx, -1);
		decoy_3_idx := pick_random_word_of_length(lengths.elements[2], target_idx, decoy_1_idx, decoy_2_idx);

		note_1_word = uppercase_word(this, target_word);
		note_2_word = uppercase_word(this, get_word(decoy_1_idx));
		note_3_word = uppercase_word(this, get_word(decoy_2_idx));
		note_4_word = uppercase_word(this, get_word(decoy_3_idx));

		// Fixed note positions/angles aligned to the paper art in anagram_bg.png.
		// Normalized within window_rect: (0,0) = bottom-left, (1,1) = top-right.
		note_1_pos = .{0.13, 0.81};  // Left paper (white, red pin)
		note_2_pos = .{0.36, 0.80};  // Center-left paper (above monitor)
		note_3_pos = .{0.68, 0.82};  // Center-right paper (above monitor)
		note_4_pos = .{0.88, 0.80};  // Right paper (yellow, blue pin)

		// Angles match the tilt of each paper in the background art.
		note_1_angle = -6.0;  // Slight CCW lean
		note_2_angle = -2.0;  // Nearly flat
		note_3_angle = 3.0;   // Slight CW lean
		note_4_angle = 8.0;   // Noticeable CW lean
	}

	rotate_about_point :: proc(using task: Task_Anagram_Puzzle, point: v2, degrees: float) -> Matrix4 {
		return Matrix4.translate(point).multiply(Matrix4.rotate(degrees, v3.{0.0, 0.0, 1.0}).multiply(Matrix4.translate(-point)));
	}

	is_input_correct :: proc(using this: Task_Anagram_Puzzle) -> bool {
		if input_chars.elements.count != target_word.count {
			return false;
		}
		for i: 0..input_chars.elements.count-1 {
			if uppercase_ascii(input_chars.elements[i]) != uppercase_ascii(target_word[i]) {
				return false;
			}
		}
		return true;
	}

	draw_note_word :: proc(using task: Task_Anagram_Puzzle, window_rect: Rect, pos01: v2, angle: float, word: string, scale: float) {
		w := window_rect.width();
		h := window_rect.height();

		// NOTE: these are just reasonable defaults; you can adjust after.
		center := v2.{window_rect.min.x + w * pos01.x, window_rect.min.y + h * pos01.y};
		rect := window_rect.center_rect().grow_unscaled(h * 0.06, w * 0.10, h * 0.06, w * 0.10).offset_unscaled(center.x - (window_rect.min.x + w * 0.5), center.y - (window_rect.min.y + h * 0.5));

		ts := UI.default_text_settings();
		ts.size = 54 * scale;
		ts.color = .{0.05, 0.05, 0.05, 1.0};
		ts.halign = .CENTER;
		ts.valign = .CENTER;

		UI.push_matrix(task.rotate_about_point(center, angle));
		defer UI.pop_matrix();

		// Simple monospace-ish layout inside rect
		UI.text(rect, ts, word);
	}

	draw_anagram_ui :: proc(using task: Task_Anagram_Puzzle, player: Player, success_state: bool) {
		screen := UI.get_screen_rect();
		bg_texture := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, bg_texture, .{0.0, 0.0, 0.0, 0.85});

		window_size := 1000.0;
		window_rect := screen.center_rect().grow(window_size / 2.0);

		window_rect = window_rect.fit_aspect(task.anagram_bg_texture.get_aspect(), .KEEP_HEIGHT);

		w := window_rect.width();
		h := window_rect.height();

		// Key pad area (compute AFTER fit_aspect so it's consistent across screen sizes)
		pad_rect := window_rect.cut_bottom_unscaled(h * 0.25);
		pad_rect = pad_rect.inset_unscaled(-h * 0.08, w *  0.02, h *  0.02, w *  0.02);

		//Rerun fit_aspect to ensure the window_rect is the correct shape
		window_rect = window_rect.fit_aspect(task.anagram_bg_texture.get_aspect(), .KEEP_HEIGHT);
		UI.quad(window_rect, task.anagram_bg_texture, .{1, 1, 1, 1});

		// Close (top-right)
		if draw_task_close_button(window_rect, player, task) {
			task.ui_active = false;
			return;
		}

		w = window_rect.width();
		h = window_rect.height();

		// Fail lock (brief)
		fail_active := false;
		if task.fail_time > 0.0 {
			fail_active = (get_time() - task.fail_time) < FAIL_LOCK_TIME;
			if !fail_active {
				task.fail_time = 0.0;
			}
		}

		// Always derive from the actual word so the number of monitor lines matches the solve word exactly.
		target_len := task.target_word.count;

		// Draw the 4 note words (positions/angles are placeholders you can tweak)
		task.draw_note_word(window_rect, task.note_1_pos, task.note_1_angle, task.note_1_word, 0.75);
		task.draw_note_word(window_rect, task.note_2_pos, task.note_2_angle, task.note_2_word, 1);
		task.draw_note_word(window_rect, task.note_3_pos, task.note_3_angle, task.note_3_word, 1);
		task.draw_note_word(window_rect, task.note_4_pos, task.note_4_angle, task.note_4_word, 0.75);

		// Monitor lines area (center)
		lines_area := window_rect.center_rect().grow_unscaled(h * 0.05, w * 0.18, h * 0.05, w * 0.18);
		lines_area = lines_area.offset_unscaled(0.0, -h * 0.10);

		// Slight shake on fail for juice
		if fail_active {
			shake := sin(get_time() * 40.0) * 6.0;
			lines_area = lines_area.offset(shake, 0);
		}

		// Lay out per-letter cells
		n := target_len;
		if n < 0 { n = 0; }
		cell_w := lines_area.width() / (n.(float));
		cell_h := lines_area.height();

		typed_ts := UI.default_text_settings();
		typed_ts.size = 78;
		typed_ts.color = .{1, 1, 1, 1};
		typed_ts.halign = .CENTER;
		typed_ts.valign = .CENTER;

		for i: 0..n-1 {
			x0 := (i.(float)) / (n.(float));
			x1 := ((i+1).(float)) / (n.(float));
			cell := lines_area.subrect(x0, 0.0, x1, 1.0);
			cell = cell.inset_unscaled(cell.height() * 0.15, cell.width() * 0.08, cell.height() * 0.15, cell.width() * 0.08);

			line_rect := cell.bottom_rect().offset(0,10).fit_aspect(task.monitor_line_texture.get_aspect(), .KEEP_WIDTH);
			UI.quad(line_rect, task.monitor_line_texture, .{1, 1, 1, 1});

			if task.input_chars.elements.count > i {
				letter := task.char_to_string(task.input_chars.elements[i]);
				UI.text(cell, typed_ts, letter);
			}
		}

		// Feedback text
		if success_state {
			success_rect := window_rect.cut_top(70).offset(0, 15);
			success_ts := UI.default_text_settings();
			success_ts.size = 56;
			success_ts.color = .{0.3, 1.0, 0.4, 1.0};
			success_ts.halign = .CENTER;
			success_ts.valign = .CENTER;
			UI.text(success_rect, success_ts, "SYSTEM RESTARTED!");
			return;
		}

		if fail_active {
			fail_rect := window_rect.cut_top(70).offset(0, 15);
			fail_ts := UI.default_text_settings();
			fail_ts.size = 54;
			fail_ts.color = .{1.0, 0.2, 0.2, 1.0};
			fail_ts.halign = .CENTER;
			fail_ts.valign = .CENTER;
			UI.text(fail_rect, fail_ts, "WRONG! TRY AGAIN");
		}

		btn_bg := get_asset(Texture_Asset, "$AO/white.png");

		cols := 7;
		rows := 4;
		cell_pad := 8.0;

		key_w := pad_rect.width() / (cols.(float));
		key_h := pad_rect.height() / (rows.(float));
		btn_w := key_w - (cell_pad * 2.0);
		btn_h := key_h - (cell_pad * 2.0);
		if btn_w < 5.0 { btn_w = 5.0; }
		if btn_h < 5.0 { btn_h = 5.0; }

		btn_ts := UI.default_text_settings();
		btn_ts.size = 44;
		btn_ts.color = .{0.08, 0.08, 0.1, 1.0};
		btn_ts.halign = .CENTER;
		btn_ts.valign = .CENTER;

		// Special buttons: 26 = backspace, 27 = clear
		for r: 0..rows-1 {
			for c: 0..cols-1 {
				idx := r * cols + c;
				if idx > 27 {
					continue;
				}

				// IMPORTANT: don't use subrect here; derive in pixels from top-left for consistent sizing.
				x := (c.(float) + 0.5) * key_w;
				y := (r.(float) + 0.5) * key_h;
				anchor := pad_rect.top_left_rect().offset_unscaled(x, -y);
				cell := anchor.grow_unscaled(btn_h * 0.5, btn_w * 0.5, btn_h * 0.5, btn_w * 0.5);

				UI.push_id("anagram_btn_%", .{idx});
				defer UI.pop_id();

				btn_bs: Button_Settings = .{};
				rr_ui_apply_button_click_sound(ref btn_bs);
				interact := UI.button(cell, btn_bs, .{}, "");

				// Visual
				col: v4 = .{0.92, 0.92, 0.96, 0.95};
				if interact.active {
					col = .{0.75, 0.95, 0.75, 0.95};
				}
				if fail_active {
					col = .{0.95, 0.75, 0.75, 0.95};
				}
				UI.quad(cell, btn_bg, col);

				label := "";
				if idx <= 25 {
					label = task.char_to_string((65 + idx).(u8));
				} else if idx == 26 {
					// ASCII-only UI
					label = "BKSP";
				} else if idx == 27 {
					label = "CLR";
				}
				UI.text(cell, btn_ts, label);

				if interact.clicked && !fail_active {
					rr_task_sfx(player, RR_TASK_SFX_KEY_PRESS, 0.4);
					// Backspace
					if idx == 26 {
						if task.input_chars.elements.count > 0 {
							task.input_chars.pop();
						}
					} else if idx == 27 {
						task.input_chars = List(u8).{};
					} else if idx <= 25 {
						// Letter
						if task.input_chars.elements.count < target_len {
							task.input_chars.append((65 + idx).(u8));
						}
					}
				}
			}
		}
	}

	handle_keyboard_input :: proc(using this: Task_Anagram_Puzzle, player: Player) -> bool {
		// Optional QoL: allow PC players to type the answer.
		// Mobile/touch still uses the on-screen keypad.
		if player == null {
			return false;
		}
		if player.device_kind != Device_Kind.PC {
			return false;
		}
		if !ui_active {
			return false;
		}

		// ESC closes the task window (same as the close button).
		if get_input_down(Input.ESCAPE, true) {
			ui_active = false;
			return true;
		}

		max_len := target_word.count;
		if max_len <= 0 {
			return false;
		}

		// Delete clears the whole input.
		if get_input_down(Input.DELETE, true) {
			input_chars = List(u8).{};
		}

		// Backspace (with repeat) removes characters.
		if get_input_down(Input.BACKSPACE, true) || get_input_repeat(Input.BACKSPACE, true) {
			if input_chars.elements.count > 0 {
				input_chars.pop();
			}
		}

		// Letters A-Z.
		base := Input.A.(int);
		for i: 0..25 {
			key := (base + i).(Input);
			if get_input_down(key, true) {
				if input_chars.elements.count < max_len {
					input_chars.append((65 + i).(u8));
				}
			}
		}

		// Consume enter so it doesn't leak to other UI widgets.
		// (The task still auto-validates when you reach the full length.)
		if get_input_down(Input.ENTER, true) {
		}
		if get_input_down(Input.KP_ENTER, true) {
		}
		return false;
	}

	update_task :: proc(using this: Task_Anagram_Puzzle, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}
		if !player.is_local_or_server() {
			return;
		}

		if anagram_bg_texture == null {
			init_textures(this);
		}
		init_puzzle(this);

		// Success flow
		if success_time > 0.0 {
			elapsed := get_time() - success_time;
			if elapsed >= SUCCESS_DISPLAY_TIME {
				ui_active = false;
				complete_attempt(this, player, true);
				return;
			}
			draw_anagram_ui(this, player, true);
			return;
		}

		// If failing, lock briefly and keep drawing
		if fail_time > 0.0 {
			if get_time() - fail_time < FAIL_LOCK_TIME {
				draw_anagram_ui(this, player, false);
				return;
			}
			fail_time = 0.0;
		}

		// PC keyboard support (optional).
		if handle_keyboard_input(this, player) {
			return;
		}

		// If input complete, validate
		if input_chars.elements.count == target_word.count && target_word.count > 0 {
			if is_input_correct(this) {
				success_time = get_time();
				rr_task_sfx(player, RR_TASK_SFX_BEEP, 0.7);
				draw_anagram_ui(this, player, true);
				return;
			} else {
				fail_time = get_time();
				rr_task_sfx(player, RR_TASK_SFX_ERROR, 0.6);
				input_chars = List(u8).{};
				draw_anagram_ui(this, player, false);
				return;
			}
		}

		draw_anagram_ui(this, player, false);
	}
}

Task_Calibrate_Teleporter :: class : Task_Base {
	// Task state
	ui_active: bool;
	reticle_position: v2;  // Normalized position within targeting area (0-1 range)
	target_position: v2;   // The random target spot to find (0-1 range)
	rng_initialized: bool;
	success_time: float;   // Time when success was achieved
	task_complete_displayed: bool;
	
	// Textures
	window_texture: Texture_Asset;
	cursor_texture: Texture_Asset;
	schleem_hologram_L: Texture_Asset;
	schleem_hologram_R: Texture_Asset;
	schleem_piece_L: Texture_Asset;
	schleem_piece_R: Texture_Asset;
	schleem_alive: Texture_Asset;
	
	ALIGNMENT_THRESHOLD :: 0.05;  // How close reticle needs to be to target
	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;  // How long to show thumbs up before closing

	cancel_attempt :: proc(using this: Task_Calibrate_Teleporter, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}

		// Reset state so reopening behaves like a fresh attempt.
		started = false;
		ui_active = false;
		rng_initialized = false;
		success_time = 0.0;
		task_complete_displayed = false;
	}
	
	init_textures :: proc(using this: Task_Calibrate_Teleporter) {
		window_texture = get_asset(Texture_Asset, "sprites/tasks/calibrate_teleporter/window.png");
		cursor_texture = get_asset(Texture_Asset, "sprites/tasks/calibrate_teleporter/cursor.png");
		schleem_hologram_L = get_asset(Texture_Asset, "sprites/tasks/calibrate_teleporter/schleem_hologram_piece_L.png");
		schleem_hologram_R = get_asset(Texture_Asset, "sprites/tasks/calibrate_teleporter/schleem_hologram_piece_R.png");
		schleem_piece_L = get_asset(Texture_Asset, "sprites/tasks/calibrate_teleporter/schleem_piece_L.png");
		schleem_piece_R = get_asset(Texture_Asset, "sprites/tasks/calibrate_teleporter/schleem_piece_R.png");
		schleem_alive = get_asset(Texture_Asset, "sprites/tasks/calibrate_teleporter/schleem_alive.png");
	}
	
	init_target :: proc(using this: Task_Calibrate_Teleporter, player: Player) {
		if rng_initialized {
			return;
		}
		rng_initialized = true;
		rr_refresh_rng_state();
		target_position.x = rng_range_float(ref rr_rng_state.value, 0.2, 0.8);
		target_position.y = rng_range_float(ref rr_rng_state.value, 0.2, 0.8);
		reticle_position = .{0.5, 0.5};
	}

	update_task :: proc(using this: Task_Calibrate_Teleporter, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}
		
		if !player.is_local_or_server() {
			return;
		}
		
		if window_texture == null {
			init_textures(this);
		}
		init_target(this, player);
		
		if !ui_active {
			ui_active = true;
		}
		
		if success_time > 0.0 {
			elapsed := get_time() - success_time;
			if elapsed >= SUCCESS_DISPLAY_TIME {
				ui_active = false;
				complete_attempt(this, player, true);
				return;
			}
			draw_calibrate_ui(this, player, true);
			return;
		}
		
		draw_calibrate_ui(this, player, false);
	}

	draw_calibrate_ui :: proc(using task: Task_Calibrate_Teleporter, player: Player, success_state: bool) {
		screen := UI.get_screen_rect();
		
		bg_texture := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, bg_texture, .{0.0, 0.0, 0.0, 0.85});
		
		// Window in center - make it appropriately sized
		window_size := 800.0;
		window_rect := screen.center_rect().grow(window_size / 2.0);
		window_rect = window_rect.fit_aspect(task.window_texture.get_aspect(), .KEEP_HEIGHT);
		UI.quad(window_rect, task.window_texture, .{1, 1, 1, 1});

		// Close (top-right)
		if draw_task_close_button(window_rect, player, task) {
			task.ui_active = false;
			return;
		}
		
		target_area := window_rect.inset_unscaled(window_rect.height() * 0.57, window_rect.width() * 0.242, window_rect.height() * 0.0365, window_rect.width() * 0.242);
		schleem_rect := window_rect.center_rect().grow(150).offset(0, 220);
		
		// DEBUG: Draw target area background
		//UI.quad(target_area, bg_texture, .{1, 0, 0, 0.6});
		
		if success_state {
			// SUCCESS STATE - Show alive schleem with thumbs up
			schleem_rect = schleem_rect.fit_aspect(task.schleem_alive.get_aspect(), .KEEP_WIDTH);
			pulse := 1.0 + sin(get_time() * 8.0) * 0.05;
			schleem_rect = schleem_rect.scale(pulse, pulse);
			
			UI.quad(schleem_rect, task.schleem_alive, .{1, 1, 1, 1});
			
			success_rect := window_rect.cut_top(50).offset(0, 20);
			success_ts := UI.default_text_settings();
			success_ts.size = 42;
			success_ts.color = .{0.3, 1.0, 0.4, 1.0};
			success_ts.halign = .CENTER;
			success_ts.valign = .CENTER;
			UI.text(success_rect, success_ts, "TELEPORTATION COMPLETE!");
		} else {
			// CALIBRATION STATE - Handle input and draw hologram pieces
			UI.push_id("calibrate_target_area");
			defer UI.pop_id();
			
			btn_bs: Button_Settings = .{};
			rr_ui_apply_button_click_sound(ref btn_bs);
			interact := UI.button(target_area, btn_bs, .{}, "");
			
			if interact.active {
				// Calculate relative position within target area
				input_area_size := target_area.max - target_area.min;
				
				if input_area_size.x > 0.0 && input_area_size.y > 0.0 {
					rel_x := (interact.mouse_position.x - target_area.min.x) / input_area_size.x;
					rel_y := (interact.mouse_position.y - target_area.min.y) / input_area_size.y;
					task.reticle_position.x = clamp(rel_x, 0.0, 1.0);
					task.reticle_position.y = clamp(rel_y, 0.0, 1.0);
				}
			}
			
			// Calculate distance from target (0 = perfect, 1 = far)
			dx := task.reticle_position.x - task.target_position.x;
			dy := task.reticle_position.y - task.target_position.y;
			distance := sqrt(dx * dx + dy * dy);
			max_distance := sqrt(2.0);  // Max possible distance in unit square
			alignment := 1.0 - clamp(distance / max_distance, 0.0, 1.0);
			
			// Check for success
			if distance < ALIGNMENT_THRESHOLD {
				task.success_time = get_time();
				rr_task_sfx(player, RR_TASK_SFX_BEEP, 0.7);
			}
			
			// Calculate split offset based on distance (further = more split)
			split_amount := (1.0 - alignment) * 75.0;
			
			// Hologram opacity - more solid as alignment increases
			hologram_alpha := 0.3 + alignment * 0.4;
			solid_alpha := clamp(alignment * alignment - 0.5, 0.0, 0.5) * 2.0;  // Quadratic for dramatic reveal
			left_rect := schleem_rect.offset(-split_amount*5, 0);
			right_rect := schleem_rect.offset(split_amount*5, 0);
			// Hologram tint (cyan/green glow)
			hologram_tint := v4.{0.3, 1.0, 0.8, hologram_alpha};
			// Draw hologram pieces (back layer)
			left_rect = left_rect.fit_aspect(task.schleem_hologram_L.get_aspect(), .KEEP_WIDTH);
			right_rect = right_rect.fit_aspect(task.schleem_hologram_R.get_aspect(), .KEEP_WIDTH);
			UI.quad(left_rect, task.schleem_hologram_L, hologram_tint);
			UI.quad(right_rect, task.schleem_hologram_R, hologram_tint);
			// Draw solid pieces on top as they align (front layer)
			if solid_alpha > 0.05 {
				solid_tint := v4.{1.0, 1.0, 1.0, solid_alpha};
				UI.quad(left_rect, task.schleem_piece_L, solid_tint);
				UI.quad(right_rect, task.schleem_piece_R, solid_tint);
			}
	
			// Draw the reticle/cursor
			cursor_size := 50.0;
			target_area = target_area.inset(25);
			cursor_offset :v2= .{task.reticle_position.x * target_area.width(), task.reticle_position.y * target_area.height()};
			cursor_rect := target_area.bottom_left_rect().grow(cursor_size / 2.0).offset_unscaled(cursor_offset.x, cursor_offset.y);
			cursor_rect = cursor_rect.fit_aspect(task.cursor_texture.get_aspect(), .KEEP_HEIGHT);
			cursor_pulse := 1.0 + sin(get_time() * 4.0) * 0.1;
			cursor_rect = cursor_rect.scale(cursor_pulse, cursor_pulse);																			
			UI.quad(cursor_rect, task.cursor_texture, .{1, 1, 1, 0.9});
		}
	}
}

Task_Cypher :: class : Task_Base {
	// Task state
	ui_active: bool;
	rng_initialized: bool;

	code_icons: List(int);   // icon indices in correct order (len = 4)
	input_icons: List(int);  // player's current input

	success_time: float;
	fail_time: float;

	// Textures
	frame_texture: Texture_Asset;
	pass_card_texture: Texture_Asset;
	button_texture: Texture_Asset;
	button_pressed_texture: Texture_Asset;
	lights_off_texture: Texture_Asset;
	lights_on_texture: Texture_Asset;

	icon_ssundee: Texture_Asset;
	icon_sigils: Texture_Asset;
	icon_garry: Texture_Asset;
	icon_skull: Texture_Asset;
	icon_schleem: Texture_Asset;
	icon_foot: Texture_Asset;
	icon_knife: Texture_Asset;
	icon_apple: Texture_Asset;
	icon_hand: Texture_Asset;

	CODE_LEN :: 4;
	FAIL_LOCK_TIME :: 0.75;
	// Reduce post-success linger before auto-close.
	SUCCESS_DISPLAY_TIME :: 0.6;

	start_attempt :: proc(using this: Task_Cypher, player: Player) {
		if started {
			return;
		}
		started = true;
		// Reset any previous state (in case task is re-opened)
		input_icons = List(int).{};
		success_time = 0.0;
		fail_time = 0.0;
		ui_active = true;
	}

	init_textures :: proc(using this: Task_Cypher) {
		frame_texture = get_asset(Texture_Asset, "sprites/tasks/cypher/keypad_frame.png");
		pass_card_texture = get_asset(Texture_Asset, "sprites/tasks/cypher/pass_card.png");
		button_texture = get_asset(Texture_Asset, "sprites/tasks/cypher/button_base.png");
		button_pressed_texture = get_asset(Texture_Asset, "sprites/tasks/cypher/button_pressed_base.png");
		lights_off_texture = get_asset(Texture_Asset, "sprites/tasks/cypher/light_red.png");
		lights_on_texture = get_asset(Texture_Asset, "sprites/tasks/cypher/light_green.png");

		icon_ssundee = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_ssundee.png");
		icon_sigils = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_burger.png");
		icon_garry = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_pie.png");
		icon_skull = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_skull.png");
		icon_schleem = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_schleem.png");
		icon_foot = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_foot.png");
		icon_knife = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_knife.png");
		icon_apple = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_apple.png");
		icon_hand = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_hand.png");
	}

	get_icon_texture :: proc(using this: Task_Cypher, icon_idx: int) -> Texture_Asset {
		switch icon_idx {
			case 0: return icon_ssundee;
			case 1: return icon_sigils;
			case 2: return icon_garry;
			case 3: return icon_skull;
			case 4: return icon_schleem;
			case 5: return icon_foot;
			case 6: return icon_knife;
			case 7: return icon_apple;
			case 8: return icon_hand;
			default: return null;
		}
	}

	get_hint_text :: proc(icon_idx: int) -> string {
		switch icon_idx {
			case 0: return "Youtuber";
			case 1: return "Patty";
			case 2: return "Pie";
			case 3: return "Death";
			case 4: return "All Out";
			case 5: return "Feet";
			case 6: return "Sharp";
			case 7: return "Juice";
			case 8: return "Hand";
			default: return "???";
		}
	}

	init_code :: proc(using this: Task_Cypher, player: Player) {
		if rng_initialized {
			return;
		}
		rng_initialized = true;
		rr_refresh_rng_state();

		code_icons = List(int).{};
		input_icons = List(int).{};

		// Build a pool [0..8] and pick 4 unique hints/icons in order
		available: List(int);
		for i: 0..8 {
			append(ref available, i);
		}

		for i: 0..CODE_LEN-1 {
			pick := rng_range_int(ref rr_rng_state.value, 0, available.elements.count-1);
			val := available.elements[pick];

			last_idx := available.elements.count - 1;
			available.elements[pick] = available.elements[last_idx];
			pop(ref available);

			append(ref code_icons, val);
		}
	}

	is_input_prefix_correct :: proc(using this: Task_Cypher) -> bool {
		if input_icons.elements.count == 0 {
			return true;
		}
		for i: 0..input_icons.elements.count-1 {
			if input_icons.elements[i] != code_icons.elements[i] {
				return false;
			}
		}
		return true;
	}

	handle_press :: proc(using this: Task_Cypher, icon_idx: int) {
		if success_time > 0.0 {
			return;
		}
		if fail_time > 0.0 {
			if get_time() - fail_time < FAIL_LOCK_TIME {
				return;
			}
			fail_time = 0.0;
		}
		if input_icons.elements.count >= CODE_LEN {
			return;
		}

		append(ref input_icons, icon_idx);

		// Wrong input -> fail flash and reset
		if !is_input_prefix_correct(this) {
			fail_time = get_time();
			input_icons = List(int).{};
			return;
		}

		// Completed and correct
		if input_icons.elements.count == CODE_LEN {
			success_time = get_time();
		}
	}

	update_task :: proc(using this: Task_Cypher, player: Player) {
		if !started {
			return;
		}
		if completed {
			return;
		}
		if !player.is_local_or_server() {
			return;
		}

		if frame_texture == null {
			init_textures(this);
		}
		init_code(this, player);

		if success_time > 0.0 {
			elapsed := get_time() - success_time;
			if elapsed >= SUCCESS_DISPLAY_TIME {
				ui_active = false;
				complete_attempt(this, player, true);
				return;
			}
			draw_cypher_ui(this, player, true);
			return;
		}

		draw_cypher_ui(this, player, false);
	}

	draw_cypher_ui :: proc(using task: Task_Cypher, player: Player, success_state: bool) {
		screen := UI.get_screen_rect();
		bg_texture := get_asset(Texture_Asset, "$AO/white.png");
		UI.quad(screen, bg_texture, .{0.0, 0.0, 0.0, 0.85});

		fail_active := false;
		if task.fail_time > 0.0 {
			fail_active = (get_time() - task.fail_time) < FAIL_LOCK_TIME;
			if !fail_active {
				task.fail_time = 0.0;
			}
		}

		// Layout: keypad on left, note on right (matches reference screenshot)
		window_size := 900.0;
		keypad_rect := screen.center_rect().grow(window_size / 2.0).offset(-220, 0);
		keypad_rect = keypad_rect.fit_aspect(task.frame_texture.get_aspect(), .KEEP_HEIGHT);

		// Slight shake when failing (for juice)
		if fail_active {
			shake := sin(get_time() * 40.0) * 6.0;
			keypad_rect = keypad_rect.offset(shake, 0);
		}

		UI.quad(keypad_rect, task.frame_texture, .{1, 1, 1, 1});

		// Close (top-right of keypad panel)
		if draw_task_close_button(keypad_rect, player, task) {
			task.ui_active = false;
			return;
		}

		note_rect := screen.center_rect().grow(180).offset(420, 60);
		note_rect = note_rect.fit_aspect(task.pass_card_texture.get_aspect(), .KEEP_WIDTH);
		UI.quad(note_rect, task.pass_card_texture, .{1, 1, 1, 1});

		// Note text (the "hints")
		title_ts := UI.default_text_settings();
		title_ts.size = 64;
		title_ts.color = .{1, 1, 1, 1};
		title_ts.halign = .CENTER;
		title_ts.valign = .CENTER;
		UI.text(note_rect.cut_top(80).offset(0, -10), title_ts, "HINTS");

		hint_ts := UI.default_text_settings();
		hint_ts.size = 48;
		hint_ts.color = .{0.5, 0.5, 0.5, 1};
		hint_ts.halign = .LEFT;
		hint_ts.valign = .CENTER;

		hints_rect := note_rect.inset_unscaled(20, 20, 20, 20);
		for i: 0..CODE_LEN-1 {
			line := hints_rect.cut_top(55);
			hint := get_hint_text(task.code_icons.elements[i]);
			UI.text(line, hint_ts, format_string("%) %", .{i+1, hint}));
		}

		// Screen text feedback area (top green display)
		display_rect := keypad_rect.inset_unscaled(keypad_rect.height() * 0.16, keypad_rect.width() * 0.15, keypad_rect.height() * 0.62, keypad_rect.width() * 0.15);
		display_ts := UI.default_text_settings();
		display_ts.size = 64;
		display_ts.halign = .LEFT;
		display_ts.valign = .CENTER;

		if success_state {
			display_ts.color = .{0.1, 0.35, 0.1, 1};
			UI.text(display_rect, display_ts, "ACCESS GRANTED");
		} else if fail_active {
			display_ts.color = .{0.7, 0.1, 0.1, 1};
			UI.text(display_rect, display_ts, "ACCESS DENIED");
		} else {
			display_ts.color = .{0.1, 0.25, 0.1, 1};
			stars := "";
			for i: 0..task.input_icons.elements.count-1 {
				stars = format_string("% *", .{stars});
			}
			display_rect.offset_unscaled(0, -10);
			display_ts.size = 128;
			UI.text(display_rect, display_ts, stars);
		}

		// Top Lights
		keypad_rect.cut_top_unscaled(keypad_rect.height() * 0.05);
		lights_rect := keypad_rect.cut_top_unscaled(keypad_rect.height() * 0.075);
		lights_rect = lights_rect.fit_aspect(task.lights_off_texture.get_aspect(), .KEEP_HEIGHT);
		if success_state {
			UI.quad(lights_rect, task.lights_on_texture, .{1, 1, 1, 1});
		} else {
			UI.quad(lights_rect, task.lights_off_texture, .{1, 1, 1, 1});
		}

		// Keypad area (bottom blue panel) -> 3x3 icon buttons
		k_height := keypad_rect.height();
		k_width := keypad_rect.width();
		keypad_area := keypad_rect.inset_unscaled(k_height * 0.35, k_width * 0.11, k_height * 0.09, k_width * 0.11);

		// Ordering matches the icons in the hint table (indices 0..8)
		for row: 0..2 {
			for col: 0..2 {
				idx := row * 3 + col;
				cell := keypad_area.subrect(col.(f32) / 3.0, row.(f32) / 3.0, (col.(f32) + 1.0) / 3.0, (row.(f32) + 1.0) / 3.0);
				cell = cell.grow(3);

				UI.push_id("cypher_btn_%", .{idx});
				defer UI.pop_id();

				btn_bs: Button_Settings = .{};
				rr_ui_apply_button_click_sound(ref btn_bs);
				interact := UI.button(cell, btn_bs, .{}, "");

				// Draw base/pressed
				base_tex := task.button_texture;
				if interact.active {
					base_tex = task.button_pressed_texture;
				}
				btn_rect := cell.fit_aspect(base_tex.get_aspect(), .KEEP_WIDTH);
				UI.quad(btn_rect, base_tex, .{1, 1, 1, 1});

				// Icon
				icon := task.get_icon_texture(idx);
				icon_rect := btn_rect.inset_unscaled(10, 10, 10, 10);
				icon_rect = icon_rect.fit_aspect(icon.get_aspect(), .KEEP_HEIGHT);
				UI.quad(icon_rect, icon, .{1, 1, 1, 1});

				if interact.clicked && !success_state && !fail_active {
					prev_success := task.success_time;
					prev_fail := task.fail_time;
					task.handle_press(idx);
					if task.success_time > 0.0 && prev_success <= 0.0 {
						rr_task_sfx(player, RR_TASK_SFX_BEEP, 0.7);
					} else if task.fail_time > prev_fail && task.fail_time > 0.0 {
						rr_task_sfx(player, RR_TASK_SFX_ERROR, 0.6);
					} else {
						rr_task_sfx(player, RR_TASK_SFX_TILE_CLICK, 0.5);
					}
				}
			}
		}
	}
}
