import "core:ao"

DOCTOR_RESURRECT_DURATION_SECONDS :: 10.0;
DOCTOR_RESURRECTS_PER_ROUND :: 2;

KILL_COOLDOWN_SECONDS :: 30.0;

// --- Hitman ---
HITMAN_NECK_SNAP_COOLDOWN_SECONDS :: 60.0;
HITMAN_SNIPER_COOLDOWN_SECONDS :: 90.0;
HITMAN_MINE_COOLDOWN_SECONDS :: 60.0;

HITMAN_NECK_SNAP_RANGE :: 2.0;
HITMAN_MINE_TRIGGER_RADIUS :: 0.8;
HITMAN_MINE_STUN_SECONDS :: 10.0;
HITMAN_MINE_MAX_FLING_SECONDS :: 1.5;
HITMAN_MINE_FLING_SPEED :: 14.0;

HITMAN_MINE_FLING_REASON :: "hitman_mine_fling";
HITMAN_MINE_STUN_REASON :: "hitman_mine_stun";
HITMAN_SNIPER_CAMERA_ZOOMED_OUT_SIZE :: 18.0;

HITMAN_NECK_SNAP_LOCK_REASON :: "hitman_neck_snap_lock";
HITMAN_NECK_SNAP_LOCK_SECONDS :: 1.1;

get_player_by_entity_id :: proc(entity_id: u64) -> Player {
    for i: 0..players.elements.count-1 {
        p := players.elements[i];
        if p == null continue;
        if !#alive(p.entity) continue;
        if p.entity.id == entity_id {
            return p;
        }
    }
    return null;
}

build_voted_list :: proc() -> string {
	names := "";
	for i: 0..players.elements.count-1 {
		v := players.elements[i];
		if v == null continue;
		if v.player_state != Player_State.ALIVE continue;
		if !v.has_voted continue;

		n := v.entity->get_name();
		if names.count > 0 {
			names = format_string("%, %", .{names, n});
		} else {
			names = n;
		}
	}
	return names;
}

draw_ability_name_label :: proc(button_rect: Rect, label: string) {
	if label.count <= 0 return;

	bg := get_asset(Texture_Asset, "$AO/white.png");

	// Draw a small strip at the bottom of the button for readability.
	label_rect := button_rect->inset(8)->cut_bottom(30);
	UI.quad(label_rect, bg, v4.{0, 0, 0, 0.55});

	ts := UI.default_text_settings();
	ts.size = 22;
	ts.color = v4.{1, 1, 1, 1};
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 2;
	ts.outline_color = v4.{0, 0, 0, 1};
	UI.text(label_rect, ts, label);
}

Kill_Ability :: class : Ability_Base {
    NAME :: "Kill";

    on_init :: proc(instance: Kill_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/kill_ability.png");
    }

    get_closest_alive_player :: proc(instance: Kill_Ability, player: Player) -> Player {
        finder := make_finder(Player, player.entity.world_position, 5.0);
        for i: 0..players.elements.count-1 {
            target := players.elements[i];
            if target == null {
                continue;
            }
            if !#alive(target.entity) {
                continue;
            }
            if target == player {
                continue;
            }
            if target.player_state != Player_State.ALIVE {
                continue;
            }

            // Traitors shouldn't be able to melee-kill other traitors.
            if player.player_type == Player_Type.TRAITOR && target.player_type == Player_Type.TRAITOR {
                continue;
            }
            finder->check(target, target.entity.world_position);
        }
        return finder.closest;
    }

    can_use :: method() -> bool {
        if game_state != Game_State.INGAME return false;
        if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
        return get_closest_alive_player(this, player) != null;
    }

    on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

        if params.clicked && params.can_use {
            closest_alive_player := get_closest_alive_player(this, player);
            if closest_alive_player != null {
                closest_alive_player->kill_with_killer(player.entity.id);

				// Traitor knife kill SFX (server-authoritative; replicates to clients).
				if Game.is_server() && player != null && player.player_type == Player_Type.TRAITOR {
					sfx := SFX.default_sfx_desc();
					sfx->set_position(closest_alive_player.entity.world_position);
					sfx.volume = 0.35;
					sfx.volume_perturb = 0.08;
					sfx.speed_perturb = 0.06;
					// Global SFX mix: everything at 25% volume.
					sfx.volume *= 0.25;
					sfx.volume_perturb *= 0.25;
					rr_play_sfx("sfx/traitor_kill_death.wav", sfx);
				}

                current_cooldown = KILL_COOLDOWN_SECONDS;
            }
        }
    }

	on_draw_button :: proc(instance: Kill_Ability, rect: Rect) {
		draw_ability_name_label(rect, Kill_Ability.NAME);
	}
}

// --- Drag Body (Traitor utility) ---
DRAG_BODY_GRAB_RANGE :: 2.5;
DRAG_BODY_FOLLOW_DISTANCE :: 0.3;

rr_drag_body_get_closest_draggable_corpse :: proc(player: Player) -> Corpse {
	if player == null return null;
	if player.player_state != Player_State.ALIVE return null;
	if game_state != Game_State.INGAME return null;

	finder := make_finder(Corpse, player.entity.world_position, DRAG_BODY_GRAB_RANGE);
	foreach corpse: component_iterator(Corpse) {
		if corpse == null continue;
		if !#alive(corpse.entity) continue;
		if corpse.has_been_reported continue;

		// Only allow dragging corpses for players that are currently dead.
		owner := get_player_by_entity_id(corpse.owner_player_entity_id);
		if owner == null continue;
		if owner.player_state != Player_State.DEAD continue;

		// Don't allow two traitors to drag the same body.
		if corpse.dragged_by_player_entity_id != 0 && corpse.dragged_by_player_entity_id != player.entity.id {
			continue;
		}

		finder->check(corpse, corpse.entity.world_position);
	}
	return finder.closest;
}

rr_drag_body_find_corpse_by_entity_id :: proc(corpse_entity_id: u64) -> Corpse {
	if corpse_entity_id == 0 return null;
	foreach corpse: component_iterator(Corpse) {
		if corpse == null continue;
		if !#alive(corpse.entity) continue;
		if corpse.entity.id == corpse_entity_id {
			return corpse;
		}
	}
	return null;
}

Drag_Body_Ability :: class : Ability_Base {
	NAME :: "Drag";

	on_init :: proc(instance: Drag_Body_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/drag_body_icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;

		// Allow button to stay enabled while already dragging (so you can drop).
		if player.dragging_corpse_entity_id != 0 return true;
		return rr_drag_body_get_closest_draggable_corpse(player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		dragging := player != null && player.dragging_corpse_entity_id != 0;

		// Toggle grab/drop.
		if params.clicked && params.can_use && Game.is_server() {
			if dragging {
				rr_drag_body_force_drop_for_player(player);
				return;
			}

			corpse := rr_drag_body_get_closest_draggable_corpse(player);
			if corpse == null return;

			player.dragging_corpse_entity_id = corpse.entity.id;
			corpse.dragged_by_player_entity_id = player.entity.id;

			// Start loop SFX while dragging (server-authoritative).
			if player != null {
				if player.drag_body_sfx_id != 0 {
					SFX.stop(player.drag_body_sfx_id);
					player.drag_body_sfx_id = 0;
				}
				sound := get_asset(SFX_Asset, "sfx/drag_body_loop.wav");
				if sound != null {
					sfx := SFX.default_sfx_desc();
					sfx.entity_to_follow = player.entity.id;
					sfx.volume = 0.55;
					sfx.volume_perturb = 0.03;
					sfx.speed_perturb = 0.02;
					// Global SFX mix: everything at 25% volume.
					sfx.volume *= 0.25;
					sfx.volume_perturb *= 0.25;
					player.drag_body_sfx_id = SFX.play(sound, sfx);
				}
			}
		}

		// Follow update while dragging.
		if dragging {
			corpse := rr_drag_body_find_corpse_by_entity_id(player.dragging_corpse_entity_id);
			if corpse == null {
				// Corpse got deleted (reported / destroyed) while dragging.
				if Game.is_server() {
					player.dragging_corpse_entity_id = 0;
					if player.drag_body_sfx_id != 0 {
						SFX.stop(player.drag_body_sfx_id);
						player.drag_body_sfx_id = 0;
					}
					player->set_trigger("RESET");
				}
				return;
			}

			// Corpse follow is handled server-side in `Corpse.ao_update` (with smoothing).
		}
	}

	on_draw_button :: proc(instance: Drag_Body_Ability, rect: Rect) {
		draw_ability_name_label(rect, Drag_Body_Ability.NAME);
	}
}

// --- Werewolf (Traitor role) ---
WEREWOLF_DEVOUR_COOLDOWN_SECONDS :: 60.0;
WEREWOLF_INFECT_COOLDOWN_SECONDS :: 60.0;
WEREWOLF_CLAW_COOLDOWN_SECONDS :: 90.0;

WEREWOLF_DEVOUR_RANGE :: 2.0;
WEREWOLF_INFECT_RANGE :: 2.0;
WEREWOLF_PASS_BITE_RANGE :: 2.0;

WEREWOLF_INFECT_UNLOCK_KILLS :: 1;
WEREWOLF_CLAW_UNLOCK_KILLS :: 2;

WEREWOLF_CLAW_PROJECTILE_SPEED :: 12.0;
WEREWOLF_CLAW_PROJECTILE_LIFETIME :: 0.45;

WEREWOLF_INFECTION_STUN_REASON :: "werewolf_infection_stun";
WEREWOLF_INFECTION_STUN_SECONDS :: 1.0;
// Delay before applying the werewolf skin on infected targets (halfway through transform anim).
WEREWOLF_INFECTED_SKIN_DELAY_SECONDS :: 1.0;
WEREWOLF_INFECT_TO_CURE_TASK_ID :: "werewolf_infect_to_cure";

rr_werewolf_apply_infected_task_override :: proc(target: Player) {
	if target == null return;
	if !target.werewolf_infected return;

	// Only override once per infection session.
	if !target.werewolf_saved_tasks_active {
		target.werewolf_saved_tasks = target.active_tasks;
		target.werewolf_saved_tasks_active = true;
	}

	// Replace with a single objective entry.
	target.active_tasks = List(Task_Base).{};
	obj := new(Task_Base);
	obj.id = WEREWOLF_INFECT_TO_CURE_TASK_ID;
	obj.started = false;
	obj.completed = false;
	append(ref target.active_tasks, obj);
}

rr_werewolf_clear_infected_task_override :: proc(player: Player) {
	if player == null return;
	if player.werewolf_infected return; // still infected
	if !player.werewolf_saved_tasks_active return;

	player.active_tasks = player.werewolf_saved_tasks;
	player.werewolf_saved_tasks = List(Task_Base).{};
	player.werewolf_saved_tasks_active = false;
}

rr_werewolf_find_melee_target :: proc(attacker: Player, range: float, exclude_werewolf: bool) -> Player {
	if attacker == null return null;
	finder := make_finder(Player, attacker.entity.world_position, range);
	for i: 0..players.elements.count-1 {
		target := players.elements[i];
		if target == null continue;
		if !#alive(target.entity) continue;
		if target == attacker continue;
		if target.player_state != Player_State.ALIVE continue;

		// Traitors shouldn't be able to melee-kill other traitors.
		if attacker.player_type == Player_Type.TRAITOR && target.player_type == Player_Type.TRAITOR {
			continue;
		}
		if exclude_werewolf && target.player_role == Player_Role.WEREWOLF {
			continue;
		}

		finder->check(target, target.entity.world_position);
	}
	return finder.closest;
}

rr_werewolf_apply_infection :: proc(infector: Player, target: Player) {
	if infector == null return;
	if target == null return;
	if !#alive(infector.entity) return;
	if !#alive(target.entity) return;
	if infector.player_state != Player_State.ALIVE return;
	if target.player_state != Player_State.ALIVE return;

	// Server authoritative: infection state is gameplay-relevant.
	if !Game.is_server() return;

	target.werewolf_infected = true;
	target.werewolf_infected_from_id = infector.entity.id;

	// Merged rig handles animations; trigger bite + transform.
	infector->set_trigger("werewolf_infection_bite");
	target->set_trigger("werewolf_infected_transform");
	// Enable werewolf skin halfway through the victim's transform animation.
	target.werewolf_skin_enable_at = get_time() + WEREWOLF_INFECTED_SKIN_DELAY_SECONDS;
	target.werewolf_skin_disable_at = 0.0;

	target->Notify("You were bitten! Pass it on to return to normal.");
	rr_werewolf_apply_infected_task_override(target);

	// Brief "fall" stun for readability.
	stun := target.entity->get_component(Werewolf_Infection_Stun);
	if stun == null {
		stun = target.entity->add_component(Werewolf_Infection_Stun);
	}
	stun->arm(WEREWOLF_INFECTION_STUN_SECONDS);
}

rr_werewolf_pass_infection :: proc(biter: Player, new_target: Player) {
	if biter == null return;
	if new_target == null return;
	if !#alive(biter.entity) return;
	if !#alive(new_target.entity) return;
	if biter.player_state != Player_State.ALIVE return;
	if new_target.player_state != Player_State.ALIVE return;
	if !biter.werewolf_infected return;
	if new_target.player_role == Player_Role.WEREWOLF return; // cannot pass back to the werewolf

	// Server authoritative.
	if !Game.is_server() return;

	from_id := biter.werewolf_infected_from_id;
	biter.werewolf_infected = false;
	biter.werewolf_infected_from_id = 0;
	rr_werewolf_clear_infected_task_override(biter);

	new_target.werewolf_infected = true;
	new_target.werewolf_infected_from_id = from_id;
	rr_werewolf_apply_infected_task_override(new_target);

	// Restore the cured player's look, and trigger transform on the new infected player.
	biter->set_trigger("RESET");
	biter.werewolf_skin_enable_at = 0.0;
	biter.werewolf_skin_disable_at = get_time();
	new_target->set_trigger("werewolf_infected_transform");
	new_target.werewolf_skin_enable_at = get_time() + WEREWOLF_INFECTED_SKIN_DELAY_SECONDS;
	new_target.werewolf_skin_disable_at = 0.0;

	biter->Notify("You passed the bite. You're back to normal.");
	new_target->Notify("You were bitten! Pass it on to return to normal.");

	stun := new_target.entity->get_component(Werewolf_Infection_Stun);
	if stun == null {
		stun = new_target.entity->add_component(Werewolf_Infection_Stun);
	}
	stun->arm(WEREWOLF_INFECTION_STUN_SECONDS);
}

Werewolf_Infection_Stun :: class : Component {
	active: bool;
	end_time: float;

	arm :: proc(using this: Werewolf_Infection_Stun, seconds: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		active = true;

		p := entity->get_component(Player);
		if p != null {
			p->add_disable_movement_input_reason(WEREWOLF_INFECTION_STUN_REASON);
		}
	}

	ao_update :: proc(using this: Werewolf_Infection_Stun, dt: float) {
		if !active return;
		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(WEREWOLF_INFECTION_STUN_REASON);
			active = false;
			return;
		}

		if get_time() >= end_time {
			p->remove_disable_movement_input_reason(WEREWOLF_INFECTION_STUN_REASON);
			active = false;
		}
	}
}

Werewolf_Devour_Ability :: class : Ability_Base {
	NAME :: "Devour";

	on_init :: proc(instance: Werewolf_Devour_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/werewolf/devour.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.WEREWOLF return false;
		if !player.werewolf_is_wolf_form return false;
		return rr_werewolf_find_melee_target(player, WEREWOLF_DEVOUR_RANGE, true) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		if params.clicked && params.can_use {
			target := rr_werewolf_find_melee_target(player, WEREWOLF_DEVOUR_RANGE, true);
			if target != null {
				// Devour should leave a corpse behind (used for report/doctor/coroner/pyro, etc.).
				target->kill_with_killer(player.entity.id);
				current_cooldown = WEREWOLF_DEVOUR_COOLDOWN_SECONDS;
			}
		}
	}

	on_draw_button :: proc(instance: Werewolf_Devour_Ability, rect: Rect) {
		draw_ability_name_label(rect, Werewolf_Devour_Ability.NAME);
	}
}

Werewolf_Infecting_Bite_Ability :: class : Ability_Base {
	NAME :: "Infect";

	on_init :: proc(instance: Werewolf_Infecting_Bite_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/werewolf/infecting_bite.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.WEREWOLF return false;
		if !player.werewolf_is_wolf_form return false;
		// Unlock after 1 kill.
		if player.werewolf_kills < WEREWOLF_INFECT_UNLOCK_KILLS return false;
		return rr_werewolf_find_melee_target(player, WEREWOLF_INFECT_RANGE, true) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			if player != null && player.player_role == Player_Role.WEREWOLF && player.werewolf_kills < WEREWOLF_INFECT_UNLOCK_KILLS {
				player->Notify(format_string("Infect locked: get %/% kills as Werewolf to unlock.", .{
					min(player.werewolf_kills, WEREWOLF_INFECT_UNLOCK_KILLS),
					WEREWOLF_INFECT_UNLOCK_KILLS
				}));
			}
		}

		if params.clicked && params.can_use {
			target := rr_werewolf_find_melee_target(player, WEREWOLF_INFECT_RANGE, true);
			if target != null {
				rr_werewolf_apply_infection(player, target);
				current_cooldown = WEREWOLF_INFECT_COOLDOWN_SECONDS;
			}
		}
	}

	on_draw_button :: proc(instance: Werewolf_Infecting_Bite_Ability, rect: Rect) {
		draw_ability_name_label(rect, Werewolf_Infecting_Bite_Ability.NAME);

		// Locked overlay (shown while in wolf form until unlocked).
		p := instance.player;
		if p != null && p.player_role == Player_Role.WEREWOLF && p.werewolf_kills < WEREWOLF_INFECT_UNLOCK_KILLS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect->inset(2)->cut_top(20), ts, "LOCKED");
		}
	}
}

Werewolf_Claw_Slash_Ability :: class : Ability_Base {
	NAME :: "Claw";

	on_init :: proc(instance: Werewolf_Claw_Slash_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/werewolf/claw_slash.png");
		instance.disable_keybind = true;
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.WEREWOLF return false;
		if !player.werewolf_is_wolf_form return false;
		// Unlock after 2 kills.
		if player.werewolf_kills < WEREWOLF_CLAW_UNLOCK_KILLS return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			if player != null && player.player_role == Player_Role.WEREWOLF && player.werewolf_kills < WEREWOLF_CLAW_UNLOCK_KILLS {
				player->Notify(format_string("Claw locked: get %/% kills as Werewolf to unlock.", .{
					min(player.werewolf_kills, WEREWOLF_CLAW_UNLOCK_KILLS),
					WEREWOLF_CLAW_UNLOCK_KILLS
				}));
			}
		}

		activation := Ability_Utilities.full_update_aimed_ability(player, ref params);
		if params.can_use && activation.activate {
			p := shoot_projectile(player.entity.world_position, activation.direction * WEREWOLF_CLAW_PROJECTILE_SPEED, 1, WEREWOLF_CLAW_PROJECTILE_LIFETIME, player.entity);
			// Slightly bigger hit radius for a "slash" feel.
			if p != null {
				proj := p->get_component(RR_Projectile);
				if proj != null {
					proj.hit_radius = 0.65;
				}
			}
			current_cooldown = WEREWOLF_CLAW_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: Werewolf_Claw_Slash_Ability, rect: Rect) {
		draw_ability_name_label(rect, Werewolf_Claw_Slash_Ability.NAME);

		// Locked overlay (shown while in wolf form until unlocked).
		p := instance.player;
		if p != null && p.player_role == Player_Role.WEREWOLF && p.werewolf_kills < WEREWOLF_CLAW_UNLOCK_KILLS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect->inset(2)->cut_top(20), ts, "LOCKED");
		}
	}
}

Werewolf_Pass_Bite_Ability :: class : Ability_Base {
	NAME :: "Infect";

	on_init :: proc(instance: Werewolf_Pass_Bite_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/werewolf/infecting_bite.png");
	}

	get_closest_pass_target :: proc(instance: Werewolf_Pass_Bite_Ability, biter: Player) -> Player {
		if biter == null return null;
		finder := make_finder(Player, biter.entity.world_position, WEREWOLF_PASS_BITE_RANGE);
		for i: 0..players.elements.count-1 {
			target := players.elements[i];
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == biter continue;
			if target.player_state != Player_State.ALIVE continue;
			if target.player_role == Player_Role.WEREWOLF continue; // exclude werewolf(s)
			finder->check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if !player.werewolf_infected return false;
		return get_closest_pass_target(this, player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			target := get_closest_pass_target(this, player);
			if target != null {
				rr_werewolf_pass_infection(player, target);
				// No cooldown; the constraint is being infected + needing a nearby target.
				current_cooldown = 0.0;
			}
		}
	}

	on_draw_button :: proc(instance: Werewolf_Pass_Bite_Ability, rect: Rect) {
		draw_ability_name_label(rect, Werewolf_Pass_Bite_Ability.NAME);
	}
}

Hitman_Mine_Stun :: class : Component {
	stun_end_time: float;
	active: bool;

	arm :: proc(using this: Hitman_Mine_Stun, seconds: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		stun_end_time = get_time() + seconds;
		active = true;

		p := entity->get_component(Player);
		if p != null {
			p->add_disable_movement_input_reason(HITMAN_MINE_STUN_REASON);
			p->set_trigger("hitman_broken_leg_idle");
		}
	}

	ao_update :: proc(using this: Hitman_Mine_Stun, dt: float) {
		if !active return;
		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(HITMAN_MINE_STUN_REASON);
			// Ensure we leave the broken-leg loop when the stun ends early.
			p->set_trigger("RESET");
			active = false;
			return;
		}

		if get_time() >= stun_end_time {
			p->remove_disable_movement_input_reason(HITMAN_MINE_STUN_REASON);
			// Stop broken-leg idle when stun ends.
			p->set_trigger("RESET");
			active = false;
		}
	}
}

Hitman_Neck_Snap_Lock :: class : Component {
	active: bool;
	end_time: float;

	arm :: proc(using this: Hitman_Neck_Snap_Lock, seconds: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		active = true;

		p := entity->get_component(Player);
		if p != null {
			p->add_disable_movement_input_reason(HITMAN_NECK_SNAP_LOCK_REASON);
		}
	}

	ao_update :: proc(using this: Hitman_Neck_Snap_Lock, dt: float) {
		if !active return;
		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(HITMAN_NECK_SNAP_LOCK_REASON);
			p->set_trigger("RESET");
			active = false;
			return;
		}

		if get_time() >= end_time {
			p->remove_disable_movement_input_reason(HITMAN_NECK_SNAP_LOCK_REASON);
			p->set_trigger("RESET");
			active = false;
		}
	}
}

Hitman_Mine_Fling :: class : Component {
	active: bool;
	end_time: float;
	dir: v2;
	last_pos: v2;
	stuck_frames: int;

	arm :: proc(using this: Hitman_Mine_Fling, seconds: float, direction: v2, speed: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		active = true;
		dir = direction;
		last_pos = entity.world_position;
		stuck_frames = 0;

		p := entity->get_component(Player);
		if p != null {
			p->add_disable_movement_input_reason(HITMAN_MINE_FLING_REASON);
			p->set_facing_right(dir.x > 0);
			p->set_trigger("hitman_fly_forward");
			p.agent.velocity = dir * speed;
		}
	}

	ao_update :: proc(using this: Hitman_Mine_Fling, dt: float) {
		if !active return;
		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(HITMAN_MINE_FLING_REASON);
			active = false;
			return;
		}

		// Keep pushing until collision or timeout.
		p.agent.velocity = dir * HITMAN_MINE_FLING_SPEED;

		pos := entity.world_position;
		moved := length(pos - last_pos);
		last_pos = pos;

		// If we aren't moving meaningfully for a few frames, treat as collision.
		if moved < 0.01 {
			stuck_frames += 1;
		} else {
			stuck_frames = 0;
		}

		collided := stuck_frames >= 3;
		if collided || get_time() >= end_time {
			p->remove_disable_movement_input_reason(HITMAN_MINE_FLING_REASON);
			p->set_trigger("hitman_collide_midair_land");

			stun := entity->get_component(Hitman_Mine_Stun);
			if stun == null {
				stun = entity->add_component(Hitman_Mine_Stun);
			}
			stun->arm(HITMAN_MINE_STUN_SECONDS);

			active = false;
		}
	}
}

Hitman_Sniper_Camera_Zoom :: class : Component {
	active: bool;
	end_time: float;
	orig_size: float;

	arm :: proc(using this: Hitman_Sniper_Camera_Zoom, duration: float) {
		if duration <= 0.0 { duration = 0.1; }
		end_time = get_time() + duration;
		active = true;

		p := entity->get_component(Player);
		if p != null && p->is_local() {
			orig_size = p.camera.size;
			p.camera.size = HITMAN_SNIPER_CAMERA_ZOOMED_OUT_SIZE;
		}
	}

	ao_update :: proc(using this: Hitman_Sniper_Camera_Zoom, dt: float) {
		if !active return;
		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		if get_time() >= end_time {
			if p->is_local() {
				p.camera.size = orig_size;
			}
			active = false;
		}
	}
}

Hitman_Neck_Snap_Ability :: class : Ability_Base {
	NAME :: "Neck Snap";

	on_init :: proc(instance: Hitman_Neck_Snap_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/hitman/knee_snap.png");
	}

	get_closest_alive_target :: proc(instance: Hitman_Neck_Snap_Ability, player: Player) -> Player {
		finder := make_finder(Player, player.entity.world_position, HITMAN_NECK_SNAP_RANGE);
		for i: 0..players.elements.count-1 {
			target := players.elements[i];
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == player continue;
			if target.player_state != Player_State.ALIVE continue;

			// No friendly-fire on traitors.
			if player.player_type == Player_Type.TRAITOR && target.player_type == Player_Type.TRAITOR {
				continue;
			}

			finder->check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.HITMAN return false;
		return get_closest_alive_target(this, player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// Apply any contract-based cooldown adjustments (from kills via other methods).
		if player != null && player.player_role == Player_Role.HITMAN && player.hitman_kill_cooldown_adjust_seconds != 0.0 {
			current_cooldown = max(0.0, current_cooldown + player.hitman_kill_cooldown_adjust_seconds);
			player.hitman_kill_cooldown_adjust_seconds = 0.0;
		}

		if params.clicked && params.can_use {
			target := get_closest_alive_target(this, player);
			if target != null {
				// Lock movement so the animation completes before control returns.
				lock := player.entity->get_component(Hitman_Neck_Snap_Lock);
				if lock == null {
					lock = player.entity->add_component(Hitman_Neck_Snap_Lock);
				}
				lock->arm(HITMAN_NECK_SNAP_LOCK_SECONDS);

				player.hitman_last_kill_style = Hitman_Kill_Style.NECK_SNAP;
				player->set_facing_right(target.entity.world_position.x > player.entity.world_position.x);
				player->set_trigger("hitman_kill_snap_neck");
				target->kill_with_killer(player.entity.id);

				// Hitman strangle/neck-snap kill SFX (server-authoritative; replicates to clients).
				if Game.is_server() {
					sfx := SFX.default_sfx_desc();
					sfx->set_position(target.entity.world_position);
					sfx.volume = 0.9;
					sfx.volume_perturb = 0.08;
					sfx.speed_perturb = 0.06;
					// Global SFX mix: everything at 25% volume.
					sfx.volume *= 0.25;
					sfx.volume_perturb *= 0.25;
					rr_play_sfx("sfx/traitor_kill_death.wav", sfx);
				}

				current_cooldown = HITMAN_NECK_SNAP_COOLDOWN_SECONDS;
			}
		}
	}

	on_draw_button :: proc(instance: Hitman_Neck_Snap_Ability, rect: Rect) {
		draw_ability_name_label(rect, Hitman_Neck_Snap_Ability.NAME);
	}
}

Hitman_Mine_Ability :: class : Ability_Base {
	NAME :: "Mine";
	was_targeting: bool;

	on_init :: proc(instance: Hitman_Mine_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/hitman/land_mine.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.HITMAN return false;
		// Unlock after 1 kill.
		if player.hitman_kills < HITMAN_MINE_UNLOCK_KILLS return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			if player != null && player.player_role == Player_Role.HITMAN && player.hitman_kills < HITMAN_MINE_UNLOCK_KILLS {
				player->Notify(format_string("Mine locked: get %/% kills as Hitman to unlock.", .{
					min(player.hitman_kills, HITMAN_MINE_UNLOCK_KILLS),
					HITMAN_MINE_UNLOCK_KILLS
				}));
			}
		}

		// Click-to-target: enter targeting mode, then click to place at cursor.
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;

		// Prevent targeting mode while on cooldown / otherwise unusable.
		if targeting && !params.can_use {
			player.active_ability = null;
			was_targeting = false;
			return;
		}

		if !targeting {
			was_targeting = false;
			return;
		}

		was_targeting = true;

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel {
			player.active_ability = null;
			was_targeting = false;
			return;
		}

		target_pos := get_mouse_world_position();
		if player->is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			UI.quad(Rect{target_pos, target_pos}->grow(0.10, 0.10, 0.10, 0.10), core_globals.white_sprite, v4.{1, 0.4, 0.1, 0.9});
		}

		if aiming.activate && params.can_use {
			rr_hitman_place_mine(player, target_pos);
			current_cooldown = HITMAN_MINE_COOLDOWN_SECONDS;
			player.active_ability = null;
			was_targeting = false;
		}
	}

	on_draw_button :: proc(instance: Hitman_Mine_Ability, rect: Rect) {
		draw_ability_name_label(rect, Hitman_Mine_Ability.NAME);

		// Locked overlay (still show button for learnability).
		p := instance.player;
		if p != null && p.player_role == Player_Role.HITMAN && p.hitman_kills < HITMAN_MINE_UNLOCK_KILLS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			UI.text(rect->inset(2)->cut_top(20), ts, "LOCKED");
		}
	}
}

Hitman_Sniper_Ability :: class : Ability_Base {
	NAME :: "Sniper";

	camera_zoom_active: bool;
	camera_original_size: float;
	was_targeting: bool;
	activated_this_session: bool;

	on_init :: proc(instance: Hitman_Sniper_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/hitman/sniper_rifle.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.HITMAN return false;
		// Unlock after 2 kills.
		if player.hitman_kills < HITMAN_SNIPER_UNLOCK_KILLS return false;
		// Needs a valid contract target to snipe.
		if player.hitman_contract_target_id == 0 return false;
		return true;
	}

	set_camera_zoom :: proc(using this: Hitman_Sniper_Ability, active: bool) {
		// Only the local player has a camera, so guard with is_local_or_server (same as other camera tweaks).
		if !player->is_local_or_server() {
			return;
		}
		if active {
			if !camera_zoom_active {
				camera_original_size = player.camera.size;
				player.camera.size = HITMAN_SNIPER_CAMERA_ZOOMED_OUT_SIZE;
				camera_zoom_active = true;
			}
		} else {
			if camera_zoom_active {
				player.camera.size = camera_original_size;
				camera_zoom_active = false;
			}
		}
	}

	cleanup_targeting :: proc(using this: Hitman_Sniper_Ability) {
		this->set_camera_zoom(false);
		was_targeting = false;
		activated_this_session = false;
	}

	get_closest_alive_target_at_point :: proc(instance: Hitman_Sniper_Ability, shooter: Player, point: v2, range: float) -> Player {
		best: Player = null;
		best_dist_sq := 0.0;
		r_sq := range * range;

		for i: 0..players.elements.count-1 {
			p := players.elements[i];
			if p == null continue;
			if !#alive(p.entity) continue;
			if p == shooter continue;
			if p.player_state != Player_State.ALIVE continue;

			// Prevent traitor friendly-fire (consistent with Kill/Neck Snap).
			if shooter.player_type == Player_Type.TRAITOR && p.player_type == Player_Type.TRAITOR {
				continue;
			}

			d := p.entity.world_position - point;
			dist_sq := length_squared(d);
			if dist_sq > r_sq continue;

			if best == null || dist_sq < best_dist_sq {
				best = p;
				best_dist_sq = dist_sq;
			}
		}
		return best;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			if player != null && player.player_role == Player_Role.HITMAN && player.hitman_kills < HITMAN_SNIPER_UNLOCK_KILLS {
				player->Notify(format_string("Sniper locked: get %/% kills as Hitman to unlock.", .{
					min(player.hitman_kills, HITMAN_SNIPER_UNLOCK_KILLS),
					HITMAN_SNIPER_UNLOCK_KILLS
				}));
			}
		}

		// Click-to-target: click ability to enter aim mode, then click to fire (right-click to cancel).
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;

		// Prevent targeting mode while on cooldown / otherwise unusable.
		if targeting && !params.can_use {
			player.active_ability = null;
			this->cleanup_targeting();
			return;
		}

		// Handle targeting transitions.
		if targeting && !was_targeting {
			activated_this_session = false;
			was_targeting = true;
		}
		if !targeting {
			if was_targeting {
				this->cleanup_targeting();
			}
			return;
		}

		this->set_camera_zoom(true);

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel {
			player.active_ability = null;
			this->cleanup_targeting();
			return;
		}

		// Preview
		target_pos := get_mouse_world_position();
		draw_aiming_line(player.entity.world_position, aiming.aim_direction, 1.0 / player.camera.size * 6);
		if player->is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			UI.quad(Rect{target_pos, target_pos}->grow(0.12, 0.12, 0.12, 0.12), core_globals.white_sprite, v4.{1, 0.2, 0.2, 0.9});
		}

		if activated_this_session {
			return;
		}

		if aiming.activate && params.can_use {
			activated_this_session = true;

			// Pick target under cursor (global snipe).
			target := get_closest_alive_target_at_point(this, player, target_pos, 1.5);
			if target == null {
				// Stay in targeting mode if they missed.
				activated_this_session = false;
				return;
			}

			player.hitman_last_kill_style = Hitman_Kill_Style.SNIPER;
			player->set_facing_right(target.entity.world_position.x > player.entity.world_position.x);
			player->set_trigger("hitman_shoot_sniper");
			target->kill_with_killer(player.entity.id);
			current_cooldown = HITMAN_SNIPER_COOLDOWN_SECONDS;

			player.active_ability = null;
			this->cleanup_targeting();
		}
	}

	on_draw_button :: proc(instance: Hitman_Sniper_Ability, rect: Rect) {
		draw_ability_name_label(rect, Hitman_Sniper_Ability.NAME);

		// Locked overlay (still show button for learnability).
		p := instance.player;
		if p != null && p.player_role == Player_Role.HITMAN && p.hitman_kills < HITMAN_SNIPER_UNLOCK_KILLS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			UI.text(rect->inset(2)->cut_top(20), ts, "LOCKED");
		}
	}
}

Resurrect_Ability :: class : Ability_Base {
    NAME :: "Resurrect";

    on_init :: proc(instance: Resurrect_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/doctor/revive.png");
    }

    get_closest_resurrectable_corpse :: proc(instance: Resurrect_Ability, doctor: Player) -> Corpse {
        finder := make_finder(Corpse, doctor.entity.world_position, 5.0);
        foreach corpse: component_iterator(Corpse) {
            // Corpse must belong to a currently-dead player.
            target := get_player_by_entity_id(corpse.owner_player_entity_id);
            if target == null continue;
            if target.player_state != Player_State.DEAD continue;
            finder->check(corpse, corpse.entity.world_position);
        }
        return finder.closest;
    }

    can_use :: method() -> bool {
        if game_state != Game_State.INGAME return false;
        if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
        if player.player_type != Player_Type.CIVILIAN return false;
        if player.player_role != Player_Role.DOCTOR return false;
        if player.doctor_resurrects_used >= DOCTOR_RESURRECTS_PER_ROUND return false;
        return get_closest_resurrectable_corpse(this, player) != null;
    }

    on_update :: proc(instance: Resurrect_Ability, params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            corpse := instance->get_closest_resurrectable_corpse(instance.player);
            if corpse == null return;

            target := get_player_by_entity_id(corpse.owner_player_entity_id);
            if target == null return;
            if target.player_state != Player_State.DEAD return;

            revive_pos := corpse.entity.world_position;

            // Consume a use.
           instance.player.doctor_resurrects_used += 1;

            // Remove the body (they "stand up").
            if #alive(corpse.entity) {
                corpse.entity->destroy();
            }

            // Revive at the corpse position.
            target.entity->set_local_position(revive_pos);
            on_player_go_alive(target);

            target.is_temporarily_resurrected = true;
            target.temporarily_resurrected_until = get_time() + DOCTOR_RESURRECT_DURATION_SECONDS;

            // Feedback
            instance.player->Notify(format_string("Resurrected % for %s (%/% used)", .{
                target.entity->get_name(),
                format_float(DOCTOR_RESURRECT_DURATION_SECONDS, decimals=0),
                instance.player.doctor_resurrects_used,
                DOCTOR_RESURRECTS_PER_ROUND
            }));
            target->Notify(format_string("You were resurrected for %s (no tasks).", .{format_float(DOCTOR_RESURRECT_DURATION_SECONDS, decimals=0)}));

            // Small cooldown to prevent double-click spamming; uses-per-round is the main limiter.
            instance.current_cooldown = 1.0;
        }
    }

    on_draw_button :: proc(instance: Resurrect_Ability, rect: Rect) {
        player := instance.player;
        if player == null return;
        if player.player_role != Player_Role.DOCTOR return;

		draw_ability_name_label(rect, Resurrect_Ability.NAME);

        ts := UI.default_text_settings();
        ts.size = 18;
        ts.halign = .CENTER;
        ts.valign = .TOP;
        remaining := DOCTOR_RESURRECTS_PER_ROUND - player.doctor_resurrects_used;
        if remaining < 0 { remaining = 0; }
        UI.text(rect->inset(2)->cut_top(20), ts, format_string("%/%", .{remaining, DOCTOR_RESURRECTS_PER_ROUND}));
    }
}

// --- Coroner ---
CORONER_DNA_SAMPLE_RANGE :: 5.0;
CORONER_DNA_MATCH_RANGE  :: 5.0;
CORONER_DNA_MATCH_VIAL_DISPLAY_SECONDS :: 2.0;

Coroner_DNA_Vial_Display :: class : Component {
	active: bool;
	start_time: float;
	end_time: float;
	color: v4;

	vial_tex: Texture_Asset;
	glow_tex: Texture_Asset;

	arm :: proc(using this: Coroner_DNA_Vial_Display, glow_color: v4) {
		active = true;
		color = glow_color;
		start_time = get_time();
		end_time = start_time + CORONER_DNA_MATCH_VIAL_DISPLAY_SECONDS;

		// Lazy-load textures
		if vial_tex == null {
			vial_tex = get_asset(Texture_Asset, "sprites/icons/coroner/dna_vial.png");
		}
		if glow_tex == null {
			glow_tex = get_asset(Texture_Asset, "sprites/icons/coroner/dna_glow.png");
		}
	}

	ao_late_update :: proc(using this: Coroner_DNA_Vial_Display, dt: float) {
		if !active {
			return;
		}

		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Cosmetic only: only show to the coroner's local client.
		if !p->is_local() {
			return;
		}

		// Safety: don't render outside gameplay / while dead.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			active = false;
			return;
		}

		now := get_time();
		if now >= end_time {
			active = false;
			return;
		}

		t01 := clamp((now - start_time) / 0.35, 0.0, 1.0);
		t := Ease.out_back(t01);

		base := entity.world_position;
		// "Moves above the coroner's head"
		y_off := lerp(0.6, 1.55, t);
		pos := base + v2.{0, y_off};

		UI.push_world_draw_context();
		defer UI.pop_draw_context();
		UI.push_z(pos.y);
		defer UI.pop_z();

		// World-space sizing (meters)
		size := 0.22;
		rect := Rect{pos, pos}->grow(size, size, size, size);

		// Vial first
		UI.quad(rect->fit_aspect(vial_tex->get_aspect()), vial_tex, v4.{1, 1, 1, 1});

		// Glow on top of the vial
		glow_alpha := clamp(1.0 - ((now - start_time) / CORONER_DNA_MATCH_VIAL_DISPLAY_SECONDS) * 0.1, 0.0, 1.0);
		glow_col := color;
		glow_col.w = glow_col.w * glow_alpha;
		UI.quad(rect->grow(0.10)->fit_aspect(glow_tex->get_aspect()), glow_tex, glow_col);
	}
}

DNA_Sample_Ability :: class : Ability_Base {
	NAME :: "DNA Sample";

	on_init :: proc(instance: DNA_Sample_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/coroner/ability_take_dna.png");
	}

	get_closest_sampleable_corpse :: proc(instance: DNA_Sample_Ability, coroner: Player) -> Corpse {
		finder := make_finder(Corpse, coroner.entity.world_position, CORONER_DNA_SAMPLE_RANGE);
		foreach corpse: component_iterator(Corpse) {
			if corpse.has_been_reported continue;
			if corpse.has_dna_been_sampled continue;
			// Only corpses with known player killers yield a vial.
			if corpse.killer_player_entity_id == 0 continue;
			finder->check(corpse, corpse.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.CIVILIAN return false;
		if player.player_role != Player_Role.CORONER return false;
		return get_closest_sampleable_corpse(this, player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			corpse := get_closest_sampleable_corpse(this, player);
			if corpse == null return;

			corpse.has_dna_been_sampled = true;
			player.coroner_dna_vials->append(corpse.killer_player_entity_id);

			current_cooldown = 1.0;
		}
	}

	on_draw_button :: proc(instance: DNA_Sample_Ability, rect: Rect) {
		draw_ability_name_label(rect, DNA_Sample_Ability.NAME);
	}
}

DNA_Match_Ability :: class : Ability_Base {
	NAME :: "DNA Match";

	on_init :: proc(instance: DNA_Match_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/coroner/ability_compare_dna.png");
	}

	get_closest_alive_other_player :: proc(instance: DNA_Match_Ability, coroner: Player) -> Player {
		finder := make_finder(Player, coroner.entity.world_position, CORONER_DNA_MATCH_RANGE);
		for i: 0..players.elements.count-1 {
			target := players.elements[i];
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == coroner continue;
			if target.player_state != Player_State.ALIVE continue;
			finder->check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.CIVILIAN return false;
		if player.player_role != Player_Role.CORONER return false;
		if player.coroner_dna_vials.count <= 0 return false;
		return get_closest_alive_other_player(this, player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			target := get_closest_alive_other_player(this, player);
			if target == null return;

			killer_id := player.coroner_dna_vials->pop();
			is_match := target.entity.id == killer_id;

			// Show vial feedback above the coroner's head.
			display := player.entity->get_component(Coroner_DNA_Vial_Display);
			if display == null {
				display = player.entity->add_component(Coroner_DNA_Vial_Display);
			}

			if is_match {
				display->arm(v4.{0.2, 1.0, 0.4, 0.95}); // green
				player->Notify(format_string("DNA MATCH: %", .{target.entity->get_name()}));
			} else {
				display->arm(v4.{1.0, 0.2, 0.2, 0.95}); // red
				player->Notify("No match.");
			}

			current_cooldown = 1.0;
		}
	}

	on_draw_button :: proc(instance: DNA_Match_Ability, rect: Rect) {
		draw_ability_name_label(rect, DNA_Match_Ability.NAME);
	}
}

Vote_Ability :: class : Ability_Base {
    NAME :: "Vote";
    voting_ui_open: bool;
    show_recent_deaths: bool;
    last_voting_start_time_seen: float;
	last_vote_result_time_seen: float;
	recent_deaths_open_time: float;

    on_init :: proc(instance: Vote_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/report_ability.png");
        instance.voting_ui_open = false;
        instance.show_recent_deaths = false;
        instance.last_voting_start_time_seen = 0.0;
		instance.last_vote_result_time_seen = 0.0;
		instance.recent_deaths_open_time = 0.0;
    }

    can_use :: method() -> bool {
        return game_state == Game_State.VOTING && player.player_state == Player_State.ALIVE;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        // Leave voting: close any meeting UI state.
        if game_state != Game_State.VOTING {
            voting_ui_open = false;
            show_recent_deaths = false;
            last_voting_start_time_seen = 0.0;
			last_vote_result_time_seen = 0.0;
			recent_deaths_open_time = 0.0;
            return;
        }

        // Auto-open vote UI when entering voting (once per voting session).
        if voting_start_time > 0.0 && voting_start_time != last_voting_start_time_seen {
            last_voting_start_time_seen = voting_start_time;
            voting_ui_open = true;
            show_recent_deaths = true;
			recent_deaths_open_time = get_time();
        }

		// Voting has ended, but we keep the game in VOTING briefly to reveal the result.
		// If the vote UI is closed, the existing Notifier popups handle the message.
		if rr_vote_results_active {
			// One-shot result SFX per voting session (client-side).
			if player != null && player->is_local() && rr_last_vote_result_time > 0.0 && rr_last_vote_result_time != last_vote_result_time_seen {
				last_vote_result_time_seen = rr_last_vote_result_time;
			}
			if voting_ui_open && player->is_local_or_server() {
				draw_vote_result_ui(this, player);
			}
			return;
		}

        // Only allow closing after the player has voted or skipped.
        if params.clicked && params.can_use && player.has_voted {
            voting_ui_open = !voting_ui_open;
        }

        if voting_ui_open && player->is_local_or_server() {
            if show_recent_deaths {
				// Auto-advance after a short recap.
				if recent_deaths_open_time > 0.0 && (get_time() - recent_deaths_open_time) >= 5.0 {
					show_recent_deaths = false;
				}
                draw_recent_deaths_ui(this, player);
            } else {
                draw_voting_ui(this, player);
            }
        }
    }

	draw_vote_result_ui :: proc(instance: Vote_Ability, local_player: Player) {
		screen := UI.get_safe_screen_rect();
		white := get_asset(Texture_Asset, "$AO/white.png");

		// Match voting screen layer (above all gameplay UI).
		UI.push_layer(20000);
		defer UI.pop_layer();

		UI.quad(screen, white, v4.{0, 0, 0, 0.82});

		panel_rect := screen->center_rect()->grow(470, 860, 470, 860);
		rr_ui_draw_modal_panel(panel_rect);

		content := panel_rect->inset(26);
		header := content->cut_top(80);
		footer := content->cut_bottom(80);
		body := content;

		title_ts := UI.default_text_settings();
		title_ts.size = 44;
		title_ts.color = v4.{0.95, 0.97, 1.0, 1};
		title_ts.halign = .CENTER;
		title_ts.valign = .CENTER;
		title_ts.do_outline = true;
		title_ts.outline_thickness = 3;
		title_ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(header, title_ts, "VOTE RESULT");

		message := "No one was ejected.";
		if rr_last_vote_ejected_player_id != 0 {
			p := get_player_by_entity_id(rr_last_vote_ejected_player_id);
			name := "Someone";
			if p != null {
				name = p.entity->get_name();
			}
			message = format_string("% has been ejected!", .{name});
		}

		msg_ts := UI.default_text_settings();
		msg_ts.size = 34;
		msg_ts.color = v4.{1, 1, 1, 1};
		msg_ts.halign = .CENTER;
		msg_ts.valign = .CENTER;
		msg_ts.word_wrap = true;
		msg_ts.do_outline = true;
		msg_ts.outline_thickness = 2;
		msg_ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(body, msg_ts, message);

		// Optional close button (dismisses the UI while waiting for the results window to end).
		close_rect := footer->center_rect()->grow(26, 210, 26, 210);
		close_icon := get_asset(Texture_Asset, "sprites/icons/close_icon.png");
		btn_bs: Button_Settings = .{};
		rr_ui_apply_button_click_sound(ref btn_bs);
		interact := UI.button(close_rect, btn_bs, .{}, ""); // no background; icon is the button
		if close_icon != null {
			icon_rect := close_rect->inset(6);
			UI.quad(icon_rect->fit_aspect(close_icon->get_aspect()), close_icon, v4.{1, 1, 1, 1});
		} else {
			ts := UI.default_text_settings();
			ts.size = 24;
			ts.halign = .CENTER;
			ts.valign = .CENTER;
			UI.text(close_rect, ts, "CLOSE");
		}
		if interact.clicked {
			instance.voting_ui_open = false;
		}
	}

    draw_recent_deaths_ui :: proc(instance: Vote_Ability, local_player: Player) {
        screen := UI.get_safe_screen_rect();

        white := get_asset(Texture_Asset, "$AO/white.png");
		// Match voting screen layer (above all gameplay UI).
		UI.push_layer(20000);
		defer UI.pop_layer();
		// Slide-in animation (left -> center)
		now := get_time();
		t := 1.0;
		if instance.recent_deaths_open_time > 0.0 {
			elapsed := now - instance.recent_deaths_open_time;
			t = clamp(elapsed / 0.35, 0.0, 1.0);
		}
		x_off := lerp(-520.0, 0.0, t);
		overlay_alpha := lerp(0.0, 0.82, t);

        UI.quad(screen, white, v4.{0, 0, 0, overlay_alpha});

        panel_rect := screen->center_rect()->grow(470, 860, 470, 860)->offset(x_off, 0);
        rr_ui_draw_modal_panel(panel_rect);

        content := panel_rect->inset(24);
        header := content->cut_top(70);
        footer := content->cut_bottom(72);

        title_ts := UI.default_text_settings();
        title_ts.size = 44;
        title_ts.color = v4.{0.95, 0.97, 1.0, 1};
        title_ts.halign = .CENTER;
        title_ts.valign = .CENTER;
        title_ts.do_outline = true;
        title_ts.outline_thickness = 3;
        title_ts.outline_color = v4.{0, 0, 0, 1};
        UI.text(header, title_ts, "RECENT DEATHS");

        // Scrollable list of deaths since last meeting.
        scroll_area := content;
        scroll_bar_area := scroll_area->cut_right(10)->inset(2);

        svs: Scroll_View_Settings;
        svs.vertical = true;
        svs.horizontal = false;
        svs.clip_padding = v4.{10, 10, 10, 10};

        sv := UI.push_scroll_view(scroll_area, "recent_deaths", svs); {
            defer UI.pop_scroll_view();

            list_rect := sv.content_rect;
            row_ts := UI.default_text_settings();
            row_ts.size = 34;
            row_ts.color = v4.{0.9, 0.92, 0.98, 1};
            row_ts.halign = .LEFT;
            row_ts.valign = .CENTER;
            row_ts.do_drop_shadow = true;
            row_ts.drop_shadow_offset = v2.{1, -1};
            row_ts.drop_shadow_color = v4.{0, 0, 0, 1};

            if deaths_since_last_meeting.elements.count <= 0 {
                none_rect := list_rect->cut_top(64);
                row_ts.halign = .CENTER;
                UI.text(none_rect, row_ts, "None");
            } else {
                for i: 0..deaths_since_last_meeting.elements.count-1 {
                    id := deaths_since_last_meeting.elements[i];
                    p := get_player_by_entity_id(id);
                    name := "Unknown";
                    if p != null {
                        name = p.entity->get_name();
                    }

                    row := list_rect->cut_top(64);
                    UI.quad(row->inset(2), white, v4.{0.08, 0.1, 0.14, 0.65});
                    UI.text(row->inset(14, 14, 14, 14), row_ts, name);

                    list_rect->cut_top(8);
                }
            }
        }

        // Manual scroll bar
        scroll_bar_rect := sv->compute_scroll_bar_rect(scroll_bar_area);
        UI.quad(scroll_bar_area, white, v4.{0.025, 0.025, 0.025, 1});
        UI.quad(scroll_bar_rect, white, v4.{0.12, 0.12, 0.12, 1});

        // Continue button
        btn_rect := footer->center_rect()->grow(18, 170, 18, 170);
        bs := UI.default_button_settings();
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png"); // green
        bs.press_scaling = 0.96;
        rr_ui_apply_button_click_sound(ref bs);
        ts := UI.default_text_settings();
        ts.size = 30;
        ts.color = v4.{1, 1, 1, 1};
        ts.halign = .CENTER;
        ts.valign = .CENTER;

        if UI.button(btn_rect, bs, ts, "CONTINUE").clicked {
            instance.show_recent_deaths = false;
        }
    }

    draw_voting_ui :: proc(instance: Vote_Ability, local_player: Player) {

        screen := UI.get_safe_screen_rect();
		// Note: `UI.spine` is affected by the UI scale factor. Our tile layout math uses rect
		// pixel sizes (from `rect->width()/height()`), so convert any pixel-derived scale values
		// back into "1080p units" by dividing by the current UI scale factor.
		ui_scale := UI.get_current_scale_factor();
		if ui_scale <= 0.001 { ui_scale = 1.0; }

        // Render above everything (popups are 10000).
        UI.push_layer(20000);
        defer UI.pop_layer();

        // --- Style / assets (prefer $AO/ui/kit; fall back safely if missing) ---
        white := get_asset(Texture_Asset, "$AO/white.png");

        // Use kit modal textures and draw them with nine-slice so borders/corners don't stretch.
        // Use transp_black1 as base for tinting (it has nice rounded corners and no color override).
        kit_panel := get_asset(Texture_Asset, "ui/voting/modal_backing.png");
        if kit_panel == null { kit_panel = get_asset(Texture_Asset, "$AO/ui/kit/Modals/modal_windows/modal_simple_black1.png"); }
        if kit_panel == null { kit_panel = white; }

        // Voting UI specific textures (project assets in /res/ui/voting)
        vote_dead_icon := get_asset(Texture_Asset, "ui/voting/dead_crew_icon.png"); // skull
        vote_tile_backing := get_asset(Texture_Asset, "ui/voting/player_backing.png"); // stays white
        vote_tile_top := get_asset(Texture_Asset, "ui/voting/player_backing_top.png"); // tinted by player color
        vote_tile_selected := get_asset(Texture_Asset, "ui/voting/player_backing_selected.png");
        vote_schleem_shadow := get_asset(Texture_Asset, "ui/voting/schleem_shadow.png");
        vote_skip_button := get_asset(Texture_Asset, "ui/voting/skip_vote_button.png");

        // Icons: match the mock better (kit tick/plus), use voting weapon icon.
        check_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/green_tick_outline.png");
        if check_icon == null { check_icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/white_tick.png"); }
        if check_icon == null { check_icon = get_asset(Texture_Asset, "sprites/icons/vote_select_icon.png"); }
        vote_weapon_icon := get_asset(Texture_Asset, "ui/voting/shoot_weapon_icon.png");
        gun_icon := vote_weapon_icon; // used as "your vote" mark
        if gun_icon == null { gun_icon = get_asset(Texture_Asset, "sprites/icons/revolver.png"); }
        plus_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/plus_button2.png");
        if plus_icon == null { plus_icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/plus_button.png"); }
        call_meeting_icon := get_asset(Texture_Asset, "sprites/icons/call_meeting_icon.png");
        timer_texture := get_asset(Texture_Asset, "ui/voting/timer.png");
        // Dead should use the skull icon.
        dead_icon := vote_dead_icon;
        if dead_icon == null { dead_icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/red_cross.png"); }
        if dead_icon == null { dead_icon = get_asset(Texture_Asset, "sprites/icons/kill_ability.png"); }

        // The mock has a translucent modal over gameplay (not fully opaque).
        c_overlay := v4.{0, 0, 0, 0.55};
        // No color override, no alpha (as requested).
        c_panel_tint := v4.{1, 1, 1, 1};
        if kit_panel == white { c_panel_tint = v4.{0.05, 0.06, 0.08, 0.92}; }

        c_text := v4.{0.95, 0.97, 1.0, 1};
        c_muted := v4.{0.80, 0.84, 0.92, 1};
        c_good := v4.{0.25, 0.90, 0.45, 1};
        c_bad := v4.{1.0, 0.25, 0.25, 1};

        // Background overlay
        UI.quad(screen, white, c_overlay);

        // Main panel (9-sliced)
        panel_rect := screen->center_rect()->grow(470, 860, 470, 860);
        {
            // Draw non-interactive 9-slice panel using the button renderer.
            bs_panel := UI.default_button_settings();
            bs_panel.sprite = kit_panel;
            bs_panel.press_scaling = 1.0;
            rr_ui_apply_button_click_sound(ref bs_panel);
            bs_panel.color = c_panel_tint;
            bs_panel.hovered_color = c_panel_tint;
            bs_panel.pressed_color = c_panel_tint;
            bs_panel.disabled_color = c_panel_tint;
            bs_panel.background_color_multiplier = v4.{1, 1, 1, 1};

            // Approximate kit modal border thickness. (If you want tighter/looser corners, tweak this.)
            NINE_SLICE_PX :: 96.0;
            bs_panel.nine_slice_data.slice = v4.{NINE_SLICE_PX, NINE_SLICE_PX, NINE_SLICE_PX, NINE_SLICE_PX};
            bs_panel.nine_slice_data.slice_scale = 1.0;

            UI.push_disabled(true);
            defer UI.pop_disabled();
            UI.begin_button(panel_rect, bs_panel, {}, ""); { defer UI.end_button(); }
        }

        content := panel_rect->inset(26);
        header := content->cut_top(120);
        footer := content->cut_bottom(120);
        grid := content;

        // --- Timer (top-right) ---
        current_time := get_time();
        elapsed := current_time - voting_start_time;
        remaining := 60.0 - elapsed;
        if remaining < 0.0 { remaining = 0.0; }
        pct := remaining / 60.0;
        if pct < 0.0 { pct = 0.0; }
        if pct > 1.0 { pct = 1.0; }

        title_row := header->cut_top(64);
        title_full := title_row;
        // Use unscaled cuts when using computed widths (avoid scale-factor mismatch).
        called_by_w := min(320.0, title_row->width() * 0.33);
        called_by_area := title_row->cut_left_unscaled(called_by_w)->inset(6, 6, 6, 6);
        timer_w := min(310.0, title_row->width() * 0.33);
        timer_area := title_row->cut_right_unscaled(timer_w);
        title_rect := title_full;

        title_ts := UI.default_text_settings();
        title_ts.size = 58;
        title_ts.color = c_text;
        title_ts.halign = .CENTER;
        title_ts.valign = .CENTER;
        title_ts.do_outline = true;
        title_ts.outline_thickness = 4;
        title_ts.outline_color = v4.{0, 0, 0, 1};
        UI.text(title_rect, title_ts, "Voting Screen");

        // Timer box + bar (rounded corners, no grow() so it can't exceed header bounds)
        timer_box := timer_area->inset(12, 18, 12, 18);
        timer_panel_color := v4.{0.14, 0.26, 0.55, 0.92}; // blue background
        UI.quad(timer_box, white, timer_panel_color);

        // Number
        t_color := c_text;
        if remaining <= 10.0 {
            t_color = v4.{1.0, 0.35, 0.35, 1.0};
        } else if remaining <= 30.0 {
            t_color = v4.{1.0, 0.85, 0.25, 1.0};
        }
        // Overlapping timer badge (half overlap to the left)
        badge_size := timer_box->height() * 2;
        badge_rect := timer_box->left_center_rect()->grow_unscaled(badge_size * 0.5, badge_size * 0.5, badge_size * 0.5, badge_size * 0.5);
        badge_rect = badge_rect->offset_unscaled(-badge_size * 0.3, 0.2);
        if timer_texture != null {
            badge_draw := badge_rect->fit_aspect(timer_texture->get_aspect());
            UI.quad(badge_draw, timer_texture, v4.{1, 1, 1, 1});
        } else {
            UI.quad(badge_rect, white, v4.{0.12, 0.16, 0.25, 1});
        }

        num_rect := badge_rect->inset(12);
        num_ts := UI.default_text_settings();
        num_ts.size = 42;
        num_ts.color = t_color;
        num_ts.halign = .CENTER;
        num_ts.valign = .CENTER;
        num_ts.do_outline = true;
        num_ts.outline_thickness = 3;
        num_ts.outline_color = v4.{0, 0, 0, 1};

        // Bar (line timer)
        bar_rect := timer_box->inset(12, 16, 12, 16)->cut_bottom_unscaled(8);
        UI.quad(bar_rect, white, v4.{0.20, 0.45, 0.85, 0.95});
        fill := bar_rect->inset(2)->subrect(0, 0, pct, 1);
        UI.quad(fill, white, v4.{0.95, 0.20, 0.20, 1});

        // Draw text after bar so it renders on top
        UI.text(num_rect, num_ts, format_string("%", .{format_float(remaining, decimals=0)}));

        // --- Called by (top-left, icon + label + name) ---
        icon_rect := called_by_area->cut_left_unscaled(64);
        label_rect := called_by_area->cut_top_unscaled(24);
        name_rect := called_by_area;

        label_ts := UI.default_text_settings();
        label_ts.size = 22;
        label_ts.color = c_muted;
        label_ts.halign = .LEFT;
        label_ts.valign = .CENTER;
        label_ts.do_drop_shadow = true;
        label_ts.drop_shadow_offset = v2.{1, -1};
        label_ts.drop_shadow_color = v4.{0, 0, 0, 1};

        name_ts := UI.default_text_settings();
        name_ts.size = 36;
        name_ts.color = c_text;
        name_ts.halign = .LEFT;
        name_ts.valign = .CENTER;
        name_ts.do_outline = true;
        name_ts.outline_thickness = 3;
        name_ts.outline_color = v4.{0, 0, 0, 1};

        initiator_str := "";
        caller_name := "";
        if meeting_initiator_id != 0 {
            caller := get_player_by_entity_id(meeting_initiator_id);
            caller_name = "Unknown";
            if caller != null { caller_name = caller.entity->get_name(); }
            initiator_str = "Called by:";
        }
        if initiator_str.count > 0 {
            if call_meeting_icon != null {
                icon_draw := icon_rect->fit_aspect(call_meeting_icon->get_aspect());
                icon_draw = icon_draw->scale(-1.0, 1.0);
                UI.quad(icon_draw, call_meeting_icon, v4.{1, 1, 1, 1});
            }
            UI.text(label_rect, label_ts, initiator_str);
            UI.text(name_rect, name_ts, caller_name);
        }

        // --- Grid of players (alive + dead) ---
        // We keep a fixed 4x3 grid like the reference so tiles never stretch.
        total_players := players.elements.count;
        if total_players <= 0 {
            empty_ts := UI.default_text_settings();
            empty_ts.size = 44;
            empty_ts.color = c_text;
            empty_ts.halign = .CENTER;
            empty_ts.valign = .CENTER;
            empty_ts.do_outline = true;
            empty_ts.outline_thickness = 3;
            empty_ts.outline_color = v4.{0, 0, 0, 1};
            UI.text(grid, empty_ts, "No players");
        } else {
            cols :: 4;
            rows :: 3;
            // Match tile aspect (never stretch).
            tile_aspect := 3.15;
            if vote_tile_backing != null {
                tile_aspect = vote_tile_backing->get_aspect();
            }

            spacing := 16.0;
            gw := grid->width();
            gh := grid->height();

            max_w_per := (gw - spacing * (cols - 1).(float)) / cols.(float);
            max_h_per := (gh - spacing * (rows - 1).(float)) / rows.(float);

            card_h := min(max_h_per, max_w_per / tile_aspect);
            if card_h < 1.0 { card_h = 1.0; }
            card_w := card_h * tile_aspect;

            total_w := card_w * cols.(float) + spacing * (cols - 1).(float);
            start_x := grid.min.x + (gw - total_w) * 0.5;
            start_y_top := grid.max.y; // top aligned like the reference

            // Card text style
            name_ts := UI.default_text_settings();
            name_ts.size = 52; // Bigger text
            name_ts.color = v4.{1, 1, 1, 1};
            name_ts.halign = .CENTER;
            name_ts.valign = .CENTER;
            name_ts.do_outline = true;
            name_ts.outline_thickness = 5; // Thicker outline
            name_ts.outline_color = v4.{0, 0, 0, 1};

            // Card button settings (use voting tile art; always keep aspect)
            card_bs := UI.default_button_settings();
            card_bs.press_scaling = 0.98;
            card_bs.sprite_fit_aspect = true;

            // Helpers for matching the mock's player-tinted tiles.
            get_vote_tile_bg :: proc(color: Color_Replace_Color) -> v4 {
                switch color {
                    // More saturated/darker pastels to contrast with white bottom strip
                    case .RED:        return v4.{1.00, 0.70, 0.70, 1.0};
                    case .RED2:       return v4.{1.00, 0.70, 0.70, 1.0};
                    case .CYAN:       return v4.{0.60, 0.85, 1.00, 1.0};
                    case .GREEN:      return v4.{0.60, 1.00, 0.70, 1.0};
                    case .GREEN3:     return v4.{0.60, 1.00, 0.70, 1.0};
                    case .LIGHT_GREEN:return v4.{0.60, 1.00, 0.70, 1.0};
                    case .BLUE2:      return v4.{0.60, 0.80, 1.00, 1.0};
                    case .PINK:       return v4.{1.00, 0.70, 0.90, 1.0};
                    case .PURPLE:     return v4.{0.85, 0.70, 1.00, 1.0};
                    case .PURPLE2:    return v4.{0.85, 0.70, 1.00, 1.0};
                    case .PURPLE3:    return v4.{0.85, 0.70, 1.00, 1.0};
                    case .YELLOW:     return v4.{1.00, 0.92, 0.60, 1.0};
                    case .ORANGE:     return v4.{1.00, 0.85, 0.60, 1.0};
                    case .ORANGE2:    return v4.{1.00, 0.85, 0.60, 1.0};
                    // Black/Gray/White -> Red (per user request)
                    case .LIGHT_GRAY: return v4.{1.00, 0.70, 0.70, 1.0};
                    case .WHITE1:     return v4.{1.00, 0.70, 0.70, 1.0};
                    case .BLACK:      return v4.{1.00, 0.70, 0.70, 1.0};
                    case .BLACK2:     return v4.{1.00, 0.70, 0.70, 1.0};
                    
                    case .BROWN1:     return v4.{0.85, 0.75, 0.65, 1.0};
                }
                return v4.{0.90, 0.90, 0.90, 1.0};
            }

            get_vote_tile_name :: proc(color: Color_Replace_Color) -> v4 {
                switch color {
                    case .RED:        return v4.{1.00, 0.25, 0.25, 1.0};
                    case .RED2:       return v4.{1.00, 0.25, 0.25, 1.0};
                    case .CYAN:       return v4.{0.10, 0.65, 1.00, 1.0};
                    case .GREEN:      return v4.{0.20, 0.90, 0.35, 1.0};
                    case .GREEN3:     return v4.{0.20, 0.90, 0.35, 1.0};
                    case .LIGHT_GREEN:return v4.{0.20, 0.90, 0.35, 1.0};
                    case .BLUE2:      return v4.{0.25, 0.55, 1.00, 1.0};
                    case .PINK:       return v4.{1.00, 0.20, 0.70, 1.0};
                    case .PURPLE:     return v4.{0.75, 0.30, 1.00, 1.0};
                    case .PURPLE2:    return v4.{0.75, 0.30, 1.00, 1.0};
                    case .PURPLE3:    return v4.{0.75, 0.30, 1.00, 1.0};
                    case .YELLOW:     return v4.{0.25, 0.90, 0.35, 1.0}; // reference uses green-ish name on yellow tiles
                    case .ORANGE:     return v4.{1.00, 0.55, 0.15, 1.0};
                    case .ORANGE2:    return v4.{1.00, 0.55, 0.15, 1.0};
                    // Black/Gray/White -> Red text
                    case .LIGHT_GRAY: return v4.{1.00, 0.25, 0.25, 1.0};
                    case .WHITE1:     return v4.{1.00, 0.25, 0.25, 1.0};
                    case .BLACK:      return v4.{1.00, 0.25, 0.25, 1.0};
                    case .BLACK2:     return v4.{1.00, 0.25, 0.25, 1.0};
                    
                    case .BROWN1:     return v4.{0.25, 0.25, 0.25, 1.0};
                }
                return v4.{0.25, 0.25, 0.25, 1.0};
            }

            max_cells := cols * rows;
            for i: 0..min(total_players, max_cells)-1 {
                p := players.elements[i];
                if p == null continue;

                // Compute card rect for index i (row-major, top to bottom).
                col := i % cols;
                row := i / cols;

                x0 := start_x + col.(float) * (card_w + spacing);
                y_top := start_y_top - row.(float) * (card_h + spacing);
                y0 := y_top - card_h;
                card_rect := Rect.{v2.{x0, y0}, v2.{x0 + card_w, y0 + card_h}};

                is_dead := p.player_state != Player_State.ALIVE;
                is_selected := (local_player.voted_for == p);
                can_vote_for := !local_player.has_voted && !is_dead && p != local_player;

                UI.push_id("vote_card_%", .{p.entity.id});
                defer UI.pop_id();

                clicked := false;
                draw_rect := card_rect;

                // Invisible button for interaction (we draw the tile art ourselves so we can top-anchor
                // `player_backing_top.png` and keep the bottom area white).
                if can_vote_for {
                    hit_bs := UI.default_button_settings();
                    hit_bs.sprite = white;
                    hit_bs.press_scaling = 1.0;
                    rr_ui_apply_button_click_sound(ref hit_bs);
                    hit_bs.color = v4.{1, 1, 1, 0.0};
                    hit_bs.hovered_color = hit_bs.color;
                    hit_bs.pressed_color = hit_bs.color;
                    hit_bs.disabled_color = hit_bs.color;

                    btn := UI.begin_button(card_rect, hit_bs, {}, ""); {
                        defer UI.end_button();
                        clicked = btn.clicked;
                        draw_rect = btn.rect;
                    }
                } else {
                    draw_rect = card_rect;
                }

                // Determine overlay color (dead is grey; selected uses its own sprite)
                top_color := v4.{1, 1, 1, 1};
                if is_dead {
                    top_color = v4.{0.1, 0.1, 0.1, 1.0};
                } else if !is_selected {
                    top_color = get_vote_tile_bg(p.avatar_color);
                }

                // Tile art
                if is_selected {
                    // Selected is a full sprite; draw it over the whole tile rect.
                    if vote_tile_selected != null {
                        UI.quad(draw_rect, vote_tile_selected, v4.{1, 1, 1, 1});
                    } else {
                        UI.quad(draw_rect, white, v4.{1, 0.20, 0.20, 1});
                    }
                } else {
                    // Backing stays white.
                    if is_dead {
                        UI.quad(draw_rect, vote_tile_backing, v4.{0.5, 0.5, 0.5, 1});
                    } else {
                        UI.quad(draw_rect, vote_tile_backing, v4.{1, 1, 1, 1});
                    }

                    // Top overlay should NOT reach the bottom area.
                    // Draw it in a top-anchored rect that fits its aspect and spans the tile width.
                    if vote_tile_top != null {
                        overlay_aspect := vote_tile_top->get_aspect();
                        overlay_w := draw_rect->width();
                        overlay_h := overlay_w / overlay_aspect;
                        if overlay_h > draw_rect->height() {
                            overlay_h = draw_rect->height();
                            overlay_w = overlay_h * overlay_aspect;
                        }
                        overlay_x0 := draw_rect.min.x + (draw_rect->width() - overlay_w) * 0.5;
                        overlay_y1 := draw_rect.max.y;
                        overlay_rect := Rect.{v2.{overlay_x0, overlay_y1 - overlay_h}, v2.{overlay_x0 + overlay_w, overlay_y1}};
                        UI.quad(overlay_rect, vote_tile_top, top_color);
                    }

                    // Dead: darken the bottom/whole tile a bit more so it reads as disabled.
                    if is_dead {
                        UI.quad(draw_rect, white, v4.{0, 0, 0, 0.26});
                    }
                }

                // Rig display area (left side) - allow overlap with bottom portion
                rig_area := draw_rect->subrect(0.15, 0.1, 0.26, 0.8);
                if p.animator != null && p.animator.instance != null {
                    // Match other UIs: push player material so cosmetics/replace colors render.
                    if is_dead {
                        // Grayed out spine for dead players
                        UI.push_color_multiplier(v4.{0.55, 0.55, 0.55, 0.95});
                    }
                    
                    UI.push_player_material(p);
                    defer UI.pop_material();
                    if is_dead {
                        defer UI.pop_color_multiplier();
                    }

                    // Shadow behind (slightly more left/down)
                    if is_selected || is_dead {
                        shadow_pos := rig_area->center() + v2.{-draw_rect->width() * 0.06, -draw_rect->height() * 0.01};
                        // rig_area->height() is pixels; convert to 1080p units for grow().
                        shadow_size := (rig_area->height() * 0.55) / ui_scale;
                        shadow_rect := Rect.{shadow_pos, shadow_pos}->grow(shadow_size);
                        UI.quad(shadow_rect->fit_aspect(vote_schleem_shadow->get_aspect()), vote_schleem_shadow, v4.{1, 1, 1, 1.0});
                    }

                    // Spine (bigger + lower, overlaps bottom area)
                    // Convert pixel-based size to 1080p units to avoid scaling up with resolution.
					// Use rig_area height (not full tile height) so the character doesn't dominate the card.
                    s := (rig_area->height() * 1.15) / ui_scale;
					// Clamp for safety across extreme aspect ratios / resolutions.
					s = clamp(s, 90.0, 165.0);
                    pos := rig_area->center() + v2.{-draw_rect->width() * 0.01, -draw_rect->height() * 0.30};
                    UI.spine(pos, p.animator.instance, v2.{s, s}, 0.0);
                }

                // Name (bottom area)
                name_area := draw_rect->subrect(0.20, 0.00, 1.00, 0.50)->inset(10, 10, 10, 10);
                if is_selected {
                    name_ts.color = v4.{1, 1, 1, 1};
                } else if is_dead {
                    name_ts.color = v4.{0.35, 0.35, 0.35, 1};
                } else {
                    name_ts.color = get_vote_tile_name(p.avatar_color);
                }
                UI.text(name_area, name_ts, p.entity->get_name());

                // "Has voted" checkmark (green, top-right)
                if check_icon != null && p.has_voted {
                    check_rect := draw_rect->top_right_rect()->offset(-24, -24)->grow(22);
                    UI.quad(check_rect->fit_aspect(check_icon->get_aspect()), check_icon, c_good);
                }

                // "You voted for this player" marker: gun
                if gun_icon != null && is_selected {
                    gun_rect := draw_rect->top_left_rect()->offset(150, -24)->grow(32);
                    UI.quad(gun_rect->fit_aspect(gun_icon->get_aspect()), gun_icon, v4.{1, 1, 1, 1});
                }

                // Dead overlay (skull)
                if is_dead {
                    if dead_icon != null {
                        dead_rect := draw_rect->center_rect()->offset(0, 0)->grow(42);
                        UI.quad(dead_rect->fit_aspect(dead_icon->get_aspect()), dead_icon, v4.{1, 1, 1, 1});
                    }
                }

                if clicked && can_vote_for {
                    cast_vote(local_player, p);
					// Local-only feedback sound on vote commit.
					if local_player != null && local_player->is_local() {
						sfx := SFX.default_sfx_desc();
						sfx->set_position(local_player.entity.world_position);
						sfx.volume = 0.85;
						sfx.volume_perturb = 0.1;
						sfx.speed_perturb = 0.05;
						// Global SFX mix: everything at 25% volume.
						sfx.volume *= 0.25;
						sfx.volume_perturb *= 0.25;
						rr_play_sfx("sfx/cast_vote.wav", sfx);
					}
                }
            }
        }

        // --- Footer: Skip Vote button (single large button like the mock) ---
        footer_inner := footer->inset(18)->cut_top_unscaled(20); // Raise up
        btn_rect := footer_inner->bottom_center_rect()->grow(36, 260, 36, 260);

        // Skip vote button (use voting art, keep aspect)
        skip_bs := UI.default_button_settings();
        skip_bs.sprite = vote_skip_button;
        if skip_bs.sprite == null {
            skip_bs.sprite = get_asset(Texture_Asset, "$AO/ui/kit/Modals/basic_buttons/button_large_arrow_green1.png");
        }
        skip_bs.press_scaling = 0.96;
        skip_bs.sprite_fit_aspect = true;
        rr_ui_apply_button_click_sound(ref skip_bs);
        // Darken slightly
        skip_bs.color_multiplier = v4.{0.9, 0.9, 0.9, 1.0};

        skip_ts := UI.default_text_settings();
        skip_ts.size = 44;
        skip_ts.color = v4.{1, 1, 1, 1};
        skip_ts.halign = .CENTER;
        skip_ts.valign = .CENTER;
        skip_ts.do_outline = true;
        skip_ts.outline_thickness = 3;
        skip_ts.outline_color = v4.{0, 0, 0, 1};

        // Disabled once you've voted or skipped (votes are locked).
        skip_disabled := local_player.has_voted;
        if skip_disabled {
            UI.push_disabled(true);
            UI.push_color_multiplier(v4.{1, 1, 1, 0.55});
        }

        // Ensure the rect matches the sprite aspect so it never squishes.
        if skip_bs.sprite != null {
            btn_rect = btn_rect->fit_aspect(skip_bs.sprite->get_aspect());
        }

        if UI.button(btn_rect, skip_bs, skip_ts, "Skip Vote").clicked {
            cast_skip_vote(local_player);
			// Local-only feedback sound on skip.
			if local_player != null && local_player->is_local() {
				sfx := SFX.default_sfx_desc();
				sfx->set_position(local_player.entity.world_position);
				sfx.volume = 0.85;
				sfx.volume_perturb = 0.1;
				sfx.speed_perturb = 0.05;
				// Global SFX mix: everything at 25% volume.
				sfx.volume *= 0.25;
				sfx.volume_perturb *= 0.25;
				rr_play_sfx("sfx/cast_vote.wav", sfx);
			}
        }

        if skip_disabled {
            UI.pop_color_multiplier();
            UI.pop_disabled();
        }
    }

	on_draw_button :: proc(instance: Vote_Ability, rect: Rect) {
		draw_ability_name_label(rect, Vote_Ability.NAME);
	}
}

shoot_projectile :: proc(spawn_position: v2, velocity: v2, damage: int, lifetime: float, owner: Entity) -> Entity {
    prefab := get_asset(Prefab_Asset, "prefabs/RR_Projectile.prefab");
    entity := Scene.instantiate(prefab);
    entity->set_local_position(spawn_position);

    projectile := entity->get_component(RR_Projectile);
    projectile.velocity = velocity;
    projectile.lifetime = lifetime;
    projectile.damage = damage;
    projectile.owner = owner;
    return entity;
}

Shoot_Ability :: class : Ability_Base {
    on_init :: proc(ability: Shoot_Ability) {
        ability.name = "Shoot";
        ability.disable_keybind = true;
        ability.is_aimed_ability = true;
    }

    can_use :: method() -> bool {
        if game_state != Game_State.INGAME return false;
        if player.player_state != Player_State.ALIVE return false;
        if player->has_task_in_progress() return false;
		// Sheriff only gets 1 shot.
		if player.player_type == Player_Type.CIVILIAN && player.player_role == Player_Role.SHERIFF {
			if player.sheriff_gun_ammo <= 0 return false;
		}
        return true;
    }

    get_icon :: proc(ability: Shoot_Ability, player_role: Player_Role) -> Texture_Asset {
        if player_role == Player_Role.PIRATE {
            return get_asset(Texture_Asset, "sprites/icons/pirate/flintlock_pistol.png");
        } else {
            return get_asset(Texture_Asset, "sprites/icons/revolver.png");
        }
        return null;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        activation := Ability_Utilities.full_update_aimed_ability(player, ref params);
        icon = get_icon(this, player.player_role);
        if params.can_use {
            if activation.activate {
                sfx := SFX.default_sfx_desc();
                sfx->set_position(player.entity.local_position);
                sfx.volume_perturb = 0.2;
                sfx.speed_perturb = 0.1;
                shoot_projectile(player.entity.world_position, activation.direction * 10.0, 1, 0.75, player.entity);
				// Global SFX mix: everything at 25% volume.
				sfx.volume *= 0.25;
				sfx.volume_perturb *= 0.25;
                rr_play_sfx("sfx/shoot.wav", sfx);

				is_sheriff := player.player_type == Player_Type.CIVILIAN && player.player_role == Player_Role.SHERIFF;

				// Consume sheriff ammo on fire (disables ability after first shot).
				if is_sheriff {
					player.sheriff_gun_ammo -= 1;
					if player.sheriff_gun_ammo < 0 { player.sheriff_gun_ammo = 0; }
				}

				// No need to apply cooldown if Sheriff is out of bullets.
				if is_sheriff && player.sheriff_gun_ammo <= 0 {
					current_cooldown = 0.0;
				} else {
					current_cooldown = 30.0;
				}
            }
        }
    }

	on_draw_button :: proc(instance: Shoot_Ability, rect: Rect) {
		draw_ability_name_label(rect, instance.name);

		// Sheriff gun ammo overlay (1 shot total): show a big number in top-right.
		if instance.player != null && instance.player.player_type == Player_Type.CIVILIAN && instance.player.player_role == Player_Role.SHERIFF {
			ammo := instance.player.sheriff_gun_ammo;
			if ammo < 0 { ammo = 0; }
			if ammo > 1 { ammo = 1; }

			bg := get_asset(Texture_Asset, "$AO/white.png");
			content := rect->inset(8);
			ammo_rect := content->top_right_rect()->offset(-18, -18)->grow(18);
			UI.quad(ammo_rect, bg, v4.{0, 0, 0, 0.55});

			ts := UI.default_text_settings();
			ts.size = 30;
			ts.color = (ammo > 0) ? v4.{1, 1, 1, 1} : v4.{0.8, 0.8, 0.8, 0.9};
			ts.halign = .CENTER;
			ts.valign = .CENTER;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(ammo_rect, ts, format_string("%", .{ammo}));
		}
	}
}

// Black Flag - Pirate ability that creates a fog zone
BLACK_FLAG_RADIUS :: 5.0;
BLACK_FLAG_DURATION :: 30.0;

// Pirate unlock economy
PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST :: 1;
PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST :: 2;

// Pirate treasure maps / digging
PIRATE_TREASURE_MAP_LOOT_RANGE :: 5.0;
PIRATE_TREASURE_DIG_SECONDS :: 1.6;
PIRATE_TREASURE_DIG_REASON :: "pirate_dig_for_treasure";

rr_pirate_refresh_unlocks :: proc(player: Player) {
	if player == null return;
	if player.player_role != Player_Role.PIRATE return;

	// Treasure is NOT consumed on unlock; abilities become usable once you have enough.
	if player.pirate_treasure >= PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST {
		player.pirate_black_flag_unlocked = true;
	}
	if player.pirate_treasure >= PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST {
		player.pirate_powder_keg_unlocked = true;
	}
}

Black_Flag :: class : Component {
    owner_entity: Entity;
    spawn_time: float;
    switched_to_idle: bool;
    
    ao_start :: proc(using this: Black_Flag) {
        spawn_time = get_time();
        switched_to_idle = false;

        // Kick off the flag animation (if the entity has a spine animator)
        spine_anim := entity->get_component(Spine_Animator);
        if spine_anim != null {
            // Start with appear, then we'll switch to idle shortly after.
            spine_anim.instance->set_animation("appear", false, 0);
        }
    }
    
    ao_update :: proc(using this: Black_Flag, dt: float) {
        time_alive := get_time() - spawn_time;

        // Transition to idle after a short delay (the rig has "appear" and "idle").
        // We don't have a clean way to query animation duration here, so keep it simple.
        if !switched_to_idle && time_alive > 0.75 {
            spine_anim := entity->get_component(Spine_Animator);
            if spine_anim != null {
                spine_anim.instance->set_animation("idle", true, 0);
            }
            switched_to_idle = true;
        }
        
        // Destroy after duration
        if time_alive >= BLACK_FLAG_DURATION {
            entity->destroy();
            return;
        }
        
        // Apply fog effect to nearby players (client-side rendering)
        foreach player: component_iterator(Player) {
            if player.player_state != Player_State.ALIVE continue;
            if !player->is_local_or_server() continue;
            
            distance := length(player.entity.world_position - entity.world_position);
            if distance < BLACK_FLAG_RADIUS {
                // Check if this player is immune (the Pirate who placed it)
                is_pirate_owner := #alive(owner_entity) && owner_entity == player.entity;
                
                if !is_pirate_owner {
                    // Draw fog overlay - obscures vision except small circle in center
                    draw_fog_overlay(player);
                }
            }
        }
    }
}

draw_fog_overlay :: proc(player: Player) {
    fog_texture := get_asset(Texture_Asset, "$AO/white.png");
    
    // Draw dark fog covering the entire screen
    UI.push_layer(1000);
    defer UI.pop_layer();
    
    fog_color := v4.{0, 0, 0, 0.9};
    
    screen := UI.get_screen_rect();
    UI.quad(screen, fog_texture, fog_color);
}

Black_Flag_Ability :: class : Ability_Base {
    NAME :: "Black Flag";
    
    on_init :: proc(ability: Black_Flag_Ability) {
        ability.icon = get_asset(Texture_Asset, "sprites/icons/pirate/black_flag.png");
    }
    
    can_use :: method() -> bool {
        if game_state != Game_State.INGAME return false;
        if player.player_state != Player_State.ALIVE return false;
        if player->has_task_in_progress() return false;
        if player.player_role != Player_Role.PIRATE return false;
		// Auto-unlock based on current treasure amount (treasure is not spent).
		if player.pirate_treasure < PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST return false;
        return true;
    }
    
    on_update :: method(params: ref Ability_Update_Params) {
        // If pressed while locked, explain unlock requirement.
        if params.clicked && !params.can_use {
            if player != null && player.player_role == Player_Role.PIRATE && player.pirate_treasure < PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST {
                player->Notify(format_string("Black Flag locked: get %/% treasure to unlock.", .{
                    min(player.pirate_treasure, PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST),
                    PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST
                }));
            }
        }

        if params.clicked && params.can_use {
            // Spawn prefab (includes the spine setup already)
            prefab := get_asset(Prefab_Asset, "prefabs/black_flag.prefab");
            flag_entity := Scene.instantiate(prefab);
            flag_entity->set_local_position(player.entity.local_position);

            // Ensure gameplay component exists (drives fog + appear->idle)
            flag: Black_Flag;
            flag = flag_entity->get_component(Black_Flag);
            if flag == null {
                flag = flag_entity->add_component(Black_Flag);
            }
            flag.owner_entity = player.entity;
            
            player->Notify("Black Flag placed!");
            current_cooldown = 60.0;
        }
    }

	on_draw_button :: proc(instance: Black_Flag_Ability, rect: Rect) {
		draw_ability_name_label(rect, Black_Flag_Ability.NAME);

		// Locked overlay (still show button for learnability).
		p := instance.player;
		if p != null && p.player_role == Player_Role.PIRATE && p.pirate_treasure < PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect->inset(2)->cut_top(20), ts, "LOCKED");

			ts2 := ts;
			ts2.size = 14;
			ts2.valign = .BOTTOM;
			UI.text(rect->inset(2)->cut_bottom(18), ts2, format_string("Need: %", .{PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST}));
		}
	}
}

// --- Pirate: Treasure Maps / Digging ---

rr_pirate_get_closest_unlooted_corpse :: proc(pirate: Player) -> Corpse {
	if pirate == null return null;
	finder := make_finder(Corpse, pirate.entity.world_position, PIRATE_TREASURE_MAP_LOOT_RANGE);
	foreach corpse: component_iterator(Corpse) {
		if corpse == null continue;
		if corpse.has_been_reported continue;
		if corpse.pirate_map_taken continue;
		finder->check(corpse, corpse.entity.world_position);
	}
	return finder.closest;
}

rr_pirate_pick_dig_spot_position :: proc(origin: v2) -> v2 {
	// Prefer random points across the whole map; clamp to navmesh for validity.
	rng := rng_seed_time();

	wmin := rr_get_map_world_min();
	wmax := rr_get_map_world_max();
	min_x := min(wmin.x, wmax.x);
	max_x := max(wmin.x, wmax.x);
	min_y := min(wmin.y, wmax.y);
	max_y := max(wmin.y, wmax.y);

	triangle_hint: s64;
	for i: 0..15 {
		p := v2.{rng_range_float(ref rng, min_x, max_x), rng_range_float(ref rng, min_y, max_y)};
		nav_point: v2;
		if try_find_closest_point_on_navmesh(p, ref nav_point, ref triangle_hint) {
			return nav_point;
		}
	}

	// Fallback: clamp the corpse position.
	nav_point: v2;
	if try_find_closest_point_on_navmesh(origin, ref nav_point, ref triangle_hint) {
		return nav_point;
	}
	return origin;
}

rr_pirate_spawn_dig_spot_for_player :: proc(pirate: Player, origin: v2) {
	if pirate == null return;
	if !Game.is_server() return;
	if pirate.player_role != Player_Role.PIRATE return;
	if pirate.player_state != Player_State.ALIVE return;

	pos := rr_pirate_pick_dig_spot_position(origin);
	e := Scene.create_entity();
	e->set_local_position(pos);

	spot := e->add_component(Pirate_Treasure_Dig_Spot);
	spot.owner_player_entity_id = pirate.entity.id;
}

Pirate_Dig_Lock :: class : Component {
	active: bool;
	end_time: float;
	spot_entity_id: u64;

	arm :: proc(using this: Pirate_Dig_Lock, seconds: float, spot_entity: Entity) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		active = true;
		spot_entity_id = 0;
		if #alive(spot_entity) {
			spot_entity_id = spot_entity.id;
		}

		p := entity->get_component(Player);
		if p != null {
			p->add_disable_movement_input_reason(PIRATE_TREASURE_DIG_REASON);
			// Visible to everyone (server-driven trigger replicated via player rig).
			p->set_trigger("pirate_dig_for_treasure");
		}
	}

	clear_spot_digging_flag :: proc(using this: Pirate_Dig_Lock) {
		if spot_entity_id == 0 return;
		foreach spot: component_iterator(Pirate_Treasure_Dig_Spot) {
			if spot == null continue;
			if spot.entity == null continue;
			if spot.entity.id != spot_entity_id continue;
			spot.is_digging = false;
			return;
		}
	}

	destroy_spot_entity_if_alive :: proc(using this: Pirate_Dig_Lock) {
		if spot_entity_id == 0 return;
		foreach spot: component_iterator(Pirate_Treasure_Dig_Spot) {
			if spot == null continue;
			if spot.entity == null continue;
			if spot.entity.id != spot_entity_id continue;
			if #alive(spot.entity) {
				spot.entity->destroy();
			}
			return;
		}
	}

	ao_update :: proc(using this: Pirate_Dig_Lock, dt: float) {
		if !active return;
		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: cancel if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(PIRATE_TREASURE_DIG_REASON);
			p->set_trigger("RESET");
			this->clear_spot_digging_flag();
			active = false;
			return;
		}

		if get_time() >= end_time {
			p->remove_disable_movement_input_reason(PIRATE_TREASURE_DIG_REASON);
			p->set_trigger("RESET");

			// Award treasure server-side.
			if Game.is_server() {
				p.pirate_treasure += 1;
				rr_pirate_refresh_unlocks(p);
				p->Notify("Found treasure! (+1)");
				this->destroy_spot_entity_if_alive();
			}

			active = false;
		}
	}
}

Pirate_Treasure_Dig_Spot :: class : Interactable {
	owner_player_entity_id: u64;
	is_dug: bool;
	is_digging: bool;

	ao_start :: method() {
		this->set_listener(this);
		radius = 1.25;
		prompt_offset = v2.{0, 0.6};
		required_hold_time = 0.0;
		priority = 25;
		this->set_text("Dig");
	}

	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.PIRATE return false;
		if owner_player_entity_id == 0 return false;
		if player.entity.id != owner_player_entity_id return false;
		if is_dug return false;
		if is_digging return false;
		return true;
	}

	on_interact :: method(player: Player) {
		if player == null return;
		if !Game.is_server() return;
		if is_dug || is_digging return;

		is_digging = true;

		lock := player.entity->get_component(Pirate_Dig_Lock);
		if lock == null {
			lock = player.entity->add_component(Pirate_Dig_Lock);
		}
		lock->arm(PIRATE_TREASURE_DIG_SECONDS, entity);
	}
}

Pirate_Treasure_Map_Ability :: class : Ability_Base {
	NAME :: "Treasure Map";

	on_init :: proc(instance: Pirate_Treasure_Map_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/pirate/dig_for_treasure.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_role != Player_Role.PIRATE return false;
		return rr_pirate_get_closest_unlooted_corpse(player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			corpse := rr_pirate_get_closest_unlooted_corpse(player);
			if corpse == null return;

			if Game.is_server() {
				corpse.pirate_map_taken = true;
				rr_pirate_spawn_dig_spot_for_player(player, corpse.entity.world_position);
			}

			player->Notify("Collected a treasure map!");
			current_cooldown = 1.0;
		}
	}

	on_draw_button :: proc(instance: Pirate_Treasure_Map_Ability, rect: Rect) {
		draw_ability_name_label(rect, Pirate_Treasure_Map_Ability.NAME);
	}
}

// --- Pirate: Powder Keg ---
POWDER_KEG_COOLDOWN_SECONDS :: 90.0;
POWDER_KEG_CAMERA_ZOOMED_OUT_SIZE :: 18.0;
POWDER_KEG_THROW_TRAVEL_TIME :: 0.75;
POWDER_KEG_MAX_THROW_RANGE :: 10.0;
POWDER_KEG_EXPLOSION_RADIUS :: 4.5;
POWDER_KEG_KNOCKBACK_SECONDS :: 0.55;
POWDER_KEG_KNOCKBACK_SPEED :: 14.0;
POWDER_KEG_CRATER_LIFETIME_SECONDS :: 18.0;

POWDER_KEG_KNOCKBACK_REASON :: "powder_keg_knockback";

Powder_Keg_Knockback :: class : Component {
	end_time: float;
	active: bool;
	dir: v2;

	arm :: proc(using this: Powder_Keg_Knockback, seconds: float, direction: v2, speed: float) {
		if seconds <= 0.0 {
			seconds = 0.1;
		}
		end_time = get_time() + seconds;
		active = true;
		dir = direction;

		p := entity->get_component(Player);
		if p != null {
			p->add_disable_movement_input_reason(POWDER_KEG_KNOCKBACK_REASON);
			// Initial impulse; movement can resume after the short disable window.
			p.agent.velocity = dir * speed;
		}
	}

	ao_update :: proc(using this: Powder_Keg_Knockback, dt: float) {
		if !active {
			return;
		}
		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(POWDER_KEG_KNOCKBACK_REASON);
			active = false;
			return;
		}

		if get_time() >= end_time {
			p->remove_disable_movement_input_reason(POWDER_KEG_KNOCKBACK_REASON);
			active = false;
			return;
		}
	}
}

Powder_Keg_Crater :: class : Component {
	spawn_time: float;
	switched_to_idle: bool;

	ao_start :: proc(using this: Powder_Keg_Crater) {
		spawn_time = get_time();
		switched_to_idle = false;

		spine_anim := entity->add_component(Spine_Animator);
		spine_anim->awaken();
		spine_anim.depth_offset = 10.0;
		spine_anim.instance->set_skeleton(get_asset(Spine_Asset, "anims/crater/BAT003_meteor_crash_crator.spine"));
		spine_anim.instance->set_animation("appear", false, 0);
	}

	ao_update :: proc(using this: Powder_Keg_Crater, dt: float) {
		time_alive := get_time() - spawn_time;

		// Switch to idle after the appear animation.
		if !switched_to_idle && time_alive > 0.75 {
			spine_anim := entity->get_component(Spine_Animator);
			if spine_anim != null {
				spine_anim.instance->set_animation("idle", true, 0);
			}
			switched_to_idle = true;
		}

		if time_alive >= POWDER_KEG_CRATER_LIFETIME_SECONDS {
			// Optional: play disappear briefly before destroying.
			spine_anim := entity->get_component(Spine_Animator);
			if spine_anim != null {
				spine_anim.instance->set_animation("disappear", false, 0);
			}
			entity->queue_for_destruction(0.6);
		}
	}
}

powder_keg_explode_at :: proc(owner: Entity, position: v2) {
	// Spawn crater visual
	crater_e := Scene.create_entity();
	crater_e->set_local_position(position);
	crater_e->add_component(Powder_Keg_Crater);

	// Find all players in range and track nearest.
	nearest: Player = null;
	nearest_dist_sq := 0.0;
	owner_id: u64 = 0;
	if #alive(owner) {
		owner_id = owner.id;
	}

	// First pass: determine the nearest victim in the blast.
	foreach p: component_iterator(Player) {
		if p.player_state != Player_State.ALIVE continue;
		// Pirate cannot kill themselves with their own keg.
		if owner_id != 0 && #alive(p.entity) && p.entity.id == owner_id continue;
		d := p.entity.world_position - position;
		dist_sq := length_squared(d);
		if dist_sq > POWDER_KEG_EXPLOSION_RADIUS * POWDER_KEG_EXPLOSION_RADIUS continue;

		if nearest == null || dist_sq < nearest_dist_sq {
			nearest = p;
			nearest_dist_sq = dist_sq;
		}
	}

	// Kill the nearest victim.
	if nearest != null {
		killer_id: u64 = 0;
		if #alive(owner) {
			killer_id = owner.id;
		}
		nearest->kill_with_killer(killer_id);
		{
			sfx := SFX.default_sfx_desc();
			sfx->set_position(nearest.entity.world_position);
			sfx.volume = 0.8;
			// Explicit death SFX (old `sfx/death.wav` removed).
			// Note: `traitor_kill_death.wav` is reserved for knife/neck-snap kills.
			// Global SFX mix: everything at 25% volume.
			sfx.volume *= 0.25;
			sfx.volume_perturb *= 0.25;
			rr_play_sfx("sfx/other_death.wav", sfx);
		}
	}

	// Second pass: knock back everyone else in the blast.
	foreach p: component_iterator(Player) {
		if p.player_state != Player_State.ALIVE continue;
		if nearest != null && p == nearest continue;

		d := p.entity.world_position - position;
		dist_sq := length_squared(d);
		if dist_sq > POWDER_KEG_EXPLOSION_RADIUS * POWDER_KEG_EXPLOSION_RADIUS continue;

		dir := d;
		if length_squared(dir) < 0.001 {
			dir = v2.{1, 0};
		} else {
			dir = normalize(dir);
		}

		knock := p.entity->get_component(Powder_Keg_Knockback);
		if knock == null {
			knock = p.entity->add_component(Powder_Keg_Knockback);
		}
		knock->arm(POWDER_KEG_KNOCKBACK_SECONDS, dir, POWDER_KEG_KNOCKBACK_SPEED);
	}
}

Powder_Keg_Thrown :: class : Component {
	owner: Entity;
	start_pos: v2;
	target_pos: v2;
	start_time: float;
	travel_time: float;
	exploded: bool;
	triangle_hint: s64;

	ao_start :: proc(using this: Powder_Keg_Thrown) {
		start_time = get_time();
		if travel_time <= 0 {
			travel_time = POWDER_KEG_THROW_TRAVEL_TIME;
		}

		spine_anim := entity->add_component(Spine_Animator);
		spine_anim->awaken();
		spine_anim.instance->set_skeleton(get_asset(Spine_Asset, "anims/powder_keg/004RAND_powder_keg.spine"));
		spine_anim.instance->set_animation("Flying_Through_Air", true, 0);
	}

	ao_update :: proc(using this: Powder_Keg_Thrown, dt: float) {
		if exploded {
			return;
		}

		// Clamp target to navmesh (keeps explosions on walkable areas).
		clamped_target := target_pos;
		point: v2;
		if try_find_closest_point_on_navmesh(target_pos, ref point, ref triangle_hint) {
			clamped_target = point;
		}

		t := (get_time() - start_time) / travel_time;
		if t < 0 { t = 0; }
		if t > 1 { t = 1; }

		// Simple parabolic arc for readability.
		height := 1.0;
		arc := 4.0 * t * (1.0 - t) * height;
		pos := lerp(start_pos, clamped_target, t);
		entity->set_local_position(pos + v2.{0, arc});

		if t >= 1.0 {
			// Snap to ground at target and explode.
			entity->set_local_position(clamped_target);
			spine_anim := entity->get_component(Spine_Animator);
			if spine_anim != null {
				spine_anim.instance->set_animation("Explode", false, 0);
			}

			powder_keg_explode_at(owner, clamped_target);

			// Cleanup projectile entity shortly after explode anim starts.
			exploded = true;
			entity->queue_for_destruction(0.8);
		}
	}
}

Powder_Keg_Ability :: class : Ability_Base {
	NAME :: "Powder Keg";

	camera_zoom_active: bool;
	camera_original_size: float;
	was_targeting: bool;
	activated_this_session: bool;

	on_init :: proc(ability: Powder_Keg_Ability) {
		ability.icon = get_asset(Texture_Asset, "sprites/icons/pirate/powder_keg.png");
		ability.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_role != Player_Role.PIRATE return false;
		// Auto-unlock based on current treasure amount (treasure is not spent).
		if player.pirate_treasure < PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST return false;
		return true;
	}

	set_camera_zoom :: proc(using this: Powder_Keg_Ability, active: bool) {
		if active {
			if !camera_zoom_active {
				camera_original_size = player.camera.size;
				player.camera.size = POWDER_KEG_CAMERA_ZOOMED_OUT_SIZE;
				camera_zoom_active = true;
			}
		}
		else {
			if camera_zoom_active {
				player.camera.size = camera_original_size;
				camera_zoom_active = false;
			}
		}
	}

	cleanup_targeting :: proc(using this: Powder_Keg_Ability) {
		this->set_camera_zoom(false);
		was_targeting = false;
		activated_this_session = false;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			if player != null && player.player_role == Player_Role.PIRATE && player.pirate_treasure < PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST {
				player->Notify(format_string("Powder Keg locked: get %/% treasure to unlock.", .{
					min(player.pirate_treasure, PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST),
					PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST
				}));
			}
		}

		// Drive enter/exit targeting via standard helper.
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;

		// Prevent aiming mode while on cooldown / otherwise unusable.
		if targeting && !params.can_use {
			player.active_ability = null;
			this->cleanup_targeting();
			return;
		}

		// Handle targeting transitions (for cleanup + per-session activation gating).
		if targeting && !was_targeting {
			activated_this_session = false;
			was_targeting = true;
		}
		if !targeting {
			if was_targeting {
				this->cleanup_targeting();
			}
			return;
		}

		this->set_camera_zoom(true);

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel {
			player.active_ability = null;
			this->cleanup_targeting();
			return;
		}

		// Preview target (world-space).
		target_pos := get_mouse_world_position();
		{
			// Clamp max throw distance so the keg can't be thrown across the map.
			origin := player.entity.world_position;
			delta := target_pos - origin;
			max_r := POWDER_KEG_MAX_THROW_RANGE;
			if length_squared(delta) > max_r * max_r {
				if length_squared(delta) < 0.001 {
					delta = v2.{1, 0};
				} else {
					delta = normalize(delta);
				}
				target_pos = origin + delta * max_r;
			}
		}
		draw_aiming_line(player.entity.world_position, aiming.aim_direction, 1.0 / player.camera.size * 4);

		// Optional: show a subtle circle at the target.
		if player->is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			UI.quad(Rect{target_pos, target_pos}->grow(0.08, 0.08, 0.08, 0.08), core_globals.white_sprite, v4.{1, 0.6, 0.1, 0.9});
		}

		// Only allow one throw per targeting session (guards against odd input edge cases).
		if activated_this_session {
			return;
		}

		if aiming.activate && params.can_use {
			activated_this_session = true;

			// Start cooldown immediately to prevent double activates.
			current_cooldown = POWDER_KEG_COOLDOWN_SECONDS;

			// Throw keg toward clicked point.
			throw_entity := Scene.create_entity();
			throw_entity->set_local_position(player.entity.world_position);
			throw_comp := throw_entity->add_component(Powder_Keg_Thrown);
			throw_comp.owner = player.entity;
			throw_comp.start_pos = player.entity.world_position;
			throw_comp.target_pos = target_pos;
			throw_comp.travel_time = POWDER_KEG_THROW_TRAVEL_TIME;

			// Consume targeting mode.
			player.active_ability = null;
			this->cleanup_targeting();
		}
	}

	on_draw_button :: proc(instance: Powder_Keg_Ability, rect: Rect) {
		draw_ability_name_label(rect, Powder_Keg_Ability.NAME);

		// Locked overlay (still show button for learnability).
		p := instance.player;
		if p != null && p.player_role == Player_Role.PIRATE && p.pirate_treasure < PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect->inset(2)->cut_top(20), ts, "LOCKED");

			ts2 := ts;
			ts2.size = 14;
			ts2.valign = .BOTTOM;
			UI.text(rect->inset(2)->cut_bottom(18), ts2, format_string("Need: %", .{PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST}));
		}
	}
}

// --- Prankster ---
PRANK_DELAY_SECONDS :: 10.0;
PRANK_MELEE_RANGE :: 3.0;
PRANK_STUN_SECONDS :: 2.0;
PRANK_STUN_REASON :: "prank_slip";

// --- Pyromaniac (Anarchist role) ---
PYRO_LIGHT_FIRE_RANGE :: 2.0;
PYRO_LIGHT_FIRE_COOLDOWN_SECONDS :: 25.0;

rr_pyro_get_closest_unlit_prop :: proc(player: Player) -> Entity {
	if player == null return null;
	if world_references == null return null;

	props: [..]Sprite_Renderer;
	world_references->find_props_child_sprite_renderers(ref props, clear_first=true);
	if props.count <= 0 return null;

	best: Entity = null;
	best_dist_sq := 0.0;
	r_sq := PYRO_LIGHT_FIRE_RANGE * PYRO_LIGHT_FIRE_RANGE;

	for i: 0..props.count-1 {
		s := props[i];
		if s == null continue;
		e := s.entity;
		if e == null continue;
		if !#alive(e) continue;

		// Skip already-burning props.
		existing := e->get_component(RR_Prop_Fire_Target);
		if existing != null && existing.active {
			continue;
		}

		d := e.world_position - player.entity.world_position;
		dist_sq := length_squared(d);
		if dist_sq > r_sq continue;

		if best == null || dist_sq < best_dist_sq {
			best = e;
			best_dist_sq = dist_sq;
		}
	}
	return best;
}

Pyromaniac_Light_Fire_Ability :: class : Ability_Base {
	NAME :: "Light Fire";

	on_init :: proc(instance: Pyromaniac_Light_Fire_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/pyro/set_fire.png");
	}

	can_use :: method() -> bool {
		p := player;
		if game_state != Game_State.INGAME return false;
		if p == null return false;
		if p.player_state != Player_State.ALIVE return false;
		if p->has_task_in_progress() return false;
		if p.player_type != Player_Type.ANARCHIST return false;
		if p.player_role != Player_Role.PYROMANIAC return false;
		if p.pyro_on_fire return false;
		// Disabled when no valid nearby prop target.
		return rr_pyro_get_closest_unlit_prop(p) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			// Server authoritative: spawns gameplay-relevant fire instance.
			if Game.is_server() {
				target := rr_pyro_get_closest_unlit_prop(player);
				if target != null {
					fire := target->get_component(RR_Prop_Fire_Target);
					if fire == null {
						fire = target->add_component(RR_Prop_Fire_Target);
					}
					fire->ignite();
					// Cosmetic but should replicate: trigger snap animation on merged rig.
					player->set_trigger("pyro_snap_fingers");
					rr_pyro_register_prop_ignited(player);
				}
			}
			current_cooldown = PYRO_LIGHT_FIRE_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: Pyromaniac_Light_Fire_Ability, rect: Rect) {
		draw_ability_name_label(rect, Pyromaniac_Light_Fire_Ability.NAME);
	}
}

Pyromaniac_Light_Corpse_Ability :: class : Ability_Base {
	NAME :: "Light Corpse";

	on_init :: proc(instance: Pyromaniac_Light_Corpse_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/pyro/light_corpse.png");
	}

	can_use :: method() -> bool {
		p := player;
		if game_state != Game_State.INGAME return false;
		if p == null return false;
		if p.player_state != Player_State.ALIVE return false;
		if p->has_task_in_progress() return false;
		if p.player_type != Player_Type.ANARCHIST return false;
		if p.player_role != Player_Role.PYROMANIAC return false;
		if p.pyro_on_fire return false;
		// Disabled when no valid nearby corpse target.
		return rr_pyro_find_burnable_corpse(p) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			if Game.is_server() {
				corpse := rr_pyro_find_burnable_corpse(player);
				if corpse != null && #alive(corpse.entity) {
					corpse.pyro_has_been_burned = true;

					// Spawn 008BED_fire and drive the burn->extinguish->cleanup sequence.
					rr_pyro_start_burning_corpse_visual(corpse.entity);

					rr_pyro_register_corpse_burned(player);
					player->set_trigger("pyro_snap_fingers");
				}
			}
			current_cooldown = PYRO_LIGHT_CORPSE_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: Pyromaniac_Light_Corpse_Ability, rect: Rect) {
		draw_ability_name_label(rect, Pyromaniac_Light_Corpse_Ability.NAME);
	}
}

Pyromaniac_World_Fire_Ability :: class : Ability_Base {
	NAME :: "World Fire";

	on_init :: proc(instance: Pyromaniac_World_Fire_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/pyro/worldfire.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.ANARCHIST return false;
		if player.player_role != Player_Role.PYROMANIAC return false;
		if player.pyro_on_fire return false;
		// Still allow the button to show while locked (so we can draw LOCKED overlay),
		// but don't allow activation until unlocked.
		if player.pyro_world_fire_unlocked_time <= 0.0 return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			if player != null && player.pyro_world_fire_unlocked_time <= 0.0 {
				player->Notify(format_string("World Fire locked: burn 1 corpse + light 5 props (Corpse %/1, Props %/5).", .{
					min(player.pyro_corpses_burned, 1),
					min(player.pyro_props_ignited, 5)
				}));
			}
		}

		if params.clicked && params.can_use {
			// Trigger the server-authoritative win cinematic.
			start_pyro_win_cinematic(player);

			// Kick off local-only overlay + bigfire around pyro for the duration.
			if player->is_local_or_server() {
				c := player.entity->get_component(RR_Pyro_World_Fire_Cinematic);
				if c == null {
					c = player.entity->add_component(RR_Pyro_World_Fire_Cinematic);
				}
				c->arm();
			}

			current_cooldown = 9999.0;
		}
	}

	on_draw_button :: proc(instance: Pyromaniac_World_Fire_Ability, rect: Rect) {
		draw_ability_name_label(rect, Pyromaniac_World_Fire_Ability.NAME);

		// Locked overlay + progress
		p := instance.player;
		if p == null return;
		if p.pyro_world_fire_unlocked_time > 0.0 return;

		ts := UI.default_text_settings();
		ts.size = 18;
		ts.halign = .CENTER;
		ts.valign = .TOP;
		ts.do_outline = true;
		ts.outline_thickness = 2;
		ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(rect->inset(2)->cut_top(20), ts, "LOCKED");

		// Show objective progress underneath.
		prog := format_string("Corpse %/1  Props %/5", .{min(p.pyro_corpses_burned, 1), min(p.pyro_props_ignited, 5)});
		ts2 := ts;
		ts2.size = 14;
		ts2.valign = .BOTTOM;
		UI.text(rect->inset(2)->cut_bottom(18), ts2, prog);
	}
}

Pranked_Effect :: class : Component {
	trigger_time: float;
	stun_end_time: float;
	phase: int; // 0 = waiting, 1 = stunning, 2 = done

	ao_start :: proc(using this: Pranked_Effect) {
		phase = 0;
	}

	arm :: proc(using this: Pranked_Effect, delay_seconds: float) {
		trigger_time = get_time() + delay_seconds;
		stun_end_time = 0.0;
		phase = 0;
	}

	ao_update :: method(dt: float) {
		p := entity->get_component(Player);
		if p == null {
			return;
		}

		// Safety: if gameplay ended or player is dead, ensure we don't leave them frozen.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(PRANK_STUN_REASON);
			phase = 2;
			return;
		}

		if phase == 0 {
			if get_time() < trigger_time {
				return;
			}

			// Impact moment: notify, play anim (non-looping), and freeze movement for 2 seconds.
			p->Notify("you've been pranked!");
			p->set_trigger("prank_slip");
			p->add_disable_movement_input_reason(PRANK_STUN_REASON);
			stun_end_time = get_time() + PRANK_STUN_SECONDS;
			phase = 1;
			return;
		}

		if phase == 1 {
			if get_time() >= stun_end_time {
				p->remove_disable_movement_input_reason(PRANK_STUN_REASON);
				// Return to the normal locomotion tree after the one-shot.
				// NOTE: This assumes the player's anim state machine has a RESET trigger wired (it already does for revive).
				p->set_trigger("RESET");
				phase = 2;
			}
			return;
		}
	}
}

Prank_Ability :: class : Ability_Base {
	NAME :: "Prank";

	on_init :: proc(instance: Prank_Ability) {
		// Reuse an existing icon (no prank icon in the repo).
		instance.icon = get_asset(Texture_Asset, "sprites/icons/trickster/prank.png");
	}

	get_closest_prankable_player :: proc(instance: Prank_Ability, player: Player) -> Player {
		finder := make_finder(Player, player.entity.world_position, PRANK_MELEE_RANGE);
		for i: 0..players.elements.count-1 {
			target := players.elements[i];
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == player continue;
			if target.player_state != Player_State.ALIVE continue;
			finder->check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: proc(instance: Prank_Ability) -> bool {
		if game_state != Game_State.INGAME return false;
		if instance.player.player_state != Player_State.ALIVE return false;
		if instance.player->has_task_in_progress() return false;
		return instance->get_closest_prankable_player(instance.player) != null;
	}

	on_update :: proc(instance: Prank_Ability, params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			target := instance->get_closest_prankable_player(instance.player);
			if target == null {
				return;
			}

			// Count unique pranks toward the win condition
			instance.player.prankster_prank_count += 1;

			// Attach a delayed effect to the target so the message shows on THEIR client after 10s
			eff := target.entity->get_component(Pranked_Effect);
			if eff == null {
				eff = target.entity->add_component(Pranked_Effect);
			}
			eff->arm(PRANK_DELAY_SECONDS);

			instance.player->Notify(format_string("Pranked %!", .{target.entity->get_name()}));
			instance.current_cooldown = 15.0;
		}
	}

	on_draw_button :: proc(instance: Prank_Ability, rect: Rect) {
		draw_ability_name_label(rect, Prank_Ability.NAME);
	}
}

Fake_Meeting_Ability :: class : Ability_Base {
	NAME :: "Fake Meeting";

	on_init :: proc(instance: Fake_Meeting_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/trickster/call_fake.png");
	}

	can_use :: proc(instance: Fake_Meeting_Ability) -> bool {
		if game_state != Game_State.INGAME return false;
		if instance.player.player_state != Player_State.ALIVE return false;
		if instance.player->has_task_in_progress() return false;

		// Respect the shared meeting cooldown AND the prankster's fake-meeting cooldown.
		// These are server-owned but replicated to clients, so we can safely use them for UI disabling.
		now := get_time();
		cooldown_end := max(meeting_cooldown_ends_at, fake_meeting_cooldown_ends_at);
		return now >= cooldown_end;
	}

	on_update :: proc(instance: Fake_Meeting_Ability, params: ref Ability_Update_Params) {
		// Keep the button's cooldown overlay synced with the authoritative cooldown timers.
		now := get_time();
		cooldown_end := max(meeting_cooldown_ends_at, fake_meeting_cooldown_ends_at);
		remaining := cooldown_end - now;
		if remaining < 0.0 remaining = 0.0;
		instance.current_cooldown = remaining;

		if params.clicked && params.can_use {
			start_fake_meeting(instance.player);

			// Resync immediately in case the meeting successfully started this frame.
			now = get_time();
			cooldown_end = max(meeting_cooldown_ends_at, fake_meeting_cooldown_ends_at);
			remaining = cooldown_end - now;
			if remaining < 0.0 remaining = 0.0;
			instance.current_cooldown = remaining;
		}
	}

	on_draw_button :: proc(instance: Fake_Meeting_Ability, rect: Rect) {
		draw_ability_name_label(rect, Fake_Meeting_Ability.NAME);
	}
}

JESTER_WIN_DELAY_SECONDS :: 15.0;
JESTER_WIN_CINEMATIC_TRIGGER :: "jester_win";

Jester_Win_Ability :: class : Ability_Base {
	NAME :: "Jester Win";

	on_init :: proc(instance: Jester_Win_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/trickster/jester.png");
	}

	can_use :: method() -> bool {
		// Must be alive in-game
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;

		// Locked until both objectives are complete (and unlock timer started)
		if player.prankster_jester_unlocked_time <= 0.0 return false;

		// Wait 15 seconds after unlocking
		return get_time() >= (player.prankster_jester_unlocked_time + JESTER_WIN_DELAY_SECONDS);
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// If pressed while locked, explain unlock requirement / timing.
		if params.clicked && !params.can_use {
			if player != null {
				if player.prankster_jester_unlocked_time <= 0.0 {
					player->Notify(format_string("Jester Win locked: prank %/% and call %/% fake meetings to unlock.", .{
						min(player.prankster_prank_count, 3),
						3,
						min(player.prankster_fake_meetings_called, 1),
						1
					}));
				} else {
					remaining := (player.prankster_jester_unlocked_time + JESTER_WIN_DELAY_SECONDS) - get_time();
					if remaining > 0.0 {
						player->Notify(format_string("Jester Win charging: survive %s more seconds.", .{format_float(remaining, decimals=0)}));
					}
				}
			}
		}

		if params.clicked && params.can_use {
			// Start the cinematic; game will end after 5 seconds.
			start_jester_win_cinematic(player);
			// Put the ability on cooldown so it can't be spammed during the cinematic.
			current_cooldown = 9999.0;
		}
	}

	on_draw_button :: proc(instance: Jester_Win_Ability, rect: Rect) {
		draw_ability_name_label(rect, Jester_Win_Ability.NAME);

		// Draw countdown / lock state on top of the button.
		ts := UI.default_text_settings();
		ts.size = 20;
		ts.halign = .CENTER;
		ts.valign = .TOP;

		player := instance.player;
		if player == null {
			return;
		}

		label := "";
		if player.prankster_jester_unlocked_time <= 0.0 {
			label = "LOCKED";
		} else {
			remaining := (player.prankster_jester_unlocked_time + JESTER_WIN_DELAY_SECONDS) - get_time();
			if remaining > 0.0 {
				label = format_string("%s", .{format_float(remaining, decimals=0)});
			} else {
				label = "READY";
			}
		}
		UI.text(rect->inset(4)->cut_top(24), ts, label);
	}
}

// --- Movie Star ---
MOVIE_STAR_AUTOGRAPH_PLACE_TIME_SECONDS :: 2.2;
MOVIE_STAR_AUTOGRAPH_COOLDOWN_SECONDS :: 30.0;
MOVIE_STAR_AUTOGRAPH_WRITE_REASON :: "movie_star_autograph_write";

Movie_Star_Write_Autograph :: class : Component {
	end_time: float;
	placed: bool;
	done: bool;

	ao_start :: proc(using this: Movie_Star_Write_Autograph) {
		p := entity->get_component(Player);
		if p == null {
			// Defensive: should never happen on non-player entities.
			done = true;
			return;
		}
		placed = false;
		done = false;
		end_time = get_time() + MOVIE_STAR_AUTOGRAPH_PLACE_TIME_SECONDS;

		// Lock movement during the signing animation
		p->add_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_WRITE_REASON);
		p->set_trigger("write_place_autograph");
	}

	ao_update :: proc(using this: Movie_Star_Write_Autograph, dt: float) {
		if done {
			return;
		}
		p := entity->get_component(Player);
		if p == null {
			done = true;
			return;
		}

		// Safety: if game left gameplay or player died, stop freezing them.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_WRITE_REASON);
			p->set_trigger("RESET");
			done = true;
			return;
		}

		if !placed && get_time() >= end_time {
			placed = true;
			rr_add_autograph_trap(p, p.entity.world_position);
			p->remove_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_WRITE_REASON);
			p->set_trigger("RESET");
			done = true;
		}
	}
}

MOVIE_STAR_AUTOGRAPH_STUN_REASON :: "movie_star_autograph_stun";

Stunned_By_Autograph_Effect :: class : Component {
	stun_end_time: float;
	active: bool;

	arm :: proc(using this: Stunned_By_Autograph_Effect, seconds: float) {
		if seconds <= 0.0 {
			seconds = 0.1;
		}
		stun_end_time = get_time() + seconds;
		active = true;

		p := entity->get_component(Player);
		if p != null {
			p->add_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_STUN_REASON);
			p->set_trigger("stunned_by_autograph_loop");
		}
	}

	ao_update :: proc(using this: Stunned_By_Autograph_Effect, dt: float) {
		if !active {
			return;
		}
		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_STUN_REASON);
			p->set_trigger("RESET");
			active = false;
			return;
		}

		if get_time() >= stun_end_time {
			p->remove_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_STUN_REASON);
			p->set_trigger("RESET");
			active = false;
		}
	}
}

Autograph_Ability :: class : Ability_Base {
	NAME :: "Autograph";

	on_init :: proc(instance: Autograph_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/movie_star/write_signature.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.CIVILIAN return false;
		if player.player_role != Player_Role.MOVIE_STAR return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			// Prevent double-clicks from stacking multiple writers/traps.
			current_cooldown = MOVIE_STAR_AUTOGRAPH_COOLDOWN_SECONDS;

			// Start the signing animation; trap is placed when it ends (~1.8s).
			writer := player.entity->get_component(Movie_Star_Write_Autograph);
			if writer == null {
				writer = player.entity->add_component(Movie_Star_Write_Autograph);
			}
		}
	}

	on_draw_button :: proc(instance: Autograph_Ability, rect: Rect) {
		draw_ability_name_label(rect, Autograph_Ability.NAME);
	}
}

// --- Portal Maker ---
PORTAL_MAKER_PORTAL_COOLDOWN_SECONDS :: 25.0;

Red_Portal_Ability :: class : Ability_Base {
	NAME :: "Red Portal";

	on_init :: proc(instance: Red_Portal_Ability) {
		instance.name = NAME;
		instance.icon = get_asset(Texture_Asset, "sprites/icons/portal_maker/red_portal.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.CIVILIAN return false;
		if player.player_role != Player_Role.PORTAL_MAKER return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Click-to-aim: press ability button to enter aim mode, then click to fire.
		activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);
		if params.can_use && activation.activate {
			rr_portal_maker_fire_bolt(player, true, activation.direction);
			current_cooldown = PORTAL_MAKER_PORTAL_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: Red_Portal_Ability, rect: Rect) {
		draw_ability_name_label(rect, Red_Portal_Ability.NAME);
	}
}

Blue_Portal_Ability :: class : Ability_Base {
	NAME :: "Blue Portal";

	on_init :: proc(instance: Blue_Portal_Ability) {
