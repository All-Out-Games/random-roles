import "core:ao"

DOCTOR_RESURRECT_DURATION_SECONDS :: 10.0;
DOCTOR_RESURRECTS_PER_ROUND :: 2;

get_player_by_entity_id :: proc(entity_id: u64) -> Player {
    for i: 0..players.elements.count-1 {
        p := players.elements[i];
        if p == null continue;
        if !#alive(p.entity) continue;
        if p.entity.id == entity_id {
            return p;
        }
    }
    return null;
}

Kill_Ability :: class : Ability_Base {
    NAME :: "Kill";

    on_init :: proc(instance: Kill_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/kill_ability.png");
    }

    get_closest_alive_player :: proc(instance: Kill_Ability, player: Player) -> Player {
        finder := make_finder(Player, player.entity.world_position, 5.0);
        for i: 0..players.elements.count-1 {
            target := players.elements[i];
            if target == null {
                continue;
            }
            if !#alive(target.entity) {
                continue;
            }
            if target == player {
                continue;
            }
            if target.player_state != Player_State.ALIVE {
                continue;
            }

            // Traitors shouldn't be able to melee-kill other traitors.
            if player.player_type == Player_Type.TRAITOR && target.player_type == Player_Type.TRAITOR {
                continue;
            }
            finder->check(target, target.entity.world_position);
        }
        return finder.closest;
    }

    can_use :: method() -> bool {
        return get_closest_alive_player(this, player) != null;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            closest_alive_player := get_closest_alive_player(this, player);
            if closest_alive_player != null {
                closest_alive_player->kill();
            }
        }
    }
}

Resurrect_Ability :: class : Ability_Base {
    NAME :: "Resurrect";

    on_init :: proc(instance: Resurrect_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/doctor/revive.png");
    }

    get_closest_resurrectable_corpse :: proc(instance: Resurrect_Ability, doctor: Player) -> Corpse {
        finder := make_finder(Corpse, doctor.entity.world_position, 5.0);
        foreach corpse: component_iterator(Corpse) {
            // Corpse must belong to a currently-dead player.
            target := get_player_by_entity_id(corpse.owner_player_entity_id);
            if target == null continue;
            if target.player_state != Player_State.DEAD continue;
            finder->check(corpse, corpse.entity.world_position);
        }
        return finder.closest;
    }

    can_use :: method() -> bool {
        if game_state != Game_State.INGAME return false;
        if player.player_state != Player_State.ALIVE return false;
        if player.player_type != Player_Type.CIVILIAN return false;
        if player.player_role != Player_Role.DOCTOR return false;
        if player.doctor_resurrects_used >= DOCTOR_RESURRECTS_PER_ROUND return false;
        return get_closest_resurrectable_corpse(this, player) != null;
    }

    on_update :: proc(instance: Resurrect_Ability, params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            corpse := instance->get_closest_resurrectable_corpse(instance.player);
            if corpse == null return;

            target := get_player_by_entity_id(corpse.owner_player_entity_id);
            if target == null return;
            if target.player_state != Player_State.DEAD return;

            revive_pos := corpse.entity.world_position;

            // Consume a use.
           instance.player.doctor_resurrects_used += 1;

            // Remove the body (they "stand up").
            if #alive(corpse.entity) {
                destroy_entity(corpse.entity);
            }

            // Revive at the corpse position.
            set_local_position(target.entity, revive_pos);
            on_player_go_alive(target);

            target.is_temporarily_resurrected = true;
            target.temporarily_resurrected_until = get_time() + DOCTOR_RESURRECT_DURATION_SECONDS;

            // Feedback
            instance.player->Notify(format_string("Resurrected % for %{.0}s (%/% used)", .{
                target.entity->get_name(),
                DOCTOR_RESURRECT_DURATION_SECONDS,
                instance.player.doctor_resurrects_used,
                DOCTOR_RESURRECTS_PER_ROUND
            }));
            target->Notify(format_string("You were resurrected for %{.0}s (no tasks).", .{DOCTOR_RESURRECT_DURATION_SECONDS}));

            // Small cooldown to prevent double-click spamming; uses-per-round is the main limiter.
            instance.current_cooldown = 1.0;
        }
    }

    on_draw_button :: proc(instance: Resurrect_Ability, rect: Rect) {
        player := instance.player;
        if player == null return;
        if player.player_role != Player_Role.DOCTOR return;

        ts := UI.default_text_settings();
        ts.size = 18;
        ts.halign = .CENTER;
        ts.valign = .BOTTOM;
        remaining := DOCTOR_RESURRECTS_PER_ROUND - player.doctor_resurrects_used;
        if remaining < 0 { remaining = 0; }
        UI.text(rect->inset(2), ts, format_string("%/%", .{remaining, DOCTOR_RESURRECTS_PER_ROUND}));
    }
}

Report_Ability :: class : Ability_Base {
    NAME :: "Report";

    on_init :: proc(instance: Report_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/report_ability.png");
    }

    get_closest_corpse :: proc(instance: Report_Ability, player: Player) -> Corpse {
        finder := make_finder(Corpse, player.entity.world_position, 5.0);
        foreach corpse: component_iterator(Corpse) {
            if corpse.has_been_reported {
                continue;
            }
            finder->check(corpse, corpse.entity.world_position);
        }
        return finder.closest;
    }

    can_use :: proc(instance: Report_Ability) -> bool {
        return instance->get_closest_corpse(instance.player) != null;
    }

    on_update :: proc(instance: Report_Ability, params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            closest_corpse := instance->get_closest_corpse(instance.player);
            if closest_corpse != null {
                closest_corpse.has_been_reported = true;
                // Start the meeting (corpse persists; cleaned up on disconnect / round end)
                start_meeting(true);
            }
        }
    }
}

Vote_Ability :: class : Ability_Base {
    NAME :: "Vote";
    voting_ui_open: bool;

    on_init :: proc(instance: Vote_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/report_ability.png");
        instance.voting_ui_open = false;
    }

    can_use :: method() -> bool {
        return game_state == Game_State.VOTING && player.player_state == Player_State.ALIVE;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            voting_ui_open = !voting_ui_open;
        }
        
        if voting_ui_open && player->is_local_or_server() {
            draw_voting_ui(this, player);
        }
    }

    draw_voting_ui :: proc(instance: Vote_Ability, local_player: Player) {

        screen := UI.get_safe_screen_rect();

        // --- Style constants ---
        white := get_asset(Texture_Asset, "$AO/white.png");
        row_sprite := get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // grey button
        hightlight := get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_10.png");
        check_on := get_asset(Texture_Asset, "sprites/icons/vote_select_icon.png");
        check_off := get_asset(Texture_Asset, "sprites/icons/vote_unselect_icon.png");

        c_overlay := v4.{0, 0, 0, 0.82};
        c_panel_shadow := v4.{0, 0, 0, 0.55};
        c_text := v4.{0.95, 0.97, 1.0, 1};
        c_muted := v4.{0.75, 0.8, 0.9, 1};
        c_accent := v4.{0.25, 0.8, 0.55, 1};
        c_warn := v4.{1.0, 0.55, 0.3, 1};

        // Dark background overlay
        UI.quad(screen, white, c_overlay);

        panel_rect := screen->center_rect()->grow(420, 520, 420, 520);
        UI.quad(panel_rect, white, c_panel_shadow);

        content := panel_rect->inset(26);
        header := content->cut_top(92);
        footer := content->cut_bottom(78);

        // Timer display + title
        current_time := get_time();
        elapsed := current_time - voting_start_time;
        remaining := 60.0 - elapsed;
        if remaining < 0.0 { remaining = 0.0; }

        title_rect := header->cut_top(46);
        title_ts := UI.default_text_settings();
        title_ts.size = 44;
        title_ts.color = c_text;
        title_ts.halign = .LEFT;
        title_ts.valign = .CENTER;
        title_ts.do_outline = true;
        title_ts.outline_thickness = 3;
        title_ts.outline_color = v4.{0, 0, 0, 1};
        UI.text(title_rect, title_ts, "VOTING");

        timer_rect := title_rect->cut_right(190);
        timer_ts := UI.default_text_settings();
        timer_ts.size = 26;
        timer_ts.color = c_warn;
        if remaining > 30.0 {
            timer_ts.color = c_text;
        } else if remaining > 10.0 {
            timer_ts.color = v4.{1, 0.85, 0.2, 1};
        }
        timer_ts.halign = .RIGHT;
        timer_ts.valign = .CENTER;
        timer_ts.do_outline = true;
        timer_ts.outline_thickness = 2;
        timer_ts.outline_color = v4.{0, 0, 0, 1};
        UI.text(timer_rect, timer_ts, format_string("%{.0}s", .{remaining}));

        // President info
        president: Player = null;
        for i: 0..players.elements.count-1 {
            p := players.elements[i];
            if p == null continue;
            if p.player_state != Player_State.ALIVE continue;
            if p.player_role == Player_Role.PRESIDENT {
                president = p;
                break;
            }
        }

        info_rect := header->cut_top(36);
        UI.quad(info_rect, white, v4.{0.08, 0.1, 0.14, 0.6});
        info_ts := UI.default_text_settings();
        info_ts.size = 20;
        info_ts.color = c_muted;
        info_ts.halign = .LEFT;
        info_ts.valign = .CENTER;
        info_ts.do_drop_shadow = true;
        info_ts.drop_shadow_offset = v2.{1, -1};
        info_ts.drop_shadow_color = v4.{0, 0, 0, 1};

        pres_name := "None";
        if president != null {
            pres_name = president.entity->get_name();
        }
        UI.text(info_rect->inset(10, 12, 10, 12), info_ts, format_string("President: %  (President votes are worth 2x)", .{pres_name}));

        // Calculate layout for player list
        alive_players: List(Player);
        for i: 0..players.elements.count-1 {
            if players.elements[i].player_state == Player_State.ALIVE {
                append(ref alive_players, players.elements[i]);
            }
        }

        // Count cast ballots + weighted votes for footer info (skip counts as a ballot)
        total_cast := 0;
        total_alive := 0;
        total_weight_cast := 0;
        for i: 0..players.elements.count-1 {
            p := players.elements[i];
            if p == null continue;
            if p.player_state != Player_State.ALIVE continue;
            total_alive += 1;
            if p.has_voted {
                total_cast += 1;
                if p.player_role == Player_Role.PRESIDENT {
                    total_weight_cast += 2;
                } else {
                    total_weight_cast += 1;
                }
            }
        }

        // Draw player entries (clean rows; click row to vote)
        list_rect := content;
        row_h := 56.0;

        row_bs := UI.default_button_settings();
        row_bs.sprite = row_sprite;
        row_bs.press_scaling = 0.98;

        for i: 0..alive_players.elements.count-1 {
            target_player := alive_players.elements[i];
            if target_player == null continue;

            row_rect := list_rect->cut_top(row_h);
            list_rect->cut_top(8.0); // spacing

            UI.push_id("vote_row_%", .{i});
            defer UI.pop_id();

            row_ts := UI.default_text_settings();
            row_ts.size = 26;
            row_ts.color = c_text;
            row_ts.halign = .LEFT;
            row_ts.valign = .CENTER;
            row_ts.do_drop_shadow = true;
            row_ts.drop_shadow_offset = v2.{1, -1};
            row_ts.drop_shadow_color = v4.{0, 0, 0, 1};

            btn := UI.begin_button(row_rect, row_bs, row_ts, ""); {
                defer UI.end_button();

                // Selected highlight
                if local_player.voted_for == target_player {
                    UI.quad(btn.rect, hightlight, v4.{c_accent.x, c_accent.y, c_accent.z, 0.18});
                }

                inner := btn.rect->inset(16, 14, 16, 14);
                right := inner->cut_right(140);

                // Name
                name_rect := inner;
                UI.text(name_rect, row_ts, target_player.entity->get_name());

                // Vote count pill
                pill := right->inset(6, 6, 6, 6);
                UI.quad(pill->grow_unscaled(2), white, v4.{0, 0, 0, 0.65});
                UI.quad(pill, white, v4.{0.08, 0.1, 0.14, 0.75});

                vote_ts := UI.default_text_settings();
                vote_ts.size = 22;
                vote_ts.color = v4.{1, 0.88, 0.25, 1};
                vote_ts.halign = .CENTER;
                vote_ts.valign = .CENTER;
                vote_ts.do_outline = true;
                vote_ts.outline_thickness = 2;
                vote_ts.outline_color = v4.{0, 0, 0, 1};
                UI.text(pill, vote_ts, format_string("Votes: %", .{target_player.votes_received}));

                // Checkbox icon at far right
                icon_rect := btn.rect->cut_right(44)->inset(10);
                if local_player.voted_for == target_player {
                    UI.quad(icon_rect->fit_aspect(check_on.aspect), check_on, v4.{1, 1, 1, 1});
                } else {
                    UI.quad(icon_rect->fit_aspect(check_off.aspect), check_off, v4.{1, 1, 1, 1});
                }
            }

            // Click handling (only allow voting for others, and only if you haven't voted)
            if btn.clicked && target_player != local_player && !local_player.has_voted {
                cast_vote(local_player, target_player);
            }
        }

        // Footer: cast status
        UI.quad(footer, white, v4.{0.06, 0.08, 0.11, 0.65});
        footer_inner := footer->inset(14);
        buttons_rect := footer_inner->cut_bottom(44.0);
        stats_rect := footer_inner;
        left := stats_rect->cut_left(260);

        foot_ts := UI.default_text_settings();
        foot_ts.size = 22;
        foot_ts.color = c_muted;
        foot_ts.halign = .LEFT;
        foot_ts.valign = .CENTER;
        UI.text(left, foot_ts, format_string("Ballots cast: %/%", .{total_cast, total_alive}));

        right := stats_rect;
        foot_ts.halign = .RIGHT;
        UI.text(right, foot_ts, format_string("Total vote weight: %", .{total_weight_cast}));

        // Buttons row: SKIP + CLOSE (centered)
        button_row := buttons_rect->center_rect()->grow(20.0, 200.0, 20.0, 200.0); // 40h, 400w
        skip_rect := button_row->cut_left(190.0);
        button_row->cut_left(20.0);
        close_rect := button_row;

        // Skip button (blank vote)
        skip_bs := UI.default_button_settings();
        skip_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png"); // blue
        skip_bs.press_scaling = 0.96;
        skip_ts := UI.default_text_settings();
        skip_ts.size = 22;
        skip_ts.color = v4.{1, 1, 1, 1};
        skip_ts.halign = .CENTER;
        skip_ts.valign = .CENTER;

        if local_player.voted_skip {
            UI.quad(skip_rect, hightlight, v4.{c_accent.x, c_accent.y, c_accent.z, 0.18});
        }

        UI.push_disabled(local_player.has_voted);
        if UI.button(skip_rect, skip_bs, skip_ts, "SKIP").clicked {
            cast_skip_vote(local_player);
        }
        UI.pop_disabled();

        // Close button (centered)
        close_bs := UI.default_button_settings();
        close_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png"); // red
        close_bs.press_scaling = 0.96;
        close_ts := UI.default_text_settings();
        close_ts.size = 22;
        close_ts.color = v4.{1, 1, 1, 1};
        close_ts.halign = .CENTER;
        close_ts.valign = .CENTER;
        if UI.button(close_rect, close_bs, close_ts, "CLOSE").clicked {
            instance.voting_ui_open = false;
        }
    }
}

shoot_projectile :: proc(spawn_position: v2, velocity: v2, damage: int, lifetime: float, owner: Entity) -> Entity {
    prefab := get_asset(Prefab_Asset, "prefabs/RR_Projectile.prefab");
    entity := Scene.instantiate(prefab);
    entity->set_local_position(spawn_position);

    projectile := entity->get_component(RR_Projectile);
    projectile.velocity = velocity;
    projectile.lifetime = lifetime;
    projectile.damage = damage;
    projectile.owner = owner;
    return entity;
}

Shoot_Ability :: class : Ability_Base {
    on_init :: proc(ability: Shoot_Ability) {
        ability.name = "Shoot";
        ability.disable_keybind = true;
        ability.is_aimed_ability = true;
    }

    get_icon :: proc(ability: Shoot_Ability, player_role: Player_Role) -> Texture_Asset {
        if player_role == Player_Role.PIRATE {
            return get_asset(Texture_Asset, "sprites/icons/pirate/flintlock_pistol.png");
        } else {
            return get_asset(Texture_Asset, "sprites/icons/revolver.png");
        }
        return null;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        activation := Ability_Utilities.full_update_aimed_ability(player, ref params);
        icon = get_icon(this, player.player_role);
        if params.can_use {
            if activation.activate {
                sfx := SFX.default_sfx_desc();
                sfx->set_position(player.entity.local_position);
                sfx.volume_perturb = 0.2;
                sfx.speed_perturb = 0.1;
                shoot_projectile(player.entity.world_position, activation.direction * 10.0, 1, 0.75, player.entity);
                SFX.play(get_asset(SFX_Asset, "sfx/shoot.wav"), sfx);
                current_cooldown = 30.0;
            }
        }
    }
}

// Black Flag - Pirate ability that creates a fog zone
BLACK_FLAG_RADIUS :: 5.0;
BLACK_FLAG_DURATION :: 30.0;

Black_Flag :: class : Component {
    owner_entity: Entity;
    spawn_time: float;
    switched_to_idle: bool;
    
    ao_start :: proc(using this: Black_Flag) {
        spawn_time = get_time();
        switched_to_idle = false;

        // Kick off the flag animation (if the entity has a spine animator)
        spine_anim := entity->get_component(Spine_Animator);
        if spine_anim != null {
            // Start with appear, then we'll switch to idle shortly after.
            spine_anim.instance->set_animation("appear", false, 0);
        }
    }
    
    ao_update :: proc(using this: Black_Flag, dt: float) {
        time_alive := get_time() - spawn_time;

        // Transition to idle after a short delay (the rig has "appear" and "idle").
        // We don't have a clean way to query animation duration here, so keep it simple.
        if !switched_to_idle && time_alive > 0.75 {
            spine_anim := entity->get_component(Spine_Animator);
            if spine_anim != null {
                spine_anim.instance->set_animation("idle", true, 0);
            }
            switched_to_idle = true;
        }
        
        // Destroy after duration
        if time_alive >= BLACK_FLAG_DURATION {
            destroy_entity(entity);
            return;
        }
        
        // Apply fog effect to nearby players (client-side rendering)
        foreach player: component_iterator(Player) {
            if player.player_state != Player_State.ALIVE continue;
            if !player->is_local_or_server() continue;
            
            distance := length(player.entity.world_position - entity.world_position);
            if distance < BLACK_FLAG_RADIUS {
                // Check if this player is immune (the Pirate who placed it)
                is_pirate_owner := #alive(owner_entity) && owner_entity == player.entity;
                
                if !is_pirate_owner {
                    // Draw fog overlay - obscures vision except small circle in center
                    draw_fog_overlay(player);
                }
            }
        }
    }
}

draw_fog_overlay :: proc(player: Player) {
    fog_texture := get_asset(Texture_Asset, "$AO/white.png");
    
    // Draw dark fog covering the entire screen
    UI.push_layer(1000);
    defer UI.pop_layer();
    
    fog_color := v4.{0, 0, 0, 0.9};
    
    screen := UI.get_screen_rect();
    UI.quad(screen, fog_texture, fog_color);
}

Black_Flag_Ability :: class : Ability_Base {
    NAME :: "Black Flag";
    
    on_init :: proc(ability: Black_Flag_Ability) {
        ability.icon = get_asset(Texture_Asset, "sprites/icons/pirate/black_flag.png");
    }
    
    can_use :: method() -> bool {
        return player.player_state == Player_State.ALIVE;
    }
    
    on_update :: method(params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            // Spawn prefab (includes the spine setup already)
            prefab := get_asset(Prefab_Asset, "prefabs/black_flag.prefab");
            flag_entity := Scene.instantiate(prefab);
            flag_entity->set_local_position(player.entity.local_position);

            // Ensure gameplay component exists (drives fog + appear->idle)
            flag: Black_Flag;
            flag = flag_entity->get_component(Black_Flag);
            if flag == null {
                flag = flag_entity->add_component(Black_Flag);
            }
            flag.owner_entity = player.entity;
            
            player->Notify("Black Flag placed!");
            current_cooldown = 60.0;
        }
    }
}

// --- Prankster ---
PRANK_DELAY_SECONDS :: 10.0;
PRANK_MELEE_RANGE :: 3.0;
PRANK_STUN_SECONDS :: 2.0;
PRANK_STUN_REASON :: "prank_slip";

Pranked_Effect :: class : Component {
	trigger_time: float;
	stun_end_time: float;
	phase: int; // 0 = waiting, 1 = stunning, 2 = done

	ao_start :: proc(using this: Pranked_Effect) {
		phase = 0;
	}

	arm :: proc(using this: Pranked_Effect, delay_seconds: float) {
		trigger_time = get_time() + delay_seconds;
		stun_end_time = 0.0;
		phase = 0;
	}

	ao_update :: method(dt: float) {
		p := entity->get_component(Player);
		if p == null {
			return;
		}

		// Safety: if gameplay ended or player is dead, ensure we don't leave them frozen.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p->remove_disable_movement_input_reason(PRANK_STUN_REASON);
			phase = 2;
			return;
		}

		if phase == 0 {
			if get_time() < trigger_time {
				return;
			}

			// Impact moment: notify, play anim (non-looping), and freeze movement for 2 seconds.
			p->Notify("you've been pranked!");
			p->set_trigger("prank_slip");
			p->add_disable_movement_input_reason(PRANK_STUN_REASON);
			stun_end_time = get_time() + PRANK_STUN_SECONDS;
			phase = 1;
			return;
		}

		if phase == 1 {
			if get_time() >= stun_end_time {
				p->remove_disable_movement_input_reason(PRANK_STUN_REASON);
				// Return to the normal locomotion tree after the one-shot.
				// NOTE: This assumes the player's anim state machine has a RESET trigger wired (it already does for revive).
				p->set_trigger("RESET");
				phase = 2;
			}
			return;
		}
	}
}

Prank_Ability :: class : Ability_Base {
	NAME :: "Prank";

	on_init :: proc(instance: Prank_Ability) {
		// Reuse an existing icon (no prank icon in the repo).
		instance.icon = get_asset(Texture_Asset, "sprites/icons/trickster/prank.png");
	}

	get_closest_prankable_player :: proc(instance: Prank_Ability, player: Player) -> Player {
		finder := make_finder(Player, player.entity.world_position, PRANK_MELEE_RANGE);
		for i: 0..players.elements.count-1 {
			target := players.elements[i];
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == player continue;
			if target.player_state != Player_State.ALIVE continue;
			finder->check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: proc(instance: Prank_Ability) -> bool {
		return instance->get_closest_prankable_player(instance.player) != null;
	}

	on_update :: proc(instance: Prank_Ability, params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			target := instance->get_closest_prankable_player(instance.player);
			if target == null {
				return;
			}

			// Count unique pranks toward the win condition
			instance.player.prankster_prank_count += 1;

			// Attach a delayed effect to the target so the message shows on THEIR client after 10s
			eff := target.entity->get_component(Pranked_Effect);
			if eff == null {
				eff = target.entity->add_component(Pranked_Effect);
			}
			eff->arm(PRANK_DELAY_SECONDS);

			instance.player->Notify(format_string("Pranked %!", .{target.entity->get_name()}));
			instance.current_cooldown = 15.0;
		}
	}
}

Fake_Meeting_Ability :: class : Ability_Base {
	NAME :: "Fake Meeting";

	on_init :: proc(instance: Fake_Meeting_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/trickster/call_fake.png");
	}

	can_use :: proc(instance: Fake_Meeting_Ability) -> bool {
		return game_state == Game_State.INGAME && instance.player.player_state == Player_State.ALIVE;
	}

	on_update :: proc(instance: Fake_Meeting_Ability, params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			start_fake_meeting(instance.player);
			instance.current_cooldown = 60.0;
		}
	}
}

JESTER_WIN_DELAY_SECONDS :: 15.0;
JESTER_WIN_CINEMATIC_TRIGGER :: "jester_win";

Jester_Win_Ability :: class : Ability_Base {
	NAME :: "Jester Win";

	on_init :: proc(instance: Jester_Win_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/trickster/jester.png");
	}

	can_use :: method() -> bool {
		// Must be alive in-game
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;

		// Locked until both objectives are complete (and unlock timer started)
		if player.prankster_jester_unlocked_time <= 0.0 return false;

		// Wait 15 seconds after unlocking
		return get_time() >= (player.prankster_jester_unlocked_time + JESTER_WIN_DELAY_SECONDS);
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Clicking early does nothing; button should be disabled by can_use.
		if params.clicked && params.can_use {
			// Start the cinematic; game will end after 5 seconds.
			start_jester_win_cinematic(player);
			// Put the ability on cooldown so it can't be spammed during the cinematic.
			current_cooldown = 9999.0;
		}
	}

	on_draw_button :: proc(instance: Jester_Win_Ability, rect: Rect) {
		// Draw countdown / lock state on top of the button.
		ts := UI.default_text_settings();
		ts.size = 20;
		ts.halign = .CENTER;
		ts.valign = .BOTTOM;

		player := instance.player;
		if player == null {
			return;
		}

		label := "";
		if player.prankster_jester_unlocked_time <= 0.0 {
			label = "LOCKED";
		} else {
			remaining := (player.prankster_jester_unlocked_time + JESTER_WIN_DELAY_SECONDS) - get_time();
			if remaining > 0.0 {
				label = format_string("%{.0}s", .{remaining});
			} else {
				label = "READY";
			}
		}
		UI.text(rect->inset(4), ts, label);
	}
}