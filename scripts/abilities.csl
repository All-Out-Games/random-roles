Werewolf_Devour_Ability :: class : Ability_Base {
	NAME :: "Devour";

	on_init :: proc(instance: Werewolf_Devour_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/werewolf/devour.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.WEREWOLF return false;
		wm := player.entity.get_component(Werewolf_Module);
		if wm == null return false;
		if !wm.is_wolf_form return false;
		return rr_werewolf_find_melee_target(player, WEREWOLF_DEVOUR_RANGE, true) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		if params.clicked && params.can_use {
			target := rr_werewolf_find_melee_target(player, WEREWOLF_DEVOUR_RANGE, true);
			if target != null {
				// Lock movement so the bite animation plays before control returns.
				lock := player.entity.get_component(Werewolf_Devour_Lock);
				if lock == null {
					lock = player.entity.add_component(Werewolf_Devour_Lock);
				}
				lock.arm(WEREWOLF_DEVOUR_LOCK_SECONDS);

				// Face the target and play bite animation.
				player.set_facing_right(target.entity.world_position.x > player.entity.world_position.x);
				player.set_trigger("werewolf_infection_bite");

				// Devour consumes the target entirely â€" no corpse left behind.
				target.kill_with_killer_no_corpse(player.entity.id);
				current_cooldown = WEREWOLF_DEVOUR_COOLDOWN_SECONDS;
			}
		}
	}

	on_draw_button :: proc(instance: Werewolf_Devour_Ability, rect: Rect) {
		draw_ability_name_label(rect, Werewolf_Devour_Ability.NAME);
	}
}

Werewolf_Infecting_Bite_Ability :: class : Ability_Base {
	NAME :: "Infect";

	on_init :: proc(instance: Werewolf_Infecting_Bite_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/werewolf/infecting_bite.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.WEREWOLF return false;
		// Usable in both human and wolf form.
		// Unlock after 1 kill.
		wm := player.entity.get_component(Werewolf_Module);
		if wm == null return false;
		if wm.kills < WEREWOLF_INFECT_UNLOCK_KILLS return false;
		return rr_werewolf_find_melee_target(player, WEREWOLF_INFECT_RANGE, true) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			wm2 := player.entity.get_component(Werewolf_Module);
			if player != null && player.player_role == Player_Role.WEREWOLF && wm2 != null && wm2.kills < WEREWOLF_INFECT_UNLOCK_KILLS {
				player.Notify(format_string("Infect locked: get %/% kills as Werewolf to unlock.", .{
					min(wm2.kills, WEREWOLF_INFECT_UNLOCK_KILLS),
					WEREWOLF_INFECT_UNLOCK_KILLS
				}));
			}
		}

		if params.clicked && params.can_use {
			target := rr_werewolf_find_melee_target(player, WEREWOLF_INFECT_RANGE, true);
			if target != null {
				rr_werewolf_apply_infection(player, target);
				current_cooldown = WEREWOLF_INFECT_COOLDOWN_SECONDS;
			}
		}
	}

	on_draw_button :: proc(instance: Werewolf_Infecting_Bite_Ability, rect: Rect) {
		draw_ability_name_label(rect, Werewolf_Infecting_Bite_Ability.NAME);

		// Locked overlay (shown until unlocked).
		p := instance.player;
		pwm := p.entity.get_component(Werewolf_Module);
		if p != null && p.player_role == Player_Role.WEREWOLF && pwm != null && pwm.kills < WEREWOLF_INFECT_UNLOCK_KILLS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");
		}
	}
}

Werewolf_Claw_Slash_Ability :: class : Ability_Base {
	NAME :: "Claw";

	on_init :: proc(instance: Werewolf_Claw_Slash_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/werewolf/claw_slash.png");
		instance.disable_keybind = true;
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.WEREWOLF return false;
		wm := player.entity.get_component(Werewolf_Module);
		if wm == null return false;
		if !wm.is_wolf_form return false;
		// Unlock after 2 kills.
		if wm.kills < WEREWOLF_CLAW_UNLOCK_KILLS return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			wm2 := player.entity.get_component(Werewolf_Module);
			if player != null && player.player_role == Player_Role.WEREWOLF && wm2 != null && wm2.kills < WEREWOLF_CLAW_UNLOCK_KILLS {
				player.Notify(format_string("Claw locked: get %/% kills as Werewolf to unlock.", .{
					min(wm2.kills, WEREWOLF_CLAW_UNLOCK_KILLS),
					WEREWOLF_CLAW_UNLOCK_KILLS
				}));
			}
		}

		activation := Ability_Utilities.full_update_aimed_ability(player, ref params);
		if params.can_use && activation.activate {
			p := shoot_projectile(player.entity.world_position, activation.direction * WEREWOLF_CLAW_PROJECTILE_SPEED, 1, WEREWOLF_CLAW_PROJECTILE_LIFETIME, player.entity);
			// Slightly bigger hit radius for a "slash" feel.
			if p != null {
				proj := p.get_component(RR_Projectile);
				if proj != null {
					proj.hit_radius = 0.65;
				}
			}
			current_cooldown = WEREWOLF_CLAW_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: Werewolf_Claw_Slash_Ability, rect: Rect) {
		draw_ability_name_label(rect, Werewolf_Claw_Slash_Ability.NAME);

		// Locked overlay (shown while in wolf form until unlocked).
		p := instance.player;
		pwm := p.entity.get_component(Werewolf_Module);
		if p != null && p.player_role == Player_Role.WEREWOLF && pwm != null && pwm.kills < WEREWOLF_CLAW_UNLOCK_KILLS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");
		}
	}
}

Werewolf_Pass_Bite_Ability :: class : Ability_Base {
	NAME :: "Infect";

	on_init :: proc(instance: Werewolf_Pass_Bite_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/werewolf/infecting_bite.png");
	}

	get_closest_pass_target :: proc(instance: Werewolf_Pass_Bite_Ability, biter: Player) -> Player {
		if biter == null return null;
		finder := make_finder(Player, biter.entity.world_position, WEREWOLF_PASS_BITE_RANGE);
		for i: 0..players.elements.count-1 {
			target := players.elements[i];
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == biter continue;
			if target.player_state != Player_State.ALIVE continue;
			if target.player_role == Player_Role.WEREWOLF continue; // exclude werewolf(s)
			finder.check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if !player.werewolf_infected return false;
		return get_closest_pass_target(this, player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			target := get_closest_pass_target(this, player);
			if target != null {
				rr_werewolf_pass_infection(player, target);
				// No cooldown; the constraint is being infected + needing a nearby target.
				current_cooldown = 0.0;
			}
		}
	}

	on_draw_button :: proc(instance: Werewolf_Pass_Bite_Ability, rect: Rect) {
		draw_ability_name_label(rect, Werewolf_Pass_Bite_Ability.NAME);
	}
}

Werewolf_Transform_Ability :: class : Ability_Base {
	NAME :: "Transform";

	on_init :: proc(instance: Werewolf_Transform_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.WEREWOLF return false;
		// Usable in both forms: transform into wolf OR revert back to schleem.
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			wm := player.entity.get_component(Werewolf_Module);
			if wm == null return;
			if wm.is_wolf_form {
				// Revert to schleem form early.
				wm.is_wolf_form = false;
				wm.transform_ends_at = 0.0;
				player.set_trigger("RESET");
				player.werewolf_skin_enable_at = 0.0;
				player.werewolf_skin_disable_at = get_time();

				// Cooldown starts now (full post-transform cooldown).
				current_cooldown = WEREWOLF_TRANSFORM_COOLDOWN_SECONDS;
			} else {
				// Activate wolf form.
				wm.is_wolf_form = true;
				wm.transform_ends_at = get_time() + WEREWOLF_TRANSFORM_MAX_DURATION_SECONDS;

				// Howl animation.
				player.set_trigger("werewolf_howl");

				// Server-authoritative SFX (replicated to all clients).
				if Game.is_server() {
					sfx := SFX.default_sfx_desc();
					sfx.set_position(player.entity.world_position);
					sfx.volume = 0.9;
					sfx.volume_perturb = 0.05;
					sfx.speed_perturb = 0.05;
					// Global SFX mix: everything at 25% volume.
					sfx.volume *= 0.25;
					sfx.volume_perturb *= 0.25;
					rr_play_sfx("sfx/killer_transform.wav", sfx);
				}

				// Enable werewolf skin halfway through the howl.
				player.werewolf_skin_enable_at = get_time() + WEREWOLF_TRANSFORM_HOWL_SKIN_DELAY;
				player.werewolf_skin_disable_at = 0.0;

				// No cooldown while in wolf form â€" the button stays active to allow reverting.
				current_cooldown = 0.0;
			}
		}
	}

	on_draw_button :: proc(instance: Werewolf_Transform_Ability, rect: Rect) {
		p := instance.player;
		pwm := p.entity.get_component(Werewolf_Module);
		if p != null && pwm != null && pwm.is_wolf_form {
			// Swap icon to "transform back" while in wolf form.
			instance.icon = get_asset(Texture_Asset, "sprites/icons/transform_good.png");
			// Show remaining wolf form time as the label.
			remaining := pwm.transform_ends_at - get_time();
			if remaining < 0.0 { remaining = 0.0; }
			remaining_s := (remaining + 0.999).(int);
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .BOTTOM;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			ts.color = v4.{1.0, 0.25, 0.25, 1.0};
			UI.text(rect.inset(2).cut_bottom(20), ts, format_string("WOLF %s", .{remaining_s}));
		} else {
			// Swap icon back to "transform to wolf" while in schleem form.
			instance.icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png");
			draw_ability_name_label(rect, Werewolf_Transform_Ability.NAME);
		}
	}
}

Hitman_Mine_Stun :: class : Component {
	stun_end_time: float;
	active: bool;

	arm :: proc(using this: Hitman_Mine_Stun, seconds: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		stun_end_time = get_time() + seconds;
		active = true;

		p := entity.get_component(Player);
		if p != null {
			p.add_disable_movement_input_reason(HITMAN_MINE_STUN_REASON);
			p.set_trigger("hitman_broken_leg_idle");
		}
	}

	ao_update :: proc(using this: Hitman_Mine_Stun, dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(HITMAN_MINE_STUN_REASON);
			// Ensure we leave the broken-leg loop when the stun ends early.
			p.set_trigger("RESET");
			active = false;
			return;
		}

		if get_time() >= stun_end_time {
			p.remove_disable_movement_input_reason(HITMAN_MINE_STUN_REASON);
			// Stop broken-leg idle when stun ends.
			p.set_trigger("RESET");
			active = false;
		}
	}
}

Hitman_Neck_Snap_Lock :: class : Component {
	active: bool;
	end_time: float;

	arm :: proc(using this: Hitman_Neck_Snap_Lock, seconds: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		active = true;

		p := entity.get_component(Player);
		if p != null {
			p.add_disable_movement_input_reason(HITMAN_NECK_SNAP_LOCK_REASON);
		}
	}

	ao_update :: proc(using this: Hitman_Neck_Snap_Lock, dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(HITMAN_NECK_SNAP_LOCK_REASON);
			p.set_trigger("RESET");
			active = false;
			return;
		}

		if get_time() >= end_time {
			p.remove_disable_movement_input_reason(HITMAN_NECK_SNAP_LOCK_REASON);
			p.set_trigger("RESET");
			active = false;
		}
	}
}

Hitman_Mine_Fling :: class : Component {
	active: bool;
	end_time: float;
	dir: v2;
	last_pos: v2;
	stuck_frames: int;

	arm :: proc(using this: Hitman_Mine_Fling, seconds: float, direction: v2, speed: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		active = true;
		dir = direction;
		last_pos = entity.world_position;
		stuck_frames = 0;

		p := entity.get_component(Player);
		if p != null {
			p.add_disable_movement_input_reason(HITMAN_MINE_FLING_REASON);
			p.set_facing_right(dir.x > 0);
			p.set_trigger("hitman_fly_forward");
			p.agent.velocity = dir * speed;
		}
	}

	ao_update :: proc(using this: Hitman_Mine_Fling, dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(HITMAN_MINE_FLING_REASON);
			active = false;
			return;
		}

		// Keep pushing until collision or timeout.
		p.agent.velocity = dir * HITMAN_MINE_FLING_SPEED;

		pos := entity.world_position;
		moved := length(pos - last_pos);
		last_pos = pos;

		// If we aren't moving meaningfully for a few frames, treat as collision.
		if moved < 0.01 {
			stuck_frames += 1;
		} else {
			stuck_frames = 0;
		}

		collided := stuck_frames >= 3;
		if collided || get_time() >= end_time {
			p.remove_disable_movement_input_reason(HITMAN_MINE_FLING_REASON);
			p.set_trigger("hitman_collide_midair_land");

			stun := entity.get_component(Hitman_Mine_Stun);
			if stun == null {
				stun = entity.add_component(Hitman_Mine_Stun);
			}
			stun.arm(HITMAN_MINE_STUN_SECONDS);

			active = false;
		}
	}
}

Hitman_Sniper_Camera_Zoom :: class : Component {
	active: bool;
	end_time: float;
	orig_size: float;

	arm :: proc(using this: Hitman_Sniper_Camera_Zoom, duration: float) {
		if duration <= 0.0 { duration = 0.1; }
		end_time = get_time() + duration;
		active = true;

		p := entity.get_component(Player);
		if p != null && p.is_local() {
			orig_size = p.camera.size;
			p.camera.size = HITMAN_SNIPER_CAMERA_ZOOMED_OUT_SIZE;
		}
	}

	ao_update :: proc(using this: Hitman_Sniper_Camera_Zoom, dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		if get_time() >= end_time {
			if p.is_local() {
				p.camera.size = orig_size;
			}
			active = false;
		}
	}
}

Hitman_Neck_Snap_Ability :: class : Ability_Base {
	NAME :: "Neck Snap";

	on_init :: proc(instance: Hitman_Neck_Snap_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/hitman/knee_snap.png");
	}

	get_closest_alive_target :: proc(instance: Hitman_Neck_Snap_Ability, player: Player) -> Player {
		finder := make_finder(Player, player.entity.world_position, HITMAN_NECK_SNAP_RANGE);
		for i: 0..players.elements.count-1 {
			target := players.elements[i];
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == player continue;
			if target.player_state != Player_State.ALIVE continue;

			// No friendly-fire on traitors.
			if player.player_type == Player_Type.TRAITOR && target.player_type == Player_Type.TRAITOR {
				continue;
			}

			finder.check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.HITMAN return false;
		return get_closest_alive_target(this, player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// Apply any contract-based cooldown adjustments (from kills via other methods).
		hm := player.entity.get_component(Hitman_Module);
		if player != null && player.player_role == Player_Role.HITMAN && hm != null && hm.kill_cooldown_adjust_seconds != 0.0 {
			current_cooldown = max(0.0, current_cooldown + hm.kill_cooldown_adjust_seconds);
			hm.kill_cooldown_adjust_seconds = 0.0;
		}

		if params.clicked && params.can_use {
			target := get_closest_alive_target(this, player);
			if target != null {
				// Lock movement so the animation completes before control returns.
				lock := player.entity.get_component(Hitman_Neck_Snap_Lock);
				if lock == null {
					lock = player.entity.add_component(Hitman_Neck_Snap_Lock);
				}
				lock.arm(HITMAN_NECK_SNAP_LOCK_SECONDS);

				if hm != null hm.last_kill_style = Hitman_Kill_Style.NECK_SNAP;
				player.set_facing_right(target.entity.world_position.x > player.entity.world_position.x);
				player.set_trigger("hitman_kill_snap_neck");
				target.kill_with_killer(player.entity.id);

				// Hitman strangle/neck-snap kill SFX (server-authoritative; replicates to clients).
				if Game.is_server() {
					sfx := SFX.default_sfx_desc();
					sfx.set_position(target.entity.world_position);
					sfx.volume = 0.9;
					sfx.volume_perturb = 0.08;
					sfx.speed_perturb = 0.06;
					// Global SFX mix: everything at 25% volume.
					sfx.volume *= 0.25;
					sfx.volume_perturb *= 0.25;
					rr_play_sfx("sfx/traitor_kill_death.wav", sfx);
				}

				current_cooldown = HITMAN_NECK_SNAP_COOLDOWN_SECONDS;
			}
		}
	}

	on_draw_button :: proc(instance: Hitman_Neck_Snap_Ability, rect: Rect) {
		draw_ability_name_label(rect, Hitman_Neck_Snap_Ability.NAME);
	}
}

Hitman_Mine_Ability :: class : Ability_Base {
	NAME :: "Mine";
	was_targeting: bool;

	on_init :: proc(instance: Hitman_Mine_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/hitman/land_mine.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.HITMAN return false;
		// Unlock after 1 kill.
		hm := player.entity.get_component(Hitman_Module);
		if hm == null return false;
		if hm.kills < HITMAN_MINE_UNLOCK_KILLS return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting / round-start lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			hm := player.entity.get_component(Hitman_Module);
			if player != null && player.player_role == Player_Role.HITMAN && hm != null && hm.kills < HITMAN_MINE_UNLOCK_KILLS {
				player.Notify(format_string("Mine locked: get %/% kills as Hitman to unlock.", .{
					min(hm.kills, HITMAN_MINE_UNLOCK_KILLS),
					HITMAN_MINE_UNLOCK_KILLS
				}));
			}
		}

		// Click-to-target: enter targeting mode, then click to place at cursor.
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;

		// Prevent targeting mode while on cooldown / otherwise unusable.
		if targeting && !params.can_use {
			player.active_ability = null;
			was_targeting = false;
			return;
		}

		if !targeting {
			was_targeting = false;
			return;
		}

		was_targeting = true;

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel {
			player.active_ability = null;
			was_targeting = false;
			return;
		}

		target_pos := get_mouse_world_position();
		if player.is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			UI.quad(Rect{target_pos, target_pos}.grow(0.10, 0.10, 0.10, 0.10), core_globals.white_sprite, v4.{1, 0.4, 0.1, 0.9});
		}

		if aiming.activate && params.can_use {
			rr_hitman_place_mine(player, target_pos);
			current_cooldown = HITMAN_MINE_COOLDOWN_SECONDS;
			player.active_ability = null;
			was_targeting = false;
		}
	}

	on_draw_button :: proc(instance: Hitman_Mine_Ability, rect: Rect) {
		draw_ability_name_label(rect, Hitman_Mine_Ability.NAME);

		// Locked overlay (still show button for learnability).
		p := instance.player;
		hm := p.entity.get_component(Hitman_Module);
		if p != null && p.player_role == Player_Role.HITMAN && hm != null && hm.kills < HITMAN_MINE_UNLOCK_KILLS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");
		}
	}
}

Hitman_Sniper_Ability :: class : Ability_Base {
	NAME :: "Sniper";

	camera_zoom_active: bool;
	camera_original_size: float;
	was_targeting: bool;
	activated_this_session: bool;

	on_init :: proc(instance: Hitman_Sniper_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/hitman/sniper_rifle.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.HITMAN return false;
		// Unlock after 2 kills.
		hm := player.entity.get_component(Hitman_Module);
		if hm == null return false;
		if hm.kills < HITMAN_SNIPER_UNLOCK_KILLS return false;
		// Needs a valid contract target to snipe.
		if hm.contract_target_id == 0 return false;
		return true;
	}

	set_camera_zoom :: proc(using this: Hitman_Sniper_Ability, active: bool) {
		// Only the local player has a camera, so guard with is_local_or_server (same as other camera tweaks).
		if !player.is_local_or_server() {
			return;
		}
		if active {
			if !camera_zoom_active {
				camera_original_size = player.camera.size;
				player.camera.size = HITMAN_SNIPER_CAMERA_ZOOMED_OUT_SIZE;
				camera_zoom_active = true;
			}
		} else {
			if camera_zoom_active {
				player.camera.size = camera_original_size;
				camera_zoom_active = false;
			}
		}
	}

	cleanup_targeting :: proc(using this: Hitman_Sniper_Ability) {
		this.set_camera_zoom(false);
		was_targeting = false;
		activated_this_session = false;
	}

	get_closest_alive_target_at_point :: proc(instance: Hitman_Sniper_Ability, shooter: Player, point: v2, range: float) -> Player {
		best: Player = null;
		best_dist_sq := 0.0;
		r_sq := range * range;

		for i: 0..players.elements.count-1 {
			p := players.elements[i];
			if p == null continue;
			if !#alive(p.entity) continue;
			if p == shooter continue;
			if p.player_state != Player_State.ALIVE continue;

			// Prevent traitor friendly-fire (consistent with Kill/Neck Snap).
			if shooter.player_type == Player_Type.TRAITOR && p.player_type == Player_Type.TRAITOR {
				continue;
			}

			d := p.entity.world_position - point;
			dist_sq := length_squared(d);
			if dist_sq > r_sq continue;

			if best == null || dist_sq < best_dist_sq {
				best = p;
				best_dist_sq = dist_sq;
			}
		}
		return best;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			hm := player.entity.get_component(Hitman_Module);
			if player != null && player.player_role == Player_Role.HITMAN && hm != null && hm.kills < HITMAN_SNIPER_UNLOCK_KILLS {
				player.Notify(format_string("Sniper locked: get %/% kills as Hitman to unlock.", .{
					min(hm.kills, HITMAN_SNIPER_UNLOCK_KILLS),
					HITMAN_SNIPER_UNLOCK_KILLS
				}));
			}
		}

		// Use the standard targeted-aimed helper for PC + mobile compatibility.
		// PC: click button -> aim mode -> click to fire (right-click cancel).
		// Mobile: press-drag-release to aim and fire.
		activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);

		// Camera zoom while targeting (the helper sets player.active_ability during aim mode).
		targeting := player.active_ability != null;
		this.set_camera_zoom(targeting);

		// Reset tracking state when not targeting.
		if !targeting {
			activated_this_session = false;
		}

		// Crosshair on cursor/touch point (local visual).
		if targeting && player.is_local() {
			target_pos := get_mouse_world_position();
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			reticle := get_asset(Texture_Asset, RETICLE_TEXTURE_PATH);
			reticle_rect := Rect{target_pos, target_pos}.grow(0.44, 0.44, 0.44, 0.44);
			UI.quad(reticle_rect.fit_aspect(reticle.get_aspect()), reticle, v4.{1, 1, 1, 0.95});
		}

		if activated_this_session {
			return;
		}

		if activation.activate {
			activated_this_session = true;

			// Pick target under cursor/touch point (global snipe).
			target_pos := get_mouse_world_position();
			target := get_closest_alive_target_at_point(this, player, target_pos, HITMAN_SNIPER_TARGET_PICKUP_RADIUS);
			if target == null {
				// Missed - allow retrying.
				activated_this_session = false;
				return;
			}

			hm := player.entity.get_component(Hitman_Module);
			if hm != null hm.last_kill_style = Hitman_Kill_Style.SNIPER;
			player.set_facing_right(target.entity.world_position.x > player.entity.world_position.x);
			player.set_trigger("hitman_shoot_sniper");
			target.kill_with_killer(player.entity.id);
			current_cooldown = HITMAN_SNIPER_COOLDOWN_SECONDS;

			this.set_camera_zoom(false);
			activated_this_session = false;
		}
	}

	on_draw_button :: proc(instance: Hitman_Sniper_Ability, rect: Rect) {
		draw_ability_name_label(rect, Hitman_Sniper_Ability.NAME);

		// Locked overlay (still show button for learnability).
		p := instance.player;
		hm := p.entity.get_component(Hitman_Module);
		if p != null && p.player_role == Player_Role.HITMAN && hm != null && hm.kills < HITMAN_SNIPER_UNLOCK_KILLS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");
		}
	}
}

rr_force_reset_hitman_sniper_zoom :: proc(player: Player) {
	if player == null return;

	for i: 0..player.abilities.count-1 {
		ability := player.abilities[i];
		if ability == null continue;

		if ability.#type == Hitman_Sniper_Ability {
			sniper := ability.(Hitman_Sniper_Ability);
			sniper.cleanup_targeting();
		}
	}

	if player.active_ability != null && player.active_ability.#type == Hitman_Sniper_Ability {
		player.active_ability = null;
	}
}

Resurrect_Ability :: class : Ability_Base {
    NAME :: "Resurrect";

    on_init :: proc(instance: Resurrect_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/doctor/revive.png");
    }

    get_closest_resurrectable_corpse :: proc(instance: Resurrect_Ability, doctor: Player) -> Corpse {
        finder := make_finder(Corpse, doctor.entity.world_position, 5.0);
        for corpse: component_iterator(Corpse) {
            // Corpse must belong to a currently-dead player.
            target := get_player_by_entity_id(corpse.owner_player_entity_id);
            if target == null continue;
            if target.player_state != Player_State.DEAD continue;
            finder.check(corpse, corpse.entity.world_position);
        }
        return finder.closest;
    }

    get_closest_spew_victim :: proc(instance: Resurrect_Ability, doctor: Player) -> Player {
        finder := make_finder(Player, doctor.entity.world_position, 5.0);
        for p: component_iterator(Player) {
            if p == null continue;
            if p.entity.id == doctor.entity.id continue;
            if p.player_state != Player_State.ALIVE continue;
            has_spew := p.mimicer_blinded || p.mimicer_distorted_until > 0.0;
            has_cocoon := p.bc_cocooned;
            if !has_spew && !has_cocoon && !rr_lily_is_player_strung_by_any(p) continue;
            finder.check(p, p.entity.world_position);
        }
        return finder.closest;
    }

    can_use :: method() -> bool {
        if game_state != Game_State.INGAME return false;
        if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
        if !rr_player_has_civilian_power(player, Player_Role.DOCTOR) return false;
        dm := player.entity.get_component(Doctor_Module);
        if dm == null return false;
        if dm.resurrects_used >= DOCTOR_RESURRECTS_PER_ROUND return false;
        if get_closest_resurrectable_corpse(this, player) != null return true;
        // Also usable to cure Spew Corruption on nearby alive players.
        if get_closest_spew_victim(this, player) != null return true;
        return false;
    }

    on_update :: proc(instance: Resurrect_Ability, params: ref Ability_Update_Params) {
        if params.clicked && params.can_use {
            corpse := instance.get_closest_resurrectable_corpse(instance.player);
            if corpse == null {
                // No corpse — try curing a nearby Spew/Trample victim instead.
                spew_victim := instance.get_closest_spew_victim(instance.player);
                if spew_victim != null {
                    if spew_victim.mimicer_blinded || spew_victim.mimicer_distorted_until > 0.0 {
                        rr_mimicer_cure_spew(spew_victim);
                        instance.player.Notify(format_string("Cured %!", .{spew_victim.entity.get_name()}));
                        spew_victim.Notify("The Doctor cured your corruption!");
                    }
                    if spew_victim.bc_cocooned {
                        // Doctor heals an unhardened cocoon, freeing the victim.
                        co := spew_victim.bc_cocoon_entity;
                        if co != null && #alive(co) {
                            cocoon := co.get_component(BC_Flesh_Cocoon);
                            if cocoon != null && !cocoon.hardened {
                                rr_bc_release_cocoon_victim(cocoon);
                                cocoon.pending_destroy = true;
                                cocoon.destroy_at = get_time() + 0.4;
                            }
                        }
                        instance.player.Notify(format_string("Freed %!", .{spew_victim.entity.get_name()}));
                        spew_victim.Notify("The Doctor cut you free of the cocoon!");
                    }
                    if rr_lily_is_player_strung_by_any(spew_victim) {
                        rr_lily_on_doctor_heal(spew_victim);
                        instance.player.Notify(format_string("Cut strings on %!", .{spew_victim.entity.get_name()}));
                        spew_victim.Notify("The Doctor freed you from Lily's strings!");
                    }
                    instance.current_cooldown = 1.0;
                }
                return;
            }

            target := get_player_by_entity_id(corpse.owner_player_entity_id);
            if target == null return;
            if target.player_state != Player_State.DEAD return;

            revive_pos := corpse.entity.world_position;

            // Consume a use.
            dm := instance.player.entity.get_component(Doctor_Module);
            if dm != null {
                dm.resurrects_used += 1;
            }

            // Remove the body (they "stand up").
            if #alive(corpse.entity) {
                corpse.entity.destroy();
            }

            // Revive at the corpse position — permanent revive.
            target.entity.set_local_position(revive_pos);
            on_player_go_alive(target);

            // Feedback
            dm_uses := 0;
            if dm != null { dm_uses = dm.resurrects_used; }
            instance.player.Notify(format_string("Resurrected %! (%/% used)", .{
                target.entity.get_name(),
                dm_uses,
                DOCTOR_RESURRECTS_PER_ROUND
            }));
            target.Notify("The Doctor resurrected you!");

            instance.current_cooldown = DOCTOR_RESURRECT_COOLDOWN_SECONDS;
        }
    }

    on_draw_button :: proc(instance: Resurrect_Ability, rect: Rect) {
        player := instance.player;
        if player == null return;
        if !rr_player_has_civilian_power(player, Player_Role.DOCTOR) return;

		draw_ability_name_label(rect, Resurrect_Ability.NAME);

        ts := UI.default_text_settings();
        ts.size = 18;
        ts.halign = .CENTER;
        ts.valign = .TOP;
        dm := player.entity.get_component(Doctor_Module);
        used := 0;
        if dm != null { used = dm.resurrects_used; }
        remaining := DOCTOR_RESURRECTS_PER_ROUND - used;
        if remaining < 0 { remaining = 0; }
        UI.text(rect.inset(2).cut_top(20), ts, format_string("%/%", .{remaining, DOCTOR_RESURRECTS_PER_ROUND}));
    }
}

// --- Coroner ---
CORONER_DNA_SAMPLE_RANGE :: 5.0;
CORONER_DNA_MATCH_RANGE  :: 5.0;
CORONER_DNA_MATCH_VIAL_DISPLAY_SECONDS :: 2.0;

Coroner_DNA_Vial_Display :: class : Component {
	active: bool;
	start_time: float;
	end_time: float;
	color: v4;

	vial_tex: Texture_Asset;
	glow_tex: Texture_Asset;

	arm :: proc(using this: Coroner_DNA_Vial_Display, glow_color: v4) {
		active = true;
		color = glow_color;
		start_time = get_time();
		end_time = start_time + CORONER_DNA_MATCH_VIAL_DISPLAY_SECONDS;

		// Lazy-load textures
		if vial_tex == null {
			vial_tex = get_asset(Texture_Asset, "sprites/icons/coroner/dna_vial.png");
		}
		if glow_tex == null {
			glow_tex = get_asset(Texture_Asset, "sprites/icons/coroner/dna_glow.png");
		}
	}

	ao_late_update :: proc(using this: Coroner_DNA_Vial_Display, dt: float) {
		if !active {
			return;
		}

		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Cosmetic only: only show to the coroner's local client.
		if !p.is_local() {
			return;
		}

		// Safety: don't render outside gameplay / while dead.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			active = false;
			return;
		}

		now := get_time();
		if now >= end_time {
			active = false;
			return;
		}

		t01 := clamp((now - start_time) / 0.35, 0.0, 1.0);
		t := Ease.out_back(t01);

		base := entity.world_position;
		// "Moves above the coroner's head"
		y_off := lerp(0.6, 1.55, t);
		pos := base + v2.{0, y_off};

		UI.push_world_draw_context();
		defer UI.pop_draw_context();
		UI.push_z(pos.y);
		defer UI.pop_z();

		// World-space sizing (meters)
		size := 0.22;
		rect := Rect{pos, pos}.grow(size, size, size, size);

		// Vial first
		UI.quad(rect.fit_aspect(vial_tex.get_aspect()), vial_tex, v4.{1, 1, 1, 1});

		// Glow on top of the vial
		glow_alpha := clamp(1.0 - ((now - start_time) / CORONER_DNA_MATCH_VIAL_DISPLAY_SECONDS) * 0.1, 0.0, 1.0);
		glow_col := color;
		glow_col.w = glow_col.w * glow_alpha;
		UI.quad(rect.grow(0.10).fit_aspect(glow_tex.get_aspect()), glow_tex, glow_col);
	}
}

DNA_Sample_Ability :: class : Ability_Base {
	NAME :: "DNA Sample";

	on_init :: proc(instance: DNA_Sample_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/coroner/ability_take_dna.png");
	}

	get_closest_sampleable_corpse :: proc(instance: DNA_Sample_Ability, coroner: Player) -> Corpse {
		finder := make_finder(Corpse, coroner.entity.world_position, CORONER_DNA_SAMPLE_RANGE);
		for corpse: component_iterator(Corpse) {
			if corpse.has_been_reported continue;
			if corpse.has_dna_been_sampled continue;
			if corpse.ggg_is_wrapped continue;
			// Only corpses with known player killers yield a vial.
			if corpse.killer_player_entity_id == 0 continue;
			finder.check(corpse, corpse.entity.world_position);
		}
		return finder.closest;
	}

	get_closest_sampleable_nest :: proc(instance: DNA_Sample_Ability, coroner: Player) -> GGG_Nest {
		best: GGG_Nest = null;
		best_dist_sq := 0.0;
		r_sq := CORONER_DNA_SAMPLE_RANGE * CORONER_DNA_SAMPLE_RANGE;
		for nest: component_iterator(GGG_Nest) {
			if nest == null continue;
			if nest.destroyed continue;
			if nest.entity == null || !#alive(nest.entity) continue;
			d := nest.entity.world_position - coroner.entity.world_position;
			dist_sq := length_squared(d);
			if dist_sq > r_sq continue;
			if best == null || dist_sq < best_dist_sq {
				best = nest;
				best_dist_sq = dist_sq;
			}
		}
		return best;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if !rr_player_has_civilian_power(player, Player_Role.CORONER) return false;
		if get_closest_sampleable_corpse(this, player) != null return true;
		if get_closest_sampleable_nest(this, player) != null return true;
		return false;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			// Prefer corpse over nest
			corpse := get_closest_sampleable_corpse(this, player);
			if corpse != null {
				corpse.has_dna_been_sampled = true;
				cm := player.entity.get_component(Coroner_Module);
				if cm != null {
					cm.dna_vials.append(corpse.killer_player_entity_id);
				}
				current_cooldown = 1.0;
				return;
			}

			// Investigate nest: get DNA from owner + notify body count
			nest := get_closest_sampleable_nest(this, player);
			if nest != null {
				cm := player.entity.get_component(Coroner_Module);
				if cm != null && nest.owner_player_entity_id != 0 {
					cm.dna_vials.append(nest.owner_player_entity_id);
				}
				player.Notify(format_string("Nest has consumed % bodies.", {nest.bodies_consumed}));
				current_cooldown = 1.0;
				return;
			}
		}
	}

	on_draw_button :: proc(instance: DNA_Sample_Ability, rect: Rect) {
		draw_ability_name_label(rect, DNA_Sample_Ability.NAME);
	}
}

DNA_Match_Ability :: class : Ability_Base {
	NAME :: "DNA Match";

	on_init :: proc(instance: DNA_Match_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/coroner/ability_compare_dna.png");
	}

	get_closest_alive_other_player :: proc(instance: DNA_Match_Ability, coroner: Player) -> Player {
		finder := make_finder(Player, coroner.entity.world_position, CORONER_DNA_MATCH_RANGE);
		for i: 0..players.elements.count-1 {
			target := players.elements[i];
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == coroner continue;
			if target.player_state != Player_State.ALIVE continue;
			finder.check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if !rr_player_has_civilian_power(player, Player_Role.CORONER) return false;
		cm := player.entity.get_component(Coroner_Module);
		if cm == null return false;
		if cm.dna_vials.count <= 0 return false;
		return get_closest_alive_other_player(this, player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			target := get_closest_alive_other_player(this, player);
			if target == null return;

			cm := player.entity.get_component(Coroner_Module);
			if cm == null return;
			killer_id := cm.dna_vials.pop();
			is_match := target.entity.id == killer_id;

			// Show vial feedback above the coroner's head.
			display := player.entity.get_component(Coroner_DNA_Vial_Display);
			if display == null {
				display = player.entity.add_component(Coroner_DNA_Vial_Display);
			}

			if is_match {
				display.arm(v4.{0.2, 1.0, 0.4, 0.95}); // green
				player.Notify(format_string("DNA MATCH: %", .{target.entity.get_name()}));
			} else {
				display.arm(v4.{1.0, 0.2, 0.2, 0.95}); // red
				player.Notify("No match.");
			}

			current_cooldown = 1.0;
		}
	}

	on_draw_button :: proc(instance: DNA_Match_Ability, rect: Rect) {
		draw_ability_name_label(rect, DNA_Match_Ability.NAME);
	}
}

Vote_Ability :: class : Ability_Base {
    NAME :: "Vote";
    voting_ui_open: bool;
    show_recent_deaths: bool;
    last_voting_start_time_seen: float;
	recent_deaths_open_time: float;

    on_init :: proc(instance: Vote_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/report_ability.png");
        instance.voting_ui_open = false;
        instance.show_recent_deaths = false;
        instance.last_voting_start_time_seen = 0.0;
		instance.recent_deaths_open_time = 0.0;
    }

    can_use :: method() -> bool {
        return game_state == Game_State.VOTING && player.player_state == Player_State.ALIVE;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        // Leave voting: close any meeting UI state.
        if game_state != Game_State.VOTING {
            voting_ui_open = false;
            show_recent_deaths = false;
            last_voting_start_time_seen = 0.0;
			recent_deaths_open_time = 0.0;
            return;
        }

        // Auto-open vote UI when entering voting (once per voting session).
        if voting_start_time > 0.0 && voting_start_time != last_voting_start_time_seen {
            last_voting_start_time_seen = voting_start_time;
            voting_ui_open = true;
            show_recent_deaths = true;
			recent_deaths_open_time = get_time();
			// Return early so stale markers from the previous session can't
			// render this frame while rr_vote_results_active / has_voted may
			// not have synced yet from the server.
			return;
        }

		// Voting has ended, but we keep the game in VOTING briefly to reveal the result.
		if rr_vote_results_active {
			if voting_ui_open && player.is_local() {
				rr_draw_vote_result_ui(player);
			}
			return;
		}

        // Only allow closing after the player has voted or skipped.
        if params.clicked && params.can_use && player.has_voted {
            voting_ui_open = !voting_ui_open;
        }

        if voting_ui_open && player.is_local_or_server() {
            if show_recent_deaths {
				// Auto-advance after a short recap.
				if recent_deaths_open_time > 0.0 && (get_time() - recent_deaths_open_time) >= 5.0 {
					show_recent_deaths = false;
				}
                if rr_draw_recent_deaths_ui(player, recent_deaths_open_time) {
					show_recent_deaths = false;
				}
            } else {
                rr_draw_voting_ui(player);
            }
        }
    }


	on_draw_button :: proc(instance: Vote_Ability, rect: Rect) {
		draw_ability_name_label(rect, Vote_Ability.NAME);
	}
}

shoot_projectile :: proc(spawn_position: v2, velocity: v2, damage: int, lifetime: float, owner: Entity) -> Entity {
    prefab := get_asset(Prefab_Asset, "prefabs/RR_Projectile.prefab");
    entity := Scene.instantiate(prefab);
    entity.set_local_position(spawn_position);

    projectile := entity.get_component(RR_Projectile);
    projectile.velocity = velocity;
    projectile.lifetime = lifetime;
    projectile.damage = damage;
    projectile.owner = owner;
    return entity;
}

Shoot_Ability :: class : Ability_Base {
    on_init :: proc(ability: Shoot_Ability) {
        ability.name = "Shoot";
        ability.is_aimed_ability = true;
    }

    can_use :: method() -> bool {
        if game_state != Game_State.INGAME return false;
        if player.player_state != Player_State.ALIVE return false;
        if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_role == Player_Role.PIRATE {
			pm := player.entity.get_component(Pirate_Module);
			if pm != null && pm.treasure < PIRATE_SHOOT_UNLOCK_TREASURE_COST return false;
		}
        return true;
    }

    get_icon :: proc(ability: Shoot_Ability, player_role: Player_Role) -> Texture_Asset {
        if player_role == Player_Role.PIRATE {
            return get_asset(Texture_Asset, "sprites/icons/pirate/flintlock_pistol.png");
        } else {
            return get_asset(Texture_Asset, "sprites/icons/revolver.png");
        }
        return null;
    }

    on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting / round-start lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

        icon = get_icon(this, player.player_role);
		// Hide the aim line while unusable (cooldown/lockout/etc).
		if !params.can_use {
			player.set_mouse_ik_enabled(false);
			if get_time() >= player.gun_visible_until {
				rr_set_player_gun_skin(player, "");
			}
			return;
		}

        activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);

		if params.can_use && activation.activate {
			player.gun_visible_until = get_time() + 0.5;
		}

		targeting := player.active_ability == this.(Ability_Base);
		gun_visible := targeting || get_time() < player.gun_visible_until;
		if gun_visible {
			gun_skin := player.player_role == Player_Role.PIRATE ? "weapons/flintlock" : "weapons/revolver";
			rr_set_player_gun_skin(player, gun_skin);
		} else {
			rr_set_player_gun_skin(player, "");
		}
		if targeting {
			player.set_mouse_ik_enabled(true);
			player.set_aim_target(player.entity.world_position + player.last_aim_direction * 5.0);
		} else {
			player.set_mouse_ik_enabled(false);
		}

        if params.can_use && activation.activate {
			player.set_facing_right(activation.direction.x > 0);
			player.set_trigger("shoot_gun");
			player.set_aim_target(player.entity.world_position + activation.direction * 5.0);
			sfx := SFX.default_sfx_desc();
			sfx.set_position(player.entity.local_position);
			sfx.volume = 0.5;
			sfx.volume_perturb = 0.2;
			sfx.speed_perturb = 0.1;
			shoot_projectile(player.entity.world_position, activation.direction * 10.0, 1, 0.75, player.entity);
			// Global SFX mix: everything at 25% volume.
			sfx.volume *= 0.25;
			sfx.volume_perturb *= 0.25;
			rr_play_sfx("sfx/shoot.wav", sfx);

			current_cooldown = 30.0;
        }
    }

	on_draw_button :: proc(instance: Shoot_Ability, rect: Rect) {
		draw_ability_name_label(rect, instance.name);
	}
}

// Black Flag - Pirate ability that creates a fog zone
BLACK_FLAG_RADIUS :: 5.0;
BLACK_FLAG_DURATION :: 30.0;

// Pirate unlock economy
PIRATE_SHOOT_UNLOCK_TREASURE_COST :: 1;
PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST :: 0;
PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST :: 2;

// Pirate treasure maps / digging
PIRATE_TREASURE_MAP_LOOT_RANGE :: 5.0;
PIRATE_TREASURE_DIG_SECONDS :: 1.6;
PIRATE_TREASURE_DIG_REASON :: "pirate_dig_for_treasure";

rr_pirate_refresh_unlocks :: proc(player: Player) {
	if player == null return;
	if player.player_role != Player_Role.PIRATE return;
	pm := player.entity.get_component(Pirate_Module);
	if pm == null return;

	// Treasure is NOT consumed on unlock; abilities become usable once you have enough.
	pm.black_flag_unlocked = true;
	if pm.treasure >= PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST {
		pm.black_flag_unlocked = true;
	}
	if pm.treasure >= PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST {
		pm.powder_keg_unlocked = true;
	}
}

Black_Flag :: class : Component {
    owner_entity: Entity;
    spawn_time: float;
    switched_to_idle: bool;
    
    ao_start :: proc(using this: Black_Flag) {
        spawn_time = get_time();
        switched_to_idle = false;

        // Kick off the flag animation (if the entity has a spine animator)
        spine_anim := entity.get_component(Spine_Animator);
        if spine_anim != null {
            // Start with appear, then we'll switch to idle shortly after.
            spine_anim.instance.set_animation("appear", false, 0);
        }
    }
    
    ao_update :: proc(using this: Black_Flag, dt: float) {
        time_alive := get_time() - spawn_time;

        // Transition to idle after a short delay (the rig has "appear" and "idle").
        // We don't have a clean way to query animation duration here, so keep it simple.
        if !switched_to_idle && time_alive > 0.75 {
            spine_anim := entity.get_component(Spine_Animator);
            if spine_anim != null {
                spine_anim.instance.set_animation("idle", true, 0);
            }
            switched_to_idle = true;
        }
        
        // Destroy after duration
        if time_alive >= BLACK_FLAG_DURATION {
            entity.destroy();
            return;
        }
        
        // Apply fog effect to nearby players (client-side rendering)
        for player: component_iterator(Player) {
            if player.player_state != Player_State.ALIVE continue;
            if !player.is_local_or_server() continue;
            
            distance := length(player.entity.world_position - entity.world_position);
            if distance < BLACK_FLAG_RADIUS {
                // Check if this player is immune (the Pirate who placed it, or fellow traitors)
                is_pirate_owner := #alive(owner_entity) && owner_entity == player.entity;

                if !is_pirate_owner && player.player_type != Player_Type.TRAITOR {
                    // Draw fog overlay - obscures vision except small circle in center
                    draw_fog_overlay(player);
                }
            }
        }
    }
}

draw_fog_overlay :: proc(player: Player) {
    fog_texture := get_asset(Texture_Asset, "$AO/white.png");
    
    // Draw dark fog covering the entire screen
    UI.push_layer(1000);
    defer UI.pop_layer();
    
    fog_color := v4.{0, 0, 0, 0.9};
    
    screen := UI.get_screen_rect();
    UI.quad(screen, fog_texture, fog_color);
}

Black_Flag_Ability :: class : Ability_Base {
    NAME :: "Black Flag";
    
    on_init :: proc(ability: Black_Flag_Ability) {
        ability.icon = get_asset(Texture_Asset, "sprites/icons/pirate/black_flag.png");
    }
    
    can_use :: method() -> bool {
        if game_state != Game_State.INGAME return false;
        if player.player_state != Player_State.ALIVE return false;
        if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
        if player.player_role != Player_Role.PIRATE return false;
		// Auto-unlock based on current treasure amount (treasure is not spent).
		pm := player.entity.get_component(Pirate_Module);
		if pm != null && pm.treasure < PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST return false;
        return true;
    }

    on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting / round-start lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

        // If pressed while locked, explain unlock requirement.
        if params.clicked && !params.can_use {
			pm := player.entity.get_component(Pirate_Module);
            if player != null && player.player_role == Player_Role.PIRATE && pm != null && pm.treasure < PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST {
                player.Notify(format_string("Black Flag locked: get %/% treasure to unlock.", .{
                    min(pm.treasure, PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST),
                    PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST
                }));
            }
        }

        if params.clicked && params.can_use {
            // Spawn prefab (includes the spine setup already)
            prefab := get_asset(Prefab_Asset, "prefabs/black_flag.prefab");
            flag_entity := Scene.instantiate(prefab);
            flag_entity.set_local_position(player.entity.local_position);

            // Ensure gameplay component exists (drives fog + appear.idle)
            flag: Black_Flag;
            flag = flag_entity.get_component(Black_Flag);
            if flag == null {
                flag = flag_entity.add_component(Black_Flag);
            }
            flag.owner_entity = player.entity;
            
            player.Notify("Black Flag placed!");
            current_cooldown = 60.0;
        }
    }

	on_draw_button :: proc(instance: Black_Flag_Ability, rect: Rect) {
		draw_ability_name_label(rect, Black_Flag_Ability.NAME);

		// Locked overlay (still show button for learnability).
		p := instance.player;
		pm := p.entity.get_component(Pirate_Module);
		if p != null && p.player_role == Player_Role.PIRATE && pm != null && pm.treasure < PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");

			ts2 := ts;
			ts2.size = 14;
			ts2.valign = .BOTTOM;
			UI.text(rect.inset(2).cut_bottom(18), ts2, format_string("Need: %", .{PIRATE_BLACK_FLAG_UNLOCK_TREASURE_COST}));
		}
	}
}

// --- Pirate: Treasure Maps / Digging ---

rr_pirate_get_closest_unlooted_corpse :: proc(pirate: Player) -> Corpse {
	if pirate == null return null;
	finder := make_finder(Corpse, pirate.entity.world_position, PIRATE_TREASURE_MAP_LOOT_RANGE);
	for corpse: component_iterator(Corpse) {
		if corpse == null continue;
		if corpse.has_been_reported continue;
		if corpse.pirate_map_taken continue;
		finder.check(corpse, corpse.entity.world_position);
	}
	return finder.closest;
}

rr_pirate_pick_dig_spot_position :: proc(origin: v2) -> v2 {
	// Prefer random points across the whole map; clamp to navmesh for validity.
	rng := rng_seed(rng_root_seed() + get_frame_number() + (abs(origin.x) * 1000.0).(u64) + (abs(origin.y) * 1000.0).(u64) * 7919);

	wmin := rr_get_map_world_min();
	wmax := rr_get_map_world_max();
	min_x := min(wmin.x, wmax.x);
	max_x := max(wmin.x, wmax.x);
	min_y := min(wmin.y, wmax.y);
	max_y := max(wmin.y, wmax.y);

	triangle_hint: s64;
	for i: 0..15 {
		p := v2.{rng_range_float(ref rng, min_x, max_x), rng_range_float(ref rng, min_y, max_y)};
		nav_point: v2;
		if try_find_closest_point_on_navmesh(p, ref nav_point, ref triangle_hint) {
			return nav_point;
		}
	}

	// Fallback: clamp the corpse position.
	nav_point: v2;
	if try_find_closest_point_on_navmesh(origin, ref nav_point, ref triangle_hint) {
		return nav_point;
	}
	return origin;
}

rr_pirate_spawn_dig_spot_for_player :: proc(pirate: Player, origin: v2) {
	if pirate == null return;
	if !Game.is_server() return;
	if pirate.player_role != Player_Role.PIRATE return;
	if pirate.player_state != Player_State.ALIVE return;

	pos := rr_pirate_pick_dig_spot_position(origin);
	e := Scene.create_entity();
	e.set_local_position(pos);

	spot := e.add_component(Pirate_Treasure_Dig_Spot);
	spot.owner_player_entity_id = pirate.entity.id;
}

Pirate_Dig_Lock :: class : Component {
	active: bool;
	end_time: float;
	spot_entity_id: u64;

	arm :: proc(using this: Pirate_Dig_Lock, seconds: float, spot_entity: Entity) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		active = true;
		spot_entity_id = 0;
		if #alive(spot_entity) {
			spot_entity_id = spot_entity.id;
		}

		p := entity.get_component(Player);
		if p != null {
			p.add_disable_movement_input_reason(PIRATE_TREASURE_DIG_REASON);
			// Visible to everyone (server-driven trigger replicated via player rig).
			p.set_trigger("pirate_dig_for_treasure");
		}
	}

	clear_spot_digging_flag :: proc(using this: Pirate_Dig_Lock) {
		if spot_entity_id == 0 return;
		for spot: component_iterator(Pirate_Treasure_Dig_Spot) {
			if spot == null continue;
			if spot.entity == null continue;
			if spot.entity.id != spot_entity_id continue;
			spot.is_digging = false;
			return;
		}
	}

	destroy_spot_entity_if_alive :: proc(using this: Pirate_Dig_Lock) {
		if spot_entity_id == 0 return;
		for spot: component_iterator(Pirate_Treasure_Dig_Spot) {
			if spot == null continue;
			if spot.entity == null continue;
			if spot.entity.id != spot_entity_id continue;
			if #alive(spot.entity) {
				spot.entity.destroy();
			}
			return;
		}
	}

	ao_update :: proc(using this: Pirate_Dig_Lock, dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: cancel if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(PIRATE_TREASURE_DIG_REASON);
			p.set_trigger("RESET");
			this.clear_spot_digging_flag();
			active = false;
			return;
		}

		if get_time() >= end_time {
			p.remove_disable_movement_input_reason(PIRATE_TREASURE_DIG_REASON);
			p.set_trigger("RESET");

			// Award treasure server-side.
			if Game.is_server() {
				pm := p.entity.get_component(Pirate_Module);
				if pm != null pm.treasure += 1;
				rr_pirate_refresh_unlocks(p);
				p.Notify("Found treasure! (+1)");
				this.destroy_spot_entity_if_alive();
			}

			active = false;
		}
	}
}

Pirate_Treasure_Dig_Spot :: class : Interactable {
	owner_player_entity_id: u64;
	is_dug: bool;
	is_digging: bool;

	ao_start :: method() {
		this.set_listener(this);
		radius = 1.25;
		prompt_offset = v2.{0, 0.6};
		required_hold_time = 0.0;
		priority = 25;
		this.set_text("Dig");
	}

	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.PIRATE return false;
		if owner_player_entity_id == 0 return false;
		if player.entity.id != owner_player_entity_id return false;
		if is_dug return false;
		if is_digging return false;
		return true;
	}

	on_interact :: method(player: Player) {
		if player == null return;
		if !Game.is_server() return;
		if is_dug || is_digging return;

		is_digging = true;

		lock := player.entity.get_component(Pirate_Dig_Lock);
		if lock == null {
			lock = player.entity.add_component(Pirate_Dig_Lock);
		}
		lock.arm(PIRATE_TREASURE_DIG_SECONDS, entity);
	}
}

Pirate_Treasure_Map_Ability :: class : Ability_Base {
	NAME :: "Treasure Map";

	on_init :: proc(instance: Pirate_Treasure_Map_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/pirate/dig_for_treasure.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_role != Player_Role.PIRATE return false;
		return rr_pirate_get_closest_unlooted_corpse(player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			corpse := rr_pirate_get_closest_unlooted_corpse(player);
			if corpse == null return;

			if Game.is_server() {
				corpse.pirate_map_taken = true;
				rr_pirate_spawn_dig_spot_for_player(player, corpse.entity.world_position);
			}

			player.Notify("Collected a treasure map!");
			current_cooldown = 1.0;
		}
	}

	on_draw_button :: proc(instance: Pirate_Treasure_Map_Ability, rect: Rect) {
		draw_ability_name_label(rect, Pirate_Treasure_Map_Ability.NAME);
	}
}

// --- Pirate: Powder Keg ---
POWDER_KEG_COOLDOWN_SECONDS :: 90.0;
POWDER_KEG_CAMERA_ZOOMED_OUT_SIZE :: 9.0;
POWDER_KEG_THROW_TRAVEL_TIME :: 0.75;
POWDER_KEG_MAX_THROW_RANGE :: 10.0;
POWDER_KEG_EXPLOSION_RADIUS :: 4.5;
POWDER_KEG_KNOCKBACK_SECONDS :: 0.55;
POWDER_KEG_KNOCKBACK_SPEED :: 14.0;
POWDER_KEG_CRATER_LIFETIME_SECONDS :: 18.0;

POWDER_KEG_KNOCKBACK_REASON :: "powder_keg_knockback";

Powder_Keg_Knockback :: class : Component {
	end_time: float;
	active: bool;
	dir: v2;

	arm :: proc(using this: Powder_Keg_Knockback, seconds: float, direction: v2, speed: float) {
		if seconds <= 0.0 {
			seconds = 0.1;
		}
		end_time = get_time() + seconds;
		active = true;
		dir = direction;

		p := entity.get_component(Player);
		if p != null {
			p.add_disable_movement_input_reason(POWDER_KEG_KNOCKBACK_REASON);
			// Initial impulse; movement can resume after the short disable window.
			p.agent.velocity = dir * speed;
		}
	}

	ao_update :: proc(using this: Powder_Keg_Knockback, dt: float) {
		if !active {
			return;
		}
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(POWDER_KEG_KNOCKBACK_REASON);
			active = false;
			return;
		}

		if get_time() >= end_time {
			p.remove_disable_movement_input_reason(POWDER_KEG_KNOCKBACK_REASON);
			active = false;
			return;
		}
	}
}

Powder_Keg_Crater :: class : Component {
	spawn_time: float;
	switched_to_idle: bool;

	ao_start :: proc(using this: Powder_Keg_Crater) {
		spawn_time = get_time();
		switched_to_idle = false;

		spine_anim := entity.add_component(Spine_Animator);
		spine_anim.awaken();
		spine_anim.depth_offset = 10.0;
		spine_anim.instance.set_skeleton(get_asset(Spine_Asset, "anims/crater/BAT003_meteor_crash_crator.spine"));
		spine_anim.instance.set_animation("appear", false, 0);
	}

	ao_update :: proc(using this: Powder_Keg_Crater, dt: float) {
		time_alive := get_time() - spawn_time;

		// Switch to idle after the appear animation.
		if !switched_to_idle && time_alive > 0.75 {
			spine_anim := entity.get_component(Spine_Animator);
			if spine_anim != null {
				spine_anim.instance.set_animation("idle", true, 0);
			}
			switched_to_idle = true;
		}

		if time_alive >= POWDER_KEG_CRATER_LIFETIME_SECONDS {
			// Optional: play disappear briefly before destroying.
			spine_anim := entity.get_component(Spine_Animator);
			if spine_anim != null {
				spine_anim.instance.set_animation("disappear", false, 0);
			}
			entity.queue_for_destruction(0.6);
		}
	}
}

powder_keg_explode_at :: proc(owner: Entity, position: v2) {
	// Spawn crater visual
	crater_e := Scene.create_entity();
	crater_e.set_local_position(position);
	crater_e.add_component(Powder_Keg_Crater);

	// Find all players in range and track nearest.
	nearest: Player = null;
	nearest_dist_sq := 0.0;
	owner_id: u64 = 0;
	if #alive(owner) {
		owner_id = owner.id;
	}

	// First pass: determine the nearest victim in the blast.
	for p: component_iterator(Player) {
		if p.player_state != Player_State.ALIVE continue;
		// Pirate cannot kill themselves with their own keg.
		if owner_id != 0 && #alive(p.entity) && p.entity.id == owner_id continue;
		d := p.entity.world_position - position;
		dist_sq := length_squared(d);
		if dist_sq > POWDER_KEG_EXPLOSION_RADIUS * POWDER_KEG_EXPLOSION_RADIUS continue;

		if nearest == null || dist_sq < nearest_dist_sq {
			nearest = p;
			nearest_dist_sq = dist_sq;
		}
	}

	// Kill the nearest victim.
	if nearest != null {
		killer_id: u64 = 0;
		if #alive(owner) {
			killer_id = owner.id;
		}
		nearest.kill_with_killer(killer_id);
		{
			sfx := SFX.default_sfx_desc();
			sfx.set_position(nearest.entity.world_position);
			sfx.volume = 0.8;
			// Explicit death SFX (old `sfx/death.wav` removed).
			// Note: `traitor_kill_death.wav` is reserved for knife/neck-snap kills.
			// Global SFX mix: everything at 25% volume.
			sfx.volume *= 0.25;
			sfx.volume_perturb *= 0.25;
			rr_play_sfx("minigame/bonk_staff_77864c.wav", sfx);
		}
	}

	// Second pass: knock back everyone else in the blast.
	for p: component_iterator(Player) {
		if p.player_state != Player_State.ALIVE continue;
		if nearest != null && p == nearest continue;

		d := p.entity.world_position - position;
		dist_sq := length_squared(d);
		if dist_sq > POWDER_KEG_EXPLOSION_RADIUS * POWDER_KEG_EXPLOSION_RADIUS continue;

		dir := d;
		if length_squared(dir) < 0.001 {
			dir = v2.{1, 0};
		} else {
			dir = normalize(dir);
		}

		knock := p.entity.get_component(Powder_Keg_Knockback);
		if knock == null {
			knock = p.entity.add_component(Powder_Keg_Knockback);
		}
		knock.arm(POWDER_KEG_KNOCKBACK_SECONDS, dir, POWDER_KEG_KNOCKBACK_SPEED);
	}
}

Powder_Keg_Thrown :: class : Component {
	owner: Entity;
	start_pos: v2;
	target_pos: v2;
	start_time: float;
	travel_time: float;
	exploded: bool;
	triangle_hint: s64;

	ao_start :: proc(using this: Powder_Keg_Thrown) {
		start_time = get_time();
		if travel_time <= 0 {
			travel_time = POWDER_KEG_THROW_TRAVEL_TIME;
		}

		spine_anim := entity.add_component(Spine_Animator);
		spine_anim.awaken();
		spine_anim.instance.set_skeleton(get_asset(Spine_Asset, "anims/powder_keg/004RAND_powder_keg.spine"));
		spine_anim.instance.set_animation("Flying_Through_Air", true, 0);
	}

	ao_update :: proc(using this: Powder_Keg_Thrown, dt: float) {
		if exploded {
			return;
		}

		// Clamp target to navmesh (keeps explosions on walkable areas).
		clamped_target := target_pos;
		point: v2;
		if try_find_closest_point_on_navmesh(target_pos, ref point, ref triangle_hint) {
			clamped_target = point;
		}

		t := (get_time() - start_time) / travel_time;
		if t < 0 { t = 0; }
		if t > 1 { t = 1; }

		// Simple parabolic arc for readability.
		height := 1.0;
		arc := 4.0 * t * (1.0 - t) * height;
		pos := lerp(start_pos, clamped_target, t);
		entity.set_local_position(pos + v2.{0, arc});

		if t >= 1.0 {
			// Snap to ground at target and explode.
			entity.set_local_position(clamped_target);
			spine_anim := entity.get_component(Spine_Animator);
			if spine_anim != null {
				spine_anim.instance.set_animation("Explode", false, 0);
			}

			powder_keg_explode_at(owner, clamped_target);

			// Cleanup projectile entity shortly after explode anim starts.
			exploded = true;
			entity.queue_for_destruction(0.8);
		}
	}
}

Powder_Keg_Ability :: class : Ability_Base {
	NAME :: "Powder Keg";

	camera_zoom_active: bool;
	camera_original_size: float;
	was_targeting: bool;
	activated_this_session: bool;

	on_init :: proc(ability: Powder_Keg_Ability) {
		ability.icon = get_asset(Texture_Asset, "sprites/icons/pirate/powder_keg.png");
		ability.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if player.player_role != Player_Role.PIRATE return false;
		// Auto-unlock based on current treasure amount (treasure is not spent).
		pm := player.entity.get_component(Pirate_Module);
		if pm != null && pm.treasure < PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST return false;
		return true;
	}

	set_camera_zoom :: proc(using this: Powder_Keg_Ability, active: bool) {
		if active {
			if !camera_zoom_active {
				camera_original_size = player.camera.size;
				player.camera.size = POWDER_KEG_CAMERA_ZOOMED_OUT_SIZE;
				camera_zoom_active = true;
			}
		}
		else {
			if camera_zoom_active {
				player.camera.size = camera_original_size;
				camera_zoom_active = false;
			}
		}
	}

	cleanup_targeting :: proc(using this: Powder_Keg_Ability) {
		this.set_camera_zoom(false);
		was_targeting = false;
		activated_this_session = false;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			pm := player.entity.get_component(Pirate_Module);
			if player != null && player.player_role == Player_Role.PIRATE && pm != null && pm.treasure < PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST {
				player.Notify(format_string("Powder Keg locked: get %/% treasure to unlock.", .{
					min(pm.treasure, PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST),
					PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST
				}));
			}
		}

		// Drive enter/exit targeting via standard helper.
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;

		// Prevent aiming mode while on cooldown / otherwise unusable.
		if targeting && !params.can_use {
			player.active_ability = null;
			this.cleanup_targeting();
			return;
		}

		// Handle targeting transitions (for cleanup + per-session activation gating).
		if targeting && !was_targeting {
			activated_this_session = false;
			was_targeting = true;
		}
		if !targeting {
			if was_targeting {
				this.cleanup_targeting();
			}
			return;
		}

		this.set_camera_zoom(true);

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel {
			player.active_ability = null;
			this.cleanup_targeting();
			return;
		}

		// Preview target (world-space).
		target_pos := get_mouse_world_position();
		{
			// Clamp max throw distance so the keg can't be thrown across the map.
			origin := player.entity.world_position;
			delta := target_pos - origin;
			max_r := POWDER_KEG_MAX_THROW_RANGE;
			if length_squared(delta) > max_r * max_r {
				if length_squared(delta) < 0.001 {
					delta = v2.{1, 0};
				} else {
					delta = normalize(delta);
				}
				target_pos = origin + delta * max_r;
			}
		}
		draw_aiming_line(player.entity.world_position, aiming.aim_direction, 1.0 / player.camera.size * 4);

		// Optional: show a subtle circle at the target.
		if player.is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			reticle := get_asset(Texture_Asset, GROUND_RETICLE_TEXTURE_PATH);
			reticle_rect := Rect{target_pos, target_pos}.grow(0.80, 0.80, 0.80, 0.80);
			UI.quad(reticle_rect.fit_aspect(reticle.get_aspect()), reticle, v4.{1, 1, 1, 0.95});
		}

		// Only allow one throw per targeting session (guards against odd input edge cases).
		if activated_this_session {
			return;
		}

		if aiming.activate && params.can_use {
			activated_this_session = true;

			// Start cooldown immediately to prevent double activates.
			current_cooldown = POWDER_KEG_COOLDOWN_SECONDS;

			// Throw keg toward clicked point.
			throw_entity := Scene.create_entity();
			throw_entity.set_local_position(player.entity.world_position);
			throw_comp := throw_entity.add_component(Powder_Keg_Thrown);
			throw_comp.owner = player.entity;
			throw_comp.start_pos = player.entity.world_position;
			throw_comp.target_pos = target_pos;
			throw_comp.travel_time = POWDER_KEG_THROW_TRAVEL_TIME;

			// Consume targeting mode.
			player.active_ability = null;
			this.cleanup_targeting();
		}
	}

	on_draw_button :: proc(instance: Powder_Keg_Ability, rect: Rect) {
		draw_ability_name_label(rect, Powder_Keg_Ability.NAME);

		// Locked overlay (still show button for learnability).
		p := instance.player;
		pm := p.entity.get_component(Pirate_Module);
		if p != null && p.player_role == Player_Role.PIRATE && pm != null && pm.treasure < PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");

			ts2 := ts;
			ts2.size = 14;
			ts2.valign = .BOTTOM;
			UI.text(rect.inset(2).cut_bottom(18), ts2, format_string("Need: %", .{PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST}));
		}
	}
}

// --- Prankster ---
PRANK_DELAY_SECONDS :: 10.0;
PRANK_MELEE_RANGE :: 3.0;
PRANK_STUN_SECONDS :: 2.0;
PRANK_STUN_REASON :: "prank_slip";

// --- Pyromaniac (Anarchist role) ---
PYRO_LIGHT_FIRE_RANGE :: 2.0;
PYRO_LIGHT_FIRE_COOLDOWN_SECONDS :: 7.5;

rr_pyro_get_closest_unlit_prop :: proc(player: Player) -> Entity {
	if player == null return null;
	if world_references == null return null;

	pyro_mod := player.entity.get_component(Pyro_Module);
	if pyro_mod == null return null;
	pyro_mod.ensure_props_cached();
	if pyro_mod.cached_props.count <= 0 return null;

	best: Entity = null;
	best_dist_sq := 0.0;
	r_sq := PYRO_LIGHT_FIRE_RANGE * PYRO_LIGHT_FIRE_RANGE;

	for i: 0..pyro_mod.cached_props.count-1 {
		e := pyro_mod.cached_props[i];
		if e == null continue;
		if !#alive(e) continue;
		// Skip non-visual entities like MIN/MAX bound markers.
		if e.get_component(Sprite_Renderer) == null continue;

		// Skip already-burning props.
		existing := e.get_component(RR_Prop_Fire_Target);
		if existing != null && existing.active {
			continue;
		}
		// Skip props in rooms that are already fully burned out.
		room_root := rr_pyro_find_props_room_root(e);
		room_state := rr_pyro_get_or_create_room_state(room_root);
		if room_state != null && room_state.fiery_locked {
			continue;
		}

		d := e.world_position - player.entity.world_position;
		dist_sq := length_squared(d);
		if dist_sq > r_sq continue;

		if best == null || dist_sq < best_dist_sq {
			best = e;
			best_dist_sq = dist_sq;
		}
	}
	return best;
}

rr_pyro_get_closest_nest :: proc(player: Player) -> GGG_Nest {
	if player == null return null;
	best: GGG_Nest = null;
	best_dist_sq := 0.0;
	r_sq := PYRO_LIGHT_FIRE_RANGE * PYRO_LIGHT_FIRE_RANGE;
	for nest: component_iterator(GGG_Nest) {
		if nest == null continue;
		if nest.destroyed continue;
		if nest.entity == null || !#alive(nest.entity) continue;
		d := nest.entity.world_position - player.entity.world_position;
		dist_sq := length_squared(d);
		if dist_sq > r_sq continue;
		if best == null || dist_sq < best_dist_sq {
			best = nest;
			best_dist_sq = dist_sq;
		}
	}
	return best;
}

Pyromaniac_Light_Fire_Ability :: class : Ability_Base {
	NAME :: "Light Fire";

	on_init :: proc(instance: Pyromaniac_Light_Fire_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/pyro/set_fire.png");
	}

	can_use :: method() -> bool {
		p := player;
		if game_state != Game_State.INGAME return false;
		if p == null return false;
		if p.player_state != Player_State.ALIVE return false;
		if p.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if p.player_type != Player_Type.ANARCHIST return false;
		if p.player_role != Player_Role.PYROMANIAC return false;
		if p.pyro_on_fire return false;
		if rr_pyro_get_closest_unlit_prop(p) != null return true;
		if rr_pyro_get_closest_nest(p) != null return true;
		return false;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting / round-start lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		// Point an arrow toward the nearest burnable prop when the ability is ready.
		if params.can_use && player.is_local() {
			target := rr_pyro_get_closest_unlit_prop(player);
			if target != null && #alive(target) {
				options := Tutorial_Arrow.default_options();
				options.alpha = 1.0;
				options.far  = true;
				options.near = true;
				rr_draw_tutorial_arrow(player, target.world_position, options);
			} else {
				// Arrow toward nest if no prop
				nest := rr_pyro_get_closest_nest(player);
				if nest != null && nest.entity != null && #alive(nest.entity) {
					options := Tutorial_Arrow.default_options();
					options.alpha = 1.0;
					options.far  = true;
					options.near = true;
					rr_draw_tutorial_arrow(player, nest.entity.world_position, options);
				}
			}
		}

		// Feedback when pressed while disabled.
		if params.clicked && !params.can_use {
			if player != null && !player.pyro_on_fire {
				if rr_pyro_get_closest_unlit_prop(player) == null && rr_pyro_get_closest_nest(player) == null {
					player.Notify("No nearby props to ignite!");
				}
			}
		}

		if params.clicked && params.can_use {
			if Game.is_server() {
				// Check for nest first (priority target)
				nest := rr_pyro_get_closest_nest(player);
				if nest != null {
					// Find the GGG_Module that owns this nest and destroy it
					for ggg_player: component_iterator(Player) {
						if ggg_player == null continue;
						if ggg_player.player_role != Player_Role.GOO_GOO_GAGA continue;
						gm := ggg_player.entity.get_component(GGG_Module);
						if gm == null continue;
						if gm.nest_entity == nest.entity {
							rr_ggg_destroy_nest(gm);
							player.Notify("Nest destroyed!");
							player.set_trigger("pyro_snap_fingers");
							break;
						}
					}
				} else {
					target := rr_pyro_get_closest_unlit_prop(player);
					if target != null {
						fire := target.get_component(RR_Prop_Fire_Target);
						if fire == null {
							fire = target.add_component(RR_Prop_Fire_Target);
						}
						fire.ignite(player);
						player.set_trigger("pyro_snap_fingers");
						rr_pyro_register_prop_ignited(player);
					}
				}
			}
			current_cooldown = PYRO_LIGHT_FIRE_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: Pyromaniac_Light_Fire_Ability, rect: Rect) {
		draw_ability_name_label(rect, Pyromaniac_Light_Fire_Ability.NAME);
	}
}

Pyromaniac_Light_Corpse_Ability :: class : Ability_Base {
	NAME :: "Light Corpse";

	on_init :: proc(instance: Pyromaniac_Light_Corpse_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/pyro/light_corpse.png");
	}

	can_use :: method() -> bool {
		p := player;
		if game_state != Game_State.INGAME return false;
		if p == null return false;
		if p.player_state != Player_State.ALIVE return false;
		if p.has_task_in_progress() return false;
		if p.player_type != Player_Type.ANARCHIST return false;
		if p.player_role != Player_Role.PYROMANIAC return false;
		if p.pyro_on_fire return false;
		// Disabled when no valid nearby corpse target.
		return rr_pyro_find_burnable_corpse(p) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			if Game.is_server() {
				corpse := rr_pyro_find_burnable_corpse(player);
				if corpse != null && #alive(corpse.entity) {
					corpse.pyro_has_been_burned = true;

					// Spawn 008BED_fire and drive the burn.extinguish.cleanup sequence.
					rr_pyro_start_burning_corpse_visual(corpse.entity);

					rr_pyro_register_corpse_burned(player);
					player.set_trigger("pyro_snap_fingers");
				}
			}
			current_cooldown = PYRO_LIGHT_CORPSE_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: Pyromaniac_Light_Corpse_Ability, rect: Rect) {
		draw_ability_name_label(rect, Pyromaniac_Light_Corpse_Ability.NAME);
	}
}

Pyromaniac_World_Fire_Ability :: class : Ability_Base {
	NAME :: "World Fire";

	on_init :: proc(instance: Pyromaniac_World_Fire_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/pyro/worldfire.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.ANARCHIST return false;
		if player.player_role != Player_Role.PYROMANIAC return false;
		if player.pyro_on_fire return false;
		// Still allow the button to show while locked (so we can draw LOCKED overlay),
		// but don't allow activation until unlocked.
		pyro := player.entity.get_component(Pyro_Module);
		if pyro == null return false;
		if pyro.world_fire_unlocked_time <= 0.0 return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// If pressed while locked, explain unlock requirement.
		if params.clicked && !params.can_use {
			pyro := player.entity.get_component(Pyro_Module);
			if player != null && pyro != null && pyro.world_fire_unlocked_time <= 0.0 {
				player.Notify(format_string("World Fire locked: burn 1 corpse + burn out % rooms (Corpse %/1, Rooms %/%).", .{
					PYRO_ROOMS_BURNOUT_TARGET,
					min(pyro.corpses_burned, 1),
					min(pyro.rooms_burned_out, PYRO_ROOMS_BURNOUT_TARGET),
					PYRO_ROOMS_BURNOUT_TARGET
				}));
			}
		}

		if params.clicked && params.can_use {
			// Trigger the server-authoritative win cinematic.
			start_pyro_win_cinematic(player);

			// Kick off local-only overlay + bigfire around pyro for the duration.
			if player.is_local_or_server() {
				c := player.entity.get_component(RR_Pyro_World_Fire_Cinematic);
				if c == null {
					c = player.entity.add_component(RR_Pyro_World_Fire_Cinematic);
				}
				c.arm();
			}

			current_cooldown = 9999.0;
		}
	}

	on_draw_button :: proc(instance: Pyromaniac_World_Fire_Ability, rect: Rect) {
		draw_ability_name_label(rect, Pyromaniac_World_Fire_Ability.NAME);

		// Locked overlay + progress
		p := instance.player;
		if p == null return;
		pyro := p.entity.get_component(Pyro_Module);
		if pyro == null return;
		if pyro.world_fire_unlocked_time > 0.0 return;

		ts := UI.default_text_settings();
		ts.size = 18;
		ts.halign = .CENTER;
		ts.valign = .TOP;
		ts.do_outline = true;
		ts.outline_thickness = 2;
		ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");

		// Show objective progress underneath (cached to avoid per-frame format_string).
		c := min(pyro.corpses_burned, 1);
		r := min(pyro.rooms_burned_out, PYRO_ROOMS_BURNOUT_TARGET);
		if c != pyro.cached_lock_corpses || r != pyro.cached_lock_rooms || pyro.cached_lock_str.count == 0 {
			pyro.cached_lock_corpses = c;
			pyro.cached_lock_rooms = r;
			pyro.cached_lock_str = format_string("Corpse %/1  Rooms %/%", .{c, r, PYRO_ROOMS_BURNOUT_TARGET});
		}
		ts2 := ts;
		ts2.size = 14;
		ts2.valign = .BOTTOM;
		UI.text(rect.inset(2).cut_bottom(18), ts2, pyro.cached_lock_str);
	}
}

Pranked_Effect :: class : Component {
	trigger_time: float;
	stun_end_time: float;
	phase: int; // 0 = waiting, 1 = stunning, 2 = done

	ao_start :: proc(using this: Pranked_Effect) {
		phase = 0;
	}

	arm :: proc(using this: Pranked_Effect, delay_seconds: float) {
		trigger_time = get_time() + delay_seconds;
		stun_end_time = 0.0;
		phase = 0;
	}

	ao_update :: method(dt: float) {
		p := entity.get_component(Player);
		if p == null {
			return;
		}

		// Safety: if gameplay ended or player is dead, ensure we don't leave them frozen.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(PRANK_STUN_REASON);
			phase = 2;
			return;
		}

		if phase == 0 {
			if get_time() < trigger_time {
				return;
			}

			// Impact moment: notify, play anim (non-looping), and freeze movement for 2 seconds.
			p.Notify("you've been pranked!");
			p.set_trigger("prank_slip");
			p.add_disable_movement_input_reason(PRANK_STUN_REASON);
			stun_end_time = get_time() + PRANK_STUN_SECONDS;
			phase = 1;
			return;
		}

		if phase == 1 {
			if get_time() >= stun_end_time {
				p.remove_disable_movement_input_reason(PRANK_STUN_REASON);
				// Return to the normal locomotion tree after the one-shot.
				// NOTE: This assumes the player's anim state machine has a RESET trigger wired (it already does for revive).
				p.set_trigger("RESET");
				phase = 2;
			}
			return;
		}
	}
}

Prank_Ability :: class : Ability_Base {
	NAME :: "Prank";

	on_init :: proc(instance: Prank_Ability) {
		// Reuse an existing icon (no prank icon in the repo).
		instance.icon = get_asset(Texture_Asset, "sprites/icons/trickster/prank.png");
	}

	get_closest_prankable_player :: proc(instance: Prank_Ability, player: Player) -> Player {
		finder := make_finder(Player, player.entity.world_position, PRANK_MELEE_RANGE);
		for i: 0..players.elements.count-1 {
			target := players.elements[i];
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == player continue;
			if target.player_state != Player_State.ALIVE continue;
			finder.check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: proc(instance: Prank_Ability) -> bool {
		if game_state != Game_State.INGAME return false;
		if instance.player.player_state != Player_State.ALIVE return false;
		if instance.player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		return instance.get_closest_prankable_player(instance.player) != null;
	}

	on_update :: proc(instance: Prank_Ability, params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting / round-start lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		instance.current_cooldown = max(instance.current_cooldown, lockout_remaining);

		if params.clicked && params.can_use {
			target := instance.get_closest_prankable_player(instance.player);
			if target == null {
				return;
			}

			// Count unique pranks toward the win condition
			prk := instance.player.entity.get_component(Prankster_Module);
			if prk != null { prk.prank_count += 1; }

			// Attach a delayed effect to the target so the message shows on THEIR client after 10s
			eff := target.entity.get_component(Pranked_Effect);
			if eff == null {
				eff = target.entity.add_component(Pranked_Effect);
			}
			eff.arm(PRANK_DELAY_SECONDS);

			instance.player.Notify(format_string("Pranked %!", .{target.entity.get_name()}));
			instance.current_cooldown = 15.0;
		}
	}

	on_draw_button :: proc(instance: Prank_Ability, rect: Rect) {
		draw_ability_name_label(rect, Prank_Ability.NAME);
	}
}

Fake_Meeting_Ability :: class : Ability_Base {
	NAME :: "Fake Meeting";

	on_init :: proc(instance: Fake_Meeting_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/trickster/call_fake.png");
	}

	can_use :: proc(instance: Fake_Meeting_Ability) -> bool {
		if game_state != Game_State.INGAME return false;
		if instance.player.player_state != Player_State.ALIVE return false;
		if instance.player.has_task_in_progress() return false;

		// Respect the shared meeting cooldown AND the prankster's fake-meeting cooldown.
		// These are server-owned but replicated to clients, so we can safely use them for UI disabling.
		now := get_time();
		cooldown_end := max(meeting_cooldown_ends_at, fake_meeting_cooldown_ends_at);
		return now >= cooldown_end;
	}

	on_update :: proc(instance: Fake_Meeting_Ability, params: ref Ability_Update_Params) {
		// Keep the button's cooldown overlay synced with the authoritative cooldown timers.
		now := get_time();
		cooldown_end := max(meeting_cooldown_ends_at, fake_meeting_cooldown_ends_at);
		remaining := cooldown_end - now;
		if remaining < 0.0 remaining = 0.0;
		instance.current_cooldown = remaining;

		if params.clicked && params.can_use {
			start_fake_meeting(instance.player);

			// Resync immediately in case the meeting successfully started this frame.
			now = get_time();
			cooldown_end = max(meeting_cooldown_ends_at, fake_meeting_cooldown_ends_at);
			remaining = cooldown_end - now;
			if remaining < 0.0 remaining = 0.0;
			instance.current_cooldown = remaining;
		}
	}

	on_draw_button :: proc(instance: Fake_Meeting_Ability, rect: Rect) {
		draw_ability_name_label(rect, Fake_Meeting_Ability.NAME);
	}
}

JESTER_WIN_DELAY_SECONDS :: 15.0;
JESTER_WIN_CINEMATIC_TRIGGER :: "jester_win";

Jester_Win_Ability :: class : Ability_Base {
	NAME :: "Jester Win";

	on_init :: proc(instance: Jester_Win_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/trickster/jester.png");
	}

	can_use :: method() -> bool {
		// Must be alive in-game
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;

		// Locked until both objectives are complete (and unlock timer started)
		prk := player.entity.get_component(Prankster_Module);
		if prk == null return false;
		if prk.jester_unlocked_time <= 0.0 return false;

		// Wait 15 seconds after unlocking
		return get_time() >= (prk.jester_unlocked_time + JESTER_WIN_DELAY_SECONDS);
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// If pressed while locked, explain unlock requirement / timing.
		if params.clicked && !params.can_use {
			if player != null {
				prk := player.entity.get_component(Prankster_Module);
				if prk != null {
					if prk.jester_unlocked_time <= 0.0 {
						player.Notify(format_string("Jester Win locked: prank %/% and call %/% fake meetings to unlock.", .{
							min(prk.prank_count, 3),
							3,
							min(prk.fake_meetings_called, 1),
							1
						}));
					} else {
						remaining := (prk.jester_unlocked_time + JESTER_WIN_DELAY_SECONDS) - get_time();
						if remaining > 0.0 {
							player.Notify(format_string("Jester Win charging: survive %s more seconds.", .{format_float(remaining, decimals=0)}));
						}
					}
				}
			}
		}

		if params.clicked && params.can_use {
			// Start the cinematic; game will end after 5 seconds.
			start_jester_win_cinematic(player);
			// Put the ability on cooldown so it can't be spammed during the cinematic.
			current_cooldown = 9999.0;
		}
	}

	on_draw_button :: proc(instance: Jester_Win_Ability, rect: Rect) {
		draw_ability_name_label(rect, Jester_Win_Ability.NAME);

		// Draw countdown / lock state on top of the button.
		ts := UI.default_text_settings();
		ts.size = 20;
		ts.halign = .CENTER;
		ts.valign = .TOP;

		player := instance.player;
		if player == null {
			return;
		}

		prk := player.entity.get_component(Prankster_Module);
		label := "";
		if prk == null || prk.jester_unlocked_time <= 0.0 {
			label = "LOCKED";
		} else {
			remaining := (prk.jester_unlocked_time + JESTER_WIN_DELAY_SECONDS) - get_time();
			if remaining > 0.0 {
				label = format_string("%s", .{format_float(remaining, decimals=0)});
			} else {
				label = "READY";
			}
		}
		UI.text(rect.inset(4).cut_top(24), ts, label);
	}
}

// --- Movie Star ---
MOVIE_STAR_AUTOGRAPH_PLACE_TIME_SECONDS :: 2.2;
MOVIE_STAR_AUTOGRAPH_COOLDOWN_SECONDS :: 30.0;
MOVIE_STAR_AUTOGRAPH_WRITE_REASON :: "movie_star_autograph_write";
MOVIE_STAR_AUTOGRAPH_PLACE_DISTANCE :: 4.0;

Movie_Star_Write_Autograph :: class : Component {
	end_time: float;
	placed: bool;
	done: bool;
	target_pos: v2;

	ao_start :: proc(using this: Movie_Star_Write_Autograph) {
		p := entity.get_component(Player);
		if p == null {
			// Defensive: should never happen on non-player entities.
			done = true;
			return;
		}
		placed = false;
		done = false;
		end_time = get_time() + MOVIE_STAR_AUTOGRAPH_PLACE_TIME_SECONDS;

		// Lock movement during the signing animation
		p.add_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_WRITE_REASON);
		p.set_trigger("write_place_autograph");
	}

	ao_update :: proc(using this: Movie_Star_Write_Autograph, dt: float) {
		if done {
			return;
		}
		p := entity.get_component(Player);
		if p == null {
			done = true;
			return;
		}

		// Safety: if game left gameplay or player died, stop freezing them.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_WRITE_REASON);
			p.set_trigger("RESET");
			done = true;
			return;
		}

		if !placed && get_time() >= end_time {
			placed = true;
			rr_add_autograph_trap(p, target_pos);
			p.remove_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_WRITE_REASON);
			p.set_trigger("RESET");
			done = true;
		}
	}
}

MOVIE_STAR_AUTOGRAPH_STUN_REASON :: "movie_star_autograph_stun";

// Local-only "wowie you're looking at an autograph!" reveal for the stunned player.
// Start time is stored on the Player (synced field) because CSL globals get clobbered
// by client-side prediction resimulation.
AUTOGRAPH_STUN_VISUAL_DURATION :: 3.8;
AUTOGRAPH_STUN_VISUAL_SPIN_IN :: 0.55;
AUTOGRAPH_STUN_VISUAL_FADE_OUT :: 0.6;

rr_trigger_autograph_stun_visual :: proc(p: Player) {
	if p == null return;
	p.autograph_stun_visual_start_time = get_time();
}

rr_draw_autograph_stun_visual :: proc(viewer: Player) {
	if viewer == null return;
	if viewer.autograph_stun_visual_start_time <= 0.0 return;

	now := get_time();
	t := now - viewer.autograph_stun_visual_start_time;
	if t < 0.0 || t >= AUTOGRAPH_STUN_VISUAL_DURATION {
		return;
	}

	scale: float = 1.0;
	rot: float = 0.0;
	alpha: float = 1.0;

	if t < AUTOGRAPH_STUN_VISUAL_SPIN_IN {
		// Magazine spin-in: overshoot ease_out_back + multiple rotations settling to 0.
		k := t / AUTOGRAPH_STUN_VISUAL_SPIN_IN;
		ease := Ease.out_back(k);
		scale = lerp(0.0, 1.0, ease);
		rot = lerp(-12.566, 0.0, ease); // ~2 full rotations
		alpha = clamp(k * 2.0, 0.0, 1.0);
	} else {
		fade_start := AUTOGRAPH_STUN_VISUAL_DURATION - AUTOGRAPH_STUN_VISUAL_FADE_OUT;
		if t < fade_start {
			// Subtle idle pulse.
			pulse_t := t - AUTOGRAPH_STUN_VISUAL_SPIN_IN;
			scale = 1.0 + sin(pulse_t * 6.0) * 0.03;
			rot = sin(pulse_t * 3.0) * 0.04;
			alpha = 1.0;
		} else {
			k := (t - fade_start) / AUTOGRAPH_STUN_VISUAL_FADE_OUT;
			if k > 1.0 { k = 1.0; }
			scale = lerp(1.0, 1.15, k);
			alpha = 1.0 - k;
		}
	}

	tex := get_asset(Texture_Asset, "sprites/autograph.png");
	if tex == null return;

	// Screen-centered reveal so it's always clearly visible to the stunned player.
	// Screen dimensions here are already unscaled; use grow_unscaled so the
	// display size derived from screen space stays consistent across UI scaling.
	screen := UI.get_screen_rect();
	base_half := min(screen.width(), screen.height()) * 0.4;
	half := base_half * scale;
	center := screen.center();

	rect := Rect{center, center}.grow_unscaled(half, half, half, half).fit_aspect(tex.get_aspect());

	UI.push_matrix(Matrix4.rotate_about_point(rect.center(), to_degrees(rot)));
	defer UI.pop_matrix();

	UI.push_color_multiplier({1, 1, 1, alpha});
	defer UI.pop_color_multiplier();

	UI.quad(rect, tex, v4.{1, 1, 1, 1});
}

Stunned_By_Autograph_Effect :: class : Component {
	stun_end_time: float;
	active: bool;
	last_visual_spawn_time: float;

	arm :: proc(using this: Stunned_By_Autograph_Effect, seconds: float) {
		if seconds <= 0.0 {
			seconds = 0.1;
		}
		stun_end_time = get_time() + seconds;

		p := entity.get_component(Player);
		if p != null {
			// Clean up previous stun state before re-applying
			if active {
				p.remove_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_STUN_REASON);
			}
			p.add_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_STUN_REASON);
			p.set_trigger("RESET");
			p.set_trigger("stunned_by_autograph_loop");

			// Set the visual start time on BOTH client and server so state sync
			// doesn't stomp the client's local-only write back to 0.
			// The draw itself is gated to the local client in player.csl.
			now := get_time();
			if now - last_visual_spawn_time > 0.25 {
				rr_trigger_autograph_stun_visual(p);
				last_visual_spawn_time = now;

				// Only the trapped player hears this swooning cue.
				// Use is_local_or_server() so the play runs on both sides and
				// reconciliation doesn't cut the SFX short.
				if p.is_local_or_server() {
					sfx := get_asset(SFX_Asset, "sfx/fall_in_love.wav");
					if sfx != null {
						desc := SFX.default_sfx_desc();
						desc.volume = 0.35;
						// Follow the trapped player and tighten the audible range so
						// it's an intimate cue rather than audible to nearby players.
						desc.entity_to_follow = p.entity.id;
						desc.range_multiplier = 0.35;
						SFX.play(sfx, desc);
					}
				}
			}
		}
		active = true;
	}

	ao_update :: proc(using this: Stunned_By_Autograph_Effect, dt: float) {
		if !active {
			return;
		}
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_STUN_REASON);
			p.set_trigger("RESET");
			rr_lily_reapply_debuff_anim(p);
			active = false;
			return;
		}

		if get_time() >= stun_end_time {
			p.remove_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_STUN_REASON);
			p.set_trigger("RESET");
			rr_lily_reapply_debuff_anim(p);
			active = false;
		}
	}
}

Autograph_Ability :: class : Ability_Base {
	NAME :: "Autograph";

	was_targeting: bool;
	activated_this_session: bool;

	on_init :: proc(instance: Autograph_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/movie_star/write_signature.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
		if !rr_player_has_civilian_power(player, Player_Role.MOVIE_STAR) return false;
		return true;
	}

	cleanup_targeting :: method() {
		was_targeting = false;
		activated_this_session = false;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting / round-start lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;

		if targeting && !params.can_use {
			player.active_ability = null;
			cleanup_targeting();
			return;
		}

		if targeting && !was_targeting {
			activated_this_session = false;
			was_targeting = true;
		}
		if !targeting {
			if was_targeting {
				cleanup_targeting();
			}
			return;
		}

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel {
			player.active_ability = null;
			cleanup_targeting();
			return;
		}

		target_pos := get_mouse_world_position();
		{
			origin := player.entity.world_position;
			delta := target_pos - origin;
			max_r := MOVIE_STAR_AUTOGRAPH_PLACE_DISTANCE;
			if length_squared(delta) > max_r * max_r {
				if length_squared(delta) < 0.001 {
					delta = v2.{1, 0};
				} else {
					delta = normalize(delta);
				}
				target_pos = origin + delta * max_r;
			}
		}

		// Draw placement reticle
		if player.is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			reticle := get_asset(Texture_Asset, GROUND_RETICLE_TEXTURE_PATH);
			reticle_rect := Rect{target_pos, target_pos}.grow(0.80, 0.80, 0.80, 0.80);
			UI.quad(reticle_rect.fit_aspect(reticle.get_aspect()), reticle, v4.{1.0, 0.9, 0.3, 0.8});
		}

		if activated_this_session return;

		if aiming.activate && params.can_use {
			activated_this_session = true;
			// Prevent double-clicks from stacking multiple writers/traps.
			current_cooldown = MOVIE_STAR_AUTOGRAPH_COOLDOWN_SECONDS;

			// Start the signing animation; trap is placed at target_pos when it ends.
			writer := player.entity.get_component(Movie_Star_Write_Autograph);
			if writer == null {
				writer = player.entity.add_component(Movie_Star_Write_Autograph);
				writer.target_pos = target_pos;
			} else {
				// Reset for reuse (ao_start only runs on first add)
				writer.placed = false;
				writer.done = false;
				writer.target_pos = target_pos;
				writer.end_time = get_time() + MOVIE_STAR_AUTOGRAPH_PLACE_TIME_SECONDS;
				player.add_disable_movement_input_reason(MOVIE_STAR_AUTOGRAPH_WRITE_REASON);
				player.set_trigger("write_place_autograph");
			}

			player.active_ability = null;
			cleanup_targeting();
		}
	}

	on_draw_button :: proc(instance: Autograph_Ability, rect: Rect) {
		draw_ability_name_label(rect, Autograph_Ability.NAME);
	}
}

// --- Portal Maker ---
PORTAL_MAKER_PORTAL_COOLDOWN_SECONDS :: 25.0;

Red_Portal_Ability :: class : Ability_Base {
	NAME :: "Red Portal";

	on_init :: proc(instance: Red_Portal_Ability) {
		instance.name = NAME;
		instance.icon = get_asset(Texture_Asset, "sprites/icons/portal_maker/red_portal.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if !rr_player_has_civilian_power(player, Player_Role.PORTAL_MAKER) return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Click-to-aim: press ability button to enter aim mode, then click to fire.
		activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);
		if params.can_use && activation.activate {
			rr_portal_maker_fire_bolt(player, true, activation.direction);
			current_cooldown = PORTAL_MAKER_PORTAL_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: Red_Portal_Ability, rect: Rect) {
		draw_ability_name_label(rect, Red_Portal_Ability.NAME);
	}
}

Blue_Portal_Ability :: class : Ability_Base {
	NAME :: "Blue Portal";

	on_init :: proc(instance: Blue_Portal_Ability) {
		instance.name = NAME;
		instance.icon = get_asset(Texture_Asset, "sprites/icons/portal_maker/blue_portal.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if !rr_player_has_civilian_power(player, Player_Role.PORTAL_MAKER) return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Click-to-aim: press ability button to enter aim mode, then click to fire.
		activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);
		if params.can_use && activation.activate {
			rr_portal_maker_fire_bolt(player, false, activation.direction);
			current_cooldown = PORTAL_MAKER_PORTAL_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: Blue_Portal_Ability, rect: Rect) {
		draw_ability_name_label(rect, Blue_Portal_Ability.NAME);
	}
}
