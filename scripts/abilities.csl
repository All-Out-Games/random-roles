import "core:ao"

DOCTOR_RESURRECT_COOLDOWN_SECONDS :: 200.0;
DOCTOR_RESURRECTS_PER_ROUND :: 2;

KILL_COOLDOWN_SECONDS :: 30.0;

// --- Hitman ---
HITMAN_NECK_SNAP_COOLDOWN_SECONDS :: 60.0;
HITMAN_SNIPER_COOLDOWN_SECONDS :: 90.0;
HITMAN_MINE_COOLDOWN_SECONDS :: 60.0;
HITMAN_SNIPER_TARGET_PICKUP_RADIUS :: 10.0;

HITMAN_NECK_SNAP_RANGE :: 2.0;
HITMAN_MINE_TRIGGER_RADIUS :: 0.8;
HITMAN_MINE_STUN_SECONDS :: 10.0;
HITMAN_MINE_MAX_FLING_SECONDS :: 1.5;
HITMAN_MINE_FLING_SPEED :: 14.0;

HITMAN_MINE_FLING_REASON :: "hitman_mine_fling";
HITMAN_MINE_STUN_REASON :: "hitman_mine_stun";
HITMAN_SNIPER_CAMERA_ZOOMED_OUT_SIZE :: 9.0;
RETICLE_TEXTURE_PATH :: "sprites/reticle.png";
GROUND_RETICLE_TEXTURE_PATH :: "sprites/ground_reticle.png";

HITMAN_NECK_SNAP_LOCK_REASON :: "hitman_neck_snap_lock";
HITMAN_NECK_SNAP_LOCK_SECONDS :: 1.1;

get_player_by_entity_id :: proc(entity_id: u64) -> Player {
    for i: 0..players.elements.count-1 {
        p := players.elements[i];
        if p == null continue;
        if !#alive(p.entity) continue;
        if p.entity.id == entity_id {
            return p;
        }
    }
    return null;
}

build_voted_list :: proc() -> string {
	names := "";
	for i: 0..players.elements.count-1 {
		v := players.elements[i];
		if v == null continue;
		if v.player_state != Player_State.ALIVE continue;
		if !v.has_voted continue;

		n := v.entity.get_name();
		if names.count > 0 {
			names = format_string("%, %", .{names, n});
		} else {
			names = n;
		}
	}
	return names;
}

draw_ability_name_label :: proc(button_rect: Rect, label: string) {
	if label.count <= 0 return;

	bg := get_asset(Texture_Asset, "$AO/white.png");

	// Draw a small strip at the bottom of the button for readability.
	label_rect := button_rect.inset(8).cut_bottom(30);
	UI.quad(label_rect, bg, v4.{0, 0, 0, 0.55});

	ts := UI.default_text_settings();
	ts.size = 22;
	ts.color = v4.{1, 1, 1, 1};
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 2;
	ts.outline_color = v4.{0, 0, 0, 1};
	UI.text(label_rect, ts, label);
}

Kill_Ability :: class : Ability_Base {
    NAME :: "Kill";

    on_init :: proc(instance: Kill_Ability) {
        instance.icon = get_asset(Texture_Asset, "sprites/icons/kill_ability.png");
    }

    get_closest_alive_player :: proc(instance: Kill_Ability, player: Player) -> Player {
		if player == null return null;
		if player.entity == null || !#alive(player.entity) return null;
		if player.bc_cocooned return null;
		// GGG creature form has extended kill range (lunge)
		kill_range := 5.0;
		if player.player_role == Player_Role.GOO_GOO_GAGA {
			gm := player.entity.get_component(GGG_Module);
			if gm != null && gm.is_creature_form {
				kill_range = GGG_CREATURE_KILL_RANGE;
			}
		}
        finder := make_finder(Player, player.entity.world_position, kill_range);
        for i: 0..players.elements.count-1 {
            target := players.elements[i];
            if target == null {
                continue;
            }
            if !#alive(target.entity) {
                continue;
            }
            if target == player {
                continue;
            }
            if target.player_state != Player_State.ALIVE {
                continue;
            }
			if target.bc_cocooned {
				continue;
			}

            // Traitors shouldn't be able to melee-kill other traitors.
            if player.player_type == Player_Type.TRAITOR && target.player_type == Player_Type.TRAITOR {
                continue;
            }
            finder.check(target, target.entity.world_position);
        }
        return finder.closest;
    }

    can_use :: method() -> bool {
        if game_state != Game_State.INGAME return false;
        if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;
        return get_closest_alive_player(this, player) != null;
    }

    on_update :: method(params: ref Ability_Update_Params) {
		// Keep cooldown overlay in sync with post-meeting lockout.
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);
		if player.bc_cocooned return;

        // GGG: queue kill during active whip pull → insta-kill on arrival
		if params.clicked && player.player_role == Player_Role.GOO_GOO_GAGA {
			gm_whip := player.entity.get_component(GGG_Module);
			if gm_whip != null && gm_whip.foil_whip_active && !gm_whip.foil_whip_kill_on_arrive {
				gm_whip.foil_whip_kill_on_arrive = true;
				if player.player_role == Player_Role.GOO_GOO_GAGA {
					current_cooldown = GGG_KILL_COOLDOWN_SECONDS;
				} else {
					current_cooldown = KILL_COOLDOWN_SECONDS;
				}
				return;
			}
		}

        if params.clicked && params.can_use {
            closest_alive_player := get_closest_alive_player(this, player);
            if closest_alive_player != null {
				// Face the victim and play the base kill animation on the player rig.
				player.set_facing_right(closest_alive_player.entity.world_position.x > player.entity.world_position.x);
				player.set_trigger("traitor_kill");

                closest_alive_player.kill_with_killer(player.entity.id);

				// Traitor knife kill SFX (server-authoritative; replicates to clients).
				if Game.is_server() && player != null && player.player_type == Player_Type.TRAITOR {
					sfx := SFX.default_sfx_desc();
					sfx.set_position(closest_alive_player.entity.world_position);
					sfx.volume = 0.35;
					sfx.volume_perturb = 0.08;
					sfx.speed_perturb = 0.06;
					// Global SFX mix: everything at 25% volume.
					sfx.volume *= 0.25;
					sfx.volume_perturb *= 0.25;
					rr_play_sfx("sfx/traitor_kill_death.wav", sfx);

					// GGG pounce/wrap SFX + animation on kill
					if player.player_role == Player_Role.GOO_GOO_GAGA {
						gm := player.entity.get_component(GGG_Module);
						if gm != null && gm.is_creature_form {
							pounce_sfx := SFX.default_sfx_desc();
							pounce_sfx.set_position(closest_alive_player.entity.world_position);
							pounce_sfx.volume = 0.15;
							pounce_sfx.speed_perturb = 0.05;
							rr_play_sfx("sfx/ggg_pounce_wrap.wav", pounce_sfx);
							rr_ggg_creature_trigger(player, "pounce");
						}
					}
				}

                // GGG has a shorter kill cooldown.
                if player.player_role == Player_Role.GOO_GOO_GAGA {
                    current_cooldown = GGG_KILL_COOLDOWN_SECONDS;
                } else {
                    current_cooldown = KILL_COOLDOWN_SECONDS;
                }
            }
        }
    }

	on_draw_button :: proc(instance: Kill_Ability, rect: Rect) {
		p := instance.player;
		if p != null && p.player_role == Player_Role.GOO_GOO_GAGA {
			gm := p.entity.get_component(GGG_Module);
			if gm != null && gm.is_creature_form {
				instance.icon = get_asset(Texture_Asset, "sprites/icons/ggg/kill_wrap_player.png");
			} else {
				instance.icon = get_asset(Texture_Asset, "sprites/icons/kill_ability.png");
			}
		}
		draw_ability_name_label(rect, Kill_Ability.NAME);
	}
}

// --- Drag Body (Traitor utility) ---
DRAG_BODY_GRAB_RANGE :: 2.5;
DRAG_BODY_FOLLOW_DISTANCE :: 0.3;

rr_drag_body_get_closest_draggable_corpse :: proc(player: Player) -> Corpse {
	if player == null return null;
	if player.player_state != Player_State.ALIVE return null;
	if game_state != Game_State.INGAME return null;

	finder := make_finder(Corpse, player.entity.world_position, DRAG_BODY_GRAB_RANGE);
	for corpse: component_iterator(Corpse) {
		if corpse == null continue;
		if !#alive(corpse.entity) continue;

		// Only allow dragging corpses for players that are currently dead.
		owner := get_player_by_entity_id(corpse.owner_player_entity_id);
		if owner == null continue;
		if owner.player_state != Player_State.DEAD continue;

		// Don't allow two traitors to drag the same body.
		if corpse.dragged_by_player_entity_id != 0 && corpse.dragged_by_player_entity_id != player.entity.id {
			continue;
		}

		finder.check(corpse, corpse.entity.world_position);
	}
	return finder.closest;
}

rr_drag_body_find_corpse_by_entity_id :: proc(corpse_entity_id: u64) -> Corpse {
	if corpse_entity_id == 0 return null;
	for corpse: component_iterator(Corpse) {
		if corpse == null continue;
		if !#alive(corpse.entity) continue;
		if corpse.entity.id == corpse_entity_id {
			return corpse;
		}
	}
	return null;
}

Drag_Body_Ability :: class : Ability_Base {
	NAME :: "Drag";

	on_init :: proc(instance: Drag_Body_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/drag_body_icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;

		// Allow button to stay enabled while already dragging (so you can drop).
		if player.dragging_corpse_entity_id != 0 return true;
		// GGG: also allow if dragging a live player
		if player.player_role == Player_Role.GOO_GOO_GAGA {
			gm := player.entity.get_component(GGG_Module);
			if gm != null && gm.dragging_live_player_id != 0 return true;
		}
		// GGG human form: can also grab trapped+blinded live players
		if player.player_role == Player_Role.GOO_GOO_GAGA {
			gm2 := player.entity.get_component(GGG_Module);
			if gm2 != null && !gm2.is_creature_form {
				trapped := rr_ggg_get_closest_draggable_trapped_player(player);
				if trapped != null return true;
			}
		}
		// Lily: also allow if dragging a trapped player
		if player.player_role == Player_Role.LILY_LOVEBRAIDS {
			llm := player.entity.get_component(Lily_Module);
			if llm != null && llm.dragging_live_player_id != 0 return true;
		}
		// Lily schleem form: can grab string-trapped players
		if player.player_role == Player_Role.LILY_LOVEBRAIDS {
			llm2 := player.entity.get_component(Lily_Module);
			if llm2 != null && !llm2.is_lily_form {
				trapped := rr_lily_get_closest_draggable_trapped_player(player);
				if trapped != null return true;
			}
		}
		return rr_drag_body_get_closest_draggable_corpse(player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		dragging := player != null && player.dragging_corpse_entity_id != 0;
		// GGG: also check live drag
		ggg_live_dragging := false;
		if player != null && player.player_role == Player_Role.GOO_GOO_GAGA {
			gm_drag := player.entity.get_component(GGG_Module);
			if gm_drag != null && gm_drag.dragging_live_player_id != 0 {
				ggg_live_dragging = true;
			}
		}
		// Lily: also check live drag
		lily_live_dragging := false;
		if player != null && player.player_role == Player_Role.LILY_LOVEBRAIDS {
			llm_drag := player.entity.get_component(Lily_Module);
			if llm_drag != null && llm_drag.dragging_live_player_id != 0 {
				lily_live_dragging = true;
			}
		}

		// Toggle grab/drop.
		if params.clicked && params.can_use && Game.is_server() {
			if dragging {
				rr_drag_body_force_drop_for_player(player);
				return;
			}
			if ggg_live_dragging {
				rr_ggg_stop_live_drag(player);
				return;
			}
			if lily_live_dragging {
				rr_lily_stop_live_drag(player);
				return;
			}

			// GGG human form: try to grab a trapped+blinded live player first
			if player.player_role == Player_Role.GOO_GOO_GAGA {
				gm_grab := player.entity.get_component(GGG_Module);
				if gm_grab != null && !gm_grab.is_creature_form {
					trapped := rr_ggg_get_closest_draggable_trapped_player(player);
					if trapped != null {
						rr_ggg_start_live_drag(player, trapped);
						return;
					}
				}
			}

			// Lily schleem form: try to grab a string-trapped player first
			if player.player_role == Player_Role.LILY_LOVEBRAIDS {
				llm_grab := player.entity.get_component(Lily_Module);
				if llm_grab != null && !llm_grab.is_lily_form {
					trapped := rr_lily_get_closest_draggable_trapped_player(player);
					if trapped != null {
						rr_lily_start_live_drag(player, trapped);
						return;
					}
				}
			}

			corpse := rr_drag_body_get_closest_draggable_corpse(player);
			if corpse == null return;

			player.dragging_corpse_entity_id = corpse.entity.id;
			corpse.dragged_by_player_entity_id = player.entity.id;

			// Start loop SFX while dragging (server-authoritative).
			if player != null {
				if player.drag_body_sfx_id != 0 {
					SFX.stop(player.drag_body_sfx_id);
					player.drag_body_sfx_id = 0;
				}
				sound := get_asset(SFX_Asset, "sfx/drag_body_loop.wav");
				if sound != null {
					sfx := SFX.default_sfx_desc();
					sfx.entity_to_follow = player.entity.id;
					sfx.volume = 0.55;
					sfx.volume_perturb = 0.03;
					sfx.speed_perturb = 0.02;
					// Global SFX mix: everything at 25% volume.
					sfx.volume *= 0.25;
					sfx.volume_perturb *= 0.25;
					player.drag_body_sfx_id = SFX.play(sound, sfx);
				}
			}
		}

		// Follow update while dragging.
		if dragging {
			corpse := rr_drag_body_find_corpse_by_entity_id(player.dragging_corpse_entity_id);
			if corpse == null || corpse.dragged_by_player_entity_id != player.entity.id {
				// Corpse got deleted or otherwise lost while dragging.
				if Game.is_server() {
					player.dragging_corpse_entity_id = 0;
					if player.drag_body_sfx_id != 0 {
						SFX.stop(player.drag_body_sfx_id);
						player.drag_body_sfx_id = 0;
					}
					player.set_trigger("RESET");
				}
				return;
			}

			// Corpse follow is handled server-side in `Corpse.ao_update` (with smoothing).
		}
	}

	on_draw_button :: proc(instance: Drag_Body_Ability, rect: Rect) {
		draw_ability_name_label(rect, Drag_Body_Ability.NAME);
	}
}

// --- Werewolf (Traitor role) ---
WEREWOLF_TRANSFORM_MAX_DURATION_SECONDS :: 30.0;
WEREWOLF_TRANSFORM_COOLDOWN_SECONDS :: 15.0;
WEREWOLF_TRANSFORM_HOWL_SKIN_DELAY :: 1.0; // half of the howl anim (2s total)
WEREWOLF_DEVOUR_COOLDOWN_SECONDS :: 60.0;
WEREWOLF_INFECT_COOLDOWN_SECONDS :: 60.0;
WEREWOLF_CLAW_COOLDOWN_SECONDS :: 90.0;

WEREWOLF_DEVOUR_RANGE :: 2.5;
WEREWOLF_INFECT_RANGE :: 2.0;
WEREWOLF_PASS_BITE_RANGE :: 2.0;

WEREWOLF_INFECT_UNLOCK_KILLS :: 1;
WEREWOLF_CLAW_UNLOCK_KILLS :: 2;

WEREWOLF_CLAW_PROJECTILE_SPEED :: 12.0;
WEREWOLF_CLAW_PROJECTILE_LIFETIME :: 0.45;

WEREWOLF_DEVOUR_LOCK_REASON :: "werewolf_devour_lock";
WEREWOLF_DEVOUR_LOCK_SECONDS :: 1.2; // matches Infection_Bite animation duration

WEREWOLF_INFECTION_STUN_REASON :: "werewolf_infection_stun";
WEREWOLF_INFECTION_STUN_SECONDS :: 1.0;
// Delay before applying the werewolf skin on infected targets.
// The target stays looking normal for this long before the transformation visual kicks in.
WEREWOLF_INFECTED_SKIN_DELAY_SECONDS :: 10.0;
WEREWOLF_INFECTION_DURATION_SECONDS :: 25.0; // infection auto-reverts after this
WEREWOLF_INFECT_TO_CURE_TASK_ID :: "werewolf_infect_to_cure";

rr_werewolf_apply_infected_task_override :: proc(target: Player) {
	if target == null return;
	if !target.werewolf_infected return;

	// Only override once per infection session.
	if !target.werewolf_saved_tasks_active {
		target.werewolf_saved_tasks = target.active_tasks;
		target.werewolf_saved_tasks_active = true;
	}

	// Replace with a single objective entry.
	target.active_tasks = List(Task_Base).{};
	obj := new(Task_Base);
	obj.id = WEREWOLF_INFECT_TO_CURE_TASK_ID;
	obj.started = false;
	obj.completed = false;
	append(ref target.active_tasks, obj);
}

rr_werewolf_clear_infected_task_override :: proc(player: Player) {
	if player == null return;
	if player.werewolf_infected return; // still infected
	if !player.werewolf_saved_tasks_active return;

	player.active_tasks = player.werewolf_saved_tasks;
	player.werewolf_saved_tasks = List(Task_Base).{};
	player.werewolf_saved_tasks_active = false;
}

// Clears infection state and reverts visuals/tasks. Called on timer expiry or cleanup.
rr_werewolf_clear_infection :: proc(player: Player) {
	if player == null return;
	if !player.werewolf_infected return;

	player.werewolf_infected = false;
	player.werewolf_infected_from_id = 0;
	player.werewolf_infection_expires_at = 0.0;
	rr_werewolf_clear_infected_task_override(player);

	// Revert wolf look.
	player.set_trigger("RESET");
	player.werewolf_skin_enable_at = 0.0;
	player.werewolf_skin_disable_at = get_time();
	player.werewolf_infected_transform_trigger_at = 0.0;

	player.Notify("The infection wore off!");
}

rr_werewolf_find_melee_target :: proc(attacker: Player, range: float, exclude_werewolf: bool) -> Player {
	if attacker == null return null;
	finder := make_finder(Player, attacker.entity.world_position, range);
	for i: 0..players.elements.count-1 {
		target := players.elements[i];
		if target == null continue;
		if !#alive(target.entity) continue;
		if target == attacker continue;
		if target.player_state != Player_State.ALIVE continue;

		// Traitors shouldn't be able to melee-kill other traitors.
		if attacker.player_type == Player_Type.TRAITOR && target.player_type == Player_Type.TRAITOR {
			continue;
		}
		if exclude_werewolf && target.player_role == Player_Role.WEREWOLF {
			continue;
		}

		finder.check(target, target.entity.world_position);
	}
	return finder.closest;
}

rr_werewolf_apply_infection :: proc(infector: Player, target: Player) {
	if infector == null return;
	if target == null return;
	if !#alive(infector.entity) return;
	if !#alive(target.entity) return;
	if infector.player_state != Player_State.ALIVE return;
	if target.player_state != Player_State.ALIVE return;

	// Server authoritative: infection state is gameplay-relevant.
	if !Game.is_server() return;

	target.werewolf_infected = true;
	target.werewolf_infected_from_id = infector.entity.id;
	// Expiry starts from the reveal moment, not the bite.
	target.werewolf_infection_expires_at = get_time() + WEREWOLF_INFECTED_SKIN_DELAY_SECONDS + WEREWOLF_INFECTION_DURATION_SECONDS;

	// Bite animation plays immediately on the infector.
	infector.set_trigger("werewolf_infection_bite");
	// The victim's transform animation + skin change is delayed so they look normal for a while.
	// For the full delay period nothing visible happens to the victim -- no stun, no notification,
	// no task swap. Everything reveals at the transform moment.
	// The animation trigger fires 1s before the skin swap so the howl/transform anim leads into it.
	target.werewolf_infected_transform_trigger_at = get_time() + WEREWOLF_INFECTED_SKIN_DELAY_SECONDS - 1.0;
	target.werewolf_skin_enable_at = get_time() + WEREWOLF_INFECTED_SKIN_DELAY_SECONDS;
	target.werewolf_skin_disable_at = 0.0;
	// Notification, task override, and stun are deferred to transform time
	// (handled in rr_werewolf_update_skins when the transform trigger fires).
}

rr_werewolf_pass_infection :: proc(biter: Player, new_target: Player) {
	if biter == null return;
	if new_target == null return;
	if !#alive(biter.entity) return;
	if !#alive(new_target.entity) return;
	if biter.player_state != Player_State.ALIVE return;
	if new_target.player_state != Player_State.ALIVE return;
	if !biter.werewolf_infected return;
	if new_target.player_role == Player_Role.WEREWOLF return; // cannot pass back to the werewolf

	// Server authoritative.
	if !Game.is_server() return;

	from_id := biter.werewolf_infected_from_id;
	biter.werewolf_infected = false;
	biter.werewolf_infected_from_id = 0;
	biter.werewolf_infection_expires_at = 0.0;
	rr_werewolf_clear_infected_task_override(biter);

	new_target.werewolf_infected = true;
	new_target.werewolf_infected_from_id = from_id;
	// Pass reveal is near-instant (1s skin swap), so expiry starts from reveal.
	new_target.werewolf_infection_expires_at = get_time() + 1.0 + WEREWOLF_INFECTION_DURATION_SECONDS;

	// Restore the cured player's look.
	biter.set_trigger("RESET");
	biter.werewolf_skin_enable_at = 0.0;
	biter.werewolf_skin_disable_at = get_time();
	biter.werewolf_infected_transform_trigger_at = 0.0;

	// Civilian-to-civilian pass is instant â€" no stealth delay.
	// Fire transform animation now and skin swap 1s later (animation duration).
	new_target.werewolf_infected_transform_trigger_at = get_time();
	new_target.werewolf_skin_enable_at = get_time() + 1.0;
	new_target.werewolf_skin_disable_at = 0.0;

	// Apply effects immediately (notification, task override, stun).
	new_target.Notify("You were bitten! Pass it on to return to normal.");
	rr_werewolf_apply_infected_task_override(new_target);

	stun := new_target.entity.get_component(Werewolf_Infection_Stun);
	if stun == null {
		stun = new_target.entity.add_component(Werewolf_Infection_Stun);
	}
	stun.arm(WEREWOLF_INFECTION_STUN_SECONDS);

	biter.Notify("You passed the bite. You're back to normal.");
}

Werewolf_Infection_Stun :: class : Component {
	active: bool;
	end_time: float;

	arm :: proc(using this: Werewolf_Infection_Stun, seconds: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		p := entity.get_component(Player);
		if p != null {
			// Ensure this reason does not stack if arm() is called repeatedly.
			p.remove_disable_movement_input_reason(WEREWOLF_INFECTION_STUN_REASON);
			p.add_disable_movement_input_reason(WEREWOLF_INFECTION_STUN_REASON);
		}
		active = true;
	}

	ao_update :: proc(using this: Werewolf_Infection_Stun, dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: exit if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(WEREWOLF_INFECTION_STUN_REASON);
			active = false;
			return;
		}

		if get_time() >= end_time {
			p.remove_disable_movement_input_reason(WEREWOLF_INFECTION_STUN_REASON);
			active = false;
		}
	}

	ao_end :: proc(using this: Werewolf_Infection_Stun) {
		if !active return;
		p := entity.get_component(Player);
		if p != null {
			p.remove_disable_movement_input_reason(WEREWOLF_INFECTION_STUN_REASON);
		}
		active = false;
	}
}

