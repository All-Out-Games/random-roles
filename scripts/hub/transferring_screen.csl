draw_transferring_screen :: proc(player: Player) {
    if !player.transferring return;

    elapsed := get_time() - player.transferring_start_time;

    glow_tex   := get_asset(Texture_Asset, "sprites/Shapes/shape_circle_gradient.png");
    dot_tex    := get_asset(Texture_Asset, "sprites/Shapes/shape_circle.png");
    ring_tex   := get_asset(Texture_Asset, "$AO/ui/kit/Game UI/Additional Elements/Circle Portholes/white_ring.png");
    silver_tex := get_asset(Texture_Asset, "$AO/ui/kit/Game UI/Additional Elements/Circle Portholes/silver_ring.png");

    UI.push_layer(2000);
    defer UI.pop_layer();

    screen := UI.get_screen_rect();
    center := screen.center_rect();

    // 1. Full-screen base dim with a deep cool tint.
    UI.quad(screen, core_globals.white_sprite, v4.{0.02, 0.03, 0.07, 0.93});

    // 2. Soft vignette: a huge gradient blob darkening edges further.
    {
        vignette_rect := center.grow(screen.width()); // overshoot edges
        UI.quad(vignette_rect, glow_tex, v4.{0, 0, 0, 0.35});
    }

    // 3. Pulsing cyan/violet aurora glow behind everything.
    {
        pulse := 0.45 + 0.18 * sin(elapsed * 1.8);
        // Hue drifts very slowly between two cool tones.
        hue := sin(elapsed * 0.6) * 0.5 + 0.5;
        glow_color := v4.{
            lerp(0.20, 0.55, hue),
            lerp(0.45, 0.35, hue),
            lerp(0.95, 1.00, hue),
            pulse,
        };
        glow_rect := center.grow(720);
        UI.quad(glow_rect, glow_tex, glow_color);
    }

    // 4. Twinkling background sparkles (deterministic per-index phase).
    {
        STAR_COUNT :: 14;
        for i: 0..STAR_COUNT - 1 {
            fi := i.(float);
            // Pseudo-random scatter — cheap hashing via sin offsets.
            sx := sin(fi * 12.9898) * 0.5 + 0.5;
            sy := sin(fi * 78.233 + 1.7) * 0.5 + 0.5;
            star_pos := v2.{
                lerp(screen.min.x + 80, screen.max.x - 80, sx),
                lerp(screen.min.y + 80, screen.max.y - 80, sy),
            };
            twinkle := sin(elapsed * 2.0 + fi * 1.3) * 0.5 + 0.5;
            size := 3.0 + twinkle * 4.0;
            star_rect := Rect.{star_pos, star_pos}.grow(size);
            alpha := 0.15 + twinkle * 0.45;
            UI.quad(star_rect, dot_tex, v4.{0.85, 0.92, 1.0, alpha});
        }
    }

    // 5. Outer rotating ring (slow clockwise).
    {
        ring_rect := center.grow(280);
        UI.push_matrix(Matrix4.rotate_about_point(ring_rect.center(), elapsed * 22.0));
        UI.quad(ring_rect, ring_tex, v4.{0.65, 0.85, 1.0, 0.28});
        UI.pop_matrix();
    }

    // 6. Inner ring (faster counter-clockwise, smaller, silver-tinted).
    {
        inner_rect := center.grow(210);
        UI.push_matrix(Matrix4.rotate_about_point(inner_rect.center(), -elapsed * 38.0));
        UI.quad(inner_rect, silver_tex, v4.{1, 1, 1, 0.20});
        UI.pop_matrix();
    }

    // 7. Orbital sparks around the rings.
    {
        ORBIT_COUNT :: 6;
        ORBIT_RADIUS :: 260.0;
        for i: 0..ORBIT_COUNT - 1 {
            theta := elapsed * 1.2 + i.(float) * (2.0 * PI / ORBIT_COUNT.(float));
            ox := cos(theta) * ORBIT_RADIUS;
            oy := sin(theta) * ORBIT_RADIUS;
            spark_pos := center.offset(ox, oy);
            spark_pulse := sin(elapsed * 3.0 + i.(float)) * 0.5 + 0.5;
            spark_size := 10.0 + spark_pulse * 6.0;
            // Big soft glow then a hard core for crisp dots.
            UI.quad(spark_pos.grow(spark_size * 3.0), glow_tex, v4.{0.55, 0.80, 1.0, 0.35 * spark_pulse + 0.10});
            UI.quad(spark_pos.grow(spark_size), dot_tex, v4.{0.95, 0.98, 1.0, 0.95});
        }
    }

    // 8. Title text with subtle vertical drift.
    {
        title_bob := sin(elapsed * 1.4) * 3.0;
        title_ts := UI.default_text_settings();
        title_ts.size = 64;
        title_ts.color = v4.{1, 1, 1, 1};
        title_ts.halign = .CENTER;
        title_ts.valign = .CENTER;
        title_ts.do_outline = true;
        title_ts.outline_thickness = 6;
        title_ts.outline_color = v4.{0.02, 0.04, 0.10, 1};
        title_rect := center.offset(0, 60 + title_bob).grow(620);
        UI.text(title_rect, title_ts, "Finding your next game");
    }

    // 9. Three bouncing dots (iMessage style, staggered).
    {
        DOT_HALF :: 12.0;
        DOT_GAP :: 38.0;
        DOTS_Y :: -10.0;
        for i: 0..2 {
            fi := i.(float);
            phase := elapsed * 4.5 - fi * 0.55;
            bob := max(0.0, sin(phase)) * 18.0;
            dot_x := (fi - 1.0) * DOT_GAP;
            dot_pos := center.offset(dot_x, DOTS_Y + bob);
            active := max(0.0, sin(phase));
            // Glow halo behind each dot.
            UI.quad(dot_pos.grow(DOT_HALF * 2.6), glow_tex, v4.{0.45, 0.75, 1.0, 0.18 + active * 0.30});
            // Solid dot core.
            core_alpha := 0.55 + active * 0.45;
            UI.quad(dot_pos.grow(DOT_HALF), dot_tex, v4.{0.88, 0.95, 1.0, core_alpha});
        }
    }

    // 10. Subtitle, gently pulsing.
    {
        sub_pulse := 0.55 + 0.20 * (sin(elapsed * 2.5) * 0.5 + 0.5);
        sub_ts := UI.default_text_settings();
        sub_ts.size = 22;
        sub_ts.color = v4.{sub_pulse, sub_pulse, sub_pulse, 1};
        sub_ts.halign = .CENTER;
        sub_ts.valign = .CENTER;
        sub_ts.do_outline = true;
        sub_ts.outline_thickness = 3;
        sub_ts.outline_color = v4.{0, 0, 0, 0.8};
        sub_rect := center.offset(0, -70).grow(600);
        UI.text(sub_rect, sub_ts, "Hang tight, you'll be matched up shortly");
    }
}
