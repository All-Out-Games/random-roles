// Hub constants + helpers.
//
// IMPORTANT: This repo contains two Platform projects (see `ao.project`).
// We branch behavior at runtime using `Game.get_game_id()` so hub logic
// does not run in the main Random Roles game.

HUB_GAME_ID :: "692f424cd0b237adf50fdab0";
MAIN_GAME_ID :: "6967701e32138407e7f2590f";

STAGING_HUB_GAME_ID :: "69a5d8e2058efef5b1fe759f";

HUB_WALK_SPEED_MULTIPLIER :: 2.0;
HUB_CAMERA_SIZE_MULTIPLIER :: 1.12;
HUB_PORTAL_INDICATOR_MIN_DISTANCE :: 2.5;

rr_is_hub_game :: proc() -> bool {
    return Game.get_game_id() == HUB_GAME_ID || Game.get_game_id() == STAGING_HUB_GAME_ID;
}
