            append(ref results, Rg_Ability_Entry.{"sprites/icons/lily/String_Icon.png",            "String",          "Attach a string to a player to track them and fulfill tree requests with them."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/lily/Hair_Tree_Icon.png",         "Plant Tree",      "One-time. Plant your Hair Tree - your permanent base. Fulfill its requests to grow it and unlock new powers."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/lily/Hair_Tree_Icon.png",         "Tree Requests",   "Offer in order: Corpse, Eyes, Legs, Alive Player, Legs & Eyes, Eyeless-Legless Player. Each grows the tree and buffs you."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/lily/Braid_Trap_Icon.png",        "String Trap",     "1 request. Lay a trap - players who walk over it get strung and can be dragged to the tree alive."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/lily/Suction_Tube_Icon.png",      "Steal Eyes",      "Deploy a machine that temporarily extracts a target's eyes. Pick up the dropped eyes to offer them to the tree."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/lily/Braid_Point_Icon.png",       "Steal Legs",      "Send a spider to temporarily chomp a target's legs. Pick up the dropped legs to offer them to the tree."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/lily/Dollhouse_Icon.png",         "Mind Control",    "3 requests. Possess a player and puppet their body. Release to return."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/lily/Tea_Party_Icon.png",         "Tea Party",       "4 requests. Invite a strung player to tea. They pick 1 of 3 cups - caffeine, poison, or empty."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/lily/Hair_Tree_Icon.png",         "Deathbraid",      "6 requests. Summon a vortex that pulls in and devours every living player. Ultimate win button."});
        }
    }
}

rg_is_role_locked :: proc(player: Player, idx: int) -> bool {
    switch idx {
        case 13: return !Purchasing.owns_product(player, GGG_PRODUCT_ID);
        case 14: return !Purchasing.owns_product(player, MIMICER_PRODUCT_ID);
        case 15: return !Purchasing.owns_product(player, BIG_CHARLIE_PRODUCT_ID);
        case 16: return !Purchasing.owns_product(player, LILY_PRODUCT_ID);
    }
    return false;
}

rg_get_role_product_id :: proc(idx: int) -> string {
    switch idx {
        case 13: return GGG_PRODUCT_ID;
        case 14: return MIMICER_PRODUCT_ID;
        case 15: return BIG_CHARLIE_PRODUCT_ID;
        case 16: return LILY_PRODUCT_ID;
    }
    return "";
}

rg_get_role_price :: proc(idx: int) -> string {
    pid := rg_get_role_product_id(idx);
    if pid == "" return "";
    product := Purchasing.get_product(pid);
    return format_string("%", {product.price});
}

rg_get_role_difficulty_stars :: proc(idx: int) -> int {
    d := rg_get_role_difficulty(idx);
    if d == "HARD"   return 3;
    if d == "MEDIUM" return 2;
    return 1;
}

rg_get_role_tips :: proc(idx: int) -> string {
    switch idx {
        case 1:  return "Announce yourself early to build trust. Shooting innocents backfires!";
        case 2:  return "Stay hidden and alive - you're the civilians' lifeline.";
        case 3:  return "Your double vote is powerful. Rally civilians to your side.";
        case 4:  return "Place autographs in doorways for maximum stun coverage.";
        case 5:  return "Collect DNA early. You need samples before you can match suspects.";
        case 6:  return "Place portals near objectives to save civilians or trap traitors.";
        case 7:  return "Blend in early. Your goal is to get voted out - act suspicious!";
        case 8:  return "Focus on burning rooms from your task list, not fighting.";
        case 10: return "Loot bodies for treasure maps to unlock your strongest abilities.";
        case 11: return "Neck snap for silent kills. Build kills to unlock mines and sniper.";
        case 12: return "Schleem form to blend in, wolf form to hunt. Switch wisely!";
        case 13: return "Place your nest early and drag bodies to it. More nest points = more abilities!";
        case 14: return "Stash a corpse at a Void Pillar to mimic the victim. Stack stolen faces fast for Unleash.";
        case 15: return "Plant nuggets early so Scouting reveals the map, then cocoon and incubate every remaining player to unlock Mass Birth.";
        case 16: return "Plant your tree somewhere safe and feed it requests in order. String victims to track and reuse them.";
    }
    return "";
}

// ---- Main panel (UIK) ----

draw_roles_guide :: proc(player: Player) {
    if !player.roles_guide_open return;

    // Full-screen dim behind the modal (covers HUD too)
    UI.push_layer(999);
    UI.quad(UI.get_screen_rect(), core_globals.white_sprite, v4.{0, 0, 0, 0.76});
    UI.pop_layer();

    UIK.begin(UIK.modal(UIK.rect_window_large(), 1000, v4.{0, 0, 0, 0}));

    shell := UIK.panel_modal(.BLACK);
    shell.padding = v4.{12, 14, 12, 14};
    shell.gap = 8;
    UIK.panel_begin(shell);

    exit_handle := UIK.title_area(UIK.title_area_desc("ROLES GUIDE"));

    // Body row: left list / right detail
    tab_handles:   [..]UIK.Interact_Handle;
    list_handles:  [..]UIK.Interact_Handle;
    list_role_ids: [..]int;

    body := UIK.layout_row();
    body.width  = UIK.flex(1);
    body.height = UIK.flex(1);
    body.gap    = 12;
    body.show_background = false;
    UIK.panel_begin(body);

    // Left: tabs + scrollable role list
    left := UIK.panel_interior(.INSET);
    left.width   = UIK.pixels(360);
    left.height  = UIK.flex(1);
    left.padding = v4.{10, 10, 10, 10};
    left.gap     = 8;
    UIK.panel_begin(left);
    rg_draw_filter_tabs(player, ref tab_handles);
    rg_draw_role_list_uik(player, ref list_handles, ref list_role_ids);
    UIK.panel_end();

    // Right: detail
    buy_present:  bool;
    buy_handle:   UIK.Interact_Handle;
    buy_role_idx: int;
    right := UIK.panel_interior(.INSET);
    right.width   = UIK.flex(1);
    right.height  = UIK.flex(1);
    right.padding = v4.{14, 14, 14, 14};
    UIK.panel_begin(right);
    rg_draw_role_detail_uik(player, ref buy_present, ref buy_handle, ref buy_role_idx);
    UIK.panel_end();

    UIK.panel_end(); // body
    UIK.panel_end(); // shell
    UIK.end();

    // Resolve handles
    if UIK.clicked(exit_handle) {
        player.roles_guide_open = false;
    }
    for t: 0..tab_handles.count - 1 {
        if UIK.clicked(tab_handles[t]) {
            player.roles_guide_filter = t;
        }
    }
    for i: 0..list_handles.count - 1 {
        if UIK.clicked(list_handles[i]) {
            player.roles_guide_selected = list_role_ids[i];
        }
    }
    if buy_present && UIK.clicked(buy_handle) {
        pid := rg_get_role_product_id(buy_role_idx);
        if pid != "" Purchasing.prompt_purchase(player, pid);
    }

    // If filter hides current selection, snap to first visible role.
    rg_ensure_visible_selection(player);
}

// Display order ensures team groupings stay contiguous in the list (anarchist
// roles 7, 8, 15 are visited before the traitor section 10..16, otherwise the
// list iteration would emit a second ANARCHIST header below TRAITOR).
rg_get_display_order :: proc(out: ref [..]int) {
    append(ref out, 1);
    append(ref out, 2);
    append(ref out, 3);
    append(ref out, 4);
    append(ref out, 5);
    append(ref out, 6);
    append(ref out, 7);
    append(ref out, 8);
    append(ref out, 15);
    append(ref out, 10);
    append(ref out, 11);
    append(ref out, 12);
    append(ref out, 13);
    append(ref out, 14);
    append(ref out, 16);
}

rg_ensure_visible_selection :: proc(player: Player) {
    if player.roles_guide_filter <= 0 return;

    sel_team := rg_get_role_team(player.roles_guide_selected);
    filter_team := "CIVILIAN";
    if player.roles_guide_filter == 2 filter_team = "ANARCHIST";
    if player.roles_guide_filter == 3 filter_team = "TRAITOR";
    if sel_team == filter_team return;

    order: [..]int;
    rg_get_display_order(ref order);
    for oi: 0..order.count - 1 {
        fi := order[oi];
        if rg_get_role_team(fi) == filter_team {
            player.roles_guide_selected = fi;
            return;
        }
    }
}

// ---- Filter tabs ----

rg_draw_filter_tabs :: proc(player: Player, handles: ref [..]UIK.Interact_Handle) {
    row := UIK.layout_row();
    row.width  = UIK.flex(1);
    row.height = UIK.fit();
    row.gap    = 6;
    row.show_background = false;
    UIK.panel_begin(row);

    for ti: 0..3 {
        is_active := player.roles_guide_filter == ti;

        bg: UIK.Panel_Background_Kind = .BUTTON_BASIC_GREY;
        if is_active {
            if ti == 0 bg = .BUTTON_BASIC_GREY;
            if ti == 1 bg = .BUTTON_BASIC_GREEN;
            if ti == 2 bg = .BUTTON_BASIC_YELLOW1;
            if ti == 3 bg = .BUTTON_BASIC_RED;
        }

        label := "ALL";
        if ti == 1 label = "CIV";
        if ti == 2 label = "ANA";
        if ti == 3 label = "TRA";

        d := UIK.widget_desc_button_default(bg);
        d.panel.width   = UIK.flex(1);
        d.panel.height  = UIK.pixels(56);
        d.panel.padding = v4.{12, 14, 12, 14};
        UIK.text_set_halign(&d.label_text, .CENTER);
        UIK.text_set_valign(&d.label_text, .CENTER);
        UIK.text_set_word_wrap(&d.label_text, false);

        h := UIK.button(format_string("rg_tab_%", {ti}), label, d);
        append(ref handles, h);
    }

    UIK.panel_end();
}

// ---- Left: role list ----

rg_draw_role_list_uik :: proc(player: Player, handles: ref [..]UIK.Interact_Handle, role_ids: ref [..]int) {
    list := UIK.layout_column();
    list.width  = UIK.flex(1);
    list.height = UIK.flex(1);
    list.gap    = 2;
    list.show_background = false;
    UIK.list_begin("rg_role_list", list);

    order: [..]int;
    rg_get_display_order(ref order);

    prev_team := "";
    for oi: 0..order.count - 1 {
        i := order[oi];

        team := rg_get_role_team(i);
        if player.roles_guide_filter == 1 && team != "CIVILIAN"  continue;
        if player.roles_guide_filter == 2 && team != "ANARCHIST" continue;
        if player.roles_guide_filter == 3 && team != "TRAITOR"   continue;

        if team != prev_team {
            if prev_team.count > 0 {
                UIK.spacer(UIK.pixels(1), UIK.pixels(2));
            }
            hdr := UIK.layout_row();
            hdr.width   = UIK.flex(1);
            hdr.height  = UIK.fit();
            hdr.padding = v4.{2, 4, 2, 4};
            hdr.show_background = false;
            UIK.panel_begin(hdr);
            hdr_ts := UIK.text_body();
            UIK.text_set_color(&hdr_ts, rg_get_role_color(i));
            UIK.text_set_halign(&hdr_ts, .LEFT);
            UIK.text_set_word_wrap(&hdr_ts, false);
            UIK.text(team, hdr_ts);
            UIK.panel_end();
            prev_team = team;
        }

        rg_draw_role_list_row(player, i, ref handles, ref role_ids);
    }

    UIK.list_end();
}

rg_draw_role_list_row :: proc(player: Player, role_idx: int, handles: ref [..]UIK.Interact_Handle, role_ids: ref [..]int) {
    is_selected := player.roles_guide_selected == role_idx;
    is_locked   := rg_is_role_locked(player, role_idx);

    bg: UIK.Panel_Background_Kind = .BUTTON_BASIC_BLACK;
    if is_selected {
        team_idx := loadout_team_for_role(role_idx);
        if team_idx >= 0 {
            bg = loadout_tab_active_bg(team_idx);
        } else {
            // Roles outside the loadout selector (e.g. Big Charlie) still
            // colour their selection background by team.
            sel_team := rg_get_role_team(role_idx);
            if sel_team == "ANARCHIST" {
                bg = .BUTTON_BASIC_YELLOW1;
            } else if sel_team == "TRAITOR" {
                bg = .BUTTON_BASIC_RED;
            } else if sel_team == "CIVILIAN" {
                bg = .BUTTON_BASIC_GREEN;
            } else {
                bg = .BUTTON_BASIC_GREY;
            }
        }
    }

    row := UIK.layout_row();
    row.width   = UIK.flex(1);
    row.height  = UIK.pixels(56);
    row.gap     = 8;
    row.padding = v4.{6, 10, 6, 10};
    row.cross_align    = .CENTER;
    row.background     = bg;
    row.show_background = true;

    h := UIK.panel_begin_interactive(format_string("rg_row_%", {role_idx}), row);
    append(ref handles,  h);
    append(ref role_ids, role_idx);

    // Small role icon
    icon_box := UIK.layout_column();
    icon_box.width  = UIK.pixels(40);
    icon_box.height = UIK.pixels(40);
    icon_box.show_background = false;
    UIK.panel_begin(icon_box);
    icon_tex := get_asset(Texture_Asset, loadout_get_role_small_icon(role_idx));
    if icon_tex != null {
        tint := v4.{1, 1, 1, 1};
        if is_locked tint = v4.{0.5, 0.5, 0.5, 1};
        UIK.image_fitted(icon_tex, UIK.image_desc(.CONTAIN), tint);
    }
    UIK.panel_end();

    // Name (flex)
    name_col := UIK.layout_column();
    name_col.width  = UIK.flex(1);
    name_col.height = UIK.flex(1);
    name_col.main_align = .CENTER;
    name_col.show_background = false;
    UIK.panel_begin(name_col);

    name_color := v4.{1, 1, 1, 1};
    if is_locked name_color = v4.{0.6, 0.6, 0.6, 1};
    name_ts := UIK.text_body();
    UIK.text_set_color(&name_ts, name_color);
    UIK.text_set_halign(&name_ts, .LEFT);
    UIK.text_set_word_wrap(&name_ts, false);
    UIK.text(rg_get_role_name(role_idx), name_ts);

    UIK.panel_end();

    // Lock icon
    if is_locked {
        lock_box := UIK.layout_column();
        lock_box.width  = UIK.pixels(20);
        lock_box.height = UIK.pixels(20);
        lock_box.show_background = false;
        UIK.panel_begin(lock_box);
        lock_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/lock_closed.png");
        if lock_tex != null {
            UIK.image_fitted(lock_tex, UIK.image_desc(.CONTAIN), v4.{1, 0.85, 0.3, 1});
        }
        UIK.panel_end();
    }

    // Stars (fixed-width slot so it doesn't fight name flex)
    stars_wrap := UIK.layout_column();
    stars_wrap.width  = UIK.pixels(60);
    stars_wrap.height = UIK.fit();
    stars_wrap.show_background = false;
    UIK.panel_begin(stars_wrap);
    loadout_draw_stars_row(rg_get_role_difficulty_stars(role_idx), 3, 16.0, false);
    UIK.panel_end();

    UIK.panel_end(); // row
}

// ---- Right: role detail ----

rg_draw_role_detail_uik :: proc(player: Player, buy_present: ref bool, buy_handle: ref UIK.Interact_Handle, buy_role_idx: ref int) {
    idx := player.roles_guide_selected;
    if idx < 1 idx = 1;

    is_locked := rg_is_role_locked(player, idx);
    buy_role_idx = idx;

    content := UIK.layout_column();
    content.width  = UIK.flex(1);
    content.height = UIK.flex(1);
    content.gap    = 8;
    content.show_background = false;
    UIK.list_begin("rg_detail_scroll", content);

    // ---- Header card: [team] [icon w/ name overlay] [stars] ----
    header := UIK.layout_row();
    header.width   = UIK.flex(1);
    header.height  = UIK.fit();
    header.padding = v4.{16, 48, 16, 48};
    header.gap     = 48;
    header.main_align  = .CENTER;
    header.cross_align = .CENTER;
    header.background      = .BUTTON_BASIC_BLACK;
    header.show_background = true;
    UIK.panel_begin(header);

    // Team label (left)
    team_ts := UIK.text_body();
    UIK.text_set_color(&team_ts, rg_get_role_color(idx));
    UIK.text_set_halign(&team_ts, .CENTER);
    UIK.text_set_valign(&team_ts, .CENTER);
    UIK.text_set_word_wrap(&team_ts, false);
    UIK.text_set_size_mult(&team_ts, 1.0);
    UIK.text(rg_get_role_team(idx), team_ts);

    // Icon + name overlay (center)
    icon_box := UIK.layout_column();
    icon_box.width  = UIK.pixels(140);
    icon_box.height = UIK.pixels(140);
    icon_box.show_background = false;
    UIK.panel_begin(icon_box);
    icon_tex := get_asset(Texture_Asset, loadout_get_role_small_icon(idx));
    if icon_tex != null {
        UIK.image_fitted(icon_tex, UIK.image_desc(.CONTAIN));
    }

    UIK.overlay_begin(.BOTTOM_CENTER, v2.{0, -4});
    name_ts := UIK.text_body();
    UIK.text_set_color(&name_ts, v4.{1, 1, 1, 1});
    UIK.text_set_halign(&name_ts, .CENTER);
    UIK.text_set_valign(&name_ts, .CENTER);
    UIK.text_set_word_wrap(&name_ts, false);
    UIK.text_set_size_mult(&name_ts, 1.15);
    UIK.text(rg_get_role_name(idx), name_ts);
    UIK.overlay_end();

    UIK.panel_end(); // icon_box

    // Stars (right)
    stars_row := UIK.layout_row();
    stars_row.width   = UIK.fit();
    stars_row.height  = UIK.fit();
    stars_row.gap     = 3;
    stars_row.cross_align = .CENTER;
    stars_row.show_background = false;
    UIK.panel_begin(stars_row);
    star_gold  := get_asset(Texture_Asset, "ui/star_gold 2.png");
    star_empty := get_asset(Texture_Asset, "ui/star_empty2 2.png");
    diff := rg_get_role_difficulty_stars(idx);
    for si: 0..2 {
        tex := star_empty;
        if si < diff tex = star_gold;
        slot := UIK.layout_column();
        slot.width  = UIK.pixels(24);
        slot.height = UIK.pixels(24);
        slot.show_background = false;
        UIK.panel_begin(slot);
        if tex != null UIK.image_fitted(tex, UIK.image_desc(.CONTAIN));
        UIK.panel_end();
    }
    UIK.panel_end(); // stars_row

    UIK.panel_end(); // header

    // ---- Locked banner + Buy CTA ----
    if is_locked {
        banner := UIK.layout_row();
        banner.width   = UIK.flex(1);
        banner.height  = UIK.fit();
        banner.gap     = 8;
        banner.padding = v4.{8, 12, 8, 12};
        banner.cross_align     = .CENTER;
        banner.background      = .MODAL_TRANSP_BLACK;
        banner.show_background = true;
        UIK.panel_begin(banner);

        lock_box := UIK.layout_column();
        lock_box.width  = UIK.pixels(20);
        lock_box.height = UIK.pixels(20);
        lock_box.show_background = false;
        UIK.panel_begin(lock_box);
        lock_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/lock_closed.png");
        if lock_tex != null {
            UIK.image_fitted(lock_tex, UIK.image_desc(.CONTAIN), v4.{1, 0.85, 0.3, 1});
        }
        UIK.panel_end();

        lock_ts := UIK.text_body();
        UIK.text_set_color(&lock_ts, v4.{1, 0.85, 0.3, 1});
        UIK.text_set_halign(&lock_ts, .LEFT);
        UIK.text_set_word_wrap(&lock_ts, false);
        UIK.text("LOCKED", lock_ts);

        UIK.panel_end();

        price := rg_get_role_price(idx);
        pid   := rg_get_role_product_id(idx);
        if price.count > 0 && pid.count > 0 {
            btn := UIK.panel_styled(.BUTTON_BASIC_GREEN);
            btn.axis        = .HORIZONTAL;
            btn.width       = UIK.flex(1);
            btn.height      = UIK.pixels(64);
            btn.padding     = v4.{10, 18, 22, 18};
            btn.gap         = 8;
            btn.main_align  = .CENTER;
            btn.cross_align = .CENTER;
            buy_handle  = UIK.panel_begin_interactive("rg_buy", btn);
            buy_present = true;

            spark_box := UIK.layout_column();
            spark_box.width  = UIK.pixels(24);
            spark_box.height = UIK.pixels(24);
            spark_box.show_background = false;
            UIK.panel_begin(spark_box);
            sparks_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/sparks/spark_small.png");
            if sparks_tex != null {
                UIK.image_fitted(sparks_tex, UIK.image_desc(.CONTAIN), v4.{1, 0.9, 0.3, 1});
            }
            UIK.panel_end();

            buy_ts := UIK.text_body();
            UIK.text_set_color(&buy_ts, v4.{1, 1, 1, 1});
            UIK.text_set_halign(&buy_ts, .CENTER);
            UIK.text_set_valign(&buy_ts, .CENTER);
            UIK.text_set_word_wrap(&buy_ts, false);
            UIK.text_set_size_mult(&buy_ts, 1.1);
            UIK.text(format_string("Unlock for % Sparks", {price}), buy_ts);

            UIK.panel_end(); // btn
        }
    }

    // ---- Description ----
    desc_panel := UIK.layout_column();
    desc_panel.width   = UIK.flex(1);
    desc_panel.height  = UIK.fit();
    desc_panel.padding = v4.{12, 14, 12, 14};
    desc_panel.show_background = false;
    UIK.panel_begin(desc_panel);
    desc_ts := UIK.text_body();
    UIK.text_set_color(&desc_ts, v4.{0.9, 0.9, 0.95, 1});
    UIK.text_set_halign(&desc_ts, .CENTER);
    UIK.text_set_word_wrap(&desc_ts, true);
    UIK.text(rg_get_role_description(idx), desc_ts);
    UIK.panel_end();

    // ---- Tips ----
    tips := rg_get_role_tips(idx);
    if tips.count > 0 {
        tips_panel := UIK.panel_styled(.MODAL_TRANSP_BLACK);
        tips_panel.width   = UIK.flex(1);
        tips_panel.height  = UIK.fit();
        tips_panel.padding = v4.{10, 12, 10, 12};
        UIK.panel_begin(tips_panel);
        tips_ts := UIK.text_body();
        UIK.text_set_color(&tips_ts, v4.{0.95, 0.88, 0.45, 1});
        UIK.text_set_halign(&tips_ts, .LEFT);
        UIK.text_set_word_wrap(&tips_ts, true);
        UIK.text(format_string("TIP: %", {tips}), tips_ts);
        UIK.panel_end();
    }

    // ---- Abilities ----
    UIK.spacer(UIK.pixels(1), UIK.pixels(4));
    ab_label_ts := UIK.text_body();
    UIK.text_set_color(&ab_label_ts, v4.{0.65, 0.65, 0.7, 1});
    UIK.text_set_halign(&ab_label_ts, .LEFT);
    UIK.text_set_word_wrap(&ab_label_ts, false);
    UIK.text("ABILITIES", ab_label_ts);
    UIK.spacer(UIK.pixels(1), UIK.pixels(2));

    ab_entries: [..]Rg_Ability_Entry;
    rg_get_role_abilities(idx, ref ab_entries);

    if ab_entries.count == 0 {
        empty := UIK.layout_column();
        empty.width   = UIK.flex(1);
        empty.height  = UIK.pixels(40);
        empty.main_align  = .CENTER;
        empty.cross_align = .CENTER;
        empty.show_background = false;
        UIK.panel_begin(empty);
        no_ts := UIK.text_body();
        UIK.text_set_color(&no_ts, v4.{0.5, 0.5, 0.55, 1});
        UIK.text_set_halign(&no_ts, .CENTER);
        UIK.text("No special abilities.", no_ts);
        UIK.panel_end();
    } else {
        for i: 0..ab_entries.count - 1 {
            rg_draw_ability_row(ab_entries[i]);
        }
    }

    UIK.list_end();
}

rg_draw_ability_row :: proc(entry: Rg_Ability_Entry) {
    row := UIK.layout_row();
    row.width   = UIK.flex(1);
    row.height  = UIK.fit();
    row.gap     = 12;
    row.padding = v4.{8, 10, 8, 10};
    row.cross_align = .START;
    row.background      = .MODAL_TRANSP_BLACK;
    row.show_background = true;
    UIK.panel_begin(row);

    // Icon
    icon_box := UIK.layout_column();
    icon_box.width  = UIK.pixels(48);
    icon_box.height = UIK.pixels(48);
    icon_box.show_background = false;
    UIK.panel_begin(icon_box);
    if entry.icon_path.count > 0 {
        icon_tex := get_asset(Texture_Asset, entry.icon_path);
        if icon_tex != null {
            UIK.image_fitted(icon_tex, UIK.image_desc(.CONTAIN));
        }
    }
    UIK.panel_end();

    // Name + desc
    info := UIK.layout_column();
    info.width  = UIK.flex(1);
    info.height = UIK.fit();
    info.gap    = 2;
    info.show_background = false;
    UIK.panel_begin(info);

    name_ts := UIK.text_body();
    UIK.text_set_color(&name_ts, v4.{1, 1, 1, 1});
    UIK.text_set_halign(&name_ts, .LEFT);
    UIK.text_set_size_mult(&name_ts, 1.1);
    UIK.text_set_word_wrap(&name_ts, false);
    UIK.text(entry.name, name_ts);

    desc_ts := UIK.text_body();
    UIK.text_set_color(&desc_ts, v4.{0.8, 0.8, 0.85, 0.9});
    UIK.text_set_halign(&desc_ts, .LEFT);
    UIK.text_set_word_wrap(&desc_ts, true);
    UIK.text(entry.desc, desc_ts);

    UIK.panel_end(); // info
    UIK.panel_end(); // row
}

// ---- Open/close button (drawn in HUD) ----

draw_roles_guide_open_button :: proc(player: Player) {
    UI.push_id("rg_open_btn");
    defer UI.pop_id();

    BTN_HALF :: 60.0;
    safe     := UI.get_safe_screen_rect();
    btn_rect := safe.right_center_rect().offset(-(BTN_HALF + 16.0), 0).grow(BTN_HALF);

    bs := UI.default_button_settings();
    bs.sprite        = get_asset(Texture_Asset, "ui/info_icon_b.png");
    bs.press_scaling = 0.35;
    bs.color         = v4.{1, 1, 1, 1};
    bs.hovered_color = v4.{1, 1, 1, 1};
    bs.pressed_color = v4.{0.6, 0.6, 0.6, 1};

    if UI.button(btn_rect, bs, UI.default_text_settings(), "").clicked {
        player.roles_guide_open = !player.roles_guide_open;
    }

    // "Role Guide" label below the icon
    label_ts := UI.default_text_settings();
    label_ts.size              = 28;
    label_ts.color             = v4.{1, 1, 1, 0.9};
    label_ts.halign            = .CENTER;
    label_ts.valign            = .TOP;
    label_ts.do_outline        = true;
    label_ts.outline_thickness = 4;
    label_ts.outline_color     = v4.{0, 0, 0, 1};
    label_rect := btn_rect.bottom_rect().offset(0, -10).grow_unscaled(18, 70, 0, 70);
    UI.text(label_rect, label_ts, "Role Guide");
}
