RG_NUM_ROLES :: 17;

Rg_Ability_Entry :: struct {
    icon_path: string;
    name:      string;
    desc:      string;
}

rg_get_role_name :: proc(idx: int) -> string {
    switch idx {
        case 0:  return "CREW";
        case 1:  return "SHERIFF";
        case 2:  return "DOCTOR";
        case 3:  return "PRESIDENT";
        case 4:  return "MOVIE STAR";
        case 5:  return "CORONER";
        case 6:  return "WARPER";
        case 7:  return "PRANKSTER";
        case 8:  return "PYROMANIAC";
        case 9:  return "TRAITOR";
        case 10: return "PIRATE";
        case 11: return "HITMAN";
        case 12: return "WEREWOLF";
        case 13: return "GOO GOO GAGA";
        case 14: return "MIMICER";
        case 15: return "BIG CHARLIE";
        case 16: return "LILY";
    }
    return "UNKNOWN";
}

rg_get_role_team :: proc(idx: int) -> string {
    if idx == 15             return "ANARCHIST";
    if idx >= 7 && idx <= 8 return "ANARCHIST";
    if idx >= 9               return "TRAITOR";
    return "CIVILIAN";
}

rg_get_role_color :: proc(idx: int) -> v4 {
    if idx == 15             return v4.{0.9,  0.55, 0.1,  1.0};
    if idx >= 7 && idx <= 8 return v4.{0.9,  0.55, 0.1,  1.0};
    if idx >= 9               return v4.{0.95, 0.2,  0.2,  1.0};
    return                         v4.{0.1,  0.9,  0.3,  1.0};
}

rg_get_team_badge_bg :: proc(idx: int) -> v4 {
    if idx == 15             return v4.{0.20, 0.12, 0.02, 0.75};
    if idx >= 7 && idx <= 8 return v4.{0.20, 0.12, 0.02, 0.75};
    if idx >= 9               return v4.{0.20, 0.04, 0.04, 0.75};
    return                         v4.{0.03, 0.20, 0.06, 0.75};
}

rg_get_role_muted_color :: proc(idx: int) -> v4 {
    if idx == 15             return v4.{0.34, 0.24, 0.10, 1.0};
    if idx >= 7 && idx <= 8 return v4.{0.34, 0.24, 0.10, 1.0};
    if idx >= 9               return v4.{0.36, 0.14, 0.14, 1.0};
    return                         v4.{0.14, 0.30, 0.18, 1.0};
}

rg_get_role_icon :: proc(idx: int) -> string {
    switch idx {
        case 1:  return "sprites/icons/revolver.png";
        case 2:  return "sprites/icons/doctor/revive.png";
        case 4:  return "sprites/icons/movie_star/write_signature.png";
        case 7:  return "sprites/icons/trickster/prank.png";
        case 9:  return "sprites/icons/kill_ability.png";
        case 10: return "sprites/icons/pirate/black_flag.png";
        case 11: return "sprites/icons/kill_ability.png";
        case 12: return "sprites/icons/kill_ability.png";
        case 13: return "sprites/icons/transform_evil.png";
        case 15: return "sprites/icons/big_charlie/Big_Charlie.png";
    }
    return "";
}

rg_get_role_description :: proc(idx: int) -> string {
    switch idx {
        case 0:  return "Complete your tasks and help civilians identify and vote out the traitors before they eliminate everyone.";
        case 1:  return "The station's law enforcer. You carry a gun and can shoot suspected traitors. Be careful - shooting an innocent has consequences.";
        case 2:  return "The civilians' medic. Resurrect fallen civilians and bring them back into the game. Use your power wisely to turn the tide.";
        case 3:  return "A high-value civilian. Your votes count double - use it to outplay traitors in close meetings.";
        case 4:  return "A beloved celebrity. Hand out autographs to players - anyone who walks over them gets stunned!";
        case 5:  return "The forensic investigator. Collect DNA samples from dead bodies and match them against living players to find killers.";
        case 6:  return "A spatial engineer who bends space. Place two portals anywhere on the map - players who enter one exit through the other.";
        case 7:  return "A chaotic wild card. Prank players, call fake meetings, and get someone voted out. Cause enough chaos to unlock the Jester Win!";
        case 8:  return "A fire-obsessed anarchist. Set rooms ablaze and ignite corpses to destroy evidence. Burn enough to unlock World Fire and win!";
        case 9:  return "Sabotage the station, eliminate civilians, and avoid suspicion. Work together with fellow traitors to win.";
        case 10: return "A swashbuckling traitor. Loot treasure maps from bodies and dig for buried treasure to unlock powerful new abilities.";
        case 11: return "A cold and calculating assassin. Silently snap necks up close. Rack up kills to unlock proximity mines and a sniper rifle.";
        case 12: return "A shape-shifting beast hiding among civilians. Switch between schleem and wolf form. Earn kills to unlock Infect and Claw.";
        case 13: return "A horrifying creature hiding in plain sight. Place a nest and consume bodies to earn nest points that unlock powerful abilities. Transform, crawl, lay traps, whip targets, and summon swarms.";
        case 14: return "A shape-shifting predator. Kill civilians and corrupt their corpses at Void Pillars to steal faces. Each stolen face unlocks new powers - Void Lunge, Spew Corruption, and the devastating Unleash.";
        case 15: return "A solo Anarchist horror. Plant 5 Lil' Nuggets around the map and infect every other living player with Flesh Cocoons. Once nobody is left to infect, Mass Birth turns every victim into a mini Big Charlie and stampedes the round into your win.";
        case 16: return "A predatory weaver. String civilians to track them, then plant your Hair Tree as your permanent base. Feed the tree its requested offerings (corpses, eyes, legs, strung victims) to grow it and unlock stronger abilities - Tea Party, Mind Control, and the ultimate Deathbraid.";
    }
    return "";
}

rg_get_role_difficulty :: proc(idx: int) -> string {
    switch idx {
        case 0:  return "EASY";
        case 1:  return "MEDIUM";
        case 2:  return "MEDIUM";
        case 3:  return "EASY";
        case 4:  return "EASY";
        case 5:  return "HARD";
        case 6:  return "MEDIUM";
        case 7:  return "HARD";
        case 8:  return "HARD";
        case 9:  return "MEDIUM";
        case 10: return "MEDIUM";
        case 11: return "HARD";
        case 12: return "MEDIUM";
        case 13: return "HARD";
        case 14: return "HARD";
        case 15: return "HARD";
        case 16: return "HARD";
    }
    return "EASY";
}

rg_get_role_difficulty_color :: proc(idx: int) -> v4 {
    d := rg_get_role_difficulty(idx);
    if d == "HARD"   return v4.{1.0, 0.35, 0.25, 1.0};
    if d == "MEDIUM" return v4.{1.0, 0.78, 0.2,  1.0};
    return v4.{0.4, 0.9, 0.4, 1.0};
}

rg_get_role_abilities :: proc(idx: int, results: ref [..]Rg_Ability_Entry) {
    switch idx {
        case 1: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/revolver.png",               "Shoot",        "Fire your gun at a target. Friendly fire has consequences."});
        }
        case 2: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/doctor/revive.png",          "Resurrect",    "Revive a fallen civilian and bring them back to life."});
        }
        case 4: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/movie_star/write_signature.png", "Autograph", "Sign an autograph on the ground. Players who walk over it get stunned."});
        }
        case 5: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/coroner/ability_take_dna.png",    "DNA Sample",   "Collect a DNA sample from a dead body."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/coroner/ability_compare_dna.png", "DNA Match",    "Compare collected DNA against a living player to identify killers."});
        }
        case 6: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/portal_maker/red_portal.png",  "Red Portal",   "Shoot a bolt to place the red end of your portal."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/portal_maker/blue_portal.png", "Blue Portal",  "Shoot a bolt to place the blue end of your portal."});
        }
        case 7: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/trickster/prank.png",        "Prank",        "Prank other players to make them fall!"});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/trickster/call_fake.png",    "Fake Meeting", "Call a fake emergency meeting and get someone voted out!"});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/trickster/jester.png",       "Jester Win",   "Unlocked after enough chaos. Prank everyone and win!"});
        }
        case 8: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pyro/set_fire.png",      "Light Fire",   "Set fire to objects in rooms on your task list to start a room blaze."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pyro/light_corpse.png",  "Light Corpse", "Ignite a nearby dead body to destroy evidence."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pyro/worldfire.png",     "World Fire",   "Unlocked after burning enough. Engulf the entire station in flames!"});
        }
        case 9: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/kill_ability.png",           "Kill",         "Eliminate a nearby civilian up close."});
        }
        case 10: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/kill_ability.png",                "Kill",            "Eliminate a nearby civilian."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pirate/dig_for_treasure.png",     "Dig Treasure",    "Loot treasure maps from bodies and dig for buried treasure."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pirate/black_flag.png",           "Black Flag",      "Plant a flag that blinds nearby enemies with thick fog."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pirate/flintlock_pistol.png",     "Shoot",           "Unlocked with treasure. Fire your pistol at range."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pirate/powder_keg.png",           "Powder Keg",      "Unlocked with treasure. Place an explosive barrel that detonates after a delay."});
        }
        case 11: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/hitman/knee_snap.png",            "Neck Snap",       "Silently eliminate a nearby target. Replaces the default kill."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/hitman/land_mine.png",            "Proximity Mine",  "Unlocked with kills. Place a hidden mine that detonates when enemies walk over it."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/hitman/sniper_rifle.png",         "Sniper Rifle",    "Unlocked with kills. Eliminate targets from long range."});
        }
        case 12: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/werewolf/devour.png",             "Kill",            "Eliminate a nearby civilian."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/werewolf/infecting_bite.png",     "Infect",          "Unlocked with kills. Bite a civilian to turn them into a werewolf."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/werewolf/claw_slash.png",         "Claw",            "Unlocked with kills. Slash at nearby enemies with deadly claws."});
        }
        case 13: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/Nest_icon.png",               "Place Nest",      "Place a nest to consume bodies and earn nest points for new abilities."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/transform_evil.png",              "Transform",       "Switch between schleem and creature form. Creature form is invisible."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/kill_wrap_player.png",        "Kill",            "Eliminate a nearby civilian. Drag bodies to the nest to consume them."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/crawl_speedup.png",           "Crawl",           "Unlocked with 1 nest point. Shrink down and move faster."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/santa_trap.png",              "Trap",            "Place a chocolate trap that roots and blinds civilians."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/kill_wrap_player.png",        "Foil Whip",       "Unlocked with 2 nest points. Fire a projectile that pulls targets to you."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/swarm.png",                   "Swarm",           "Unlocked with 4 nest points. Summon decoy creatures from the nest."});
        }
        case 14: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/transform_evil.png",              "Transform",       "Toggle between schleem and monster form. Monster form grants 115%% move speed."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/mimicer/prowl.png",               "Prowl",           "Toggle stealth mode. Move slower, but become near-invisible when close to walls."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/mimicer/kill_purple_slash.png",   "Kill",            "Eliminate a nearby civilian. Corrupt their corpse at a Void Pillar to steal their face."});
