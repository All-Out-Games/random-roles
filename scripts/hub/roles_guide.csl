RG_NUM_ROLES :: 15;

Rg_Ability_Entry :: struct {
    icon_path: string;
    name:      string;
    desc:      string;
}

rg_get_role_name :: proc(idx: int) -> string {
    switch idx {
        case 0:  return "CREW";
        case 1:  return "SHERIFF";
        case 2:  return "DOCTOR";
        case 3:  return "PRESIDENT";
        case 4:  return "MOVIE STAR";
        case 5:  return "CORONER";
        case 6:  return "WARPER";
        case 7:  return "PRANKSTER";
        case 8:  return "PYROMANIAC";
        case 9:  return "TRAITOR";
        case 10: return "PIRATE";
        case 11: return "HITMAN";
        case 12: return "WEREWOLF";
        case 13: return "GOO GOO GAGA";
        case 14: return "MIMICER";
    }
    return "UNKNOWN";
}

rg_get_role_team :: proc(idx: int) -> string {
    if idx >= 7 && idx <= 8 return "ANARCHIST";
    if idx >= 9               return "TRAITOR";
    return "CIVILIAN";
}

rg_get_role_color :: proc(idx: int) -> v4 {
    if idx >= 7 && idx <= 8 return v4.{0.9,  0.55, 0.1,  1.0};
    if idx >= 9               return v4.{0.95, 0.2,  0.2,  1.0};
    return                         v4.{0.1,  0.9,  0.3,  1.0};
}

rg_get_team_badge_bg :: proc(idx: int) -> v4 {
    if idx >= 7 && idx <= 8 return v4.{0.20, 0.12, 0.02, 0.75};
    if idx >= 9               return v4.{0.20, 0.04, 0.04, 0.75};
    return                         v4.{0.03, 0.20, 0.06, 0.75};
}

rg_get_role_muted_color :: proc(idx: int) -> v4 {
    if idx >= 7 && idx <= 8 return v4.{0.34, 0.24, 0.10, 1.0};
    if idx >= 9               return v4.{0.36, 0.14, 0.14, 1.0};
    return                         v4.{0.14, 0.30, 0.18, 1.0};
}

rg_get_role_icon :: proc(idx: int) -> string {
    switch idx {
        case 1:  return "sprites/icons/revolver.png";
        case 2:  return "sprites/icons/doctor/revive.png";
        case 4:  return "sprites/icons/movie_star/write_signature.png";
        case 7:  return "sprites/icons/trickster/prank.png";
        case 9:  return "sprites/icons/kill_ability.png";
        case 10: return "sprites/icons/pirate/black_flag.png";
        case 11: return "sprites/icons/kill_ability.png";
        case 12: return "sprites/icons/kill_ability.png";
        case 13: return "sprites/icons/transform_evil.png";
    }
    return "";
}

rg_get_role_description :: proc(idx: int) -> string {
    switch idx {
        case 0:  return "Complete your tasks and help civilians identify and vote out the traitors before they eliminate everyone.";
        case 1:  return "The station's law enforcer. You carry a gun and can shoot suspected traitors. Be careful - shooting an innocent has consequences.";
        case 2:  return "The civilians' medic. Resurrect fallen civilians and bring them back into the game. Use your power wisely to turn the tide.";
        case 3:  return "A high-value civilian. Your votes count double - use it to outplay traitors in close meetings.";
        case 4:  return "A beloved celebrity. Hand out autographs to players - anyone who walks over them gets stunned!";
        case 5:  return "The forensic investigator. Collect DNA samples from dead bodies and match them against living players to find killers.";
        case 6:  return "A spatial engineer who bends space. Place two portals anywhere on the map - players who enter one exit through the other.";
        case 7:  return "A chaotic wild card. Prank players, call fake meetings, and get someone voted out. Cause enough chaos to unlock the Jester Win!";
        case 8:  return "A fire-obsessed anarchist. Set rooms ablaze and ignite corpses to destroy evidence. Burn enough to unlock World Fire and win!";
        case 9:  return "Sabotage the station, eliminate civilians, and avoid suspicion. Work together with fellow traitors to win.";
        case 10: return "A swashbuckling traitor. Loot treasure maps from bodies and dig for buried treasure to unlock powerful new abilities.";
        case 11: return "A cold and calculating assassin. Silently snap necks up close. Rack up kills to unlock proximity mines and a sniper rifle.";
        case 12: return "A shape-shifting beast hiding among civilians. Switch between schleem and wolf form. Earn kills to unlock Infect and Claw.";
        case 13: return "A horrifying creature hiding in plain sight. Place a nest and consume bodies to earn nest points that unlock powerful abilities. Transform, crawl, lay traps, whip targets, and summon swarms.";
    }
    return "";
}

rg_get_role_difficulty :: proc(idx: int) -> string {
    switch idx {
        case 0:  return "EASY";
        case 1:  return "MEDIUM";
        case 2:  return "MEDIUM";
        case 3:  return "EASY";
        case 4:  return "EASY";
        case 5:  return "HARD";
        case 6:  return "MEDIUM";
        case 7:  return "HARD";
        case 8:  return "HARD";
        case 9:  return "MEDIUM";
        case 10: return "MEDIUM";
        case 11: return "HARD";
        case 12: return "MEDIUM";
        case 13: return "HARD";
    }
    return "EASY";
}

rg_get_role_difficulty_color :: proc(idx: int) -> v4 {
    d := rg_get_role_difficulty(idx);
    if d == "HARD"   return v4.{1.0, 0.35, 0.25, 1.0};
    if d == "MEDIUM" return v4.{1.0, 0.78, 0.2,  1.0};
    return v4.{0.4, 0.9, 0.4, 1.0};
}

rg_get_role_abilities :: proc(idx: int, results: ref [..]Rg_Ability_Entry) {
    switch idx {
        case 1: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/revolver.png",               "Shoot",        "Fire your gun at a target. Friendly fire has consequences."});
        }
        case 2: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/doctor/revive.png",          "Resurrect",    "Revive a fallen civilian and bring them back to life."});
        }
        case 4: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/movie_star/write_signature.png", "Autograph", "Sign an autograph on the ground. Players who walk over it get stunned."});
        }
        case 5: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/coroner/ability_take_dna.png",    "DNA Sample",   "Collect a DNA sample from a dead body."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/coroner/ability_compare_dna.png", "DNA Match",    "Compare collected DNA against a living player to identify killers."});
        }
        case 6: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/portal_maker/red_portal.png",  "Red Portal",   "Shoot a bolt to place the red end of your portal."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/portal_maker/blue_portal.png", "Blue Portal",  "Shoot a bolt to place the blue end of your portal."});
        }
        case 7: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/trickster/prank.png",        "Prank",        "Prank other players to make them fall!"});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/trickster/call_fake.png",    "Fake Meeting", "Call a fake emergency meeting and get someone voted out!"});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/trickster/jester.png",       "Jester Win",   "Unlocked after enough chaos. Prank everyone and win!"});
        }
        case 8: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pyro/set_fire.png",      "Light Fire",   "Set fire to objects in rooms on your task list to start a room blaze."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pyro/light_corpse.png",  "Light Corpse", "Ignite a nearby dead body to destroy evidence."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pyro/worldfire.png",     "World Fire",   "Unlocked after burning enough. Engulf the entire station in flames!"});
        }
        case 9: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/kill_ability.png",           "Kill",         "Eliminate a nearby civilian up close."});
        }
        case 10: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/kill_ability.png",                "Kill",            "Eliminate a nearby civilian."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pirate/dig_for_treasure.png",     "Dig Treasure",    "Loot treasure maps from bodies and dig for buried treasure."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pirate/black_flag.png",           "Black Flag",      "Plant a flag that blinds nearby enemies with thick fog."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pirate/flintlock_pistol.png",     "Shoot",           "Unlocked with treasure. Fire your pistol at range."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/pirate/powder_keg.png",           "Powder Keg",      "Unlocked with treasure. Place an explosive barrel that detonates after a delay."});
        }
        case 11: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/hitman/knee_snap.png",            "Neck Snap",       "Silently eliminate a nearby target. Replaces the default kill."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/hitman/land_mine.png",            "Proximity Mine",  "Unlocked with kills. Place a hidden mine that detonates when enemies walk over it."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/hitman/sniper_rifle.png",         "Sniper Rifle",    "Unlocked with kills. Eliminate targets from long range."});
        }
        case 12: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/werewolf/devour.png",             "Kill",            "Eliminate a nearby civilian."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/werewolf/infecting_bite.png",     "Infect",          "Unlocked with kills. Bite a civilian to turn them into a werewolf."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/werewolf/claw_slash.png",         "Claw",            "Unlocked with kills. Slash at nearby enemies with deadly claws."});
        }
        case 13: {
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/Nest_icon.png",               "Place Nest",      "Place a nest to consume bodies and earn nest points for new abilities."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/transform_evil.png",              "Transform",       "Switch between schleem and creature form. Creature form is invisible."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/kill_wrap_player.png",        "Kill",            "Eliminate a nearby civilian. Drag bodies to the nest to consume them."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/crawl_speedup.png",           "Crawl",           "Unlocked with 1 nest point. Shrink down and move faster."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/santa_trap.png",              "Trap",            "Place a chocolate trap that roots and blinds civilians."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/kill_wrap_player.png",        "Foil Whip",       "Unlocked with 2 nest points. Fire a projectile that pulls targets to you."});
            append(ref results, Rg_Ability_Entry.{"sprites/icons/ggg/swarm.png",                   "Swarm",           "Unlocked with 4 nest points. Summon decoy creatures from the nest."});
        }
    }
}

rg_is_role_locked :: proc(player: Player, idx: int) -> bool {
    switch idx {
        case 13: return !Purchasing.owns_product(player, GGG_PRODUCT_ID);
        case 14: return !Purchasing.owns_product(player, MIMICER_PRODUCT_ID);
        case 16: return true;
    }
    return false;
}

rg_get_role_detail_icon :: proc(idx: int) -> string {
    switch idx {
        case 1:  return "ui/roles/sheriff_icon.png";
        case 2:  return "ui/roles/doctor_icon.png";
        case 3:  return "ui/roles/president_icon.png";
        case 4:  return "ui/roles/moviestar_icon.png";
        case 5:  return "ui/roles/coroner_icon.png";
        case 6:  return "ui/roles/portalmaker_icon.png";
        case 7:  return "ui/roles/trickster_icon.png";
        case 8:  return "ui/roles/pyromaniac_icon.png";
        case 10: return "ui/roles/pirate_icon.png";
        case 11: return "ui/roles/hitman_icon.png";
        case 12: return "ui/roles/werewolf_icon.png";
        case 13: return "ui/roles/googoogaga_icon.png";
    }
    return "";
}

rg_get_role_difficulty_stars :: proc(idx: int) -> int {
    d := rg_get_role_difficulty(idx);
    if d == "HARD"   return 3;
    if d == "MEDIUM" return 2;
    return 1;
}

rg_get_role_tips :: proc(idx: int) -> string {
    switch idx {
        case 1:  return "Announce yourself early to build trust. Shooting innocents backfires!";
        case 2:  return "Stay hidden and alive - you're the civilians' lifeline.";
        case 3:  return "Your double vote is powerful. Rally civilians to your side.";
        case 4:  return "Place autographs in doorways for maximum stun coverage.";
        case 5:  return "Collect DNA early. You need samples before you can match suspects.";
        case 6:  return "Place portals near objectives to save civilians or trap traitors.";
        case 7:  return "Blend in early. Your goal is to get voted out - act suspicious!";
        case 8:  return "Focus on burning rooms from your task list, not fighting.";
        case 10: return "Loot bodies for treasure maps to unlock your strongest abilities.";
        case 11: return "Neck snap for silent kills. Build kills to unlock mines and sniper.";
        case 12: return "Schleem form to blend in, wolf form to hunt. Switch wisely!";
        case 13: return "Place your nest early and drag bodies to it. More nest points = more abilities!";
    }
    return "";
}

// ---- Main panel ----

draw_roles_guide :: proc(player: Player) {
    if !player.roles_guide_open return;

    UI.push_layer(500);
    defer UI.pop_layer();

    // Dim the background
    full_screen := UI.get_screen_rect();
    UI.quad(full_screen, core_globals.white_sprite, v4.{0, 0, 0, 0.76});

    safe := UI.get_safe_screen_rect();

    PANEL_W := safe.width() * 0.80;
    PANEL_H := safe.height() * 0.82;
    panel_rect := safe.center_rect().grow_unscaled(PANEL_H * 0.5, PANEL_W * 0.5, PANEL_H * 0.5, PANEL_W * 0.5);

    // 9-slice panel background (matches task help backing)
    HELP_SLICE_PX :: 16.0;
    bg_tex := get_asset(Texture_Asset, "ui/task_help_backing.png");
    if bg_tex != null {
        bs := UI.default_button_settings();
        bs.sprite = bg_tex;
        bs.press_scaling = 1.0;
        bs.color = v4.{1, 1, 1, 0.95};
        bs.hovered_color  = bs.color;
        bs.pressed_color  = bs.color;
        bs.disabled_color = bs.color;
        bs.background_color_multiplier = v4.{1, 1, 1, 1};
        bs.nine_slice_data.slice       = v4.{HELP_SLICE_PX, HELP_SLICE_PX, HELP_SLICE_PX, HELP_SLICE_PX};
        bs.nine_slice_data.slice_scale = 1.0;
        UI.push_disabled(true);
        defer UI.pop_disabled();
        UI.begin_button(panel_rect, bs, {}, ""); { defer UI.end_button(); }
    } else {
        UI.quad(panel_rect, core_globals.white_sprite, v4.{0.07, 0.07, 0.11, 0.97});
    }

    content := panel_rect.inset(16, 18, 16, 18);

    // ---- Title bar ----
    title_strip := content.cut_top(46);

    title_ts := UI.default_text_settings();
    title_ts.size             = 36;
    title_ts.color            = v4.{1, 1, 1, 1};
    title_ts.halign           = .CENTER;
    title_ts.valign           = .CENTER;
    title_ts.do_outline       = true;
    title_ts.outline_thickness = 3;
    title_ts.outline_color    = v4.{0, 0, 0, 1};
    UI.text(title_strip, title_ts, "ROLES GUIDE");

    // Close button (icon sprite, top-right of panel)
    UI.push_id("rg_close");
    defer UI.pop_id();

    CLOSE_HALF :: 30.0;
    CLOSE_PAD  :: 10.0;
    close_rect := panel_rect.top_right_rect().offset(-CLOSE_PAD, -CLOSE_PAD).grow(CLOSE_HALF);

    close_bs := UI.default_button_settings();
    close_bs.sprite        = get_asset(Texture_Asset, "ui/close_icon.png");
    close_bs.press_scaling = 0.35;
    close_bs.color         = v4.{1, 1, 1, 0.8};
    close_bs.hovered_color = v4.{1, 1, 1, 1};
    close_bs.pressed_color = v4.{0.6, 0.6, 0.6, 1};

    if UI.button(close_rect, close_bs, UI.default_text_settings(), "").clicked {
        player.roles_guide_open = false;
    }

    content.cut_top(10);

    // ---- Split left list | right detail ----
    LIST_W :: 240.0;
    GAP    :: 14.0;

    left_panel := content.cut_left(LIST_W);
    content.cut_left(GAP);

    // Vertical divider
    vert_div := content.cut_left(1);
    UI.quad(vert_div, core_globals.white_sprite, v4.{1, 1, 1, 0.1});
    content.cut_left(GAP);

    rg_draw_role_list(player, left_panel);
    rg_draw_role_detail(player, content);
}

// ---- Left panel: role list ----

rg_draw_role_list :: proc(player: Player, rect: Rect) {
    list_area := rect;

    // ---- Filter tabs ----
    TAB_H :: 50.0;
    tab_strip := list_area.cut_top(TAB_H);
    list_area.cut_top(6);

    tab_w := tab_strip.width() / 4.0;

    for ti: 0..3 {
        UI.push_id("rg_tab_%", {ti});
        defer UI.pop_id();

        tab_rect := tab_strip.cut_left_unscaled(tab_w);
        is_active := player.roles_guide_filter == ti;

        tab_bs := UI.default_button_settings();
        tab_bs.press_scaling = 0.25;
        tab_bs.color         = v4.{1, 1, 1, 1};
        tab_bs.hovered_color = v4.{1, 1, 1, 1};
        tab_bs.pressed_color = v4.{0.7, 0.7, 0.7, 1};

        if is_active {
            tab_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_9.png");
            if ti == 0 { tab_bs.background_color_multiplier = v4.{0.35, 0.35, 0.40, 1.0}; }
            if ti == 1 { tab_bs.background_color_multiplier = v4.{0.1,  0.7,  0.25, 1.0}; }
            if ti == 2 { tab_bs.background_color_multiplier = v4.{0.7,  0.45, 0.08, 1.0}; }
            if ti == 3 { tab_bs.background_color_multiplier = v4.{0.75, 0.15, 0.15, 1.0}; }
        } else {
            tab_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png");
            tab_bs.background_color_multiplier = v4.{0.20, 0.20, 0.24, 1.0};
        }

        tab_ts := UI.default_text_settings();
        tab_ts.size              = 20;
        tab_ts.halign            = .CENTER;
        tab_ts.valign            = .CENTER;
        tab_ts.do_outline        = true;
        tab_ts.outline_thickness = 2;
        tab_ts.outline_color     = v4.{0, 0, 0, 1};

        tab_ts.color = v4.{1, 1, 1, 1};
        if !is_active {
            if ti == 0 { tab_ts.color = v4.{0.6,  0.6,  0.6,  1}; }
            if ti == 1 { tab_ts.color = v4.{0.3,  0.75, 0.4,  1}; }
            if ti == 2 { tab_ts.color = v4.{0.75, 0.5,  0.2,  1}; }
            if ti == 3 { tab_ts.color = v4.{0.8,  0.35, 0.35, 1}; }
        }

        tab_label := "ALL";
        if ti == 1 { tab_label = "CIV"; }
        if ti == 2 { tab_label = "ANA"; }
        if ti == 3 { tab_label = "TRA"; }

        if UI.button(tab_rect.inset_unscaled(2, 2, 2, 2), tab_bs, tab_ts, tab_label).clicked {
            player.roles_guide_filter = ti;
        }
    }

    // ---- Auto-select first visible role when filter hides current selection ----
    if player.roles_guide_filter > 0 {
        sel_team := rg_get_role_team(player.roles_guide_selected);
        filter_team := "CIVILIAN";
        if player.roles_guide_filter == 2 { filter_team = "ANARCHIST"; }
        if player.roles_guide_filter == 3 { filter_team = "TRAITOR"; }

        if sel_team != filter_team {
            found := false;
            for fi: 1..RG_NUM_ROLES-1 {
                if fi == 9 continue;
                    if !found && rg_get_role_team(fi) == filter_team {
                    player.roles_guide_selected = fi;
                    found = true;
                }
            }
        }
    }

    // ---- Scrollable role list ----
    scroll_area    := list_area;
    scrollbar_area := scroll_area.cut_right(6).inset(2);

    ROW_H   :: 60.0;
    ROW_GAP :: 5.0;
    HDR_H   :: 26.0;
    HDR_GAP :: 4.0;

    settings: Scroll_View_Settings;
    settings.vertical     = true;
    settings.horizontal   = false;
    settings.clip_padding = v4.{2, 2, 2, 2};

    sv := UI.push_scroll_view(scroll_area, "rg_role_list_sv", settings); {
        defer UI.pop_scroll_view();

        sc := sv.content_rect;
        prev_team := "";

        star_gold  := get_asset(Texture_Asset, "ui/star_gold 2.png");
        star_empty := get_asset(Texture_Asset, "ui/star_empty2 2.png");

        for i: 1..RG_NUM_ROLES-1 {
            if i == 9 continue;

            team := rg_get_role_team(i);

            // Apply filter
            if player.roles_guide_filter == 1 && team != "CIVILIAN"  continue;
            if player.roles_guide_filter == 2 && team != "ANARCHIST" continue;
            if player.roles_guide_filter == 3 && team != "TRAITOR"   continue;

            // ---- Group header on team change ----
            if team != prev_team {
                if prev_team.count > 0 {
                    sc.cut_top(HDR_GAP + 2);
                }

                hdr_row := sc.cut_top(HDR_H);
                sc.cut_top(HDR_GAP);

                hdr_ts := UI.default_text_settings();
                hdr_ts.size              = 16;
                hdr_ts.color             = rg_get_role_color(i);
                hdr_ts.halign            = .LEFT;
                hdr_ts.valign            = .CENTER;
                hdr_ts.do_outline        = true;
                hdr_ts.outline_thickness = 2;
                hdr_ts.outline_color     = v4.{0, 0, 0, 1};
                hdr_ts.offset.x          = 4;
                UI.text(hdr_row, hdr_ts, team);

                // Subtle colored underline
                line_color := rg_get_role_color(i);
                line_color.w = 0.25;
                line_rect := hdr_row.bottom_rect().grow_unscaled(0, 0, 1, 0);
                UI.quad(line_rect, core_globals.white_sprite, line_color);

                UI.expand_current_scroll_view(hdr_row);
                prev_team = team;
            }

            // ---- Role button ----
            UI.push_id("rg_rl_%", {i});
            defer UI.pop_id();

            row := sc.cut_top(ROW_H);
            sc.cut_top(ROW_GAP);

            is_selected := player.roles_guide_selected == i;
            is_locked   := rg_is_role_locked(player, i);
            role_color  := rg_get_role_color(i);
            muted_color := rg_get_role_muted_color(i);

            btn_bs := UI.default_button_settings();
            btn_bs.press_scaling = 0.3;

            if is_selected {
                btn_bs.sprite                      = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_9.png");
                btn_bs.color                       = v4.{1, 1, 1, 1};
                btn_bs.hovered_color               = v4.{1, 1, 1, 1};
                btn_bs.pressed_color               = v4.{0.82, 0.82, 0.82, 1};
                btn_bs.background_color_multiplier = role_color;
            } else {
                btn_bs.sprite                      = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png");
                btn_bs.color                       = v4.{1, 1, 1, 1};
                btn_bs.hovered_color               = v4.{1, 1, 1, 1};
                btn_bs.pressed_color               = v4.{0.82, 0.82, 0.82, 1};
                btn_bs.background_color_multiplier = muted_color;
            }

            // Custom button content: name + difficulty stars + lock icon
            result := UI.begin_button(row, btn_bs, UI.default_text_settings(), ""); {
                defer UI.end_button();

                inner := result.rect.inset(4, 8, 4, 10);

                // Reserve space for stars on the right
                diff_stars := rg_get_role_difficulty_stars(i);
                STAR_HALF :: 8.0;
                STAR_SP   :: 2.0;
                total_stars_w := 3.0 * STAR_HALF * 2.0 + 2.0 * STAR_SP;
                stars_strip := inner.cut_right(total_stars_w);

                star_layout := UI.make_directional_layout(stars_strip, .RIGHT);
                for si: 0..2 {
                    s_rect := star_layout.next(STAR_HALF * 2.0);
                    star_tex := star_empty;
                    if si < diff_stars { star_tex = star_gold; }
                    if star_tex != null {
                        UI.quad(s_rect.center_rect().grow(STAR_HALF).fit_aspect(star_tex.get_aspect()), star_tex);
                    }
                }

                // Lock icon if role is locked
                if is_locked {
                    LOCK_HALF :: 10.0;
                    lock_slot := inner.cut_left(LOCK_HALF * 2.0 + 4.0);
                    lock_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/lock_closed.png");
                    if lock_tex != null {
                        lock_rect := lock_slot.center_rect().grow(LOCK_HALF);
                        UI.quad(lock_rect.fit_aspect(lock_tex.get_aspect()), lock_tex, v4.{1, 1, 1, 0.8});
                    }
                }

                // Role name on the left
                name_ts := UI.default_text_settings();
                name_ts.size              = 22;
                name_ts.color             = v4.{1, 1, 1, 1};
                if is_locked {
                    name_ts.color = v4.{0.6, 0.6, 0.6, 1};
                }
                name_ts.halign            = .LEFT;
                name_ts.valign            = .CENTER;
                name_ts.do_outline        = true;
                name_ts.outline_thickness = 2;
                name_ts.outline_color     = v4.{0, 0, 0, 1};
                name_ts.offset.x          = 2;
                UI.text(inner, name_ts, rg_get_role_name(i));

                // "NEW" badge for new roles
                if i == 14 {
                    NEW_BADGE_H :: 14.0;
                    NEW_BADGE_W :: 30.0;
                    badge_rect := result.rect.top_right_rect().offset(-4, -2).grow_unscaled(NEW_BADGE_H, NEW_BADGE_W, 0, 0);
                    UI.quad(badge_rect, core_globals.white_sprite, v4.{0.1, 0.6, 1.0, 0.9});

                    new_badge_ts := UI.default_text_settings();
                    new_badge_ts.size = 11;
                    new_badge_ts.halign = .CENTER;
                    new_badge_ts.valign = .CENTER;
                    new_badge_ts.color = v4.{1, 1, 1, 1};
                    new_badge_ts.do_outline = true;
                    new_badge_ts.outline_thickness = 1;
                    new_badge_ts.outline_color = v4.{0, 0, 0, 1};
                    UI.text(badge_rect, new_badge_ts, "NEW");
                }
            }

            if result.clicked {
                player.roles_guide_selected = i;
            }

            UI.expand_current_scroll_view(row);
        }
    }

    sb_rect := sv.compute_scroll_bar_rect(scrollbar_area);
    if sb_rect.height() < scrollbar_area.height() - 1.0 {
        UI.quad(scrollbar_area, core_globals.white_sprite, v4.{0.1, 0.1, 0.1, 0.4});
        UI.quad(sb_rect,        core_globals.white_sprite, v4.{0.4, 0.4, 0.4, 0.6});
    }
}

// ---- Right panel: role detail ----

rg_draw_role_detail :: proc(player: Player, rect: Rect) {
    idx := player.roles_guide_selected;
    if idx < 1 { idx = 1; }

    description := rg_get_role_description(idx);

    content := rect;

    // ---- Header: role icon centered with stars to the right ----
    ICON_HALF  :: 46.0;
    HEADER_H   :: 100.0;
    detail_icon_path := rg_get_role_detail_icon(idx);
    diff_stars       := rg_get_role_difficulty_stars(idx);

    header_strip := content.cut_top(HEADER_H);

    if detail_icon_path.count > 0 {
        role_icon_tex := get_asset(Texture_Asset, detail_icon_path);
        if role_icon_tex != null {
            icon_rect := header_strip.center_rect().grow(ICON_HALF);
            UI.quad(icon_rect.fit_aspect(role_icon_tex.get_aspect(), .KEEP_HEIGHT), role_icon_tex, v4.{1, 1, 1, 1});
        }

        // Stars to the right of the icon
        star_gold  := get_asset(Texture_Asset, "ui/star_gold 2.png");
        star_empty := get_asset(Texture_Asset, "ui/star_empty2 2.png");
        STAR_HALF :: 12.0;
        STAR_GAP  :: 4.0;
        stars_anchor := header_strip.center_rect().offset(ICON_HALF + 14.0, 0);
        for si: 0..2 {
            offset_y := (si.(float) - 1.0) * (STAR_HALF * 2.0 + STAR_GAP);
            star_rect := stars_anchor.offset(0, -offset_y).grow(STAR_HALF);
            star_tex := star_empty;
            if si < diff_stars { star_tex = star_gold; }
            if star_tex != null {
                UI.quad(star_rect.fit_aspect(star_tex.get_aspect()), star_tex, v4.{1, 1, 1, 1});
            }
        }
    }

    // ---- Locked banner ----
    is_locked := rg_is_role_locked(player, idx);
    if is_locked {
        content.cut_top(6);
        LOCK_BANNER_H :: 32.0;
        lock_banner := content.cut_top(LOCK_BANNER_H);
        UI.quad(lock_banner, core_globals.white_sprite, v4.{0.15, 0.12, 0.05, 0.6});

        lock_inner := lock_banner.inset(4, 8, 4, 8);
        LOCK_ICON_HALF :: 10.0;
        lock_icon_slot := lock_inner.cut_left(LOCK_ICON_HALF * 2.0 + 6.0);
        lock_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_1/lock_closed.png");
        if lock_tex != null {
            lock_icon_rect := lock_icon_slot.center_rect().grow(LOCK_ICON_HALF);
            UI.quad(lock_icon_rect.fit_aspect(lock_tex.get_aspect()), lock_tex, v4.{1, 0.85, 0.3, 1});
        }

        lock_ts := UI.default_text_settings();
        lock_ts.size              = 18;
        lock_ts.color             = v4.{1, 0.85, 0.3, 1};
        lock_ts.halign            = .LEFT;
        lock_ts.valign            = .CENTER;
        lock_ts.do_outline        = true;
        lock_ts.outline_thickness = 2;
        lock_ts.outline_color     = v4.{0, 0, 0, 1};
        UI.text(lock_inner, lock_ts, "LOCKED - Available in Shop");
    }

    content.cut_top(8);

    // Thin divider
    UI.quad(content.cut_top(1), core_globals.white_sprite, v4.{1, 1, 1, 0.1});
    content.cut_top(10);

    // ---- Description ----
    DESC_H :: 90.0;
    desc_area := content.cut_top(DESC_H);

    desc_ts := UI.default_text_settings();
    desc_ts.size              = 28;
    desc_ts.color             = v4.{0.9, 0.9, 0.95, 1};
    desc_ts.halign            = .CENTER;
    desc_ts.valign            = .TOP;
    desc_ts.word_wrap         = true;
    desc_ts.do_outline        = true;
    desc_ts.outline_thickness = 3;
    desc_ts.outline_color     = v4.{0, 0, 0, 1};
    desc_ts.do_autofit        = true;
    desc_ts.autofit_min_size  = 18;
    desc_ts.autofit_max_size  = 28;
    UI.text(desc_area, desc_ts, description);

    // ---- Tips ----
    tips := rg_get_role_tips(idx);
    if tips.count > 0 {
        content.cut_top(8);

        TIPS_H :: 60.0;
        tips_area := content.cut_top(TIPS_H);

        tips_bg := tips_area.inset(2);
        UI.quad(tips_bg, core_globals.white_sprite, v4.{0.12, 0.12, 0.18, 0.5});

        tips_inner := tips_bg.inset(8, 10, 8, 10);

        tips_ts := UI.default_text_settings();
        tips_ts.size              = 22;
        tips_ts.color             = v4.{0.95, 0.88, 0.45, 1};
        tips_ts.halign            = .LEFT;
        tips_ts.valign            = .CENTER;
        tips_ts.word_wrap         = true;
        tips_ts.do_outline        = true;
        tips_ts.outline_thickness = 2;
        tips_ts.outline_color     = v4.{0, 0, 0, 1};
        tips_ts.do_autofit        = true;
        tips_ts.autofit_min_size  = 16;
        tips_ts.autofit_max_size  = 22;
        UI.text(tips_inner, tips_ts, "TIP: %", {tips});
    }

    content.cut_top(10);

    // Thin divider
    UI.quad(content.cut_top(1), core_globals.white_sprite, v4.{1, 1, 1, 0.1});
    content.cut_top(8);

    // ---- Abilities section label ----
    ab_label := content.cut_top(26);
    ab_label_ts := UI.default_text_settings();
    ab_label_ts.size             = 19;
    ab_label_ts.color            = v4.{0.6, 0.6, 0.65, 1};
    ab_label_ts.halign           = .LEFT;
    ab_label_ts.valign           = .CENTER;
    ab_label_ts.do_outline       = true;
    ab_label_ts.outline_thickness = 2;
    ab_label_ts.outline_color    = v4.{0, 0, 0, 1};
    UI.text(ab_label, ab_label_ts, "ABILITIES");
    content.cut_top(6);

    // ---- Abilities list ----
    ab_entries: [..]Rg_Ability_Entry;
    rg_get_role_abilities(idx, ref ab_entries);

    if ab_entries.count == 0 {
        no_ab_ts := UI.default_text_settings();
        no_ab_ts.size             = 26;
        no_ab_ts.color            = v4.{0.45, 0.45, 0.50, 1};
        no_ab_ts.halign           = .CENTER;
        no_ab_ts.valign           = .CENTER;
        no_ab_ts.do_outline       = true;
        no_ab_ts.outline_thickness = 2;
        no_ab_ts.outline_color    = v4.{0, 0, 0, 1};
        UI.text(content, no_ab_ts, "No special abilities.");
        return;
    }

    // Scroll view for abilities
    scroll_area    := content;
    scrollbar_area := scroll_area.cut_right(6).inset(2);

    settings: Scroll_View_Settings;
    settings.vertical     = true;
    settings.horizontal   = false;
    settings.clip_padding = v4.{6, 6, 6, 6};

    sv := UI.push_scroll_view(scroll_area, "rg_ability_sv", settings); {
        defer UI.pop_scroll_view();

        sc := sv.content_rect;

        ROW_H      :: 64.0;
        ICON_SIZE  :: 36.0;
        ROW_GAP    :: 16.0;

        for i: 0..ab_entries.count-1 {
            entry := ab_entries[i];

            UI.push_id("rg_ab_%", {i});
            defer UI.pop_id();

            row := sc.cut_top(ROW_H);
            if i < ab_entries.count - 1 {
                sc.cut_top(ROW_GAP);
            }

            row_inner := row.inset(6, 8, 6, 8);

            // Icon slot
            if entry.icon_path.count > 0 {
                icon_slot := row_inner.cut_left(ICON_SIZE * 2.0 + 12.0);
                icon_tex  := get_asset(Texture_Asset, entry.icon_path);
                if icon_tex != null {
                    icon_rect := icon_slot.center_rect().grow(ICON_SIZE);
                    UI.quad(icon_rect.fit_aspect(icon_tex.get_aspect()), icon_tex, v4.{1, 1, 1, 1});
                }
            }

            // Ability name
            name_row := row_inner.cut_top(26);
            ab_name_ts := UI.default_text_settings();
            ab_name_ts.size             = 30;
            ab_name_ts.color            = v4.{1, 1, 1, 1};
            ab_name_ts.halign           = .LEFT;
            ab_name_ts.valign           = .TOP;
            ab_name_ts.do_outline       = true;
            ab_name_ts.outline_thickness = 2;
            ab_name_ts.outline_color    = v4.{0, 0, 0, 1};
            UI.text(name_row, ab_name_ts, entry.name);

            // Ability description
            ab_desc_ts := UI.default_text_settings();
            ab_desc_ts.size             = 22;
            ab_desc_ts.color            = v4.{0.8, 0.8, 0.85, 0.85};
            ab_desc_ts.halign           = .LEFT;
            ab_desc_ts.valign           = .TOP;
            ab_desc_ts.word_wrap        = true;
            ab_desc_ts.do_outline       = true;
            ab_desc_ts.outline_thickness = 2;
            ab_desc_ts.outline_color    = v4.{0, 0, 0, 1};
            UI.text(row_inner, ab_desc_ts, entry.desc);

            UI.expand_current_scroll_view(row);
        }
    }

    sb_rect := sv.compute_scroll_bar_rect(scrollbar_area);
    UI.quad(scrollbar_area, core_globals.white_sprite, v4.{0.1, 0.1, 0.1, 0.4});
    UI.quad(sb_rect,        core_globals.white_sprite, v4.{0.4, 0.4, 0.4, 0.6});
}

// ---- Open/close button (drawn in HUD) ----

draw_roles_guide_open_button :: proc(player: Player) {
    UI.push_id("rg_open_btn");
    defer UI.pop_id();

    BTN_HALF :: 60.0;
    safe     := UI.get_safe_screen_rect();
    btn_rect := safe.right_center_rect().offset(-(BTN_HALF + 16.0), 0).grow(BTN_HALF);

    bs := UI.default_button_settings();
    bs.sprite        = get_asset(Texture_Asset, "ui/info_icon_b.png");
    bs.press_scaling = 0.35;
    bs.color         = v4.{1, 1, 1, 1};
    bs.hovered_color = v4.{1, 1, 1, 1};
    bs.pressed_color = v4.{0.6, 0.6, 0.6, 1};

    if UI.button(btn_rect, bs, UI.default_text_settings(), "").clicked {
        player.roles_guide_open = !player.roles_guide_open;
    }

    // "Role Guide" label below the icon
    label_ts := UI.default_text_settings();
    label_ts.size              = 28;
    label_ts.color             = v4.{1, 1, 1, 0.9};
    label_ts.halign            = .CENTER;
    label_ts.valign            = .TOP;
    label_ts.do_outline        = true;
    label_ts.outline_thickness = 4;
    label_ts.outline_color     = v4.{0, 0, 0, 1};
    label_rect := btn_rect.bottom_rect().offset(0, -10).grow_unscaled(18, 70, 0, 70);
    UI.text(label_rect, label_ts, "Role Guide");
}
