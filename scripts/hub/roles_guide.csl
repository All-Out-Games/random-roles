            append(ref results, Rg_Ability_Entry.{"sprites/icons/big_charlie/Lil_Nugget.png",                  "Birth Nugget",  "Big Charlie form. Plant a stationary Lil' Nugget at your feet. Up to 5 nuggets, 30s cooldown - non-traitors must hold for 3s to break one."});
