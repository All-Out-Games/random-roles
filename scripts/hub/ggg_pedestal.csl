GGG_PRODUCT_ID :: "69b1aa6e3a1668e54467c5d4";
MIMICER_PRODUCT_ID :: "69d67dac5a645398b8c19d96";
LILY_PRODUCT_ID :: "69e7ceac7c51b1e14b7a5611";

stamp_product_purchase :: proc(player: Player, product_id: string, reason: string) {
    if Game.is_server() {
        save_key := format_string("purchase_usage_%", {product_id});
        existing := Save.get_int(player, save_key, -1);
        if existing >= 0 return;

        Save.set_int(player, save_key, 0);

        log_info("[Purchase] Stamped product % for % (%). Reason: %", {product_id, player.get_username(), player.get_user_id(), reason});
    }
}

ao_purchase_handler :: proc(player: Player, id: string) -> bool {
    if id == GGG_PRODUCT_ID {
        stamp_product_purchase(player, GGG_PRODUCT_ID, "purchase");
        player.ggg_bought = true;
        Notifier.notify(player, "Goo Goo Ga Ga unlocked!");
        loadout_open_after_purchase(player, 13);
        return true;
    }
    if id == MIMICER_PRODUCT_ID {
        stamp_product_purchase(player, MIMICER_PRODUCT_ID, "purchase");
        player.mimicer_bought = true;
        Notifier.notify(player, "Mimicer unlocked!");
        loadout_open_after_purchase(player, 14);
        return true;
    }
    if id == LILY_PRODUCT_ID {
        stamp_product_purchase(player, LILY_PRODUCT_ID, "purchase");
        player.lily_bought = true;
        Notifier.notify(player, "Lily unlocked!");
        loadout_open_after_purchase(player, 16);
        return true;
    }
    if loadout_purchase_handler(player, id) return true;
    return false;
}

loadout_open_after_purchase :: proc(player: Player, role_idx: int) {
    loadout_try_auto_equip(player, role_idx);
    tab := loadout_team_for_role(role_idx);
    if tab >= 0 player.loadout_tab = tab;
    player.loadout_open = true;
}

check_owned_products :: proc(player: Player) {
    if Purchasing.owns_product(player, GGG_PRODUCT_ID) {
        stamp_product_purchase(player, GGG_PRODUCT_ID, "corrective");
        player.ggg_bought = true;
    }
    if Purchasing.owns_product(player, MIMICER_PRODUCT_ID) {
        stamp_product_purchase(player, MIMICER_PRODUCT_ID, "corrective");
        player.mimicer_bought = true;
    }
    if Purchasing.owns_product(player, LILY_PRODUCT_ID) {
        stamp_product_purchase(player, LILY_PRODUCT_ID, "corrective");
        player.lily_bought = true;
    }
    if Purchasing.owns_product(player, LOADOUT_EXTRA_TRAITOR_PRODUCT_ID)   player.loadout_extra_traitor_owned   = true;
    if Purchasing.owns_product(player, LOADOUT_EXTRA_CIVILIAN_PRODUCT_ID)  player.loadout_extra_civilian_owned  = true;
    if Purchasing.owns_product(player, LOADOUT_EXTRA_ANARCHIST_PRODUCT_ID) player.loadout_extra_anarchist_owned = true;
}

Pedestal_Role :: enum {
    GOO_GOO_GAGA;
    MIMICER;
    LILY;
}

pedestal_get_product_id :: proc(role: Pedestal_Role) -> string {
    switch role {
        case .GOO_GOO_GAGA: return GGG_PRODUCT_ID;
        case .MIMICER:      return MIMICER_PRODUCT_ID;
        case .LILY:         return LILY_PRODUCT_ID;
    }
    return "";
}

pedestal_get_display_name :: proc(role: Pedestal_Role) -> string {
    switch role {
        case .GOO_GOO_GAGA: return "Goo Goo Ga Ga";
        case .MIMICER:      return "Mimicer";
        case .LILY:         return "Lily";
    }
    return "";
}

pedestal_get_idle_anim :: proc(role: Pedestal_Role) -> string {
    switch role {
        case .GOO_GOO_GAGA: return "Idle";
        case .MIMICER:      return "004RAND/Idle";
        case .LILY:         return "idle";
    }
    return "Idle";
}

pedestal_get_action_anim :: proc(role: Pedestal_Role) -> string {
    switch role {
        case .GOO_GOO_GAGA: return "PounceWrap";
        case .MIMICER:      return "004RAND/Absorb_Flames";
        case .LILY:         return "action";
    }
    return "Idle";
}

pedestal_is_bought :: proc(role: Pedestal_Role, player: Player) -> bool {
    switch role {
        case .GOO_GOO_GAGA: return player.ggg_bought;
        case .MIMICER:      return player.mimicer_bought;
        case .LILY:         return player.lily_bought;
    }
    return false;
}

pedestal_is_new :: proc(role: Pedestal_Role) -> bool {
    switch role {
        case .LILY: return true;
    }
    return false;
}

pedestal_get_price :: proc(role: Pedestal_Role) -> string {
    switch role {
        case .GOO_GOO_GAGA: return "199";
        case .MIMICER:      return "299";
        case .LILY:         return "499";
    }
    return "";
}

PEDESTAL_ACTION_INTERVAL :: 15.0;

Role_Pedestal :: class : Interactable {
    role: Pedestal_Role @ao_serialize;
    spine: Spine_Animator @ao_serialize;
    action_timer: float;
    state_machine: State_Machine;

    ao_start :: method() {
        this.set_listener(this);
        this.set_text(format_string("Buy %", {pedestal_get_display_name(role)}));
        action_timer = PEDESTAL_ACTION_INTERVAL;

        if spine != null {
            spine.awaken();

            state_machine = State_Machine.create();
            action_trigger := state_machine.create_variable("action", .TRIGGER);

            layer := state_machine.create_layer("main", 0);

            idle_state := layer.create_state(pedestal_get_idle_anim(role), true);
            action_state := layer.create_state(pedestal_get_action_anim(role), false);

            layer.set_initial_state(idle_state);

            to_action := layer.create_global_transition(action_state, true);
            to_action.create_trigger_condition(action_trigger);

            action_to_idle := layer.create_transition(action_state, idle_state, true);

            spine.instance.set_state_machine(state_machine, true);
        }
    }

    ao_late_update :: method(dt: float) {
        if Game.is_server() return;

        pos := entity.world_position;
        product_id := pedestal_get_product_id(role);

        UI.push_world_draw_context();
        defer UI.pop_draw_context();

        UI.push_z(pos.y - 10.0);
        defer UI.pop_z();

        t := get_time();
        bob := sin(t * 2.5) * 0.06;

        // Floating banner
        banner_y := pos.y + 0.1 + bob;
        banner_pos := v2.{pos.x, banner_y};

        banner_tex := get_asset(Texture_Asset, "$AO/ui/kit/Modal Augments/modal_banner_small/modal_banner_red.png");

        if pedestal_is_new(role) {
            banner_rect := Rect.{banner_pos, banner_pos}.grow(0.3, 1.2, 0.3, 1.2);
            if banner_tex != null {
                UI.quad(banner_rect, banner_tex, v4.{0.15, 0.5, 0.8, 1.0});
            }
        } else {
            // Standard pulsing banner
            pulse := (sin(t * 3.0) + 1.0) * 0.5;
            banner_r := lerp(0.6, 0.75, pulse);
            banner_g := lerp(0.08, 0.2, pulse);
            banner_b := lerp(0.05, 0.12, pulse);

            banner_rect := Rect.{banner_pos, banner_pos}.grow(0.3, 1.2, 0.3, 1.2);
            if banner_tex != null {
                UI.quad(banner_rect, banner_tex, v4.{banner_r, banner_g, banner_b, 1.0});
            }
        }

        // Price with sparks icon - bottom line of banner
        sparks_tex := get_asset(Texture_Asset, "$AO/ui/kit/Icons/sparks/spark_small.png");
        price_y := banner_pos.y + 0.05;
        price_pos := v2.{banner_pos.x, price_y};
        price_rect := Rect.{price_pos, price_pos}.grow(0.0, 0.5, 0.0, 0.5);

        price_ts := UI.default_text_settings();
        price_ts.size = 0.42;
        price_ts.halign = .CENTER;
        price_ts.valign = .CENTER;
        price_ts.color = v4.{1.0, 1.0, 0.5, 1.0};
        price_ts.do_outline = true;
        price_ts.outline_thickness = 0.018;
        price_ts.outline_color = v4.{0.3, 0.1, 0.0, 1.0};
        price_ts.do_drop_shadow = true;
        price_ts.drop_shadow_offset = v2.{0.008, -0.008};
        price_ts.drop_shadow_color = v4.{0.0, 0.0, 0.0, 0.6};
        UI.text(price_rect, price_ts, pedestal_get_price(role));

        if sparks_tex != null {
            SPARK_HALF :: 0.15;
            spark_rect := Rect.{price_pos, price_pos}.offset(0.48, 0).grow(SPARK_HALF, SPARK_HALF, SPARK_HALF, SPARK_HALF);
            UI.quad(spark_rect.fit_aspect(sparks_tex.get_aspect()), sparks_tex, v4.{1.0, 0.9, 0.3, 1.0});
        }

        // Floating sprite/text above pedestal if not bought
        local_player, lok := Game.get_local_player();
        if lok && !pedestal_is_bought(role, local_player) && !Purchasing.owns_product(local_player, product_id) || (lok && local_player.is_admin()) {
            if role == Pedestal_Role.LILY {
                new_role_tex := get_asset(Texture_Asset, "sprites/NewRole.png");
                if new_role_tex != null {
                    nr_y := pos.y + 3.0 + bob;
                    nr_pos := v2.{pos.x, nr_y};
                    NR_HALF :: 1.0;
                    nr_rect := Rect.{nr_pos, nr_pos}.grow(NR_HALF, NR_HALF, NR_HALF, NR_HALF);
                    UI.quad(nr_rect.fit_aspect(new_role_tex.get_aspect()), new_role_tex);
                }
            }
        }
    }

    ao_update :: method(dt: float) {
        if spine == null return;

        action_timer -= dt;
        if action_timer <= 0.0 {
            action_timer = PEDESTAL_ACTION_INTERVAL;
            state_machine.set_trigger("action");
        }
    }

    can_use :: method(player: Player) -> bool {
        if player == null return false;
        if player.is_admin() return true;
        product_id := pedestal_get_product_id(role);
        if pedestal_is_bought(role, player) || Purchasing.owns_product(player, product_id) {
            this.set_text("Bought!");
            return false;
        }
        this.set_text(format_string("Buy %", {pedestal_get_display_name(role)}));
        return true;
    }

    on_interact :: method(player: Player) {
        Purchasing.prompt_purchase(player, pedestal_get_product_id(role));
    }
}
