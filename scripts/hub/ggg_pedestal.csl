GGG_PRODUCT_ID :: "69b1aa6e3a1668e54467c5d4";

stamp_product_purchase :: proc(player: Player, product_id: string, reason: string) {
    if Game.is_server() {
        save_key := format_string("purchase_usage_%", {product_id});
        existing := Save.get_int(player, save_key, -1);
        if existing >= 0 return;

        Save.set_int(player, save_key, 0);

        log_info("[Purchase] Stamped product % for % (%). Reason: %", {product_id, player->get_username(), player->get_user_id(), reason});
    }
}

ao_purchase_handler :: proc(player: Player, id: string) -> bool {
    if id == GGG_PRODUCT_ID {
        stamp_product_purchase(player, GGG_PRODUCT_ID, "purchase");
        foreach pedestal: component_iterator(GGG_Pedestal) {
            pedestal.bought = true;
        }
        Notifier.notify(player, "Goo Goo Ga Ga unlocked!");
        return true;
    }
    return false;
}

check_owned_products :: proc(player: Player) {
    if Purchasing.owns_product(player, GGG_PRODUCT_ID) {
        stamp_product_purchase(player, GGG_PRODUCT_ID, "corrective");
    }
}

POUNCE_INTERVAL :: 15.0;

GGG_Pedestal :: class : Interactable {
    bought: bool;
    spine: Spine_Animator @ao_serialize;
    pounce_timer: float;
    state_machine: State_Machine;

    ao_start :: method() {
        this->set_listener(this);
        this->set_text("Buy Goo Goo Ga Ga");
        pounce_timer = POUNCE_INTERVAL;

        if spine != null {
            spine->awaken();

            state_machine = State_Machine.create();
            pounce_trigger := state_machine->create_variable("pounce", .TRIGGER);

            layer := state_machine->create_layer("main", 0);

            idle_state := layer->create_state("Idle", true);
            pounce_state := layer->create_state("PounceWrap", false);

            layer->set_initial_state(idle_state);

            to_pounce := layer->create_global_transition(pounce_state, true);
            to_pounce->create_trigger_condition(pounce_trigger);

            pounce_to_idle := layer->create_transition(pounce_state, idle_state, true);

            spine.instance->set_state_machine(state_machine, true);
        }
    }

    ao_update :: method(dt: float) {
        if spine == null return;

        pounce_timer -= dt;
        if pounce_timer <= 0.0 {
            pounce_timer = POUNCE_INTERVAL;
            state_machine->set_trigger("pounce");
        }
    }

    can_use :: method(player: Player) -> bool {
        if player == null return false;
        if bought || Purchasing.owns_product(player, GGG_PRODUCT_ID) {
            this->set_text("Bought!");
            return false;
        }
        this->set_text("Buy Goo Goo Ga Ga");
        return true;
    }

    on_interact :: method(player: Player) {
        Purchasing.prompt_purchase(player, GGG_PRODUCT_ID);
    }
}
