import "core:ao"

// =============================================================================
// Mimicer v2 — Traitor Role (Void Pillar Identity Thief)
// =============================================================================

rr_mimicer_role_enabled: bool;

// --- Constants ---
MIMICER_CREATURE_RIG :: "anims/roles/Mimicer/004RAND_Mimicer.spine";
MIMICER_VFX_RIG :: "anims/roles/Mimicer/vfx/004RAND_Mimicer.spine";
MIMICER_PILLAR_RIG :: "anims/roles/Mimicer/vfx/012MIM_Dark_Flame_Pillar.spine";

// Kill
MIMICER_KILL_COOLDOWN :: 25.0;
MIMICER_KILL_RANGE_SCHLEEM :: 5.0;
MIMICER_KILL_RANGE_MONSTER :: 6.5;
MIMICER_KILL_ESCALATION_FACES :: 2;

// Transform
MIMICER_TRANSFORM_ANIM_SECONDS :: 1.0;
MIMICER_MONSTER_SPEED_MULTIPLIER :: 1.15;

// Prowl
MIMICER_PROWL_SPEED_MULTIPLIER :: 0.8;
MIMICER_PROWL_WALL_RANGE :: 2.0;
MIMICER_PROWL_NEAR_WALL_ALPHA :: 0.1;
MIMICER_PROWL_NORMAL_ALPHA :: 1.0;

// Corrupt
MIMICER_CORRUPT_CHANNEL_SECONDS :: 4.0;
MIMICER_CORRUPT_INTERACT_RADIUS :: 2.5;

// Void Pillar
MIMICER_PILLAR_INTERACT_RADIUS :: 2.5;
MIMICER_PILLAR_SMOLDER_SECONDS :: 3.0;
MIMICER_PILLAR_REIGNITE_SECONDS :: 3.0;

// Disguise
MIMICER_DISGUISE_DURATION :: 40.0;

// Teleport
MIMICER_TELEPORT_COOLDOWN :: 15.0;

// Void Lunge
MIMICER_VOID_LUNGE_COOLDOWN :: 35.0;
MIMICER_VOID_LUNGE_STUN_SECONDS :: 4.0;
MIMICER_VOID_LUNGE_DISTANCE :: 8.0;
MIMICER_VOID_LUNGE_DURATION :: 0.3;
MIMICER_VOID_LUNGE_HIT_RADIUS :: 1.5;

// Spew Corruption
MIMICER_SPEW_COOLDOWN :: 50.0;
MIMICER_SPEW_BLIND_SECONDS :: 10.0;
MIMICER_SPEW_DISTORT_SECONDS :: 20.0;
MIMICER_SPEW_RANGE :: 2.5;
MIMICER_SPEW_BLIND_LOS_INNER :: 0.5;
MIMICER_SPEW_BLIND_LOS_OUTER :: 0.8;

// Stolen Faces unlock thresholds
MIMICER_VOID_LUNGE_UNLOCK_FACES :: 1;
MIMICER_SPEW_UNLOCK_FACES :: 3;
MIMICER_UNLEASH_UNLOCK_FACES :: 5;

// Unleash: Doppelganger Swarm
MIMICER_SWARM_DURATION :: 30.0;
MIMICER_SWARM_CLONE_FADE_SECONDS :: 3.0;
MIMICER_UNLEASH_CAMERA_SIZE :: 30.0;

// Passives
MIMICER_VOID_TETHER_RANGE :: 5.0;
MIMICER_VOID_TETHER_SPEED_BONUS :: 0.20;
MIMICER_VOID_HUNGER_CD_REDUCTION :: 2.0;

// --- Movement lock reasons ---
MIMICER_TRANSFORM_LOCK_REASON :: "mimicer_transform_lock";
MIMICER_VOID_LUNGE_LOCK_REASON :: "mimicer_void_lunge_lock";
MIMICER_SPEW_LOCK_REASON :: "mimicer_spew_lock";
MIMICER_UNLEASH_LOCK_REASON :: "mimicer_unleash_lock";
MIMICER_STUN_REASON :: "mimicer_void_lunge_stun";
MIMICER_INVIS_REASON :: "mimicer_monster_form";
MIMICER_NAME_INVIS_REASON :: "mimicer_monster_form";
MIMICER_PROWL_INVIS_REASON :: "mimicer_prowl";

// =============================================================================
// Creature Entity Management
// =============================================================================

rr_mimicer_ensure_creature_entity :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if mm.creature_entity != null && #alive(mm.creature_entity) return;

	ce := Scene.create_entity();
	ce->set_parent(player.entity, false);
	ce->set_local_position(v2.{0, 0});
	ce->set_local_scale(v2.{1, 1});
	ce->set_local_rotation(0.0);

	ca := ce->add_component(Spine_Animator);
	ca->awaken();
	if ca.instance != null {
		ca.instance->set_skeleton(get_asset(Spine_Asset, MIMICER_CREATURE_RIG));
		ca.instance->set_skin("normal");
		ca.instance->set_animation("004RAND/Idle", true, 0);
		rr_mimicer_setup_creature_state_machine(ca);
	}

	ce->set_local_enabled(false);
	mm.creature_entity = ce;
	mm.creature_animator = ca;
}

rr_mimicer_destroy_creature_entity :: proc(player: Player) {
	player->remove_invisibility_reason(MIMICER_INVIS_REASON);
	player->remove_name_invisibility_reason(MIMICER_NAME_INVIS_REASON);
	player->remove_invisibility_reason(MIMICER_PROWL_INVIS_REASON);
	player->remove_name_invisibility_reason(MIMICER_PROWL_INVIS_REASON);

	mm := player.entity->get_component(Mimicer_Module);
	if mm != null {
		if mm.creature_entity != null && #alive(mm.creature_entity) {
			mm.creature_entity->destroy();
		}
		mm.creature_entity = null;
		mm.creature_animator = null;
		mm.creature_visible = false;
	}
}

rr_mimicer_swap_to_creature :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	rr_mimicer_ensure_creature_entity(player);
	if mm.creature_entity == null return;

	player->add_invisibility_reason(MIMICER_INVIS_REASON);
	player->add_name_invisibility_reason(MIMICER_NAME_INVIS_REASON);
	mm.creature_entity->set_local_enabled(true);
	mm.creature_visible = true;

	if mm.creature_animator != null && mm.creature_animator.instance != null {
		if mm.creature_animator.instance.state_machine != null {
			mm.creature_animator.instance.state_machine->set_trigger("spawn_in");
		}
	}
}

rr_mimicer_swap_to_player :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if !mm.creature_visible return;
	if mm.creature_entity != null && #alive(mm.creature_entity) {
		mm.creature_entity->set_local_enabled(false);
	}
	mm.creature_visible = false;
	player->remove_invisibility_reason(MIMICER_INVIS_REASON);
	player->remove_name_invisibility_reason(MIMICER_NAME_INVIS_REASON);
}

rr_mimicer_creature_trigger :: proc(player: Player, trigger_name: string) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if mm.creature_animator == null return;
	if mm.creature_animator.instance == null return;
	if mm.creature_animator.instance.state_machine != null {
		mm.creature_animator.instance.state_machine->set_trigger(trigger_name);
	}
}

// =============================================================================
// Creature Animation State Machine
// =============================================================================

rr_mimicer_setup_creature_state_machine :: proc(ca: Spine_Animator) {
	sm := State_Machine.create();
	layer := sm->create_layer("main", 0);

	is_moving := sm->create_variable("is_moving", .BOOL);
	is_prowling := sm->create_variable("is_prowling", .BOOL);
	spawn_in_trigger := sm->create_variable("spawn_in", .TRIGGER);
	lunge_trigger := sm->create_variable("lunge", .TRIGGER);
	lunge_end_trigger := sm->create_variable("lunge_end", .TRIGGER);

	// Normal locomotion
	idle_state := layer->create_state("004RAND/Idle", true, 0.0);
	move_state := layer->create_state("004RAND/Move", true, 0.0);
	layer->set_initial_state(idle_state);

	idle_to_move := layer->create_transition(idle_state, move_state, false);
	idle_to_move->create_bool_condition(is_moving, true);
	idle_to_move->create_bool_condition(is_prowling, false);
	move_to_idle := layer->create_transition(move_state, idle_state, false);
	move_to_idle->create_bool_condition(is_moving, false);

	// Prowl locomotion
	prowl_idle := layer->create_state("004RAND/Idle_All_Fours", true, 0.0);
	prowl_move := layer->create_state("004RAND/Move_All_Fours", true, 0.0);

	to_prowl_idle := layer->create_transition(idle_state, prowl_idle, false);
	to_prowl_idle->create_bool_condition(is_prowling, true);
	to_prowl_move := layer->create_transition(move_state, prowl_idle, false);
	to_prowl_move->create_bool_condition(is_prowling, true);

	pi_to_pm := layer->create_transition(prowl_idle, prowl_move, false);
	pi_to_pm->create_bool_condition(is_moving, true);
	pi_to_pm->create_bool_condition(is_prowling, true);
	pm_to_pi := layer->create_transition(prowl_move, prowl_idle, false);
	pm_to_pi->create_bool_condition(is_moving, false);

	from_prowl_idle := layer->create_transition(prowl_idle, idle_state, false);
	from_prowl_idle->create_bool_condition(is_prowling, false);
	from_prowl_move := layer->create_transition(prowl_move, idle_state, false);
	from_prowl_move->create_bool_condition(is_prowling, false);

	// Spawn in (from transform)
	spawn_in_state := layer->create_state("004RAND/Transform_Monster_End", false, 1.0);
	layer->create_global_transition(spawn_in_state, false)->create_trigger_condition(spawn_in_trigger);
	layer->create_transition(spawn_in_state, idle_state, true);

	// Lunge
	lunge_state := layer->create_state("004RAND/Void_Lunge", false, 0.5);
	layer->create_global_transition(lunge_state, false)->create_trigger_condition(lunge_trigger);
	lunge_end_state := layer->create_state("004RAND/Void_Lunge_end", false, 0.5);
	layer->create_global_transition(lunge_end_state, false)->create_trigger_condition(lunge_end_trigger);
	layer->create_transition(lunge_end_state, idle_state, true);

	// Action triggers
	rr_mimicer_setup_creature_actions(sm, layer, idle_state);

	ca.instance->set_state_machine(sm, true);
}

rr_mimicer_setup_creature_actions :: proc(sm: State_Machine, layer: State_Machine_Layer, idle_state: State_Machine_State) {
	slash_trigger := sm->create_variable("slash", .TRIGGER);
	slash_prowl_trigger := sm->create_variable("slash_prowl", .TRIGGER);
	slash_escalated_trigger := sm->create_variable("slash_escalated", .TRIGGER);
	spew_trigger := sm->create_variable("spew", .TRIGGER);
	scream_trigger := sm->create_variable("scream", .TRIGGER);
	prowl_lunge_trigger := sm->create_variable("prowl_lunge", .TRIGGER);
	corrupt_trigger := sm->create_variable("corrupt", .TRIGGER);

	// Slash (kill — standard upright)
	slash_state := layer->create_state("004RAND/Slash_With_Hand", false, 0.8);
	layer->create_global_transition(slash_state, false)->create_trigger_condition(slash_trigger);
	layer->create_transition(slash_state, idle_state, true);

	// Slash (kill — all fours / prowl)
	slash_prowl_state := layer->create_state("004RAND/Slash_With_Hand_All_Fours", false, 0.8);
	layer->create_global_transition(slash_prowl_state, false)->create_trigger_condition(slash_prowl_trigger);
	layer->create_transition(slash_prowl_state, idle_state, true);

	// Slash (kill — escalated, 2+ stolen faces)
	slash_esc_state := layer->create_state("004RAND/Furious_Strikes_1_End", false, 1.0);
	layer->create_global_transition(slash_esc_state, false)->create_trigger_condition(slash_escalated_trigger);
	layer->create_transition(slash_esc_state, idle_state, true);

	// Prowl Lunge
	prowl_lunge_state := layer->create_state("004RAND/Creepy_Crawly_Full", false, 0.5);
	layer->create_global_transition(prowl_lunge_state, false)->create_trigger_condition(prowl_lunge_trigger);
	layer->create_transition(prowl_lunge_state, idle_state, true);

	// Spew Corruption
	spew_state := layer->create_state("004RAND/Spew_Corruption", false, 1.0);
	layer->create_global_transition(spew_state, false)->create_trigger_condition(spew_trigger);
	layer->create_transition(spew_state, idle_state, true);

	// Unleash transformation
	scream_state := layer->create_state("004RAND/Transform_Into_Ultimate_Form", false, 1.0);
	layer->create_global_transition(scream_state, false)->create_trigger_condition(scream_trigger);
	layer->create_transition(scream_state, idle_state, true);

	// Corrupt channeling
	corrupt_state := layer->create_state("004RAND/Slash_With_Hand_Dark", false, 1.0);
	layer->create_global_transition(corrupt_state, false)->create_trigger_condition(corrupt_trigger);
	layer->create_transition(corrupt_state, idle_state, true);
}

rr_mimicer_update_creature_anims :: proc(player: Player, dt: float) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if !mm.creature_visible return;
	if mm.creature_animator == null return;
	if mm.creature_animator.instance == null return;
	sm := mm.creature_animator.instance.state_machine;
	if sm == null return;

	moving := length_squared(player.agent.velocity) > 0.01;
	sm->set_bool("is_moving", moving);
	sm->set_bool("is_prowling", mm.is_prowling);
}

// =============================================================================
// Force Revert (death, meeting, round end)
// =============================================================================

rr_mimicer_force_revert :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	if mm.is_prowling {
		rr_mimicer_end_prowl(player);
	}

	if mm.is_disguised {
		rr_mimicer_end_disguise(player);
	}

	if mm.void_lunge_active {
		mm.void_lunge_active = false;
		player->remove_disable_movement_input_reason(MIMICER_VOID_LUNGE_LOCK_REASON);
	}

	if mm.swarm_active {
		rr_mimicer_end_swarm(player);
	}

	mm.is_monster_form = false;
	mm.skeleton_swap_at = 0.0;

	if mm.creature_visible {
		rr_mimicer_swap_to_player(player);
	}

	player->set_trigger("RESET");
	player->remove_disable_movement_input_reason(MIMICER_TRANSFORM_LOCK_REASON);
	player->remove_disable_movement_input_reason(MIMICER_SPEW_LOCK_REASON);
	player->remove_disable_movement_input_reason(MIMICER_UNLEASH_LOCK_REASON);
}

// =============================================================================
// Hitman Interaction — disguised Mimicer survives Hitman contract kill
// =============================================================================

rr_mimicer_should_survive_hitman_kill :: proc(killer: Player, victim: Player) -> bool {
	if killer == null return false;
	if victim == null return false;
	if killer.player_role != Player_Role.HITMAN return false;
	if victim.player_role != Player_Role.MIMICER return false;

	mm := victim.entity->get_component(Mimicer_Module);
	if mm == null return false;
	if !mm.is_disguised return false;

	hm := killer.entity->get_component(Hitman_Module);
	if hm == null return false;
	if hm.contract_target_id == 0 return false;

	if mm.disguise_target_id == hm.contract_target_id {
		hm.contract_target_id = 0;
		hm.kill_cooldown_adjust_seconds += HITMAN_OFF_CONTRACT_KILL_COOLDOWN_ADJUST_SECONDS;
		Notifier.notify(killer, "Contract failed! That was a Mimicer in disguise!");
		rr_mimicer_end_disguise(victim);
		Notifier.notify(victim, "Your disguise saved you from the Hitman!");
		return true;
	}
	return false;
}

// =============================================================================
// Kill Tracking & Stolen Faces
// =============================================================================

rr_mimicer_on_player_killed :: proc(killer_player_entity_id: u64, victim_player_entity_id: u64) {
	if !Game.is_server() return;

	killer := get_player_by_entity_id(killer_player_entity_id);
	if killer == null return;
	if killer.player_role != Player_Role.MIMICER return;

	mm := killer.entity->get_component(Mimicer_Module);
	if mm == null return;

	mm.kills += 1;

	// Track if this kill was while disguised (for 2x stolen faces on corrupt)
	if mm.is_disguised {
		mm.last_kill_was_disguised = true;
	}

	// Play kill animation
	if mm.is_monster_form && mm.creature_visible {
		if mm.stolen_faces >= MIMICER_KILL_ESCALATION_FACES {
			rr_mimicer_creature_trigger(killer, "slash_escalated");
		} else if mm.is_prowling {
			rr_mimicer_creature_trigger(killer, "slash_prowl");
		} else {
			rr_mimicer_creature_trigger(killer, "slash");
		}
	} else {
		killer->set_trigger("traitor_kill");
	}

	// Spoof killer identity on corpse when disguised
	if mm.is_disguised && mm.disguise_target_id != 0 {
		foreach corpse: component_iterator(Corpse) {
			if corpse == null continue;
			if !#alive(corpse.entity) continue;
			if corpse.owner_player_entity_id == victim_player_entity_id {
				corpse.killer_player_entity_id = mm.disguise_target_id;
				corpse.mimicer_disguised_kill = true;
				break;
			}
		}
	}
}

// =============================================================================
// Per-Frame Update
// =============================================================================

rr_mimicer_update :: proc(player: Player, dt: float) {
	if player == null return;

	if player.player_role != Player_Role.MIMICER || player.player_type != Player_Type.TRAITOR {
		return;
	}

	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	now := get_time();

	// Dead mimicer reverts
	if player.player_state != Player_State.ALIVE {
		if mm.is_monster_form || mm.creature_visible {
			rr_mimicer_force_revert(player);
		}
		return;
	}

	// Meetings: defer visual revert until teleport
	if game_state != Game_State.INGAME {
		return;
	}

	// Delayed skeleton swap (after transform animation)
	if mm.skeleton_swap_at > 0.0 && now >= mm.skeleton_swap_at {
		mm.skeleton_swap_at = 0.0;
		if mm.is_monster_form && !mm.creature_visible {
			rr_mimicer_swap_to_creature(player);
		}
	}

	// Prowl wall proximity check
	if mm.is_prowling {
		rr_mimicer_update_prowl(player, dt);
	}

	// Disguise expiry
	if mm.is_disguised && mm.disguise_ends_at > 0.0 && now >= mm.disguise_ends_at {
		rr_mimicer_end_disguise(player);
		Notifier.notify(player, "Disguise expired.");
	}

	// Void lunge movement
	if mm.void_lunge_active {
		rr_mimicer_update_void_lunge(player, dt);
	}

	// Teleport cooldown
	if mm.teleport_cooldown > 0.0 {
		mm.teleport_cooldown -= dt;
		if mm.teleport_cooldown < 0.0 {
			mm.teleport_cooldown = 0.0;
		}
	}

	// Swarm timer
	if mm.swarm_active {
		rr_mimicer_update_swarm(player, dt);
	}

	// Passives
	rr_mimicer_update_passives(player, dt);

	// Update creature locomotion anims
	rr_mimicer_update_creature_anims(player, dt);
}

// =============================================================================
// Prowl
// =============================================================================

rr_mimicer_start_prowl :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	mm.is_prowling = true;
	mm.prowl_near_wall = false;
	mm.prowl_speed_original = player.agent.movement_speed;
	mm.prowl_speed_active = true;
	player.agent.movement_speed = mm.prowl_speed_original * MIMICER_PROWL_SPEED_MULTIPLIER;

	if mm.is_monster_form {
		rr_mimicer_creature_trigger(player, "spawn_in");
	} else {
		player->set_trigger("mimicer_prowl_start");
	}
}

rr_mimicer_end_prowl :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if !mm.is_prowling return;

	mm.is_prowling = false;

	if mm.prowl_speed_active {
		player.agent.movement_speed = mm.prowl_speed_original;
		mm.prowl_speed_active = false;
	}

	if mm.prowl_near_wall {
		mm.prowl_near_wall = false;
		rr_mimicer_set_player_alpha(player, MIMICER_PROWL_NORMAL_ALPHA);
	}

	player->remove_invisibility_reason(MIMICER_PROWL_INVIS_REASON);
	player->remove_name_invisibility_reason(MIMICER_PROWL_INVIS_REASON);

	if !mm.is_monster_form {
		player->set_trigger("mimicer_prowl_end");
	}
}

rr_mimicer_update_prowl :: proc(player: Player, dt: float) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	pos := player.entity.world_position;

	near_wall := false;
	directions: [4]v2;
	directions[0] = v2.{1, 0};
	directions[1] = v2.{-1, 0};
	directions[2] = v2.{0, 1};
	directions[3] = v2.{0, -1};

	for i: 0..3 {
		test_point := v2.{pos.x + directions[i].x * MIMICER_PROWL_WALL_RANGE, pos.y + directions[i].y * MIMICER_PROWL_WALL_RANGE};
		closest: v2;
		nav_hint: int;
		if try_find_closest_point_on_navmesh(test_point, ref closest, ref nav_hint) {
			dist := length(v2.{test_point.x - closest.x, test_point.y - closest.y});
			if dist > 0.5 {
				near_wall = true;
			}
		}
	}

	was_near_wall := mm.prowl_near_wall;
	mm.prowl_near_wall = near_wall;

	if near_wall && !was_near_wall {
		rr_mimicer_set_player_alpha(player, MIMICER_PROWL_NEAR_WALL_ALPHA);
	} else if !near_wall && was_near_wall {
		rr_mimicer_set_player_alpha(player, MIMICER_PROWL_NORMAL_ALPHA);
	}
}

rr_mimicer_set_player_alpha :: proc(player: Player, alpha: float) {
	if player.animator != null && player.animator.instance != null {
		player.animator.instance.color_multiplier = v4.{1.0, 1.0, 1.0, alpha};
	}

	mm := player.entity->get_component(Mimicer_Module);
	if mm != null && mm.creature_visible && mm.creature_animator != null && mm.creature_animator.instance != null {
		mm.creature_animator.instance.color_multiplier = v4.{1.0, 1.0, 1.0, alpha};
	}
}

// =============================================================================
// Fake Nameplate helpers for disguise
// =============================================================================

rr_mimicer_ensure_fake_nameplate :: proc(player: Player, name: string) {
	fnp := player.entity->get_component(Fake_Nameplate);
	if fnp == null {
		fnp = player.entity->add_component(Fake_Nameplate);
	}
	fnp.display_name = name;
	fnp.hidden = false;
}

rr_mimicer_remove_fake_nameplate :: proc(player: Player) {
	fnp := player.entity->get_component(Fake_Nameplate);
	if fnp == null return;
	fnp.display_name = "";
	fnp.hidden = true;
}

// =============================================================================
// Disguise (from Void Pillars)
// =============================================================================

rr_mimicer_start_disguise_from_pillar :: proc(player: Player, pillar: Void_Pillar) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if player.animator == null return;
	if player.animator.instance == null return;

	// Save current appearance
	mm.disguise_saved_skins->clear();
	skins := player.animator.instance->get_skins();
	for i: 0..skins.count-1 {
		append(ref mm.disguise_saved_skins, skins[i]);
	}
	mm.disguise_saved_color = player.avatar_color;
	mm.disguise_target_id = pillar.stored_victim_entity_id;
	mm.disguise_target_name = pillar.stored_victim_name;

	// Apply stored victim's appearance
	player.animator.instance->disable_all_skins();
	for i: 0..pillar.stored_victim_skins.count-1 {
		player.animator.instance->enable_skin(pillar.stored_victim_skins[i]);
	}
	player.animator.instance->refresh_skins();
	player.animator.instance->set_color_replace_color(pillar.stored_victim_color);

	player->add_name_invisibility_reason("mimicer_disguise");

	// Show victim's name via a fake nameplate on the player entity.
	rr_mimicer_ensure_fake_nameplate(player, pillar.stored_victim_name);

	mm.is_disguised = true;
	mm.disguise_ends_at = get_time() + MIMICER_DISGUISE_DURATION;

	rr_mimicer_spawn_vfx(player.entity.world_position, "004RAND/Mimic_Poof", 1.0);
}

rr_mimicer_end_disguise :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if !mm.is_disguised return;

	if player.animator != null && player.animator.instance != null {
		player.animator.instance->disable_all_skins();
		for i: 0..mm.disguise_saved_skins.count-1 {
			player.animator.instance->enable_skin(mm.disguise_saved_skins[i]);
		}
		player.animator.instance->refresh_skins();
		player.animator.instance->set_color_replace_color(mm.disguise_saved_color);
	}

	player->remove_name_invisibility_reason("mimicer_disguise");

	// Remove the fake nameplate from the player entity.
	rr_mimicer_remove_fake_nameplate(player);

	mm.is_disguised = false;
	mm.disguise_ends_at = 0.0;
	mm.disguise_target_id = 0;
	mm.disguise_target_name = "";

	rr_mimicer_spawn_vfx(player.entity.world_position, "004RAND/Mimic_Poof", 1.0);
}

// =============================================================================
// Void Lunge
// =============================================================================

rr_mimicer_start_void_lunge :: proc(player: Player, target_pos: v2) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	start_pos := player.entity.world_position;
	dir := v2.{target_pos.x - start_pos.x, target_pos.y - start_pos.y};
	dist := length(dir);
	if dist < 0.1 return;

	if dist > MIMICER_VOID_LUNGE_DISTANCE {
		dir = v2.{dir.x / dist * MIMICER_VOID_LUNGE_DISTANCE, dir.y / dist * MIMICER_VOID_LUNGE_DISTANCE};
	}

	final_target := v2.{start_pos.x + dir.x, start_pos.y + dir.y};

	clamped: v2;
	nav_hint: int;
	if try_find_closest_point_on_navmesh(final_target, ref clamped, ref nav_hint) {
		final_target = clamped;
	}

	mm.void_lunge_active = true;
	mm.void_lunge_start_pos = start_pos;
	mm.void_lunge_target_pos = final_target;
	mm.void_lunge_start_time = get_time();
	mm.void_lunge_duration = MIMICER_VOID_LUNGE_DURATION;

	player->add_disable_movement_input_reason(MIMICER_VOID_LUNGE_LOCK_REASON);

	if mm.creature_visible {
		if mm.is_prowling {
			rr_mimicer_creature_trigger(player, "prowl_lunge");
		} else {
			rr_mimicer_creature_trigger(player, "lunge");
		}
	}
}

rr_mimicer_update_void_lunge :: proc(player: Player, dt: float) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if !mm.void_lunge_active return;

	now := get_time();
	elapsed := now - mm.void_lunge_start_time;
	t := elapsed / mm.void_lunge_duration;

	if t >= 1.0 {
		player.entity->set_local_position(mm.void_lunge_target_pos);
		mm.void_lunge_active = false;
		player->remove_disable_movement_input_reason(MIMICER_VOID_LUNGE_LOCK_REASON);

		if mm.is_monster_form && mm.creature_visible {
			rr_mimicer_creature_trigger(player, "lunge_end");
		}

		if Game.is_server() {
			nearby: [..]Player;
			Scene.get_all_components_in_range(mm.void_lunge_target_pos, MIMICER_VOID_LUNGE_HIT_RADIUS, ref nearby);
			for i: 0..nearby.count-1 {
				hit := nearby[i];
				if hit == null continue;
				if hit.entity.id == player.entity.id continue;
				if hit.player_state != Player_State.ALIVE continue;
				rr_mimicer_stun_player(hit, MIMICER_VOID_LUNGE_STUN_SECONDS);
			}
		}
		return;
	}

	new_pos := v2.{
		lerp(mm.void_lunge_start_pos.x, mm.void_lunge_target_pos.x, t),
		lerp(mm.void_lunge_start_pos.y, mm.void_lunge_target_pos.y, t)
	};
	player.entity->set_local_position(new_pos);

	if Game.is_server() {
		nearby: [..]Player;
		Scene.get_all_components_in_range(new_pos, MIMICER_VOID_LUNGE_HIT_RADIUS, ref nearby);
		for i: 0..nearby.count-1 {
			hit := nearby[i];
			if hit == null continue;
			if hit.entity.id == player.entity.id continue;
			if hit.player_state != Player_State.ALIVE continue;
			rr_mimicer_stun_player(hit, MIMICER_VOID_LUNGE_STUN_SECONDS);
		}
	}
}

// =============================================================================
// Stun (Void Lunge target)
// =============================================================================

Mimicer_Stun :: class : Component {
	end_time: float;
	active: bool;

	ao_update :: method(dt: float) {
		if !active return;
		if get_time() >= end_time {
			active = false;
			p := entity->get_component(Player);
			if p != null {
				p->remove_disable_movement_input_reason(MIMICER_STUN_REASON);
				p->set_trigger("RESET");
			}
		}
	}
}

rr_mimicer_stun_player :: proc(target: Player, seconds: float) {
	existing := target.entity->get_component(Mimicer_Stun);
	if existing != null && existing.active return;

	target->add_disable_movement_input_reason(MIMICER_STUN_REASON);

	stun := existing;
	if stun == null {
		stun = target.entity->add_component(Mimicer_Stun);
	}
	stun.end_time = get_time() + seconds;
	stun.active = true;
}

// =============================================================================
// Spew Corruption
// =============================================================================

rr_mimicer_spew_corruption :: proc(player: Player, target: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	target.mimicer_blinded = true;
	target.mimicer_blinded_until = get_time() + MIMICER_SPEW_BLIND_SECONDS;
	target.mimicer_distorted_until = get_time() + MIMICER_SPEW_DISTORT_SECONDS;
	target->set_trigger("mimicer_blinded_start");
	target->add_disable_movement_input_reason(MIMICER_SPEW_LOCK_REASON);

	if mm.is_monster_form && mm.creature_visible {
		rr_mimicer_creature_trigger(player, "spew");
	}

	// Spawn hallucination mimicer creatures on every other alive player.
	// Created disabled; the blinded client's on_state_sync will enable them locally.
	rr_mimicer_spawn_halluc_creatures(target);
}

// =============================================================================
// Spew Hallucination — blinded player sees everyone as a Mimicer
// =============================================================================

MIMICER_HALLUC_INVIS_REASON :: "mimicer_halluc";

Mim_Halluc_Creature :: class : Component {
	blinded_player_id: u64;
	halluc_spine: Spine_Animator;

	ao_on_state_sync :: method() {
		local_player, ok := Game.get_local_player();
		if !ok return;

		if local_player.entity.id == blinded_player_id {
			entity->set_local_enabled(true);
			parent := entity.parent;
			if parent != null {
				p := parent->get_component(Player);
				if p != null {
					p->add_invisibility_reason(MIMICER_HALLUC_INVIS_REASON);
					p->add_name_invisibility_reason(MIMICER_HALLUC_INVIS_REASON);
				}
			}
		} else {
			entity->set_local_enabled(false);
		}
	}

	ao_update :: method(dt: float) {
		if halluc_spine == null return;
		if halluc_spine.instance == null return;
		sm := halluc_spine.instance.state_machine;
		if sm == null return;

		parent := entity.parent;
		if parent == null return;
		p := parent->get_component(Player);
		if p == null return;

		moving := length_squared(p.agent.velocity) > 0.01;
		sm->set_bool("is_moving", moving);
	}

	ao_end :: method() {
		parent := entity.parent;
		if parent != null {
			p := parent->get_component(Player);
			if p != null {
				p->remove_invisibility_reason(MIMICER_HALLUC_INVIS_REASON);
				p->remove_name_invisibility_reason(MIMICER_HALLUC_INVIS_REASON);
			}
		}
	}
}

rr_mimicer_setup_halluc_state_machine :: proc(ca: Spine_Animator) {
	sm := State_Machine.create();
	layer := sm->create_layer("main", 0);

	is_moving := sm->create_variable("is_moving", .BOOL);

	idle_state := layer->create_state("004RAND/Idle", true, 0.0);
	move_state := layer->create_state("004RAND/Move", true, 0.0);
	layer->set_initial_state(idle_state);

	idle_to_move := layer->create_transition(idle_state, move_state, false);
	idle_to_move->create_bool_condition(is_moving, true);
	move_to_idle := layer->create_transition(move_state, idle_state, false);
	move_to_idle->create_bool_condition(is_moving, false);

	ca.instance->set_state_machine(sm, true);
}

rr_mimicer_spawn_halluc_creatures :: proc(blinded_player: Player) {
	foreach p: component_iterator(Player) {
		if p == null continue;
		if p.entity.id == blinded_player.entity.id continue;
		if p.player_state != Player_State.ALIVE continue;

		he := Scene.create_entity();
		he->set_parent(p.entity, false);
		he->set_local_position(v2.{0, 0});
		he->set_local_scale(v2.{1, 1});
		he->set_local_rotation(0.0);

		ha := he->add_component(Spine_Animator);
		ha->awaken();
		if ha.instance != null {
			ha.instance->set_skeleton(get_asset(Spine_Asset, MIMICER_CREATURE_RIG));
			ha.instance->set_skin("normal");
			ha.instance->set_animation("004RAND/Idle", true, 0);
			rr_mimicer_setup_halluc_state_machine(ha);
		}

		hc := he->add_component(Mim_Halluc_Creature);
		hc.blinded_player_id = blinded_player.entity.id;
		hc.halluc_spine = ha;
	}
}

rr_mimicer_destroy_halluc_creatures :: proc(player: Player) {
	foreach hc: component_iterator(Mim_Halluc_Creature) {
		if hc == null continue;
		if hc.blinded_player_id != player.entity.id continue;
		if hc.entity != null && #alive(hc.entity) {
			hc.entity->destroy();
		}
	}
}

// =============================================================================
// Void Pillar System
// =============================================================================

Void_Pillar :: class : Component {
	owner_entity_id: u64;
	stored_victim_entity_id: u64;
	stored_victim_name: string;
	stored_victim_skins: [..]string;
	stored_victim_color: Color_Replace_Color;
	is_smoldered: bool;
	pillar_spine: Spine_Animator;
}

rr_mimicer_create_void_pillar :: proc(player: Player, pos: v2, corpse: Corpse) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	// Create pillar entity
	pillar_entity := Scene.create_entity();
	pillar_entity->set_local_position(pos);
	pillar_entity->set_local_scale(v2.{1, 1});

	pillar_spine := pillar_entity->add_component(Spine_Animator);
	pillar_spine->awaken();
	if pillar_spine.instance != null {
		pillar_spine.instance->set_skeleton(get_asset(Spine_Asset, MIMICER_PILLAR_RIG));

		// State machine: Start → Idle (loop)
		psm := State_Machine.create();
		plyr := psm->create_layer("main", 0);
		start_state := plyr->create_state("012MIM/Dark_Flame_Pillar_Start", false, 0.0);
		idle_state := plyr->create_state("012MIM/Dark_Flame_Pillar_Idle", true, 0.0);
		plyr->set_initial_state(start_state);
		plyr->create_transition(start_state, idle_state, true);
		pillar_spine.instance->set_state_machine(psm, true);
	}

	// Set up Void_Pillar component
	pillar := pillar_entity->add_component(Void_Pillar);
	pillar.owner_entity_id = player.entity.id;
	pillar.pillar_spine = pillar_spine;

	// Store victim identity from corpse
	pillar.stored_victim_entity_id = corpse.owner_player_entity_id;

	// Get victim name
	victim := get_player_by_entity_id(corpse.owner_player_entity_id);
	if victim != null {
		pillar.stored_victim_name = victim->get_username();
	} else {
		pillar.stored_victim_name = "Unknown";
	}

	// Store victim skins from corpse's spine
	corpse_spine := corpse.entity->get_component(Spine_Animator);
	if corpse_spine != null && corpse_spine.instance != null {
		corpse_skins := corpse_spine.instance->get_skins();
		for i: 0..corpse_skins.count-1 {
			append(ref pillar.stored_victim_skins, corpse_skins[i]);
		}
		pillar.stored_victim_color = corpse_spine.instance.color_replace_color;
	} else if victim != null && victim.animator != null && victim.animator.instance != null {
		// Fallback: read from victim player
		victim_skins := victim.animator.instance->get_skins();
		for i: 0..victim_skins.count-1 {
			append(ref pillar.stored_victim_skins, victim_skins[i]);
		}
		pillar.stored_victim_color = victim.avatar_color;
	}

	pillar.is_smoldered = false;

	// Add interactables
	pillar_entity->add_component(Void_Pillar_Mimicer_Interact);
	pillar_entity->add_component(Void_Pillar_Civilian_Interact);

	// Track pillar
	append(ref mm.void_pillars, pillar_entity);

	// Award stolen faces
	faces := 1;
	if corpse.mimicer_disguised_kill {
		faces = 2;
	}
	// Only award if the Mimicer killed this victim
	if corpse.killer_player_entity_id == player.entity.id || corpse.mimicer_disguised_kill {
		mm.stolen_faces += faces;

		if mm.stolen_faces >= MIMICER_VOID_LUNGE_UNLOCK_FACES && mm.stolen_faces - faces < MIMICER_VOID_LUNGE_UNLOCK_FACES {
			Notifier.notify(player, "Void Lunge unlocked!");
		} else if mm.stolen_faces >= MIMICER_SPEW_UNLOCK_FACES && mm.stolen_faces - faces < MIMICER_SPEW_UNLOCK_FACES {
			Notifier.notify(player, "Spew Corruption unlocked!");
		} else if mm.stolen_faces >= MIMICER_UNLEASH_UNLOCK_FACES && mm.stolen_faces - faces < MIMICER_UNLEASH_UNLOCK_FACES {
			Notifier.notify(player, "Unleash is ready!");
		}
	}
	mm.last_kill_was_disguised = false;
}

rr_mimicer_smolder_pillar :: proc(pillar: Void_Pillar) {
	if pillar == null return;
	pillar.is_smoldered = true;

	if pillar.pillar_spine != null && pillar.pillar_spine.instance != null {
		pillar.pillar_spine.instance->set_animation("012MIM/Dark_Flame_Pillar_End", false, 0);
		pillar.pillar_spine.instance.color_multiplier = v4.{0.3, 0.3, 0.3, 0.4};
	}
}

rr_mimicer_reignite_pillar :: proc(pillar: Void_Pillar) {
	if pillar == null return;
	pillar.is_smoldered = false;

	if pillar.pillar_spine != null && pillar.pillar_spine.instance != null {
		pillar.pillar_spine.instance->set_animation("012MIM/Dark_Flame_Pillar_Start", false, 0);
		pillar.pillar_spine.instance.color_multiplier = v4.{1.0, 1.0, 1.0, 1.0};
	}
}

rr_mimicer_get_active_pillar_count :: proc(player: Player) -> int {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return 0;
	count := 0;
	for i: 0..mm.void_pillars.count-1 {
		if mm.void_pillars[i] == null continue;
		if !#alive(mm.void_pillars[i]) continue;
		vp := mm.void_pillars[i]->get_component(Void_Pillar);
		if vp != null && !vp.is_smoldered {
			count += 1;
		}
	}
	return count;
}

rr_mimicer_clear_void_pillars :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	for i: 0..mm.void_pillars.count-1 {
		if mm.void_pillars[i] != null && #alive(mm.void_pillars[i]) {
			mm.void_pillars[i]->destroy();
		}
	}
	mm.void_pillars->clear();
}

// =============================================================================
// Corrupt Interactable (on corpses — Mimicer channels to create Void Pillar)
// =============================================================================

Mimicer_Corrupt_Interactable :: class : Interactable {
	ao_start :: method() {
		this->set_listener(this);
		this->set_text("Corrupt");
		this->set_hold_text("Corrupting...");
		required_hold_time = MIMICER_CORRUPT_CHANNEL_SECONDS;
		radius = MIMICER_CORRUPT_INTERACT_RADIUS;
		prompt_offset = v2.{0, 1.5};
		priority = 100;
	}

	can_use :: method(player: Player) -> bool {
		if player.player_role != Player_Role.MIMICER return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_state != Player_State.ALIVE return false;

		corpse := entity->get_component(Corpse);
		if corpse == null return false;

		return true;
	}

	on_interact :: method(player: Player) {
		corpse := entity->get_component(Corpse);
		if corpse == null return;

		pos := entity.world_position;

		// Play corrupt animation on creature rig
		mm := player.entity->get_component(Mimicer_Module);
		if mm != null && mm.is_monster_form && mm.creature_visible {
			rr_mimicer_creature_trigger(player, "corrupt");
		}

		// Create the Void Pillar
		rr_mimicer_create_void_pillar(player, pos, corpse);

		// Destroy the corpse
		entity->destroy();
	}
}

// =============================================================================
// Void Pillar Interactables
// =============================================================================

// --- Mimicer interaction: Disguise (active pillar) or Reignite (smoldered) ---
Void_Pillar_Mimicer_Interact :: class : Interactable {
	ao_start :: method() {
		this->set_listener(this);
		this->set_text("Disguise");
		radius = MIMICER_PILLAR_INTERACT_RADIUS;
		prompt_offset = v2.{0, 2.0};
	}

	can_use :: method(player: Player) -> bool {
		if player.player_role != Player_Role.MIMICER return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_state != Player_State.ALIVE return false;

		vp := entity->get_component(Void_Pillar);
		if vp == null return false;

		mm := player.entity->get_component(Mimicer_Module);
		if mm == null return false;

		if vp.is_smoldered {
			this->set_text("Reignite");
			this->set_hold_text("Reigniting...");
			required_hold_time = MIMICER_PILLAR_REIGNITE_SECONDS;
		} else {
			if mm.is_disguised {
				return false;
			}
			this->set_text("Disguise");
			this->set_hold_text("");
			required_hold_time = 0.0;
		}

		return true;
	}

	on_interact :: method(player: Player) {
		vp := entity->get_component(Void_Pillar);
		if vp == null return;

		if vp.is_smoldered {
			rr_mimicer_reignite_pillar(vp);
			Notifier.notify(player, "Void Pillar reignited!");
		} else {
			mm := player.entity->get_component(Mimicer_Module);
			if mm == null return;
			if mm.is_disguised return;

			// If in monster form, swap to player first for disguise
			if mm.is_monster_form && mm.creature_visible {
				rr_mimicer_swap_to_player(player);
			}

			rr_mimicer_start_disguise_from_pillar(player, vp);
			Notifier.notify(player, format_string("Disguised as %!", {vp.stored_victim_name}));
		}
	}
}

// --- Civilian interaction: Extinguish active pillar into Smolder ---
Void_Pillar_Civilian_Interact :: class : Interactable {
	ao_start :: method() {
		this->set_listener(this);
		this->set_text("Extinguish");
		this->set_hold_text("Extinguishing...");
		required_hold_time = MIMICER_PILLAR_SMOLDER_SECONDS;
		radius = MIMICER_PILLAR_INTERACT_RADIUS;
		prompt_offset = v2.{0, 2.0};
	}

	can_use :: method(player: Player) -> bool {
		if player.player_type == Player_Type.TRAITOR return false;
		if player.player_state != Player_State.ALIVE return false;

		vp := entity->get_component(Void_Pillar);
		if vp == null return false;
		if vp.is_smoldered return false;

		return true;
	}

	on_interact :: method(player: Player) {
		vp := entity->get_component(Void_Pillar);
		if vp == null return;

		rr_mimicer_smolder_pillar(vp);
		Notifier.notify(player, "Void Pillar extinguished!");
	}
}

// =============================================================================
// Teleport (to a specific or next active Void Pillar)
// =============================================================================

rr_mimicer_teleport_to_pillar :: proc(player: Player, target_pillar: Entity) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if mm.teleport_cooldown > 0.0 return;

	if target_pillar == null return;
	if !#alive(target_pillar) return;
	vp := target_pillar->get_component(Void_Pillar);
	if vp == null return;
	if vp.is_smoldered return;

	pos := target_pillar.world_position;
	player.entity->set_local_position(pos);

	rr_mimicer_spawn_vfx(pos, "004RAND/Teleport", 1.5);

	mm.teleport_cooldown = MIMICER_TELEPORT_COOLDOWN;
}

rr_mimicer_teleport_to_next_pillar :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	// Build list of active (non-smoldered) pillars
	active_pillars: [..]Entity;
	for i: 0..mm.void_pillars.count-1 {
		if mm.void_pillars[i] == null continue;
		if !#alive(mm.void_pillars[i]) continue;
		vp := mm.void_pillars[i]->get_component(Void_Pillar);
		if vp != null && !vp.is_smoldered {
			append(ref active_pillars, mm.void_pillars[i]);
		}
	}

	if active_pillars.count == 0 {
		Notifier.notify(player, "No active Void Pillars!");
		return;
	}

	// Cycle to next pillar
	if mm.teleport_pillar_index >= active_pillars.count {
		mm.teleport_pillar_index = 0;
	}

	target_pillar := active_pillars[mm.teleport_pillar_index];
	mm.teleport_pillar_index += 1;
	if mm.teleport_pillar_index >= active_pillars.count {
		mm.teleport_pillar_index = 0;
	}

	pos := target_pillar.world_position;
	player.entity->set_local_position(pos);

	rr_mimicer_spawn_vfx(pos, "004RAND/Teleport", 1.5);

	mm.teleport_cooldown = MIMICER_TELEPORT_COOLDOWN;
}

// =============================================================================
// Passives
// =============================================================================

rr_mimicer_update_passives :: proc(player: Player, dt: float) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	pos := player.entity.world_position;

	// Void Tether: +20% speed near active Void Pillars
	near_pillar := false;
	for i: 0..mm.void_pillars.count-1 {
		if mm.void_pillars[i] == null continue;
		if !#alive(mm.void_pillars[i]) continue;
		vp := mm.void_pillars[i]->get_component(Void_Pillar);
		if vp == null continue;
		if vp.is_smoldered continue;

		pillar_pos := mm.void_pillars[i].world_position;
		dist := length(v2.{pos.x - pillar_pos.x, pos.y - pillar_pos.y});
		if dist <= MIMICER_VOID_TETHER_RANGE {
			near_pillar = true;
			break;
		}
	}

	// Apply/remove tether speed bonus
	// This is handled as a flag to avoid stacking with prowl speed changes
	if near_pillar && !mm.is_prowling {
		// Only set the bonus flag, actual speed is applied by base speed * multiplier
		// We use a simple approach: adjust speed if not already adjusted
	}

	// Void Hunger: Kill CD reduced by 2s per active pillar
	// (Applied in Kill ability on_update via rr_mimicer_get_void_hunger_reduction)
}

rr_mimicer_get_void_hunger_reduction :: proc(player: Player) -> float {
	active := rr_mimicer_get_active_pillar_count(player);
	return active.(float) * MIMICER_VOID_HUNGER_CD_REDUCTION;
}

rr_mimicer_is_near_active_pillar :: proc(player: Player) -> bool {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return false;

	pos := player.entity.world_position;
	for i: 0..mm.void_pillars.count-1 {
		if mm.void_pillars[i] == null continue;
		if !#alive(mm.void_pillars[i]) continue;
		vp := mm.void_pillars[i]->get_component(Void_Pillar);
		if vp == null continue;
		if vp.is_smoldered continue;

		pillar_pos := mm.void_pillars[i].world_position;
		dist := length(v2.{pos.x - pillar_pos.x, pos.y - pillar_pos.y});
		if dist <= MIMICER_VOID_TETHER_RANGE {
			return true;
		}
	}
	return false;
}

// =============================================================================
// Unleash: Doppelganger Swarm
// =============================================================================

Mimicer_Shadow_Clone :: class : Component {
	victim_entity_id: u64;
	victim_name: string;
	victim_skins: [..]string;
	victim_color: Color_Replace_Color;
	is_fading: bool;
	fade_start_time: float;
	clone_spine: Spine_Animator;
}

rr_mimicer_begin_unleash :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	mm.unleash_used = true;
	mm.is_ultimate_form = true;

	player->add_disable_movement_input_reason(MIMICER_UNLEASH_LOCK_REASON);

	// Switch to final_form skin on creature
	if mm.creature_animator != null && mm.creature_animator.instance != null {
		mm.creature_animator.instance->set_skin("final_form");
		mm.creature_animator.instance->refresh_skins();
	}

	// Play scream animation
	if mm.creature_visible {
		rr_mimicer_creature_trigger(player, "scream");
	}

	// Jumpscare all non-mimicer players
	jumpscare_end := get_time() + MIMICER_JUMPSCARE_DURATION;
	foreach p: component_iterator(Player) {
		if p == null continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.entity.id == player.entity.id continue;
		p.mim_jumpscare_until = jumpscare_end;
	}

	// Spawn shadow clones at all active void pillars
	mm.swarm_clones->clear();
	for i: 0..mm.void_pillars.count-1 {
		if mm.void_pillars[i] == null continue;
		if !#alive(mm.void_pillars[i]) continue;
		vp := mm.void_pillars[i]->get_component(Void_Pillar);
		if vp == null continue;
		if vp.is_smoldered continue;

		clone_entity := rr_mimicer_spawn_shadow_clone(vp);
		if clone_entity != null {
			append(ref mm.swarm_clones, clone_entity);
		}
	}

	mm.swarm_active = true;
	mm.swarm_scream_until = get_time() + 1.5;
	mm.swarm_end_time = mm.swarm_scream_until + MIMICER_SWARM_DURATION;
	mm.swarm_current_index = 0;
	mm.swarm_clone_framed = false;
}

rr_mimicer_spawn_shadow_clone :: proc(pillar: Void_Pillar) -> Entity {
	clone_entity := Scene.create_entity();
	clone_entity->set_local_position(pillar.entity.world_position);
	clone_entity->set_local_scale(v2.{1, 1});

	// Set up spine with victim appearance
	clone_spine := clone_entity->add_component(Spine_Animator);
	clone_spine->awaken();
	if clone_spine.instance != null {
		// Use the player rig skeleton
		clone_spine.instance->set_skeleton(get_asset(Spine_Asset, "$AO/player/playercharacter.spine"));
		clone_spine.instance->disable_all_skins();
		for i: 0..pillar.stored_victim_skins.count-1 {
			clone_spine.instance->enable_skin(pillar.stored_victim_skins[i]);
		}
		clone_spine.instance->refresh_skins();
		clone_spine.instance->set_color_replace_color(pillar.stored_victim_color);
		clone_spine.instance->set_animation("Idle", true, 0);
	}

	clone := clone_entity->add_component(Mimicer_Shadow_Clone);
	clone.victim_entity_id = pillar.stored_victim_entity_id;
	clone.victim_name = pillar.stored_victim_name;
	for i: 0..pillar.stored_victim_skins.count-1 {
		append(ref clone.victim_skins, pillar.stored_victim_skins[i]);
	}
	clone.victim_color = pillar.stored_victim_color;
	clone.clone_spine = clone_spine;

	// Fake nameplate so the clone shows the victim's name like a real player.
	fnp := clone_entity->add_component(Fake_Nameplate);
	fnp.display_name = pillar.stored_victim_name;

	return clone_entity;
}

rr_mimicer_inhabit_clone :: proc(player: Player, index: int) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if index < 0 || index >= mm.swarm_clones.count return;

	clone_entity := mm.swarm_clones[index];
	if clone_entity == null return;
	if !#alive(clone_entity) return;

	clone := clone_entity->get_component(Mimicer_Shadow_Clone);
	if clone == null return;

	// Reset framing state when switching clones
	mm.swarm_clone_framed = false;

	// End current disguise if active
	if mm.is_disguised {
		rr_mimicer_end_disguise(player);
	}

	// Teleport to clone position
	player.entity->set_local_position(clone_entity.world_position);

	// Disguise as clone's victim (manually apply, not via pillar)
	mm.disguise_saved_skins->clear();
	if player.animator != null && player.animator.instance != null {
		skins := player.animator.instance->get_skins();
		for i: 0..skins.count-1 {
			append(ref mm.disguise_saved_skins, skins[i]);
		}
		mm.disguise_saved_color = player.avatar_color;
		mm.disguise_target_id = clone.victim_entity_id;
		mm.disguise_target_name = clone.victim_name;

		player.animator.instance->disable_all_skins();
		for i: 0..clone.victim_skins.count-1 {
			player.animator.instance->enable_skin(clone.victim_skins[i]);
		}
		player.animator.instance->refresh_skins();
		player.animator.instance->set_color_replace_color(clone.victim_color);
	}

	player->add_name_invisibility_reason("mimicer_disguise");

	// Show victim's name via a fake nameplate on the player entity.
	rr_mimicer_ensure_fake_nameplate(player, clone.victim_name);

	mm.is_disguised = true;
	mm.disguise_ends_at = 0.0;

	// If in monster form, swap to player for disguise
	if mm.creature_visible {
		rr_mimicer_swap_to_player(player);
	}

	// Hide the clone entity (Mimicer IS the clone now)
	clone_entity->set_local_enabled(false);

	mm.swarm_current_index = index;
}

rr_mimicer_cycle_clone :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if !mm.swarm_active return;
	if mm.swarm_clones.count == 0 return;

	// Spawn a fading remnant at current position
	rr_mimicer_spawn_fade_clone(player);

	// Find next valid clone
	next_index := mm.swarm_current_index + 1;
	for attempt: 0..mm.swarm_clones.count-1 {
		if next_index >= mm.swarm_clones.count {
			next_index = 0;
		}
		if mm.swarm_clones[next_index] != null && #alive(mm.swarm_clones[next_index]) {
			clone := mm.swarm_clones[next_index]->get_component(Mimicer_Shadow_Clone);
			if clone != null && !clone.is_fading {
				rr_mimicer_inhabit_clone(player, next_index);
				return;
			}
		}
		next_index += 1;
	}

	// No more clones — end swarm
	rr_mimicer_end_swarm(player);
}

rr_mimicer_spawn_fade_clone :: proc(player: Player) {
	// Create a visual remnant at the player's current position that fades out
	pos := player.entity.world_position;

	fade_entity := Scene.create_entity();
	fade_entity->set_local_position(pos);
	fade_entity->set_local_scale(v2.{1, 1});

	fade_cleanup := fade_entity->add_component(Mimicer_VFX_Cleanup);
	fade_cleanup.destroy_at = get_time() + MIMICER_SWARM_CLONE_FADE_SECONDS;

	// Copy current player appearance to the remnant
	fade_spine := fade_entity->add_component(Spine_Animator);
	fade_spine->awaken();
	if fade_spine.instance != null && player.animator != null && player.animator.instance != null {
		fade_spine.instance->set_skeleton(player.animator.instance->get_skeleton());
		current_skins := player.animator.instance->get_skins();
		for i: 0..current_skins.count-1 {
			fade_spine.instance->enable_skin(current_skins[i]);
		}
		fade_spine.instance->refresh_skins();
		fade_spine.instance->set_color_replace_color(player.avatar_color);
		fade_spine.instance->set_animation("Idle", true, 0);
		fade_spine.instance.color_multiplier = v4.{1.0, 1.0, 1.0, 0.6};
	}
}

rr_mimicer_update_swarm :: proc(player: Player, dt: float) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	now := get_time();

	// Wait for scream animation to finish before inhabiting first clone
	if mm.swarm_scream_until > 0.0 && now >= mm.swarm_scream_until {
		mm.swarm_scream_until = 0.0;
		player->remove_disable_movement_input_reason(MIMICER_UNLEASH_LOCK_REASON);
		if mm.swarm_clones.count > 0 {
			rr_mimicer_inhabit_clone(player, 0);
		}
	}

	if now >= mm.swarm_end_time {
		rr_mimicer_end_swarm(player);
		return;
	}
}

rr_mimicer_end_swarm :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;

	mm.swarm_active = false;
	mm.swarm_clone_framed = false;
	mm.swarm_scream_until = 0.0;

	// Destroy all remaining clone entities
	for i: 0..mm.swarm_clones.count-1 {
		if mm.swarm_clones[i] != null && #alive(mm.swarm_clones[i]) {
			mm.swarm_clones[i]->destroy();
		}
	}
	mm.swarm_clones->clear();

	// End disguise
	if mm.is_disguised {
		rr_mimicer_end_disguise(player);
	}

	// Restore creature form — Mimicer was in monster form before unleash
	if mm.is_monster_form && !mm.creature_visible {
		rr_mimicer_swap_to_creature(player);
	}

	player->remove_disable_movement_input_reason(MIMICER_UNLEASH_LOCK_REASON);
	Notifier.notify(player, "Doppelganger Swarm ended.");
}

// =============================================================================
// VFX Helper
// =============================================================================

rr_mimicer_spawn_vfx :: proc(position: v2, anim_name: string, lifetime: float) {
	vfx_entity := Scene.create_entity();
	vfx_entity->set_local_position(position);
	vfx_entity->set_local_scale(v2.{1, 1});

	vfx_spine := vfx_entity->add_component(Spine_Animator);
	vfx_spine->awaken();
	if vfx_spine.instance != null {
		vfx_spine.instance->set_skeleton(get_asset(Spine_Asset, MIMICER_VFX_RIG));
		vfx_spine.instance->set_animation(anim_name, false, 0);
	}

	cleanup := vfx_entity->add_component(Mimicer_VFX_Cleanup);
	cleanup.destroy_at = get_time() + lifetime;
}

Mimicer_VFX_Cleanup :: class : Component {
	destroy_at: float;

	ao_update :: method(dt: float) {
		if get_time() >= destroy_at {
			entity->destroy();
		}
	}
}

// =============================================================================
// Disguise Name Rendering
// =============================================================================

rr_mimicer_draw_disguise_name :: proc(player: Player) {
	mm := player.entity->get_component(Mimicer_Module);
	if mm == null return;
	if !mm.is_disguised return;
	if mm.disguise_target_name == "" return;

	pos := player.entity.world_position;
	label_pos := pos + v2.{0.0, 1.6};
	label_rect := Rect{label_pos, label_pos}->grow(0.10, 1.00, 0.10, 1.00);

	ts := UI.default_text_settings();
	ts.size = 0.26;
	ts.color = v4.{1.0, 1.0, 1.0, 1.0};
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 0.03;
	ts.outline_color = v4.{0.0, 0.0, 0.0, 1.0};

	UI.text(label_rect, ts, mm.disguise_target_name);
}

// =============================================================================
// Blind/Distort Update
// =============================================================================

rr_mimicer_update_blind :: proc(player: Player, dt: float) {
	if !player.mimicer_blinded && player.mimicer_distorted_until <= 0.0 return;

	now := get_time();

	if player.mimicer_blinded && now >= player.mimicer_blinded_until {
		player.mimicer_blinded = false;
		player->remove_disable_movement_input_reason(MIMICER_SPEW_LOCK_REASON);
		player->set_trigger("mimicer_blinded_end");
	}

	if player.mimicer_distorted_until > 0.0 && now >= player.mimicer_distorted_until {
		player.mimicer_distorted_until = 0.0;
		rr_mimicer_destroy_halluc_creatures(player);
	}
}

// Client-side: draw dark overlay when spew-blinded (like GGG trap).
rr_draw_mim_blind_overlay :: proc(player: Player) {
	if player == null return;
	if !player->is_local() return;
	if !player.mimicer_blinded return;

	screen := UI.get_screen_rect();
	UI.push_layer(9998);
	defer UI.pop_layer();

	bg := get_asset(Texture_Asset, "$AO/white.png");
	UI.quad(screen, bg, v4.{0.0, 0.0, 0.0, 0.92});
}


// Doctor cure helper
rr_mimicer_cure_spew :: proc(target: Player) {
	target.mimicer_blinded = false;
	target.mimicer_blinded_until = 0.0;
	target.mimicer_distorted_until = 0.0;
	target->remove_disable_movement_input_reason(MIMICER_SPEW_LOCK_REASON);
	target->set_trigger("mimicer_blinded_end");
	rr_mimicer_destroy_halluc_creatures(target);
}

// =============================================================================
// Abilities
// =============================================================================

// --- Mimicer Kill (25s CD, extended range in monster, disguised name spoofing) ---
Mimicer_Kill_Ability :: class : Ability_Base {
	NAME :: "Kill";

	on_init :: proc(instance: Mimicer_Kill_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/mimicer/kill_purple_slash.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.MIMICER return false;

		mm := player.entity->get_component(Mimicer_Module);
		if mm == null return false;
		if mm.void_lunge_active return false;
		if mm.swarm_active return false;
		return true;
	}

	get_closest_kill_target :: proc(instance: Mimicer_Kill_Ability, player: Player) -> Player {
		mm := player.entity->get_component(Mimicer_Module);
		kill_range := MIMICER_KILL_RANGE_SCHLEEM;
		if mm != null && mm.is_monster_form {
			kill_range = MIMICER_KILL_RANGE_MONSTER;
		}

		finder := make_finder(Player, player.entity.world_position, kill_range);
		foreach target: component_iterator(Player) {
			if target == null continue;
			if target.entity.id == player.entity.id continue;
			if target.player_state != Player_State.ALIVE continue;
			if target.player_type == Player_Type.TRAITOR continue;
			finder->check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		// Apply Void Hunger CD reduction
		hunger_reduction := rr_mimicer_get_void_hunger_reduction(player);
		effective_cd := MIMICER_KILL_COOLDOWN - hunger_reduction;
		if effective_cd < 5.0 effective_cd = 5.0;

		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		if params.clicked && params.can_use {
			closest := get_closest_kill_target(this, player);
			if closest != null {
				player->set_facing_right(closest.entity.world_position.x > player.entity.world_position.x);

				closest->kill_with_killer(player.entity.id);

				current_cooldown = effective_cd;

				if Game.is_server() {
					sfx := SFX.default_sfx_desc();
					sfx->set_position(closest.entity.world_position);
					sfx.volume = 0.25;
					rr_play_sfx("sfx/traitor_kill_death.wav", sfx);
				}
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Mimicer_Kill_Ability.NAME);
	}
}

// --- Transform ---
Mimicer_Transform_Ability :: class : Ability_Base {
	NAME :: "Transform";

	on_init :: proc(instance: Mimicer_Transform_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.MIMICER return false;

		mm := player.entity->get_component(Mimicer_Module);
		if mm == null return false;
		if mm.void_lunge_active return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			mm := player.entity->get_component(Mimicer_Module);
			if mm == null return;

			// Swarm-specific transform: framing a clone's identity
			if mm.swarm_active {
				if mm.swarm_clone_framed {
					// Reverting after framing — destroy the current clone
					mm.is_monster_form = false;
					mm.skeleton_swap_at = 0.0;
					rr_mimicer_swap_to_player(player);
					player->set_trigger("mimicer_revert");
					player->add_disable_movement_input_reason(MIMICER_TRANSFORM_LOCK_REASON);

					if mm.is_disguised {
						rr_mimicer_end_disguise(player);
					}
					mm.swarm_clone_framed = false;

					// Destroy the inhabited clone
					idx := mm.swarm_current_index;
					if idx >= 0 && idx < mm.swarm_clones.count {
						clone_entity := mm.swarm_clones[idx];
						if clone_entity != null && #alive(clone_entity) {
							clone_entity->destroy();
						}
					}

					lock := player.entity->get_component(Mimicer_Transform_Lock);
					if lock == null {
						lock = player.entity->add_component(Mimicer_Transform_Lock);
					}
					lock.end_time = get_time() + MIMICER_TRANSFORM_ANIM_SECONDS;
					lock.player_entity_id = player.entity.id;
					lock.active = true;
				} else {
					// Transform while inhabiting clone — shift into creature, framing the identity
					mm.is_monster_form = true;
					mm.swarm_clone_framed = true;
					player->set_trigger("mimicer_transform");
					player->add_disable_movement_input_reason(MIMICER_TRANSFORM_LOCK_REASON);
					mm.skeleton_swap_at = get_time() + MIMICER_TRANSFORM_ANIM_SECONDS;

					lock := player.entity->get_component(Mimicer_Transform_Lock);
					if lock == null {
						lock = player.entity->add_component(Mimicer_Transform_Lock);
					}
					lock.end_time = get_time() + MIMICER_TRANSFORM_ANIM_SECONDS;
					lock.player_entity_id = player.entity.id;
					lock.active = true;
				}
				return;
			}

			if mm.is_monster_form {
				// Revert to schleem — transforming back breaks disguise
				mm.is_monster_form = false;
				mm.skeleton_swap_at = 0.0;
				rr_mimicer_swap_to_player(player);
				player->set_trigger("mimicer_revert");
				player->add_disable_movement_input_reason(MIMICER_TRANSFORM_LOCK_REASON);

				// Breaking disguise on revert to schleem
				if mm.is_disguised {
					rr_mimicer_end_disguise(player);
				}

				lock := player.entity->get_component(Mimicer_Transform_Lock);
				if lock == null {
					lock = player.entity->add_component(Mimicer_Transform_Lock);
				}
				lock.end_time = get_time() + MIMICER_TRANSFORM_ANIM_SECONDS;
				lock.player_entity_id = player.entity.id;
				lock.active = true;
			} else {
				// Transform to monster (115% speed)
				mm.is_monster_form = true;
				player->set_trigger("mimicer_transform");
				player->add_disable_movement_input_reason(MIMICER_TRANSFORM_LOCK_REASON);
				mm.skeleton_swap_at = get_time() + MIMICER_TRANSFORM_ANIM_SECONDS;

				lock := player.entity->get_component(Mimicer_Transform_Lock);
				if lock == null {
					lock = player.entity->add_component(Mimicer_Transform_Lock);
				}
				lock.end_time = get_time() + MIMICER_TRANSFORM_ANIM_SECONDS;
				lock.player_entity_id = player.entity.id;
				lock.active = true;
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Mimicer_Transform_Ability.NAME);
	}
}

Mimicer_Transform_Lock :: class : Component {
	end_time: float;
	player_entity_id: u64;
	active: bool;

	ao_update :: method(dt: float) {
		if !active return;
		if get_time() >= end_time {
			active = false;
			p := get_player_by_entity_id(player_entity_id);
			if p != null {
				p->remove_disable_movement_input_reason(MIMICER_TRANSFORM_LOCK_REASON);

				// Apply monster speed bonus
				mm := p.entity->get_component(Mimicer_Module);
				if mm != null && mm.is_monster_form && !mm.is_prowling {
					p.agent.movement_speed = p.agent.movement_speed * MIMICER_MONSTER_SPEED_MULTIPLIER;
				}
			}
		}
	}
}

// --- Prowl ---
Mimicer_Prowl_Ability :: class : Ability_Base {
	NAME :: "Prowl";

	on_init :: proc(instance: Mimicer_Prowl_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/mimicer/prowl.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.MIMICER return false;

		mm := player.entity->get_component(Mimicer_Module);
		if mm == null return false;
		if mm.void_lunge_active return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			mm := player.entity->get_component(Mimicer_Module);
			if mm == null return;

			if mm.is_prowling {
				rr_mimicer_end_prowl(player);
			} else {
				rr_mimicer_start_prowl(player);
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Mimicer_Prowl_Ability.NAME);
	}
}

// --- Void Lunge ---
Mimicer_Void_Lunge_Ability :: class : Ability_Base {
	NAME :: "Void Lunge";

	on_init :: proc(instance: Mimicer_Void_Lunge_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/mimicer/void_lunge.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.MIMICER return false;

		mm := player.entity->get_component(Mimicer_Module);
		if mm == null return false;
		if mm.stolen_faces < MIMICER_VOID_LUNGE_UNLOCK_FACES return false;
		if !mm.is_monster_form return false;
		if mm.void_lunge_active return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		activation := Ability_Utilities.full_update_aimed_ability(player, ref params);
		if params.can_use && activation.activate {
			if current_cooldown > 0.0 return;

			dir := activation.direction;
			start := player.entity.world_position;
			target_pos := v2.{start.x + dir.x * MIMICER_VOID_LUNGE_DISTANCE, start.y + dir.y * MIMICER_VOID_LUNGE_DISTANCE};
			rr_mimicer_start_void_lunge(player, target_pos);
			current_cooldown = MIMICER_VOID_LUNGE_COOLDOWN;
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Mimicer_Void_Lunge_Ability.NAME);
	}
}

// --- Spew Corruption ---
Mimicer_Spew_Ability :: class : Ability_Base {
	NAME :: "Spew Corruption";

	on_init :: proc(instance: Mimicer_Spew_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/mimicer/spew_corruption.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.MIMICER return false;

		mm := player.entity->get_component(Mimicer_Module);
		if mm == null return false;
		if mm.stolen_faces < MIMICER_SPEW_UNLOCK_FACES return false;
		if !mm.is_monster_form return false;
		if mm.void_lunge_active return false;
		return true;
	}

	get_closest_spew_target :: proc(instance: Mimicer_Spew_Ability, player: Player) -> Player {
		finder := make_finder(Player, player.entity.world_position, MIMICER_SPEW_RANGE);
		foreach target: component_iterator(Player) {
			if target == null continue;
			if target.entity.id == player.entity.id continue;
			if target.player_state != Player_State.ALIVE continue;
			finder->check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			if current_cooldown > 0.0 return;

			target := get_closest_spew_target(this, player);
			if target != null {
				rr_mimicer_spew_corruption(player, target);
				current_cooldown = MIMICER_SPEW_COOLDOWN;
			} else {
				Notifier.notify(player, "No target in range!");
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Mimicer_Spew_Ability.NAME);
	}
}

// --- Teleport ---
Mimicer_Teleport_Ability :: class : Ability_Base {
	NAME :: "Teleport";

	on_init :: proc(instance: Mimicer_Teleport_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/mimicer/teleport.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.MIMICER return false;

		mm := player.entity->get_component(Mimicer_Module);
		if mm == null return false;
		if mm.teleport_cooldown > 0.0 return false;
		if rr_mimicer_get_active_pillar_count(player) == 0 return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		mm := player.entity->get_component(Mimicer_Module);
		if mm != null {
			current_cooldown = mm.teleport_cooldown;
		}

		if params.clicked && params.can_use {
			rr_mimicer_teleport_to_next_pillar(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Mimicer_Teleport_Ability.NAME);
	}
}

// --- Unleash: Doppelganger Swarm ---
Mimicer_Unleash_Ability :: class : Ability_Base {
	NAME :: "Unleash";

	on_init :: proc(instance: Mimicer_Unleash_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/mimicer/unleash_ultimate.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player->has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.MIMICER return false;

		mm := player.entity->get_component(Mimicer_Module);
		if mm == null return false;
		if mm.stolen_faces < MIMICER_UNLEASH_UNLOCK_FACES return false;
		if mm.unleash_used return false;
		if !mm.is_monster_form return false;
		if mm.void_lunge_active return false;
		if rr_mimicer_get_active_pillar_count(player) == 0 return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_mimicer_begin_unleash(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Mimicer_Unleash_Ability.NAME);
	}
}

// --- Cycle Clone (during Doppelganger Swarm) ---
Mimicer_Cycle_Clone_Ability :: class : Ability_Base {
	NAME :: "Next Clone";

	on_init :: proc(instance: Mimicer_Cycle_Clone_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/mimicer/mimic.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.MIMICER return false;

		mm := player.entity->get_component(Mimicer_Module);
		if mm == null return false;
		if !mm.swarm_active return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_mimicer_cycle_clone(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Mimicer_Cycle_Clone_Ability.NAME);
	}
}
