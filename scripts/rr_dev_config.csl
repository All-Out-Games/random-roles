// rr_dev_config.csl
// -----------------------------------------------------------------------------
// Recording / development tweakables
// -----------------------------------------------------------------------------

// When true, the round never ends on its own from automatic win-condition
// checks. Use during video recordings so a round can't end early. Manual /end
// still works. Toggle in-game with /noautowin.
rr_disable_auto_victory: bool;

// /noautowin — toggles automatic (win-condition) victory on/off.
noautowin :: proc(player: Player) {
	rr_disable_auto_victory = !rr_disable_auto_victory;
	if rr_disable_auto_victory {
		Chat.server_send_message("Automatic victory DISABLED. Round won't end on its own — use /end to end it manually.", player);
		return;
	}
	Chat.server_send_message("Automatic victory ENABLED. Win conditions will end the round normally.", player);
} @chat_command @youtuber

// -----------------------------------------------------------------------------
// Mech recording tweakables
// -----------------------------------------------------------------------------
mech_missile_los_follows_camera: bool = true; // RECORDING TEMP
MECH_CAR_AUTO_DRIVE :: false;  // RECORDING TEMP
MECH_CAR_SMOOTH_STEER :: false; // RECORDING TEMP
MECH_ALLOW_MULTIPLE_MINIONS :: true; // RECORDING TEMP

