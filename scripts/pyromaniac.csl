import "core:ao"

// --- Pyromaniac (Anarchist role) ---

PYRO_FIRE_ATTACH_OFFSET_X :: 0.0;
PYRO_FIRE_ATTACH_OFFSET_Y :: -0.6;
// Fallback render order if the prop has no Sprite_Renderer.
PYRO_FIRE_FALLBACK_LAYER :: 2;
PYRO_FIRE_FALLBACK_DEPTH_OFFSET :: 2.0;
PYRO_FIRE_ABOVE_PROP_LAYER_BUMP :: 1;
PYRO_FIRE_ABOVE_PROP_DEPTH_BUMP :: 0.05;
PYRO_FIRE_IGNITE_RADIUS :: 0.95;
PYRO_FIRE_INTERACT_RADIUS :: 1.1;

PYRO_ON_FIRE_DURATION_SECONDS :: 4.0;
PYRO_ON_FIRE_SPEED_MULTIPLIER :: 1.5;

PYRO_LIGHT_CORPSE_RANGE :: 4.5;
PYRO_LIGHT_CORPSE_COOLDOWN_SECONDS :: 120.0;
PYRO_CORPSE_BURN_ANIM_SECONDS :: 2.2;
// 008BED_fire "004RAND/corpse_extinguish" has keyframes out to ~0.9333s.
PYRO_CORPSE_EXTINGUISH_ANIM_SECONDS :: 1.0;

PYRO_WORLD_FIRE_OVERLAY_LAYER :: 9000;
PYRO_WORLD_FIRE_OVERLAY_SECONDS :: 5.0;
PYRO_WORLD_FIRE_COLOR_R :: 1.0;
PYRO_WORLD_FIRE_COLOR_G :: 0.35;
PYRO_WORLD_FIRE_COLOR_B :: 0.05;
PYRO_ROOMS_BURNOUT_TARGET :: 3;
// How long (seconds) a player must stay in a fully-burned room before catching fire.
PYRO_ROOM_EXPOSURE_DURATION :: 10.0;
// Radius (meters) used to detect if a player is inside a fiery room.
PYRO_ROOM_EXPOSURE_SEARCH_RADIUS :: 8.0;

// Local-only cinematic overlay + bigfire around the pyro.
RR_Pyro_World_Fire_Cinematic :: class : Component {
	active: bool;
	start_time: float;
	fire_entity: Entity;

	arm :: proc(using this: RR_Pyro_World_Fire_Cinematic) {
		// Cosmetic: this component renders client-side overlay; safe to exist everywhere.
		active = true;
		start_time = get_time();

		// Spawn a big fire around the pyro in world space.
		fire_entity = Scene.create_entity();
		fire_entity->set_parent(entity, false);
		fire_entity->set_local_position(v2.{0.0, PYRO_FIRE_ATTACH_OFFSET_Y});
		fire_entity->set_local_rotation(0.0);
		fire_entity->set_local_scale(v2.{1.0, 1.0});

		spine := fire_entity->add_component(Spine_Animator);
		spine->awaken();
		spine.layer = 999; // above most gameplay
		spine.depth_offset = 999.0;
		spine.instance->set_skeleton(get_asset(Spine_Asset, "anims/torch_fire/008BED_fire.spine"));
		spine.instance->set_skin("fire");
		spine.instance->set_animation("004RAND/bigfire_intro", false, 0);
	}

	ao_update :: proc(using this: RR_Pyro_World_Fire_Cinematic, dt: float) {
		if !active return;
		// Stop when leaving pyro win state.
		if game_state != Game_State.ANIM_PYRO_WIN {
			active = false;
			if fire_entity != null && #alive(fire_entity) {
				fire_entity->destroy();
			}
			fire_entity = null;
			return;
		}

		// Keep bigfire looping after intro.
		if fire_entity != null && #alive(fire_entity) {
			elapsed := get_time() - start_time;
			spine := fire_entity->get_component(Spine_Animator);
			if spine != null && spine.instance != null {
				if elapsed > 0.7 {
					spine.instance->set_animation("004RAND/bigfire_idleloop", true, 0);
				}
			}
		}
	}

	ao_late_update :: proc(using this: RR_Pyro_World_Fire_Cinematic, dt: float) {
		if !active return;
		// Local-only overlay
		p := entity->get_component(Player);
		if p == null return;
		if !p->is_local() return;
		if game_state != Game_State.ANIM_PYRO_WIN return;

		elapsed := get_time() - start_time;
		t := clamp(elapsed / PYRO_WORLD_FIRE_OVERLAY_SECONDS, 0.0, 1.0);
		alpha := Ease.out_cubic(t);

		screen := UI.get_screen_rect();
		bg := get_asset(Texture_Asset, "$AO/white.png");

		UI.push_layer(PYRO_WORLD_FIRE_OVERLAY_LAYER);
		defer UI.pop_layer();
		col := v4.{PYRO_WORLD_FIRE_COLOR_R, PYRO_WORLD_FIRE_COLOR_G, PYRO_WORLD_FIRE_COLOR_B, 1.0};
		col.w = alpha;
		UI.quad(screen, bg, col);
	}
}

// Returns true if any active fire belonging to a fiery-locked room is within
// PYRO_ROOM_EXPOSURE_SEARCH_RADIUS of the player.
rr_pyro_player_in_fiery_room :: proc(player: Player) -> bool {
	if player == null return false;
	if !#alive(player.entity) return false;

	pos := player.entity.world_position;
	r_sq := PYRO_ROOM_EXPOSURE_SEARCH_RADIUS * PYRO_ROOM_EXPOSURE_SEARCH_RADIUS;

	foreach fire: component_iterator(RR_Prop_Fire_Target) {
		if fire == null continue;
		if !fire.active continue;
		if fire.room_state == null continue;
		if !fire.room_state.fiery_locked continue;
		if fire.fire_entity == null || !#alive(fire.fire_entity) continue;

		d := fire.fire_entity.world_position - pos;
		if length_squared(d) <= r_sq {
			return true;
		}
	}
	return false;
}

// Server-authoritative: tick down the room-exposure countdown for a player.
// When the countdown hits 0 the player catches fire using the existing on-fire system.
// The timer pauses while the player has a task in progress and resets when leaving
// the fiery room, dying, or already being on fire.
rr_pyro_update_room_exposure :: proc(player: Player, dt: float) {
	if !Game.is_server() return;
	if player == null return;
	if !#alive(player.entity) return;

	// Clear timer if not mid-game or player is not alive.
	if game_state != Game_State.INGAME || player.player_state != Player_State.ALIVE {
		player.pyro_room_exposure_timer = 0.0;
		return;
	}

	// Pyromaniacs are immune to their own fiery rooms.
	if player.player_role == Player_Role.PYROMANIAC {
		player.pyro_room_exposure_timer = 0.0;
		return;
	}

	// Already on fire: clear the exposure timer so it restarts fresh afterward.
	if player.pyro_on_fire {
		player.pyro_room_exposure_timer = 0.0;
		return;
	}

	if !rr_pyro_player_in_fiery_room(player) {
		// Reset timer when leaving the room.
		player.pyro_room_exposure_timer = 0.0;
		return;
	}

	// Pause while a task minigame is in progress.
	if player->has_task_in_progress() return;

	// Start the countdown the first time a player enters a fiery room.
	if player.pyro_room_exposure_timer <= 0.0 {
		player.pyro_room_exposure_timer = PYRO_ROOM_EXPOSURE_DURATION;
	}

	player.pyro_room_exposure_timer -= dt;

	if player.pyro_room_exposure_timer <= 0.0 {
		player.pyro_room_exposure_timer = 0.0;
		// Catch fire using the existing status system.
		on_fire := player.entity->get_component(RR_Player_On_Fire_Status);
		if on_fire == null {
			on_fire = player.entity->add_component(RR_Player_On_Fire_Status);
		}
		on_fire->arm(PYRO_ON_FIRE_DURATION_SECONDS);
	}
}

// Local-only: draw a world-space countdown timer above the player's head while
// they are being exposed to a fiery room.
rr_pyro_draw_room_exposure_timer :: proc(player: Player) {
	if player == null return;
	if game_state != Game_State.INGAME return;
	if player.player_state != Player_State.ALIVE return;
	if player.player_role == Player_Role.PYROMANIAC return;
	if player.pyro_room_exposure_timer <= 0.0 return;

	UI.push_world_draw_context();
	defer UI.pop_draw_context();

	pos := player.entity.world_position;
	UI.push_z(pos.y);
	defer UI.pop_z();

	// Ceiling of remaining seconds for display.
	secs_f := player.pyro_room_exposure_timer;
	secs_i := secs_f.(int);
	rem := secs_f - secs_i.(float);
	if rem > 0.001 { secs_i += 1; }
	if secs_i < 1 { secs_i = 1; }

	// Interpolate color: yellow (full time) → red (about to burn).
	t := player.pyro_room_exposure_timer / PYRO_ROOM_EXPOSURE_DURATION;
	g := t;
	if g < 0.0 { g = 0.0; }
	col := v4.{1.0, g, 0.0, 1.0};

	// Draw above the player's nameplate (~2.1 m above entity origin).
	label_pos := pos + v2.{0.0, 2.1};
	label_rect := Rect{label_pos, label_pos}->grow(0.10, 0.50, 0.10, 0.50);

	ts := UI.default_text_settings();
	ts.size = 0.30;
	ts.color = col;
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 0.04;
	ts.outline_color = v4.{0.0, 0.0, 0.0, 1.0};

	UI.text(label_rect, ts, format_string("FIRE IN %", .{secs_i}));
}

rr_pyro_extinguish_all_fires :: proc() {
	// Server authoritative cleanup between rounds / in lobby.
	if !Game.is_server() return;
	foreach fire: component_iterator(RR_Prop_Fire_Target) {
		fire->extinguish(null, true);
	}
	foreach room_state: component_iterator(RR_Pyro_Room_Fire_State) {
		if room_state == null continue;
		room_state.fiery_locked = false;
		room_state.burning_props = 0;
		room_state.burnout_awarded = false;
		room_state.burned_by_player_entity_id = 0;
	}
}

rr_pyro_find_task :: proc(player: Player, task_id: string) -> Task_Base {
	if player == null return null;
	if task_id.count == 0 return null;
	for i: 0..player.active_tasks.elements.count-1 {
		t := player.active_tasks.elements[i];
		if t == null continue;
		if t.id == task_id {
			return t;
		}
	}
	return null;
}

rr_pyro_check_objectives :: proc(player: Player) {
	if player == null return;
	if player.player_role != Player_Role.PYROMANIAC return;

	// Mark objective completion (these tasks are just UI objectives).
	t_corpse := rr_pyro_find_task(player, "pyro_burn_1_corpse");
	if t_corpse != null {
		t_corpse.completed = player.pyro_corpses_burned >= 1;
	}
	t_props := rr_pyro_find_task(player, "pyro_ignite_5_props");
	if t_props != null {
		t_props.completed = player.pyro_props_ignited >= 5;
	}
	t_rooms := rr_pyro_find_task(player, "pyro_burn_out_rooms");
	if t_rooms != null {
		t_rooms.completed = player.pyro_rooms_burned_out >= PYRO_ROOMS_BURNOUT_TARGET;
	}

	// Unlock World Fire once all objectives are complete.
	unlocked := (player.pyro_corpses_burned >= 1)
		&& (player.pyro_props_ignited >= 5)
		&& (player.pyro_rooms_burned_out >= PYRO_ROOMS_BURNOUT_TARGET);
	if unlocked && player.pyro_world_fire_unlocked_time <= 0.0 {
		player.pyro_world_fire_unlocked_time = get_time();
		player->Notify("World Fire unlocked!");
	}
}

rr_pyro_register_prop_ignited :: proc(player: Player) {
	// Server authoritative; counters are replicated.
	if !Game.is_server() return;
	if player == null return;
	if player.player_role != Player_Role.PYROMANIAC return;
	player.pyro_props_ignited += 1;
	rr_pyro_check_objectives(player);
}

rr_pyro_register_corpse_burned :: proc(player: Player) {
	// Server authoritative; counters are replicated.
	if !Game.is_server() return;
	if player == null return;
	if player.player_role != Player_Role.PYROMANIAC return;
	player.pyro_corpses_burned += 1;
	rr_pyro_check_objectives(player);
}

rr_pyro_register_room_burned_out :: proc(player: Player) {
	// Server authoritative; counters are replicated.
	if !Game.is_server() return;
	if player == null return;
	if player.player_role != Player_Role.PYROMANIAC return;
	player.pyro_rooms_burned_out += 1;
	rr_pyro_check_objectives(player);
}

rr_pyro_find_props_room_root :: proc(start: Entity) -> Entity {
	if start == null return null;
	if !#alive(start) return null;

	cur := start;
	while cur != null {
		if cur->get_name() == "Props" {
			return cur;
		}
		cur = cur.parent;
	}
	return null;
}

rr_pyro_count_ignitable_props_in_room :: proc(room_root: Entity) -> int {
	if room_root == null return 0;
	if !#alive(room_root) return 0;

	// Only count DIRECT children of the Props entity that have a Sprite_Renderer.
	// Props are placed as direct children; fire entities are grandchildren (children of props),
	// so this naturally excludes any Spine-created sub-entities that appear after ignition.
	count := 0;
	child := room_root.first_child;
	while child != null {
		if child != null && #alive(child) {
			sprite := child->get_component(Sprite_Renderer);
			if sprite != null {
				count += 1;
			}
		}
		child = child.next_sibling;
	}
	return count;
}


rr_pyro_get_or_create_room_state :: proc(room_root: Entity) -> RR_Pyro_Room_Fire_State {
	if room_root == null return null;
	if !#alive(room_root) return null;

	state := room_root->get_component(RR_Pyro_Room_Fire_State);
	if !Game.is_server() {
		return state;
	}
	if state == null {
		state = room_root->add_component(RR_Pyro_Room_Fire_State);
		// Count total props ONCE on creation, before any fires are lit.
		// Recalculating later risks counting Spine-internal child entities
		// that get added when fires are awakened.
		state.total_props = rr_pyro_count_ignitable_props_in_room(room_root);
	}
	return state;
}

rr_pyro_find_burnable_corpse :: proc(pyro: Player) -> Corpse {
	if pyro == null return null;
	finder := make_finder(Corpse, pyro.entity.world_position, PYRO_LIGHT_CORPSE_RANGE);
	foreach corpse: component_iterator(Corpse) {
		if corpse == null continue;
		// Pyro can burn both reported and unreported corpses.
		if corpse.pyro_has_been_burned continue;
		// Must still have a live entity.
		if !#alive(corpse.entity) continue;
		finder->check(corpse, corpse.entity.world_position);
	}
	return finder.closest;
}

rr_pyro_start_burning_corpse_visual :: proc(corpse_entity: Entity) -> Entity {
	if corpse_entity == null || !#alive(corpse_entity) return null;

	fire_entity := Scene.create_entity();
	fire_entity->set_local_position(corpse_entity.world_position + v2.{PYRO_FIRE_ATTACH_OFFSET_X, PYRO_FIRE_ATTACH_OFFSET_Y});
	fire_entity->set_local_rotation(0.0);
	fire_entity->set_local_scale(v2.{1.0, 1.0});

	spine := fire_entity->add_component(Spine_Animator);
	spine->awaken();

	// Render above the corpse (match corpse sort order if possible).
	corpse_spine: Spine_Animator = null;
	corpse_spine = corpse_entity->get_component(Spine_Animator);
	if corpse_spine != null {
		spine.layer = corpse_spine.layer + PYRO_FIRE_ABOVE_PROP_LAYER_BUMP;
		spine.depth_offset = corpse_spine.depth_offset + PYRO_FIRE_ABOVE_PROP_DEPTH_BUMP;
	} else {
		spine.layer = PYRO_FIRE_FALLBACK_LAYER;
		spine.depth_offset = PYRO_FIRE_FALLBACK_DEPTH_OFFSET;
	}

	spine.instance->set_skeleton(get_asset(Spine_Asset, "anims/torch_fire/008BED_fire.spine"));
	spine.instance->set_skin("fire");
	spine.instance->set_animation("004RAND/bigfire_idleloop", true, 0);

	seq := fire_entity->add_component(RR_Pyro_Burning_Corpse);
	seq.corpse_entity = corpse_entity;
	seq.start_time = get_time();
	seq.did_extinguish = false;

	return fire_entity;
}

// Visual driver for burning corpses (runs on spawned 008BED_fire entity).
RR_Pyro_Burning_Corpse :: class : Component {
	corpse_entity: Entity;
	start_time: float;
	did_extinguish: bool;

	ao_start :: proc(using this: RR_Pyro_Burning_Corpse) {
		// Fallback if someone adds the component without initializing it.
		if start_time <= 0.0 {
			start_time = get_time();
		}
	}

	ao_update :: proc(using this: RR_Pyro_Burning_Corpse, dt: float) {
		// Follow the corpse while it exists.
		if !did_extinguish && corpse_entity != null && #alive(corpse_entity) {
			entity->set_local_position(corpse_entity.world_position + v2.{PYRO_FIRE_ATTACH_OFFSET_X, PYRO_FIRE_ATTACH_OFFSET_Y});
		}

		if did_extinguish return;
		if (get_time() - start_time) < PYRO_CORPSE_BURN_ANIM_SECONDS return;

		// Switch the fire to corpse extinguish.
		spine := entity->get_component(Spine_Animator);
		if spine != null {
			spine->awaken();
			if spine.instance != null {
				spine.instance->set_animation("004RAND/corpse_extinguish", false, 0);
			}
		}

		did_extinguish = true;

		// Server-authoritative destruction (replicates to clients).
		if Game.is_server() {
			if corpse_entity != null && #alive(corpse_entity) {
				corpse_entity->destroy();
			}
			entity->queue_for_destruction(PYRO_CORPSE_EXTINGUISH_ANIM_SECONDS);
		}
	}
}

// Per-prop fire controller. This is attached at runtime to the chosen prop.
RR_Prop_Fire_Target :: class : Component {
	active: bool;
	fire_entity: Entity;
	ignited_at: float;
	room_root: Entity;
	room_state: RR_Pyro_Room_Fire_State;

	ignite :: proc(using this: RR_Prop_Fire_Target, by: Player = null) {
		// Server authoritative: affects gameplay (burning + interaction)
		if !Game.is_server() return;
		if active return;
		if entity == null || !#alive(entity) return;

		room_root = rr_pyro_find_props_room_root(entity);
		room_state = rr_pyro_get_or_create_room_state(room_root);
		if room_state != null && room_state.fiery_locked {
			if by != null {
				by->Notify("This room is fully ablaze.");
			}
			return;
		}

		active = true;
		ignited_at = get_time();

		// Create a child entity to hold the fire visuals + interactable.
		fire_entity = Scene.create_entity();
		fire_entity->set_parent(entity, false);
		fire_entity->set_local_position(v2.{PYRO_FIRE_ATTACH_OFFSET_X, PYRO_FIRE_ATTACH_OFFSET_Y});
		fire_entity->set_local_rotation(0.0);
		fire_entity->set_local_scale(v2.{1.0, 1.0});

		// Visual (Spine)
		spine := fire_entity->add_component(Spine_Animator);
		// NOTE: Spine skeleton/animation is initialized client-side in
		// RR_Extinguish_Fire_Interactable.ao_start so visuals appear on all clients.

		// Interactable (extinguish)
		ext := fire_entity->add_component(RR_Extinguish_Fire_Interactable);
		ext.target = this;

		if room_state != null {
			room_state.burning_props += 1;
			if room_state.total_props > 0 && room_state.burning_props >= room_state.total_props {
				room_state.fiery_locked = true;
				if !room_state.burnout_awarded {
					room_state.burnout_awarded = true;
					if by != null {
						room_state.burned_by_player_entity_id = by.entity.id;
						rr_pyro_register_room_burned_out(by);
						by->Notify("Room burned out!");
					}
				}
			}
		}
	}

	extinguish :: proc(using this: RR_Prop_Fire_Target, by: Player = null, force: bool = false) {
		// Server authoritative.
		if !Game.is_server() return;
		if !active return;
		if !force {
			if room_state == null {
				room_root = rr_pyro_find_props_room_root(entity);
				room_state = rr_pyro_get_or_create_room_state(room_root);
			}
			if room_state != null && room_state.fiery_locked {
				if by != null {
					by->Notify("This room is too fiery to extinguish.");
				}
				return;
			}
		}

		active = false;

		// Play outro and destroy visual entity.
		if fire_entity != null && #alive(fire_entity) {
			spine := fire_entity->get_component(Spine_Animator);
			if spine != null {
				spine->awaken();
				if spine.instance != null {
					spine.instance->set_animation("004RAND/smallfire_outro", false, 0);
				}
			}
			fire_entity->queue_for_destruction(0.8);
		}
		fire_entity = null;
		if room_state != null && room_state.burning_props > 0 {
			room_state.burning_props -= 1;
		}

		if by != null {
			by->Notify("Fire extinguished!");
		}
	}
}

RR_Pyro_Room_Fire_State :: class : Component {
	total_props: int;
	burning_props: int;
	fiery_locked: bool;
	burnout_awarded: bool;
	burned_by_player_entity_id: u64;
}

// Interactable on the fire entity to extinguish it.
RR_Extinguish_Fire_Interactable :: class : Interactable {
	target: RR_Prop_Fire_Target;
	start_time: float;
	switched_to_idle: bool;

	ao_start :: method() {
		this->set_listener(this);
		this->set_text("Extinguish");
		this->set_hold_text("Extinguishing...");
		radius = PYRO_FIRE_INTERACT_RADIUS;
		required_hold_time = 0.75;
		priority = 50;

		start_time = get_time();
		switched_to_idle = false;

		spine := entity->get_component(Spine_Animator);
		if spine != null {
			spine->awaken();

			// Render above the parent prop (match prop sort order if possible).
			parent := entity.parent;
			prop_sprite: Sprite_Renderer = null;
			if parent != null {
				prop_sprite = parent->get_component(Sprite_Renderer);
			}
			if prop_sprite != null {
				spine.layer = prop_sprite.layer + PYRO_FIRE_ABOVE_PROP_LAYER_BUMP;
				spine.depth_offset = prop_sprite.depth_offset + PYRO_FIRE_ABOVE_PROP_DEPTH_BUMP;
			} else {
				spine.layer = PYRO_FIRE_FALLBACK_LAYER;
				spine.depth_offset = PYRO_FIRE_FALLBACK_DEPTH_OFFSET;
			}

			spine.instance->set_skeleton(get_asset(Spine_Asset, "anims/torch_fire/008BED_fire.spine"));
			spine.instance->set_skin("fire");
			spine.instance->set_animation("004RAND/004RAND/bigfire_idleloop", true, 0);
		}
	}

	ao_update :: method(dt: float) {
		// Cosmetic: switch to idle loop after intro.
		if switched_to_idle return;
		if (get_time() - start_time) < 0.7 return;
		spine := entity->get_component(Spine_Animator);
		if spine != null && spine.instance != null {
			spine.instance->set_animation("004RAND/smallfire_idleloop", true, 0);
			switched_to_idle = true;
		}
	}

	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role == Player_Role.PYROMANIAC return false;
		if target == null return false;
		if !target.active return false;
		if target.room_state == null {
			target.room_root = rr_pyro_find_props_room_root(target.entity);
			target.room_state = rr_pyro_get_or_create_room_state(target.room_root);
		}
		if target.room_state != null && target.room_state.fiery_locked return false;
		return true;
	}

	on_interact :: method(player: Player) {
		if target == null return;
		target->extinguish(player);
	}
}

// Player-side status applied when they walk through fire.
// - 150% move speed
// - cannot use abilities or interactables (enforced by Player hooks)
RR_Player_On_Fire_Status :: class : Component {
	active: bool;
	end_time: float;
	orig_speed: float;
	orig_speed_valid: bool;

	arm :: proc(using this: RR_Player_On_Fire_Status, seconds: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		active = true;

		p := entity->get_component(Player);
		if p != null {
			p.pyro_on_fire = true;

			// Capture baseline move speed once per "session".
			if !orig_speed_valid {
				orig_speed = p.agent.movement_speed;
				orig_speed_valid = true;
			}

			// Switch to on-fire idle loop (merged rig).
			p->set_trigger("pyro_on_fire_idle");
		}
	}

	clear :: proc(using this: RR_Player_On_Fire_Status, play_blow_out: bool) {
		active = false;
		end_time = 0.0;

		p := entity->get_component(Player);
		if p != null {
			p.pyro_on_fire = false;
			if orig_speed_valid {
				p.agent.movement_speed = orig_speed;
			}
			if play_blow_out {
				p->set_trigger("pyro_blow_out_fire");
			} else {
				p->set_trigger("RESET");
			}
		}

		orig_speed_valid = false;
	}

	ao_update :: proc(using this: RR_Player_On_Fire_Status, dt: float) {
		if !active return;

		p := entity->get_component(Player);
		if p == null {
			active = false;
			return;
		}

		// Safety: stop if gameplay ended or player died.
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			this->clear(false);
			return;
		}

		// Apply speed boost while active.
		if orig_speed_valid {
			p.agent.movement_speed = orig_speed * PYRO_ON_FIRE_SPEED_MULTIPLIER;
		}

		if get_time() >= end_time {
			this->clear(true);
		}
	}
}

