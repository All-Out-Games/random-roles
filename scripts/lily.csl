	DEAD_PLAYER;           // deliver a corpse to the tree
	EYES;                  // steal a player's eyes, bring to tree
	LEGS;                  // steal a player's legs, bring to tree
	ALIVE_PLAYER;          // deliver a living (strung) player to the tree
	LEGS_AND_EYES;         // deliver both stolen legs AND stolen eyes
}

