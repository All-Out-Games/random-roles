// =============================================================================
// Creature Entity Management
// =============================================================================

rr_lily_ensure_creature_entity :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.creature_entity != null && #alive(lm.creature_entity) return;

	ce := Scene.create_entity();
	ce.set_parent(player.entity, false);
	ce.set_local_position(v2.{0, 0});
	ce.set_local_scale(v2.{1, 1});
	ce.set_local_rotation(0.0);

	ca := ce.add_component(Spine_Animator);
	ca.awaken();
	lily_rig := get_asset(Spine_Asset, rr_lily_get_creature_rig_path());
	if ca.instance != null && lily_rig != null {
		ca.instance.set_skeleton(lily_rig);
		ca.instance.set_animation("idle", true, 0);
		rr_lily_setup_creature_state_machine(ca);
		rr_apply_shadow_mask(ca.instance);
	}

	ce.set_local_enabled(false);
	lm.creature_entity = ce;
	lm.creature_animator = ca;
}

rr_lily_destroy_creature_entity :: proc(player: Player) {
	player.remove_invisibility_reason(LILY_INVIS_REASON);
	player.remove_name_invisibility_reason(LILY_NAME_INVIS_REASON);

	lm := player.entity.get_component(Lily_Module);
	if lm != null {
		if lm.creature_entity != null && #alive(lm.creature_entity) {
			lm.creature_entity.destroy();
		}
		lm.creature_entity = null;
		lm.creature_animator = null;
		lm.creature_visible = false;
	}
}

rr_lily_swap_to_creature :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	rr_lily_ensure_creature_entity(player);
	if lm.creature_entity == null return;

	player.add_invisibility_reason(LILY_INVIS_REASON);
	player.add_name_invisibility_reason(LILY_NAME_INVIS_REASON);
	lm.creature_entity.set_local_enabled(true);
	lm.creature_visible = true;

	if lm.creature_animator != null && lm.creature_animator.instance != null {
		if lm.creature_animator.instance.state_machine != null {
			lm.creature_animator.instance.state_machine.set_trigger("spawn_in");
		}
	}
}

rr_lily_swap_to_player :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.creature_visible return;
	if lm.creature_entity != null && #alive(lm.creature_entity) {
		lm.creature_entity.set_local_enabled(false);
	}
	lm.creature_visible = false;
	player.remove_invisibility_reason(LILY_INVIS_REASON);
	player.remove_name_invisibility_reason(LILY_NAME_INVIS_REASON);
}

rr_lily_creature_trigger :: proc(player: Player, trigger_name: string) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.creature_animator == null return;
	if lm.creature_animator.instance == null return;
	if lm.creature_animator.instance.state_machine != null {
		lm.creature_animator.instance.state_machine.set_trigger(trigger_name);
	}
}

// =============================================================================
// Creature Animation State Machine
// =============================================================================

rr_lily_setup_creature_state_machine :: proc(ca: Spine_Animator) {
	sm := State_Machine.create();
	layer := sm.create_layer("main", 0);

	is_moving := sm.create_variable("is_moving", .BOOL);
	spawn_in_trigger := sm.create_variable("spawn_in", .TRIGGER);

	// Normal locomotion
	idle_state := layer.create_state("idle", true, 0.0);
	move_state := layer.create_state("run", true, 0.0);
	layer.set_initial_state(idle_state);

	idle_to_move := layer.create_transition(idle_state, move_state, false);
	idle_to_move.create_bool_condition(is_moving, true);
	move_to_idle := layer.create_transition(move_state, idle_state, false);
	move_to_idle.create_bool_condition(is_moving, false);

	// Spawn in (from transform)
	spawn_in_state := layer.create_state("transform", false, 1.0);
	layer.create_global_transition(spawn_in_state, false).create_trigger_condition(spawn_in_trigger);
	layer.create_transition(spawn_in_state, idle_state, true);

	// Action trigger
	action_trigger := sm.create_variable("action", .TRIGGER);
	action_state := layer.create_state("action", false, 1.0);
	layer.create_global_transition(action_state, false).create_trigger_condition(action_trigger);
	layer.create_transition(action_state, idle_state, true);

	// Leap (for tea party / dollhouse activation) — [ART] leap_start/leap_end animations
	leap_start_trigger := sm.create_variable("leap_start", .TRIGGER);
	leap_start_state := layer.create_state("leap_start", false, 0.5);
	layer.create_global_transition(leap_start_state, false).create_trigger_condition(leap_start_trigger);
	layer.create_transition(leap_start_state, idle_state, true);

	// Control (dollhouse puppet control loop)
	control_start_trigger := sm.create_variable("control_start", .TRIGGER);
	control_end_trigger := sm.create_variable("control_end", .TRIGGER);
	control_start_state := layer.create_state("control_start", false, 0.5);
	control_loop_state := layer.create_state("control_loop", true, 0.0);
	control_end_state := layer.create_state("control_end", false, 0.5);

	layer.create_global_transition(control_start_state, false).create_trigger_condition(control_start_trigger);
	layer.create_transition(control_start_state, control_loop_state, true);
	layer.create_global_transition(control_end_state, false).create_trigger_condition(control_end_trigger);
	layer.create_transition(control_end_state, idle_state, true);

	// Detransform
	detransform_trigger := sm.create_variable("detransform", .TRIGGER);
	detransform_state := layer.create_state("detransform", false, 1.0);
	layer.create_global_transition(detransform_state, false).create_trigger_condition(detransform_trigger);
	layer.create_transition(detransform_state, idle_state, true);

	ca.instance.set_state_machine(sm, true);
}

// =============================================================================
// Update creature locomotion animations
// =============================================================================

rr_lily_update_creature_anims :: proc(player: Player, dt: float) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.creature_visible return;
	if lm.creature_animator == null return;
	if lm.creature_animator.instance == null return;
	if lm.creature_animator.instance.state_machine == null return;

	moving := length_squared(player.agent.velocity) > 0.01;
	lm.creature_animator.instance.state_machine.set_bool("is_moving", moving);
}

// =============================================================================
// Force Revert (on death / meeting)
// =============================================================================

rr_lily_force_revert :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	if lm.lily_speed_active {
		lm.lily_speed_active = false;
		player.agent.movement_speed = player.agent.movement_speed / LILY_LILY_SPEED_MULTIPLIER;
	}

	// Remove thread count speed bonus
	if lm.thread_speed_active {
		player.agent.movement_speed = player.agent.movement_speed / lm.thread_speed_multiplier;
		lm.thread_speed_active = false;
		lm.thread_speed_multiplier = 1.0;
	}

	// Remove tree speed buff
	rr_lily_remove_tree_buffs(player);

	lm.is_lily_form = false;
	lm.skeleton_swap_at = 0.0;
	rr_lily_swap_to_player(player);
	player.remove_disable_movement_input_reason(LILY_TRANSFORM_LOCK_REASON);

	// End active abilities
	rr_lily_end_tea_party(player);
	rr_lily_end_mind_control(player);
	rr_lily_end_pull(player);

	// Cut all braids on strung players
	rr_lily_trigger_all_braids(player, "cut");
}

// Single entry point for round start — cleanup + init.
rr_lily_round_start :: proc(p: Player) {
	rr_lily_cleanup(p);
	if p.player_role != Player_Role.LILY_LOVEBRAIDS return;
	llm := p.entity.get_component(Lily_Module);
	if llm == null {
		llm = p.entity.add_component(Lily_Module);
	}
	llm.kills = 0;
	llm.is_lily_form = false;
	llm.creature_visible = false;
	llm.skeleton_swap_at = 0.0;
	llm.lily_speed_active = false;
	llm.strung_player_ids.clear();
	llm.thread_speed_active = false;
	llm.thread_speed_multiplier = 1.0;
	llm.hair_tree_entity = null;
	llm.hair_tree_planted = false;
	llm.tree_teleport_cooldown = 0.0;
	llm.carrying_eyes = false;
	llm.carrying_legs = false;
	llm.stolen_eyes_from_id = 0;
	llm.stolen_legs_from_id = 0;
	llm.tree_speed_buff_active = false;
	llm.tree_speed_multiplier = 1.0;
	llm.tree_cd_multiplier = 1.0;
	llm.pull_active = false;
	llm.pull_target_index = 0;
	llm.pull_progress = 0.0;
	llm.pull_tree_entity = null;
	llm.pull_snapping = false;
	llm.tea_party_active = false;
	llm.tea_party_drink_done = false;
	llm.tea_party_victim_chose = false;
	llm.tea_party_chosen_cup = 0;
	llm.tea_party_settle_at = 0.0;
	llm.tea_party_drinking = false;
	llm.tea_party_drink_done_at = 0.0;
	llm.tea_party_target_id = 0;
	llm.tea_party_poison_cup = 0;
	llm.tea_table_entity = null;
	llm.tea_table_animator = null;
	llm.tea_tray_entity = null;
	llm.tea_cup_entities.clear();
	llm.mind_control_active = false;
	llm.mind_control_target_id = 0;
	llm.mind_control_picking = false;
	llm.dragging_live_player_id = 0;
	llm.eye_machine_active = false;
	llm.eye_machine_tube_entity = null;
	llm.eye_machine_aoe_entity = null;

	llm.eye_machine_has_target = false;
	llm.eye_machine_lowering = false;
	llm.eye_machine_lower_done_at = 0.0;
	llm.eye_pickup_entity = null;
	llm.eye_pickup_animator = null;
	llm.eye_pickup_active = false;
	llm.eye_pickup_victim_id = 0;
	llm.spider_active = false;
	llm.spider_entity = null;
	llm.spider_animator = null;
	llm.spider_has_legs = false;
	llm.spider_victim_id = 0;
	llm.spider_return_deadline = 0.0;
	llm.spider_attack_cooldown = 0.0;
	llm.deathbraid_active = false;
	llm.deathbraid_tree_entity = null;
	llm.deathbraid_mouth_entity = null;
	llm.deathbraid_ground_entity = null;
	llm.web_sense_arrow_targets.clear();
	p.active_tasks = List(Task_Base).{};
}

// Cleanup all lily entities/state on round end.
rr_lily_cleanup :: proc(player: Player) {
	rr_lily_force_revert(player);

	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	rr_lily_destroy_creature_entity(player);

	// Destroy hair tree
	if lm.hair_tree_entity != null && #alive(lm.hair_tree_entity) {
		lm.hair_tree_entity.destroy();
	}
	lm.hair_tree_entity = null;
	lm.hair_tree_planted = false;

	// Remove all strings
	rr_lily_remove_all_strings(player);

	// Force-destroy any remaining braids on all players
	for braid: component_iterator(Lily_String_Braid) {
		if braid == null continue;
		if braid.lily_player_entity_id == player.entity.id {
			braid.entity.destroy();
		}
	}

	// Clean up string traps
	rr_lily_cleanup_string_traps(player);

	// End eye machine if active
	if lm.eye_machine_active {
		rr_lily_end_eye_machine(player);
	}
	// Destroy eye pickup
	rr_lily_destroy_eye_pickup(player);

	// End spider if active
	if lm.spider_active {
		rr_lily_end_spider(player, false);
	}

	// End deathbraid if active
	rr_lily_end_deathbraid(player);

	// Free any lingering string trap roots on all players (in case cleanup missed them)
	for root: component_iterator(Lily_String_Trap_Root) {
		if root == null continue;
		if root.active && root.lily_entity_id == player.entity.id {
			root.free();
		}
	}

	// Force-destroy any lingering delayed-destroy entities (tea cups, braids, AOEs, etc.)
	// These use timed destroy for despawn animations, but round end can interrupt them.
	for dd: component_iterator(Lily_Delayed_Destroy) {
		if dd == null continue;
		if #alive(dd.entity) {
			dd.entity.destroy();
		}
	}
}

// =============================================================================
// String System
// =============================================================================

// Check if a target player is strung by ANY Lily (used by doctor/UI).
rr_lily_is_player_strung_by_any :: proc(target: Player) -> bool {
	if target == null return false;
	for lily: component_iterator(Player) {
		if lily == null continue;
		if lily.player_role != Player_Role.LILY_LOVEBRAIDS continue;
		if rr_lily_is_player_strung(lily, target.entity.id) return true;
	}
	return false;
}

rr_lily_is_player_strung :: proc(player: Player, target_id: u64) -> bool {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return false;
	for i: 0..lm.strung_player_ids.count-1 {
		if lm.strung_player_ids[i] == target_id return true;
	}
	return false;
}

rr_lily_add_string :: proc(player: Player, target_id: u64) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	// Don't double-string
	if rr_lily_is_player_strung(player, target_id) return;
	lm.strung_player_ids.append(target_id);
}

rr_lily_remove_string :: proc(player: Player, target_id: u64) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	lm.strung_player_ids.unordered_remove_by_value(target_id);

	// Remove braid VFX from target
	target := get_player_by_entity_id(target_id);
	if target != null {
		rr_lily_remove_braid_from_target(target);
	} else {
		// Player entity gone — find and destroy braid by iterating
		for braid: component_iterator(Lily_String_Braid) {
			if braid == null continue;
			if braid.lily_player_entity_id == player.entity.id {
				braid.entity.destroy();
			}
		}
	}
}

rr_lily_remove_all_strings :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	// Clean up root effects on strung players
	for i: 0..lm.strung_player_ids.count-1 {
		target := get_player_by_entity_id(lm.strung_player_ids[i]);
		if target != null {
			target.remove_freeze_reason(LILY_TEA_PARTY_SIT_REASON);
			target.remove_disable_movement_input_reason(LILY_MIND_CONTROL_PUPPET_REASON);
			target.remove_freeze_reason(LILY_PULL_REASON);
			target.remove_disable_movement_input_reason(LILY_CAFFEINE_REASON);
		}
	}
	lm.strung_player_ids.clear();
}

// Remove string when target dies.
rr_lily_on_player_death :: proc(dead_player_entity_id: u64, killer_entity_id: u64) {
	// Check all players for Lily — a dead player's string dissolves
	for player: component_iterator(Player) {
		if player == null continue;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS continue;

		lm := player.entity.get_component(Lily_Module);
		if lm == null continue;

		was_strung := rr_lily_is_player_strung(player, dead_player_entity_id);
		if was_strung {
			rr_lily_remove_string(player, dead_player_entity_id);

		}
	}
}

// Called when doctor heals a player — cuts string if strung.
rr_lily_on_doctor_heal :: proc(healed_player: Player) {
	if healed_player == null return;
	for player: component_iterator(Player) {
		if player == null continue;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS continue;

		lm := player.entity.get_component(Lily_Module);
		if lm == null continue;

		// Break mind control if the healed player is being controlled
		if lm.mind_control_active && lm.mind_control_target_id == healed_player.entity.id {
			rr_lily_end_mind_control(player);
			if player.is_local_or_server() {
				Notifier.notify(player, "Mind Control broken — target was healed!");
			}
		}

		if rr_lily_is_player_strung(player, healed_player.entity.id) {
			rr_lily_remove_string(player, healed_player.entity.id);

			// Also free from tree pull root
			healed_player.remove_freeze_reason(LILY_PULL_REASON);
		}

		// Free from string trap if trapped
		root := healed_player.entity.get_component(Lily_String_Trap_Root);
		if root != null && root.active && root.lily_entity_id == player.entity.id {
			// End carry if Lily was carrying this player
			if lm.dragging_live_player_id != 0 && lm.dragging_live_player_id == healed_player.entity.id {
				rr_lily_stop_live_drag(player);
			}
			root.free();
			if player.is_local_or_server() {
				Notifier.notify(player, "String Trap broken — target was healed!");
			}
		}

		// Restore stolen eyes if this player is the victim
		if healed_player.lily_no_eyes {
			healed_player.lily_no_eyes = false;
			// If eyes are on the ground as pickup, destroy the pickup
			if lm.eye_pickup_active && lm.eye_pickup_victim_id == healed_player.entity.id {
				rr_lily_destroy_eye_pickup(player);
			}
			// If Lily is carrying these eyes, cancel
			if lm.carrying_eyes && lm.stolen_eyes_from_id == healed_player.entity.id {
				lm.carrying_eyes = false;
				lm.stolen_eyes_from_id = 0;
			}
			if player.is_local_or_server() {
				Notifier.notify(player, "Eye steal reversed — target was healed!");
			}
		}

		// Restore stolen legs if this player is the victim
		if healed_player.lily_crawling && lm.spider_victim_id == healed_player.entity.id {
			rr_lily_restore_legs(healed_player);
			// If spider is still active with these legs, cancel the delivery
			if lm.spider_active && lm.spider_has_legs {
				lm.spider_has_legs = false;
				lm.spider_victim_id = 0;
				lm.spider_return_deadline = 0.0;
			}
			// If legs were already delivered (carrying_legs), cancel that too
			if lm.carrying_legs && lm.stolen_legs_from_id == healed_player.entity.id {
				lm.carrying_legs = false;
				lm.stolen_legs_from_id = 0;
			}
			if player.is_local_or_server() {
				Notifier.notify(player, "Leg steal reversed — target was healed!");
			}
		}
	}
}

// =============================================================================
// Braid Point Awards
// =============================================================================


// =============================================================================
// Hair Tree System
// =============================================================================

Lily_Hair_Tree :: class : Component {
	owner_player_entity_id: u64;
	placement_time: float;
	tree_animator: Spine_Animator;

	// Request system — tree asks for items one at a time
	request_order: [..]int;       // shuffled indices (0-3) mapping to Tree_Request values
	fulfilled_count: int;         // how many requests have been fulfilled (= growth stage)

	// State machine is set up in rr_lily_place_hair_tree after skeleton is loaded

	// Get the current request type (what the tree is asking for)
	get_current_request :: method() -> Tree_Request, bool {
		if fulfilled_count >= request_order.count return Tree_Request.DEAD_PLAYER, false;
		return request_order[fulfilled_count].(Tree_Request), true;
	}

	// Fulfill the current request — grow tree, advance to next request
	fulfill_request :: method() {
		fulfilled_count += 1;
		grow();
	}

	// Growth: tree scales up per stage
	grow :: method() {
		new_scale := LILY_TREE_SCALE_STAGE_0;
		if fulfilled_count >= 6 {
			new_scale = LILY_TREE_SCALE_STAGE_6;
		} else if fulfilled_count == 5 {
			new_scale = LILY_TREE_SCALE_STAGE_5;
		} else if fulfilled_count == 4 {
			new_scale = LILY_TREE_SCALE_STAGE_4;
		} else if fulfilled_count == 3 {
			new_scale = LILY_TREE_SCALE_STAGE_3;
		} else if fulfilled_count == 2 {
			new_scale = LILY_TREE_SCALE_STAGE_2;
		} else if fulfilled_count == 1 {
			new_scale = LILY_TREE_SCALE_STAGE_1;
		}
		entity.set_local_scale(v2.{new_scale, new_scale});
	}
}

// Tree can no longer be destroyed by other players — it's Lily's permanent base.

// Pull interactable — Lily holds to pull a strung player toward the tree.
Lily_Tree_Pull_Interactable :: class : Interactable {
	tree_entity: Entity;
	aoe_entity: Entity;

	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Pull");
		this.set_hold_text("Pulling...");
		radius = LILY_TREE_INTERACT_RADIUS;
		required_hold_time = LILY_PULL_HOLD_DURATION;
		prompt_offset = v2.{0, 2.5};
		priority = 18;
	}

	spawn_aoe :: method() {
		if aoe_entity != null return;
		if tree_entity == null return;
		aoe_entity = Scene.create_entity();
		aoe_entity.set_parent(tree_entity, false);
		aoe_entity.set_local_position(v2.{0, 0});
		aoe_entity.set_local_scale(v2.{0.6, 0.6});
		aoe_anim := aoe_entity.add_component(Spine_Animator);
		aoe_anim.depth_offset = -5.0; // Render above everything
		aoe_anim.awaken();
		aoe_rig := get_asset(Spine_Asset, format_string("anims/vfx/BAT003_gravity_field_AOE.spine", {}));
		if aoe_anim.instance != null && aoe_rig != null {
			aoe_anim.instance.set_skeleton(aoe_rig);
			aoe_anim.instance.set_animation("loop", true, 0);
		}
	}

	destroy_aoe :: method() {
		if aoe_entity == null return;
		if !#alive(aoe_entity) { aoe_entity = null; return; }
		aoe_anim := aoe_entity.get_component(Spine_Animator);
		if aoe_anim != null && aoe_anim.instance != null {
			aoe_anim.instance.set_animation("disappear", false, 0);
		}
		delayed := aoe_entity.add_component(Lily_Delayed_Destroy);
		delayed.destroy_at = get_time() + 1.0;
		aoe_entity = null;
	}

	ao_end :: method() {
		destroy_aoe();
	}

	// Find the first alive strung player for this Lily
	find_pull_target :: method() -> Player {
		if tree_entity == null return null;
		if !#alive(tree_entity) return null;

		tree_comp := tree_entity.get_component(Lily_Hair_Tree);
		if tree_comp == null return null;
		lily := get_player_by_entity_id(tree_comp.owner_player_entity_id);
		if lily == null return null;
		lm := lily.entity.get_component(Lily_Module);
		if lm == null return null;

		if lm.pull_target_index >= lm.strung_player_ids.count {
			lm.pull_target_index = 0;
		}
		if lm.strung_player_ids.count == 0 return null;

		target := get_player_by_entity_id(lm.strung_player_ids[lm.pull_target_index]);
		if target != null && target.player_state == Player_State.ALIVE return target;

		// Try other targets
		for i: 0..lm.strung_player_ids.count-1 {
			target = get_player_by_entity_id(lm.strung_player_ids[i]);
			if target != null && target.player_state == Player_State.ALIVE {
				lm.pull_target_index = i;
				return target;
			}
		}
		return null;
	}

	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;
		if tree_entity == null return false;
		if !#alive(tree_entity) return false;
		return find_pull_target() != null;
	}

	on_holding :: method(player: Player) {
		// Show AOE while pulling
		spawn_aoe();

		// While holding, drag target toward tree
		target := find_pull_target();
		if target == null return;
		if tree_entity == null return;

		tree_pos := tree_entity.world_position;
		dir := tree_pos - target.entity.world_position;
		dist := length(dir);
		if dist > 0.3 {
			move := normalize(dir) * LILY_PULL_DRAG_SPEED * 0.016; // approximate frame dt
			new_pos := target.entity.world_position + move;
			nav_pt: v2;
			tri_hint: s64;
			try_find_closest_point_on_navmesh(new_pos, ref nav_pt, ref tri_hint);
			target.entity.set_local_position(nav_pt);
		}
	}

	on_interact :: method(player: Player) {
		destroy_aoe();
		// Pull complete — snap target to tree and freeze
		target := find_pull_target();
		if target == null return;
		if tree_entity == null return;

		tree_pos := tree_entity.world_position;
		nav_pt: v2;
		tri_hint: s64;
		try_find_closest_point_on_navmesh(tree_pos, ref nav_pt, ref tri_hint);
		target.entity.set_local_position(nav_pt);
		target.add_freeze_reason(LILY_PULL_REASON);

		if player.is_local_or_server() {
			Notifier.notify(player, format_string("% dragged to tree!", {target.get_username()}));
		}

		// Cycle to next target for subsequent pulls
		lm := player.entity.get_component(Lily_Module);
		if lm != null {
			lm.pull_target_index = (lm.pull_target_index + 1) % max(lm.strung_player_ids.count, 1);
		}
	}
}

// Deliver interactable — Lily holds to deliver a requested item to the tree.
Lily_Tree_Deliver_Interactable :: class : Interactable {
	tree_entity: Entity;

	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Deliver");
		this.set_hold_text("Delivering...");
		radius = LILY_TREE_DELIVER_RANGE;
		required_hold_time = LILY_DELIVER_HOLD_TIME;
		prompt_offset = v2.{0, 2.0};
		priority = 60;
	}

	// Check what the tree currently wants and if Lily can fulfill it
	can_fulfill :: method(player: Player) -> bool {
		if tree_entity == null return false;
		if !#alive(tree_entity) return false;
		tree_comp := tree_entity.get_component(Lily_Hair_Tree);
		if tree_comp == null return false;

		request, has_request := tree_comp.get_current_request();
		if !has_request return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;

		switch request {
			case .DEAD_PLAYER:
				// Lily must be dragging a corpse
				return player.dragging_corpse_entity_id != 0;
			case .EYES:
				return lm.carrying_eyes;
			case .LEGS:
				return lm.carrying_legs;
			case .ALIVE_PLAYER:
				// A living strung player must be near the tree
				return find_alive_strung_near_tree(lm) != null;
			case .LEGS_AND_EYES:
				// Must be carrying both
				return lm.carrying_eyes && lm.carrying_legs;
			case .LIVE_PLAYER_NO_PARTS:
				// A living strung player near tree who has no eyes AND no legs
				return find_alive_strung_no_parts_near_tree(lm) != null;
		}
		return false;
	}

	// Find a living strung player near the tree (also checks carried trap victims)
	find_alive_strung_near_tree :: method(lm: Lily_Module) -> Player {
		if tree_entity == null return null;
		tree_pos := tree_entity.world_position;
		for i: 0..lm.strung_player_ids.count-1 {
			target := get_player_by_entity_id(lm.strung_player_ids[i]);
			if target == null continue;
			if target.player_state != Player_State.ALIVE continue;
			dist := length(target.entity.world_position - tree_pos);
			if dist <= LILY_TREE_DELIVER_RANGE {
				return target;
			}
		}
		// Also check if Lily is carrying a trapped player near the tree
		if lm.dragging_live_player_id != 0 {
			target := get_player_by_entity_id(lm.dragging_live_player_id);
			if target != null && target.player_state == Player_State.ALIVE {
				dist := length(target.entity.world_position - tree_pos);
				if dist <= LILY_TREE_DELIVER_RANGE {
					return target;
				}
			}
		}
		return null;
	}

	// Find a living strung player near the tree who has no eyes AND no legs
	find_alive_strung_no_parts_near_tree :: method(lm: Lily_Module) -> Player {
		if tree_entity == null return null;
		tree_pos := tree_entity.world_position;
		for i: 0..lm.strung_player_ids.count-1 {
			target := get_player_by_entity_id(lm.strung_player_ids[i]);
			if target == null continue;
			if target.player_state != Player_State.ALIVE continue;
			if !target.lily_no_eyes continue;
			if !target.lily_crawling continue;
			dist := length(target.entity.world_position - tree_pos);
			if dist <= LILY_TREE_DELIVER_RANGE {
				return target;
			}
		}
		if lm.dragging_live_player_id != 0 {
			target := get_player_by_entity_id(lm.dragging_live_player_id);
			if target != null && target.player_state == Player_State.ALIVE {
				if target.lily_no_eyes && target.lily_crawling {
					dist := length(target.entity.world_position - tree_pos);
					if dist <= LILY_TREE_DELIVER_RANGE {
						return target;
					}
				}
			}
		}
		return null;
	}

	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;
		return can_fulfill(player);
	}

	on_interact :: method(player: Player) {
		if tree_entity == null return;
		if !#alive(tree_entity) return;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return;

		tree_comp := tree_entity.get_component(Lily_Hair_Tree);
		if tree_comp == null return;

		request, has_request := tree_comp.get_current_request();
		if !has_request return;

		switch request {
			case .DEAD_PLAYER: {
				// Consume the dragged corpse
				corpse_id := player.dragging_corpse_entity_id;
				rr_drag_body_force_drop_for_player(player);
				for corpse: component_iterator(Corpse) {
					if corpse == null continue;
					if !#alive(corpse.entity) continue;
					if corpse.entity.id == corpse_id {
						corpse.entity.destroy();
						break;
					}
				}
				if player.is_local_or_server() {
					Notifier.notify(player, "Corpse delivered to the tree!");
				}
			}
			case .EYES: {
				lm.carrying_eyes = false;
				lm.stolen_eyes_from_id = 0;
				if player.is_local_or_server() {
					Notifier.notify(player, "Eyes delivered to the tree!");
				}
			}
			case .LEGS: {
				lm.carrying_legs = false;
				lm.stolen_legs_from_id = 0;
				if player.is_local_or_server() {
					Notifier.notify(player, "Legs delivered to the tree!");
				}
			}
			case .ALIVE_PLAYER: {
				target := find_alive_strung_near_tree(lm);
				if target == null return;
				// End carry if this was a carried trap victim
				if lm.dragging_live_player_id != 0 && lm.dragging_live_player_id == target.entity.id {
					rr_lily_stop_live_drag(player);
					// Free the root so the kill is clean
					root := target.entity.get_component(Lily_String_Trap_Root);
					if root != null root.free();
				}
				// Absorb the living player into the tree
				target.kill_with_killer_no_corpse(player.entity.id);
				rr_lily_remove_string(player, target.entity.id);
				lm.kills += 1;
				if player.is_local_or_server() {
					Notifier.notify(player, format_string("% delivered to the tree!", {target.get_username()}));
				}
			}
			case .LEGS_AND_EYES: {
				// Consume both carried items
				lm.carrying_eyes = false;
				lm.stolen_eyes_from_id = 0;
				lm.carrying_legs = false;
				lm.stolen_legs_from_id = 0;
				if player.is_local_or_server() {
					Notifier.notify(player, "Legs & Eyes delivered to the tree!");
				}
			}
			case .LIVE_PLAYER_NO_PARTS: {
				target := find_alive_strung_no_parts_near_tree(lm);
				if target == null return;
				if lm.dragging_live_player_id != 0 && lm.dragging_live_player_id == target.entity.id {
					rr_lily_stop_live_drag(player);
					root := target.entity.get_component(Lily_String_Trap_Root);
					if root != null root.free();
				}
				target.kill_with_killer_no_corpse(player.entity.id);
				rr_lily_remove_string(player, target.entity.id);
				lm.kills += 1;
				if player.is_local_or_server() {
					Notifier.notify(player, format_string("% consumed by the tree!", {target.get_username()}));
				}
			}
		}

		// Fulfill the request — grow tree, advance to next
		tree_comp.fulfill_request();
		rr_lily_apply_tree_buffs(player);

		if player.is_local_or_server() {
			if tree_comp.fulfilled_count >= LILY_DEATHBRAID_THRESHOLD {
				Notifier.notify(player, "All requests fulfilled — Deathbraid is ready!");
			} else {
				request_name := rr_lily_get_request_name(tree_comp);
				Notifier.notify(player, format_string("Request fulfilled! Next: %", {request_name}));
			}
		}
	}
}

// Get a human-readable name for the tree's current request
rr_lily_get_request_name :: proc(tree_comp: Lily_Hair_Tree) -> string {
	request, has_request := tree_comp.get_current_request();
	if !has_request return "None";
	switch request {
		case .DEAD_PLAYER: return "Dead Player";
		case .EYES: return "Eyes";
		case .LEGS: return "Legs";
		case .ALIVE_PLAYER: return "Alive Player";
		case .LEGS_AND_EYES: return "Legs & Eyes";
		case .LIVE_PLAYER_NO_PARTS: return "Eyeless Legless Player";
	}
	return "Unknown";
}

// Apply tree growth buffs to Lily (speed + cooldown reduction)
rr_lily_apply_tree_buffs :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.hair_tree_entity == null return;

	tree_comp := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
	if tree_comp == null return;

	stage := tree_comp.fulfilled_count.(float);

	// Remove old speed buff if active
	if lm.tree_speed_buff_active {
		player.agent.movement_speed = player.agent.movement_speed / lm.tree_speed_multiplier;
	}

	// Apply new speed buff
	new_speed_mult := 1.0 + stage * LILY_TREE_SPEED_BUFF_PER_STAGE;
	lm.tree_speed_multiplier = new_speed_mult;
	lm.tree_speed_buff_active = true;
	player.agent.movement_speed = player.agent.movement_speed * new_speed_mult;

	// Cooldown multiplier (lower = faster cooldowns)
	lm.tree_cd_multiplier = 1.0 - stage * LILY_TREE_CD_REDUCTION_PER_STAGE;
	if lm.tree_cd_multiplier < 0.1 {
		lm.tree_cd_multiplier = 0.1;
	}
}

// Remove tree buffs (called on cleanup/revert)
rr_lily_remove_tree_buffs :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	if lm.tree_speed_buff_active {
		player.agent.movement_speed = player.agent.movement_speed / lm.tree_speed_multiplier;
		lm.tree_speed_buff_active = false;
		lm.tree_speed_multiplier = 1.0;
	}
	lm.tree_cd_multiplier = 1.0;
}

rr_lily_place_hair_tree :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	// One-time use — cannot plant again once placed
	if lm.hair_tree_planted return;

	pos := player.entity.world_position;
	// Snap to navmesh
	nav_point: v2;
	triangle_hint: s64;
	try_find_closest_point_on_navmesh(pos, ref nav_point, ref triangle_hint);

	tree_entity := Scene.create_entity();
	tree_entity.set_local_position(nav_point);
	// [ART] Starts as a small hair sapling — swap tree asset later
	tree_entity.set_local_scale(v2.{LILY_TREE_SCALE_STAGE_0, LILY_TREE_SCALE_STAGE_0});

	tree_anim := tree_entity.add_component(Spine_Animator);
	tree_anim.awaken();
	// [ART] Using current tree rig — will be swapped for a proper sapling/growth asset
	tree_rig := get_asset(Spine_Asset, rr_lily_get_tree_rig_path());
	if tree_anim.instance != null && tree_rig != null {
		tree_anim.instance.set_skeleton(tree_rig);
		rr_apply_shadow_mask(tree_anim.instance);

		// Set up state machine: Spawn → Idle, with Destroyed trigger
		sm := State_Machine.create();
		layer := sm.create_layer("main", 0);
		spawn_state := layer.create_state("Spawn", false, 1.0);
		idle_state := layer.create_state("Idle", true, 0.0);
		destroyed_trigger := sm.create_variable("destroyed", .TRIGGER);
		destroyed_state := layer.create_state("Destroyed", false, 1.0);
		layer.set_initial_state(spawn_state);
		layer.create_transition(spawn_state, idle_state, true);
		layer.create_global_transition(destroyed_state, false).create_trigger_condition(destroyed_trigger);
		tree_anim.instance.set_state_machine(sm, true);
	}

	tree_comp := tree_entity.add_component(Lily_Hair_Tree);
	tree_comp.owner_player_entity_id = player.entity.id;
	tree_comp.placement_time = get_time();
	tree_comp.tree_animator = tree_anim;
	tree_comp.fulfilled_count = 0;

	// Fixed request order: Dead Player, Eyes, Legs, Alive Player, then multi-requests
	tree_comp.request_order.clear();
	tree_comp.request_order.append(0); // DEAD_PLAYER
	tree_comp.request_order.append(1); // EYES
	tree_comp.request_order.append(2); // LEGS
	tree_comp.request_order.append(3); // ALIVE_PLAYER
	tree_comp.request_order.append(4); // LEGS_AND_EYES
	tree_comp.request_order.append(5); // LIVE_PLAYER_NO_PARTS

	deliver_interactable := tree_entity.add_component(Lily_Tree_Deliver_Interactable);
	deliver_interactable.tree_entity = tree_entity;

	pull_interactable := tree_entity.add_component(Lily_Tree_Pull_Interactable);
	pull_interactable.tree_entity = tree_entity;

	lm.hair_tree_entity = tree_entity;
	lm.hair_tree_planted = true;

	if player.is_local_or_server() {
		Notifier.notify(player, "Braid Tree planted! This is your permanent base.");
	}
}

rr_lily_teleport_to_tree :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.tree_teleport_cooldown > 0.0 return;
	if lm.hair_tree_entity == null return;
	if !#alive(lm.hair_tree_entity) return;

	nav_point: v2;
	triangle_hint: s64;
	try_find_closest_point_on_navmesh(lm.hair_tree_entity.world_position, ref nav_point, ref triangle_hint);
	player.entity.set_local_position(nav_point);
	lm.tree_teleport_cooldown = LILY_TREE_TELEPORT_COOLDOWN;
}

// =============================================================================
// Teleport strung players in a circle around a target point
// =============================================================================

LILY_TELEPORT_CIRCLE_RADIUS :: 3.0;

rr_lily_teleport_strung_to_point :: proc(player: Player, center: v2) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.strung_player_ids.count == 0 return;

	count := lm.strung_player_ids.count;
	for i: 0..count-1 {
		target := get_player_by_entity_id(lm.strung_player_ids[i]);
		if target == null continue;
		if target.player_state != Player_State.ALIVE continue;

		// Distribute evenly in a circle
		angle := (i.(float) / count.(float)) * 2.0 * PI;
		offset := v2.{cos(angle) * LILY_TELEPORT_CIRCLE_RADIUS, sin(angle) * LILY_TELEPORT_CIRCLE_RADIUS};
		dest := center + offset;

		// Snap to navmesh
		nav_point: v2;
		triangle_hint: s64;
		try_find_closest_point_on_navmesh(dest, ref nav_point, ref triangle_hint);
		target.entity.set_local_position(nav_point);
		target.set_trigger("lily_pull_start");
	}
}

// =============================================================================
// Red Light, Green Light
// =============================================================================


// =============================================================================
// Tree Pull Root Timer (auto-expires roots on strung players)
// =============================================================================

// =============================================================================
// String Braid VFX — lives on each strung player's head
// =============================================================================

LILY_BRAID_HEAD_OFFSET :: 0.9; // Y offset to position braid at head height

// Component on the braid VFX entity (child of strung player).
Lily_String_Braid :: class : Component {
	braid_animator: Spine_Animator;
	lily_player_entity_id: u64;

	is_visible_to_local_player :: method() -> bool {
		// Only visible to Lily herself
		local_player, ok := Game.get_local_player();
		if !ok return false;
		return local_player.entity.id == lily_player_entity_id;
	}

	apply_local_visibility :: method() {
		if braid_animator == null return;
		if braid_animator.instance == null return;

		if is_visible_to_local_player() {
			braid_animator.instance.color_multiplier = v4.{1, 1, 1, 1};
		} else {
			braid_animator.instance.color_multiplier = v4.{1, 1, 1, 0};
		}
	}

	ao_start :: method() {
		apply_local_visibility();
	}

	ao_on_state_sync :: method() {
		apply_local_visibility();
	}

	ao_update :: method(dt: float) {
		// Self-destroy if parent player is dead
		parent_entity := entity.get_parent();
		if parent_entity != null && #alive(parent_entity) {
			parent_player := parent_entity.get_component(Player);
			if parent_player != null && parent_player.player_state != Player_State.ALIVE {
				entity.destroy();
				return;
			}
		}

		apply_local_visibility();

		// Flip braid to face toward Lily, compensating for parent's facing scale.
		lily := get_player_by_entity_id(lily_player_entity_id);
		if lily == null return;

		parent_player := entity.get_parent();
		if parent_player == null return;
		if !#alive(parent_player) return;

		dir_x := lily.entity.world_position.x - parent_player.world_position.x;
		parent_flipped := parent_player.world_scale.x < 0.0;

		// XOR: if parent is flipped, invert our local scale to get the desired world facing
		if (dir_x > 0.0) != parent_flipped {
			entity.set_local_scale(v2.{-1, 1});
		} else {
			entity.set_local_scale(v2.{1, 1});
		}
	}

	trigger :: method(trigger_name: string) {
		if braid_animator == null return;
		if braid_animator.instance == null return;
		if braid_animator.instance.state_machine == null return;
		braid_animator.instance.state_machine.set_trigger(trigger_name);
	}

	update_locomotion :: method(is_moving: bool) {
		if braid_animator == null return;
		if braid_animator.instance == null return;
		if braid_animator.instance.state_machine == null return;
		braid_animator.instance.state_machine.set_bool("is_moving", is_moving);
	}
}

rr_lily_setup_braid_state_machine :: proc(sa: Spine_Animator) {
	sm := State_Machine.create();
	layer := sm.create_layer("main", 0);

	idle_state := layer.create_state("Idle", true, 0.0);
	is_moving := sm.create_variable("is_moving", .BOOL);
	run_state := layer.create_state("Run", true, 0.0);
	layer.set_initial_state(idle_state);

	idle_to_run := layer.create_transition(idle_state, run_state, false);
	idle_to_run.create_bool_condition(is_moving, true);
	run_to_idle := layer.create_transition(run_state, idle_state, false);
	run_to_idle.create_bool_condition(is_moving, false);

	attach_trigger := sm.create_variable("attach", .TRIGGER);
	attach_state := layer.create_state("Attach", false, 1.0);
	layer.create_global_transition(attach_state, false).create_trigger_condition(attach_trigger);
	layer.create_transition(attach_state, idle_state, true);

	cut_trigger := sm.create_variable("cut", .TRIGGER);
	cut_state := layer.create_state("Cut", false, 1.0);
	layer.create_global_transition(cut_state, false).create_trigger_condition(cut_trigger);

	pull_start_trigger := sm.create_variable("pull_start", .TRIGGER);
	pull_start_state := layer.create_state("Pulling_Start", false, 0.5);
	pull_loop_state := layer.create_state("Pulling_Loop", true, 0.0);
	layer.create_global_transition(pull_start_state, false).create_trigger_condition(pull_start_trigger);
	layer.create_transition(pull_start_state, pull_loop_state, true);

	control_start_trigger := sm.create_variable("control_start", .TRIGGER);
	control_start_state := layer.create_state("Control_Start", false, 0.5);
	control_loop_state := layer.create_state("Control_Loop", true, 0.0);
	control_end_trigger := sm.create_variable("control_end", .TRIGGER);
	control_end_state := layer.create_state("Control_End", false, 0.5);
	layer.create_global_transition(control_start_state, false).create_trigger_condition(control_start_trigger);
	layer.create_transition(control_start_state, control_loop_state, true);
	layer.create_global_transition(control_end_state, false).create_trigger_condition(control_end_trigger);
	layer.create_transition(control_end_state, idle_state, true);

	sa.instance.set_state_machine(sm, true);
}

// Spawn a braid on a strung player's head. Plays Attach animation.
rr_lily_spawn_braid_on_target :: proc(target: Player, lily_entity_id: u64) {
	if target == null return;

	// Don't double-spawn
	existing := target.entity.get_component(Lily_String_Braid);
	if existing != null return;

	se := Scene.create_entity();
	se.set_parent(target.entity, false);
	se.set_local_position(v2.{0, LILY_BRAID_HEAD_OFFSET});
	se.set_local_scale(v2.{1, 1});

	sa := se.add_component(Spine_Animator);
	sa.depth_offset = -2.0; // Render above players
	sa.awaken();
	rig := get_asset(Spine_Asset, rr_lily_get_string_rig_path());
	if sa.instance != null && rig != null {
		sa.instance.set_skeleton(rig);
		rr_lily_setup_braid_state_machine(sa);
		sa.instance.set_animation("Attach", false, 0);
	}

	braid := se.add_component(Lily_String_Braid);
	braid.braid_animator = sa;
	braid.lily_player_entity_id = lily_entity_id;
}

// Remove the braid from a strung player. Plays Cut animation then destroys.
rr_lily_remove_braid_from_target :: proc(target: Player) {
	if target == null return;

	braid := target.entity.get_component(Lily_String_Braid);
	if braid == null return;

	// Play cut animation then destroy
	braid.trigger("cut");
	delayed := braid.entity.add_component(Lily_Delayed_Destroy);
	delayed.destroy_at = get_time() + 1.0;
}

// Trigger an animation on ALL strung players' braids.
rr_lily_trigger_all_braids :: proc(player: Player, trigger_name: string) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	for i: 0..lm.strung_player_ids.count-1 {
		target := get_player_by_entity_id(lm.strung_player_ids[i]);
		if target == null continue;
		braid := target.entity.get_component(Lily_String_Braid);
		if braid == null continue;
		braid.trigger(trigger_name);
	}
}

// Update locomotion on all strung players' braids.
rr_lily_update_all_braids :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	for i: 0..lm.strung_player_ids.count-1 {
		target := get_player_by_entity_id(lm.strung_player_ids[i]);
		if target == null continue;
		braid := target.entity.get_component(Lily_String_Braid);
		if braid == null continue;
		moving := length_squared(target.agent.velocity) > 0.01;
		braid.update_locomotion(moving);
	}
}

// Generic delayed entity destroy (waits for animation to finish).
Lily_Delayed_Destroy :: class : Component {
	destroy_at: float;

	ao_update :: method(dt: float) {
		if get_time() >= destroy_at {
			entity.destroy();
		}
	}
}


// =============================================================================
// Tea Party
// =============================================================================

Lily_Tea_Cup_Follower :: class : Component {
	table_entity: Entity;
	shadow_bone_name: string;
	settled: bool;
	settle_target: v2;      // local position to lerp toward when settled
	settle_speed: float;

	ao_update :: method(dt: float) {
		if table_entity == null || !#alive(table_entity) {
			entity.destroy();
			return;
		}

		if settled {
			// Lerp toward settle position
			current := entity.local_position;
			dir := settle_target - current;
			dist := length(dir);
			if dist > 0.01 {
				move := normalize(dir) * settle_speed * dt;
				if length(move) > dist {
					entity.set_local_position(settle_target);
				} else {
					entity.set_local_position(current + move);
				}
			}
			return;
		}

		table_anim := table_entity.get_component(Spine_Animator);
		if table_anim == null || table_anim.instance == null return;

		shadow_local := table_anim.instance.get_bone_local_position(shadow_bone_name);
		entity.set_local_position(shadow_local);
	}
}

// Spawn tea cup entities at CUP bone positions on the table rig.
rr_lily_spawn_tea_cups :: proc(player: Player, table_anim: Spine_Animator, count: int) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if table_anim == null return;
	if table_anim.instance == null return;

	cup_rig := get_asset(Spine_Asset, rr_lily_get_teacup_rig_path());
	if cup_rig == null return;

	for i: 0..count-1 {
		shadow_bone_name := format_string("TestShadow%", {i + 1});
		shadow_local := table_anim.instance.get_bone_local_position(shadow_bone_name);

		cup_entity := Scene.create_entity();
		cup_entity.set_parent(table_anim.entity, false);
		cup_entity.set_local_position(shadow_local);
		cup_entity.set_local_scale(v2.{1, 1});

		cup_anim := cup_entity.add_component(Spine_Animator);
		cup_anim.depth_offset = -3.0;
		cup_anim.awaken();
		if cup_anim.instance != null {
			cup_anim.instance.set_skeleton(cup_rig);
			cup_anim.instance.set_animation("Spawn", false, 0);
		}

		follower := cup_entity.add_component(Lily_Tea_Cup_Follower);
		follower.table_entity = table_anim.entity;
		follower.shadow_bone_name = shadow_bone_name;

		lm.tea_cup_entities.append(cup_entity);
	}
}

// Get the PLAYER bone world position for a given seat index (1-based).
rr_lily_get_seat_position :: proc(lm: Lily_Module, seat_index: int) -> v2 {
	if lm.tea_table_animator == null return v2.{0, 0};
	if lm.tea_table_animator.instance == null return v2.{0, 0};
	bone_name := format_string("PLAYER%", {seat_index});
	bone_local := lm.tea_table_animator.instance.get_bone_local_position(bone_name);
	return lm.tea_table_animator.entity.world_position + bone_local;
}

rr_lily_place_strung_players_at_table :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.tea_table_animator == null return;
	if lm.tea_table_animator.instance == null return;
	if lm.strung_player_ids.count == 0 return;

	seat_count := lm.strung_player_ids.count;
	if seat_count < 1 seat_count = 1;
	if seat_count > 8 seat_count = 8;

	for i: 0..seat_count-1 {
		target := get_player_by_entity_id(lm.strung_player_ids[i]);
		if target == null continue;
		if target.player_state != Player_State.ALIVE continue;

		seat_world := rr_lily_get_seat_position(lm, i + 1);
		target.entity.set_local_position(seat_world);
	}
}

rr_lily_start_tea_party :: proc(player: Player, target: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if target == null return;

	// Place table between Lily and victim
	mid := (player.entity.world_position + target.entity.world_position) * 0.5;
	nav_point: v2;
	triangle_hint: s64;
	try_find_closest_point_on_navmesh(mid, ref nav_point, ref triangle_hint);

	// --- Layer 1: Table (1 player layout) ---
	table_entity := Scene.create_entity();
	table_entity.set_local_position(nav_point);
	table_entity.set_local_scale(v2.{1, 1});

	table_anim := table_entity.add_component(Spine_Animator);
	table_anim.depth_offset = 2.0; // render below players
	table_anim.awaken();
	table_rig := get_asset(Spine_Asset, rr_lily_get_table_rig_path());
	if table_anim.instance != null && table_rig != null {
		table_anim.instance.set_skeleton(table_rig);
		table_anim.instance.set_animation("2_Player/Idle", true, 0);
		rr_apply_shadow_mask(table_anim.instance);
	}

	lm.tea_table_entity = table_entity;
	lm.tea_table_animator = table_anim;

	// --- Layer 2: Spawn 2 cups ---
	lm.tea_cup_entities.clear();
	rr_lily_spawn_tea_cups(player, table_anim, 2);

	// --- Layer 3: Tray overlay ---
	tray_entity := Scene.create_entity();
	tray_entity.set_parent(table_entity, false);
	tray_entity.set_local_position(v2.{0, 0});
	tray_anim := tray_entity.add_component(Spine_Animator);
	tray_anim.depth_offset = -4.0;
	tray_anim.awaken();
	tray_rig := get_asset(Spine_Asset, rr_lily_get_tray_rig_path());
	if tray_anim.instance != null && tray_rig != null {
		tray_anim.instance.set_skeleton(tray_rig);
		tray_anim.instance.set_animation("Idle", true, 0);
	}
	lm.tea_tray_entity = tray_entity;

	// State setup
	lm.tea_party_active = true;
	lm.tea_party_start_time = get_time();
	lm.tea_party_ends_at = get_time() + LILY_TEA_CUP_SPIN_START_DELAY + LILY_TEA_CUP_SPIN_SECONDS + LILY_TEA_PARTY_CHOICE_TIME + 3.0;
	lm.tea_party_target_id = target.entity.id;
	lm.tea_party_victim_chose = false;
	lm.tea_party_drink_done = false;
	lm.tea_party_choice_deadline = 0.0;

	// Random poison assignment: 50/50 left or right
	rng: u64 = rng_seed_time();
	lm.tea_party_poison_cup = rng_range_int(ref rng, 1, 2);

	// Place victim at table seat
	seat_world := rr_lily_get_seat_position(lm, 1);
	target.entity.set_local_position(seat_world);
	target.add_freeze_reason(LILY_TEA_PARTY_SIT_REASON);
	target.set_trigger("lily_tea_start");

	// Camera focus for both players
	lm.tea_party_camera_saved_size = player.camera.size;
	lm.tea_party_camera_saved_follow = player.camera.follow_player;

	// Add victim choice component
	existing_choice := target.entity.get_component(Lily_Tea_Party_Victim_Choice);
	if existing_choice == null {
		existing_choice = target.entity.add_component(Lily_Tea_Party_Victim_Choice);
	}
	existing_choice.choice = 0;
	existing_choice.lily_entity_id = player.entity.id;
	existing_choice.deadline = 0.0;
	existing_choice.active = true;

	if Game.is_server() {
		sfx := SFX.default_sfx_desc();
		sfx.set_position(nav_point);
		sfx.volume = 0.4;
		rr_play_sfx(LILY_SFX_TEA_PARTY, sfx);
	}

	rr_lily_creature_trigger(player, "leap_start");
}

rr_lily_update_tea_party :: proc(player: Player, dt: float) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.tea_party_active return;

	now := get_time();
	elapsed := now - lm.tea_party_start_time;

	if lm.tea_table_entity == null || !#alive(lm.tea_table_entity) {
		rr_lily_end_tea_party(player);
		return;
	}

	// Validate victim still alive
	victim := get_player_by_entity_id(lm.tea_party_target_id);
	if victim == null || victim.player_state != Player_State.ALIVE {
		rr_lily_end_tea_party(player);
		return;
	}

	// Keep victim locked at seat, facing the table
	seat_world := rr_lily_get_seat_position(lm, 1);
	victim.entity.set_local_position(seat_world);
	table_pos := lm.tea_table_entity.world_position;
	victim.set_facing_right(table_pos.x > seat_world.x);

	// Camera focus (must set every frame due to server sync)
	if player.is_local_or_server() {
		table_pos := lm.tea_table_entity.world_position;
		player.camera.follow_player = false;
		player.camera.position = table_pos;
		player.camera.size = LILY_TEA_PARTY_CAMERA_SIZE;
	}
	// Focus victim's camera too
	if victim.is_local_or_server() {
		table_pos := lm.tea_table_entity.world_position;
		victim.camera.follow_player = false;
		victim.camera.position = table_pos;
		victim.camera.size = LILY_TEA_PARTY_CAMERA_SIZE;
	}

	// Done already
	if lm.tea_party_drink_done return;

	// Drinking phase: drink anim playing, wait for it to finish before applying effect
	if lm.tea_party_drinking {
		if now >= lm.tea_party_drink_done_at {
			rr_lily_tea_party_resolve(player, victim, lm.tea_party_chosen_cup);
			lm.tea_party_drink_done = true;
		}
		return;
	}

	// Settle phase: cup sliding in front of player
	if lm.tea_party_victim_chose {
		if now >= lm.tea_party_settle_at {
			// Cup has settled — switch to Idle_Plate and start drink anim
			chosen_idx := lm.tea_party_chosen_cup - 1;
			if chosen_idx >= 0 && chosen_idx < lm.tea_cup_entities.count {
				cup := lm.tea_cup_entities[chosen_idx];
				if cup != null && #alive(cup) {
					cup_anim := cup.get_component(Spine_Animator);
					if cup_anim != null && cup_anim.instance != null {
						cup_anim.instance.set_animation("Idle_Plate", true, 0);
					}
				}
			}

			// Play the correct drink animation based on outcome
			is_poison := lm.tea_party_chosen_cup == lm.tea_party_poison_cup;
			if is_poison {
				victim.set_trigger("lily_tea_death");
			} else {
				victim.set_trigger("lily_tea_hyper");
			}
			lm.tea_party_drinking = true;
			lm.tea_party_drink_done_at = now + 2.0; // drink anim duration
		}
		return;
	}

	// Phase 1: Cup spawn anim playing
	if elapsed < LILY_TEA_CUP_SPAWN_SECONDS return;

	// Phase 2: Waiting period before choice opens — cups sit on Idle
	if elapsed < LILY_TEA_CUP_SPIN_START_DELAY return;

	// Phase 3: Choice phase — victim picks a cup
	// Start choice deadline once
	if lm.tea_party_choice_deadline == 0.0 {
		lm.tea_party_choice_deadline = now + LILY_TEA_PARTY_CHOICE_TIME;

		// Activate victim choice UI
		victim_choice := victim.entity.get_component(Lily_Tea_Party_Victim_Choice);
		if victim_choice != null {
			victim_choice.deadline = lm.tea_party_choice_deadline;
		}
	}

	// Check if victim chose or deadline expired
	victim_choice := victim.entity.get_component(Lily_Tea_Party_Victim_Choice);
	victim_picked := 0;
	if victim_choice != null && victim_choice.choice != 0 {
		victim_picked = victim_choice.choice;
	}

	if victim_picked != 0 || now >= lm.tea_party_choice_deadline {
		// If no pick, random assignment
		if victim_picked == 0 {
			rng: u64 = rng_seed_time();
			victim_picked = rng_range_int(ref rng, 1, 2);
		}

		// Start settle phase: chosen cup slides to player, other cup despawns
		lm.tea_party_victim_chose = true;
		lm.tea_party_chosen_cup = victim_picked;
		lm.tea_party_settle_at = now + 1.5;

		// Calculate settle position: same radius from table center, angled toward victim
		table_pos := lm.tea_table_entity.world_position;
		victim_pos := victim.entity.world_position;
		dir_to_victim := victim_pos - table_pos;
		cup_radius := 0.0;

		// Chosen cup settles (Idle_Plate) in front of player, other cup despawns
		for c: 0..lm.tea_cup_entities.count-1 {
			cup := lm.tea_cup_entities[c];
			if cup == null continue;
			if !#alive(cup) continue;

			if c == (victim_picked - 1) {
				// Get current radius from table center
				cup_radius = length(cup.local_position);
				if cup_radius < 0.1 cup_radius = 1.0;

				// Target: same radius, direction toward victim (in local space)
				settle_dir := dir_to_victim;
				if length_squared(settle_dir) < 0.01 {
					settle_dir = v2.{0, -1};
				} else {
					settle_dir = normalize(settle_dir);
				}
				settle_local := settle_dir * cup_radius;

				// Tell follower to lerp to settle position (stays on Idle until arrived)
				follower := cup.get_component(Lily_Tea_Cup_Follower);
				if follower != null {
					follower.settled = true;
					follower.settle_target = settle_local;
					follower.settle_speed = 3.0;
				}
			} else {
				cup_anim := cup.get_component(Spine_Animator);
				if cup_anim != null && cup_anim.instance != null {
					cup_anim.instance.set_animation("Despawn", false, 0);
				}
				delayed := cup.add_component(Lily_Delayed_Destroy);
				delayed.destroy_at = now + 1.0;
			}
		}
		return;
	}

	// Draw red glow on poison cup for Lily (local only)
	if player.is_local() {
		rr_lily_draw_poison_cup_glow(player);
	}

	// Timeout safety
	if now >= lm.tea_party_ends_at {
		rr_lily_end_tea_party(player);
	}
}

// Resolve the cup choice — poison or caffeine
rr_lily_tea_party_resolve :: proc(player: Player, victim: Player, chosen_cup: int) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if victim == null return;

	is_poison := chosen_cup == lm.tea_party_poison_cup;

	if is_poison {
		// Poison — victim dies
		victim.remove_freeze_reason(LILY_TEA_PARTY_SIT_REASON);
		victim.kill_with_killer(player.entity.id);
		// Reset anim state to idle so ghost doesn't show death pose
		if victim.animator != null && victim.animator.instance != null {
			victim.animator.instance.set_animation("idle", true, 0);
		}
		if player.is_local_or_server() {
			Notifier.notify(player, format_string("% drank poison!", {victim.get_username()}));
		}
	} else {
		// Caffeine — uncontrollable movement (anim already playing)
		victim.remove_freeze_reason(LILY_TEA_PARTY_SIT_REASON);
		victim.add_disable_movement_input_reason(LILY_CAFFEINE_REASON);

		caffeine_entity := Scene.create_entity();
		caffeine_timer := caffeine_entity.add_component(Lily_Caffeine_Timer);
		caffeine_timer.ends_at = get_time() + LILY_CAFFEINE_DURATION;
		caffeine_timer.player_entity_id = victim.entity.id;
		caffeine_timer.speed_multiplier = LILY_CAFFEINE_SPEED_BOOST;
		victim.agent.movement_speed = victim.agent.movement_speed * LILY_CAFFEINE_SPEED_BOOST;

		if victim.is_local_or_server() {
			Notifier.notify(victim, "Caffeine rush! You can't stop running!");
		}
		if player.is_local_or_server() {
			Notifier.notify(player, format_string("% got caffeine!", {victim.get_username()}));
		}
	}

	// NO string reset — strings remain after tea party
	rr_lily_end_tea_party(player);
}

// Draw red glow on poison cup (Lily's screen only)
rr_lily_draw_poison_cup_glow :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.tea_party_poison_cup < 1 return;
	if lm.tea_party_poison_cup > lm.tea_cup_entities.count return;

	poison_cup := lm.tea_cup_entities[lm.tea_party_poison_cup - 1];
	if poison_cup == null return;
	if !#alive(poison_cup) return;

	UI.push_world_draw_context();
	defer UI.pop_draw_context();

	cup_pos := poison_cup.world_position;
	UI.push_z(cup_pos.y - 0.1);
	defer UI.pop_z();

	pulse := sin(get_time() * 4.0) * 0.15 + 0.85;
	glow_rect := Rect{cup_pos, cup_pos}.grow(0.4);
	UI.quad(glow_rect, core_globals.white_sprite, v4.{1.0, 0.0, 0.0, 0.3 * pulse});
}

rr_lily_end_tea_party :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.tea_party_active return;

	lm.tea_party_active = false;
	lm.tea_party_drink_done = false;
	lm.tea_party_victim_chose = false;
	lm.tea_party_choice_deadline = 0.0;

	// Restore camera
	if player.is_local_or_server() {
		player.camera.follow_player = lm.tea_party_camera_saved_follow;
		player.camera.size = lm.tea_party_camera_saved_size;
	}

	// Restore victim camera and free them
	victim := get_player_by_entity_id(lm.tea_party_target_id);
	if victim != null {
		victim.remove_freeze_reason(LILY_TEA_PARTY_SIT_REASON);
		// Restore victim camera
		if victim.is_local_or_server() {
			victim.camera.follow_player = true;
		}
		// Remove choice component
		victim_choice := victim.entity.get_component(Lily_Tea_Party_Victim_Choice);
		if victim_choice != null {
			victim_choice.active = false;
		}
	}
	lm.tea_party_target_id = 0;

	// Despawn cups
	for i: 0..lm.tea_cup_entities.count-1 {
		cup := lm.tea_cup_entities[i];
		if cup != null && #alive(cup) {
			cup_anim := cup.get_component(Spine_Animator);
			if cup_anim != null && cup_anim.instance != null {
				cup_anim.instance.set_animation("Despawn", false, 0);
			}
			delayed := cup.add_component(Lily_Delayed_Destroy);
			delayed.destroy_at = get_time() + 1.0;
		}
	}
	lm.tea_cup_entities.clear();

	// Despawn table
	if lm.tea_table_entity != null && #alive(lm.tea_table_entity) {
		if lm.tea_table_animator != null && lm.tea_table_animator.instance != null {
			lm.tea_table_animator.instance.set_animation("Despawn", false, 0);
		}
		delayed := lm.tea_table_entity.add_component(Lily_Delayed_Destroy);
		delayed.destroy_at = get_time() + 1.0;
	}
	lm.tea_table_entity = null;
	lm.tea_table_animator = null;

	// Destroy tray
	if lm.tea_tray_entity != null && #alive(lm.tea_tray_entity) {
		lm.tea_tray_entity.destroy();
	}
	lm.tea_tray_entity = null;
}

// Victim cup choice component — syncs the victim's pick back to Lily
Lily_Tea_Party_Victim_Choice :: class : Component {
	choice: int;          // 0=none, 1=left cup, 2=right cup
	lily_entity_id: u64;
	deadline: float;
	active: bool;
}

// Draw tea party victim cup choice UI — called from player ao_late_update for ALL players.
rr_lily_draw_tea_party_victim_ui :: proc(player: Player) {
	vc := player.entity.get_component(Lily_Tea_Party_Victim_Choice);
	if vc == null return;
	if !vc.active return;
	if vc.choice != 0 return;
	if vc.deadline <= 0.0 return;

	if !player.is_local_or_server() return;

	screen := UI.get_safe_screen_rect();
	UI.push_layer(200);
	defer UI.pop_layer();

	// Timer bar
	remaining := vc.deadline - get_time();
	if remaining < 0.0 remaining = 0.0;
	timer_pct := remaining / LILY_TEA_PARTY_CHOICE_TIME;

	timer_rect := screen.top_center_rect().offset(0.0, -160.0).grow(10.0, 150.0, 10.0, 150.0);
	UI.quad(timer_rect, core_globals.white_sprite, v4.{0.0, 0.0, 0.0, 0.6});
	fill := timer_rect.subrect(0.0, 0.0, timer_pct, 1.0);
	UI.quad(fill, core_globals.white_sprite, v4.{1.0, 0.8, 0.2, 0.9});

	ts := UI.default_text_settings();
	ts.size = 28;
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.color = v4.{1.0, 1.0, 1.0, 1.0};
	ts.do_outline = true;
	ts.outline_thickness = 2;
	ts.outline_color = v4.{0, 0, 0, 1};

	prompt_rect := screen.center_rect().offset(0.0, 80.0).grow(20.0, 200.0, 20.0, 200.0);
	UI.text(prompt_rect, ts, "Choose a cup!");

	bs := UI.default_button_settings();
	bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png");

	btn_ts := UI.default_text_settings();
	btn_ts.size = 24;
	btn_ts.halign = .CENTER;
	btn_ts.valign = .CENTER;
	btn_ts.color = v4.{1, 1, 1, 1};

	left_rect := screen.center_rect().offset(-120.0, 0.0).grow(35.0, 100.0, 35.0, 100.0);
	right_rect := screen.center_rect().offset(120.0, 0.0).grow(35.0, 100.0, 35.0, 100.0);

	if UI.button(left_rect, bs, btn_ts, "Left Cup").clicked {
		vc.choice = 1;
	}

	bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_1.png");
	UI.push_id("right_cup", {});
	defer UI.pop_id();
	if UI.button(right_rect, bs, btn_ts, "Right Cup").clicked {
		vc.choice = 2;
	}
}

// Caffeine effect timer — forced movement at high speed
Lily_Caffeine_Timer :: class : Component {
	ends_at: float;
	player_entity_id: u64;
	speed_multiplier: float;
	rng: u64;
	current_dir: v2;
	next_direction_change_at: float;

	ao_start :: method() {
		rng = rng_seed_time();
		angle := rng_range_float(ref rng, 0.0, 6.28);
		current_dir = v2.{cos(angle), sin(angle)};
		next_direction_change_at = get_time() + LILY_CAFFEINE_DIRECTION_HOLD_SECONDS;
	}

	ao_update :: method(dt: float) {
		p := get_player_by_entity_id(player_entity_id);
		if p == null {
			entity.destroy();
			return;
		}

		// Force random movement direction
		if p.player_state == Player_State.ALIVE {
			if get_time() >= next_direction_change_at {
				angle := rng_range_float(ref rng, 0.0, 6.28);
				current_dir = v2.{cos(angle), sin(angle)};
				next_direction_change_at = get_time() + LILY_CAFFEINE_DIRECTION_HOLD_SECONDS;
			}
			p.agent.input_this_frame = current_dir;
			p.set_facing_right(current_dir.x >= 0.0);

			// Sync hyper locomotion animation
			moving := length_squared(p.agent.input_this_frame) > 0.01;
			sm := p.animator.instance.state_machine;
			if sm != null {
				sm.set_bool("lily_hyper_moving", moving);
			}
		}

		if get_time() >= ends_at {
			p.remove_disable_movement_input_reason(LILY_CAFFEINE_REASON);
			p.agent.movement_speed = p.agent.movement_speed / speed_multiplier;
			p.agent.input_this_frame = v2.{0, 0};
			p.agent.velocity = v2.{0, 0};
			p.set_trigger("lily_hyper_end");
			entity.destroy();
		}
	}
}

// =============================================================================
// Pull (base ability — drag strung player to nearest tree)
// =============================================================================

// Get Lily's planted tree (single tree now)
rr_lily_get_nearest_tree :: proc(player: Player) -> Entity {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return null;
	if lm.hair_tree_entity == null return null;
	if !#alive(lm.hair_tree_entity) return null;
	return lm.hair_tree_entity;
}

rr_lily_start_pull :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	tree := rr_lily_get_nearest_tree(player);
	if tree == null return;
	if length(player.entity.world_position - tree.world_position) > LILY_TREE_INTERACT_RADIUS return;

	lm.pull_active = true;
	lm.pull_progress = 0.0;
	lm.pull_tree_entity = tree;
	lm.pull_snapping = false;

	// Validate target index
	if lm.pull_target_index >= lm.strung_player_ids.count {
		lm.pull_target_index = 0;
	}

	// Start pulling animation on target's braid
	if lm.strung_player_ids.count > 0 {
		target := get_player_by_entity_id(lm.strung_player_ids[lm.pull_target_index]);
		if target != null {
			braid := target.entity.get_component(Lily_String_Braid);
			if braid != null braid.trigger("pull_start");
		}
	}
}

rr_lily_update_pull :: proc(player: Player, dt: float) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.pull_active return;

	// Validate tree still exists
	if lm.pull_tree_entity == null || !#alive(lm.pull_tree_entity) {
		rr_lily_end_pull(player);
		return;
	}

	// Validate target
	if lm.strung_player_ids.count == 0 {
		rr_lily_end_pull(player);
		return;
	}
	if lm.pull_target_index >= lm.strung_player_ids.count {
		lm.pull_target_index = 0;
	}

	target := get_player_by_entity_id(lm.strung_player_ids[lm.pull_target_index]);
	if target == null || target.player_state != Player_State.ALIVE {
		rr_lily_end_pull(player);
		return;
	}

	tree_pos := lm.pull_tree_entity.world_position;

	// Snap phase: fast drag to tree
	if lm.pull_snapping {
		dir := tree_pos - target.entity.world_position;
		dist := length(dir);
		if dist < 0.5 {
			// Arrived at tree — freeze them there
			nav_point: v2;
			triangle_hint: s64;
			try_find_closest_point_on_navmesh(tree_pos, ref nav_point, ref triangle_hint);
			target.entity.set_local_position(nav_point);
			target.add_freeze_reason(LILY_PULL_REASON);
			rr_lily_end_pull(player);

			if player.is_local_or_server() {
				Notifier.notify(player, format_string("% dragged to tree!", {target.get_username()}));
			}
			return;
		}
		move := normalize(dir) * LILY_PULL_SNAP_SPEED * dt;
		new_pos := target.entity.world_position + move;
		nav_point: v2;
		triangle_hint: s64;
		try_find_closest_point_on_navmesh(new_pos, ref nav_point, ref triangle_hint);
		target.entity.set_local_position(nav_point);
		return;
	}

	// Slow drag phase: lerp toward tree
	dir := tree_pos - target.entity.world_position;
	dist := length(dir);
	if dist > 0.1 {
		move := normalize(dir) * LILY_PULL_DRAG_SPEED * dt;
		new_pos := target.entity.world_position + move;
		nav_point: v2;
		triangle_hint: s64;
		try_find_closest_point_on_navmesh(new_pos, ref nav_point, ref triangle_hint);
		target.entity.set_local_position(nav_point);
	}
}

rr_lily_pull_complete :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.pull_active return;

	// Bar filled — snap target to tree quickly
	lm.pull_snapping = true;
}

rr_lily_end_pull :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.pull_active return;

	lm.pull_active = false;
	lm.pull_progress = 0.0;
	lm.pull_snapping = false;
	lm.pull_tree_entity = null;
}

rr_lily_pull_cycle_target :: proc(player: Player, direction: int) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.strung_player_ids.count == 0 return;

	lm.pull_target_index = (lm.pull_target_index + direction) % lm.strung_player_ids.count;
	if lm.pull_target_index < 0 {
		lm.pull_target_index = lm.strung_player_ids.count - 1;
	}

	target := get_player_by_entity_id(lm.strung_player_ids[lm.pull_target_index]);
	if target != null && player.is_local_or_server() {
		Notifier.notify(player, format_string("Target: %", {target.get_username()}));
	}
}

// =============================================================================
// Mind Control
// =============================================================================

// Forwards Lily's input to the controlled target each frame
Lily_Mind_Control_Puppet :: class : Component {
	lily_entity_id: u64;

	ao_update :: method(dt: float) {
		lily := get_player_by_entity_id(lily_entity_id);
		if lily == null return;
		lm := lily.entity.get_component(Lily_Module);
		if lm == null || !lm.mind_control_active return;

		p := entity.get_component(Player);
		if p == null return;
		if p.player_state != Player_State.ALIVE return;
		if lm.mind_control_target_id != p.entity.id return;

		// Forward Lily's input to the controlled player
		input := lily.agent.input_this_frame;
		p.agent.input_this_frame = input;
		if length_squared(input) > 0.01 {
			p.set_facing_right(input.x >= 0.0);
		}

		// Lily stays put — only the puppet moves
		lily.agent.input_this_frame = v2.{0, 0};

		// Draw "Mind Controlled!" banner at top of screen (below progress bar)
		if p.is_local_or_server() {
			screen := UI.get_screen_rect();
			banner := screen.top_rect().offset(0.0, -140.0).grow_bottom(40);
			ts := UI.default_text_settings();
			ts.size = 36;
			ts.halign = .CENTER;
			ts.valign = .CENTER;
			ts.color = v4.{0.8, 0.4, 1.0, 1.0};
			ts.do_outline = true;
			ts.outline_thickness = 3;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(banner, ts, "Mind Controlled!");
		}
	}

	ao_end :: method() {
		p := entity.get_component(Player);
		if p != null {
			p.remove_disable_movement_input_reason(LILY_MIND_CONTROL_PUPPET_REASON);
		}
	}
}

// =============================================================================
// String Trap
// =============================================================================

// Component on the trap entity — invisible to everyone except Lily, triggers on proximity.
Lily_String_Trap :: class : Component {
	lily_entity_id: u64;
	trap_animator: Spine_Animator;
	triggered: bool;
	trapped_player_id: u64;
	emerge_done_at: float;

	ao_start :: method() {
		triggered = false;
		trapped_player_id = 0;
	}

	// Visibility: only Lily can see the dormant trap
	apply_visibility :: method() {
		if trap_animator == null return;
		if trap_animator.instance == null return;
		if triggered {
			// Everyone sees the erupted hair
			trap_animator.instance.color_multiplier = v4.{1, 1, 1, 1};
			return;
		}
		local_player, ok := Game.get_local_player();
		if !ok {
			trap_animator.instance.color_multiplier = v4.{1, 1, 1, 0};
			return;
		}
		if local_player.entity.id == lily_entity_id {
			trap_animator.instance.color_multiplier = v4.{1, 1, 1, 0.5};
		} else {
			trap_animator.instance.color_multiplier = v4.{1, 1, 1, 0};
		}
	}

	ao_update :: method(dt: float) {
		apply_visibility();

		// After emerge animation, trigger rooted anim on victim and destroy trap
		if triggered && emerge_done_at > 0.0 && get_time() >= emerge_done_at {
			victim := get_player_by_entity_id(trapped_player_id);
			if victim != null {
				victim.set_trigger("lily_rooted_start");
			}
			entity.destroy();
			return;
		}

		if triggered return;

		// Proximity check — server triggers the trap
		if !Game.is_server() return;

		trap_pos := entity.world_position;
		for p: component_iterator(Player) {
			if p == null continue;
			if p.player_state != Player_State.ALIVE continue;
			if p.player_type == Player_Type.TRAITOR continue;
			if p.entity.id == lily_entity_id continue;

			dist := length(p.entity.world_position - trap_pos);
			if dist < LILY_STRING_TRAP_TRIGGER_RADIUS {
				rr_lily_trigger_string_trap(this, p);
				return;
			}
		}
	}

	ao_on_state_sync :: method() {
		apply_visibility();
	}
}

// Root effect on the trapped player
Lily_String_Trap_Root :: class : Component {
	lily_entity_id: u64;
	root_ends_at: float;
	active: bool;
	being_carried: bool;

	ao_start :: method() {
		active = true;
	}

	ao_update :: method(dt: float) {
		if !active return;
		if !Game.is_server() return;

		// Check expiry — only if not being dragged (time pauses during drag)
		if !being_carried {
			if get_time() >= root_ends_at {
				free();
				return;
			}
		}
	}

	free :: method() {
		if !active return;
		active = false;
		p := entity.get_component(Player);
		if p != null {
			p.remove_disable_movement_input_reason(LILY_STRING_TRAP_REASON);
			p.remove_disable_movement_input_reason(LILY_LIVE_DRAG_REASON);
			p.set_trigger("lily_rooted_end");
		}
	}

	ao_end :: method() {
		p := entity.get_component(Player);
		if p != null {
			p.remove_disable_movement_input_reason(LILY_STRING_TRAP_REASON);
			p.remove_disable_movement_input_reason(LILY_LIVE_DRAG_REASON);
		}
	}
}

rr_lily_trigger_string_trap :: proc(trap: Lily_String_Trap, victim: Player) {
	trap.triggered = true;
	trap.trapped_player_id = victim.entity.id;

	// Play eruption animation on the trap spine
	if trap.trap_animator != null && trap.trap_animator.instance != null {
		trap.trap_animator.instance.set_animation("emerge_at_exit_point", false, 0);
	}
	trap.emerge_done_at = get_time() + 1.0; // switch to idle loop after emerge

	// Root the victim (rooted animation starts when trap entity destroys after emerge)
	victim.add_disable_movement_input_reason(LILY_STRING_TRAP_REASON);

	root := victim.entity.get_component(Lily_String_Trap_Root);
	if root == null {
		root = victim.entity.add_component(Lily_String_Trap_Root);
	}
	root.lily_entity_id = trap.lily_entity_id;
	root.root_ends_at = get_time() + LILY_STRING_TRAP_ROOT_DURATION;
	root.active = true;
	root.being_carried = false;

	// SFX
	sfx := SFX.default_sfx_desc();
	sfx.entity_to_follow = trap.entity.id;
	sfx.volume = 0.5;
	rr_play_sfx(LILY_SFX_STRING_TRAP, sfx);

	// Notify Lily
	lily := get_player_by_entity_id(trap.lily_entity_id);
	if lily != null && lily.is_local_or_server() {
		Notifier.notify(lily, format_string("% caught in your string trap!", {victim.get_username()}));
	}
}

rr_lily_place_string_trap :: proc(player: Player, world_pos: v2) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	// Snap to navmesh
	nav_pt: v2;
	tri_hint: s64;
	try_find_closest_point_on_navmesh(world_pos, ref nav_pt, ref tri_hint);

	trap_e := Scene.create_entity();
	trap_e.set_local_position(nav_pt);
	trap_e.set_local_scale(v2.{1.2, 1.2});

	sa := trap_e.add_component(Spine_Animator);
	sa.awaken();
	if sa.instance != null {
		sa.instance.set_skeleton(get_asset(Spine_Asset, LILY_STRING_TRAP_RIG));
		sa.instance.set_animation("lair_node", true, 0);
	}

	trap := trap_e.add_component(Lily_String_Trap);
	trap.lily_entity_id = player.entity.id;
	trap.trap_animator = sa;

	if player.is_local_or_server() {
		Notifier.notify(player, "String Trap placed!");
	}
}

// Live drag helpers (mirrors GGG pattern — used by Drag_Body_Ability)
rr_lily_get_closest_draggable_trapped_player :: proc(player: Player) -> Player {
	if player == null return null;
	best_dist := 2.5;
	best: Player = null;
	for p: component_iterator(Player) {
		if p == null continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.player_type == Player_Type.TRAITOR continue;
		root := p.entity.get_component(Lily_String_Trap_Root);
		if root == null continue;
		if !root.active continue;
		if root.lily_entity_id != player.entity.id continue;
		dist := length(p.entity.world_position - player.entity.world_position);
		if dist < best_dist {
			best_dist = dist;
			best = p;
		}
	}
	return best;
}

rr_lily_start_live_drag :: proc(player: Player, target: Player) {
	if player == null return;
	if target == null return;
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	lm.dragging_live_player_id = target.entity.id;
	target.add_disable_movement_input_reason(LILY_LIVE_DRAG_REASON);

	root := target.entity.get_component(Lily_String_Trap_Root);
	if root != null root.being_carried = true;
}

rr_lily_stop_live_drag :: proc(player: Player) {
	if player == null return;
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.dragging_live_player_id == 0 return;
	target := get_player_by_entity_id(lm.dragging_live_player_id);
	if target != null && #alive(target.entity) {
		target.remove_disable_movement_input_reason(LILY_LIVE_DRAG_REASON);
		root := target.entity.get_component(Lily_String_Trap_Root);
		if root != null root.being_carried = false;
	}
	lm.dragging_live_player_id = 0;
}

rr_lily_update_live_drag :: proc(player: Player, dt: float) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.dragging_live_player_id == 0 return;

	target := get_player_by_entity_id(lm.dragging_live_player_id);
	if target == null || target.player_state != Player_State.ALIVE {
		lm.dragging_live_player_id = 0;
		return;
	}

	// Check if trap effect expired — stop drag
	root := target.entity.get_component(Lily_String_Trap_Root);
	if root == null || !root.active {
		rr_lily_stop_live_drag(player);
		return;
	}

	// Move victim to follow Lily (offset behind)
	player_pos := player.entity.world_position;
	target_pos := target.entity.world_position;
	follow_pos := player_pos;
	s := player.entity.local_scale;
	offset_x := -0.5;
	if s.x < 0.0 { offset_x = 0.5; }
	follow_pos.x = follow_pos.x + offset_x;

	new_pos := v2.{
		lerp(target_pos.x, follow_pos.x, 6.0 * dt),
		lerp(target_pos.y, follow_pos.y, 6.0 * dt),
	};
	target.entity.set_local_position(new_pos);
}

// Cleanup all string traps belonging to a Lily player
rr_lily_cleanup_string_traps :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm != null {
		rr_lily_stop_live_drag(player);
	}

	for trap: component_iterator(Lily_String_Trap) {
		if trap == null continue;
		if trap.lily_entity_id == player.entity.id {
			// Free trapped player if any
			if trap.trapped_player_id != 0 {
				victim := get_player_by_entity_id(trap.trapped_player_id);
				if victim != null {
					root := victim.entity.get_component(Lily_String_Trap_Root);
					if root != null root.free();
				}
			}
			trap.entity.destroy();
		}
	}
}

MAX_MIND_CONTROL_PICKER_TARGETS :: 8;

rr_lily_draw_mind_control_picker :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	// Collect valid targets
	target_players: [MAX_MIND_CONTROL_PICKER_TARGETS]Player;
	target_count: s64 = 0;
	for target: component_iterator(Player) {
		if target == null continue;
		if target.entity.id == player.entity.id continue;
		if target.player_state != Player_State.ALIVE continue;
		if target.player_type == Player_Type.TRAITOR continue;
		if target_count >= MAX_MIND_CONTROL_PICKER_TARGETS break;
		target_players[target_count] = target;
		target_count += 1;
	}

	if target_count == 0 {
		lm.mind_control_picking = false;
		return;
	}

	UIK.begin(UIK.modal(UIK.rect_window_small(), 15));

	shell := UIK.panel_modal(.BLUE_WITH_FOOTER);
	UIK.panel_begin(shell);

	title_desc := UIK.title_area_desc("Mind Control");
	title_desc.style = .NONE;
	exit_handle := UIK.title_area(title_desc);

	UIK.spacer(UIK.pixels(1), UIK.pixels(4));
	UIK.text("Choose a player to control:", UIK.text_body());
	UIK.spacer(UIK.pixels(1), UIK.pixels(8));

	list_panel := UIK.layout_column();
	list_panel.width = UIK.flex(1);
	list_panel.height = UIK.flex(1);
	list_panel.gap = 6;
	UIK.list_begin("mc_pick_list", list_panel);

	handles: [MAX_MIND_CONTROL_PICKER_TARGETS]UIK.Interact_Handle;
	for i: 0..target_count - 1 {
		desc := UIK.widget_desc_button_auto_default(.BUTTON_BASIC_GREY);
		desc.panel.width = UIK.flex(1);
		desc.panel.height = UIK.pixels(70);
		handles[i] = UIK.button(format_string("mc_pick_%", {i}), target_players[i].get_username(), desc);
	}

	UIK.list_end();
	UIK.panel_end();
	UIK.end();

	if UIK.clicked(exit_handle) {
		lm.mind_control_picking = false;
		return;
	}

	for i: 0..target_count - 1 {
		if UIK.clicked(handles[i]) {
			lm.mind_control_picking = false;
			rr_lily_start_mind_control(player, target_players[i]);
			cd_mult := lm.tree_cd_multiplier;
			// Cooldown is applied via the ability — just start it here
			return;
		}
	}
}

rr_lily_start_mind_control :: proc(player: Player, target: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if target == null return;

	lm.mind_control_active = true;
	lm.mind_control_ends_at = get_time() + LILY_MIND_CONTROL_DURATION;
	lm.mind_control_target_id = target.entity.id;

	// Block target's own input — Lily's input is forwarded via the Puppet component
	target.add_disable_movement_input_reason(LILY_MIND_CONTROL_PUPPET_REASON);

	// Lily keeps her own movement during mind control

	// Add input forwarding component
	existing := target.entity.get_component(Lily_Mind_Control_Puppet);
	if existing == null {
		mc := target.entity.add_component(Lily_Mind_Control_Puppet);
		mc.lily_entity_id = player.entity.id;
	}

	// Spawn braid on target for visual feedback
	rr_lily_spawn_braid_on_target(target, player.entity.id);
	braid := target.entity.get_component(Lily_String_Braid);
	if braid != null braid.trigger("control_start");

	if Game.is_server() {
		sfx := SFX.default_sfx_desc();
		sfx.entity_to_follow = player.entity.id;
		sfx.volume = 0.4;
		rr_play_sfx(LILY_SFX_DOLLHOUSE, sfx);
	}

	rr_lily_creature_trigger(player, "control_start");

	if player.is_local_or_server() {
		Notifier.notify(player, format_string("Mind controlling %!", {target.get_username()}));
	}
}

rr_lily_update_mind_control :: proc(player: Player, dt: float) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.mind_control_active return;

	now := get_time();
	if now >= lm.mind_control_ends_at {
		rr_lily_end_mind_control(player);
		return;
	}

	// Validate target is still alive
	target := get_player_by_entity_id(lm.mind_control_target_id);
	if target == null || target.player_state != Player_State.ALIVE {
		rr_lily_end_mind_control(player);
		return;
	}

	// Input forwarding handled in Lily_Mind_Control_Puppet.ao_update

	// Lily's camera and LOS follow the puppet
	if player.is_local() {
		player.camera.follow_player = false;
		player.camera.position = target.entity.world_position;

		// Unparent light and set world position directly (avoids parent scale flip issues)
		if player.local_light_entity != null && #alive(player.local_light_entity) {
			player.local_light_entity.set_parent(null, true);
			player.local_light_entity.set_local_position(target.entity.world_position);
		}
	}

	// Check if target is near the tree — auto-deliver for Alive Player request
	if lm.hair_tree_entity != null && #alive(lm.hair_tree_entity) {
		tree_pos := lm.hair_tree_entity.world_position;
		tree_dist := length(target.entity.world_position - tree_pos);
		if tree_dist <= LILY_TREE_DELIVER_RANGE {
			tree_comp := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
			if tree_comp != null {
				request, has_request := tree_comp.get_current_request();
				can_deliver_alive := has_request && request == Tree_Request.ALIVE_PLAYER;
				can_deliver_no_parts := has_request && request == Tree_Request.LIVE_PLAYER_NO_PARTS && target.lily_no_eyes && target.lily_crawling;
				if can_deliver_alive || can_deliver_no_parts {
					// Deliver alive player to tree
					target.kill_with_killer_no_corpse(player.entity.id);
					lm.kills += 1;
					tree_comp.fulfill_request();
					rr_lily_apply_tree_buffs(player);
					if player.is_local_or_server() {
						Notifier.notify(player, format_string("% delivered to the tree!", {target.get_username()}));
						if tree_comp.fulfilled_count >= LILY_DEATHBRAID_THRESHOLD {
							Notifier.notify(player, "All requests fulfilled — Deathbraid is ready!");
						} else {
							request_name := rr_lily_get_request_name(tree_comp);
							Notifier.notify(player, format_string("Request fulfilled! Next: %", {request_name}));
						}
					}
					rr_lily_end_mind_control(player);
					return;
				}
			}
		}
	}

	// Mind Control camera UI
	if player.is_local() {
		rr_lily_draw_mind_control_ui(player);
	}
}

// Draw Mind Control overlay — timer + controlled player name
rr_lily_draw_mind_control_ui :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	screen := UI.get_safe_screen_rect();
	UI.push_layer(150);
	defer UI.pop_layer();

	top_bar := screen.top_rect().offset(0.0, -80.0).grow_bottom(50);
	UI.quad(top_bar, core_globals.white_sprite, v4.{0.0, 0.0, 0.0, 0.7});

	// Timer
	remaining := lm.mind_control_ends_at - get_time();
	if remaining < 0.0 remaining = 0.0;
	ts := UI.default_text_settings();
	ts.size = 20;
	ts.halign = .RIGHT;
	ts.valign = .CENTER;
	ts.color = v4.{1.0, 0.8, 0.2, 1.0};
	ts.do_outline = true;
	ts.outline_thickness = 2;
	ts.outline_color = v4.{0, 0, 0, 1};
	timer_rect := top_bar.inset(5.0, 10.0, 5.0, 10.0);
	UI.text(timer_rect, ts, "%s", {format_float(remaining, decimals=0)});

	// "Mind Control: [name]" label
	target := get_player_by_entity_id(lm.mind_control_target_id);
	label_ts := UI.default_text_settings();
	label_ts.size = 22;
	label_ts.halign = .CENTER;
	label_ts.valign = .CENTER;
	label_ts.color = v4.{0.8, 0.4, 1.0, 1.0};
	label_ts.do_outline = true;
	label_ts.outline_thickness = 2;
	label_ts.outline_color = v4.{0, 0, 0, 1};
	if target != null {
		UI.text(top_bar, label_ts, "Mind Control: %", {target.get_username()});
	}
}

rr_lily_end_mind_control :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.mind_control_active return;

	// Release target
	target := get_player_by_entity_id(lm.mind_control_target_id);
	if target != null {
		target.remove_disable_movement_input_reason(LILY_MIND_CONTROL_PUPPET_REASON);

		// Remove braid visual — component lives on a child entity
		child := target.entity.get_first_child();
		while child != null {
			next := child.get_next_sibling();
			braid := child.get_component(Lily_String_Braid);
			if braid != null {
				child.destroy();
			}
			child = next;
		}
	}

	// Restore Lily's camera and LOS
	player.camera.follow_player = true;
	if player.local_light_entity != null && #alive(player.local_light_entity) {
		player.local_light_entity.set_parent(player.entity, false);
		player.local_light_entity.set_local_position(v2.{0, 0});
	}

	lm.mind_control_active = false;
	lm.mind_control_target_id = 0;

	rr_lily_creature_trigger(player, "control_end");
}

// Called when Lily is killed — break mind control
rr_lily_on_lily_killed :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.mind_control_active {
		rr_lily_end_mind_control(player);
	}
	if lm.dragging_live_player_id != 0 {
		rr_lily_stop_live_drag(player);
	}
	if lm.spider_active {
		rr_lily_end_spider(player, false);
	}
	if lm.eye_machine_active {
		rr_lily_end_eye_machine(player);
	}
}

// =============================================================================
// Passives
// =============================================================================

rr_lily_update_passives :: proc(player: Player, dt: float) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	// Thread Count: +3% speed per active string
	string_count := lm.strung_player_ids.count;
	new_multiplier := 1.0 + (string_count.(float) * LILY_THREAD_COUNT_SPEED_PER_STRING);

	if lm.thread_speed_active && lm.thread_speed_multiplier != new_multiplier {
		// Remove old bonus, apply new
		player.agent.movement_speed = player.agent.movement_speed / lm.thread_speed_multiplier;
		if new_multiplier > 1.0 {
			player.agent.movement_speed = player.agent.movement_speed * new_multiplier;
			lm.thread_speed_multiplier = new_multiplier;
		} else {
			lm.thread_speed_active = false;
			lm.thread_speed_multiplier = 1.0;
		}
	} else if !lm.thread_speed_active && new_multiplier > 1.0 {
		lm.thread_speed_active = true;
		lm.thread_speed_multiplier = new_multiplier;
		player.agent.movement_speed = player.agent.movement_speed * new_multiplier;
	}
}

// =============================================================================
// Web Sense — draw directional arrows toward strung players
// =============================================================================

rr_lily_draw_web_sense :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !player.is_local() return;
	if lm.strung_player_ids.count == 0 return;

	options := Tutorial_Arrow.default_options();
	options.alpha = 0.5;
	options.far = true;
	options.near = false;
	options.bob_scale = 0.3;
	options.bob_bias = 1.2;

	// Hide arrows during tea party
	lm_check := player.entity.get_component(Lily_Module);
	if lm_check != null && lm_check.tea_party_active return;

	// Purple tint for Lily's web sense arrows
	UI.push_color_multiplier(v4.{0.7, 0.3, 1.0, 1.0});
	defer UI.pop_color_multiplier();

	for i: 0..lm.strung_player_ids.count-1 {
		target := get_player_by_entity_id(lm.strung_player_ids[i]);
		if target == null continue;
		if target.player_state != Player_State.ALIVE continue;

		target_pos := target.entity.world_position;
		Tutorial_Arrow.draw(player, target_pos, options);

		// Draw name next to the arrow (replicate arrow positioning)
		max_distance := player.camera.size * 0.8;
		offset_to_target := normalize_vector_to_radius(target_pos - player.entity.world_position, max_distance) * max_distance;
		arrow_pos := player.entity.world_position + offset_to_target;

		is_far := length_squared(arrow_pos - target_pos) > 0.1;

		UI.push_world_draw_context();
		defer UI.pop_draw_context();
		UI.push_layer(101);
		defer UI.pop_layer();
		UI.push_z(target_pos.y);
		defer UI.pop_z();
		UI.push_color_multiplier(v4.{1, 1, 1, options.alpha});
		defer UI.pop_color_multiplier();

		name_ts := UI.default_text_settings();
		name_ts.size = 0.22;
		name_ts.halign = .CENTER;
		name_ts.valign = .CENTER;
		name_ts.color = v4.{1.0, 0.6, 0.8, 1.0};
		name_ts.do_outline = true;
		name_ts.outline_thickness = 1;
		name_ts.outline_color = v4.{0, 0, 0, 1};

		if is_far {
			name_pos := arrow_pos + v2.{0, -0.7};
			name_rect := Rect{name_pos, name_pos}.grow(0.15, 1.5, 0.15, 1.5);
			UI.text(name_rect, name_ts, "%", {target.get_username()});
		}
	}
}

// =============================================================================
// Deathbraid Grand Finale
// =============================================================================

// Tendril — grows outward from center along a random angle
Lily_Deathbraid_Tendril :: class : Component {
	angle: float;
	max_dist: float;
	max_scale: float;
	grow_duration: float;
	start_time: float;

	ao_update :: method(dt: float) {
		t := (get_time() - start_time) / grow_duration;
		if t > 1.0 t = 1.0;

		// Grow outward from center
		dist := t * max_dist;
		entity.set_local_position(v2.{cos(angle) * dist, sin(angle) * dist});

		// Scale up
		s := 0.5 + t * (max_scale - 0.5);
		entity.set_local_scale(v2.{s, s});
	}
}

LILY_DEATHBRAID_FREEZE_PHASE :: 2.0;   // freeze + camera zoom
LILY_DEATHBRAID_GROUND_PHASE :: 4.0;   // ground hair + mouth spawn
LILY_DEATHBRAID_SUCK_PHASE :: 7.0;     // suck in players
LILY_DEATHBRAID_KILL_PHASE :: 8.0;     // kill all

rr_lily_trigger_deathbraid :: proc(player: Player, tree_entity: Entity) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.deathbraid_active return;

	lm.deathbraid_active = true;
	lm.deathbraid_tree_entity = tree_entity;
	lm.deathbraid_start_time = get_time();

	// Freeze ALL players
	for p: component_iterator(Player) {
		if p == null continue;
		if p.player_state != Player_State.ALIVE continue;
		p.add_freeze_reason(LILY_DEATHBRAID_REASON);
	}

	// Spawn mouth immediately
	tree_pos := tree_entity.world_position;
	mouth_entity := Scene.create_entity();
	mouth_entity.set_local_position(tree_pos);
	mouth_entity.set_local_scale(v2.{1.5, 1.5});

	mouth_anim := mouth_entity.add_component(Spine_Animator);
	mouth_anim.depth_offset = 1.0; // Render below players (0) but above ground hair (2.0)
	mouth_anim.awaken();
	mouth_rig := get_asset(Spine_Asset, rr_lily_get_mouth_rig_path());
	if mouth_anim.instance != null && mouth_rig != null {
		mouth_anim.instance.set_skeleton(mouth_rig);
		mouth_anim.instance.set_animation("idle", true, 0);
		rr_apply_shadow_mask(mouth_anim.instance);
	}
	lm.deathbraid_mouth_entity = mouth_entity;

	// Ground hair spawns later in update (after FREEZE_PHASE)

	if player.is_local_or_server() {
		Notifier.notify(player, "DEATHBRAID ACTIVATED!");
	}
}

rr_lily_update_deathbraid :: proc(player: Player, dt: float) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.deathbraid_active return;

	elapsed := get_time() - lm.deathbraid_start_time;
	tree_pos := v2.{0, 0};
	if lm.deathbraid_tree_entity != null && #alive(lm.deathbraid_tree_entity) {
		tree_pos = lm.deathbraid_tree_entity.world_position;
	}

	// Hair tendril growth handled by Lily_Deathbraid_Tendril components

	// Focus point — on mouth if spawned, otherwise on tree
	focus_pos := tree_pos;
	if lm.deathbraid_mouth_entity != null && #alive(lm.deathbraid_mouth_entity) {
		focus_pos = lm.deathbraid_mouth_entity.world_position;
	}

	// Camera + LOS — only set for the local player to avoid flickering
	if player.is_local_or_server() {
		player.camera.follow_player = false;
		player.camera.position = focus_pos;
		camera_size := lerp(player.camera.size, 8.0, min(elapsed * 0.5, 1.0));
		player.camera.size = camera_size;

		if player.local_light_entity != null && #alive(player.local_light_entity) {
			player.local_light_entity.set_parent(null, true);
			player.local_light_entity.set_local_position(focus_pos);
		}
	}

	// Phase 2: Spawn ground hair tendrils (after freeze phase, mouth already visible)
	if elapsed >= LILY_DEATHBRAID_FREEZE_PHASE && lm.deathbraid_ground_entity == null {
		ground_parent := Scene.create_entity();
		ground_parent.set_local_position(focus_pos);
		ground_parent.set_local_scale(v2.{1.0, 1.0});

		hair_tex := get_asset(Texture_Asset, "sprites/Hair_on_ground.png");
		rng: u64 = rng_seed_time();

		for h: 0..7 {
			hair_entity := Scene.create_entity();
			hair_entity.set_parent(ground_parent, false);
			hair_entity.set_local_position(v2.{0, 0});
			hair_entity.set_local_scale(v2.{0.5, 0.5});

			angle := rng_range_float(ref rng, 0.0, 6.283);
			hair_entity.set_local_rotation(angle * 57.2958);

			hair_sprite := hair_entity.add_component(Sprite_Renderer);
			hair_sprite.set_texture(hair_tex);
			hair_sprite.color = v4.{1, 1, 1, 1};
			hair_sprite.depth_offset = 2.0; // Below mouth (-1.0), on ground level

			tendril := hair_entity.add_component(Lily_Deathbraid_Tendril);
			tendril.angle = angle;
			tendril.max_dist = rng_range_float(ref rng, 4.0, 8.0);
			tendril.max_scale = rng_range_float(ref rng, 3.0, 5.0);
			tendril.grow_duration = LILY_DEATHBRAID_GROUND_PHASE - LILY_DEATHBRAID_FREEZE_PHASE;
			tendril.start_time = get_time();
		}

		lm.deathbraid_ground_entity = ground_parent;
	}

	// Phase 3: Suck in all alive players + play pull anim
	if elapsed >= LILY_DEATHBRAID_GROUND_PHASE {
		suck_progress := (elapsed - LILY_DEATHBRAID_GROUND_PHASE) / (LILY_DEATHBRAID_SUCK_PHASE - LILY_DEATHBRAID_GROUND_PHASE);
		if suck_progress > 1.0 suck_progress = 1.0;

		// Set pull anim + spawn braids once at start of suck phase
		just_started := (elapsed - dt) < LILY_DEATHBRAID_GROUND_PHASE;

		for p: component_iterator(Player) {
			if p == null continue;
			if p.player_state != Player_State.ALIVE continue;
			if p.player_type == Player_Type.TRAITOR continue;

			if just_started {
				p.set_trigger("lily_pull_start");
				// Spawn braid on players that don't already have one
				rr_lily_spawn_braid_on_target(p, player.entity.id);
			}

			// Move directly toward mouth center (ignore navmesh/walls)
			current := p.entity.world_position;
			new_pos := lerp(current, focus_pos, suck_progress * 0.1);
			p.entity.set_local_position(new_pos);
		}
	}

	// Phase 4: Kill all non-traitors
	if elapsed >= LILY_DEATHBRAID_KILL_PHASE {
		for p: component_iterator(Player) {
			if p == null continue;
			if p.player_state != Player_State.ALIVE continue;
			if p.player_type == Player_Type.TRAITOR continue;
			p.kill_with_killer(player.entity.id);
		}

		rr_lily_end_deathbraid(player);
	}
}

rr_lily_end_deathbraid :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.deathbraid_active return;

	lm.deathbraid_active = false;

	// Unfreeze all players, restore camera and LOS light
	for p: component_iterator(Player) {
		if p == null continue;
		p.remove_freeze_reason(LILY_DEATHBRAID_REASON);
		if p.is_local_or_server() {
			p.camera.follow_player = true;
		}
		if p.local_light_entity != null && #alive(p.local_light_entity) {
			p.local_light_entity.set_parent(p.entity, false);
			p.local_light_entity.set_local_position(v2.{0, 0});
		}
	}

	// Clean up entities (delayed destroy for visual)
	if lm.deathbraid_mouth_entity != null && #alive(lm.deathbraid_mouth_entity) {
		delayed := lm.deathbraid_mouth_entity.add_component(Lily_Delayed_Destroy);
		delayed.destroy_at = get_time() + 2.0;
	}
	lm.deathbraid_mouth_entity = null;

	if lm.deathbraid_ground_entity != null && #alive(lm.deathbraid_ground_entity) {
		delayed := lm.deathbraid_ground_entity.add_component(Lily_Delayed_Destroy);
		delayed.destroy_at = get_time() + 2.0;
	}
	lm.deathbraid_ground_entity = null;
	lm.deathbraid_tree_entity = null;
}

// =============================================================================
// Main Update
// =============================================================================

rr_lily_update :: proc(player: Player, dt: float) {
	if player == null return;
	if player.player_role != Player_Role.LILY_LOVEBRAIDS || player.player_type != Player_Type.TRAITOR return;

	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	now := get_time();

	// Dead Lily reverts
	if player.player_state != Player_State.ALIVE {
		if lm.is_lily_form || lm.creature_visible {
			rr_lily_force_revert(player);
		}
		return;
	}

	// Meetings: defer visual revert until teleport
	if game_state != Game_State.INGAME return;

	// Delayed skeleton swap (after transform animation)
	if lm.skeleton_swap_at > 0.0 && now >= lm.skeleton_swap_at {
		lm.skeleton_swap_at = 0.0;
		if lm.is_lily_form && !lm.creature_visible {
			rr_lily_swap_to_creature(player);
		}
	}

	// Hair tree teleport cooldown
	if lm.tree_teleport_cooldown > 0.0 {
		lm.tree_teleport_cooldown -= dt;
		if lm.tree_teleport_cooldown < 0.0 {
			lm.tree_teleport_cooldown = 0.0;
		}
	}

	// Clean up dead strung players
	i := 0;
	while i < lm.strung_player_ids.count {
		target_id := lm.strung_player_ids[i];
		target := get_player_by_entity_id(target_id);
		if target == null || target.player_state != Player_State.ALIVE {
			rr_lily_remove_string(player, target_id);
		} else {
			i += 1;
		}
	}

	// Update active abilities
	rr_lily_update_tea_party(player, dt);
	rr_lily_update_mind_control(player, dt);
	rr_lily_update_pull(player, dt);
	rr_lily_update_live_drag(player, dt);
	rr_lily_update_deathbraid(player, dt);
	rr_lily_update_spider(player, dt);
	rr_lily_update_eye_machine(player, dt);

	// Passives
	rr_lily_update_passives(player, dt);

	// Update creature locomotion anims
	rr_lily_update_creature_anims(player, dt);

	// Braid locomotion sync on all strung players
	rr_lily_update_all_braids(player);

	// Mind control player picker (local only UI)
	if lm.mind_control_picking && player.is_local_or_server() {
		rr_lily_draw_mind_control_picker(player);
	}

	// Web sense arrows (local only UI)
	rr_lily_draw_web_sense(player);

	// Braid points HUD (local only UI)
	rr_lily_draw_hud(player);

	// Spider return timer
	rr_lily_draw_spider_timer(player);

	// World-space request icon above tree
	rr_lily_draw_tree_request_icon(player);
}

// =============================================================================
// Abilities
// =============================================================================

// --- Kill ---
Lily_Kill_Ability :: class : Ability_Base {
	NAME :: "Kill";

	on_init :: proc(instance: Lily_Kill_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Standard_Kill_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;
		if get_time() < post_meeting_kill_lockout_ends_at return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if lm.tea_party_active return false;
		return get_closest_kill_target(this, player) != null;
	}

	get_closest_kill_target :: proc(instance: Lily_Kill_Ability, player: Player) -> Player {
		lm := player.entity.get_component(Lily_Module);
		kill_range := LILY_KILL_RANGE_SCHLEEM;
		if lm != null && lm.is_lily_form {
			kill_range = LILY_KILL_RANGE_LILY;
		}

		// During Mind Control, search from puppet position
		search_pos := player.entity.world_position;
		if lm != null && lm.mind_control_active {
			puppet := get_player_by_entity_id(lm.mind_control_target_id);
			if puppet != null {
				search_pos = puppet.entity.world_position;
			}
		}

		finder := make_finder(Player, search_pos, kill_range);
		for target: component_iterator(Player) {
			if target == null continue;
			if target.entity.id == player.entity.id continue;
			if target.player_state != Player_State.ALIVE continue;
			if target.player_type == Player_Type.TRAITOR continue;
			// During Mind Control, don't target the controlled player
			if lm != null && lm.mind_control_active && target.entity.id == lm.mind_control_target_id continue;
			finder.check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		lockout_remaining := post_meeting_kill_lockout_ends_at - get_time();
		if lockout_remaining < 0.0 lockout_remaining = 0.0;
		current_cooldown = max(current_cooldown, lockout_remaining);

		if params.clicked && params.can_use {
			closest := get_closest_kill_target(this, player);
			if closest != null {
				lm := player.entity.get_component(Lily_Module);

				// During Mind Control, play attack anim on puppet — other players see the puppet commit the kill
				if lm != null && lm.mind_control_active {
					puppet := get_player_by_entity_id(lm.mind_control_target_id);
					if puppet != null {
						puppet.set_facing_right(closest.entity.world_position.x > puppet.entity.world_position.x);
						puppet.set_trigger("traitor_kill");
					}
				} else if lm != null && lm.is_lily_form {
					player.set_facing_right(closest.entity.world_position.x > player.entity.world_position.x);
					rr_lily_creature_trigger(player, "action");
					player.set_trigger("lily_kill");
				} else {
					player.set_facing_right(closest.entity.world_position.x > player.entity.world_position.x);
					player.set_trigger("lily_kill");
				}

				closest.kill_with_killer(player.entity.id);

				cd_mult := 1.0;
				if lm != null cd_mult = lm.tree_cd_multiplier;
				current_cooldown = LILY_KILL_COOLDOWN * cd_mult;

				if Game.is_server() {
					sfx := SFX.default_sfx_desc();
					sfx.set_position(closest.entity.world_position);
					sfx.volume = 0.25;
					rr_play_sfx(LILY_SFX_KILL, sfx);
				}
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		lm := player.entity.get_component(Lily_Module);
		if lm != null && lm.is_lily_form {
			icon = get_asset(Texture_Asset, "sprites/icons/lily/Lily_Bun_Angry_Icon.png");
		} else {
			icon = get_asset(Texture_Asset, "sprites/icons/lily/Standard_Kill_Icon.png");
		}
		draw_ability_name_label(rect, Lily_Kill_Ability.NAME);
	}
}

// --- Transform ---
Lily_Transform_Ability :: class : Ability_Base {
	NAME :: "Transform";

	on_init :: proc(instance: Lily_Transform_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if lm.mind_control_active return false;
		if lm.tea_party_active return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			lm := player.entity.get_component(Lily_Module);
			if lm == null return;

			if lm.is_lily_form {
				// Revert to schleem
				lm.is_lily_form = false;
				lm.skeleton_swap_at = 0.0;
				if lm.lily_speed_active {
					lm.lily_speed_active = false;
					player.agent.movement_speed = player.agent.movement_speed / LILY_LILY_SPEED_MULTIPLIER;
				}
				rr_lily_swap_to_player(player);
				player.set_trigger("lily_revert");
				player.remove_disable_movement_input_reason(LILY_TRANSFORM_LOCK_REASON);
				player.add_disable_movement_input_reason(LILY_TRANSFORM_LOCK_REASON);

				if Game.is_server() {
					sfx_desc := SFX.default_sfx_desc();
					sfx_desc.entity_to_follow = player.entity.id;
					sfx_desc.volume = 0.5;
					rr_play_sfx(LILY_SFX_TRANSFORM_BACK, sfx_desc);
				}

				lock := player.entity.get_component(Lily_Transform_Lock);
				if lock == null {
					lock = player.entity.add_component(Lily_Transform_Lock);
				}
				lock.end_time = get_time() + LILY_TRANSFORM_ANIM_SECONDS;
				lock.player_entity_id = player.entity.id;
				lock.active = true;
			} else {
				// Transform to Lily (110% speed)
				rr_drag_body_force_drop_for_player(player);
				lm.is_lily_form = true;
				player.set_trigger("lily_transform");
				player.remove_disable_movement_input_reason(LILY_TRANSFORM_LOCK_REASON);
				player.add_disable_movement_input_reason(LILY_TRANSFORM_LOCK_REASON);
				lm.skeleton_swap_at = get_time() + LILY_TRANSFORM_ANIM_SECONDS;

				if Game.is_server() {
					sfx_desc := SFX.default_sfx_desc();
					sfx_desc.entity_to_follow = player.entity.id;
					sfx_desc.volume = 0.5;
					rr_play_sfx(LILY_SFX_TRANSFORM, sfx_desc);
				}

				lock := player.entity.get_component(Lily_Transform_Lock);
				if lock == null {
					lock = player.entity.add_component(Lily_Transform_Lock);
				}
				lock.end_time = get_time() + LILY_TRANSFORM_ANIM_SECONDS;
				lock.player_entity_id = player.entity.id;
				lock.active = true;
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		lm := player.entity.get_component(Lily_Module);
		if lm != null && lm.is_lily_form {
			icon = get_asset(Texture_Asset, "sprites/icons/transform_good.png");
		} else {
			icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png");
		}
		draw_ability_name_label(rect, Lily_Transform_Ability.NAME);
	}
}

Lily_Transform_Lock :: class : Component {
	end_time: float;
	player_entity_id: u64;
	active: bool;

	ao_update :: method(dt: float) {
		if !active return;
		if get_time() >= end_time {
			active = false;
			p := get_player_by_entity_id(player_entity_id);
			if p != null {
				p.remove_disable_movement_input_reason(LILY_TRANSFORM_LOCK_REASON);

				// Apply lily speed bonus
				lm := p.entity.get_component(Lily_Module);
				if lm != null && lm.is_lily_form && !lm.lily_speed_active {
					lm.lily_speed_active = true;
					p.agent.movement_speed = p.agent.movement_speed * LILY_LILY_SPEED_MULTIPLIER;
				}
			}
		}
	}
}

// --- Plant Tree (one-time use — Lily's permanent base) ---
Lily_Hair_Tree_Ability :: class : Ability_Base {
	NAME :: "Plant Tree";

	on_init :: proc(instance: Lily_Hair_Tree_Ability) {
		// [ART] swap icon for plant/sapling icon later
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Hair_Tree_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		// Already planted — one-time use
		if lm.hair_tree_planted return false;
		// Schleem form only
		if lm.is_lily_form return false;
		if lm.mind_control_active return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_lily_place_hair_tree(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Hair_Tree_Ability.NAME);
	}
}

// --- String ---
Lily_String_Ability :: class : Ability_Base {
	NAME :: "String";

	on_init :: proc(instance: Lily_String_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/String_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		// Schleem form only
		if lm.is_lily_form return false;
		if lm.mind_control_active return false;

		return get_closest_string_target(this, player) != null;
	}

	get_closest_string_target :: proc(instance: Lily_String_Ability, player: Player) -> Player {
		finder := make_finder(Player, player.entity.world_position, LILY_STRING_RANGE);
		for target: component_iterator(Player) {
			if target == null continue;
			if target.entity.id == player.entity.id continue;
			if target.player_state != Player_State.ALIVE continue;
			if target.player_type == Player_Type.TRAITOR continue;
			finder.check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			closest := get_closest_string_target(this, player);
			if closest != null {
				lm := player.entity.get_component(Lily_Module);
				if lm == null return;

				// Toggle: if already strung, remove string
				if rr_lily_is_player_strung(player, closest.entity.id) {
					rr_lily_remove_string(player, closest.entity.id);
					rr_lily_remove_braid_from_target(closest);
					if player.is_local_or_server() {
						Notifier.notify(player, format_string("String removed from %", {closest.get_username()}));
					}
				} else {
					// Attach string — target gets NO notification
					rr_lily_add_string(player, closest.entity.id);
					rr_lily_spawn_braid_on_target(closest, player.entity.id);
					if player.is_local_or_server() {
						Notifier.notify(player, format_string("String attached to %", {closest.get_username()}));
					}
				}

				current_cooldown = LILY_STRING_COOLDOWN * lm.tree_cd_multiplier;

				if Game.is_server() {
					sfx := SFX.default_sfx_desc();
					sfx.entity_to_follow = player.entity.id;
					sfx.volume = 0.15;
					rr_play_sfx(LILY_SFX_STRING, sfx);
				}
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		lm := player.entity.get_component(Lily_Module);
		if lm != null {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .RIGHT;
			ts.valign = .BOTTOM;
			UI.text(rect.inset(5), ts, "%", {lm.strung_player_ids.count});
		}
		draw_ability_name_label(rect, Lily_String_Ability.NAME);
	}
}

// Pull interactable is added to each tree via Lily_Tree_Pull_Interactable (see Hair Tree section)

// =============================================================================
// Spider (Leg Steal)
// =============================================================================

// Spawns the spider entity at the tree position and starts spider control mode.
rr_lily_spawn_spider :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.spider_active return;
	if lm.hair_tree_entity == null || !#alive(lm.hair_tree_entity) return;

	tree_pos := lm.hair_tree_entity.world_position;

	// Create spider entity at tree
	se := Scene.create_entity();
	se.set_local_position(tree_pos);
	se.set_local_scale(v2.{1, 1});
	se.set_local_rotation(0.0);

	sa := se.add_component(Spine_Animator);
	sa.awaken();
	spider_rig := get_asset(Spine_Asset, rr_lily_get_spider_rig_path());
	if sa.instance != null && spider_rig != null {
		sa.instance.set_skeleton(spider_rig);
		sa.instance.set_skin("base");
		sa.instance.set_animation("idle", true, 0);
		rr_apply_shadow_mask(sa.instance);
	}

	// Add spider component for per-frame logic
	spider_comp := se.add_component(Lily_Spider);
	spider_comp.lily_entity_id = player.entity.id;

	lm.spider_entity = se;
	lm.spider_animator = sa;
	lm.spider_active = true;
	lm.spider_has_legs = false;
	lm.spider_victim_id = 0;
	lm.spider_return_deadline = 0.0;
	lm.spider_attack_cooldown = 0.0;

	// Lily's input is forwarded to the spider then zeroed each frame (like mind control).
	// Don't use add_disable_movement_input_reason — it prevents input from being read.

	if player.is_local_or_server() {
		Notifier.notify(player, "Spider deployed! Find a victim...");
	}
}

// End spider mode, destroy spider entity, unfreeze Lily.
rr_lily_end_spider :: proc(player: Player, delivered: bool) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.spider_active return;

	// Destroy spider entity
	if lm.spider_entity != null && #alive(lm.spider_entity) {
		lm.spider_entity.destroy();
	}
	lm.spider_entity = null;
	lm.spider_animator = null;

	// Restore Lily's camera and LOS
	if player.is_local() {
		player.camera.follow_player = true;
		if player.local_light_entity != null && #alive(player.local_light_entity) {
			player.local_light_entity.set_parent(player.entity, false);
			player.local_light_entity.set_local_position(v2.{0, 0});
		}
	}

	// If spider had legs but didn't deliver, legs are lost
	if lm.spider_has_legs && !delivered {
		// Restore victim's legs
		victim := get_player_by_entity_id(lm.spider_victim_id);
		if victim != null {
			rr_lily_restore_legs(victim);
		}
		lm.carrying_legs = false;
		lm.stolen_legs_from_id = 0;
		if player.is_local_or_server() {
			Notifier.notify(player, "Spider didn't return in time — legs lost!");
		}
	}

	lm.spider_active = false;
	lm.spider_has_legs = false;
	lm.spider_victim_id = 0;
	lm.spider_return_deadline = 0.0;
}

// Apply crawl effect to a victim (40% speed, crawl animation).
rr_lily_apply_crawl :: proc(victim: Player) {
	if victim == null return;
	if victim.lily_crawling return; // already crawling
	victim.lily_crawl_speed_saved = victim.agent.movement_speed;
	victim.agent.movement_speed = victim.lily_crawl_speed_saved * LILY_CRAWL_SPEED_MULTIPLIER;
	victim.lily_crawling = true;
}

// Remove crawl effect, restore speed.
rr_lily_restore_legs :: proc(victim: Player) {
	if victim == null return;
	if !victim.lily_crawling return;
	victim.agent.movement_speed = victim.lily_crawl_speed_saved;
	victim.lily_crawl_ends_at = 0.0;
	victim.lily_crawling = false;
	victim.lily_crawl_speed_saved = 0.0;
}

// Per-frame spider update (called from rr_lily_update).
rr_lily_update_spider :: proc(player: Player, dt: float) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.spider_active return;
	if lm.spider_entity == null || !#alive(lm.spider_entity) {
		rr_lily_end_spider(player, false);
		return;
	}

	now := get_time();

	// Camera and LOS follow the spider (every frame, server sync overwrites)
	if player.is_local() {
		player.camera.follow_player = false;
		player.camera.position = lm.spider_entity.world_position;

		// Unparent light and set world position directly (avoids parent scale flip issues)
		if player.local_light_entity != null && #alive(player.local_light_entity) {
			player.local_light_entity.set_parent(null, true);
			player.local_light_entity.set_local_position(lm.spider_entity.world_position);
		}
	}

	// Input zeroing is handled in Lily_Spider.ao_update (runs before this).

	// Check return deadline
	if lm.spider_has_legs && lm.spider_return_deadline > 0.0 {
		if now >= lm.spider_return_deadline {
			rr_lily_end_spider(player, false);
			return;
		}
	}
}

// Spider component — lives on the spider entity, handles movement and attack.
LILY_SPIDER_CHOMP_BITE_DELAY :: 0.75; // seconds into chomp animation when the leg steal actually happens
LILY_SPIDER_CHOMP_TOTAL_DURATION :: 2.0; // total chomp lock duration

Lily_Spider :: class : Component {
	lily_entity_id: u64;
	chomping: bool;
	chomp_done_at: float;
	chomp_bite_at: float; // when the actual leg steal triggers
	chomp_victim_id: u64; // pending victim entity id
	chomp_bite_applied: bool;
	is_walking: bool;

	ao_update :: method(dt: float) {
		lily := get_player_by_entity_id(lily_entity_id);
		if lily == null return;
		lm := lily.entity.get_component(Lily_Module);
		if lm == null || !lm.spider_active return;

		now := get_time();

		// Read Lily's input then zero it so Lily herself doesn't move
		input := lily.agent.input_this_frame;
		lily.agent.input_this_frame = v2.{0, 0};

		// Handle chomp animation lock
		if chomping {
			// Apply the bite (leg steal) at the right moment in the animation
			if !chomp_bite_applied && now >= chomp_bite_at {
				chomp_bite_applied = true;
				rr_lily_spider_apply_bite(lily, lm, chomp_victim_id);
			}
			if now >= chomp_done_at {
				chomping = false;
			} else {
				return; // locked during chomp
			}
		}

		// Forward input to spider movement
		if length_squared(input) > 0.01 {
			dir := normalize(input);
			entity.set_local_position(entity.local_position + dir * LILY_SPIDER_SPEED * dt);

			// Flip spider sprite based on direction
			if dir.x < 0.0 {
				entity.set_local_scale(v2.{-1, 1});
			} else {
				entity.set_local_scale(v2.{1, 1});
			}

			// Play walk animation (only set once to avoid restarting every frame)
			if !is_walking {
				if lm.spider_animator != null && lm.spider_animator.instance != null {
					lm.spider_animator.instance.set_animation("run", true, 0);
				}
				is_walking = true;
			}
		} else {
			if is_walking {
				if lm.spider_animator != null && lm.spider_animator.instance != null {
					lm.spider_animator.instance.set_animation("idle", true, 0);
				}
				is_walking = false;
			}
		}

		spider_pos := entity.world_position;

		// If spider has legs, check if near tree to deliver
		if lm.spider_has_legs {
			if lm.hair_tree_entity != null && #alive(lm.hair_tree_entity) {
				tree_pos := lm.hair_tree_entity.world_position;
				dist := length(spider_pos - tree_pos);
				if dist <= LILY_SPIDER_TREE_RETURN_RANGE {
					// Auto-deliver legs to tree
					tree_comp := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
					if tree_comp != null {
						request, has_request := tree_comp.get_current_request();
						if has_request && request == Tree_Request.LEGS {
							// Tree wants legs right now — fulfill directly
							tree_comp.fulfill_request();
							rr_lily_apply_tree_buffs(lily);
						} else {
							// Tree isn't asking for legs yet — carry them for later
							lm.carrying_legs = true;
							lm.stolen_legs_from_id = lm.spider_victim_id;
						}
					}
					rr_lily_end_spider(lily, true);

					if lily.is_local_or_server() {
						Notifier.notify(lily, "Spider returned! Legs delivered to the tree!");
					}
					return;
				}
			}
			return; // spider has legs, just needs to return
		}
	}
}

// Called when the chomp animation reaches the bite moment — actually steals legs.
rr_lily_spider_apply_bite :: proc(player: Player, lm: Lily_Module, victim_entity_id: u64) {
	if lm == null return;
	if lm.spider_has_legs return; // already stolen

	victim := get_player_by_entity_id(victim_entity_id);
	if victim == null return;

	now := get_time();
	lm.spider_has_legs = true;
	lm.spider_victim_id = victim_entity_id;
	lm.spider_return_deadline = now + LILY_SPIDER_RETURN_TIME;

	rr_lily_apply_crawl(victim);
	victim.lily_crawl_ends_at = lm.spider_return_deadline;

	desc := SFX.default_sfx_desc();
	desc.entity_to_follow = lm.spider_entity.id;
	desc.volume = 0.5;
	SFX.play(get_asset(SFX_Asset, "sfx/lily/spider_attack_chomp.wav"), desc);

	if player.is_local_or_server() {
		Notifier.notify(player, format_string("Stole %'s legs! Return to the tree!", {victim.get_username()}));
	}
}

// Perform spider chomp on closest valid target.
rr_lily_spider_chomp :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.spider_active return;
	if lm.spider_has_legs return;
	if lm.spider_entity == null || !#alive(lm.spider_entity) return;

	spider_pos := lm.spider_entity.world_position;

	finder := make_finder(Player, spider_pos, LILY_SPIDER_ATTACK_RANGE);
	for target: component_iterator(Player) {
		if target == null continue;
		if target.entity.id == player.entity.id continue;
		if target.player_state != Player_State.ALIVE continue;
		if target.player_type == Player_Type.TRAITOR continue;
		if target.lily_crawling continue;
		finder.check(target, target.entity.world_position);
	}

	closest := finder.closest;
	if closest == null return;

	now := get_time();

	// Play attack_chomp
	if lm.spider_animator != null && lm.spider_animator.instance != null {
		lm.spider_animator.instance.set_animation("attack_chomp", false, 0);
	}

	// Lock spider movement during chomp — leg steal is deferred to the bite moment
	spider_comp := lm.spider_entity.get_component(Lily_Spider);
	if spider_comp != null {
		spider_comp.chomping = true;
		spider_comp.chomp_done_at = now + LILY_SPIDER_CHOMP_TOTAL_DURATION;
		spider_comp.chomp_bite_at = now + LILY_SPIDER_CHOMP_BITE_DELAY;
		spider_comp.chomp_victim_id = closest.entity.id;
		spider_comp.chomp_bite_applied = false;
		spider_comp.is_walking = false;
	}
}

// --- Spider Attack Ability ---
Lily_Spider_Attack_Ability :: class : Ability_Base {
	NAME :: "Chomp";

	on_init :: proc(instance: Lily_Spider_Attack_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Hair_Mouth_Icon.png");
	}

	get_closest_target :: proc(player: Player) -> Player {
		lm := player.entity.get_component(Lily_Module);
		if lm == null return null;
		if lm.spider_entity == null || !#alive(lm.spider_entity) return null;

		spider_pos := lm.spider_entity.world_position;
		finder := make_finder(Player, spider_pos, LILY_SPIDER_ATTACK_RANGE);
		for target: component_iterator(Player) {
			if target == null continue;
			if target.entity.id == player.entity.id continue;
			if target.player_state != Player_State.ALIVE continue;
			if target.player_type == Player_Type.TRAITOR continue;
			if target.lily_crawling continue;
			finder.check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if !lm.spider_active return false;
		if lm.spider_has_legs return false; // already stole legs

		// Check spider not mid-chomp
		if lm.spider_entity != null && #alive(lm.spider_entity) {
			sc := lm.spider_entity.get_component(Lily_Spider);
			if sc != null && sc.chomping return false;
		}

		return get_closest_target(player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_lily_spider_chomp(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Spider_Attack_Ability.NAME);
	}
}

// --- Spider Cancel Ability ---
Lily_Spider_Cancel_Ability :: class : Ability_Base {
	NAME :: "Cancel";

	on_init :: proc(instance: Lily_Spider_Cancel_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Hair_Mouth_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		return lm.spider_active;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_lily_end_spider(player, false);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Spider_Cancel_Ability.NAME);
	}
}

// Draw spider return timer HUD (visible to Lily only).
rr_lily_draw_spider_timer :: proc(player: Player) {
	if !player.is_local() return;
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.spider_active return;
	if !lm.spider_has_legs return;
	if lm.spider_entity == null || !#alive(lm.spider_entity) return;

	now := get_time();
	remaining := lm.spider_return_deadline - now;
	if remaining < 0.0 { remaining = 0.0; }

	secs := remaining.(int);
	frac := remaining - secs.(float);
	if frac > 0.001 { secs += 1; }

	spider_pos := lm.spider_entity.world_position;

	UI.push_world_draw_context();
	defer UI.pop_draw_context();

	UI.push_z(spider_pos.y);
	defer UI.pop_z();

	label_pos := spider_pos + v2.{0.0, 1.2};

	// Background pill
	bg_rect := Rect{label_pos, label_pos}.grow(0.18, 0.8, 0.18, 0.8);
	UI.quad(bg_rect, core_globals.white_sprite, v4.{0.0, 0.0, 0.0, 0.55});

	ts := UI.default_text_settings();
	ts.size = 0.28;
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 0.04;
	ts.outline_color = v4.{0, 0, 0, 1};

	// Color: lerp from white to red as time runs out
	t := clamp(remaining / LILY_SPIDER_RETURN_TIME, 0.0, 1.0);
	ts.color = v4.{1.0, t, t, 1.0};

	text_rect := Rect{label_pos, label_pos}.grow(0.16, 0.58, 0.16, 0.58);
	UI.text(text_rect, ts, format_string("Return: %s", .{secs}));
}

// =============================================================================
// Eye Steal Machine System
// =============================================================================

// Spawn the eye machine: suction tube entity + AOE VFX, detach camera.
rr_lily_spawn_eye_machine :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.eye_machine_active return;
	if lm.hair_tree_entity == null || !#alive(lm.hair_tree_entity) return;

	tree_pos := lm.hair_tree_entity.world_position;
	lm.eye_machine_pos = tree_pos;

	// Create suction tube entity (visible to ALL players)
	tube_e := Scene.create_entity();
	tube_e.set_local_position(v2.{tree_pos.x, tree_pos.y + LILY_EYE_MACHINE_TUBE_OFFSET_Y});
	tube_e.set_local_scale(v2.{1, 1});
	tube_e.set_local_rotation(0.0);
	tube_sprite := tube_e.add_component(Sprite_Renderer);
	tube_tex := get_asset(Texture_Asset, "sprites/Suction_Tube_With_Propeller_Layout.png");
	if tube_sprite != null && tube_tex != null {
		tube_sprite.set_texture(tube_tex);
		tube_sprite.layer = 50;
	}
	lm.eye_machine_tube_entity = tube_e;

	// Create AOE reticle entity (will be hidden for non-Lily via ao_on_state_sync)
	aoe_e := Scene.create_entity();
	aoe_e.set_local_position(tree_pos);
	aoe_e.set_local_scale(v2.{1.5, 1.5});
	aoe_e.set_local_rotation(0.0);
	aoe_sr := aoe_e.add_component(Sprite_Renderer);
	aoe_tex := get_asset(Texture_Asset, "sprites/ground_reticle_white.png");
	if aoe_sr != null && aoe_tex != null {
		aoe_sr.set_texture(aoe_tex);
		aoe_sr.color = v4.{1.0, 0.3, 0.3, 0.7}; // start red
		aoe_sr.layer = 10; // render above floor, below characters
	}
	// Add visibility component to hide AOE for non-Lily players
	aoe_vis := aoe_e.add_component(Lily_Eye_Machine_AOE);
	aoe_vis.lily_entity_id = player.entity.id;

	lm.eye_machine_aoe_entity = aoe_e;

	// Add input-zeroing component to the tube entity (runs in ao_update before Player movement)
	machine_comp := tube_e.add_component(Lily_Eye_Machine);
	machine_comp.lily_entity_id = player.entity.id;

	lm.eye_machine_active = true;
	lm.eye_machine_has_target = false;
	lm.eye_machine_lowering = false;
	lm.eye_machine_lower_done_at = 0.0;

	// Lily's input is forwarded to the machine then zeroed each frame (like spider).
	// Don't use add_freeze_reason or add_disable_movement_input_reason — they prevent
	// input_this_frame from being populated.

	// Save camera state and zoom out
	if player.is_local() {
		lm.eye_machine_camera_saved_size = player.camera.size;
		lm.eye_machine_camera_saved_follow = player.camera.follow_player;
		player.camera.follow_player = false;
		player.camera.size = LILY_EYE_MACHINE_ZOOM_SIZE;
		player.camera.position = tree_pos;
	}

	if player.is_local_or_server() {
		Notifier.notify(player, "Eye Machine deployed! Move to a target...");
	}
}

// End eye machine mode, destroy entities, restore camera.
rr_lily_end_eye_machine :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.eye_machine_active return;

	// Destroy tube entity
	if lm.eye_machine_tube_entity != null && #alive(lm.eye_machine_tube_entity) {
		lm.eye_machine_tube_entity.destroy();
	}
	lm.eye_machine_tube_entity = null;

	// Destroy AOE entity
	if lm.eye_machine_aoe_entity != null && #alive(lm.eye_machine_aoe_entity) {
		lm.eye_machine_aoe_entity.destroy();
	}
	lm.eye_machine_aoe_entity = null;

	// Unfreeze victim if still frozen (cancelled or round ended mid-attack)
	if lm.eye_machine_victim_id != 0 {
		victim := get_player_by_entity_id(lm.eye_machine_victim_id);
		if victim != null {
			victim.remove_freeze_reason(LILY_EYE_MACHINE_FREEZE_REASON);
		}
		lm.eye_machine_victim_id = 0;
	}

	// Stop suction loop SFX if still playing
	if lm.eye_machine_suction_sfx_id != 0 {
		SFX.stop(lm.eye_machine_suction_sfx_id);
		lm.eye_machine_suction_sfx_id = 0;
	}

	// Restore camera — set position before re-enabling follow to avoid a black frame
	if player.is_local() {
		player.camera.position = player.entity.world_position;
		player.camera.size = lm.eye_machine_camera_saved_size;
		player.camera.follow_player = lm.eye_machine_camera_saved_follow;
	}
	lm.eye_machine_camera_saved_size = 0.0; // mark restored (prevents update guard re-firing)

	lm.eye_machine_active = false;
	lm.eye_machine_has_target = false;
	lm.eye_machine_lowering = false;
	lm.eye_machine_linger_until = 0.0;
	lm.eye_machine_linger_start = 0.0;
}

// Per-frame eye machine update: move camera with input, position entities, check targets.
rr_lily_update_eye_machine :: proc(player: Player, dt: float) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.eye_machine_active {
		// Guard: if server sync cleared eye_machine_active without end proc running,
		// restore camera and clear post-processing to avoid black flash / lingering FX.
		if player.is_local() && lm.eye_machine_camera_saved_size > 0.0 {
			player.camera.position = player.entity.world_position;
			player.camera.size = lm.eye_machine_camera_saved_size;
			player.camera.follow_player = lm.eye_machine_camera_saved_follow;
			lm.eye_machine_camera_saved_size = 0.0;
		}
		return;
	}

	now := get_time();

	// ---- CAMERA (runs every frame, all phases — server sync overwrites) ----
	// ---- CAMERA + VFX (every frame, all phases) ----
	if player.is_local() {
		player.camera.follow_player = false;

		if lm.eye_machine_lowering {
			elapsed := now - lm.eye_machine_lower_start_at;

			// Zoom progress (capped at 1.0 even during suction sub-phase)
			total_duration := LILY_EYE_MACHINE_ZOOM_DURATION + LILY_EYE_MACHINE_SUCTION_DURATION;
			zoom_t := clamp(elapsed / LILY_EYE_MACHINE_ZOOM_DURATION, 0.0, 1.0);
			zoom_ease := zoom_t * zoom_t;

			player.camera.size = lerp(LILY_EYE_MACHINE_ZOOM_SIZE, LILY_EYE_MACHINE_ZOOM_ATTACK, zoom_ease);

			// Camera position lerps to victim
			cam_x := lerp(lm.eye_machine_pos.x, lm.eye_machine_victim_pos.x, zoom_ease);
			cam_y := lerp(lm.eye_machine_pos.y, lm.eye_machine_victim_pos.y, zoom_ease);

			// Shake starts when zoom is 95% done, builds through suction
			if zoom_ease >= 0.95 {
				suction_elapsed := elapsed - LILY_EYE_MACHINE_ZOOM_DURATION * 0.95;
				suction_total := total_duration - LILY_EYE_MACHINE_ZOOM_DURATION * 0.95;
				shake_t := clamp(suction_elapsed / suction_total, 0.0, 1.0);
				shake_str := shake_t * LILY_EYE_MACHINE_SHAKE_INTENSITY;
				cam_x = cam_x + sin(now * LILY_EYE_MACHINE_SHAKE_SPEED) * shake_str;
				cam_y = cam_y + cos(now * LILY_EYE_MACHINE_SHAKE_SPEED * 1.3) * shake_str * 0.7;
			}

			player.camera.position = v2.{cam_x, cam_y};
			player.draw_letterbox_bars();

		} else if lm.eye_machine_linger_until > 0.0 {
			// Phase: LINGER — hold on victim, shake decays, tube flies away
			linger_elapsed := now - lm.eye_machine_linger_start;
			linger_total := LILY_EYE_MACHINE_LINGER_TIME;
			t := clamp(linger_elapsed / linger_total, 0.0, 1.0);

			// Camera on victim with decaying shake
			decay := 1.0 - t;
			shake_str := decay * LILY_EYE_MACHINE_SHAKE_INTENSITY;
			shake_x := sin(now * LILY_EYE_MACHINE_SHAKE_SPEED) * shake_str;
			shake_y := cos(now * LILY_EYE_MACHINE_SHAKE_SPEED * 1.3) * shake_str * 0.7;

			player.camera.size = LILY_EYE_MACHINE_ZOOM_ATTACK;
			player.camera.position = v2.{
				lm.eye_machine_victim_pos.x + shake_x,
				lm.eye_machine_victim_pos.y + shake_y
			};

			player.draw_letterbox_bars();

		} else {
			// Phase: IDLE/MOVING — normal overview
			player.camera.size = LILY_EYE_MACHINE_ZOOM_SIZE;
			player.camera.position = lm.eye_machine_pos;
		}
	}

	// ---- PHASE: SUCTION (lowering) ----
	if lm.eye_machine_lowering {
		elapsed := now - lm.eye_machine_lower_start_at;
		total_duration := LILY_EYE_MACHINE_ZOOM_DURATION + LILY_EYE_MACHINE_SUCTION_DURATION;
		drift_t := clamp(elapsed / LILY_EYE_MACHINE_ZOOM_DURATION, 0.0, 1.0);
		drift_ease := drift_t * drift_t;

		// Tube drifts from machine pos to above victim during zoom
		if lm.eye_machine_tube_entity != null && #alive(lm.eye_machine_tube_entity) {
			tube_x := lerp(lm.eye_machine_pos.x, lm.eye_machine_victim_pos.x, drift_ease);
			tube_y := lerp(
				lm.eye_machine_pos.y + LILY_EYE_MACHINE_TUBE_OFFSET_Y,
				lm.eye_machine_victim_pos.y + LILY_EYE_MACHINE_TUBE_OFFSET_Y,
				drift_ease
			);
			bob := sin(now * LILY_EYE_MACHINE_TUBE_BOB_SPEED) * LILY_EYE_MACHINE_TUBE_BOB_AMP;
			lm.eye_machine_tube_entity.set_local_position(v2.{tube_x, tube_y + bob});
		}

		if now >= lm.eye_machine_lower_done_at {
			rr_lily_eye_machine_finish_attack(player);
		}
		return;
	}

	// ---- PHASE: LINGER (tube flies up, camera returns) ----
	if lm.eye_machine_linger_until > 0.0 {
		// Tube holds above victim, then flies up and fades out (last 30% of linger)
		if lm.eye_machine_tube_entity != null && #alive(lm.eye_machine_tube_entity) {
			linger_elapsed := now - lm.eye_machine_linger_start;
			linger_total := LILY_EYE_MACHINE_LINGER_TIME;
			fly_start := linger_total * 0.7;

			if linger_elapsed < fly_start {
				// Hold tube above victim with gentle bob
				bob := sin(now * LILY_EYE_MACHINE_TUBE_BOB_SPEED) * LILY_EYE_MACHINE_TUBE_BOB_AMP;
				lm.eye_machine_tube_entity.set_local_position(v2.{lm.eye_machine_victim_pos.x, lm.eye_machine_victim_pos.y + LILY_EYE_MACHINE_TUBE_OFFSET_Y + bob});
			} else {
				// Fly up high and fade out
				fly_t := clamp((linger_elapsed - fly_start) / (linger_total - fly_start), 0.0, 1.0);
				fly_ease := fly_t * fly_t; // accelerate upward
				fly_y := lm.eye_machine_victim_pos.y + LILY_EYE_MACHINE_TUBE_OFFSET_Y + fly_ease * 10.0;
				lm.eye_machine_tube_entity.set_local_position(v2.{lm.eye_machine_victim_pos.x, fly_y});

				tube_sr := lm.eye_machine_tube_entity.get_component(Sprite_Renderer);
				if tube_sr != null {
					tube_sr.color = v4.{1.0, 1.0, 1.0, 1.0 - fly_t};
				}
			}
		}

		if now >= lm.eye_machine_linger_until {
			lm.eye_machine_linger_until = 0.0;
			rr_lily_end_eye_machine(player);
		}
		return;
	}

	// ---- PHASE: IDLE/MOVING ----
	// Input reading and movement happen in Lily_Eye_Machine.ao_update (runs before this).

	// Update tube entity position (floats above machine pos with gentle bob)
	if lm.eye_machine_tube_entity != null && #alive(lm.eye_machine_tube_entity) {
		bob := sin(now * LILY_EYE_MACHINE_TUBE_BOB_SPEED) * LILY_EYE_MACHINE_TUBE_BOB_AMP;
		lm.eye_machine_tube_entity.set_local_position(v2.{lm.eye_machine_pos.x, lm.eye_machine_pos.y + LILY_EYE_MACHINE_TUBE_OFFSET_Y + bob});
	}

	// Update AOE VFX position
	if lm.eye_machine_aoe_entity != null && #alive(lm.eye_machine_aoe_entity) {
		lm.eye_machine_aoe_entity.set_local_position(lm.eye_machine_pos);
	}

	// Check for valid target in range (for AOE color + attack availability)
	closest := rr_lily_eye_machine_find_target(player);
	lm.eye_machine_has_target = closest != null;

	// Update AOE reticle color: red by default, white when target in range (Lily-local only)
	if player.is_local() {
		if lm.eye_machine_aoe_entity != null && #alive(lm.eye_machine_aoe_entity) {
			aoe_sr := lm.eye_machine_aoe_entity.get_component(Sprite_Renderer);
			if aoe_sr != null {
				if lm.eye_machine_has_target {
					aoe_sr.color = v4.{1.0, 1.0, 1.0, 0.8}; // white — target in range
				} else {
					aoe_sr.color = v4.{1.0, 0.3, 0.3, 0.7}; // red — no target
				}
			}
		}
	}
}

// Find closest valid eye-steal target near the machine.
rr_lily_eye_machine_find_target :: proc(player: Player) -> Player {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return null;

	finder := make_finder(Player, lm.eye_machine_pos, LILY_EYE_MACHINE_ATTACK_RANGE);
	for target: component_iterator(Player) {
		if target == null continue;
		if target.entity.id == player.entity.id continue;
		if target.player_state != Player_State.ALIVE continue;
		if target.player_type == Player_Type.TRAITOR continue;
		if target.lily_no_eyes continue; // already blinded
		finder.check(target, target.entity.world_position);
	}
	return finder.closest;
}

// Start the attack — freeze victim, zoom camera, begin suction.
rr_lily_eye_machine_start_attack :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if !lm.eye_machine_active return;
	if lm.eye_machine_lowering return;

	closest := rr_lily_eye_machine_find_target(player);
	if closest == null return;

	now := get_time();
	lm.eye_machine_lowering = true;
	lm.eye_machine_lower_start_at = now;
	lm.eye_machine_lower_done_at = now + LILY_EYE_MACHINE_ZOOM_DURATION + LILY_EYE_MACHINE_SUCTION_DURATION;
	lm.eye_machine_victim_pos = closest.entity.world_position;
	lm.eye_machine_victim_id = closest.entity.id;

	// Freeze the victim in place
	closest.add_freeze_reason(LILY_EYE_MACHINE_FREEZE_REASON);

	// Hide AOE reticle during cinematic
	if lm.eye_machine_aoe_entity != null && #alive(lm.eye_machine_aoe_entity) {
		lm.eye_machine_aoe_entity.set_local_enabled(false);
	}

	// Suction start SFX (whoosh as camera zooms)
	desc := SFX.default_sfx_desc();
	desc.volume = 0.5;
	whoosh := get_asset(SFX_Asset, "sfx/Whoosh_1e3125.wav");
	if whoosh != null {
		SFX.play(whoosh, desc);
	}

	// Start looping suction SFX
	desc2 := SFX.default_sfx_desc();
	desc2.volume = 0.3;
	desc2.loop = true;
	suction_loop := get_asset(SFX_Asset, "sfx/suction_loop_47fce8.wav");
	if suction_loop != null {
		lm.eye_machine_suction_sfx_id = SFX.play(suction_loop, desc2);
	}
}

// Finish the attack: blind victim, spawn eye pickup near them, begin linger (tube fly-up).
rr_lily_eye_machine_finish_attack :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	// Find the victim we locked
	victim := get_player_by_entity_id(lm.eye_machine_victim_id);
	if victim != null {
		// Blind the victim
		victim.lily_no_eyes = true;

		// Unfreeze victim
		victim.remove_freeze_reason(LILY_EYE_MACHINE_FREEZE_REASON);

		// Spawn eye pickup slightly in front of the victim
		drop_pos := victim.entity.world_position + v2.{0.0, -0.3};
		rr_lily_spawn_eye_pickup(player, victim.entity.id, drop_pos);

		if player.is_local_or_server() {
			Notifier.notify(player, format_string("Stole %'s eyes! Pick them up!", {victim.get_username()}));
		}
	}
	lm.eye_machine_victim_id = 0;

	// Stop suction loop SFX
	if lm.eye_machine_suction_sfx_id != 0 {
		SFX.stop(lm.eye_machine_suction_sfx_id);
		lm.eye_machine_suction_sfx_id = 0;
	}

	// Gore SFX (squelch)
	desc := SFX.default_sfx_desc();
	desc.volume = 0.5;
	gore := get_asset(SFX_Asset, "sfx/gore_explosion_death_66eeb3.wav");
	if gore != null {
		SFX.play(gore, desc);
	}

	// Begin linger — tube flies up, camera returns to player
	now := get_time();
	lm.eye_machine_lowering = false;
	lm.eye_machine_linger_until = now + LILY_EYE_MACHINE_LINGER_TIME;
	lm.eye_machine_linger_start = now;
}

// Spawn a hovering eyes pickup entity at the given position.
rr_lily_spawn_eye_pickup :: proc(player: Player, victim_id: u64, pos: v2) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	// Destroy old pickup if any
	rr_lily_destroy_eye_pickup(player);

	e := Scene.create_entity();
	e.set_local_position(pos);
	e.set_local_scale(v2.{0.5, 0.5});
	e.set_local_rotation(0.0);

	sa := e.add_component(Spine_Animator);
	sa.awaken();
	eyes_rig := get_asset(Spine_Asset, rr_lily_get_eyes_rig_path());
	if sa.instance != null && eyes_rig != null {
		sa.instance.set_skeleton(eyes_rig);
		sa.instance.set_skin("default");
		sa.instance.set_animation("Hover", true, 0);
	}

	// Add interactable for Lily to pick up
	pickup := e.add_component(Lily_Eyes_Pickup_Interactable);
	pickup.lily_entity_id = player.entity.id;
	pickup.victim_id = victim_id;

	lm.eye_pickup_entity = e;
	lm.eye_pickup_animator = sa;
	lm.eye_pickup_active = true;
	lm.eye_pickup_victim_id = victim_id;
}

// Destroy eye pickup entity.
rr_lily_destroy_eye_pickup :: proc(player: Player) {
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.eye_pickup_entity != null && #alive(lm.eye_pickup_entity) {
		lm.eye_pickup_entity.destroy();
	}
	lm.eye_pickup_entity = null;
	lm.eye_pickup_animator = null;
	lm.eye_pickup_active = false;
	lm.eye_pickup_victim_id = 0;
}

// Interactable component on the eye pickup entity — lets Lily collect stolen eyes.
Lily_Eyes_Pickup_Interactable :: class : Interactable {
	lily_entity_id: u64;
	victim_id: u64;

	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Pick Up Eyes");
		this.set_hold_text("Picking up...");
		radius = LILY_EYES_PICKUP_RANGE;
		required_hold_time = 0.5;
		prompt_offset = v2.{0, 1.0};
		priority = 70;
	}

	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;
		if player.entity.id != lily_entity_id return false;
		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if lm.carrying_eyes return false; // already carrying eyes
		return true;
	}

	on_interact :: method(player: Player) {
		lm := player.entity.get_component(Lily_Module);
		if lm == null return;
		lm.carrying_eyes = true;
		lm.stolen_eyes_from_id = victim_id;

		// Destroy the pickup
		rr_lily_destroy_eye_pickup(player);

		if player.is_local_or_server() {
			Notifier.notify(player, "Eyes collected! Deliver them to the tree.");
		}
	}
}

// AOE visibility component — hides the AOE VFX for non-Lily players.
Lily_Eye_Machine_AOE :: class : Component {
	lily_entity_id: u64;

	ao_on_state_sync :: method() {
		local_player, ok := Game.get_local_player();
		if !ok return;
		// Only visible to the owning Lily player
		if local_player.entity.id == lily_entity_id {
			entity.set_local_enabled(true);
		} else {
			entity.set_local_enabled(false);
		}
	}
}

// Eye Machine movement component — lives on the tube entity, reads Lily's input in ao_update
// (before Player movement processing) then zeros it so Lily doesn't move.
Lily_Eye_Machine :: class : Component {
	lily_entity_id: u64;

	ao_update :: method(dt: float) {
		lily := get_player_by_entity_id(lily_entity_id);
		if lily == null return;
		lm := lily.entity.get_component(Lily_Module);
		if lm == null || !lm.eye_machine_active return;
		if lm.eye_machine_lowering return; // locked during attack

		// Read Lily's input then zero it
		input := lily.agent.input_this_frame;
		lily.agent.input_this_frame = v2.{0, 0};

		// Move machine position
		if length_squared(input) > 0.01 {
			dir := normalize(input);
			lm.eye_machine_pos = lm.eye_machine_pos + dir * LILY_EYE_MACHINE_SPEED * dt;
		}
	}
}

// --- Steal Eyes (Machine) ---
Lily_Steal_Eyes_Ability :: class : Ability_Base {
	NAME :: "Steal Eyes";

	on_init :: proc(instance: Lily_Steal_Eyes_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Suction_Tube_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if lm.is_lily_form return false;
		if lm.mind_control_active return false;
		if lm.eye_machine_active return false;
		if lm.spider_active return false;
		if lm.carrying_eyes return false;
		// Must have tree planted and be near the tree to activate
		if !lm.hair_tree_planted return false;
		if lm.hair_tree_entity == null return false;
		if !#alive(lm.hair_tree_entity) return false;
		dist := length(player.entity.world_position - lm.hair_tree_entity.world_position);
		if dist > LILY_TREE_INTERACT_RADIUS return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_lily_spawn_eye_machine(player);
			cd_mult := 1.0;
			lm := player.entity.get_component(Lily_Module);
			if lm != null {
				cd_mult = lm.tree_cd_multiplier;
			}
			current_cooldown = LILY_EYE_STEAL_COOLDOWN * cd_mult;
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Steal_Eyes_Ability.NAME);
	}
}

// --- Eye Machine Attack Ability ---
Lily_Eye_Machine_Attack_Ability :: class : Ability_Base {
	NAME :: "Lower Machine";

	on_init :: proc(instance: Lily_Eye_Machine_Attack_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Suction_Tube_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if !lm.eye_machine_active return false;
		if lm.eye_machine_lowering return false;
		// Check target fresh instead of relying on cached has_target
		return rr_lily_eye_machine_find_target(player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_lily_eye_machine_start_attack(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Eye_Machine_Attack_Ability.NAME);
	}
}

// --- Eye Machine Cancel Ability ---
Lily_Eye_Machine_Cancel_Ability :: class : Ability_Base {
	NAME :: "Cancel";

	on_init :: proc(instance: Lily_Eye_Machine_Cancel_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Suction_Tube_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		return lm.eye_machine_active;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_lily_end_eye_machine(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Eye_Machine_Cancel_Ability.NAME);
	}
}

// --- Steal Legs (Spider) ---
Lily_Steal_Legs_Ability :: class : Ability_Base {
	NAME :: "Steal Legs";

	on_init :: proc(instance: Lily_Steal_Legs_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Braid_Point_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if lm.is_lily_form return false;
		if lm.mind_control_active return false;
		if lm.spider_active return false; // spider already deployed
		if lm.carrying_legs return false;  // already carrying legs
		// Must have tree planted and be near the tree to activate
		if !lm.hair_tree_planted return false;
		if lm.hair_tree_entity == null return false;
		if !#alive(lm.hair_tree_entity) return false;
		dist := length(player.entity.world_position - lm.hair_tree_entity.world_position);
		if dist > LILY_TREE_INTERACT_RADIUS return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			lm := player.entity.get_component(Lily_Module);
			if lm == null return;

			rr_lily_spawn_spider(player);

			cd_mult := lm.tree_cd_multiplier;
			current_cooldown = LILY_LEG_STEAL_COOLDOWN * cd_mult;
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Steal_Legs_Ability.NAME);
	}
}

// --- Tea Party (single target) ---
Lily_Tea_Party_Ability :: class : Ability_Base {
	NAME :: "Tea Party";

	on_init :: proc(instance: Lily_Tea_Party_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Tea_Party_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if !lm.is_lily_form return false;
		if lm.tea_party_active return false;
		if lm.mind_control_active return false;
		if lm.strung_player_ids.count == 0 return false;
		return get_closest_tea_target(this, player) != null;
	}

	get_closest_tea_target :: proc(instance: Lily_Tea_Party_Ability, player: Player) -> Player {
		lm := player.entity.get_component(Lily_Module);
		if lm == null return null;

		finder := make_finder(Player, player.entity.world_position, LILY_TEA_PARTY_TABLE_RANGE);
		for i: 0..lm.strung_player_ids.count-1 {
			target := get_player_by_entity_id(lm.strung_player_ids[i]);
			if target == null continue;
			if target.player_state != Player_State.ALIVE continue;
			finder.check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			closest := get_closest_tea_target(this, player);
			if closest != null {
				rr_lily_start_tea_party(player, closest);
				current_cooldown = LILY_TEA_PARTY_COOLDOWN;
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Tea_Party_Ability.NAME);
	}
}

// --- Mind Control ---
Lily_Mind_Control_Ability :: class : Ability_Base {
	NAME :: "Mind Control";

	on_init :: proc(instance: Lily_Mind_Control_Ability) {
		// [ART] placeholder icon — swap for mind control icon
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Dollhouse_Icon.png");
	}

	has_any_target :: proc(player: Player) -> bool {
		for target: component_iterator(Player) {
			if target == null continue;
			if target.entity.id == player.entity.id continue;
			if target.player_state != Player_State.ALIVE continue;
			if target.player_type == Player_Type.TRAITOR continue;
			return true;
		}
		return false;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if !lm.is_lily_form return false;
		if lm.mind_control_active return false;
		if lm.mind_control_picking return false;
		if lm.tea_party_active return false;
		return has_any_target(player);
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			lm := player.entity.get_component(Lily_Module);
			if lm != null {
				lm.mind_control_picking = true;
			}
		}

		// Apply cooldown once mind control actually starts (from picker)
		lm := player.entity.get_component(Lily_Module);
		if lm != null && lm.mind_control_active && current_cooldown <= 0.0 {
			cd_mult := lm.tree_cd_multiplier;
			current_cooldown = LILY_MIND_CONTROL_COOLDOWN * cd_mult;
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Mind_Control_Ability.NAME);
	}
}

// --- Mind Control Exit ---
Lily_Mind_Control_Exit_Ability :: class : Ability_Base {
	NAME :: "Release";

	on_init :: proc(instance: Lily_Mind_Control_Exit_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Lily_Transform_Icon.png");
	}

	can_use :: method() -> bool {
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;
		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		return lm.mind_control_active;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_lily_end_mind_control(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_Mind_Control_Exit_Ability.NAME);
	}
}

// --- Deathbraid (manual activation when a tree has 5+ absorbs) ---
Lily_Deathbraid_Ability :: class : Ability_Base {
	NAME :: "Deathbraid";

	on_init :: proc(instance: Lily_Deathbraid_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Hair_Tree_Icon.png");
	}

	// Find the tree if it has enough absorbs
	find_ready_tree :: method() -> Entity {
		lm := player.entity.get_component(Lily_Module);
		if lm == null return null;
		tree := lm.hair_tree_entity;
		if tree == null return null;
		if !#alive(tree) return null;
		tc := tree.get_component(Lily_Hair_Tree);
		if tc != null && tc.fulfilled_count >= LILY_DEATHBRAID_THRESHOLD {
			return tree;
		}
		return null;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;

		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if !lm.is_lily_form return false;
		if lm.deathbraid_active return false;
		if lm.mind_control_active return false;
		if lm.tea_party_active return false;
		return find_ready_tree() != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			tree := find_ready_tree();
			if tree != null {
				rr_lily_trigger_deathbraid(player, tree);
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		// Pulsing red glow
		pulse := sin(get_time() * 3.0) * 0.3 + 0.7;
		ts := UI.default_text_settings();
		ts.size = 14;
		ts.halign = .CENTER;
		ts.valign = .BOTTOM;
		ts.color = v4.{1.0, 0.2, 0.2, pulse};
		UI.text(rect.inset(3), ts, "READY");
		draw_ability_name_label(rect, Lily_Deathbraid_Ability.NAME);
	}
}

// --- String Trap (aimed placement) ---
Lily_String_Trap_Ability :: class : Ability_Base {
	NAME :: "String Trap";

	was_targeting: bool;
	activated_this_session: bool;

	on_init :: proc(instance: Lily_String_Trap_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/lily/Braid_Trap_Icon.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.LILY_LOVEBRAIDS return false;
		lm := player.entity.get_component(Lily_Module);
		if lm == null return false;
		if !lm.is_lily_form return false;
		if lm.tea_party_active return false;
		if lm.mind_control_active return false;
		return true;
	}

	cleanup_targeting :: method() {
		was_targeting = false;
		activated_this_session = false;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;

		if targeting && !params.can_use {
			player.active_ability = null;
			cleanup_targeting();
			return;
		}

		if targeting && !was_targeting {
			activated_this_session = false;
			was_targeting = true;
		}
		if !targeting {
			if was_targeting {
				cleanup_targeting();
			}
			return;
		}

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel {
			player.active_ability = null;
			cleanup_targeting();
			return;
		}

		target_pos := get_mouse_world_position();
		{
			origin := player.entity.world_position;
			delta := target_pos - origin;
			max_r := LILY_STRING_TRAP_PLACE_DISTANCE;
			if length_squared(delta) > max_r * max_r {
				if length_squared(delta) < 0.001 {
					delta = v2.{1, 0};
				} else {
					delta = normalize(delta);
				}
				target_pos = origin + delta * max_r;
			}
		}

		// Draw placement reticle
		if player.is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			reticle := get_asset(Texture_Asset, GROUND_RETICLE_TEXTURE_PATH);
			reticle_rect := Rect{target_pos, target_pos}.grow(0.80, 0.80, 0.80, 0.80);
			UI.quad(reticle_rect.fit_aspect(reticle.get_aspect()), reticle, v4.{0.8, 0.4, 1.0, 0.8});
		}

		if activated_this_session return;

		if aiming.activate && params.can_use {
			activated_this_session = true;
			current_cooldown = LILY_STRING_TRAP_COOLDOWN;
			rr_lily_place_string_trap(player, target_pos);
			player.active_ability = null;
			cleanup_targeting();
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, Lily_String_Trap_Ability.NAME);
	}
}


// =============================================================================
// Ability Drawing (called from player.csl)
// =============================================================================

rr_lily_draw_abilities :: proc(player: Player, idx: int) -> int {
	abilityIndex := idx;
	lm := player.entity.get_component(Lily_Module);
	if lm == null return abilityIndex;

	// During Mind Control: Kill (through puppet) + Release
	if lm.mind_control_active {
		draw_ability_button(player, Lily_Kill_Ability, abilityIndex);
		abilityIndex += 1;
		draw_ability_button(player, Lily_Mind_Control_Exit_Ability, abilityIndex);
		abilityIndex += 1;
		return abilityIndex;
	}

	// During Eye Machine control: Lower Machine + Cancel
	if lm.eye_machine_active {
		draw_ability_button(player, Lily_Eye_Machine_Attack_Ability, abilityIndex);
		abilityIndex += 1;
		draw_ability_button(player, Lily_Eye_Machine_Cancel_Ability, abilityIndex);
		abilityIndex += 1;
		return abilityIndex;
	}

	// During Spider control: Chomp + Cancel
	if lm.spider_active {
		draw_ability_button(player, Lily_Spider_Attack_Ability, abilityIndex);
		abilityIndex += 1;
		draw_ability_button(player, Lily_Spider_Cancel_Ability, abilityIndex);
		abilityIndex += 1;
		return abilityIndex;
	}

	// Get tree fulfilled count for progressive ability unlocks
	fulfilled := 0;
	if lm.hair_tree_entity != null && #alive(lm.hair_tree_entity) {
		tree_comp := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
		if tree_comp != null {
			fulfilled = tree_comp.fulfilled_count;
		}
	}

	if lm.is_lily_form {
		// Lily form (6 max): Kill, Transform, Mind Control, String Trap, Tea Party, Deathbraid
		draw_ability_button(player, Lily_Kill_Ability, abilityIndex);
		abilityIndex += 1;
		draw_ability_button(player, Lily_Transform_Ability, abilityIndex);
		abilityIndex += 1;
		// Mind Control: unlocked at 1+ fulfilled
		if fulfilled >= 1 {
			draw_ability_button(player, Lily_Mind_Control_Ability, abilityIndex);
			abilityIndex += 1;
		}
		// String Trap: unlocked at 2+ fulfilled
		if fulfilled >= 2 {
			draw_ability_button(player, Lily_String_Trap_Ability, abilityIndex);
			abilityIndex += 1;
		}
		// Tea Party: unlocked at 4 fulfilled
		if fulfilled >= 4 {
			draw_ability_button(player, Lily_Tea_Party_Ability, abilityIndex);
			abilityIndex += 1;
		}
		// Deathbraid: unlocked at 4 fulfilled
		if fulfilled >= LILY_DEATHBRAID_THRESHOLD {
			draw_ability_button(player, Lily_Deathbraid_Ability, abilityIndex);
			abilityIndex += 1;
		}
	} else {
		// Schleem form (5 max): Plant Tree / Kill, Transform, Eyes, Legs, Drag
		if !lm.hair_tree_planted {
			draw_ability_button(player, Lily_Hair_Tree_Ability, abilityIndex);
			abilityIndex += 1;
		} else {
			draw_ability_button(player, Lily_Kill_Ability, abilityIndex);
			abilityIndex += 1;
			draw_ability_button(player, Lily_Transform_Ability, abilityIndex);
			abilityIndex += 1;
			// Steal Eyes: unlocked at 1+ fulfilled
			if fulfilled >= 1 {
				draw_ability_button(player, Lily_Steal_Eyes_Ability, abilityIndex);
				abilityIndex += 1;
			}
			// Steal Legs: unlocked at 2+ fulfilled
			if fulfilled >= 2 {
				draw_ability_button(player, Lily_Steal_Legs_Ability, abilityIndex);
				abilityIndex += 1;
			}
			draw_ability_button(player, Drag_Body_Ability, abilityIndex);
			abilityIndex += 1;
		}
	}
	return abilityIndex;
}

// =============================================================================
// Braid Points HUD (local only)
// =============================================================================


rr_lily_draw_hud :: proc(player: Player) {
	if !player.is_local() return;
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;

	screen := UI.get_screen_rect();
	ts := UI.default_text_settings();
	ts.size = 20;
	ts.halign = .LEFT;
	ts.valign = .TOP;
	ts.color = v4.{1.0, 0.6, 0.8, 1.0};

	// Show string count
	hud_rect2 := screen.top_left_rect().offset(20.0, 80.0).grow(200.0, 200.0, 30.0, 30.0);
	ts.size = 16;
	ts.color = v4.{0.8, 0.8, 0.8, 0.8};
	UI.text(hud_rect2, ts, "Strings: %", {lm.strung_player_ids.count});

	y_offset := 105.0;

	// Tree request status
	if lm.hair_tree_planted && lm.hair_tree_entity != null && #alive(lm.hair_tree_entity) {
		tree_comp := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
		if tree_comp != null {
			req_rect := screen.top_left_rect().offset(20.0, y_offset).grow(200.0, 200.0, 30.0, 30.0);
			ts.color = v4.{1.0, 0.8, 0.9, 1.0};
			if tree_comp.fulfilled_count >= LILY_TREE_TOTAL_REQUESTS {
				UI.text(req_rect, ts, "Tree: DEATHBRAID READY");
			} else {
				request_name := rr_lily_get_request_name(tree_comp);
				UI.text(req_rect, ts, "Tree wants: % (%/%)", {request_name, tree_comp.fulfilled_count, LILY_TREE_TOTAL_REQUESTS});
			}
			y_offset += 25.0;

			// Show carried items
			if lm.carrying_eyes {
				carry_rect := screen.top_left_rect().offset(20.0, y_offset).grow(200.0, 200.0, 30.0, 30.0);
				ts.color = v4.{0.9, 0.7, 0.7, 1.0};
				UI.text(carry_rect, ts, "Carrying: Eyes");
				y_offset += 25.0;
			}
			if lm.carrying_legs {
				carry_rect := screen.top_left_rect().offset(20.0, y_offset).grow(200.0, 200.0, 30.0, 30.0);
				ts.color = v4.{0.9, 0.7, 0.7, 1.0};
				UI.text(carry_rect, ts, "Carrying: Legs");
				y_offset += 25.0;
			}
		}
	}

	// Mind Control active indicator
	if lm.mind_control_active {
		mc_rect := screen.top_left_rect().offset(20.0, y_offset).grow(200.0, 200.0, 30.0, 30.0);
		ts.color = v4.{0.8, 0.4, 1.0, 1.0};
		target := get_player_by_entity_id(lm.mind_control_target_id);
		if target != null {
			UI.text(mc_rect, ts, "Mind Control: %", {target.get_username()});
		}
	}
}

// Draw request icon above the tree in world space (visible only to Lily)
rr_lily_draw_tree_request_icon :: proc(player: Player) {
	if !player.is_local() return;
	lm := player.entity.get_component(Lily_Module);
	if lm == null return;
	if lm.hair_tree_entity == null return;
	if !#alive(lm.hair_tree_entity) return;

	tree_comp := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
	if tree_comp == null return;
	if tree_comp.fulfilled_count >= LILY_TREE_TOTAL_REQUESTS return;

	UI.push_world_draw_context();
	defer UI.pop_draw_context();

	tree_pos := lm.hair_tree_entity.world_position;
	UI.push_z(tree_pos.y + 0.01);
	defer UI.pop_z();

	// Icon above the tree
	icon_pos := tree_pos + v2.{0, 2.5};
	icon_rect := Rect.{icon_pos, icon_pos}.grow(0.15, 0.4, 0.15, 0.4);

	// Pulsing glow
	pulse := sin(get_time() * 2.0) * 0.15 + 0.85;

	// Request label
	ts := UI.default_text_settings();
	ts.size = 0.30;
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.color = v4.{1.0, 0.85, 0.95, pulse};
	ts.do_outline = true;
	ts.outline_thickness = 1;
	ts.outline_color = v4.{0, 0, 0, 0.8};

	request_name := rr_lily_get_request_name(tree_comp);
	UI.text(icon_rect, ts, request_name);
}
