// Growth stage → skin name on 004RAND_LilyGiantTree.spine
rr_lily_get_tree_skin_for_stage :: proc(fulfilled_count: int) -> string {
	if fulfilled_count <= 0 return "1.tiny";
	if fulfilled_count == 1 return "2.small";
	if fulfilled_count == 2 return "3.medium";
	if fulfilled_count == 3 return "4.big";
	if fulfilled_count == 4 return "5.giant";
	return "6.massive"; // 5+
}

