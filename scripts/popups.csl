import "core:ao"

POPUP_DURATION: float : 2.0;
SCROLL_DURATION: float : 2.0;

// --- Role Spin Constants ---
SPIN_TOTAL_DURATION: float : 4.5;   // total time the spin runs
SPIN_CARD_WIDTH: float : 240.0;     // width of each role card (at 1080p)
SPIN_CARD_HEIGHT: float : 320.0;    // height of each role card
SPIN_CARD_GAP: float : 16.0;        // gap between cards
SPIN_STRIP_COUNT :: 40;             // how many cards in the scrolling strip

INTRO_POPUP_DURATION: float : 3.5;

// Ensure intro/victory popups always draw above gameplay UI.
POPUP_UI_LAYER :: 10000;

Body_Found_Popup :: class {

	spine_asset: Spine_Asset;
	spine_instance: Spine_Instance;
	
	is_visible: bool;
	show_start_time: float;
	
	init :: proc(using this: Body_Found_Popup) {
		spine_asset = get_asset(Spine_Asset, "anims/Toast/RAND004_toast_text.spine");
		spine_instance = Spine_Instance.create();
		spine_instance.set_skeleton(spine_asset);
		is_visible = false;
		show_start_time = 0.0;
	}

	show :: proc(using this: Body_Found_Popup) {
		is_visible = true;
		show_start_time = get_time();
		spine_instance.set_animation("body_found1b", false, 0);
	}

	hide :: proc(using this: Body_Found_Popup) {
		is_visible = false;
	}

	is_finished :: proc(using this: Body_Found_Popup) -> bool {
		if !is_visible { return true; }
		elapsed := get_time() - show_start_time;
		return elapsed >= POPUP_DURATION;
	}

	update :: proc(using this: Body_Found_Popup, delta_time: float) {
		if !is_visible { return; }
		
		elapsed := get_time() - show_start_time;
		
		// Auto-hide after duration
		if elapsed >= POPUP_DURATION {
			is_visible = false;
			return;
		}

		spine_instance.update(delta_time);
		
		render_popup(this, elapsed);
	}

	render_popup :: proc(using popup: Body_Found_Popup, elapsed: float) {
		UI.push_layer(POPUP_UI_LAYER);
		defer UI.pop_layer();
		screen := UI.get_safe_screen_rect();
		popup_rect := screen.cut_top(150);
		UI.spine(popup_rect.center(), spine_instance, .{50, 50}, 0.0);
	}
}

// Separate function to render the popup with scroll effects
render_popup :: proc(using popup: Body_Found_Popup, elapsed: float) {
	UI.push_layer(POPUP_UI_LAYER);
	defer UI.pop_layer();
	screen := UI.get_safe_screen_rect();
	popup_rect := screen.cut_top(200);
	UI.spine(popup_rect.center(), spine_instance, .{200, 200}, 0.0);
}

Meeting_Called_Popup :: class {

	spine_asset: Spine_Asset;
	spine_instance: Spine_Instance;
	
	is_visible: bool;
	show_start_time: float;
	
	init :: proc(using this: Meeting_Called_Popup) {
		spine_asset = get_asset(Spine_Asset, "anims/Toast/RAND004_toast_text.spine");
		spine_instance = Spine_Instance.create();
		spine_instance.set_skeleton(spine_asset);
		is_visible = false;
		show_start_time = 0.0;
	}

	show :: proc(using this: Meeting_Called_Popup) {
		is_visible = true;
		show_start_time = get_time();
		spine_instance.set_animation("meeting_called", false, 0);
	}

	hide :: proc(using this: Meeting_Called_Popup) {
		is_visible = false;
	}

	is_finished :: proc(using this: Meeting_Called_Popup) -> bool {
		if !is_visible { return true; }
		elapsed := get_time() - show_start_time;
		return elapsed >= POPUP_DURATION;
	}

	update :: proc(using this: Meeting_Called_Popup, delta_time: float) {
		if !is_visible { return; }
		
		elapsed := get_time() - show_start_time;
		
		// Auto-hide after duration
		if elapsed >= POPUP_DURATION {
			is_visible = false;
			return;
		}

		spine_instance.update(delta_time);
		
		render_popup(this, elapsed);
	}
}

// Separate function to render the popup with scroll effects
render_popup :: proc(using popup: Meeting_Called_Popup, elapsed: float) {
	UI.push_layer(POPUP_UI_LAYER);
	defer UI.pop_layer();
	screen := UI.get_safe_screen_rect();
	popup_rect := screen.cut_top(150);
	UI.spine(popup_rect.center(), spine_instance, .{50, 50}, 0.0);
}

Intro_Popup :: class {

	bg_texture: Texture_Asset;

	is_visible: bool;
	show_start_time: float;

	spine_instance: Spine_Instance;
	local_player: Player;
	player_type: Player_Type;
	player_role: Player_Role;

	init :: proc(using this: Intro_Popup) {
		bg_texture = get_asset(Texture_Asset, "sprites/intro.png");
		is_visible = false;
		show_start_time = 0.0;
		local_player = null;
	}

	set_local_player :: proc(using this: Intro_Popup, player: Player) {
		this.spine_instance = player.animator.instance;
		this.local_player = player;
		this.player_type = player.player_type;
		this.player_role = player.player_role;
	}

	show :: proc(using this: Intro_Popup) {
		is_visible = true;
		show_start_time = get_time();
	}

	hide :: proc(using this: Intro_Popup) {
		is_visible = false;
	}

	is_finished :: proc(using this: Intro_Popup) -> bool {
		if !is_visible { return true; }
		elapsed := get_time() - show_start_time;
		return elapsed >= INTRO_POPUP_DURATION;
	}

	update :: proc(using this: Intro_Popup, delta_time: float) {
		if !is_visible { return; }

		elapsed := get_time() - show_start_time;

		// Auto-hide after duration
		if elapsed >= INTRO_POPUP_DURATION {
			is_visible = false;
			return;
		}

		render_popup(this, elapsed);
	}
}

get_type_name :: proc(type: Player_Type) -> string {
	if type == Player_Type.CIVILIAN {
		return "CIVILIAN";
	} else if type == Player_Type.ANARCHIST {
		return "ANARCHIST";
	} else if type == Player_Type.TRAITOR {
		return "TRAITOR";
	}
	return "UNKNOWN";
}

get_role_name :: proc(role: Player_Role) -> string {
	if role == Player_Role.SHERIFF {
		return "Sheriff";
	} else if role == Player_Role.DOCTOR {
		return "Doctor";
	} else if role == Player_Role.PRESIDENT {
		return "President";
	} else if role == Player_Role.MOVIE_STAR {
		return "Movie Star";
	} else if role == Player_Role.CORONER {
		return "Coroner";
	} else if role == Player_Role.PORTAL_MAKER {
		return "Warper";
	} else if role == Player_Role.PIRATE {
		return "Pirate";
	} else if role == Player_Role.HITMAN {
		return "Hitman";
	} else if role == Player_Role.WEREWOLF {
		return "Werewolf";
	} else if role == Player_Role.PRANKSTER {
		return "Prankster";
	} else if role == Player_Role.PYROMANIAC {
		return "Pyromaniac";
	} else if role == Player_Role.HACKER {
		return "Hacker";
	} else if role == Player_Role.GOO_GOO_GAGA {
		return "GooGoo Gaga";
	} else if role == Player_Role.MIMICER {
		return "Mimicer";
	} else if role == Player_Role.BIG_CHARLIE {
		return "Big Charlie";
	} else if role == Player_Role.LILY_LOVEBRAIDS {
		return "Lily";
	}
	return "Normal Dude";
}

get_type_color :: proc(type: Player_Type) -> v4 {
	if type == Player_Type.CIVILIAN {
		return .{0.2, 0.8, 0.4, 1.0}; // Green
	} else if type == Player_Type.ANARCHIST {
		return .{0.9, 0.6, 0.1, 1.0}; // Orange
	} else if type == Player_Type.TRAITOR {
		return .{0.9, 0.2, 0.2, 1.0}; // Red
	}
	return .{1.0, 1.0, 1.0, 1.0};
}

// Separate function to render the popup with scroll effects
render_popup :: proc(using popup: Intro_Popup, elapsed: float) {
	// Calculate animation progress
	bg_progress := clamp(elapsed / 0.5, 0.0, 1.0);
	player_progress := clamp((elapsed - 0.3) / 0.8, 0.0, 1.0);
	type_progress := clamp((elapsed - 0.6) / 0.6, 0.0, 1.0);
	role_progress := clamp((elapsed - 0.9) / 0.6, 0.0, 1.0);

	bg_alpha := Ease.out_cubic(bg_progress);
	player_scale := Ease.out_back(player_progress);
	type_ease := Ease.out_back(type_progress);
	role_ease := Ease.out_elastic(role_progress);

	screen := UI.get_screen_rect();

	UI.push_layer(POPUP_UI_LAYER);
	defer UI.pop_layer();

	// Background with fade in
	bg_rect := screen.fit_aspect(bg_texture.get_aspect(), .KEEP_BIGGER);
	UI.quad(bg_rect, bg_texture, .{1, 1, 1, bg_alpha});

	// Spine in center with scale animation
	spine_size := 150.0 * player_scale;
	spine_rect := screen.center_rect().grow(spine_size);
	spine_rect = spine_rect.offset(0, -400);

	if local_player != null && local_player.intro_role_spine_ready {
		// Render role-specific animation from the player
		if !local_player.intro_is_creature_rig {
			UI.push_player_material(local_player);
			UI.spine(spine_rect.center(), local_player.intro_role_spine, .{200, 200}, 0.0);
			UI.pop_material();
		} else {
			UI.spine(spine_rect.center(), local_player.intro_role_spine, .{200, 200}, 0.0);
		}
	} else if local_player != null {
		// Fallback: render the player's own spine (no role / President)
		UI.push_player_material(local_player);
		UI.spine(spine_rect.center(), spine_instance, .{200, 200}, 0.0);
		UI.pop_material();
	}

	// Type text above player
	type_name := get_type_name(player_type);
	type_color := get_type_color(player_type);

	ts := UI.default_text_settings();
	ts.size = 96;
	ts.color = type_color;
	ts.color.w = type_ease;
	ts.outline_color.w = type_ease;
	ts.drop_shadow_color.w = type_ease;
	ts.halign = .CENTER;
	ts.valign = .CENTER;

	type_rect := screen.center_rect().grow(200);
	type_rect = type_rect.offset(0, 0.0 + 30.0 * (1.0 - type_ease));
	UI.text(type_rect, ts, type_name);

	// Role text below type (if player has a special role)
	role_name := get_role_name(player_role);
	if player_role != Player_Role.NONE && role_name != "" {
		rs := UI.default_text_settings();
		rs.size = 64;
		rs.color = .{1.0, 0.9, 0.3, role_ease}; // Golden color for roles
		rs.outline_color.w = role_ease;
		rs.drop_shadow_color.w = role_ease;
		rs.halign = .CENTER;
		rs.valign = .CENTER;

		role_rect := screen.center_rect().grow(200);
		role_rect = role_rect.offset(0, 90.0 + 50.0 * (1.0 - role_ease));
		UI.text(role_rect, rs, role_name);
	}

	// "You are a..." label at top
	label_ts := UI.default_text_settings();
	label_ts.size = 45;
	label_ts.color = .{1.0, 1.0, 1.0, type_ease * 0.8};
	label_ts.outline_color.w = type_ease * 0.8;
	label_ts.drop_shadow_color.w = type_ease * 0.8;
	label_ts.halign = .CENTER;
	label_ts.valign = .CENTER;

	label_rect := screen.center_rect().grow(150);
	label_rect = label_rect.offset(0, 200);
	UI.text(label_rect, label_ts, "You are a...");
}

// ============================================================
// Role Spin Popup - CS:GO style role roulette
// ============================================================

// Enabled roles for the current round (rebuilt each round by game manager).
spin_enabled_roles: [..]Player_Role;

// Rebuild the list of roles that should appear in the spinner.
// Called at round start, before the spin popup is shown.
spin_rebuild_enabled_roles :: proc() {
	#unsafe spin_enabled_roles.count = 0;
	spin_enabled_roles.append(Player_Role.SHERIFF);
	spin_enabled_roles.append(Player_Role.DOCTOR);
	spin_enabled_roles.append(Player_Role.PRESIDENT);
	spin_enabled_roles.append(Player_Role.MOVIE_STAR);
	spin_enabled_roles.append(Player_Role.CORONER);
	spin_enabled_roles.append(Player_Role.PORTAL_MAKER);
	spin_enabled_roles.append(Player_Role.PRANKSTER);
	spin_enabled_roles.append(Player_Role.PYROMANIAC);
	spin_enabled_roles.append(Player_Role.HACKER);
	spin_enabled_roles.append(Player_Role.PIRATE);
	spin_enabled_roles.append(Player_Role.HITMAN);
	spin_enabled_roles.append(Player_Role.WEREWOLF);
	// GGG: always show in spinner. Non-owners see a lock overlay.
	spin_enabled_roles.append(Player_Role.GOO_GOO_GAGA);
	// Mimicer: always show in spinner. Non-owners see a lock overlay.
	spin_enabled_roles.append(Player_Role.MIMICER);
	// Lily: always show in spinner. Non-owners see a lock overlay.
	spin_enabled_roles.append(Player_Role.LILY_LOVEBRAIDS);
}

// Ensure a role appears in the spinner (e.g. admin-forced roles like Mimicer).
spin_ensure_role :: proc(role: Player_Role) {
	if role == Player_Role.NONE return;
	for i: 0..spin_enabled_roles.count-1 {
		if spin_enabled_roles[i] == role return;
	}
	spin_enabled_roles.append(role);
}

// Map index to a Player_Role from the enabled set.
spin_index_to_role :: proc(idx: int) -> Player_Role {
	if idx >= 0 && idx < spin_enabled_roles.count {
		return spin_enabled_roles[idx];
	}
	return Player_Role.SHERIFF;
}

spin_role_to_icon :: proc(role: Player_Role) -> Texture_Asset {
	switch role {
		case .SHERIFF:      return get_asset(Texture_Asset, "sprites/icons/roles_small/sheriff_icon.png");
		case .DOCTOR:       return get_asset(Texture_Asset, "sprites/icons/roles_small/doctor_icon.png");
		case .PRESIDENT:    return get_asset(Texture_Asset, "sprites/icons/roles_small/president_icon.png");
		case .MOVIE_STAR:   return get_asset(Texture_Asset, "sprites/icons/roles_small/moviestar_icon.png");
		case .CORONER:      return get_asset(Texture_Asset, "sprites/icons/roles_small/coroner_icon.png");
		case .PORTAL_MAKER: return get_asset(Texture_Asset, "sprites/icons/roles_small/portalmaker_icon.png");
		case .PRANKSTER:    return get_asset(Texture_Asset, "sprites/icons/roles_small/trickster_icon.png");
		case .PYROMANIAC:   return get_asset(Texture_Asset, "sprites/icons/roles_small/pyromaniac_icon.png");
		case .HACKER:       return get_asset(Texture_Asset, "sprites/icons/hacker/game_end.png");
		case .PIRATE:       return get_asset(Texture_Asset, "sprites/icons/roles_small/pirate_icon.png");
		case .HITMAN:       return get_asset(Texture_Asset, "sprites/icons/roles_small/hitman_icon.png");
		case .WEREWOLF:     return get_asset(Texture_Asset, "sprites/icons/roles_small/werewolf_icon.png");
		case .GOO_GOO_GAGA: return get_asset(Texture_Asset, "sprites/icons/roles_small/goo_goo_icon.png");
		case .MIMICER:      return get_asset(Texture_Asset, "sprites/icons/roles_small/mimicer_icon.png");
		case .BIG_CHARLIE:  return get_asset(Texture_Asset, "sprites/icons/roles_small/charlie_icon (1).png");
		case .LILY_LOVEBRAIDS: return get_asset(Texture_Asset, "sprites/icons/roles_small/lily_icon (1).png");
	}
	return null;
}

SPIN_HOLD_TIME: float : 0.8;
SPIN_FULL_DURATION: float : 5.3; // SPIN_TOTAL_DURATION + SPIN_HOLD_TIME
SPIN_LANDING_POS :: SPIN_STRIP_COUNT - 8;

// Find the spin index for a given role in the enabled set.
spin_role_to_index :: proc(role: Player_Role) -> int {
	for i: 0..spin_enabled_roles.count-1 {
		if spin_enabled_roles[i] == role {
			return i;
		}
	}
	return 0;
}

Role_Spin_Popup :: class {
	// --- Synced state (set by show(), runs on both server + client) ---
	is_visible: bool;
	show_start_time: float;

	// --- Local state (set per-frame by set_local_player, like Intro_Popup) ---
	target_role: Player_Role;
	target_type: Player_Type;

	// Textures
	star_gold: Texture_Asset;
	star_empty: Texture_Asset;

	init :: proc(using this: Role_Spin_Popup) {
		is_visible = false;
		show_start_time = 0.0;
		star_gold = get_asset(Texture_Asset, "ui/star_gold 2.png");
		star_empty = get_asset(Texture_Asset, "ui/star_empty2 2.png");
	}

	// Called from game state code (runs on server + client)
	show :: proc(using this: Role_Spin_Popup) {
		is_visible = true;
		show_start_time = get_time();
	}

	hide :: proc(using this: Role_Spin_Popup) {
		is_visible = false;
	}

	// Time-based, just like Intro_Popup
	is_finished :: proc(using this: Role_Spin_Popup) -> bool {
		if !is_visible { return true; }
		elapsed := get_time() - show_start_time;
		return elapsed >= SPIN_FULL_DURATION;
	}

	// Called per-frame from player ao_late_update (like intro_popup.set_local_player)
	set_local_player :: proc(using this: Role_Spin_Popup, player: Player) {
		this.target_role = player.player_role;
		this.target_type = player.player_type;
	}

	update :: proc(using this: Role_Spin_Popup, delta_time: float) {
		if !is_visible { return; }

		elapsed := get_time() - show_start_time;

		if elapsed >= SPIN_FULL_DURATION {
			is_visible = false;
			return;
		}

		// Players with no special role see a brief "CIVILIAN" splash instead of a spinner.
		if target_role == Player_Role.NONE {
			render_no_role_splash(this, elapsed);
			return;
		}

		render_spin(this, elapsed);
	}
}

// Generate the role index for a given strip position, deterministically.
// The target role is always placed at SPIN_LANDING_POS; all others are random.
spin_get_card_role_idx :: proc(strip_pos: int, seed: u64, target_role_idx: int) -> int {
	if strip_pos == SPIN_LANDING_POS {
		return target_role_idx;
	}
	// Deterministic per-card seed so the strip is stable across frames
	card_seed: u64 = rng_seed(seed + strip_pos.(u64) * 7919);
	return rng_range_int(ref card_seed, 0, spin_enabled_roles.count - 1);
}

render_no_role_splash :: proc(using popup: Role_Spin_Popup, elapsed: float) {
	UI.push_layer(POPUP_UI_LAYER + 1);
	defer UI.pop_layer();

	screen := UI.get_screen_rect();

	// Quick fade in / out
	fade_in := clamp(elapsed / 0.3, 0.0, 1.0);
	fade_out := clamp((SPIN_FULL_DURATION - elapsed) / 0.3, 0.0, 1.0);
	alpha := min(fade_in, fade_out);

	// Dim background
	UI.quad(screen, core_globals.white_sprite, v4.{0, 0, 0, 0.85 * alpha});

	// Type name
	type_color := get_type_color(target_type);
	type_color.w = alpha;

	ts := UI.default_text_settings();
	ts.size = 96;
	ts.color = type_color;
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 3;
	ts.outline_color = v4.{0, 0, 0, alpha};

	text_rect := screen.center_rect().grow(300);
	text_rect = text_rect.offset(0, 40.0);
	UI.text(text_rect, ts, get_type_name(target_type));

	// Subtitle
	sub := UI.default_text_settings();
	sub.size = 48;
	sub.color = v4.{1, 1, 1, 0.7 * alpha};
	sub.outline_color.w = 0.7 * alpha;
	sub.drop_shadow_color.w = 0.7 * alpha;
	sub.halign = .CENTER;
	sub.valign = .CENTER;

	sub_rect := screen.center_rect().grow(200);
	sub_rect = sub_rect.offset(0, -40.0);
	UI.text(sub_rect, sub, "No special role");
}

render_spin :: proc(using popup: Role_Spin_Popup, elapsed: float) {
	UI.push_layer(POPUP_UI_LAYER + 1);
	defer UI.pop_layer();

	screen := UI.get_screen_rect();
	scale := UI.get_current_scale_factor();

	// Black background with fade-in
	bg_alpha := clamp(elapsed / 0.3, 0.0, 0.98);
	UI.quad(screen, core_globals.white_sprite, v4.{0, 0, 0, bg_alpha});

	// Card dimensions (in scaled px)
	card_w := SPIN_CARD_WIDTH;
	card_h := SPIN_CARD_HEIGHT;
	card_stride := card_w + SPIN_CARD_GAP;

	// Center of screen
	cx := (screen.min.x + screen.max.x) / 2.0;
	cy := (screen.min.y + screen.max.y) / 2.0;

	// Compute scroll offset from elapsed time (cubic ease-out)
	target_offset := SPIN_LANDING_POS.(float) * card_stride;
	scroll_t := clamp(elapsed / SPIN_TOTAL_DURATION, 0.0, 1.0);
	ease := 1.0 - (1.0 - scroll_t) * (1.0 - scroll_t) * (1.0 - scroll_t);
	scroll_offset := ease * target_offset;

	// Strip start: card 0 centered, then shifted left by scroll
	strip_start_x := cx - scroll_offset * scale;

	// Clipping bounds
	screen_left := screen.min.x - card_w * scale;
	screen_right := screen.max.x + card_w * scale;

	// Deterministic seed from show_start_time (same on every frame)
	strip_seed: u64 = (show_start_time * 100000.0).(u64);
	target_role_idx := spin_role_to_index(target_role);

	for i: 0..SPIN_STRIP_COUNT-1 {
		// Card center x in screen pixels
		card_cx := strip_start_x + i.(float) * card_stride * scale;

		// Skip if off screen
		if card_cx < screen_left || card_cx > screen_right {
			continue;
		}

		role_idx := spin_get_card_role_idx(i, strip_seed, target_role_idx);
		role := spin_index_to_role(role_idx);
		rtype := rr_get_role_type(role);
		type_color := get_type_color(rtype);

		// Build card rect centered at (card_cx, cy)
		half_w := card_w * scale / 2.0;
		half_h := card_h * scale / 2.0;
		card_rect := Rect.{
			v2.{card_cx - half_w, cy - half_h},
			v2.{card_cx + half_w, cy + half_h}
		};

		// Card background
		bg_color := v4.{0.12, 0.12, 0.15, 0.95};
		UI.quad(card_rect, core_globals.white_sprite, bg_color);

		// Colored top bar
		bar_rect := Rect.{
			v2.{card_rect.min.x, card_rect.max.y - 6.0 * scale},
			v2.{card_rect.max.x, card_rect.max.y}
		};
		UI.quad(bar_rect, core_globals.white_sprite, type_color);

		// Colored side accents
		side_w := 3.0 * scale;
		left_side := Rect.{
			v2.{card_rect.min.x, card_rect.min.y},
			v2.{card_rect.min.x + side_w, card_rect.max.y}
		};
		right_side := Rect.{
			v2.{card_rect.max.x - side_w, card_rect.min.y},
			v2.{card_rect.max.x, card_rect.max.y}
		};
		border_color := type_color;
		border_color.w = 0.5;
		UI.quad(left_side, core_globals.white_sprite, border_color);
		UI.quad(right_side, core_globals.white_sprite, border_color);

		// Role icon in center
		icon_tex := spin_role_to_icon(role);
		if icon_tex != null {
			icon_size := 132.0 * scale;
			icon_cy := (card_rect.min.y + card_rect.max.y) / 2.0 + 10.0 * scale;
			icon_rect := Rect.{
				v2.{card_cx - icon_size / 2.0, icon_cy - icon_size / 2.0},
				v2.{card_cx + icon_size / 2.0, icon_cy + icon_size / 2.0}
			};
			UI.quad(icon_rect.fit_aspect(icon_tex.get_aspect()), icon_tex, v4.{1, 1, 1, 1});

			name_rect := Rect.{
				v2.{icon_rect.min.x - 34.0 * scale, icon_rect.min.y + 2.0 * scale},
				v2.{icon_rect.max.x + 34.0 * scale, icon_rect.min.y + 42.0 * scale}
			};
			ts := UI.default_text_settings();
			ts.size = 38;
			ts.color = type_color;
			ts.halign = .CENTER;
			ts.valign = .CENTER;
			ts.do_outline = true;
			ts.outline_thickness = 4;
			ts.outline_color = v4.{0, 0, 0, 1};
			ts.do_autofit = false;
			UI.text(name_rect, ts, get_role_name(role));
		}

		// Star rating at bottom
		difficulty := rr_get_role_difficulty(role, rtype);
		STAR_SIZE := 18.0 * scale;
		STAR_GAP := 5.0 * scale;
		star_cy := card_rect.min.y + 35.0 * scale;
		for s: 0..2 {
			offset_x := (s.(float) - 1.0) * (STAR_SIZE * 2.0 + STAR_GAP);
			star_rect := Rect.{
				v2.{card_cx + offset_x - STAR_SIZE, star_cy - STAR_SIZE},
				v2.{card_cx + offset_x + STAR_SIZE, star_cy + STAR_SIZE}
			};
			star_tex := star_empty;
			if s < difficulty { star_tex = star_gold; }
			if star_tex != null {
				UI.quad(star_rect.fit_aspect(star_tex.get_aspect()), star_tex, v4.{1, 1, 1, 1});
			}
		}

		// Lock overlay for purchase-gated roles the local player doesn't own
		is_locked := false;
		if rp_is_purchase_gated(role) && role != target_role {
			lock_local_p, lock_local_ok := Game.get_local_player();
			if !lock_local_ok || lock_local_p == null || rp_is_role_locked(lock_local_p, role) {
				is_locked = true;
			}
		}
		if is_locked {
			// Dark overlay
			UI.quad(card_rect, core_globals.white_sprite, v4.{0, 0, 0, 0.7});

			// Lock icon (centered in card)
			lock_size := 60.0 * scale;
			lock_cy := (card_rect.min.y + card_rect.max.y) / 2.0 + 20.0 * scale;
			lock_rect := Rect.{
				v2.{card_cx - lock_size / 2.0, lock_cy - lock_size / 2.0},
				v2.{card_cx + lock_size / 2.0, lock_cy + lock_size / 2.0}
			};
			lock_tex := get_asset(Texture_Asset, "icon/Lock Outline 64.png");
			if lock_tex != null {
				UI.quad(lock_rect.fit_aspect(lock_tex.get_aspect()), lock_tex, v4.{1, 1, 1, 0.9});
			}

			// "LOCKED" text below icon
			lock_ts := UI.default_text_settings();
			lock_ts.size = 28;
			lock_ts.color = v4.{1, 1, 1, 0.9};
			lock_ts.halign = .CENTER;
			lock_ts.valign = .CENTER;
			lock_ts.do_outline = true;
			lock_ts.outline_thickness = 3;
			lock_ts.outline_color = v4.{0, 0, 0, 1};
			lock_text_rect := Rect.{
				v2.{card_rect.min.x, lock_cy - lock_size - 25.0 * scale},
				v2.{card_rect.max.x, lock_cy - lock_size}
			};
			UI.text(lock_text_rect, lock_ts, "LOCKED");
		}
	}

	// Center indicator line (the selector tick)
	tick_w := 3.0 * scale;
	tick_h := (card_h + 30.0) * scale;
	tick_rect := Rect.{
		v2.{cx - tick_w, cy - tick_h / 2.0},
		v2.{cx + tick_w, cy + tick_h / 2.0}
	};
	UI.quad(tick_rect, core_globals.white_sprite, v4.{1, 1, 1, 0.9});

	// Small triangles above and below center
	tri_size := 10.0 * scale;
	top_tri := Rect.{
		v2.{cx - tri_size, cy + tick_h / 2.0},
		v2.{cx + tri_size, cy + tick_h / 2.0 + tri_size}
	};
	bottom_tri := Rect.{
		v2.{cx - tri_size, cy - tick_h / 2.0 - tri_size},
		v2.{cx + tri_size, cy - tick_h / 2.0}
	};
	UI.quad(top_tri, core_globals.white_sprite, v4.{1, 1, 1, 0.9});
	UI.quad(bottom_tri, core_globals.white_sprite, v4.{1, 1, 1, 0.9});

	// "ROLE SELECT" title at top
	title_alpha := clamp(elapsed / 0.3, 0.0, 0.9);
	title_ts := UI.default_text_settings();
	title_ts.size = 52;
	title_ts.color = v4.{1, 1, 1, title_alpha};
	title_ts.halign = .CENTER;
	title_ts.valign = .CENTER;
	title_ts.do_outline = true;
	title_ts.outline_thickness = 3;
	title_ts.outline_color = v4.{0, 0, 0, title_alpha};
	title_ts.drop_shadow_color.w = title_alpha;
	title_rect := screen.center_rect().grow_unscaled(0, screen.width() / 2.0, 0, screen.width() / 2.0).offset(0, card_h / 2.0 + 60.0);
	UI.text(title_rect, title_ts, "ROLE SELECT");

	// After landing, flash the selected card with a pulsing glow
	if elapsed >= SPIN_TOTAL_DURATION {
		flash_t := elapsed - SPIN_TOTAL_DURATION;
		pulse := 0.5 + 0.5 * sin(flash_t * 8.0);
		glow_color := get_type_color(target_type);
		glow_color.w = 0.3 * pulse;

		landing_cx := strip_start_x + SPIN_LANDING_POS.(float) * card_stride * scale;
		half_w := card_w * scale / 2.0;
		half_h := card_h * scale / 2.0;
		glow_rect := Rect.{
			v2.{landing_cx - half_w - 4.0 * scale, cy - half_h - 4.0 * scale},
			v2.{landing_cx + half_w + 4.0 * scale, cy + half_h + 4.0 * scale}
		};
		UI.quad(glow_rect, core_globals.white_sprite, glow_color);
	}
}

VICTORY_POPUP_DURATION: float : 2;
MAX_WINNERS_DISPLAYED: int : 6;

Victory_Popup :: class {

	bg_texture: Texture_Asset;
	
	is_visible: bool;
	show_start_time: float;

	winning_type: Player_Type;
	winner_spines: List(Spine_Instance);
	winner_names: List(string);
	winner_players: List(Player);
	
	init :: proc(using this: Victory_Popup) {
		bg_texture = get_asset(Texture_Asset, "sprites/win.png");
		is_visible = false;
		show_start_time = 0.0;
		winner_spines = List(Spine_Instance).{};
		winner_names = List(string).{};
		winner_players = List(Player).{};
	}

	show :: proc(using this: Victory_Popup, victor_type: Player_Type, winners: List(Player)) {
		is_visible = true;
		show_start_time = get_time();
		this.winning_type = victor_type;

		// Local end-game audio (victory/defeat).
		// Clients play based on their own team; server should not play UI audio.
		if !Game.is_server() {
			local_player: Player = null;
			for p: component_iterator(Player) {
				if p != null && #alive(p.entity) && p.is_local() {
					local_player = p;
					break;
				}
			}

			won := true;
			if local_player != null {
				won = local_player.player_type == victor_type;
			}

			// Non-positional UI cue so it plays reliably regardless of where the
			// local player ended up (e.g. pulled to Lily's mouth during Deathbraid).
			sfx := SFX.default_sfx_desc();
			sfx.volume = 0.95;
			sfx.volume_perturb = 0.0;
			sfx.speed_perturb = 0.0;
			// Global SFX mix: everything at 25% volume.
			sfx.volume *= 0.25;
			sfx.volume_perturb *= 0.25;

			asset := won ? "sfx/end_game_victory.wav" : "sfx/defeat.wav";
			if !won {
				sfx.volume *= 0.5;
			}
			rr_play_sfx(asset, sfx);
		}
		
		// Clear previous winners
		winner_spines = List(Spine_Instance).{};
		winner_names = List(string).{};
		winner_players = List(Player).{};
		
		// Collect winning players' spines and names
		for i: 0..winners.elements.count-1 {
			if i >= MAX_WINNERS_DISPLAYED { break; }
			p := winners.elements[i];
			if p != null && #alive(p.entity) {
				append(ref winner_spines, p.animator.instance);
				append(ref winner_names, p.entity.get_name());
				append(ref winner_players, p);
			}
		}
	}

	hide :: proc(using this: Victory_Popup) {
		is_visible = false;
	}

	is_finished :: proc(using this: Victory_Popup) -> bool {
		if !is_visible { return true; }
		elapsed := get_time() - show_start_time;
		return elapsed >= VICTORY_POPUP_DURATION;
	}

	update :: proc(using this: Victory_Popup, delta_time: float) {
		if !is_visible { return; }
		
		elapsed := get_time() - show_start_time;
		
		// Auto-hide after duration
		if elapsed >= VICTORY_POPUP_DURATION {
			is_visible = false;
			return;
		}
		
		render_popup(this, elapsed);
	}
}

// Separate function to render the victory popup
render_popup :: proc(using popup: Victory_Popup, elapsed: float) {
	// Calculate animation progress
	bg_progress := clamp(elapsed / 0.5, 0.0, 1.0);
	title_progress := clamp((elapsed - 0.3) / 0.6, 0.0, 1.0);
	players_progress := clamp((elapsed - 0.6) / 0.8, 0.0, 1.0);
	
	bg_alpha := Ease.out_cubic(bg_progress);
	title_ease := Ease.out_back(title_progress);
	players_ease := Ease.out_back(players_progress);
	
	screen := UI.get_screen_rect();

	UI.push_layer(POPUP_UI_LAYER);
	defer UI.pop_layer();
	
	// Background with fade in
	bg_rect := screen.fit_aspect(bg_texture.get_aspect(), .KEEP_BIGGER);
	UI.quad(bg_rect, bg_texture, .{1, 1, 1, bg_alpha});
	
	// Victory title
	type_name := get_type_name(winning_type);
	type_color := get_type_color(winning_type);

	// For anarchist wins, show the actual role name (e.g. "PRANKSTER VICTORY!") instead of generic "ANARCHIST".
	if winning_type == Player_Type.ANARCHIST && winner_players.elements.count > 0 {
		first_winner := winner_players.elements[0];
		if first_winner != null {
			if first_winner.player_role == Player_Role.PRANKSTER {
				type_name = "PRANKSTER";
			} else if first_winner.player_role == Player_Role.PYROMANIAC {
				type_name = "PYROMANIAC";
			} else if first_winner.player_role == Player_Role.HACKER {
				type_name = "HACKER";
			} else if first_winner.player_role == Player_Role.BIG_CHARLIE {
				type_name = "BIG CHARLIE";
			}
		}
	}
	
	title_ts := UI.default_text_settings();
	title_ts.size = 72;
	title_ts.color = type_color;
	title_ts.color.w = title_ease;
	title_ts.outline_color.w = title_ease;
	title_ts.drop_shadow_color.w = title_ease;
	title_ts.halign = .CENTER;
	title_ts.valign = .CENTER;

	title_rect := screen.center_rect().grow(300);
	title_rect = title_rect.offset(0, 250.0 + 40.0 * (1.0 - title_ease));
	UI.text(title_rect, title_ts, format_string("% VICTORY!", .{type_name}));

	// "Winners" subtitle
	sub_ts := UI.default_text_settings();
	sub_ts.size = 48;
	sub_ts.color = .{1.0, 1.0, 1.0, title_ease * 0.8};
	sub_ts.outline_color.w = title_ease * 0.8;
	sub_ts.drop_shadow_color.w = title_ease * 0.8;
	sub_ts.halign = .CENTER;
	sub_ts.valign = .CENTER;
	
	sub_rect := screen.center_rect().grow(200);
	sub_rect = sub_rect.offset(0.0, 180.0);
	UI.text(sub_rect, sub_ts, "Winners");
	
	// Display winning players in a row
	winner_count := winner_spines.elements.count;
	if winner_count > 0 {
		// Calculate spacing for players
		total_width := 1200.0;
		player_spacing := total_width / (winner_count.(float) + 1.0);
		start_x := -total_width / 2.0 + player_spacing;
		
		for i: 0..winner_count-1 {
			// Stagger the animation for each player
			player_delay := 0.1 * i.(float);
			player_progress := clamp((elapsed - 0.8 - player_delay) / 0.6, 0.0, 1.0);
			player_ease := Ease.out_elastic(player_progress);
			
			x_offset := start_x + player_spacing * i.(float);
			
			// Player spine
			player_rect := screen.center_rect().grow(80);
			player_rect = player_rect.offset(x_offset, -300.0 + 30.0 * (1.0 - player_ease));

			// Use proper cosmetics/material for the winner.
			p := winner_players.elements[i];
			if p != null {
				UI.push_player_material(p);
				UI.spine(player_rect.center(), winner_spines.elements[i], .{180, 180}, 0.0);
				UI.pop_material();
			} else {
				UI.spine(player_rect.center(), winner_spines.elements[i], .{180, 180}, 0.0);
			}
			
			// Player name below
			name_ts := UI.default_text_settings();
			name_ts.size = 48;
			name_ts.color = .{1.0, 1.0, 1.0, player_ease};
			name_ts.outline_color.w = player_ease;
			name_ts.drop_shadow_color.w = player_ease;
			name_ts.halign = .CENTER;
			name_ts.valign = .CENTER;
			
			name_rect := screen.center_rect().grow(100);
			name_rect = name_rect.offset(x_offset, -100.0);
			UI.text(name_rect, name_ts, winner_names.elements[i]);
		}
	}
}

MIMICER_JUMPSCARE_DURATION: float : 0.7;
