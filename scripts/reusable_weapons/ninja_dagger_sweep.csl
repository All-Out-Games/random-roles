// Adapted from All-Out-Games/reusable-weapons-csl: beam_detection.csl,
// beam_line_damage, and projectile_standard.csl. Nonlethal Player target adapter.
// https://github.com/All-Out-Games/reusable-weapons-csl
// Reuses projection/width collision with nearest-hit ordering and segment endcaps.
reusable_ninja_dagger_hit :: proc(owner_user_id: string, origin: v2, head: v2, width: float) -> Player {
    delta := head - origin;
    distance := length(delta);
    if distance < 0.0001 return null;
    dir := delta / distance;
    best: Player;
    best_along := 1000000.0;
    for target: component_iterator(Player) {
        if target.get_user_id() == owner_user_id || target.player_state != .ALIVE continue;
        if rr_mech_is_carried(target) || target.bc_cocooned continue;
        to_target := target.entity.world_position - origin;
        along := to_target.x * dir.x + to_target.y * dir.y;
        projected := dir * clamp(along, 0.0, distance);
        if length_squared(to_target - projected) > width * width continue;
        if along < best_along {
            best = target;
            best_along = along;
        }
    }
    return best;
}
