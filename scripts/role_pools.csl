// role_pools.csl
// ────────────────────────────────────────────────────────────────────
// Purchase-weighted role pool system.
//
// Players who own a role product get that role added to their personal
// pool AND a decaying probability boost to land on it each round.
//
//   Usage count     Boost chance
//   ───────────     ────────────
//   0 – 4           80 %
//   5 – 24          33 %
//   25 +             0 % (normal odds)
//
// The system preserves exact type-count targets (civilian / anarchist /
// traitor distribution) while giving boosted players priority access to
// available slots of their target type and specific role.
// ────────────────────────────────────────────────────────────────────

// ── Product configuration ───────────────────────────────────────────
GGG_PRODUCT_ID         :: "69b1aa6e3a1668e54467c5d4";
GGG_USAGE_KEY          :: "purchase_usage_69b1aa6e3a1668e54467c5d4";
MIMICER_PRODUCT_ID     :: "69d67dac5a645398b8c19d96";
MIMICER_USAGE_KEY      :: "purchase_usage_69d67dac5a645398b8c19d96";
LILY_PRODUCT_ID        :: "69e7ceac7c51b1e14b7a5611";
LILY_USAGE_KEY         :: "purchase_usage_69e7ceac7c51b1e14b7a5611";
BIG_CHARLIE_PRODUCT_ID :: "69fe2c16961587c2b549b47b";
BIG_CHARLIE_USAGE_KEY  :: "purchase_usage_69fe2c16961587c2b549b47b";

// ── Boost tiers ─────────────────────────────────────────────────────
RP_BOOST_HIGH           :: 0.80;
RP_BOOST_LOW            :: 0.33;
RP_BOOST_THRESHOLD_MID  :: 5;
RP_BOOST_THRESHOLD_GONE :: 25;
RP_ROLE_TYPE_BOOST_CHANCE :: 0.65;

// ── Per-player boost descriptor (transient, rebuilt each round) ─────
Role_Boost_Info :: struct {
    has_boost: bool;
    role:      Player_Role;
    role_type: Player_Type;
    chance:    float;
}

rp_set_type_boost_candidate :: proc(out: ref [..]Role_Boost_Info, role_type: Player_Type, chance: float) {
    if chance <= 0.0 return;
    for i: 0..out.count - 1 {
        if out[i].role_type == role_type {
            if chance > out[i].chance {
                out[i].chance = chance;
            }
            return;
        }
    }

    c: Role_Boost_Info;
    c.has_boost = true;
    c.role      = Player_Role.NONE;
    c.role_type = role_type;
    c.chance    = chance;
    out.append(c);
}

rp_sort_boost_candidates :: proc(out: ref [..]Role_Boost_Info) {
    if out.count <= 1 return;
    for a: 0..out.count - 2 {
        best := a;
        for b: a + 1..out.count - 1 {
            if out[b].chance > out[best].chance { best = b; }
        }
        if best != a {
            tmp := out[a];
            out[a] = out[best];
            out[best] = tmp;
        }
    }
}

// Returns true if any connected player owns the given product.
rp_any_player_owns :: proc(players: ref List(Player), product_id: string) -> bool {
    for i: 0..players.elements.count - 1 {
        p := players.elements[i];
        if p != null && Purchasing.owns_product(p, product_id) return true;
    }
    return false;
}

// Returns true if the role is behind a purchase gate.
rp_is_purchase_gated :: proc(role: Player_Role) -> bool {
    if role == Player_Role.GOO_GOO_GAGA return true;
    if role == Player_Role.MIMICER return true;
    if role == Player_Role.LILY_LOVEBRAIDS return true;
    if role == Player_Role.BIG_CHARLIE return true;
    return false;
}

// Returns true if the role requires a purchase and the player doesn't own it.
rp_is_role_locked :: proc(player: Player, role: Player_Role) -> bool {
    if role == Player_Role.GOO_GOO_GAGA {
        return !Purchasing.owns_product(player, GGG_PRODUCT_ID);
    }
    if role == Player_Role.MIMICER {
        return !Purchasing.owns_product(player, MIMICER_PRODUCT_ID);
    }
    if role == Player_Role.LILY_LOVEBRAIDS {
        return !Purchasing.owns_product(player, LILY_PRODUCT_ID);
    }
    if role == Player_Role.BIG_CHARLIE {
        return !Purchasing.owns_product(player, BIG_CHARLIE_PRODUCT_ID);
    }
    return false;
}

// Returns boost probability based on cumulative usage count.
rp_get_boost_chance :: proc(usage_count: int) -> float {
    if usage_count < RP_BOOST_THRESHOLD_MID  return RP_BOOST_HIGH;
    if usage_count < RP_BOOST_THRESHOLD_GONE return RP_BOOST_LOW;
    return 0.0;
}

// Returns the player's owned boostable roles with chance > 0, sorted by chance desc.
rp_collect_player_boost_candidates :: proc(player: Player, out: ref [..]Role_Boost_Info) {
    if player == null return;

    if Purchasing.owns_product(player, GGG_PRODUCT_ID) {
        usage  := Save.get_int(player, GGG_USAGE_KEY, 0);
        chance := rp_get_boost_chance(usage.(int));
        if chance > 0.0 {
            c: Role_Boost_Info;
            c.role      = Player_Role.GOO_GOO_GAGA;
            c.role_type = Player_Type.TRAITOR;
            c.chance    = chance;
            out.append(c);
        }
    }
    if Purchasing.owns_product(player, MIMICER_PRODUCT_ID) {
        usage  := Save.get_int(player, MIMICER_USAGE_KEY, 0);
        chance := rp_get_boost_chance(usage.(int));
        if chance > 0.0 {
            c: Role_Boost_Info;
            c.role      = Player_Role.MIMICER;
            c.role_type = Player_Type.TRAITOR;
            c.chance    = chance;
            out.append(c);
        }
    }
    if Purchasing.owns_product(player, LILY_PRODUCT_ID) {
        usage  := Save.get_int(player, LILY_USAGE_KEY, 0);
        chance := rp_get_boost_chance(usage.(int));
        if chance > 0.0 {
            c: Role_Boost_Info;
            c.role      = Player_Role.LILY_LOVEBRAIDS;
            c.role_type = Player_Type.TRAITOR;
            c.chance    = chance;
            out.append(c);
        }
    }
    if Purchasing.owns_product(player, BIG_CHARLIE_PRODUCT_ID) {
        usage  := Save.get_int(player, BIG_CHARLIE_USAGE_KEY, 0);
        chance := rp_get_boost_chance(usage.(int));
        if chance > 0.0 {
            c: Role_Boost_Info;
            c.role      = Player_Role.BIG_CHARLIE;
            c.role_type = Player_Type.ANARCHIST;
            c.chance    = chance;
            out.append(c);
        }
    }

    if out.count <= 1 return;
    for a: 0..out.count - 2 {
        best := a;
        for b: a + 1..out.count - 1 {
            if out[b].chance > out[best].chance { best = b; }
        }
        if best != a {
            tmp := out[a];
            out[a] = out[best];
            out[best] = tmp;
        }
    }
}

// Query a player's active boost (if any). Picks the highest boost when multiple are owned.
rp_get_player_boost :: proc(player: Player) -> Role_Boost_Info {
    info: Role_Boost_Info;
    if player == null return info;

    // ── GGG ──
    if Purchasing.owns_product(player, GGG_PRODUCT_ID) {
        usage := Save.get_int(player, GGG_USAGE_KEY, 0);
        chance := rp_get_boost_chance(usage.(int));
        if chance > info.chance {
            info.has_boost = true;
            info.role      = Player_Role.GOO_GOO_GAGA;
            info.role_type = Player_Type.TRAITOR;
            info.chance    = chance;
        }
    }

    // ── Mimicer ──
    if Purchasing.owns_product(player, MIMICER_PRODUCT_ID) {
        usage := Save.get_int(player, MIMICER_USAGE_KEY, 0);
        chance := rp_get_boost_chance(usage.(int));
        if chance > info.chance {
            info.has_boost = true;
            info.role      = Player_Role.MIMICER;
            info.role_type = Player_Type.TRAITOR;
            info.chance    = chance;
        }
    }

    // ── Lily ──
    if Purchasing.owns_product(player, LILY_PRODUCT_ID) {
        usage := Save.get_int(player, LILY_USAGE_KEY, 0);
        chance := rp_get_boost_chance(usage.(int));
        if chance > info.chance {
            info.has_boost = true;
            info.role      = Player_Role.LILY_LOVEBRAIDS;
            info.role_type = Player_Type.TRAITOR;
            info.chance    = chance;
        }
    }

    // ── Big Charlie ──
    if Purchasing.owns_product(player, BIG_CHARLIE_PRODUCT_ID) {
        usage := Save.get_int(player, BIG_CHARLIE_USAGE_KEY, 0);
        chance := rp_get_boost_chance(usage.(int));
        if chance > info.chance {
            info.has_boost = true;
            info.role      = Player_Role.BIG_CHARLIE;
            info.role_type = Player_Type.ANARCHIST;
            info.chance    = chance;
        }
    }

    return info;
}

rp_loadout_has_role_restriction_for_type :: proc(ld: Loadout_Data, ptype: Player_Type) -> bool {
    if ld == null return false;
    if ptype == Player_Type.TRAITOR return ld.traitors.count > 0;
    if ptype == Player_Type.CIVILIAN return ld.civilians.count > 0;
    if ptype == Player_Type.ANARCHIST return ld.anarchists.count > 0;
    return false;
}

rp_claimed_contains :: proc(claimed: [..]Player_Role, role: Player_Role) -> bool {
    for c: 0..claimed.count - 1 {
        if claimed[c] == role return true;
    }
    return false;
}

// Persist that a player received their boosted role (server-only).
rp_record_boost_used :: proc(player: Player, role: Player_Role) {
    if !Game.is_server() return;
    if role == Player_Role.GOO_GOO_GAGA {
        current := Save.get_int(player, GGG_USAGE_KEY, 0);
        Save.set_int(player, GGG_USAGE_KEY, current + 1);
    }
    if role == Player_Role.MIMICER {
        current := Save.get_int(player, MIMICER_USAGE_KEY, 0);
        Save.set_int(player, MIMICER_USAGE_KEY, current + 1);
    }
    if role == Player_Role.LILY_LOVEBRAIDS {
        current := Save.get_int(player, LILY_USAGE_KEY, 0);
        Save.set_int(player, LILY_USAGE_KEY, current + 1);
    }
    if role == Player_Role.BIG_CHARLIE {
        current := Save.get_int(player, BIG_CHARLIE_USAGE_KEY, 0);
        Save.set_int(player, BIG_CHARLIE_USAGE_KEY, current + 1);
    }
}

// ════════════════════════════════════════════════════════════════════
//  Phase 1 — Player-type assignment with boosts
// ════════════════════════════════════════════════════════════════════
// Sets player_type on each unforced player in-place.
// Boosted players roll for priority on their target type slot;
// total type distribution is preserved exactly.
rp_assign_player_types :: proc(
    unforced:      ref [..]Player,
    remaining_civ: int,
    remaining_an:  int,
    remaining_tr:  int,
    rng:           ref u64
) {
    count := unforced.count;
    if count <= 0 return;

    // Shuffle the unforced list so priority among boosted players is fair.
    for i: 0..count - 1 {
        j := rng_range_int(ref rng, i, count - 1);
        tmp := unforced[i];
        unforced[i] = unforced[j];
        unforced[j] = tmp;
    }

    type_locked: [..]bool;
    for i: 0..count - 1 { type_locked.append(false); }

    loadouts: [..]Loadout_Data;
    for i: 0..count - 1 {
        loadouts.append(loadout_load_for_player(unforced[i]));
    }

    r_civ := remaining_civ;
    r_an  := remaining_an;
    r_tr  := remaining_tr;

    // Pass 1 — boosted players roll for their target type.
    for i: 0..count - 1 {
        boost := rp_get_player_boost(unforced[i]);
        if !boost.has_boost continue;

        // Check available slots for the target type.
        slots := 0;
        if boost.role_type == Player_Type.CIVILIAN  { slots = r_civ; }
        if boost.role_type == Player_Type.ANARCHIST { slots = r_an; }
        if boost.role_type == Player_Type.TRAITOR   { slots = r_tr; }
        if slots <= 0 continue;

        roll := rng_range_float(ref rng, 0.0, 1.0);
        if roll > boost.chance continue;

        unforced[i].player_type = boost.role_type;
        type_locked[i] = true;
        if boost.role_type == Player_Type.CIVILIAN  { r_civ -= 1; }
        if boost.role_type == Player_Type.ANARCHIST { r_an  -= 1; }
        if boost.role_type == Player_Type.TRAITOR   { r_tr  -= 1; }
    }

    // Pass 2 — build and shuffle type list for remaining players.
    // Consumable role-type boosts from the hub loadout.
    for i: 0..count - 1 {
        if type_locked[i] continue;

        candidates: [..]Role_Boost_Info;
        if loadout_role_boost_remaining(loadouts[i], Player_Type.TRAITOR) > 0 {
            rp_set_type_boost_candidate(ref candidates, Player_Type.TRAITOR, RP_ROLE_TYPE_BOOST_CHANCE);
        }
        if loadout_role_boost_remaining(loadouts[i], Player_Type.ANARCHIST) > 0 {
            rp_set_type_boost_candidate(ref candidates, Player_Type.ANARCHIST, RP_ROLE_TYPE_BOOST_CHANCE);
        }
        if loadout_role_boost_remaining(loadouts[i], Player_Type.CIVILIAN) > 0 {
            rp_set_type_boost_candidate(ref candidates, Player_Type.CIVILIAN, RP_ROLE_TYPE_BOOST_CHANCE);
        }
        rp_sort_boost_candidates(ref candidates);

        for ci: 0..candidates.count - 1 {
            boost := candidates[ci];
            slots := 0;
            if boost.role_type == Player_Type.CIVILIAN  { slots = r_civ; }
            if boost.role_type == Player_Type.ANARCHIST { slots = r_an; }
            if boost.role_type == Player_Type.TRAITOR   { slots = r_tr; }
            if slots <= 0 continue;

            roll := rng_range_float(ref rng, 0.0, 1.0);
            if roll > boost.chance continue;

            unforced[i].player_type = boost.role_type;
            type_locked[i] = true;
            if boost.role_type == Player_Type.CIVILIAN  { r_civ -= 1; }
            if boost.role_type == Player_Type.ANARCHIST { r_an  -= 1; }
            if boost.role_type == Player_Type.TRAITOR   { r_tr  -= 1; }
            break;
        }
    }

    type_list: [..]Player_Type;
    for i: 0..r_civ - 1 { type_list.append(Player_Type.CIVILIAN); }
    for i: 0..r_an - 1  { type_list.append(Player_Type.ANARCHIST); }
    for i: 0..r_tr - 1  { type_list.append(Player_Type.TRAITOR); }

    unassigned := 0;
    for i: 0..count - 1 { if !type_locked[i] { unassigned += 1; } }
    while type_list.count < unassigned {
        type_list.append(Player_Type.CIVILIAN);
    }

    // Fisher-Yates shuffle.
    for i: 0..type_list.count - 1 {
        j := rng_range_int(ref rng, i, type_list.count - 1);
        tmp := type_list[i];
        type_list[i] = type_list[j];
        type_list[j] = tmp;
    }

    idx := 0;
    for i: 0..count - 1 {
        if type_locked[i] continue;
        if idx < type_list.count {
            unforced[i].player_type = type_list[idx];
            idx += 1;
        } else {
            unforced[i].player_type = Player_Type.CIVILIAN;
        }
    }

    for i: 0..count - 1 {
        loadout_role_boost_consume(unforced[i], loadouts[i], unforced[i].player_type);
    }

}

// ════════════════════════════════════════════════════════════════════
//  Phase 2 — Specific role assignment with boosts
// ════════════════════════════════════════════════════════════════════
// For a single type's player list, assigns specific roles.
// Boosted winners get their role directly; remaining players draw
// from the bag as usual.  At most one player can claim each boosted
// role per round.
rp_assign_roles_for_type :: proc(
    type_players:     ref List(Player),
    bag:              ref List(Player_Role),
    master:           List(Player_Role),
    rng:              ref u64,
    allow_duplicates: bool
) {
    count := type_players.elements.count;
    if count <= 0 return;

    // Shuffle for base randomness.
    shuffle_player_list(ref type_players);

    // ── Loadout cache ───────────────────────────────────────────────
    // One Save.try_get_json per player, reused across both passes below.
    // null entries mean "no saved loadout" → loadout_player_allows_role
    // treats that as allow-all.
    loadouts: [..]Loadout_Data;
    for i: 0..count - 1 {
        loadouts.append(loadout_load_for_player(type_players.elements[i]));
    }

    // ── Boost pass ──────────────────────────────────────────────────
    // Boost > loadout: a boost win bypasses the loadout filter entirely.
    boost_won:  [..]bool;
    boost_role: [..]Player_Role;
    for i: 0..count - 1 {
        boost_won.append(false);
        boost_role.append(Player_Role.NONE);
    }

    claimed: [..]Player_Role;
    boost_winner_count := 0;

    for i: 0..count - 1 {
        p := type_players.elements[i];

        candidates: [..]Role_Boost_Info;
        rp_collect_player_boost_candidates(p, ref candidates);
        if candidates.count == 0 continue;

        won_role: Player_Role = Player_Role.NONE;
        for ci: 0..candidates.count - 1 {
            cand := candidates[ci];
            if cand.role_type != p.player_type continue;

            // One claim per boosted role per round.
            is_claimed := false;
            for c: 0..claimed.count - 1 {
                if claimed[c] == cand.role { is_claimed = true; break; }
            }
            if is_claimed continue;

            roll := rng_range_float(ref rng, 0.0, 1.0);
            if roll > cand.chance continue;

            won_role = cand.role;
            break;
        }
        if won_role == Player_Role.NONE continue;

        boost_won[i]  = true;
        boost_role[i] = won_role;
        claimed.append(won_role);
        boost_winner_count += 1;
        rp_record_boost_used(p, won_role);
    }

    // ── Draw remaining roles from bag ───────────────────────────────
    // Strict loadout pass: players with a non-empty allow-list for this team
    // get an eligible role before the generic bag draw. This prevents a
    // Sparks-only traitor loadout from rejecting all drawn base traitor roles
    // and staying Player_Role.NONE ("Normal Dude").
    loadout_won:  [..]bool;
    loadout_role: [..]Player_Role;
    for i: 0..count - 1 {
        loadout_won.append(false);
        loadout_role.append(Player_Role.NONE);
    }

    loadout_winner_count := 0;
    for i: 0..count - 1 {
        if boost_won[i] continue;
        p := type_players.elements[i];
        if !rp_loadout_has_role_restriction_for_type(loadouts[i], p.player_type) continue;

        eligible: [..]Player_Role;
        for m: 0..master.elements.count - 1 {
            role := master.elements[m];
            if rp_is_role_locked(p, role) continue;
            if !loadout_player_allows_role(loadouts[i], role) continue;

            if !allow_duplicates && rp_claimed_contains(claimed, role) continue;

            eligible.append(role);
        }

        if eligible.count <= 0 continue;

        pick := rng_range_int(ref rng, 0, eligible.count - 1);
        won_role := eligible[pick];
        loadout_won[i] = true;
        loadout_role[i] = won_role;
        if !allow_duplicates {
            claimed.append(won_role);
        }
        loadout_winner_count += 1;
    }

    normal_count := count - boost_winner_count - loadout_winner_count;

    // Build filtered master excluding claimed boost roles.
    filtered_master: List(Player_Role);
    for m: 0..master.elements.count - 1 {
        is_claimed := false;
        for c: 0..claimed.count - 1 {
            if master.elements[m] == claimed[c] { is_claimed = true; break; }
        }
        if !is_claimed {
            append(ref filtered_master, master.elements[m]);
        }
    }

    // Rebuild the persistent bag without claimed roles to stay in sync.
    cleaned_bag: List(Player_Role);
    for b: 0..bag.elements.count - 1 {
        is_claimed := false;
        for c: 0..claimed.count - 1 {
            if bag.elements[b] == claimed[c] { is_claimed = true; break; }
        }
        if !is_claimed {
            append(ref cleaned_bag, bag.elements[b]);
        }
    }
    bag = cleaned_bag;

    drawn := draw_roles_from_bag(ref bag, filtered_master, normal_count, allow_duplicates);
    // ── Final assignment (ownership-aware) ────────────────────────────
    // Assign boost winners their roles first.
    assigned: [..]bool;
    for i: 0..count - 1 {
        if boost_won[i] {
            type_players.elements[i].player_role = boost_role[i];
        } else if loadout_won[i] {
            type_players.elements[i].player_role = loadout_role[i];
        }
        assigned.append(boost_won[i] || loadout_won[i]);
    }

    drawn_used: [..]bool;
    for d: 0..drawn.elements.count - 1 { drawn_used.append(false); }

    // Build a non-gated master for redrawing replacements.
    ungated_master: List(Player_Role);
    for m: 0..master.elements.count - 1 {
        if !rp_is_purchase_gated(master.elements[m]) {
            append(ref ungated_master, master.elements[m]);
        }
    }

    // Pass 1: assign purchase-gated roles to eligible owners only.
    // Eligibility now also requires the player's loadout to permit the role
    // (boost wins above already bypassed loadout). If no eligible owner
    // exists the role is discarded and replaced with a fresh draw from
    // ungated_master, which pass 2 then tries to place.
    for d: 0..drawn.elements.count - 1 {
        role := drawn.elements[d];
        if !rp_is_purchase_gated(role) continue; // free role, handle in pass 2
        if !allow_duplicates && rp_claimed_contains(claimed, role) {
            drawn_used[d] = true;
            continue;
        }
        found_owner := false;
        for i: 0..count - 1 {
            if assigned[i] continue;
            if rp_is_role_locked(type_players.elements[i], role) continue;
            if !loadout_player_allows_role(loadouts[i], role) continue;
            type_players.elements[i].player_role = role;
            assigned[i] = true;
            drawn_used[d] = true;
            if !allow_duplicates {
                claimed.append(role);
            }
            found_owner = true;
            break;
        }
        if !found_owner {
            // No eligible owner — discard and redraw a free role as replacement.
            drawn_used[d] = true;
            replacement := draw_roles_from_bag(ref bag, ungated_master, 1, allow_duplicates);
            if replacement.elements.count > 0 {
                append(ref drawn, replacement.elements[0]);
                drawn_used.append(false);
            }
        }
    }

    // Pass 2: assign remaining drawn roles to remaining players, respecting
    // each player's loadout allow-list. For each unused drawn role, find
    // any unassigned player whose loadout permits it. If nobody allows it,
    // discard and redraw from ungated_master (capped to avoid pathological
    // loops when no combination satisfies any loadout).
    LOADOUT_REDRAW_BUDGET :: 8;
    redraws_left := LOADOUT_REDRAW_BUDGET;
    d := 0;
    while d < drawn.elements.count {
        if drawn_used[d] { d += 1; continue; }
        role := drawn.elements[d];
        if !allow_duplicates && rp_claimed_contains(claimed, role) {
            drawn_used[d] = true;
            d += 1;
            continue;
        }
        placed := false;
        for i: 0..count - 1 {
            if assigned[i] continue;
            if rp_is_role_locked(type_players.elements[i], role) continue;
            if !loadout_player_allows_role(loadouts[i], role) continue;
            type_players.elements[i].player_role = role;
            assigned[i] = true;
            drawn_used[d] = true;
            if !allow_duplicates {
                claimed.append(role);
            }
            placed = true;
            break;
        }
        if !placed {
            drawn_used[d] = true;
            if redraws_left > 0 {
                replacement := draw_roles_from_bag(ref bag, ungated_master, 1, allow_duplicates);
                if replacement.elements.count > 0 {
                    append(ref drawn, replacement.elements[0]);
                    drawn_used.append(false);
                    redraws_left -= 1;
                }
            }
        }
        d += 1;
    }

    // Pass 3 (fallback): any player still unassigned (e.g. their loadout
    // excluded every drawn role and the redraw budget ran out) gets the
    // next leftover drawn role regardless of loadout. Better to break the
    // loadout filter than to ship a player with Player_Role.NONE.
    leftover_idx := 0;
    for i: 0..count - 1 {
        if assigned[i] continue;
        while leftover_idx < drawn.elements.count && drawn_used[leftover_idx] {
            leftover_idx += 1;
        }
        if leftover_idx < drawn.elements.count {
            type_players.elements[i].player_role = drawn.elements[leftover_idx];
            assigned[i] = true;
            drawn_used[leftover_idx] = true;
            if !allow_duplicates {
                claimed.append(drawn.elements[leftover_idx]);
            }
            leftover_idx += 1;
        }
    }

    // Final safety: never leave a team-assigned player with Player_Role.NONE.
    // Prefer an unlocked, not-yet-claimed role; if every role is claimed, use
    // an unlocked duplicate rather than showing "Normal Dude" for the team.
    for i: 0..count - 1 {
        if assigned[i] continue;

        p := type_players.elements[i];
        preferred := Player_Role.NONE;
        duplicate := Player_Role.NONE;
        for m: 0..master.elements.count - 1 {
            role := master.elements[m];
            if rp_is_role_locked(p, role) continue;
            if duplicate == Player_Role.NONE duplicate = role;
            if !allow_duplicates && rp_claimed_contains(claimed, role) continue;
            preferred = role;
            break;
        }

        fallback := preferred;
        if fallback == Player_Role.NONE fallback = duplicate;

        if fallback != Player_Role.NONE {
            p.player_role = fallback;
            assigned[i] = true;
            if !allow_duplicates {
                claimed.append(fallback);
            }
        }
    }

}

// ════════════════════════════════════════════════════════════════════
//  Chat command — /my_boost
// ════════════════════════════════════════════════════════════════════
my_boost :: proc(player: Player) {
    found_any := false;
    rp_check_boost(player, "Goo Goo Gaga", GGG_PRODUCT_ID, GGG_USAGE_KEY, ref found_any);
    rp_check_boost(player, "Mimicer", MIMICER_PRODUCT_ID, MIMICER_USAGE_KEY, ref found_any);
    rp_check_boost(player, "Lily Lovebraids", LILY_PRODUCT_ID, LILY_USAGE_KEY, ref found_any);
    rp_check_boost(player, "Big Charlie", BIG_CHARLIE_PRODUCT_ID, BIG_CHARLIE_USAGE_KEY, ref found_any);
    if !found_any {
        Chat.server_send_message("You don't own any purchasable roles.", player);
    }
} @chat_command

rp_check_boost :: proc(player: Player, name: string, product_id: string, usage_key: string, found: ref bool) {
    if !Purchasing.owns_product(player, product_id) return;
    found = true;
    usage := Save.get_int(player, usage_key, 0);
    chance := rp_get_boost_chance(usage.(int));
    if chance <= 0.0 {
        Chat.server_send_message(format_string("% — Uses: %. Boost: EXHAUSTED (normal odds).", {name, usage}), player);
    } else {
        Chat.server_send_message(format_string("% — Uses: %. Boost: %0%%.", {name, usage, format_float(chance * 100.0, decimals=0)}), player);
    }
}

// ════════════════════════════════════════════════════════════════════
//  Admin command — /is_boost <product_id>
// ════════════════════════════════════════════════════════════════════
is_boost :: proc(player: Player, product_id: string) {
    owns := Purchasing.owns_product(player, product_id);
    if !owns {
        Chat.server_send_message(format_string("You do NOT own product %.", {product_id}), player);
        return;
    }

    usage_key := format_string("purchase_usage_%", {product_id});
    usage := Save.get_int(player, usage_key, 0);
    chance := rp_get_boost_chance(usage.(int));

    if chance <= 0.0 {
        Chat.server_send_message(format_string("Owned. Uses: %. Boost: EXHAUSTED (normal odds).", {usage}), player);
    } else {
        Chat.server_send_message(format_string("Owned. Uses: %. Boost: %0%%.", {usage, format_float(chance * 100.0, decimals=0)}), player);
    }
} @chat_command

// ════════════════════════════════════════════════════════════════════
//  Admin command — /reset_boost <product_id>
// ════════════════════════════════════════════════════════════════════
reset_boost :: proc(player: Player, product_id: string) {
    owns := Purchasing.owns_product(player, product_id);
    if !owns {
        Chat.server_send_message(format_string("You do NOT own product %.", {product_id}), player);
        return;
    }

    usage_key := format_string("purchase_usage_%", {product_id});
    Save.set_int(player, usage_key, 0);
    chance := rp_get_boost_chance(0);
    Chat.server_send_message(format_string("Boost reset! Uses: 0. Boost: %0%%.", {format_float(chance * 100.0, decimals=0)}), player);
} @chat_command
