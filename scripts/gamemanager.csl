rr_power_outage_active: bool;
rr_power_outage_started_at: float;
rr_power_outage_triggered_by_id: u64;
rr_power_outage_cooldown_ends_at: float;
rr_power_outage_generator_entity: Entity;

// --- Sabotage: Comms Outage ---
rr_comms_outage_active: bool;
rr_comms_outage_started_at: float;
rr_comms_outage_triggered_by_id: u64;
rr_comms_outage_cooldown_ends_at: float;

// --- Sabotage: Door Lockdown ---
rr_lockdown_active: bool;
rr_lockdown_started_at: float;
rr_lockdown_triggered_by_id: u64;
rr_lockdown_cooldown_ends_at: float;
rr_lockdown_ends_at: float;

// --- Meeting pause: saved sabotage cooldown remaining (seconds) ---
rr_saved_power_outage_cooldown_remaining: float;
rr_saved_comms_outage_cooldown_remaining: float;
rr_saved_lockdown_cooldown_remaining: float;
rr_saved_fake_meeting_cooldown_remaining: float;

rr_power_outage_add_generator_task_to_player :: proc(player: Player) {
	if player == null return;
	// Traitors should never be tasked with fixing sabotages.
	if player.player_type == Player_Type.TRAITOR return;
	// Don't add duplicates
	for i: 0..player.active_tasks.elements.count-1 {
		t := player.active_tasks.elements[i];
		if t == null continue;
		if t.id == RR_RESTART_GENERATOR_TASK_ID {
			return;
		}
	}
	task := new(Task_Restart_Generator);
	task.id = RR_RESTART_GENERATOR_TASK_ID;
	append(ref player.active_tasks, task);
}

rr_power_outage_remove_generator_task_from_player :: proc(player: Player) {
	if player == null return;
	i := 0;
	while i < player.active_tasks.elements.count {
		t := player.active_tasks.elements[i];
		if t != null && t.id == RR_RESTART_GENERATOR_TASK_ID {
			last := player.active_tasks.elements.count - 1;
			player.active_tasks.elements[i] = player.active_tasks.elements[last];
			pop(ref player.active_tasks);
			continue;
		}
		i += 1;
	}
}

rr_comms_outage_add_enable_comms_task_to_player :: proc(player: Player) {
	if player == null return;
	// Traitors should never be tasked with fixing sabotages.
	if player.player_type == Player_Type.TRAITOR return;
	// Don't add duplicates
	for i: 0..player.active_tasks.elements.count-1 {
		t := player.active_tasks.elements[i];
		if t == null continue;
		if t.id == RR_ENABLE_COMMUNICATIONS_TASK_ID {
			return;
		}
	}
	task := new(Task_Enable_Communications);
	task.id = RR_ENABLE_COMMUNICATIONS_TASK_ID;
	append(ref player.active_tasks, task);
}

rr_comms_outage_remove_enable_comms_task_from_player :: proc(player: Player) {
	if player == null return;
	i := 0;
	while i < player.active_tasks.elements.count {
		t := player.active_tasks.elements[i];
		if t != null && t.id == RR_ENABLE_COMMUNICATIONS_TASK_ID {
			last := player.active_tasks.elements.count - 1;
			player.active_tasks.elements[i] = player.active_tasks.elements[last];
			pop(ref player.active_tasks);
			continue;
		}
		i += 1;
	}
}

Game_State :: enum {
    LOBBY;
	ANIM_ROLE_SPIN;
	ANIM_INTRO;
	INGAME;
	ANIM_BODY_FOUND;
	ANIM_MEETING_CALLED;
	VOTING;
	ANIM_VOTE_EJECT;
	ANIM_JESTER_WIN;
	ANIM_PYRO_WIN;
	ANIM_BC_MASS_BIRTH;
	ANIM_HACKER_WIN;
	ANIM_VICTORY;
}

Player_Type :: enum {
    CIVILIAN;
	ANARCHIST;
	TRAITOR;
}

Player_State :: enum {
    PASSIVE;
	ALIVE;
	DEAD;
}

Player_Role :: enum {
    NONE;
	//Civilian Roles
	SHERIFF;
	DOCTOR;
	PRESIDENT;
	MOVIE_STAR;
	CORONER;
	PORTAL_MAKER;
	//Anarchist Roles
	PRANKSTER;
	PYROMANIAC;
	HACKER;
	//Traitor Roles
	PIRATE;
	HITMAN;
	WEREWOLF;
	GOO_GOO_GAGA;
	MIMICER;
	BIG_CHARLIE;
	LILY_LOVEBRAIDS;
}

rr_get_role_type :: proc(role: Player_Role) -> Player_Type {
	switch role {
		case .SHERIFF:      return Player_Type.CIVILIAN;
		case .DOCTOR:       return Player_Type.CIVILIAN;
		case .PRESIDENT:    return Player_Type.CIVILIAN;
		case .MOVIE_STAR:   return Player_Type.CIVILIAN;
		case .CORONER:      return Player_Type.CIVILIAN;
		case .PORTAL_MAKER: return Player_Type.CIVILIAN;
		case .PRANKSTER:    return Player_Type.ANARCHIST;
		case .PYROMANIAC:   return Player_Type.ANARCHIST;
		case .HACKER:       return Player_Type.ANARCHIST;
		case .PIRATE:       return Player_Type.TRAITOR;
		case .HITMAN:       return Player_Type.TRAITOR;
		case .WEREWOLF:      return Player_Type.TRAITOR;
		case .GOO_GOO_GAGA:  return Player_Type.TRAITOR;
		case .MIMICER:       return Player_Type.TRAITOR;
		case .BIG_CHARLIE:   return Player_Type.ANARCHIST;
		case .LILY_LOVEBRAIDS: return Player_Type.TRAITOR;
		case .NONE:          return Player_Type.CIVILIAN;
	}
	return Player_Type.CIVILIAN;
}

rr_get_role_display_name :: proc(role: Player_Role) -> string {
	switch role {
		case .SHERIFF:      return "sheriff";
		case .DOCTOR:       return "doctor";
		case .PRESIDENT:    return "president";
		case .MOVIE_STAR:   return "movie_star";
		case .CORONER:      return "coroner";
		case .PORTAL_MAKER: return "portal_maker";
		case .PRANKSTER:    return "prankster";
		case .PYROMANIAC:   return "pyromaniac";
		case .HACKER:       return "hacker";
		case .PIRATE:       return "pirate";
		case .HITMAN:       return "hitman";
		case .WEREWOLF:      return "werewolf";
		case .GOO_GOO_GAGA:  return "goo_goo_gaga";
		case .MIMICER:       return "mimicer";
		case .BIG_CHARLIE:   return "big_charlie";
		case .LILY_LOVEBRAIDS: return "lily";
		case .NONE:          return "none";
	}
	return "none";
}

// Lowercase an entire string and normalize spaces to underscores.
rr_to_lower :: proc(s: string) -> string {
	lower := to_lower(s);
	result := "";
	for i: 0..lower.count-1 {
		ch := string_substring(lower, i, 1);
		if ch == " " { ch = "_"; }
		result = format_string("%0%", .{result, ch});
	}
	return result;
}

rr_parse_role_name :: proc(role_name: string) -> Player_Role, bool {
	name := rr_to_lower(role_name);
	if name == "none"                                          return Player_Role.NONE, true;
	if name == "sheriff"                                       return Player_Role.SHERIFF, true;
	if name == "doctor"                                        return Player_Role.DOCTOR, true;
	if name == "president"                                     return Player_Role.PRESIDENT, true;
	if name == "movie_star"                                    return Player_Role.MOVIE_STAR, true;
	if name == "coroner"                                       return Player_Role.CORONER, true;
	if name == "portal_maker" || name == "warper"              return Player_Role.PORTAL_MAKER, true;
	if name == "prankster"                                     return Player_Role.PRANKSTER, true;
	if name == "pyromaniac" || name == "pyro"                  return Player_Role.PYROMANIAC, true;
	if name == "hacker"                                        return Player_Role.HACKER, true;
	if name == "pirate"                                        return Player_Role.PIRATE, true;
	if name == "hitman"                                        return Player_Role.HITMAN, true;
	if name == "werewolf"                                      return Player_Role.WEREWOLF, true;
	if name == "ggg" || name == "goo_goo_gaga" || name == "googoo" return Player_Role.GOO_GOO_GAGA, true;
	if name == "mimicer" || name == "mim"                        return Player_Role.MIMICER, true;
	if name == "big_charlie" || name == "bigcharlie" || name == "charlie" return Player_Role.BIG_CHARLIE, true;
	if name == "lily" return Player_Role.LILY_LOVEBRAIDS, true;
	return Player_Role.NONE, false;
}

// --- Movie Star: Autograph trap ---
MOVIE_STAR_AUTOGRAPH_STUN_SECONDS :: 15.0;
MOVIE_STAR_AUTOGRAPH_TRAP_LIFETIME_SECONDS :: 45.0;
MOVIE_STAR_AUTOGRAPH_TRIGGER_RADIUS :: 0.8;

Autograph_Trap_Entry :: class {
	pos: v2;
	owner_entity_id: u64;
	expires_at: float;
	trap_entity: Entity;
}

autograph_traps: List(Autograph_Trap_Entry);

// Match portal/mine ground decal conventions.
MOVIE_STAR_AUTOGRAPH_VISUAL_SCALE :: 1.1;
MOVIE_STAR_AUTOGRAPH_VISUAL_LAYER :: 0;
MOVIE_STAR_AUTOGRAPH_VISUAL_DEPTH_OFFSET :: 1.0;
MOVIE_STAR_AUTOGRAPH_FADE_IN_SECONDS :: 0.45;

Autograph_Trap_Visibility :: class : Component {
	owner_entity_id: u64;

	is_visible_to_local_player :: method() -> bool {
		local_player, ok := Game.get_local_player();
		if !ok return false;
		return local_player.entity.id == owner_entity_id;
	}

	ao_on_state_sync :: method() {
		entity.set_local_enabled(is_visible_to_local_player());
	}
}

Autograph_Trap_Fade_In :: class : Component {
	start_time: float;
	done: bool;

	ao_start :: method() {
		start_time = get_time();
	}

	ao_update :: method(dt: float) {
		if done return;
		t := get_time() - start_time;
		k := t / MOVIE_STAR_AUTOGRAPH_FADE_IN_SECONDS;
		if k >= 1.0 {
			entity.set_local_scale(v2.{MOVIE_STAR_AUTOGRAPH_VISUAL_SCALE, MOVIE_STAR_AUTOGRAPH_VISUAL_SCALE});
			sr := entity.get_component(Sprite_Renderer);
			if sr != null {
				sr.color = v4.{1, 1, 1, 1};
			}
			done = true;
			return;
		}
		// Ease-out cubic for a gentle settle.
		ease := 1.0 - pow(1.0 - k, 3.0);
		s := lerp(MOVIE_STAR_AUTOGRAPH_VISUAL_SCALE * 0.6, MOVIE_STAR_AUTOGRAPH_VISUAL_SCALE, ease);
		entity.set_local_scale(v2.{s, s});
		sr := entity.get_component(Sprite_Renderer);
		if sr != null {
			sr.color = v4.{1, 1, 1, ease};
		}
	}
}

// --- Hitman: Mines ---
Hitman_Mine_Entry :: class {
	pos: v2;
	owner_entity_id: u64;
	mine_entity: Entity;
	trigger_target_entity_id: u64;
	detonate_at: float;
	is_triggered: bool;
}

hitman_mines: List(Hitman_Mine_Entry);

// Match portal ground decal conventions.
HITMAN_MINE_VISUAL_SCALE :: 0.6;
HITMAN_MINE_VISUAL_LAYER :: 0;
HITMAN_MINE_VISUAL_DEPTH_OFFSET :: 1.0;
HITMAN_MINE_PRE_EXPLODE_SECONDS :: 0.7;

Hitman_Mine_Visibility :: class : Component {
	owner_entity_id: u64;
	reveal_to_all: bool;

	is_visible_to_local_player :: method() -> bool {
		if reveal_to_all return true;
		local_player, ok := Game.get_local_player();
		if !ok return false;
		return local_player.player_type == Player_Type.TRAITOR;
	}

	ao_on_state_sync :: method() {
		entity.set_local_enabled(is_visible_to_local_player());
	}
}

rr_hitman_clear_mines :: proc() {
	// Server authoritative
	if !Game.is_server() return;

	for i: 0..hitman_mines.elements.count-1 {
		m := hitman_mines.elements[i];
		if m == null continue;
		if m.mine_entity != null && #alive(m.mine_entity) {
			m.mine_entity.destroy();
		}
	}
	hitman_mines = List(Hitman_Mine_Entry).{};
}

rr_hitman_place_mine :: proc(owner: Player, pos: v2) {
	// Server authoritative
	if !Game.is_server() return;
	if owner == null return;
	if owner.player_role != Player_Role.HITMAN return;
	if owner.player_state != Player_State.ALIVE return;

	// Clamp to navmesh so mines don't end up outside walkable space.
	clamped := pos;
	nav_point: v2;
	triangle_hint: s64;
	if try_find_closest_point_on_navmesh(pos, ref nav_point, ref triangle_hint) {
		clamped = nav_point;
	}

	entry := new(Hitman_Mine_Entry);
	entry.pos = clamped;
	entry.owner_entity_id = owner.entity.id;
	entry.trigger_target_entity_id = 0;
	entry.detonate_at = 0.0;
	entry.is_triggered = false;

	// World visual
	mine_e := Scene.create_entity();
	mine_e.set_local_position(clamped);
	mine_e.set_local_rotation(0.0);
	mine_e.set_local_scale(v2.{HITMAN_MINE_VISUAL_SCALE, HITMAN_MINE_VISUAL_SCALE});
	sprite := mine_e.add_component(Sprite_Renderer);
	if sprite != null {
		sprite.set_texture(get_asset(Texture_Asset, "sprites/icons/hitman/land_mine.png"));
		// Above map, below players (same as portals).
		sprite.layer = HITMAN_MINE_VISUAL_LAYER;
		sprite.depth_offset = HITMAN_MINE_VISUAL_DEPTH_OFFSET;
		sprite.color = v4.{1, 1, 1, 0.95};
	}
	visibility := mine_e.add_component(Hitman_Mine_Visibility);
	if visibility != null {
		visibility.owner_entity_id = owner.entity.id;
		visibility.reveal_to_all = false;
	}
	entry.mine_entity = mine_e;

	append(ref hitman_mines, entry);
}

update_hitman_mines :: proc() {
	// Server authoritative
	if !Game.is_server() return;
	if hitman_mines.elements.count <= 0 return;

	i := 0;
	while i < hitman_mines.elements.count {
		m := hitman_mines.elements[i];
		if m == null {
			last := hitman_mines.elements.count - 1;
			hitman_mines.elements[i] = hitman_mines.elements[last];
			pop(ref hitman_mines);
			continue;
		}

		// Remove dead visuals defensively.
		if m.mine_entity != null && !#alive(m.mine_entity) {
			last := hitman_mines.elements.count - 1;
			hitman_mines.elements[i] = hitman_mines.elements[last];
			pop(ref hitman_mines);
			continue;
		}

		if !m.is_triggered {
			// Arm when someone steps on it, then reveal shortly before detonation.
			for p_i: 0..players.elements.count-1 {
				p := players.elements[p_i];
				if p == null continue;
				if !#alive(p.entity) continue;
				if p.player_state != Player_State.ALIVE continue;
				if p.entity.id == m.owner_entity_id continue;

				if in_range(p.entity.world_position - m.pos, HITMAN_MINE_TRIGGER_RADIUS) {
					m.is_triggered = true;
					m.trigger_target_entity_id = p.entity.id;
					m.detonate_at = get_time() + HITMAN_MINE_PRE_EXPLODE_SECONDS;

					if m.mine_entity != null && #alive(m.mine_entity) {
						visibility := m.mine_entity.get_component(Hitman_Mine_Visibility);
						if visibility != null {
							visibility.reveal_to_all = true;
						}
					}
					break;
				}
			}
		}

		if m.is_triggered && get_time() >= m.detonate_at {
			target := get_player_by_entity_id(m.trigger_target_entity_id);
			if target == null || !#alive(target.entity) || target.player_state != Player_State.ALIVE || target.entity.id == m.owner_entity_id {
				target = null;
				for p_i: 0..players.elements.count-1 {
					p := players.elements[p_i];
					if p == null continue;
					if !#alive(p.entity) continue;
					if p.player_state != Player_State.ALIVE continue;
					if p.entity.id == m.owner_entity_id continue;
					if !in_range(p.entity.world_position - m.pos, HITMAN_MINE_TRIGGER_RADIUS) continue;
					target = p;
					break;
				}
			}

			if target != null {
				rr_refresh_rng_state();
				angle := rng_range_float(ref rr_rng_state.value, 0.0, 6.28318);
				dir := v2.{cos(angle), sin(angle)};
				if length_squared(dir) < 0.001 { dir = v2.{1, 0}; }

				fling := target.entity.get_component(Hitman_Mine_Fling);
				if fling == null {
					fling = target.entity.add_component(Hitman_Mine_Fling);
				}
				fling.arm(HITMAN_MINE_MAX_FLING_SECONDS, dir, HITMAN_MINE_FLING_SPEED);
			}

			if m.mine_entity != null && #alive(m.mine_entity) {
				m.mine_entity.destroy();
			}
			last := hitman_mines.elements.count - 1;
			hitman_mines.elements[i] = hitman_mines.elements[last];
			pop(ref hitman_mines);
			continue;
		}

		i += 1;
	}
}

rr_add_autograph_trap :: proc(owner: Player, pos: v2) {
	if owner == null return;
	entry := new(Autograph_Trap_Entry);
	entry.pos = pos;
	entry.owner_entity_id = owner.entity.id;
	entry.expires_at = get_time() + MOVIE_STAR_AUTOGRAPH_TRAP_LIFETIME_SECONDS;

	if Game.is_server() {
		trap_e := Scene.create_entity();
		trap_e.set_local_position(pos);
		trap_e.set_local_rotation(0.0);
		trap_e.set_local_scale(v2.{MOVIE_STAR_AUTOGRAPH_VISUAL_SCALE * 0.6, MOVIE_STAR_AUTOGRAPH_VISUAL_SCALE * 0.6});
		sprite := trap_e.add_component(Sprite_Renderer);
		if sprite != null {
			sprite.set_texture(get_asset(Texture_Asset, "sprites/autograph_item.png"));
			sprite.layer = MOVIE_STAR_AUTOGRAPH_VISUAL_LAYER;
			sprite.depth_offset = MOVIE_STAR_AUTOGRAPH_VISUAL_DEPTH_OFFSET;
			sprite.color = v4.{1, 1, 1, 0};
		}
		vis := trap_e.add_component(Autograph_Trap_Visibility);
		if vis != null {
			vis.owner_entity_id = owner.entity.id;
		}
		trap_e.add_component(Autograph_Trap_Fade_In);
		entry.trap_entity = trap_e;
	}

	append(ref autograph_traps, entry);
}

rr_autograph_destroy_trap_entity :: proc(trap: Autograph_Trap_Entry) {
	if trap == null return;
	if trap.trap_entity == null return;
	if !#alive(trap.trap_entity) return;
	trap.trap_entity.destroy();
}

rr_autograph_clear_traps :: proc() {
	if !Game.is_server() return;
	for i: 0..autograph_traps.elements.count-1 {
		t := autograph_traps.elements[i];
		if t == null continue;
		rr_autograph_destroy_trap_entity(t);
	}
	autograph_traps = List(Autograph_Trap_Entry).{};
}

update_autograph_traps :: proc() {
	if autograph_traps.elements.count <= 0 return;
	now := get_time();

	i := 0;
	while i < autograph_traps.elements.count {
		trap := autograph_traps.elements[i];
		if trap == null {
			last := autograph_traps.elements.count - 1;
			autograph_traps.elements[i] = autograph_traps.elements[last];
			pop(ref autograph_traps);
			continue;
		}

		// Expire
		if now >= trap.expires_at {
			rr_autograph_destroy_trap_entity(trap);
			last := autograph_traps.elements.count - 1;
			autograph_traps.elements[i] = autograph_traps.elements[last];
			pop(ref autograph_traps);
			continue;
		}

		// Trigger: first alive player (not owner) who walks over it.
		triggered := false;
		for p_i: 0..players.elements.count-1 {
			p := players.elements[p_i];
			if p == null continue;
			if !#alive(p.entity) continue;
			if p.player_state != Player_State.ALIVE continue;
			if p.entity.id == trap.owner_entity_id continue;

			if in_range(p.entity.world_position - trap.pos, MOVIE_STAR_AUTOGRAPH_TRIGGER_RADIUS) {
				// Apply stun effect
				eff := p.entity.get_component(Stunned_By_Autograph_Effect);
				if eff == null {
					eff = p.entity.add_component(Stunned_By_Autograph_Effect);
				}
				eff.arm(MOVIE_STAR_AUTOGRAPH_STUN_SECONDS);
				triggered = true;
				break;
			}
		}

		if triggered {
			rr_autograph_destroy_trap_entity(trap);
			last := autograph_traps.elements.count - 1;
			autograph_traps.elements[i] = autograph_traps.elements[last];
			pop(ref autograph_traps);
			continue;
		}

		i += 1;
	}
}

game_state: Game_State;
countdown_start_time: float;
countdown_active: bool;
lobby_timer_paused: bool;
lobby_timer_paused_at: float;
game_end_time: float;
waiting_for_restart: bool;
lobby_relaxed_min_players_active: bool;
lobby_under_min_players_since: float;
voting_start_time: float;
rr_matchmaking_initialized: bool;
rr_last_matchmaking_priority: int;

// After voting completes, keep the game in VOTING briefly to reveal the result.
RR_VOTE_RESULTS_REVEAL_SECONDS :: 6.0;
rr_vote_results_active: bool;
rr_vote_results_end_time: float;

// When all alive players except 1 have voted, the timer shortens to this many seconds.
RR_VOTE_HURRY_SECONDS :: 10.0;
rr_vote_hurry_deadline: float; // 0 = not active; otherwise game-time when voting should end
round_number: int;
// Game-level save key for a published-game-wide round counter. Used as
// extra entropy in the role-assignment seed so two fresh server instances
// don't collide on round 1 if rng_root_seed() happens to match.
RR_GLOBAL_ROUND_COUNT_KEY :: "rr_global_round_count";
meeting_cooldown_ends_at: float;
post_meeting_kill_lockout_ends_at: float;
// One-shot override for next-round traitor team size. -1 means disabled.
forced_traitor_count_next_round: int = -1;

// --- Single-player test mode ---
// If a round is started with only one player (via force start), we disable all end-game win triggers.
// This is useful for local testing without being kicked back to lobby by "only X alive" conditions.
rr_started_solo_test_mode: bool;
rr_round_start_player_count: int;

// --- End-game delay ---
// Give a brief moment after the final kill so players can see the death happen
// before the victory screen takes over.
RR_END_GAME_DELAY_AFTER_FINAL_KILL_SECONDS :: 2.0;
rr_end_game_pending: bool;
rr_end_game_pending_started_at: float;
rr_end_game_pending_victor: Player_Type;

// --- Fake meeting (Prankster) ---
fake_meeting_active: bool;
fake_meeting_caller_id: u64;
fake_meeting_cooldown_ends_at: float;

// --- Meeting metadata (used by voting UI) ---
meeting_initiator_id: u64;          // 0 = none / hidden (e.g. fake meeting)
meeting_initiator_from_body: bool;  // true when triggered via Report

// Player entity ids that died since the previous meeting ended.
deaths_since_last_meeting: List(u64);

// --- Voting outcome (used by vote UI to show who was ejected) ---
// Updated whenever a voting session ends. Clients can decide whether to show this
// inside the vote UI (if open) or as a popup (if the UI is closed).
rr_last_vote_result_time: float;     // 0 = none yet; otherwise game-time the result was set
rr_last_vote_ejected_player_id: u64; // 0 = no one ejected; otherwise entity id of ejected player
rr_last_vote_was_fake_meeting: bool;          // True if the vote was a prankster's fake meeting
rr_last_vote_prankster_got_voted: bool;       // True if the prankster was the top-voted player in a fake meeting

// --- Vote ejection cinematic ---
rr_vote_eject_start_time: float;
rr_vote_eject_player_id: u64;
rr_vote_eject_anim_started: bool;
rr_vote_eject_anim_start_time: float;

rr_set_matchmaking :: proc(priority: int) {
	if rr_matchmaking_initialized && rr_last_matchmaking_priority == priority return;
	Server.set_matchmaking_priority(priority);
	rr_last_matchmaking_priority = priority;
	rr_matchmaking_initialized = true;
}

rr_is_round_running :: proc() -> bool {
	return game_state != Game_State.LOBBY && game_state != Game_State.ANIM_VICTORY;
}

rr_get_lobby_timer_now :: proc() -> float {
	if game_state == Game_State.LOBBY && lobby_timer_paused {
		return lobby_timer_paused_at;
	}
	return get_time();
}

rr_get_lobby_required_player_count :: proc() -> int {
	if game_state == Game_State.LOBBY && lobby_relaxed_min_players_active {
		return RELAXED_MIN_NUMBER_OF_PLAYERS;
	}
	return MIN_NUMBER_OF_PLAYERS;
}

rr_lobby_seconds_until_round_start :: proc() -> float {
	// "Very far in the future" sentinel for states where a round is not imminent.
	if game_state != Game_State.LOBBY return 999999.0;
	if players.elements.count < rr_get_lobby_required_player_count() return 999999.0;
	now := rr_get_lobby_timer_now();

	countdown_seconds := NORMAL_LOBBY_COUNTDOWN_SECONDS;
	if round_number == 0 {
		countdown_seconds = FIRST_ROUND_LOBBY_COUNTDOWN_SECONDS;
	}

	if waiting_for_restart {
		wait_remaining := 60.0 - (now - game_end_time);
		if wait_remaining < 0.0 wait_remaining = 0.0;
		return wait_remaining + countdown_seconds;
	}

	if countdown_active {
		remaining := countdown_seconds - (now - countdown_start_time);
		if remaining < 0.0 remaining = 0.0;
		return remaining;
	}

	// Enough players but countdown hasn't started this frame yet.
	return countdown_seconds;
}

rr_update_matchmaking_priority :: proc() {
	player_count := players.elements.count;
	running := rr_is_round_running();
	priority := 0; // 0 = send me players

	// Explicit busy case from product rules.
	if player_count > 4 && running {
		priority = 1;
	}
	// Explicit open case from product rules.
	else if player_count < 4 {
		priority = 0;
	}
	// Not currently running: only stay open if the next round is still >10s away.
	else if !running {
		if rr_lobby_seconds_until_round_start() <= 10.0 {
			priority = 1;
		}
	}
	// Running with exactly 4 players keeps previous "open" behavior unless told otherwise.

	rr_set_matchmaking(priority);
}
rr_vote_eject_text_sfx_played: bool;
rr_vote_eject_anim_sfx_played: bool;

u64_list_contains :: proc(list: List(u64), value: u64) -> bool {
	for i: 0..list.elements.count-1 {
		if list.elements[i] == value return true;
	}
	return false;
}

rr_register_player_death :: proc(player_entity_id: u64) {
	if player_entity_id == 0 return;
	// Avoid duplicates (e.g. multiple damage sources calling kill defensively).
	if u64_list_contains(deaths_since_last_meeting, player_entity_id) return;
	append(ref deaths_since_last_meeting, player_entity_id);
}

// --- Jester Win cinematic (Prankster) ---
JESTER_WIN_CINEMATIC_TIME :: 5.0;
jester_win_active: bool;
jester_win_start_time: float;
jester_win_player_id: u64;

// --- Pyromaniac Win cinematic ---
PYRO_WIN_CINEMATIC_TIME :: 5.0;
pyro_win_active: bool;
pyro_win_start_time: float;
pyro_win_player_id: u64;

BC_MASS_BIRTH_CINEMATIC_TIME :: 7.0;
bc_mass_birth_active: bool;
bc_mass_birth_start_time: float;
bc_mass_birth_player_id: u64;

rr_try_start_power_outage :: proc(caller: Player) {
	// Server authoritative
	if !Game.is_server() return;
	// Only allow during gameplay
	if game_state != Game_State.INGAME return;
	if caller == null return;
	if caller.player_state != Player_State.ALIVE return;
	if caller.player_type != Player_Type.TRAITOR && !rr_is_hacker(caller) return;

	if rr_power_outage_active return;
	if get_time() < rr_power_outage_cooldown_ends_at return;
	// Global shared sabotage cooldown.
	if get_time() < rr_global_sabotage_cooldown_ends_at return;

	rr_power_outage_active = true;
	rr_power_outage_disable_los_occlusion = true;
	rr_power_outage_started_at = get_time();
	rr_power_outage_triggered_by_id = caller.entity.id;
	rr_power_outage_cooldown_ends_at = get_time() + POWER_OUTAGE_SABOTAGE_COOLDOWN_SECONDS;
	rr_global_sabotage_cooldown_ends_at = get_time() + GLOBAL_SABOTAGE_COOLDOWN_SECONDS;

	// One-shot SFX on server (replicated to clients). No position — global event.
	sfx := SFX.default_sfx_desc();
	sfx.loop = false;
	sfx.loop_timeout = 0.0;
	sfx.volume = 0.9;
	sfx.volume_perturb = 0.05;
	sfx.speed_perturb = 0.05;
	// Global SFX mix: everything at 25% volume.
	sfx.volume *= 0.25;
	sfx.volume_perturb *= 0.25;
	rr_play_sfx("sfx/turn_off_power.wav", sfx);

	// Inject the generator task for all alive non-traitors (traitors shouldn't be instructed to fix sabotages).
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p.player_state != Player_State.ALIVE continue;
		rr_power_outage_add_generator_task_to_player(p);
	}

	// Notify everyone — traitors see "Lights Out!", others see the sabotage name.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p.player_type == Player_Type.TRAITOR {
			p.Notify("Lights Out!");
		} else {
			p.Notify("Sabotage: Power Outage!");
		}
	}
}

rr_find_entity_named :: proc(name: string) -> Entity {
	if name.count == 0 return null;
	for e: entity_iterator() {
		if e == null continue;
		if !#alive(e) continue;
		if e.compare_name(name) {
			return e;
		}
	}
	return null;
}

rr_update_comms_lever_visuals :: proc() {
	// Server authoritative visual state
	if !Game.is_server() return;

	e := world_references.rr_comms_lever_entity;
	if e == null return;
	if !#alive(e) return;

	sprite := e.get_component(Sprite_Renderer);
	if sprite == null return;

	lever_on := get_asset(Texture_Asset, "sprites/lever_on.png");
	lever_off := get_asset(Texture_Asset, "sprites/lever_off.png");
	if lever_on == null || lever_off == null return;

	// Green when comms are functional, off otherwise.
	if rr_comms_outage_active {
		sprite.set_texture(lever_off);
	} else {
		sprite.set_texture(lever_on);
	}
}

rr_try_start_comms_outage :: proc(caller: Player) {
	// Server authoritative
	if !Game.is_server() return;
	// Only allow during gameplay
	if game_state != Game_State.INGAME return;
	if caller == null return;
	if caller.player_state != Player_State.ALIVE return;
	if caller.player_type != Player_Type.TRAITOR && !rr_is_hacker(caller) return;

	if rr_comms_outage_active return;
	if get_time() < rr_comms_outage_cooldown_ends_at return;
	// Global shared sabotage cooldown.
	if get_time() < rr_global_sabotage_cooldown_ends_at return;

	rr_comms_outage_active = true;
	rr_comms_outage_started_at = get_time();
	rr_comms_outage_triggered_by_id = caller.entity.id;
	rr_comms_outage_cooldown_ends_at = get_time() + COMMS_OUTAGE_SABOTAGE_COOLDOWN_SECONDS;
	rr_global_sabotage_cooldown_ends_at = get_time() + GLOBAL_SABOTAGE_COOLDOWN_SECONDS;

	// Inject the fix task for all alive non-traitors (traitors shouldn't be instructed to fix sabotages).
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p.player_state != Player_State.ALIVE continue;
		rr_comms_outage_add_enable_comms_task_to_player(p);
		// Apply voice routing immediately (server-state will sync to clients).
		p.apply_voice_chat_masks_for_current_state();
	}

	rr_update_comms_lever_visuals();

	// Notify everyone
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		p.Notify("Sabotage: Comms Down!");
	}
}

rr_try_start_lockdown :: proc(caller: Player) {
	// Server authoritative
	if !Game.is_server() return;
	// Only allow during gameplay
	if game_state != Game_State.INGAME return;
	if caller == null return;
	if caller.player_state != Player_State.ALIVE return;
	if caller.player_type != Player_Type.TRAITOR && !rr_is_hacker(caller) return;

	if rr_lockdown_active return;
	if get_time() < rr_lockdown_cooldown_ends_at return;
	// Global shared sabotage cooldown.
	if get_time() < rr_global_sabotage_cooldown_ends_at return;

	rr_lockdown_active = true;
	rr_lockdown_started_at = get_time();
	rr_lockdown_triggered_by_id = caller.entity.id;
	rr_lockdown_ends_at = get_time() + LOCKDOWN_DURATION_SECONDS;
	rr_lockdown_cooldown_ends_at = get_time() + LOCKDOWN_SABOTAGE_COOLDOWN_SECONDS;
	rr_global_sabotage_cooldown_ends_at = get_time() + GLOBAL_SABOTAGE_COOLDOWN_SECONDS;

	// Match meeting behavior: force doors closed/locked.
	close_all_doors();

	// Server-authoritative SFX (play once for everyone).
	sfx := SFX.default_sfx_desc();
	if caller != null {
		sfx.set_position(caller.entity.world_position);
	}
	sfx.volume = 0.9;
	sfx.volume_perturb = 0.05;
	sfx.speed_perturb = 0.05;
	// Global SFX mix: everything at 25% volume.
	sfx.volume *= 0.25;
	sfx.volume_perturb *= 0.25;
	rr_play_sfx("sfx/door_sabotage.wav", sfx);

	// Notify everyone
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		p.Notify("Sabotage: Door Lockdown!");
	}
}

rr_update_lockdown :: proc() {
	// Server authoritative
	if !Game.is_server() return;
	if !rr_lockdown_active return;
	if rr_lockdown_ends_at <= 0.0 return;

	now := get_time();
	if now < rr_lockdown_ends_at return;

	// Time's up
	rr_lockdown_active = false;
	rr_lockdown_started_at = 0.0;
	rr_lockdown_triggered_by_id = 0;
	rr_lockdown_ends_at = 0.0;

	// Only reopen doors if we're actually back in gameplay.
	// (Voting/meetings want doors locked; they'll handle opening on exit.)
	if game_state == Game_State.INGAME {
		open_all_doors();
	}

	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		p.Notify("Door Lockdown ended.");
	}
}

rr_end_comms_outage :: proc(fixer: Player) {
	// Server authoritative
	if !Game.is_server() return;
	if !rr_comms_outage_active return;

	rr_comms_outage_active = false;
	rr_comms_outage_triggered_by_id = 0;
	rr_comms_outage_started_at = 0.0;

	// Remove fix task so task UI returns to normal.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		rr_comms_outage_remove_enable_comms_task_from_player(p);
		// Restore voice routing.
		p.apply_voice_chat_masks_for_current_state();
	}

	rr_update_comms_lever_visuals();

	// Notify everyone
	msg := "Communications restored!";
	if fixer != null {
		if rr_is_hacker(fixer) {
			msg = "The Hacker shut down the comms outage.";
		} else {
			msg = format_string("Communications restored by %!", .{fixer.entity.get_name()});
		}
	}
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		Notifier.notify(p, msg);
	}
}

rr_end_power_outage :: proc(fixer: Player) {
	// Server authoritative
	if !Game.is_server() return;
	if !rr_power_outage_active return;

	rr_power_outage_active = false;
	rr_power_outage_disable_los_occlusion = false;
	rr_power_outage_triggered_by_id = 0;
	rr_power_outage_started_at = 0.0;

	if rr_power_outage_generator_entity != null && #alive(rr_power_outage_generator_entity) {
		rr_power_outage_generator_entity.destroy();
	}
	rr_power_outage_generator_entity = null;

	// Remove generator task so task UI returns to normal.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		rr_power_outage_remove_generator_task_from_player(p);
	}

	// Notify everyone
	msg := "Power restored!";
	if fixer != null {
		if rr_is_hacker(fixer) {
			msg = "The Hacker shut down the power outage.";
		} else {
			msg = format_string("Power restored by %!", .{fixer.entity.get_name()});
		}
	}
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		Notifier.notify(p, msg);
	}
}

start_fake_meeting :: proc(caller: Player) {
	// Only allow during gameplay
	if game_state != Game_State.INGAME return;
	if caller == null return;
	if caller.player_state != Player_State.ALIVE return;

	// Use the normal meeting flow (meeting called popup -> voting).
	// Fake meetings share the same cooldown as real meetings (checked inside start_meeting).
	started := start_meeting(false, caller);
	if !started return;

	fake_meeting_active = true;
	fake_meeting_caller_id = caller.entity.id;
	// Set the fake-meeting-specific cooldown so the Fake_Meeting_Ability timer syncs correctly.
	fake_meeting_cooldown_ends_at = get_time() + MEETING_COOLDOWN_SECONDS;
	// Note: Prankster_Module.fake_meetings_called is credited in end_voting() only if the
	// prankster gets voted out (tricked others into targeting them).
}

// --- Prankster: fake-meeting target (random alive non-prankster player) ---
rr_prankster_is_valid_target :: proc(prankster: Player, target: Player) -> bool {
	if prankster == null return false;
	if target == null return false;
	if !#alive(prankster.entity) return false;
	if !#alive(target.entity) return false;
	if prankster == target return false;
	if prankster.player_state != Player_State.ALIVE return false;
	if target.player_state != Player_State.ALIVE return false;
	return true;
}

rr_prankster_assign_target :: proc(prankster: Player) {
	if prankster == null return;
	if prankster.player_role != Player_Role.PRANKSTER return;
	if prankster.player_state != Player_State.ALIVE return;
	if !prankster.is_local_or_server() return;

	// Build candidate list (exclude current target to avoid repeats when possible).
	candidates: List(Player);
	prk := prankster.entity.get_component(Prankster_Module);
	if prk == null return;
	prev_target_id := prk.fake_meeting_target_id;
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !rr_prankster_is_valid_target(prankster, p) continue;
		if prev_target_id != 0 && p.entity.id == prev_target_id continue;
		append(ref candidates, p);
	}

	// Fallback: allow repeats if filtering removed everyone.
	if candidates.elements.count <= 0 {
		for i: 0..players.elements.count-1 {
			p := players.elements[i];
			if p == null continue;
			if !rr_prankster_is_valid_target(prankster, p) continue;
			append(ref candidates, p);
		}
	}

	if candidates.elements.count <= 0 {
		prk.fake_meeting_target_id = 0;
		return;
	}

	rr_refresh_rng_state();
	idx := rng_range_int(ref rr_rng_state.value, 0, candidates.elements.count - 1);
	target := candidates.elements[idx];
	if target == null || !#alive(target.entity) {
		prk.fake_meeting_target_id = 0;
		return;
	}

	prk.fake_meeting_target_id = target.entity.id;
}

// Reassign the prankster's target if the current one is no longer valid (dead/left).
rr_prankster_update_target :: proc(prankster: Player) {
	if prankster == null return;
	if prankster.player_role != Player_Role.PRANKSTER return;
	if prankster.player_state != Player_State.ALIVE return;

	// If no target yet, assign one.
	prk := prankster.entity.get_component(Prankster_Module);
	if prk == null return;
	if prk.fake_meeting_target_id == 0 {
		rr_prankster_assign_target(prankster);
		return;
	}

	// Check if the current target is still valid.
	target := get_player_by_entity_id(prk.fake_meeting_target_id);
	if target == null || !#alive(target.entity) || target.player_state != Player_State.ALIVE {
		rr_prankster_assign_target(prankster);
	}
}

prankster_check_unlock_jester_win :: proc(player: Player) {
	if player == null return;
	if player.player_role != Player_Role.PRANKSTER return;
	prk := player.entity.get_component(Prankster_Module);
	if prk == null return;
	// Requires BOTH objectives before unlocking
	if prk.prank_count >= 3 && prk.fake_meetings_called >= 1 {
		if prk.jester_unlocked_time <= 0.0 {
			prk.jester_unlocked_time = get_time();
			player.Notify("Jester Win unlocked! Survive 15s, then use it to win.");
		}
	}
}

start_vote_eject_cinematic :: proc(player: Player) {
	if player == null return;
	if player.player_state != Player_State.ALIVE return;
	if !Game.is_server() return;

	rr_vote_eject_start_time = get_time();
	rr_vote_eject_player_id = player.entity.id;
	rr_vote_eject_anim_started = false;
	rr_vote_eject_anim_start_time = 0.0;
	rr_vote_eject_text_sfx_played = false;
	rr_vote_eject_anim_sfx_played = false;

	game_state = Game_State.ANIM_VOTE_EJECT;
	close_all_doors();
}

start_jester_win_cinematic :: proc(caller: Player) {
	if caller == null return;
	if caller.player_state != Player_State.ALIVE return;
	if caller.player_role != Player_Role.PRANKSTER return;
	if game_state != Game_State.INGAME return;

	jester_win_active = true;
	jester_win_start_time = get_time();
	jester_win_player_id = caller.entity.id;

	// Freeze game flow + show cinematic
	game_state = Game_State.ANIM_JESTER_WIN;
	close_all_doors();

	// Play the trickster end animation (must be wired into the player's anim state machine)
	caller.set_facing_right(true);
	caller.set_trigger("jester_win");
}

start_pyro_win_cinematic :: proc(caller: Player) {
	if caller == null return;
	if caller.player_state != Player_State.ALIVE return;
	if caller.player_role != Player_Role.PYROMANIAC return;
	if game_state != Game_State.INGAME return;

	// Server authoritative endgame trigger.
	if !Game.is_server() return;

	pyro_win_active = true;
	pyro_win_start_time = get_time();
	pyro_win_player_id = caller.entity.id;

	// Freeze game flow + show cinematic
	game_state = Game_State.ANIM_PYRO_WIN;
	close_all_doors();

	// Play pyromaniac end animation (wired into merged rig state machine).
	caller.set_facing_right(true);
	caller.set_trigger("pyro_end_game");
}

// Big Charlie Mass Birth — ends the round in her favor (solo Anarchist win).
start_bc_mass_birth_cinematic :: proc(caller: Player) {
	if caller == null return;
	if caller.player_state != Player_State.ALIVE return;
	if caller.player_role != Player_Role.BIG_CHARLIE return;
	if game_state != Game_State.INGAME return;

	if !Game.is_server() return;

	bc_mass_birth_active = true;
	bc_mass_birth_start_time = get_time();
	bc_mass_birth_player_id = caller.entity.id;

	game_state = Game_State.ANIM_BC_MASS_BIRTH;
	// Force doors open so the nugget swarm can pathfind through the map and
	// chase surviving players. Also clears any active lockdown sabotage that
	// would otherwise leave doors locked.
	rr_lockdown_active = false;
	rr_lockdown_ends_at = 0.0;
	open_all_doors();

	caller.set_facing_right(true);
	// Player rig also plays a Birth Nugget squat as a synced cosmetic.
	caller.set_trigger("bc_birth_nugget");
}

on_player_go_dead :: proc(player: Player) {
	// If the player was mid-task when they died, close the task UI so death feedback/cinematics
	// aren't obscured. Ghost civilians can still reopen and continue tasks afterwards.
	rr_cancel_all_task_attempts(player);

	// Release any corpse this player was dragging (covers all death paths: kill, vote eject, etc.).
	// Safe to call even if already dropped (guard inside checks dragging_corpse_entity_id == 0).
	rr_drag_body_force_drop_for_player(player);

	// Force-revert all transforming roles before switching to ghost speed.
	rr_ggg_force_revert(player);
	rr_mimicer_force_revert(player);
	rr_werewolf_force_revert_for_meeting(player);

	// Reset Lily creature state on death.
	rr_lily_force_revert(player);
	// Clear Lily strings/braids for any player entering the dead state, including vote ejection.
	rr_lily_on_player_death(player.entity.id, 0);

	// Shoot_Ability.on_update normally clears this, but it stops running once the
	// ability button is no longer drawn — which is the moment we leave ALIVE.
	rr_player_clear_gun_state(player);

	player.player_state = Player_State.DEAD;

	// Ghost QoL: apply a movement speed boost while spectating.
	if player.baseline_movement_speed_saved {
		player.agent.movement_speed = player.baseline_movement_speed * GHOST_SPEED_MULTIPLIER;
	}

	player.add_ghost_reason("spectator");
	player.agent.set_navmesh_to_lock_to(world_references.ghost_navmesh);
	player.apply_voice_chat_masks_for_current_state();
}

on_player_go_passive :: proc(player: Player) {
	// End any active Lily deathbraid cinematic so the camera/freeze/entities don't persist
	// into the victory screen / lobby.
	lily_mod := player.entity.get_component(Lily_Module);
	if lily_mod != null && lily_mod.deathbraid_active {
		rr_lily_end_deathbraid(player);
	}

	// Drop any corpse / live drag so the drag anim flags clear before the lobby loop —
	// otherwise the player can spawn back into the lobby still playing the drag idle.
	rr_drag_body_force_drop_for_player(player);
	rr_ggg_stop_live_drag(player);
	rr_lily_stop_live_drag(player);
	player.set_trigger("RESET");

	// Clear Lily no-eyes / crawl so eyes/legs reappear for the victory screen and lobby
	// (the round-start reset in assign_players_to_types happens too late and only
	// runs when a new round begins).
	player.lily_no_eyes = false;
	player.lily_no_eyes_unlock_at = 0.0;
	player.lily_no_eyes_until = 0.0;
	if player.lily_crawling {
		rr_lily_restore_legs(player);
	}

	rr_player_clear_gun_state(player);

	player.revive();
	player.player_state = Player_State.PASSIVE;
	// Immediately restore werewolf visuals (don't defer to next frame — /restart can start
	// a new round on the same frame, so the deferred cleanup would never run).
	player.reset_werewolf_visuals();
	player.werewolf_saved_tasks_active = false;
	world_references.teleport_near_lobby(player);
	player.remove_ghost_reason("spectator");
	// Hard-reset to canonical baseline speed — prevents any leaked multipliers.
	if player.baseline_movement_speed_saved {
		player.agent.movement_speed = player.baseline_movement_speed;
	}
	rr_player_restore_default_camera(player, false);
	player.agent.set_navmesh_to_lock_to(world_references.main_navmesh);
	player.apply_voice_chat_masks_for_current_state();
	rr_intro_cleanup_role_spine(player);
}

on_player_go_alive :: proc(player: Player) {
	player.revive();
	player.player_state = Player_State.ALIVE;
	player.remove_ghost_reason("spectator");
	// Hard-reset to canonical baseline speed — prevents any leaked multipliers.
	if player.baseline_movement_speed_saved {
		player.agent.movement_speed = player.baseline_movement_speed;
	}
	rr_player_restore_default_camera(player, false);
	player.agent.set_navmesh_to_lock_to(world_references.main_navmesh);
	rebuild_game_world_navmesh();
	player.apply_voice_chat_masks_for_current_state();
}

close_all_doors :: proc() {
	for door: component_iterator(Door) {
		door.close_door();
	}
	rebuild_game_world_navmesh();
}

open_all_doors :: proc() {
	for door: component_iterator(Door) {
		door.open_door();
	}
	rebuild_game_world_navmesh();
}

setup_lobby :: proc() {
	game_state = Game_State.LOBBY;
	countdown_active = false;
	countdown_start_time = 0.0;
	lobby_timer_paused = false;
	lobby_timer_paused_at = 0.0;
	lobby_relaxed_min_players_active = false;
	lobby_under_min_players_since = 0.0;
	lobby_minigame_active = false;
	lobby_minigame_wait_since = 0.0;
	lobby_minigame_started_at = 0.0;
	game_end_time = 0.0;
	waiting_for_restart = false;
	rr_end_game_pending = false;
	rr_end_game_pending_started_at = 0.0;
	rr_end_game_pending_victor = Player_Type.CIVILIAN;
	rr_vote_results_active = false;
	rr_vote_results_end_time = 0.0;
	rr_vote_eject_start_time = 0.0;
	rr_vote_eject_player_id = 0;
	rr_vote_eject_anim_started = false;
	rr_vote_eject_anim_start_time = 0.0;
	meeting_cooldown_ends_at = 0.0;
	post_meeting_kill_lockout_ends_at = 0.0;
	meeting_initiator_id = 0;
	meeting_initiator_from_body = false;
	deaths_since_last_meeting = List(u64).{};
	rr_started_solo_test_mode = false;
	rr_round_start_player_count = 0;
	close_all_doors();
	rr_destroy_all_portals();
	rr_hitman_clear_mines();
	rr_autograph_clear_traps();
	rr_ggg_clear_traps();
	rr_ggg_clear_decoys();
	rr_ggg_clear_nest();
	rr_pyro_extinguish_all_fires();
	// Clear all Mimicer Void Pillars
	for p: component_iterator(Player) {
		rr_mimicer_clear_void_pillars(p);
	}
	// Reset sabotages
	rr_power_outage_active = false;
	rr_power_outage_disable_los_occlusion = false;
	rr_power_outage_started_at = 0.0;
	rr_power_outage_triggered_by_id = 0;
	rr_power_outage_cooldown_ends_at = 0.0;
	if rr_power_outage_generator_entity != null && #alive(rr_power_outage_generator_entity) {
		rr_power_outage_generator_entity.destroy();
	}
	rr_power_outage_generator_entity = null;
	rr_comms_outage_active = false;
	rr_comms_outage_started_at = 0.0;
	rr_comms_outage_triggered_by_id = 0;
	rr_comms_outage_cooldown_ends_at = 0.0;
	rr_lockdown_active = false;
	rr_lockdown_started_at = 0.0;
	rr_lockdown_triggered_by_id = 0;
	rr_lockdown_cooldown_ends_at = 0.0;
	rr_lockdown_ends_at = 0.0;
	rr_global_sabotage_cooldown_ends_at = 0.0;
	fake_meeting_cooldown_ends_at = 0.0;
	for player: component_iterator(Player) {
		rr_power_outage_remove_generator_task_from_player(player);
		rr_comms_outage_remove_enable_comms_task_from_player(player);
		rr_force_reset_hitman_sniper_zoom(player);
		rr_lily_cleanup(player);
		on_player_go_passive(player);
		// Lobby reset: everyone can hear & speak to everyone.
		player.apply_voice_chat_masks_for_current_state();
	}
	for corpse: component_iterator(Corpse) {
		corpse.entity.destroy();
	}
	rr_destroy_world_lily_pickups();
}

setup_ingame :: proc() {
	// Tear down lobby minigame state (gun skins, IK, ghost reasons, etc) before flipping flags.
	rr_lobby_minigame_stop();
	game_state = Game_State.INGAME;
	countdown_active = false;
	countdown_start_time = 0.0;
	lobby_timer_paused = false;
	lobby_timer_paused_at = 0.0;
	game_end_time = 0.0;
	waiting_for_restart = false;
	lobby_minigame_active = false;
	lobby_minigame_wait_since = 0.0;
	lobby_minigame_started_at = 0.0;
	rr_end_game_pending = false;
	rr_end_game_pending_started_at = 0.0;
	rr_end_game_pending_victor = Player_Type.CIVILIAN;
	voting_start_time = 0.0;
	rr_vote_results_active = false;
	rr_vote_results_end_time = 0.0;
	meeting_cooldown_ends_at = 0.0;
	// Lock out all player-affecting abilities (kill, stun, etc.) for the first 20s of each round.
	post_meeting_kill_lockout_ends_at = get_time() + INITIAL_ROUND_ATTACK_LOCKOUT_SECONDS;
	meeting_initiator_id = 0;
	meeting_initiator_from_body = false;
	deaths_since_last_meeting = List(u64).{};
	rr_destroy_all_portals();
	// If a lockdown is active (should be rare), respect it.
	if rr_lockdown_active {
		close_all_doors();
	} else {
		open_all_doors();
	}
	rr_lockdown_cooldown_ends_at = get_time() + INITIAL_ROUND_ATTACK_LOCKOUT_SECONDS;
	// Start-of-round: comms are functional.
	rr_comms_outage_active = false;
	rr_comms_outage_started_at = 0.0;
	rr_comms_outage_triggered_by_id = 0;
	// Sabotages start on cooldown for the same duration as abilities.
	rr_comms_outage_cooldown_ends_at = get_time() + INITIAL_ROUND_ATTACK_LOCKOUT_SECONDS;
	rr_global_sabotage_cooldown_ends_at = get_time() + INITIAL_ROUND_ATTACK_LOCKOUT_SECONDS;
	rr_update_comms_lever_visuals();
	rr_power_outage_active = false;
	rr_power_outage_disable_los_occlusion = false;
	rr_power_outage_started_at = 0.0;
	rr_power_outage_triggered_by_id = 0;
	rr_power_outage_cooldown_ends_at = get_time() + INITIAL_ROUND_ATTACK_LOCKOUT_SECONDS;
	if rr_power_outage_generator_entity != null && #alive(rr_power_outage_generator_entity) {
		rr_power_outage_generator_entity.destroy();
	}
	rr_power_outage_generator_entity = null;
	// Clear any lingering sabotage tasks from previous round.
	for player: component_iterator(Player) {
		rr_power_outage_remove_generator_task_from_player(player);
		rr_comms_outage_remove_enable_comms_task_from_player(player);
	}
	jester_win_active = false;
	jester_win_player_id = 0;
	jester_win_start_time = 0.0;
	// Fake meetings start on cooldown so the prankster can't call one immediately.
	fake_meeting_cooldown_ends_at = get_time() + INITIAL_ROUND_ATTACK_LOCKOUT_SECONDS;
}

rr_werewolf_force_revert_for_meeting :: proc(player: Player) {
	if player == null return;
	now := get_time();
	// Revert infected players' wolf look
	if player.werewolf_infected {
		player.werewolf_skin_enable_at = 0.0;
		player.werewolf_skin_disable_at = now;
		player.werewolf_infected_transform_trigger_at = 0.0;
	}
	// Revert actual werewolf transform
	if player.player_role != Player_Role.WEREWOLF || player.player_type != Player_Type.TRAITOR return;
	wm := player.entity.get_component(Werewolf_Module);
	if wm == null return;
	if wm.is_wolf_form {
		player.set_trigger("RESET");
	}
	wm.is_wolf_form = false;
	wm.transform_ends_at = 0.0;
	if wm.speed_boost_active {
		player.agent.movement_speed = wm.speed_original;
		wm.speed_boost_active = false;
	}
	player.werewolf_skin_enable_at = 0.0;
	player.werewolf_skin_disable_at = now;
}

// Run immediately after teleport so transform-reverts are masked by the jump
// and never visible during the meeting animation in the original room.
rr_force_revert_all_roles_for_meeting :: proc(player: Player) {
	rr_ggg_force_revert(player);
	rr_mimicer_force_revert(player);
	rr_lily_force_revert(player);
	rr_werewolf_force_revert_for_meeting(player);
	rr_bc_force_revert(player);
}

setup_voting :: proc() {
	game_state = Game_State.VOTING;
	voting_start_time = get_time();
	rr_vote_results_active = false;
	rr_vote_results_end_time = 0.0;
	rr_vote_hurry_deadline = 0.0;
	close_all_doors();
	
	// Reset all votes
	for player: component_iterator(Player) {
		player.voted_for = null;
		player.has_voted = false;
		player.voted_skip = false;
		player.votes_received = 0;

		// Revert before teleporting: Lily's eye-machine / spider (leg-steal) reverts
		// reattach her detached body via rr_lily_reattach_body_from_origin, which
		// snaps player.entity back to the ability origin. Doing it after the teleport
		// undoes the jump to the voting circle.
		rr_force_revert_all_roles_for_meeting(player);
		world_references.teleport_to_voting(player);
	}
}

cast_vote :: proc(voter: Player, target: Player) {
	if voter.has_voted {
		// Already voted, can't change vote
		return;
	}
	if voter.player_state != Player_State.ALIVE || target.player_state != Player_State.ALIVE {
		return;
	}
	if game_state != Game_State.VOTING {
		return;
	}
	
	voter.voted_for = target;
	voter.has_voted = true;
	voter.voted_skip = false;
	vote_weight := 1;
	if voter.player_role == Player_Role.PRESIDENT {
		vote_weight = 2;
	}
	target.votes_received += vote_weight;
}

cast_skip_vote :: proc(voter: Player) {
	if voter.has_voted {
		return;
	}
	if voter.player_state != Player_State.ALIVE {
		return;
	}
	if game_state != Game_State.VOTING {
		return;
	}

	voter.voted_for = null;
	voter.has_voted = true;
	voter.voted_skip = true;

	vote_weight := 1;
	if voter.player_role == Player_Role.PRESIDENT {
		vote_weight = 2;
	}
}

start_meeting :: proc(from_body: bool, caller: Player) -> bool {
	// Can only start meetings during gameplay.
	if game_state != Game_State.INGAME {
		if !from_body && caller != null {
			caller.Notify("Can't call a meeting right now.");
		}
		return false;
	}

	// Only alive players can start meetings.
	if caller != null && caller.player_state != Player_State.ALIVE {
		return false;
	}

	// Capture meeting metadata for the upcoming voting UI.
	meeting_initiator_id = 0;
	meeting_initiator_from_body = false;
	if caller != null {
		meeting_initiator_id = caller.entity.id;
		meeting_initiator_from_body = from_body;
	}

	// Cooldown only for non-body meetings.
	if !from_body {
		now := get_time();
		if now < meeting_cooldown_ends_at {
			if caller != null {
				remaining := meeting_cooldown_ends_at - now;
				caller.Notify(format_string("Meeting on cooldown: %s", .{format_float(remaining, decimals=0)}));
			}
			return false;
		}
		meeting_cooldown_ends_at = now + MEETING_COOLDOWN_SECONDS;

		// Play meeting-call SFX once (server authoritative).
		rr_play_call_meeting_sound(caller);
	}

	// Release any carried bodies / live drags before the meeting starts.
	// Transform-reverts are deferred to teleport time (see setup_voting) so they
	// aren't visible mid-room.
	for p: component_iterator(Player) {
		rr_drag_body_force_drop_for_player(p);
		rr_ggg_stop_live_drag(p);
		rr_lily_stop_live_drag(p);
		rr_bc_exit_camera(p);
	}

	// Clear active light sabotage (power outage) when entering a meeting/cutscene.
	// The meeting teleports players to a well-lit voting area, so the sabotage effect
	// should not persist through the meeting.
	if rr_power_outage_active {
		rr_end_power_outage(null);
	}

	// Save every player's ability cooldowns so they can be restored after the meeting.
	// This effectively pauses cooldowns for the entire meeting duration.
	for p: component_iterator(Player) {
		p.meeting_saved_cooldowns.clear();
		for i: 0..p.abilities.count-1 {
			p.meeting_saved_cooldowns.append(p.abilities[i].current_cooldown);
		}
	}

	// Save remaining sabotage cooldowns so they can be restored after the meeting.
	now := get_time();
	rr_saved_power_outage_cooldown_remaining = max(0.0, rr_power_outage_cooldown_ends_at - now);
	rr_saved_comms_outage_cooldown_remaining = max(0.0, rr_comms_outage_cooldown_ends_at - now);
	rr_saved_lockdown_cooldown_remaining = max(0.0, rr_lockdown_cooldown_ends_at - now);
	rr_saved_global_sabotage_cooldown_remaining = max(0.0, rr_global_sabotage_cooldown_ends_at - now);
	rr_saved_fake_meeting_cooldown_remaining = max(0.0, fake_meeting_cooldown_ends_at - now);

	// Cancel any pending end-game queued by the 1v1 auto-end while INGAME.
	// The meeting outcome must take precedence: if voting ejects the last traitor,
	// civilians should win instead of the stale traitor-victory firing on return to INGAME.
	rr_end_game_pending = false;
	rr_end_game_pending_started_at = 0.0;
	rr_end_game_pending_victor = Player_Type.CIVILIAN;

	if from_body {
		game_state = Game_State.ANIM_BODY_FOUND;
		body_found_popup.show();
	} else {
		game_state = Game_State.ANIM_MEETING_CALLED;
		meeting_called_popup.show();
	}

	return true;
}

body_found_popup: Body_Found_Popup;
meeting_called_popup: Meeting_Called_Popup;
role_spin_popup: Role_Spin_Popup;
intro_popup: Intro_Popup;
victory_popup: Victory_Popup;

ao_start :: proc() {
	rr_set_matchmaking(0);
	rr_refresh_rng_state();
	setup_lobby();
	body_found_popup = new();
	body_found_popup.init();
	meeting_called_popup = new();
	meeting_called_popup.init();
	role_spin_popup = new();
	role_spin_popup.init();
	intro_popup = new();
	intro_popup.init();
	victory_popup = new();
	victory_popup.init();
  }

ao_update :: proc(dt: float) {
	rr_update_matchmaking_priority();

	// Keep timed sabotages progressing regardless of game_state (e.g., lockdown during voting).
	rr_update_lockdown();

	if(game_state == Game_State.LOBBY) {
		ao_update_lobby(dt);
	} else if(game_state == Game_State.ANIM_ROLE_SPIN) {
		ao_update_role_spin(dt);
	} else if(game_state == Game_State.ANIM_INTRO) {
		ao_update_intro(dt);
	} else if(game_state == Game_State.INGAME) {
		ao_update_ingame(dt);
	} else if(game_state == Game_State.ANIM_BODY_FOUND) {
		ao_update_body_found(dt);
	} else if(game_state == Game_State.ANIM_MEETING_CALLED) {
		ao_update_meeting_called(dt);
	} else if(game_state == Game_State.VOTING) {
		ao_update_voting(dt);
	} else if(game_state == Game_State.ANIM_VOTE_EJECT) {
		ao_update_vote_eject(dt);
	} else if(game_state == Game_State.ANIM_JESTER_WIN) {
		ao_update_jester_win(dt);
	} else if(game_state == Game_State.ANIM_PYRO_WIN) {
		ao_update_pyro_win(dt);
	} else if(game_state == Game_State.ANIM_BC_MASS_BIRTH) {
		ao_update_bc_mass_birth(dt);
	} else if(game_state == Game_State.ANIM_HACKER_WIN) {
		ao_update_hacker_win(dt);
	} else if(game_state == Game_State.ANIM_VICTORY) {
		ao_update_victory(dt);
	}
	body_found_popup.update(dt);
	meeting_called_popup.update(dt);
	victory_popup.update(dt);
  }

get_alive_player_count :: proc() -> int {
	alive_count := 0;
	for i: 0..players.elements.count-1 {
		player := players.elements[i];
		if player == null continue;
		if !#alive(player.entity) continue;
		if player.player_state == Player_State.ALIVE {
			alive_count += 1;
		}
	}
	return alive_count;
}

get_player_count :: proc(type: Player_Type) -> int {
	count := 0;
	for i: 0..players.elements.count-1 {
		if players.elements[i].player_state == Player_State.ALIVE && players.elements[i].player_type == type {
			count += 1;
		}
	}
	return count;
}

all_civilians_completed_tasks :: proc() -> bool {
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p.player_state == Player_State.PASSIVE continue;
		if p.player_type == Player_Type.CIVILIAN {
			// Check if this civilian has completed all their tasks
			if p.active_tasks.elements.count == 0 {
				return false; // No tasks assigned means not completed
			}
			for j: 0..p.active_tasks.elements.count-1 {
				if !p.active_tasks.elements[j].completed {
					return false; // Found an incomplete task
				}
			}
		}
	}
	return true;
}

end_game_with_winners :: proc(victor: Player_Type, winners: List(Player)) {
	// Show victory popup with winning players
	victory_popup.show(victor, winners);
	game_state = Game_State.ANIM_VICTORY;
	
	// Properly transition all players to passive (removes ghost reasons, restores speed, etc.).
	for i: 0..players.elements.count-1 {
		on_player_go_passive(players.elements[i]);
		rr_lily_cleanup(players.elements[i]);
		// Strip mini-Charlie visuals/locks/followers so the victory screen and
		// lobby don't show players still wrapped up as Big Charlie spawn.
		rr_bc_cleanup(players.elements[i]);
		// setup_lobby() also clears these, but only after the victory popup —
		// clear now so pillars don't linger in the victory cinematic.
		rr_mimicer_clear_void_pillars(players.elements[i]);
		// Clear tasks at end of round
		players.elements[i].active_tasks = List(Task_Base).{};
	}

	// Increment leaderboard score for each winner
	if Game.is_server() {
		for i: 0..winners.elements.count-1 {
			w := winners.elements[i];
			if w != null && #alive(w.entity) {
				leaderboard_increment_score(w, "wins", 1.0);
			}
		}
	}

	round_number += 1;
}

end_game_with_victor :: proc(victor: Player_Type) {
	// Collect winning players
	winners: List(Player);
	for i: 0..players.elements.count-1 {
		if players.elements[i].player_type == victor {
			append(ref winners, players.elements[i]);
		}
	}
	end_game_with_winners(victor, winners);
}

rr_queue_end_game_with_victor :: proc(victor: Player_Type) {
	// Only queue once.
	if rr_end_game_pending return;
	rr_end_game_pending = true;
	rr_end_game_pending_started_at = get_time();
	rr_end_game_pending_victor = victor;
}

ao_update_lobby :: proc(dt: float) {
	current_time := rr_get_lobby_timer_now();
	player_count := players.elements.count;

	// Safety: lobby should always run on the player navmesh.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		p.agent.set_navmesh_to_lock_to(world_references.main_navmesh);
	}
	
	// Check if we're waiting for restart timer (1 minute)
	if waiting_for_restart {
		elapsed := current_time - game_end_time;
		if elapsed >= 60.0 {
			waiting_for_restart = false;
			game_end_time = 0.0;
		} else {
			// Display wait timer
			remaining := 60.0 - elapsed;
			// Format as mm:ss with leading zeroes (e.g. 00:09)
			remaining_i := (remaining + 0.999).(int);
			if remaining_i < 0 { remaining_i = 0; }
			minutes := remaining_i / 60;
			seconds := remaining_i - minutes * 60;
			
			screen := UI.get_safe_screen_rect();
			rect := screen.subrect(0.5, 0.5, 0.5, 0.5, -150, -25, -150, -25);
			
			ts := UI.default_text_settings();
			ts.size = 48;
			ts.color = .{1, 1, 1, 1};
			ts.halign = .CENTER;
			ts.valign = .CENTER;
			
			msg := "Next round in: %:%";
			if lobby_timer_paused {
				msg = "Next round paused: %:%";
			}
			UI.text(rect, ts, msg, {format_int(minutes, leading_zeroes=2), format_int(seconds, leading_zeroes=2)});
			return;
		}
	}

	rr_lobby_minigame_update_state(current_time, player_count);

	// If lobby stays under the normal minimum for long enough, relax requirement for one round.
	if !lobby_relaxed_min_players_active {
		if player_count < MIN_NUMBER_OF_PLAYERS {
			if lobby_under_min_players_since <= 0.0 {
				lobby_under_min_players_since = current_time;
			}
			if current_time - lobby_under_min_players_since >= RELAXED_MIN_PLAYERS_WAIT_SECONDS {
				lobby_relaxed_min_players_active = true;
			}
		} else {
			lobby_under_min_players_since = 0.0;
		}
	}

	required_players := rr_get_lobby_required_player_count();
	
	if player_count >= required_players {
		// First round after server boot waits longer; subsequent rounds use the normal countdown.
		countdown_seconds := NORMAL_LOBBY_COUNTDOWN_SECONDS;
		if round_number == 0 {
			countdown_seconds = FIRST_ROUND_LOBBY_COUNTDOWN_SECONDS;
		}

		// Start or continue countdown
		if !countdown_active {
			countdown_active = true;
			countdown_start_time = current_time;
		}
		
		// Check if countdown has completed
		elapsed := current_time - countdown_start_time;
		if elapsed >= countdown_seconds {
			// Start the game - assign_players_to_types sets state to ANIM_INTRO
			assign_players_to_types();
		} else {
			// Display countdown on screen
			remaining := countdown_seconds - elapsed;
			// Format as mm:ss with leading zeroes (e.g. 00:04)
			remaining_i := (remaining + 0.999).(int);
			if remaining_i < 0 { remaining_i = 0; }
			minutes := remaining_i / 60;
			seconds := remaining_i - minutes * 60;
			
			screen := UI.get_safe_screen_rect();
			rect := screen.subrect(0.5, 0.5, 0.5, 0.5, -100, -25, -100, -25);
			
			ts := UI.default_text_settings();
			ts.size = 48;
			ts.color = .{1, 1, 1, 1};
			ts.halign = .CENTER;
			ts.valign = .CENTER;
			
			msg := "Game starting in: %:%";
			if lobby_timer_paused {
				msg = "Game start paused: %:%";
			}
			UI.text(rect, ts, msg, {format_int(minutes, leading_zeroes=2), format_int(seconds, leading_zeroes=2)});
		}
	} else {
		// Player count dropped below threshold, reset countdown
		if countdown_active {
			countdown_active = false;
			countdown_start_time = 0.0;
		}
	}
}

force_start_lobby_game :: proc() {
	// Safety: don't start with zero players (assign logic assumes >= 1).
	if players.elements.count <= 0 {
		return;
	}

	// Reset any pending countdown state, then reuse the normal start flow.
	countdown_active = false;
	countdown_start_time = 0.0;
	assign_players_to_types();
}

set_lobby_timer_paused :: proc(paused: bool) {
	if game_state != Game_State.LOBBY return;
	if paused == lobby_timer_paused return;

	if paused {
		lobby_timer_paused = true;
		lobby_timer_paused_at = get_time();
		return;
	}

	paused_duration := get_time() - lobby_timer_paused_at;
	if paused_duration < 0.0 {
		paused_duration = 0.0;
	}
	if waiting_for_restart {
		game_end_time += paused_duration;
	}
	if countdown_active {
		countdown_start_time += paused_duration;
	}

	lobby_timer_paused = false;
	lobby_timer_paused_at = 0.0;
}

RR_UNSTUCK_REASON_REMOVE_PASSES :: 12;

rr_remove_movement_reason_all :: proc(player: Player, reason: string) {
	if player == null return;
	// Defensive: drain duplicates in case a reason was accidentally stacked.
	for _i: 0..RR_UNSTUCK_REASON_REMOVE_PASSES-1 {
		player.remove_disable_movement_input_reason(reason);
	}
}

rr_remove_freeze_reason_all :: proc(player: Player, reason: string) {
	if player == null return;
	for _i: 0..RR_UNSTUCK_REASON_REMOVE_PASSES-1 {
		player.remove_freeze_reason(reason);
	}
}

rr_unstuck_player :: proc(player: Player) {
	if player == null return;
	if player.entity == null return;
	if !#alive(player.entity) return;

	// Disable active temporary effect components first so they don't re-apply locks next frame.
	werewolf_stun := player.entity.get_component(Werewolf_Infection_Stun);
	if werewolf_stun != null {
		werewolf_stun.active = false;
	}
	werewolf_devour := player.entity.get_component(Werewolf_Devour_Lock);
	if werewolf_devour != null {
		werewolf_devour.active = false;
	}
	hitman_mine_stun := player.entity.get_component(Hitman_Mine_Stun);
	if hitman_mine_stun != null {
		hitman_mine_stun.active = false;
	}
	hitman_snap_lock := player.entity.get_component(Hitman_Neck_Snap_Lock);
	if hitman_snap_lock != null {
		hitman_snap_lock.active = false;
	}
	hitman_fling := player.entity.get_component(Hitman_Mine_Fling);
	if hitman_fling != null {
		hitman_fling.active = false;
	}
	pirate_dig := player.entity.get_component(Pirate_Dig_Lock);
	if pirate_dig != null {
		pirate_dig.active = false;
		pirate_dig.clear_spot_digging_flag();
	}
	powder_knockback := player.entity.get_component(Powder_Keg_Knockback);
	if powder_knockback != null {
		powder_knockback.active = false;
	}
	pranked := player.entity.get_component(Pranked_Effect);
	if pranked != null {
		pranked.phase = 2;
		pranked.stun_end_time = 0.0;
	}
	autograph_write := player.entity.get_component(Movie_Star_Write_Autograph);
	if autograph_write != null {
		autograph_write.done = true;
	}
	autograph_stun := player.entity.get_component(Stunned_By_Autograph_Effect);
	if autograph_stun != null {
		autograph_stun.active = false;
	}
	ggg_transform_lock := player.entity.get_component(GGG_Transform_Lock);
	if ggg_transform_lock != null {
		ggg_transform_lock.active = false;
	}
	ggg_trap_root := player.entity.get_component(GGG_Trap_Root_Effect);
	if ggg_trap_root != null {
		ggg_trap_root.heal();
	}
	// Cancel active GGG live drag.
	rr_ggg_stop_live_drag(player);

	// Clear pyromaniac fire status through its own cleanup path.
	fire_status := player.entity.get_component(RR_Player_On_Fire_Status);
	if fire_status != null {
		fire_status.clear(false);
	}

	// Clear werewolf infection state/effects.
	if player.werewolf_infected {
		player.werewolf_infected = false;
		player.werewolf_infected_from_id = 0;
		player.werewolf_infection_expires_at = 0.0;
		rr_werewolf_clear_infected_task_override(player);
	}
	player.werewolf_infected_transform_trigger_at = 0.0;

	// Clear mimicer blind/distort state.
	player.mimicer_blinded = false;
	player.mimicer_blinded_until = 0.0;
	player.mimicer_distorted_until = 0.0;
	player.remove_disable_movement_input_reason(MIMICER_SPEW_LOCK_REASON);
	rr_mimicer_destroy_halluc_creatures(player);

	// Always reset local animation and velocity.
	player.set_trigger("RESET");
	player.agent.velocity = v2.{0, 0};
	rr_force_reset_hitman_sniper_zoom(player);

	// Remove all known movement-disable reasons, including global freeze.
	rr_remove_movement_reason_all(player, "frozen");
	rr_remove_movement_reason_all(player, WEREWOLF_INFECTION_STUN_REASON);
	rr_remove_movement_reason_all(player, WEREWOLF_DEVOUR_LOCK_REASON);
	rr_remove_movement_reason_all(player, HITMAN_MINE_STUN_REASON);
	rr_remove_movement_reason_all(player, HITMAN_NECK_SNAP_LOCK_REASON);
	rr_remove_movement_reason_all(player, HITMAN_MINE_FLING_REASON);
	rr_remove_movement_reason_all(player, PIRATE_TREASURE_DIG_REASON);
	rr_remove_movement_reason_all(player, POWDER_KEG_KNOCKBACK_REASON);
	rr_remove_movement_reason_all(player, PRANK_STUN_REASON);
	rr_remove_movement_reason_all(player, MOVIE_STAR_AUTOGRAPH_WRITE_REASON);
	rr_remove_movement_reason_all(player, MOVIE_STAR_AUTOGRAPH_STUN_REASON);
	rr_remove_movement_reason_all(player, GGG_TRANSFORM_LOCK_REASON);
	rr_remove_movement_reason_all(player, GGG_TRAP_ROOT_REASON);
	rr_remove_movement_reason_all(player, GGG_FOIL_WHIP_PULL_REASON);
	rr_remove_movement_reason_all(player, MIMICER_TRANSFORM_LOCK_REASON);
	rr_remove_movement_reason_all(player, MIMICER_VOID_LUNGE_LOCK_REASON);
	rr_remove_movement_reason_all(player, MIMICER_STUN_REASON);
	rr_remove_movement_reason_all(player, MIMICER_SPEW_LOCK_REASON);
	rr_remove_movement_reason_all(player, MIMICER_UNLEASH_LOCK_REASON);

	rr_remove_movement_reason_all(player, BC_TRANSFORM_LOCK_REASON);
	rr_remove_freeze_reason_all(player, BC_CAMERA_LOCK_REASON);

	// Lily: clear victim-side effects and end any active Lily abilities owned by this player.
	rr_lily_unstuck_player(player);

	// Keep visual state coherent after force-clears.
	player.remove_name_invisibility_reason("werewolf_transform");
	player.remove_invisibility_reason(MIMICER_INVIS_REASON);
	player.remove_name_invisibility_reason(MIMICER_NAME_INVIS_REASON);
	player.remove_invisibility_reason(BC_INVIS_REASON);
	player.remove_name_invisibility_reason(BC_NAME_INVIS_REASON);
}

// Chat command: /start
// Server-only by default (no @any annotation).
start :: proc(player: Player) {
	// Only valid from lobby.
	if game_state != Game_State.LOBBY {
		Chat.server_send_message("Can only force start from the lobby.", player);
		return;
	}

	// Reuse the same flow as the lobby UI button.
	force_start_lobby_game();
} @chat_command @youtuber

// Chat command: /r werewolf
// Force a role for the next round (applies once, then clears).
r :: proc(player: Player, role_name: string) {
	role, ok := rr_parse_role_name(role_name);
	if !ok {
		Chat.server_send_message("Unknown role. Try: sheriff, doctor, president, movie_star, coroner, warper, prankster, pyromaniac, pirate, hitman, werewolf, googoo, charlie, lily, none.", player);
		return;
	}

	player.forced_role_next_round = role;
	if role == Player_Role.NONE {
		Chat.server_send_message("Cleared forced role.", player);
		return;
	}
	Chat.server_send_message(format_string("Forced role set for next round: %", .{rr_get_role_display_name(role)}), player);
} @chat_command @youtuber

// Chat command: /role werewolf (alias for /r)
role :: proc(player: Player, role_name: string) {
	r(player, role_name);
} @chat_command @youtuber

// Chat command: /traitors 2
// Force traitor count for the next round only. Use /traitors -1 to clear.
traitors :: proc(player: Player, count: int = -1) {
	if count < 0 {
		forced_traitor_count_next_round = -1;
		Chat.server_send_message("Cleared forced traitor count.", player);
		return;
	}

	forced_traitor_count_next_round = count;
	Chat.server_send_message(format_string("Forced traitor count set for next round: % (one round only, clamped if needed).", {count}), player);
} @chat_command @youtuber

// Chat command: /end
// Ends the current round and shows victory (default: civilians).
end :: proc(player: Player) {
	if game_state == Game_State.LOBBY {
		Chat.server_send_message("Already in lobby.", player);
		return;
	}
	end_game_with_victor(Player_Type.CIVILIAN);
} @chat_command @youtuber

// Chat command: /lobby
// Returns to lobby without starting a new round.
lobby :: proc(player: Player) {
	if game_state == Game_State.LOBBY {
		Chat.server_send_message("Already in lobby.", player);
		return;
	}
	setup_lobby();
	Chat.server_send_message("Returned to lobby.", player);
} @chat_command @youtuber

// Chat command: /restart
// Resets to lobby and immediately starts a new round.
restart :: proc(player: Player) {
	setup_lobby();
	force_start_lobby_game();
} @chat_command @youtuber

// Chat command: /pause
// Pauses lobby timers (restart wait + round-start countdown).
pause :: proc(player: Player) {
	if game_state != Game_State.LOBBY {
		Chat.server_send_message("Can only pause timers in the lobby.", player);
		return;
	}
	if lobby_timer_paused {
		Chat.server_send_message("Lobby timer is already paused.", player);
		return;
	}
	set_lobby_timer_paused(true);
	Chat.server_send_message("Lobby timer paused. Use /unpause to resume.", player);
} @chat_command @youtuber

// Chat command: /unpause
// Resumes lobby timers from where they were paused.
unpause :: proc(player: Player) {
	if game_state != Game_State.LOBBY {
		Chat.server_send_message("Can only unpause timers in the lobby.", player);
		return;
	}
	if !lobby_timer_paused {
		Chat.server_send_message("Lobby timer is not paused.", player);
		return;
	}
	set_lobby_timer_paused(false);
	Chat.server_send_message("Lobby timer resumed.", player);
} @chat_command @youtuber

// Chat command: /kill
// /kill — kill yourself. /kill <player> — kill a specific player.
kill :: proc(player: Player, target: Player = null) {
	if game_state != Game_State.INGAME {
		Chat.server_send_message("You can only use /kill during a round.", player);
		return;
	}
	victim := target != null ? target : player;
	if victim.player_state != Player_State.ALIVE {
		Chat.server_send_message("That player is already dead.", player);
		return;
	}
	victim.kill();
} @chat_command @youtuber

// Chat command: /revive
// /revive — revive yourself. /revive <username> — revive a specific player by username.
revive :: proc(player: Player, target_username: string = "") {
	if game_state != Game_State.INGAME {
		Chat.server_send_message("You can only use /revive during a round.", player);
		return;
	}
	victim: Player = null;
	if target_username.count == 0 {
		victim = player;
	} else {
		needle := to_lower(target_username);
		exact: Player = null;
		prefix: Player = null;
		for p: component_iterator(Player) {
			if p == null continue;
			if !#alive(p.entity) continue;
			name_lower := to_lower(p.get_username());
			if name_lower == needle {
				exact = p;
				break;
			}
			if prefix == null && name_lower.count >= needle.count && string_substring(name_lower, 0, needle.count) == needle {
				prefix = p;
			}
		}
		victim = exact != null ? exact : prefix;
		if victim == null {
			Chat.server_send_message(format_string("No player found matching '%'.", {target_username}), player);
			return;
		}
	}
	if victim.player_state != Player_State.DEAD {
		Chat.server_send_message("That player is not dead.", player);
		return;
	}
	destroy_corpses_for_player(victim.entity.id);
	on_player_go_alive(victim);
	Chat.server_send_message(format_string("% has been revived.", {victim.get_username()}), player);
} @chat_command @youtuber

// Chat command: /cd
// Clears this player's ability cooldown timers.
cd :: proc(player: Player) {
	// If player was mid-sniper targeting, force camera + targeting cleanup as part of cooldown reset.
	rr_force_reset_hitman_sniper_zoom(player);

	for i: 0..player.abilities.count-1 {
		player.abilities[i].current_cooldown = 0.0;
	}

	// If a meeting cooldown snapshot exists for this player, keep it aligned.
	for i: 0..player.meeting_saved_cooldowns.count-1 {
		player.meeting_saved_cooldowns[i] = 0.0;
	}

	// Clear deferred per-player cooldown modifiers.
	hm := player.entity.get_component(Hitman_Module);
	if hm != null hm.kill_cooldown_adjust_seconds = 0.0;

	// These shared timers also gate ability usage (Fake Meeting + post-meeting attack lockout).
	// We clear them here so /cd behaves like a true "all ability timers" reset in test sessions.
	post_meeting_kill_lockout_ends_at = 0.0;
	meeting_cooldown_ends_at = 0.0;
	fake_meeting_cooldown_ends_at = 0.0;

	Chat.server_send_message("Ability cooldown timers reset (including shared meeting/lockout timers).", player);
} @chat_command @youtuber

// Chat command: /unstuck
// Clears active temporary effects and movement locks on yourself.
unstuck :: proc(player: Player) {
	rr_unstuck_player(player);
	Chat.server_send_message("Unstuck applied: cleared active effects and movement locks.", player);
} @chat_command @youtuber

// Chat command: /unlock
// Maxes out all ability-unlock counters for the calling player's current role.
unlock :: proc(player: Player) {
	if player == null return;
	if player.player_state != Player_State.ALIVE {
		Chat.server_send_message("Must be alive to unlock abilities.", player);
		return;
	}

	role := player.player_role;

	// GGG: nest points
	if role == Player_Role.GOO_GOO_GAGA {
		gm := player.entity.get_component(GGG_Module);
		if gm != null {
			gm.nest_points = max(gm.nest_points, GGG_SWARM_UNLOCK_NEST_POINTS);
		}
	}
	// Werewolf: kills
	if role == Player_Role.WEREWOLF {
		wm := player.entity.get_component(Werewolf_Module);
		if wm != null {
			wm.kills = max(wm.kills, WEREWOLF_CLAW_UNLOCK_KILLS);
		}
	}
	// Hitman: kills
	if role == Player_Role.HITMAN {
		hm := player.entity.get_component(Hitman_Module);
		if hm != null {
			hm.kills = max(hm.kills, HITMAN_SNIPER_UNLOCK_KILLS);
		}
	}
	// Pirate: treasure
	if role == Player_Role.PIRATE {
		pm := player.entity.get_component(Pirate_Module);
		if pm != null {
			pm.treasure = max(pm.treasure, PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST);
		}
	}
	// Mimicer: stolen faces
	if role == Player_Role.MIMICER {
		mm := player.entity.get_component(Mimicer_Module);
		if mm != null {
			mm.stolen_faces = max(mm.stolen_faces, MIMICER_UNLEASH_UNLOCK_FACES);
		}
	}
	// Big Charlie: complete Mass Birth checklist
	if role == Player_Role.BIG_CHARLIE {
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc != null {
			bc.planted_nugget_total = max(bc.planted_nugget_total, BC_CHECKLIST_NUGGETS);

			// Goal is "infect everyone" — slot every alive non-Charlie player.
			for i: 0..players.elements.count-1 {
				p := players.elements[i];
				if p == null continue;
				if !#alive(p.entity) continue;
				if p == player continue;
				if p.player_state != Player_State.ALIVE continue;

				already := false;
				for j: 0..bc.infected_player_ids.count-1 {
					if bc.infected_player_ids[j] == p.entity.id {
						already = true;
						break;
					}
				}
				if !already {
					bc.infected_player_ids.append(p.entity.id);
				}
			}

			// Solo playtest fallback: ensure at least one entry so Mass Birth unlocks.
			if bc.infected_player_ids.count == 0 {
				bc.infected_player_ids.append(BC_DUMMY_INFECTION_ID_BASE);
			}
		}
	}
	// Lily: plant tree if needed, then max out fulfilled requests
	if role == Player_Role.LILY_LOVEBRAIDS {
		lm := player.entity.get_component(Lily_Module);
		if lm != null {
			// Auto-plant tree if not yet planted
			if !lm.hair_tree_planted {
				rr_lily_place_hair_tree(player);
			}
			// Max out fulfilled requests for Deathbraid testing
			if lm.hair_tree_entity != null && #alive(lm.hair_tree_entity) {
				tc := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
				if tc != null {
					tc.fulfilled_count = LILY_DEATHBRAID_THRESHOLD;
					tc.grow();
					rr_lily_apply_tree_buffs(player);
					Notifier.notify(player, "Tree fully grown — all abilities unlocked!");
				}
			}
		}
	}
	// Prankster: jester win unlock
	if role == Player_Role.PRANKSTER {
		prk := player.entity.get_component(Prankster_Module);
		if prk != null {
			prk.prank_count = max(prk.prank_count, 3);
			prk.fake_meetings_called = max(prk.fake_meetings_called, 1);
			if prk.jester_unlocked_time <= 0.0 {
				prk.jester_unlocked_time = get_time();
			}
		}
	}
	// Pyromaniac: world fire unlock
	if role == Player_Role.PYROMANIAC {
		pyro := player.entity.get_component(Pyro_Module);
		if pyro != null {
			pyro.corpses_burned = max(pyro.corpses_burned, 1);
			pyro.rooms_burned_out = max(pyro.rooms_burned_out, PYRO_ROOMS_BURNOUT_TARGET);
			if pyro.world_fire_unlocked_time <= 0.0 {
				pyro.world_fire_unlocked_time = get_time();
			}
		}
	}
	// Hacker: complete Game Hack checklist
	if role == Player_Role.HACKER {
		hacker := rr_hacker_get_module(player);
		if hacker != null {
			hacker.hacked_tasks = max(hacker.hacked_tasks, HACKER_HACK_TASK_GOAL);
			hacker.stolen_identities = max(hacker.stolen_identities, HACKER_STEAL_IDENTITY_GOAL);
			rr_hacker_refresh_objectives(player);
		}
	}

	Chat.server_send_message("All abilities unlocked for your role.", player);
} @chat_command @youtuber

// Chat command: /task_progress 75
// Force-completes civilian tasks until overall progress reaches the given percentage.
task_progress :: proc(player: Player, percent: int = 100) {
	if game_state != Game_State.INGAME {
		Chat.server_send_message("You can only use /task_progress during a round.", player);
		return;
	}
	target := clamp(percent, 0, 100);

	total := 0;
	remaining := 0;
	rr_get_civilian_task_counts(ref total, ref remaining);
	if total <= 0 {
		Chat.server_send_message("No tasks found.", player);
		return;
	}

	target_completed := (total * target) / 100;
	current_completed := total - remaining;

	if target_completed <= current_completed {
		Chat.server_send_message(format_string("Task progress already at %% (%/%).", .{percent, current_completed, total}), player);
		return;
	}

	need_to_complete := target_completed - current_completed;
	completed_count := 0;

	for i: 0..players.elements.count-1 {
		if completed_count >= need_to_complete break;
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p.player_state == Player_State.PASSIVE continue;
		if p.player_type != Player_Type.CIVILIAN continue;

		for j: 0..p.active_tasks.elements.count-1 {
			if completed_count >= need_to_complete break;
			t := p.active_tasks.elements[j];
			if t == null continue;
			if t.completed continue;
			t.completed = true;
			completed_count += 1;
		}
	}

	Chat.server_send_message(format_string("Task progress set to ~%0%% (% tasks force-completed).", .{target, completed_count}), player);
} @chat_command @youtuber

ao_update_ingame :: proc(dt: float) {
	rr_backup_maybe_auto();
	update_autograph_traps();
	update_hitman_mines();
	update_ggg_traps();
	update_ggg_decoys();
	rr_ggg_update_radio_hijack();
	rr_update_comms_lever_visuals();
	// Keep prankster fake-meeting targets valid (reassign if dead/left).
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p.player_role == Player_Role.PRANKSTER && p.player_state == Player_State.ALIVE {
			rr_prankster_update_target(p);
		}
	}
	alive_count := get_alive_player_count();
	civilian_count := get_player_count(Player_Type.CIVILIAN);
	traitor_count := get_player_count(Player_Type.TRAITOR);
	anarchist_count := get_player_count(Player_Type.ANARCHIST);

	if rr_started_solo_test_mode {
		// Test mode is only valid while there are <=2 players.
		// If someone new joins mid-round, immediately bounce back to lobby for a fresh start.
		if players.elements.count > 2 {
			setup_lobby();
			return;
		}
		// If everyone left/died, return to lobby so the server isn't stuck.
		if alive_count == 0 {
			setup_lobby();
		}
		return;
	}

	// If an end-game is queued, wait a beat before showing victory.
	if rr_end_game_pending {
		// Hold the popup while a Lily deathbraid cinematic is still playing.
		if rr_lily_any_deathbraid_active() return;
		if (get_time() - rr_end_game_pending_started_at) >= RR_END_GAME_DELAY_AFTER_FINAL_KILL_SECONDS {
			rr_end_game_pending = false;
			rr_end_game_pending_started_at = 0.0;
			end_game_with_victor(rr_end_game_pending_victor);
		}
		return;
	}

	//Win Conditions
	// -- Prankster: does NOT auto-win. They must unlock + use the Jester Win ability.
	// Still, we need to detect when they complete prerequisites so we can start the 15s timer.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.player_type != Player_Type.ANARCHIST continue;
		prankster_check_unlock_jester_win(p);
	}

	// -- Traitor: All non-traitors are infected (mini-werewolves)
	// If there are any alive non-traitors, and all of them are currently infected, traitors win.
	alive_non_traitor := 0;
	alive_non_traitor_infected := 0;
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.player_type == Player_Type.TRAITOR continue;
		alive_non_traitor += 1;
		if p.werewolf_infected {
			alive_non_traitor_infected += 1;
		}
	}
	if alive_non_traitor > 0 && alive_non_traitor_infected == alive_non_traitor {
		rr_queue_end_game_with_victor(Player_Type.TRAITOR);
		return;
	}

	// -- Traitor: Only traitors alive
	if traitor_count > 0 && traitor_count == alive_count {
		rr_queue_end_game_with_victor(Player_Type.TRAITOR);
		return;
	}
	// -- Traitor: Numerical advantage (traitors >= all non-traitors).
	// When traitors outnumber or equal the remaining players they can always win by brute force.
	// Exception: exact 1v1 traitor-vs-sheriff — the sheriff can fight back.
	non_traitor_count := civilian_count + anarchist_count;
	if traitor_count > 0 && non_traitor_count > 0 && traitor_count >= non_traitor_count {
		// In a 1v1, the sheriff can shoot the traitor, so don't auto-end.
		should_end := true;
		if traitor_count == 1 && non_traitor_count == 1 {
			for i: 0..players.elements.count-1 {
				p := players.elements[i];
				if p == null continue;
				if !#alive(p.entity) continue;
				if p.player_state != Player_State.ALIVE continue;
				if p.player_type == Player_Type.TRAITOR continue;
				if p.player_role == Player_Role.SHERIFF {
					should_end = false;
				}
			}
		}
		if should_end {
			rr_queue_end_game_with_victor(Player_Type.TRAITOR);
			return;
		}
	}
	// -- Civilian: All traitors are dead
	if traitor_count == 0 {
		rr_queue_end_game_with_victor(Player_Type.CIVILIAN);
		return;
	}
	// -- Civilian: Only civilians alive
	if civilian_count > 0 && civilian_count == alive_count {
		rr_queue_end_game_with_victor(Player_Type.CIVILIAN);
		return;
	}
	// -- Civilian: All civilians completed all their tasks
	if civilian_count > 0 && all_civilians_completed_tasks() {
		end_game_with_victor(Player_Type.CIVILIAN);
		return;
	}
}

ao_update_body_found :: proc(dt: float) {
	// Wait for popup animation to finish before starting voting
	if body_found_popup.is_finished() {
		body_found_popup.hide();
		setup_voting();
	}
}

