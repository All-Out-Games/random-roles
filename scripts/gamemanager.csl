import "core:ao"

// Random state used by tasks/roles. Keep this as a class instance (not a top-level u64)
// to avoid collisions with engine-provided globals in some build configurations.
RR_Rng_State :: class {
	value: u64;
}

rr_rng_state: RR_Rng_State;

rr_refresh_rng_state :: proc() {
	if rr_rng_state == null {
		rr_rng_state = new(RR_Rng_State);
	}
	rr_rng_state.value = rng_seed((get_real_time() * 1000000000).(u64));
}

// --- Role variety (no duplicates per round, maximize variety across rounds) ---
civilian_role_bag: List(Player_Role);
anarchist_role_bag: List(Player_Role);
traitor_role_bag: List(Player_Role);

shuffle_role_list :: proc(list: ref List(Player_Role)) {
	if list.elements.count <= 1 return;
	rr_refresh_rng_state();
	for i: 0..list.elements.count-1 {
		j := rng_range_int(ref rr_rng_state.value, i, list.elements.count-1);
		tmp := list.elements[i];
		list.elements[i] = list.elements[j];
		list.elements[j] = tmp;
	}
}

shuffle_player_list :: proc(list: ref List(Player)) {
	if list.elements.count <= 1 return;
	rr_refresh_rng_state();
	for i: 0..list.elements.count-1 {
		j := rng_range_int(ref rr_rng_state.value, i, list.elements.count-1);
		tmp := list.elements[i];
		list.elements[i] = list.elements[j];
		list.elements[j] = tmp;
	}
}

role_list_contains :: proc(list: List(Player_Role), role: Player_Role) -> bool {
	for i: 0..list.elements.count-1 {
		if list.elements[i] == role return true;
	}
	return false;
}

ensure_role_bag_valid :: proc(bag: ref List(Player_Role), master: List(Player_Role)) {
	// If master changed (new roles added/removed) invalidate the bag so we refill cleanly.
	for i: 0..bag.elements.count-1 {
		if !role_list_contains(master, bag.elements[i]) {
			bag = List(Player_Role).{};
			return;
		}
	}
}

refill_role_bag_if_needed :: proc(bag: ref List(Player_Role), master: List(Player_Role)) {
	ensure_role_bag_valid(ref bag, master);
	if bag.elements.count > 0 return;
	bag = List(Player_Role).{};
	for i: 0..master.elements.count-1 {
		append(ref bag, master.elements[i]);
	}
	shuffle_role_list(ref bag);
}

draw_roles_from_bag :: proc(bag: ref List(Player_Role), master: List(Player_Role), count: int) -> List(Player_Role) {
	drawn: List(Player_Role);
	if count <= 0 return drawn;
	if master.elements.count <= 0 return drawn;

	// Never draw more than the number of distinct roles available (no duplicates per round).
	to_draw := min(count, master.elements.count);
	for i: 0..to_draw-1 {
		refill_role_bag_if_needed(ref bag, master);
		// Bag is guaranteed non-empty here if master non-empty.
		role := bag.elements[bag.elements.count - 1];
		pop(ref bag);
		append(ref drawn, role);
	}
	return drawn;
}

MIN_NUMBER_OF_PLAYERS: int : 4;

// Non-body-report meetings (button/fake meetings) cooldown to prevent spam.
MEETING_COOLDOWN_SECONDS :: 30.0;

Game_State :: enum {
    LOBBY;
	ANIM_INTRO;
	INGAME;
	ANIM_BODY_FOUND;
	ANIM_MEETING_CALLED;
	VOTING;
	ANIM_JESTER_WIN;
	ANIM_VICTORY;
}

Player_Type :: enum {
    CIVILIAN;
	ANARCHIST;
	TRAITOR;
}

Player_State :: enum {
    PASSIVE;
	ALIVE;
	DEAD;
}

Player_Role :: enum {
    NONE;
	//Civilian Roles
	SHERIFF;
	DOCTOR;
	PRESIDENT;
	MOVIE_STAR;
	//Anarchist Roles
	PRANKSTER;
	//Traitor Roles
	PIRATE;
}

// --- Movie Star: Autograph trap ---
MOVIE_STAR_AUTOGRAPH_STUN_SECONDS :: 15.0;
MOVIE_STAR_AUTOGRAPH_TRAP_LIFETIME_SECONDS :: 45.0;
MOVIE_STAR_AUTOGRAPH_TRIGGER_RADIUS :: 0.8;

Autograph_Trap_Entry :: class {
	pos: v2;
	owner_entity_id: u64;
	expires_at: float;
}

autograph_traps: List(Autograph_Trap_Entry);

rr_add_autograph_trap :: proc(owner: Player, pos: v2) {
	if owner == null return;
	entry := new(Autograph_Trap_Entry);
	entry.pos = pos;
	entry.owner_entity_id = owner.entity.id;
	entry.expires_at = get_time() + MOVIE_STAR_AUTOGRAPH_TRAP_LIFETIME_SECONDS;
	append(ref autograph_traps, entry);
}

update_autograph_traps :: proc() {
	if autograph_traps.elements.count <= 0 return;
	now := get_time();

	i := 0;
	while i < autograph_traps.elements.count {
		trap := autograph_traps.elements[i];
		if trap == null {
			last := autograph_traps.elements.count - 1;
			autograph_traps.elements[i] = autograph_traps.elements[last];
			pop(ref autograph_traps);
			continue;
		}

		// Expire
		if now >= trap.expires_at {
			last := autograph_traps.elements.count - 1;
			autograph_traps.elements[i] = autograph_traps.elements[last];
			pop(ref autograph_traps);
			continue;
		}

		// Trigger: first alive player (not owner) who walks over it.
		triggered := false;
		for p_i: 0..players.elements.count-1 {
			p := players.elements[p_i];
			if p == null continue;
			if !#alive(p.entity) continue;
			if p.player_state != Player_State.ALIVE continue;
			if p.entity.id == trap.owner_entity_id continue;

			if in_range(p.entity.world_position - trap.pos, MOVIE_STAR_AUTOGRAPH_TRIGGER_RADIUS) {
				// Apply stun effect
				eff := p.entity->get_component(Stunned_By_Autograph_Effect);
				if eff == null {
					eff = p.entity->add_component(Stunned_By_Autograph_Effect);
				}
				eff->arm(MOVIE_STAR_AUTOGRAPH_STUN_SECONDS);
				triggered = true;
				break;
			}
		}

		if triggered {
			last := autograph_traps.elements.count - 1;
			autograph_traps.elements[i] = autograph_traps.elements[last];
			pop(ref autograph_traps);
			continue;
		}

		i += 1;
	}
}

game_state: Game_State;
countdown_start_time: float;
countdown_active: bool;
game_end_time: float;
waiting_for_restart: bool;
voting_start_time: float;
round_number: int;
meeting_cooldown_ends_at: float;

// --- Single-player test mode ---
// If a round is started with only one player (via force start), we disable all end-game win triggers.
// This is useful for local testing without being kicked back to lobby by "only X alive" conditions.
rr_started_solo_test_mode: bool;
rr_round_start_player_count: int;

// --- Fake meeting (Prankster) ---
fake_meeting_active: bool;
fake_meeting_caller_id: u64;

// --- Jester Win cinematic (Prankster) ---
JESTER_WIN_CINEMATIC_TIME :: 5.0;
jester_win_active: bool;
jester_win_start_time: float;
jester_win_player_id: u64;

start_fake_meeting :: proc(caller: Player) {
	// Only allow during gameplay
	if game_state != Game_State.INGAME return;
	if caller == null return;
	if caller.player_state != Player_State.ALIVE return;

	// Use the normal meeting flow (meeting called popup -> voting).
	// Respect meeting cooldown (only applies to non-body meetings).
	if !start_meeting(false, caller) {
		return;
	}

	fake_meeting_active = true;
	fake_meeting_caller_id = caller.entity.id;
	caller.prankster_fake_meetings_called += 1;
}

prankster_check_unlock_jester_win :: proc(player: Player) {
	if player == null return;
	if player.player_role != Player_Role.PRANKSTER return;
	// Requires BOTH objectives before unlocking
	if player.prankster_prank_count >= 3 && player.prankster_fake_meetings_called >= 1 {
		if player.prankster_jester_unlocked_time <= 0.0 {
			player.prankster_jester_unlocked_time = get_time();
			player->Notify("Jester Win unlocked! Survive 15s, then use it to win.");
		}
	}
}

start_jester_win_cinematic :: proc(caller: Player) {
	if caller == null return;
	if caller.player_state != Player_State.ALIVE return;
	if caller.player_role != Player_Role.PRANKSTER return;
	if game_state != Game_State.INGAME return;

	jester_win_active = true;
	jester_win_start_time = get_time();
	jester_win_player_id = caller.entity.id;

	// Freeze game flow + show cinematic
	game_state = Game_State.ANIM_JESTER_WIN;
	close_all_doors();

	// Play the trickster end animation (must be wired into the player's anim state machine)
	caller->set_facing_right(true);
	caller->set_trigger("jester_win");
}

on_player_go_dead :: proc(player: Player) {
	player.player_state = Player_State.DEAD;
	// Safety: temporary resurrection should always end when dead.
	player.is_temporarily_resurrected = false;
	player.temporarily_resurrected_until = 0.0;
	player->add_ghost_reason("spectator");
	player.agent->set_navmesh_to_lock_to(world_references.ghost_navmesh);
	player->apply_voice_chat_masks_for_current_state();
}

on_player_go_passive :: proc(player: Player) {
	player->revive();
	player.player_state = Player_State.PASSIVE;
	// Safety: passive/lobby players should never remain in temporary-resurrect state.
	player.is_temporarily_resurrected = false;
	player.temporarily_resurrected_until = 0.0;
	world_references->teleport_near_lobby(player);
	player->remove_ghost_reason("spectator");
	player.agent->set_navmesh_to_lock_to(world_references.main_navmesh);
	player->apply_voice_chat_masks_for_current_state();
}

on_player_go_alive :: proc(player: Player) {
	player->revive();
	player.player_state = Player_State.ALIVE;
	player->remove_ghost_reason("spectator");
	player.agent->set_navmesh_to_lock_to(world_references.main_navmesh);
	rebuild_game_world_navmesh();
	player->apply_voice_chat_masks_for_current_state();
}

close_all_doors :: proc() {
	foreach door: component_iterator(Door) {
		door->close_door();
	}
	rebuild_game_world_navmesh();
}

open_all_doors :: proc() {
	foreach door: component_iterator(Door) {
		door->open_door();
	}
	rebuild_game_world_navmesh();
}

setup_lobby :: proc() {
	game_state = Game_State.LOBBY;
	countdown_active = false;
	countdown_start_time = 0.0;
	game_end_time = 0.0;
	waiting_for_restart = false;
	meeting_cooldown_ends_at = 0.0;
	rr_started_solo_test_mode = false;
	rr_round_start_player_count = 0;
	close_all_doors();
	foreach player: component_iterator(Player) {
		on_player_go_passive(player);
		// Lobby reset: everyone can hear & speak to everyone.
		player->apply_voice_chat_masks_for_current_state();
	}
	foreach corpse: component_iterator(Corpse) {
		destroy_entity(corpse.entity);
	}
}

setup_ingame :: proc() {
	game_state = Game_State.INGAME;
	countdown_active = false;
	countdown_start_time = 0.0;
	game_end_time = 0.0;
	waiting_for_restart = false;
	voting_start_time = 0.0;
	meeting_cooldown_ends_at = 0.0;
	open_all_doors();
	jester_win_active = false;
	jester_win_player_id = 0;
	jester_win_start_time = 0.0;
}

setup_voting :: proc() {
	game_state = Game_State.VOTING;
	voting_start_time = get_time();
	close_all_doors();
	
	// Reset all votes
	foreach player: component_iterator(Player) {
		player.voted_for = null;
		player.has_voted = false;
		player.voted_skip = false;
		player.votes_received = 0;
		world_references->teleport_to_voting(player);
	}
}

cast_vote :: proc(voter: Player, target: Player) {
	if voter.has_voted {
		// Already voted, can't change vote
		return;
	}
	if voter.player_state != Player_State.ALIVE || target.player_state != Player_State.ALIVE {
		return;
	}
	if game_state != Game_State.VOTING {
		return;
	}
	
	voter.voted_for = target;
	voter.has_voted = true;
	voter.voted_skip = false;
	vote_weight := 1;
	if voter.player_role == Player_Role.PRESIDENT {
		vote_weight = 2;
	}
	target.votes_received += vote_weight;
	
	if vote_weight == 2 {
		voter->Notify(format_string("You voted for % (2x)", .{target.entity->get_name()}));
	} else {
		voter->Notify(format_string("You voted for %", .{target.entity->get_name()}));
	}
}

cast_skip_vote :: proc(voter: Player) {
	if voter.has_voted {
		return;
	}
	if voter.player_state != Player_State.ALIVE {
		return;
	}
	if game_state != Game_State.VOTING {
		return;
	}

	voter.voted_for = null;
	voter.has_voted = true;
	voter.voted_skip = true;

	vote_weight := 1;
	if voter.player_role == Player_Role.PRESIDENT {
		vote_weight = 2;
	}

	if vote_weight == 2 {
		voter->Notify("You voted to skip (2x)");
	} else {
		voter->Notify("You voted to skip");
	}
}

start_meeting :: proc(from_body: bool, caller: Player) -> bool {
	// Can only start meetings during gameplay.
	if game_state != Game_State.INGAME {
		if !from_body && caller != null {
			caller->Notify("Can't call a meeting right now.");
		}
		return false;
	}

	// Cooldown only for non-body meetings.
	if !from_body {
		now := get_time();
		if now < meeting_cooldown_ends_at {
			if caller != null {
				remaining := meeting_cooldown_ends_at - now;
				caller->Notify(format_string("Meeting on cooldown: %{.0}s", .{remaining}));
			}
			return false;
		}
		meeting_cooldown_ends_at = now + MEETING_COOLDOWN_SECONDS;
	}

	if from_body {
		game_state = Game_State.ANIM_BODY_FOUND;
		body_found_popup->show();
	} else {
		game_state = Game_State.ANIM_MEETING_CALLED;
		meeting_called_popup->show();
	}

	return true;
}

body_found_popup: Body_Found_Popup;
meeting_called_popup: Meeting_Called_Popup;
intro_popup: Intro_Popup;
victory_popup: Victory_Popup;

ao_start :: proc() {
	rr_refresh_rng_state();
	setup_lobby();
	body_found_popup = new();
	body_found_popup->init();
	meeting_called_popup = new();
	meeting_called_popup->init();
	intro_popup = new();
	intro_popup->init();
	victory_popup = new();
	victory_popup->init();
  }

ao_update :: proc(dt: float) {
	if(game_state == Game_State.LOBBY) {
		ao_update_lobby(dt);
	} else if(game_state == Game_State.ANIM_INTRO) {
		ao_update_intro(dt);
	} else if(game_state == Game_State.INGAME) {
		ao_update_ingame(dt);
	} else if(game_state == Game_State.ANIM_BODY_FOUND) {
		ao_update_body_found(dt);
	} else if(game_state == Game_State.ANIM_MEETING_CALLED) {
		ao_update_meeting_called(dt);
	} else if(game_state == Game_State.VOTING) {
		ao_update_voting(dt);
	} else if(game_state == Game_State.ANIM_JESTER_WIN) {
		ao_update_jester_win(dt);
	} else if(game_state == Game_State.ANIM_VICTORY) {
		ao_update_victory(dt);
	}
	body_found_popup->update(dt);
	meeting_called_popup->update(dt);
	victory_popup->update(dt);
  }

get_alive_player_count :: proc() -> int {
	// Clean up null/invalid players by rebuilding the list with only valid players
	valid_players: List(Player);
	for i: 0..players.elements.count-1 {
		player := players.elements[i];
		// Only keep players that are not null and have alive entities
		if player != null && #alive(player.entity) {
			append(ref valid_players, player);
		}
	}
	// Replace the old list with the cleaned list
	players = valid_players;
	
	// Count alive players
	alive_count := 0;
	for i: 0..players.elements.count-1 {
		if players.elements[i].player_state == Player_State.ALIVE {
			alive_count += 1;
		}
	}
	return alive_count;
}

get_player_count :: proc(type: Player_Type) -> int {
	count := 0;
	for i: 0..players.elements.count-1 {
		if players.elements[i].player_state == Player_State.ALIVE && players.elements[i].player_type == type {
			count += 1;
		}
	}
	return count;
}

all_civilians_completed_tasks :: proc() -> bool {
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p.player_state == Player_State.ALIVE && p.player_type == Player_Type.CIVILIAN {
			// Check if this civilian has completed all their tasks
			if p.active_tasks.elements.count == 0 {
				return false; // No tasks assigned means not completed
			}
			for j: 0..p.active_tasks.elements.count-1 {
				if !p.active_tasks.elements[j].completed {
					return false; // Found an incomplete task
				}
			}
		}
	}
	return true;
}

end_game_with_winners :: proc(victor: Player_Type, winners: List(Player)) {
	// Show victory popup with winning players
	victory_popup->show(victor, winners);
	game_state = Game_State.ANIM_VICTORY;
	
	// Set all players to passive
	for i: 0..players.elements.count-1 {
		players.elements[i].player_state = Player_State.PASSIVE;
		// Clear tasks at end of round
		players.elements[i].active_tasks = List(Task_Base).{};
	}

	round_number += 1;
}

end_game_with_victor :: proc(victor: Player_Type) {
	// Collect winning players
	winners: List(Player);
	for i: 0..players.elements.count-1 {
		if players.elements[i].player_type == victor {
			append(ref winners, players.elements[i]);
		}
	}
	end_game_with_winners(victor, winners);
}

ao_update_lobby :: proc(dt: float) {
	current_time := get_time();
	player_count := players.elements.count;
	
	// Check if we're waiting for restart timer (1 minute)
	if waiting_for_restart {
		elapsed := current_time - game_end_time;
		if elapsed >= 60.0 {
			waiting_for_restart = false;
			game_end_time = 0.0;
		} else {
			// Display wait timer
			remaining := 60.0 - elapsed;
			wait_text := format_string("Next round in: %{.2} seconds", .{remaining});
			
			screen := UI.get_safe_screen_rect();
			rect := screen->subrect(0.5, 0.5, 0.5, 0.5, -150, -25, -150, -25);
			
			ts := UI.default_text_settings();
			ts.size = 48;
			ts.color = .{1, 1, 1, 1};
			ts.halign = .CENTER;
			ts.valign = .CENTER;
			
			UI.text(rect, ts, wait_text);
			return;
		}
	}
	
	if player_count >= MIN_NUMBER_OF_PLAYERS {
		// Start or continue countdown
		if !countdown_active {
			countdown_active = true;
			countdown_start_time = current_time;
		}
		
		// Check if countdown has completed (10 seconds)
		elapsed := current_time - countdown_start_time;
		if elapsed >= 10.0 {
			// Start the game - assign_players_to_types sets state to ANIM_INTRO
			assign_players_to_types();
		} else {
			// Display countdown on screen
			remaining := 10.0 - elapsed;
			countdown_text := format_string("Game starting in: %{.2}", .{remaining});
			
			screen := UI.get_safe_screen_rect();
			rect := screen->subrect(0.5, 0.5, 0.5, 0.5, -100, -25, -100, -25);
			
			ts := UI.default_text_settings();
			ts.size = 48;
			ts.color = .{1, 1, 1, 1};
			ts.halign = .CENTER;
			ts.valign = .CENTER;
			
			UI.text(rect, ts, countdown_text);
		}
	} else {
		// Player count dropped below threshold, reset countdown
		if countdown_active {
			countdown_active = false;
			countdown_start_time = 0.0;
		}
	}
}

force_start_lobby_game :: proc() {
	// Safety: don't start with zero players (assign logic assumes >= 1).
	if players.elements.count <= 0 {
		return;
	}

	// Reset any pending countdown state, then reuse the normal start flow.
	countdown_active = false;
	countdown_start_time = 0.0;
	assign_players_to_types();
}

ao_update_ingame :: proc(dt: float) {
	update_temporary_resurrections();
	update_autograph_traps();
	alive_count := get_alive_player_count();
	civilian_count := get_player_count(Player_Type.CIVILIAN);
	traitor_count := get_player_count(Player_Type.TRAITOR);
	anarchist_count := get_player_count(Player_Type.ANARCHIST);

	if rr_started_solo_test_mode {
		return;
	}

	//Win Conditions
	// -- Prankster: does NOT auto-win. They must unlock + use the Jester Win ability.
	// Still, we need to detect when they complete prerequisites so we can start the 15s timer.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.player_type != Player_Type.ANARCHIST continue;
		prankster_check_unlock_jester_win(p);
	}

	// -- Traitor: Only traitors alive
	if traitor_count > 0 && traitor_count == alive_count {
		end_game_with_victor(Player_Type.TRAITOR);
		return;
	}
	// -- Civilian: Only civilians alive
	if civilian_count > 0 && civilian_count == alive_count {
		end_game_with_victor(Player_Type.CIVILIAN);
		return;
	}
	// -- Civilian: All civilians completed all their tasks
	if civilian_count > 0 && all_civilians_completed_tasks() {
		end_game_with_victor(Player_Type.CIVILIAN);
		return;
	}
}

update_temporary_resurrections :: proc() {
	now := get_time();
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if !p.is_temporarily_resurrected continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.temporarily_resurrected_until <= 0.0 continue;
		if now < p.temporarily_resurrected_until continue;

		// Time's up: return them to dead state and spawn a new corpse at their current position.
		p->kill();
	}
}

ao_update_body_found :: proc(dt: float) {
	// Wait for popup animation to finish before starting voting
	if body_found_popup->is_finished() {
		body_found_popup->hide();
		setup_voting();
	}
}

ao_update_meeting_called :: proc(dt: float) {
	// Wait for popup animation to finish before starting voting
	if meeting_called_popup->is_finished() {
		meeting_called_popup->hide();
		setup_voting();
	}
}

ao_update_intro :: proc(dt: float) {
	// Wait for intro popup animation to finish before starting gameplay
	if intro_popup->is_finished() {
		intro_popup->hide();
		setup_ingame();
	}
}

ao_update_victory :: proc(dt: float) {
	// Wait for victory popup animation to finish before returning to lobby
	if victory_popup->is_finished() {
		victory_popup->hide();
		setup_lobby();
	}
}

ao_update_jester_win :: proc(dt: float) {
	elapsed := get_time() - jester_win_start_time;
	if elapsed < JESTER_WIN_CINEMATIC_TIME {
		return;
	}

	// After the cinematic, end the game with only the jester as winner.
	winners: List(Player);
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p != null && #alive(p.entity) && p.entity.id == jester_win_player_id {
			append(ref winners, p);
			break;
		}
	}

	jester_win_active = false;
	jester_win_player_id = 0;
	jester_win_start_time = 0.0;

	if winners.elements.count > 0 {
		end_game_with_winners(Player_Type.ANARCHIST, winners);
	} else {
		end_game_with_victor(Player_Type.ANARCHIST);
	}
}

ao_update_voting :: proc(dt: float) {
	current_time := get_time();
	elapsed := current_time - voting_start_time;
	
	// Display voting timer
	remaining := 60.0 - elapsed;
	if remaining < 0.0 { remaining = 0.0; }
	
	voting_text := format_string("Voting ends in: %{.0} seconds", .{remaining});
	
	screen := UI.get_safe_screen_rect();
	rect := screen->subrect(0.5, 0.1, 0.5, 0.1, -150, -25, -150, -25);
	
	ts := UI.default_text_settings();
	ts.size = 48;
	ts.color = .{1, 1, 1, 1};
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	
	UI.text(rect, ts, voting_text);

	// Check if all alive players have voted - early end if so
	alive_count := 0;
	voted_count := 0;
	for i: 0..players.elements.count-1 {
		if players.elements[i].player_state == Player_State.ALIVE {
			alive_count += 1;
			if players.elements[i].has_voted {
				voted_count += 1;
			}
		}
	}
	
	if alive_count > 0 && voted_count == alive_count {
		end_voting();
		return;
	}
	
	// After 1 minute, end voting and return to game
	if elapsed >= 60.0 {
		end_voting();
	}
}

end_voting :: proc() {
	// If this was a fake meeting, skip ejection entirely.
	if fake_meeting_active {
		for i: 0..players.elements.count-1 {
			players.elements[i]->Notify("It was a fake meeting!");
		}
		fake_meeting_active = false;
		fake_meeting_caller_id = 0;
	} else {
		// Tally skip votes (weighted)
		skip_votes := 0;
		for i: 0..players.elements.count-1 {
			v := players.elements[i];
			if v == null continue;
			if v.player_state != Player_State.ALIVE continue;
			if !v.has_voted continue;
			if !v.voted_skip continue;
			if v.player_role == Player_Role.PRESIDENT {
				skip_votes += 2;
			} else {
				skip_votes += 1;
			}
		}

		// Tally player votes and detect ties robustly.
		max_player_votes := 0;
		max_player: Player = null;
		max_player_count := 0;

		for i: 0..players.elements.count-1 {
			p := players.elements[i];
			if p == null continue;
			if p.player_state != Player_State.ALIVE continue;

			if p.votes_received > max_player_votes {
				max_player_votes = p.votes_received;
				max_player = p;
				max_player_count = 1;
			} else if p.votes_received == max_player_votes && max_player_votes > 0 {
				max_player_count += 1;
			}
		}

		// Resolution:
		// - Skip beats player max => no ejection.
		// - Skip ties player max (and > 0) => tie, no ejection.
		// - Player tie (>1 with max, and max > 0) => tie, no ejection.
		// - Single player max (>0) and skip lower => eject that player.
		if skip_votes > max_player_votes {
			for i: 0..players.elements.count-1 {
				players.elements[i]->Notify("Vote skipped. No one was ejected.");
			}
		} else if skip_votes == max_player_votes && max_player_votes > 0 {
			for i: 0..players.elements.count-1 {
				players.elements[i]->Notify("It's a tie! No one was ejected.");
			}
		} else if max_player_votes <= 0 {
			for i: 0..players.elements.count-1 {
				players.elements[i]->Notify("No votes were cast. No one was ejected.");
			}
		} else if max_player_count > 1 || max_player == null {
			for i: 0..players.elements.count-1 {
				players.elements[i]->Notify("It's a tie! No one was ejected.");
			}
		} else {
			// Eject the unique top-voted player.
			on_player_go_dead(max_player);

			ejected_message := format_string("% has been ejected!", .{max_player.entity->get_name()});
			for i: 0..players.elements.count-1 {
				players.elements[i]->Notify(ejected_message);
			}
		}
	}
	
	// Reset votes
	for i: 0..players.elements.count-1 {
		players.elements[i].voted_for = null;
		players.elements[i].has_voted = false;
		players.elements[i].voted_skip = false;
		players.elements[i].votes_received = 0;
	}
	
	game_state = Game_State.INGAME;
	voting_start_time = 0.0;
	open_all_doors();
	
	// Notify all players
	for i: 0..players.elements.count-1 {
		players.elements[i]->Notify("Voting has ended. The game continues!");
	}
}

//Player count should change how many of each type there are
//Player count is from 5 - 10.
//at 5:  3 CIV, 1 AN, 1 TR
//at 6:  4 CIV, 1 AN, 1 TR
//at 7:  4 CIV, 1 AN, 2 TR
//at 8:  5 CIV, 1 AN, 2 TR
//at 9:  5 CIV, 2 AN, 2 TR
//at 10: 6 CIV, 2 AN, 2 TR
assign_players_to_types :: proc() {
	player_count := players.elements.count;

	// Capture round start count for special-case behaviors.
	rr_round_start_player_count = player_count;
	rr_started_solo_test_mode = (player_count == 1);
	if rr_started_solo_test_mode {
		for i: 0..players.elements.count-1 {
			if players.elements[i] != null {
				players.elements[i]->Notify("Solo test mode: game will not end automatically.");
			}
		}
	}
	
	// Determine counts for each type based on player count
	civ_count: int;
	an_count: int;
	tr_count: int;

	if player_count == 1 {
		// Special case: solo testing should always be civilian.
		civ_count = 1;
		an_count = 0;
		tr_count = 0;
	} else if player_count < 5 {
		civ_count = player_count - 1;
		an_count = 0;
		tr_count = 1;
	} else if player_count == 5 {
		civ_count = 3;
		an_count = 1;
		tr_count = 1;
	} else if player_count == 6 {
		civ_count = 4;
		an_count = 1;
		tr_count = 1;
	} else if player_count == 7 {
		civ_count = 4;
		an_count = 1;
		tr_count = 2;
	} else if player_count == 8 {
		civ_count = 5;
		an_count = 1;
		tr_count = 2;
	} else if player_count == 9 {
		civ_count = 5;
		an_count = 2;
		tr_count = 2;
	} else {
		// player_count >= 10
		civ_count = player_count - 4;
		an_count = 2;
		tr_count = 2;
	}
	
	// Create a list of types to assign
	type_list: []Player_Type = new(Player_Type, player_count);
	
	// Fill the array with the correct counts
	index := 0;
	for i: 0..civ_count-1 {
		type_list[index] = Player_Type.CIVILIAN;
		index += 1;
	}
	for i: 0..an_count-1 {
		type_list[index] = Player_Type.ANARCHIST;
		index += 1;
	}
	for i: 0..tr_count-1 {
		type_list[index] = Player_Type.TRAITOR;
		index += 1;
	}
	
	// Shuffle the type list using Fisher-Yates algorithm
	rng := rng_seed((player_count.(u64) + round_number.(u64)));
	for i: 0..type_list.count-1 {
		j := rng_range_int(ref rng, i, type_list.count-1);
		temp := type_list[i];
		type_list[i] = type_list[j];
		type_list[j] = temp;
	}
	
	// Assign types to players
	for i: 0..players.elements.count-1 {
		if i < type_list.count {
			on_player_go_alive(players.elements[i]);
			players.elements[i].player_type = type_list[i];
			
			// Clear old tasks and assign new tasks to civilians
			players.elements[i].active_tasks = List(Task_Base).{};
			if type_list[i] == Player_Type.CIVILIAN {
				players.elements[i].active_tasks = get_random_task_list(5, players.elements[i]);
			}
		}
	}

	// Assign roles
	civilian_roles_master: List(Player_Role);
	anarchist_roles_master: List(Player_Role);
	traitor_roles_master: List(Player_Role);

	append(ref civilian_roles_master, Player_Role.SHERIFF);
	append(ref civilian_roles_master, Player_Role.DOCTOR);
	append(ref civilian_roles_master, Player_Role.PRESIDENT);
	append(ref civilian_roles_master, Player_Role.MOVIE_STAR);
	append(ref anarchist_roles_master, Player_Role.PRANKSTER);
	append(ref traitor_roles_master, Player_Role.PIRATE);

	civ_players: List(Player);
	an_players: List(Player);
	tr_players: List(Player);

	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		p.player_role = Player_Role.NONE;
		if p.player_type == Player_Type.CIVILIAN {
			append(ref civ_players, p);
		} else if p.player_type == Player_Type.ANARCHIST {
			append(ref an_players, p);
		} else if p.player_type == Player_Type.TRAITOR {
			append(ref tr_players, p);
		}
	}

	// Shuffle who receives roles within each type for extra randomness.
	shuffle_player_list(ref civ_players);
	shuffle_player_list(ref an_players);
	shuffle_player_list(ref tr_players);

	civ_roles := draw_roles_from_bag(ref civilian_role_bag, civilian_roles_master, civ_players.elements.count);
	an_roles := draw_roles_from_bag(ref anarchist_role_bag, anarchist_roles_master, an_players.elements.count);
	tr_roles := draw_roles_from_bag(ref traitor_role_bag, traitor_roles_master, tr_players.elements.count);

	for i: 0..civ_roles.elements.count-1 {
		civ_players.elements[i].player_role = civ_roles.elements[i];
	}
	for i: 0..an_roles.elements.count-1 {
		an_players.elements[i].player_role = an_roles.elements[i];
	}
	for i: 0..tr_roles.elements.count-1 {
		tr_players.elements[i].player_role = tr_roles.elements[i];
	}

	// Assign role-specific tasks / objectives
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		
		// Per-round resets
		p.doctor_resurrects_used = 0;

		if p.player_role == Player_Role.PRANKSTER {
			p.active_tasks = List(Task_Base).{};
			task := new(Task_Prank_3_People);
			task.id = "prank_3_people";
			task.started = true; // Show as an active objective immediately
			append(ref p.active_tasks, task);

			fake_task := new(Task_Call_Fake_Meeting);
			fake_task.id = "call_fake_meeting";
			fake_task.started = true;
			append(ref p.active_tasks, fake_task);

			// Reset prank progress at round start
			p.prankster_prank_count = 0;
			p.prankster_fake_meetings_called = 0;
			p.prankster_jester_unlocked_time = 0.0;
		}
	}
	
	// Show intro popup for local player
	intro_popup->show();
	
	// Switch to intro animation state
	game_state = Game_State.ANIM_INTRO;
}