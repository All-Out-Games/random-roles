	// Wait for popup animation to finish before starting voting
	if meeting_called_popup.is_finished() {
		meeting_called_popup.hide();
		setup_voting();
	}
}

ao_update_role_spin :: proc(dt: float) {
	// Time-based finish, just like other popups
	if role_spin_popup.is_finished() {
		role_spin_popup.hide();
		intro_popup.show();
		game_state = Game_State.ANIM_INTRO;
