}

ao_update_jester_win :: proc(dt: float) {
	elapsed := get_time() - jester_win_start_time;
	if elapsed < JESTER_WIN_CINEMATIC_TIME {
		return;
	}

	// After the cinematic, end the game with only the jester as winner.
	winners: List(Player);
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p != null && #alive(p.entity) && p.entity.id == jester_win_player_id {
			append(ref winners, p);
			break;
		}
	}

	jester_win_active = false;
	jester_win_player_id = 0;
	jester_win_start_time = 0.0;

	if winners.elements.count > 0 {
		end_game_with_winners(Player_Type.ANARCHIST, winners);
	} else {
		end_game_with_victor(Player_Type.ANARCHIST);
	}
}

ao_update_pyro_win :: proc(dt: float) {
	elapsed := get_time() - pyro_win_start_time;
	if elapsed < PYRO_WIN_CINEMATIC_TIME {
		return;
	}

	// After the cinematic, end the game with only the pyromaniac as winner.
	winners: List(Player);
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p != null && #alive(p.entity) && p.entity.id == pyro_win_player_id {
			append(ref winners, p);
			break;
		}
	}

	pyro_win_active = false;
	pyro_win_player_id = 0;
	pyro_win_start_time = 0.0;

	if winners.elements.count > 0 {
		end_game_with_winners(Player_Type.ANARCHIST, winners);
	} else {
		end_game_with_victor(Player_Type.ANARCHIST);
	}
}

ao_update_bc_mass_birth :: proc(dt: float) {
	// During the cinematic, drive Big Charlie's per-frame stampede / wave-of-deaths.
	// Per-player updates run from Player.ao_update which checks bc.mass_birth_active.

	elapsed := get_time() - bc_mass_birth_start_time;
	if elapsed < BC_MASS_BIRTH_CINEMATIC_TIME {
		return;
	}

	// Endscreen: "Big Charlie Wins" — only the BC player is in the winner list.
	winners: List(Player);
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p != null && #alive(p.entity) && p.entity.id == bc_mass_birth_player_id {
			append(ref winners, p);
			break;
		}
	}

	// Release Charlie's mass-birth freeze before handing off to the endgame
	// flow so the victory pose / lobby return aren't stuck in place.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		p.remove_freeze_reason(BC_MASS_BIRTH_LOCK_REASON);
	}

	bc_mass_birth_active = false;
	bc_mass_birth_player_id = 0;
	bc_mass_birth_start_time = 0.0;

	if winners.elements.count > 0 {
		end_game_with_winners(Player_Type.ANARCHIST, winners);
	} else {
		end_game_with_victor(Player_Type.ANARCHIST);
	}
}

ao_update_voting :: proc(dt: float) {
	current_time := get_time();

	// During the brief results reveal phase, keep the game in VOTING but do not
	// allow further voting interaction/tallying.
	if rr_vote_results_active {
		if rr_vote_results_end_time > 0.0 && current_time >= rr_vote_results_end_time {
			// If there is an ejected player, delay the cinematic until after
			// the vote reveal UI has had time to play.
			if Game.is_server() && rr_last_vote_ejected_player_id != 0 && !rr_last_vote_was_fake_meeting {
				ejected := get_player_by_entity_id(rr_last_vote_ejected_player_id);
				rr_vote_results_active = false;
				rr_vote_results_end_time = 0.0;
				if ejected != null && #alive(ejected.entity) && ejected.player_state == Player_State.ALIVE {
					start_vote_eject_cinematic(ejected);
				} else {
					finalize_voting();
				}
			} else {
				finalize_voting();
			}
		}
		return;
	}

	elapsed := current_time - voting_start_time;
	
	// Display voting timer
	remaining := 60.0 - elapsed;
	if remaining < 0.0 { remaining = 0.0; }
	
	// Check if all alive players have voted - early end if so
	alive_count := 0;
	voted_count := 0;
	for i: 0..players.elements.count-1 {
		if players.elements[i].player_state == Player_State.ALIVE {
			alive_count += 1;
			if players.elements[i].has_voted {
				voted_count += 1;
			}
		}
	}
	
	if alive_count > 0 && voted_count == alive_count {
		if Game.is_server() {
			end_voting();
			return;
		}
	}

	// When all alive except 1 have voted, start a shorter countdown.
	if alive_count > 1 && voted_count >= alive_count - 1 && rr_vote_hurry_deadline <= 0.0 {
		hurry_end := current_time + RR_VOTE_HURRY_SECONDS;
		normal_end := voting_start_time + 60.0;
		// Only shorten if the hurry deadline is actually sooner.
		if hurry_end < normal_end {
			rr_vote_hurry_deadline = hurry_end;
		}
	}
	
	// Determine effective deadline (whichever comes first).
	deadline := voting_start_time + 60.0;
	if rr_vote_hurry_deadline > 0.0 && rr_vote_hurry_deadline < deadline {
		deadline = rr_vote_hurry_deadline;
	}

	if current_time >= deadline {
		if Game.is_server() {
			end_voting();
			return;
		}
	}
}

ao_update_vote_eject :: proc(dt: float) {
	if rr_vote_eject_start_time <= 0.0 return;
	elapsed := get_time() - rr_vote_eject_start_time;

	if Game.is_server() && !rr_vote_eject_text_sfx_played {
		rr_vote_eject_text_sfx_played = true;
		p := get_player_by_entity_id(rr_vote_eject_player_id);
		if p != null && #alive(p.entity) {
			sfx := SFX.default_sfx_desc();
			sfx.entity_to_follow = p.entity.id;
			sfx.volume = 0.9;
			sfx.volume_perturb = 0.05;
			sfx.speed_perturb = 0.05;
			// Global SFX mix: everything at 25% volume.
			sfx.volume *= 0.25;
			sfx.volume_perturb *= 0.25;
			rr_play_sfx("sfx/voteout.wav", sfx);
		}
	}

	// Wait for the text reveal window to finish before zoom/throw.
	if elapsed < RR_VOTE_EJECT_TEXT_SECONDS {
		return;
	}

	anim_start_at := RR_VOTE_EJECT_TEXT_SECONDS + RR_VOTE_EJECT_CAMERA_ZOOM_SECONDS;
	if !rr_vote_eject_anim_started && elapsed >= anim_start_at {
		rr_vote_eject_anim_started = true;
		rr_vote_eject_anim_start_time = get_time();
		if Game.is_server() {
			p := get_player_by_entity_id(rr_vote_eject_player_id);
			if p != null && #alive(p.entity) {
				p.set_facing_right(true);
				p.set_trigger("death_vote2");
			}
		}
		if Game.is_server() && !rr_vote_eject_anim_sfx_played {
			rr_vote_eject_anim_sfx_played = true;
			p := get_player_by_entity_id(rr_vote_eject_player_id);
			if p != null && #alive(p.entity) {
				sfx := SFX.default_sfx_desc();
				sfx.entity_to_follow = p.entity.id;
				sfx.volume = 0.9;
				sfx.volume_perturb = 0.05;
				sfx.speed_perturb = 0.05;
				// Global SFX mix: everything at 25% volume.
				sfx.volume *= 0.25;
				sfx.volume_perturb *= 0.25;
				rr_play_sfx("sfx/cm_dragged_down.wav", sfx);
			}
		}
	}

	if !rr_vote_eject_anim_started || (get_time() - rr_vote_eject_anim_start_time) < RR_VOTE_EJECT_ANIM_SECONDS {
		return;
	}

	if Game.is_server() {
		p := get_player_by_entity_id(rr_vote_eject_player_id);
		if p != null && #alive(p.entity) {
			p.set_trigger("RESET");
			on_player_go_dead(p);
		}

		rr_vote_eject_start_time = 0.0;
		rr_vote_eject_player_id = 0;
		rr_vote_eject_anim_started = false;
		rr_vote_eject_anim_start_time = 0.0;
		rr_vote_eject_text_sfx_played = false;
		rr_vote_eject_anim_sfx_played = false;

		finalize_voting();
	}
}

end_voting :: proc() {
	// Server-authoritative.
	if !Game.is_server() return;

	// Auto-cast skip for any alive player who did not vote.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.has_voted continue;
		cast_skip_vote(p);
	}

	// Begin results phase (don't transition out of VOTING yet).
	rr_vote_results_active = true;
	rr_vote_results_end_time = get_time() + RR_VOTE_RESULTS_REVEAL_SECONDS;

	// If this was a fake meeting, skip ejection entirely.
	if fake_meeting_active {
		rr_last_vote_result_time = get_time();
		rr_last_vote_ejected_player_id = 0;
		rr_last_vote_was_fake_meeting = true;
		rr_last_vote_prankster_got_voted = false;

		// Credit the prankster's fake-meeting task when their assigned target
		// would have been ejected (sole top-voted player AND beats skip votes).
		caller := get_player_by_entity_id(fake_meeting_caller_id);
		if caller != null && #alive(caller.entity) && caller.player_role == Player_Role.PRANKSTER {
			// Tally skip votes (weighted, same rules as real meetings).
			fm_skip_votes := 0;
			for i: 0..players.elements.count-1 {
				v := players.elements[i];
				if v == null continue;
				if v.player_state != Player_State.ALIVE continue;
				if !v.has_voted continue;
				if !v.voted_skip continue;
				if v.player_role == Player_Role.PRESIDENT {
					fm_skip_votes += 2;
				} else {
					fm_skip_votes += 1;
				}
			}

			// Tally player votes to see who would have been ejected.
			fm_max_votes := 0;
			fm_max_player: Player = null;
			fm_max_count := 0;
			for i: 0..players.elements.count-1 {
				p := players.elements[i];
				if p == null continue;
				if p.player_state != Player_State.ALIVE continue;
				if p.votes_received > fm_max_votes {
					fm_max_votes = p.votes_received;
					fm_max_player = p;
					fm_max_count = 1;
				} else if p.votes_received == fm_max_votes && fm_max_votes > 0 {
					fm_max_count += 1;
				}
			}
			// Success: target is the sole top-voted player AND their votes beat skips
			// (mirrors real meeting ejection rules — skip wins means no credit).
			prk := caller.entity.get_component(Prankster_Module);
			if prk != null && fm_max_count == 1 && fm_max_player != null && fm_max_votes > 0 && fm_skip_votes <= fm_max_votes && prk.fake_meeting_target_id != 0 && fm_max_player.entity.id == prk.fake_meeting_target_id {
				prk.fake_meetings_called += 1;
				prankster_check_unlock_jester_win(caller);
				rr_last_vote_prankster_got_voted = true;
				// Assign a new target for the next fake meeting.
				rr_prankster_assign_target(caller);
			}
		}

		if rr_last_vote_prankster_got_voted {
			for i: 0..players.elements.count-1 {
				players.elements[i].Notify("Fake meeting! You got played by the prankster!");
			}
		} else {
			for i: 0..players.elements.count-1 {
				players.elements[i].Notify("It was a fake meeting!");
			}
		}
		fake_meeting_active = false;
		fake_meeting_caller_id = 0;
	} else {
		rr_last_vote_was_fake_meeting = false;
		rr_last_vote_prankster_got_voted = false;

		// Tally skip votes (weighted)
		skip_votes := 0;
		for i: 0..players.elements.count-1 {
			v := players.elements[i];
			if v == null continue;
			if v.player_state != Player_State.ALIVE continue;
			if !v.has_voted continue;
			if !v.voted_skip continue;
			if v.player_role == Player_Role.PRESIDENT {
				skip_votes += 2;
			} else {
				skip_votes += 1;
			}
		}

		// Tally player votes and detect ties robustly.
		max_player_votes := 0;
		max_player: Player = null;
		max_player_count := 0;

		for i: 0..players.elements.count-1 {
			p := players.elements[i];
			if p == null continue;
			if p.player_state != Player_State.ALIVE continue;

			if p.votes_received > max_player_votes {
				max_player_votes = p.votes_received;
				max_player = p;
				max_player_count = 1;
			} else if p.votes_received == max_player_votes && max_player_votes > 0 {
				max_player_count += 1;
			}
		}

		// Resolution:
		// - Skip beats player max => no ejection.
		// - Player tie (>1 with max, and max > 0) => tie, no ejection.
		// - Single player max (>0) and skip <= player max => eject that player.
		if skip_votes > max_player_votes {
			rr_last_vote_result_time = get_time();
			rr_last_vote_ejected_player_id = 0;
			for i: 0..players.elements.count-1 {
				players.elements[i].Notify("Vote skipped. No one was ejected.");
			}
		} else if max_player_votes <= 0 {
			rr_last_vote_result_time = get_time();
			rr_last_vote_ejected_player_id = 0;
			for i: 0..players.elements.count-1 {
				players.elements[i].Notify("No votes were cast. No one was ejected.");
			}
		} else if max_player_count > 1 || max_player == null {
			rr_last_vote_result_time = get_time();
			rr_last_vote_ejected_player_id = 0;
			for i: 0..players.elements.count-1 {
				players.elements[i].Notify("It's a tie! No one was ejected.");
			}
		} else {
			// Eject the unique top-voted player.
			rr_register_player_death(max_player.entity.id);
			rr_last_vote_result_time = get_time();
			rr_last_vote_ejected_player_id = max_player.entity.id;
		}
	}

	// Note: The rest of voting cleanup + transition back to INGAME happens in finalize_voting()
	// after the brief results reveal window.
}

finalize_voting :: proc() {
	// Server-authoritative.
	if !Game.is_server() return;

	// Restore saved ability cooldowns (paused during the meeting).
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		for j: 0..p.abilities.count-1 {
			if j < p.meeting_saved_cooldowns.count {
				p.abilities[j].current_cooldown = p.meeting_saved_cooldowns[j];
			}
		}
		p.meeting_saved_cooldowns.clear();
	}

	// Restore saved sabotage cooldowns (paused during the meeting).
	restore_now := get_time();
	if rr_saved_power_outage_cooldown_remaining > 0.0 {
		rr_power_outage_cooldown_ends_at = restore_now + rr_saved_power_outage_cooldown_remaining;
	}
	if rr_saved_comms_outage_cooldown_remaining > 0.0 {
		rr_comms_outage_cooldown_ends_at = restore_now + rr_saved_comms_outage_cooldown_remaining;
	}
	if rr_saved_lockdown_cooldown_remaining > 0.0 {
		rr_lockdown_cooldown_ends_at = restore_now + rr_saved_lockdown_cooldown_remaining;
	}
	if rr_saved_global_sabotage_cooldown_remaining > 0.0 {
		rr_global_sabotage_cooldown_ends_at = restore_now + rr_saved_global_sabotage_cooldown_remaining;
	}
	if rr_saved_fake_meeting_cooldown_remaining > 0.0 {
		fake_meeting_cooldown_ends_at = restore_now + rr_saved_fake_meeting_cooldown_remaining;
	}
	rr_saved_power_outage_cooldown_remaining = 0.0;
	rr_saved_comms_outage_cooldown_remaining = 0.0;
	rr_saved_lockdown_cooldown_remaining = 0.0;
	rr_saved_global_sabotage_cooldown_remaining = 0.0;
	rr_saved_fake_meeting_cooldown_remaining = 0.0;

	// Reset votes
	for i: 0..players.elements.count-1 {
		if players.elements[i] == null continue;
		players.elements[i].voted_for = null;
		players.elements[i].has_voted = false;
		players.elements[i].voted_skip = false;
		players.elements[i].votes_received = 0;
	}
	
	// Brief lockout for killing abilities after meetings.
	post_meeting_kill_lockout_ends_at = get_time() + POST_MEETING_KILL_LOCKOUT_SECONDS;

	// Cooldown before another button/fake meeting can be called (applies after ANY meeting type).
	meeting_cooldown_ends_at = get_time() + MEETING_COOLDOWN_SECONDS;

	game_state = Game_State.INGAME;
	voting_start_time = 0.0;
	rr_vote_results_active = false;
	rr_vote_results_end_time = 0.0;
	// Next meeting should only show deaths that occur after this one ends.
	deaths_since_last_meeting = List(u64).{};
	meeting_initiator_id = 0;
	meeting_initiator_from_body = false;
	// If a lockdown is still active, keep doors locked like a meeting.
	if !rr_lockdown_active {
		open_all_doors();
	}
}

//Player count should change how many of each type there are
//Player count is from 5 - 10.
//at 5:  3 CIV, 1 AN, 1 TR
//at 6:  4 CIV, 1 AN, 1 TR
//at 7:  4 CIV, 1 AN, 2 TR
//at 8:  5 CIV, 1 AN, 2 TR
//at 9:  5 CIV, 2 AN, 2 TR
//at 10: 6 CIV, 2 AN, 2 TR
assign_players_to_types :: proc() {
	player_count := players.elements.count;
	// Relaxed lobby threshold is one-shot and only applies to entering this round.
	lobby_relaxed_min_players_active = false;
	lobby_under_min_players_since = 0.0;

	// Capture round start count for special-case behaviors.
	rr_round_start_player_count = player_count;
	rr_started_solo_test_mode = (player_count <= 2);
	if rr_started_solo_test_mode {
		for i: 0..players.elements.count-1 {
			if players.elements[i] != null {
				players.elements[i].Notify("Test mode: game will not end automatically.");
			}
		}
	}
	
	// Determine target counts for each type based on player count.
	target_civ: int;
	target_an: int;
	target_tr: int;

	if player_count <= 2 {
		// Special case: small-player test mode should always be civilian.
		target_civ = player_count;
		target_an = 0;
		target_tr = 0;
	} else if player_count < 5 {
		target_civ = player_count - 1;
		target_an = 0;
		target_tr = 1;
	} else if player_count == 5 {
		target_civ = 3;
		target_an = 1;
		target_tr = 1;
	} else if player_count == 6 {
		target_civ = 4;
		target_an = 1;
		target_tr = 1;
	} else if player_count == 7 {
		target_civ = 4;
		target_an = 1;
		target_tr = 2;
	} else if player_count == 8 {
		target_civ = 5;
		target_an = 1;
		target_tr = 2;
	} else if player_count == 9 {
		target_civ = 5;
		target_an = 2;
		target_tr = 2;
	} else {
		// player_count >= 10
		target_civ = player_count - 4;
		target_an = 2;
		target_tr = 2;
	}

	// One-shot admin override: force traitor target for this round only, then clear.
	if forced_traitor_count_next_round >= 0 {
		target_tr = clamp(forced_traitor_count_next_round, 0, max(0, player_count - target_an));
		target_civ = max(0, player_count - target_an - target_tr);
		forced_traitor_count_next_round = -1;
	}

	// Count forced roles and subtract them from the targets so the final distribution
	// respects the correct team sizes even when cheats override some slots.
	forced_civ := 0;
	forced_an := 0;
	forced_tr := 0;
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p.forced_role_next_round == Player_Role.NONE continue;
		ft := rr_get_role_type(p.forced_role_next_round);
		if ft == Player_Type.CIVILIAN  { forced_civ += 1; }
		if ft == Player_Type.ANARCHIST { forced_an  += 1; }
		if ft == Player_Type.TRAITOR   { forced_tr  += 1; }
	}

	// Adjust targets: each forced slot fills one target slot of the matching type.
	// If a forced type exceeds its target, the excess eats into the civilian pool
	// (keeping at least 0 for each).
	remaining_civ := max(0, target_civ - forced_civ);
	remaining_an  := max(0, target_an  - forced_an);
	remaining_tr  := max(0, target_tr  - forced_tr);
	// Extra forced slots that exceeded targets steal from civilians.
	excess_an := max(0, forced_an - target_an);
	excess_tr := max(0, forced_tr - target_tr);
	remaining_civ = max(0, remaining_civ - excess_an - excess_tr);
	unforced_count := player_count - forced_civ - forced_an - forced_tr;
	// Safety: if more players are unforced than remaining slots, give extras to civilians.
	total_remaining := remaining_civ + remaining_an + remaining_tr;
	if unforced_count > total_remaining {
		remaining_civ += unforced_count - total_remaining;
	}

	// Build unforced player list and assign types with purchase boosts.
	// Mix in a globally-monotonic round counter so the seed varies across
	// server instances even when rng_root_seed() collides. The game-level
	// save is published-game-wide; optimistic_update keeps client+server in
	// agreement within the same frame.
	Save.increment_game_int(RR_GLOBAL_ROUND_COUNT_KEY, 1);
	global_round_count := Save.get_game_int(RR_GLOBAL_ROUND_COUNT_KEY, 0);
	rng := rng_seed(rng_root_seed() + player_count.(u64) + round_number.(u64) * 7919 + global_round_count.(u64) * 2654435761);
	unforced_for_types: [..]Player;
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p.forced_role_next_round != Player_Role.NONE continue;
		unforced_for_types.append(p);
	}
	rp_assign_player_types(ref unforced_for_types, remaining_civ, remaining_an, remaining_tr, ref rng);

	// Apply forced types, go-alive, and tasks.
	for i: 0..players.elements.count-1 {
		on_player_go_alive(players.elements[i]);
		forced_role := players.elements[i].forced_role_next_round;
		if forced_role != Player_Role.NONE {
			players.elements[i].player_type = rr_get_role_type(forced_role);
		}

		// Clear old tasks and assign new tasks to civilians
		players.elements[i].active_tasks = List(Task_Base).{};
		if players.elements[i].player_type == Player_Type.CIVILIAN {
			players.elements[i].active_tasks = get_random_task_list(5, players.elements[i]);
		}
	}

	// Assign roles
	civilian_roles_master: List(Player_Role);
	anarchist_roles_master: List(Player_Role);
	traitor_roles_master: List(Player_Role);

	append(ref civilian_roles_master, Player_Role.SHERIFF);
	append(ref civilian_roles_master, Player_Role.DOCTOR);
	append(ref civilian_roles_master, Player_Role.PRESIDENT);
	append(ref civilian_roles_master, Player_Role.MOVIE_STAR);
	append(ref civilian_roles_master, Player_Role.CORONER);
	append(ref civilian_roles_master, Player_Role.PORTAL_MAKER);
	append(ref anarchist_roles_master, Player_Role.PRANKSTER);
	append(ref anarchist_roles_master, Player_Role.PYROMANIAC);
	append(ref anarchist_roles_master, Player_Role.HACKER);
	append(ref traitor_roles_master, Player_Role.PIRATE);
	append(ref traitor_roles_master, Player_Role.HITMAN);
	append(ref traitor_roles_master, Player_Role.WEREWOLF);
	// Purchase-gated roles: add to master if any connected player owns the product.
	if rp_any_player_owns(ref players, GGG_PRODUCT_ID) {
		append(ref traitor_roles_master, Player_Role.GOO_GOO_GAGA);
	}
	if rp_any_player_owns(ref players, MIMICER_PRODUCT_ID) {
		append(ref traitor_roles_master, Player_Role.MIMICER);
	}
	if rp_any_player_owns(ref players, BIG_CHARLIE_PRODUCT_ID) {
		append(ref anarchist_roles_master, Player_Role.BIG_CHARLIE);
	}
	if rp_any_player_owns(ref players, LILY_PRODUCT_ID) {
		append(ref traitor_roles_master, Player_Role.LILY_LOVEBRAIDS);
	}

	civ_players: List(Player);
	an_players: List(Player);
	tr_players: List(Player);

	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		p.player_role = Player_Role.NONE;
		if p.player_type == Player_Type.CIVILIAN {
			append(ref civ_players, p);
		} else if p.player_type == Player_Type.ANARCHIST {
			append(ref an_players, p);
		} else if p.player_type == Player_Type.TRAITOR {
			append(ref tr_players, p);
		}
	}

	// Assign roles with purchase-weighted boosting (handles shuffle + bag draw internally).
	rp_assign_roles_for_type(ref civ_players, ref civilian_role_bag, civilian_roles_master, ref rng, allow_duplicates=true);
	rp_assign_roles_for_type(ref an_players, ref anarchist_role_bag, anarchist_roles_master, ref rng, allow_duplicates=false);
	rp_assign_roles_for_type(ref tr_players, ref traitor_role_bag, traitor_roles_master, ref rng, allow_duplicates=false);

	// Apply forced roles for this round (one-time).
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p.forced_role_next_round == Player_Role.NONE continue;
		p.player_role = p.forced_role_next_round;
		p.forced_role_next_round = Player_Role.NONE;
	}

	// Big Charlie: nuke any leftover scene entities (cocoons, nuggets) before
	// per-player resets so previous-round artifacts can't survive a reroll.
	rr_bc_round_global_cleanup();
	rr_hacker_round_global_cleanup();

	// Assign role-specific tasks / objectives
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;

		// Per-round resets
		if p.player_role == Player_Role.DOCTOR {
			dm := p.entity.get_component(Doctor_Module);
			if dm == null {
				dm = p.entity.add_component(Doctor_Module);
			}
			dm.resurrects_used = 0;
		}
		// Sheriff: 1 bullet per round (Shoot ability will disable after firing).
		if p.player_role == Player_Role.SHERIFF {
			sm := p.entity.get_component(Sheriff_Module);
			if sm == null {
				sm = p.entity.add_component(Sheriff_Module);
			}
			sm.gun_ammo = 1;
		}
		if p.player_role == Player_Role.CORONER {
			cm := p.entity.get_component(Coroner_Module);
			if cm == null {
				cm = p.entity.add_component(Coroner_Module);
			}
			cm.dna_vials.clear();
		}
		if p.player_role == Player_Role.PORTAL_MAKER {
			portal_mod := p.entity.get_component(Portal_Maker_Module);
			if portal_mod == null {
				portal_mod = p.entity.add_component(Portal_Maker_Module);
			}
			portal_mod.red_portal = null;
			portal_mod.blue_portal = null;
		}
		if p.player_role == Player_Role.HITMAN {
			hm := p.entity.get_component(Hitman_Module);
			if hm == null {
				hm = p.entity.add_component(Hitman_Module);
			}
			hm.kills = 0;
			hm.contract_target_id = 0;
			hm.kill_cooldown_adjust_seconds = 0.0;
			hm.last_kill_style = Hitman_Kill_Style.NONE;
		}
		// Pirate — reset or create the module for pirate players.
		if p.player_role == Player_Role.PIRATE {
			pm := p.entity.get_component(Pirate_Module);
			if pm == null {
				pm = p.entity.add_component(Pirate_Module);
			}
			pm.treasure = 0;
			pm.black_flag_unlocked = true;
			pm.powder_keg_unlocked = false;
		}
		// Ensure any leftover dig-spots from prior sessions are cleared.
		destroy_pirate_dig_spots_for_player(p.entity.id);
		// Werewolf — full reset including skin state (guards against /restart race).
		p.reset_werewolf_visuals();
		// Capture round-start cosmetics so werewolf cleanup can always restore baseline look.
		p.capture_werewolf_round_start_look();
		// Werewolf module: only for actual werewolves.
		if p.player_role == Player_Role.WEREWOLF {
			wwm := p.entity.get_component(Werewolf_Module);
			if wwm == null {
				wwm = p.entity.add_component(Werewolf_Module);
			}
			wwm.kills = 0;
			wwm.is_wolf_form = false;
			wwm.transform_ends_at = 0.0;
			wwm.speed_boost_active = false;
			wwm.speed_original = 0.0;
		}

		// Goo Goo Gaga
		rr_ggg_destroy_creature_entity(p);
		if p.player_role == Player_Role.GOO_GOO_GAGA {
			ggm := p.entity.get_component(GGG_Module);
			if ggm == null {
				ggm = p.entity.add_component(GGG_Module);
			}
			ggm.nest_points = 0;
			ggm.nest_placed = false;
			ggm.nest_destroyed = false;
			ggm.nest_placing = false;
			ggm.consumed_portal_maker = false;
			ggm.consumed_doctor = false;
			ggm.is_creature_form = false;
			ggm.speed_boost_active = false;
			ggm.is_crawling = false;
			ggm.crawl_ends_at = 0.0;
			ggm.crawl_speed_active = false;
			ggm.skeleton_swap_at = 0.0;
			ggm.creature_visible = false;
			ggm.foil_whip_active = false;
			ggm.foil_whip_kill_on_arrive = false;
			ggm.dragging_live_player_id = 0;
		}

		// Lily no-eyes / crawl
		p.lily_no_eyes = false;
		p.lily_no_eyes_unlock_at = 0.0;
		p.lily_no_eyes_until = 0.0;
		if p.lily_crawling {
			rr_lily_restore_legs(p);
		}

		// Pyromaniac
		p.pyro_on_fire = false;
		if p.player_role == Player_Role.PYROMANIAC {
			pyro := p.entity.get_component(Pyro_Module);
			if pyro == null {
				pyro = p.entity.add_component(Pyro_Module);
			}
			pyro.props_ignited = 0;
			pyro.corpses_burned = 0;
			pyro.rooms_burned_out = 0;
			pyro.world_fire_unlocked_time = 0.0;
			pyro.room_exposure_timer = 0.0;
		}

		if p.player_role == Player_Role.PRANKSTER {
			p.active_tasks = List(Task_Base).{};
			task := new(Task_Prank_3_People);
			task.id = "prank_3_people";
			task.started = true; // Show as an active objective immediately
			append(ref p.active_tasks, task);

			fake_task := new(Task_Call_Fake_Meeting);
			fake_task.id = "call_fake_meeting";
			fake_task.started = true;
			append(ref p.active_tasks, fake_task);

			// Reset prank progress at round start
			prk := p.entity.get_component(Prankster_Module);
			if prk == null { prk = p.entity.add_component(Prankster_Module); }
			prk.prank_count = 0;
			prk.fake_meetings_called = 0;
			prk.jester_unlocked_time = 0.0;
			prk.fake_meeting_target_id = 0;

			// Clear the lockout cooldown applied by the previous round's
			// Jester Win cinematic
			for i: 0..p.abilities.count-1 {
				ab := p.abilities[i];
				if ab.type == Jester_Win_Ability {
					ab.current_cooldown = 0.0;
					break;
				}
			}
		}

		if p.player_role == Player_Role.GOO_GOO_GAGA {
			// GGG has a dedicated role HUD panel (like werewolf) — no task list tasks.
			p.active_tasks = List(Task_Base).{};
		}

		// Mimicer
		rr_mimicer_round_start(p);

		// Big Charlie
		rr_bc_round_start(p);

		// Hacker
		rr_hacker_round_start(p);

		// Lily
		rr_lily_round_start(p);

		if p.player_role == Player_Role.PYROMANIAC {
			// Pyro objectives replace normal tasks.
			p.active_tasks = List(Task_Base).{};

			obj1 := new(Task_Base);
			obj1.id = "pyro_burn_1_corpse";
			obj1.started = true;
			obj1.completed = false;
			append(ref p.active_tasks, obj1);

			// Collect all eligible rooms (Props entities with MIN & MAX children).
			candidate_rooms: [..]Entity;
			candidate_names: [..]string;
			for room_e: entity_iterator() {
				if room_e == null continue;
				if !#alive(room_e) continue;
				if !room_e.compare_name("Props") continue;

				has_min := false;
				has_max := false;
				bounds_child := room_e.get_first_child();
				while bounds_child != null {
					if #alive(bounds_child) {
						if bounds_child.compare_name("MIN") { has_min = true; }
						else if bounds_child.compare_name("MAX") { has_max = true; }
					}
					bounds_child = bounds_child.get_next_sibling();
				}
				if !has_min || !has_max continue;

				room_name := "Room";
				if room_e.get_parent() != null && #alive(room_e.get_parent()) {
					pname := room_e.get_parent().get_name();
					if pname.count > 0 {
						room_name = pname;
					}
				}

				append(ref candidate_rooms, room_e);
				append(ref candidate_names, room_name);
			}

			// Partial Fisher-Yates shuffle — pick PYRO_ROOMS_BURNOUT_TARGET rooms at random.
			rng: u64 = rng_seed(rng_root_seed() + round_number.(u64) + candidate_rooms.count.(u64) * 7919);
			pick_count := min(PYRO_ROOMS_BURNOUT_TARGET, candidate_rooms.count);
			for pick_i: 0..pick_count-1 {
				remaining := candidate_rooms.count - pick_i;
				swap_idx := pick_i + rng_range_int(ref rng, 0, remaining - 1);

				tmp_e := candidate_rooms[pick_i];
				candidate_rooms[pick_i] = candidate_rooms[swap_idx];
				candidate_rooms[swap_idx] = tmp_e;

				tmp_n := candidate_names[pick_i];
				candidate_names[pick_i] = candidate_names[swap_idx];
				candidate_names[swap_idx] = tmp_n;

				rt := new(RR_Pyro_Room_Task);
				rt.id = format_string("pyro_burn_room_%", .{pick_i});
				rt.started = true;
				rt.completed = false;
				rt.room_entity = candidate_rooms[pick_i];
				rt.room_name = candidate_names[pick_i];
				append(ref p.active_tasks, rt);
			}
		}
	}

	// Hitman contracts (start-of-round + after each kill).
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p.player_role != Player_Role.HITMAN continue;
		rr_hitman_assign_new_contract(p);
	}

	// Prankster fake-meeting targets.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p.player_role != Player_Role.PRANKSTER continue;
		rr_prankster_assign_target(p);
	}
	
	// Rebuild the spinner's role list so it only shows enabled roles.
	spin_rebuild_enabled_roles();
	// Ensure admin-forced roles (e.g. Mimicer) appear in the spinner.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p != null {
			spin_ensure_role(p.player_role);
		}
	}

	// Start the role spin animation (spin will trigger intro popup when done)
	role_spin_popup.show();
	game_state = Game_State.ANIM_ROLE_SPIN;
}
