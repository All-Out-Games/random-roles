import "core:ao"

// --- Global task ids (non-random, injected by game state) ---
RR_RESTART_GENERATOR_TASK_ID :: "restart_generator";
RR_ENABLE_COMMUNICATIONS_TASK_ID :: "enable_communications";

// Random state used by tasks/roles. Keep this as a class instance (not a top-level u64)
// to avoid collisions with engine-provided globals in some build configurations.
RR_Rng_State :: class {
	value: u64;
}

rr_rng_state: RR_Rng_State;
rr_rng_refresh_count: u64;

rr_refresh_rng_state :: proc() {
	if rr_rng_state == null {
		rr_rng_state = new(RR_Rng_State);
	}
	rr_rng_refresh_count += 1;
	rr_rng_state.value = rng_seed(rng_root_seed() + rr_rng_refresh_count * 7919);
}



// --- Hitman (Traitor role) ---
HITMAN_MINE_UNLOCK_KILLS :: 1;
HITMAN_SNIPER_UNLOCK_KILLS :: 2;

// --- Ghost (Spectator) ---
// Dead players move faster and see more of the map while spectating.
GHOST_SPEED_MULTIPLIER :: 1.5;
GHOST_CAMERA_ZOOMED_OUT_SIZE :: 9.0;
VOTE_EJECT_CAMERA_ZOOMED_IN_SIZE :: 5.0;

// --- Vote ejection cinematic ---
RR_VOTE_EJECT_TEXT_SECONDS :: 3.0;
RR_VOTE_EJECT_CAMERA_ZOOM_SECONDS :: 1.0;
RR_VOTE_EJECT_ANIM_SECONDS :: 4.6;

// How strongly contracts affect the Hitman's kill cooldown.
// Negative reduces cooldown; positive increases it.
HITMAN_CONTRACT_KILL_COOLDOWN_ADJUST_SECONDS :: -10.0;
HITMAN_OFF_CONTRACT_KILL_COOLDOWN_ADJUST_SECONDS :: 10.0;

rr_hitman_is_valid_contract_target :: proc(hitman: Player, target: Player) -> bool {
	if hitman == null return false;
	if target == null return false;
	if !#alive(hitman.entity) return false;
	if !#alive(target.entity) return false;
	if hitman == target return false;
	if hitman.player_state != Player_State.ALIVE return false;
	if target.player_state != Player_State.ALIVE return false;

	// Avoid uncompletable contracts: traitors can't (and shouldn't) target other traitors.
	if target.player_type == Player_Type.TRAITOR return false;

	return true;
}

rr_hitman_assign_new_contract :: proc(hitman: Player) {
	// TODO: Make it so this is a permanent on screen UI & not a notification.
	if hitman == null return;
	if hitman.player_role != Player_Role.HITMAN return;
	if hitman.player_state != Player_State.ALIVE return;
	if !hitman.is_local_or_server() return;

	// Build candidate list (exclude previous contract to reduce repeats when possible).
	candidates: List(Player);
	hm := hitman.entity.get_component(Hitman_Module);
	prev_target_id : u64 = 0;
	if hm != null prev_target_id = hm.contract_target_id;
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !rr_hitman_is_valid_contract_target(hitman, p) continue;
		// Prefer not to repeat the same contract back-to-back.
		if prev_target_id != 0 && p.entity.id == prev_target_id continue;
		append(ref candidates, p);
	}

	// If we filtered everything out (e.g. only one valid target), fall back to allowing repeats.
	// TODO: Early return if no valid target, no repeat allowed.
	if candidates.elements.count <= 0 {
		for i: 0..players.elements.count-1 {
			p := players.elements[i];
			if p == null continue;
			if !rr_hitman_is_valid_contract_target(hitman, p) continue;
			append(ref candidates, p);
		}
	}

	if candidates.elements.count <= 0 {
		if hm != null hm.contract_target_id = 0;
		return;
	}

	rr_refresh_rng_state();
	idx := rng_range_int(ref rr_rng_state.value, 0, candidates.elements.count - 1);
	target := candidates.elements[idx];
	if target == null || !#alive(target.entity) {
		if hm != null hm.contract_target_id = 0;
		return;
	}

	if hm != null hm.contract_target_id = target.entity.id;
}

rr_hitman_on_player_killed :: proc(killer_player_entity_id: u64, victim_player_entity_id: u64) {
	if killer_player_entity_id == 0 return;
	if victim_player_entity_id == 0 return;

	killer := get_player_by_entity_id(killer_player_entity_id);
	if killer == null return;
	if killer.player_role != Player_Role.HITMAN return;
	if killer.player_state != Player_State.ALIVE return;
	if !killer.is_local_or_server() return;

	hm := killer.entity.get_component(Hitman_Module);
	if hm == null return;

	is_contract := (hm.contract_target_id != 0 && hm.contract_target_id == victim_player_entity_id);
	// Only contract kills count toward Hitman unlock progress.
	if is_contract {
		hm.kills += 1;
	}

	// Professional: adjust kill cooldown based on whether the victim was the contract.
	if is_contract {
		hm.kill_cooldown_adjust_seconds += HITMAN_CONTRACT_KILL_COOLDOWN_ADJUST_SECONDS;
	} else {
		hm.kill_cooldown_adjust_seconds += HITMAN_OFF_CONTRACT_KILL_COOLDOWN_ADJUST_SECONDS;
	}

	// New contract after each kill.
	rr_hitman_assign_new_contract(killer);
}

// --- Werewolf (Traitor role) ---
rr_werewolf_on_player_killed :: proc(killer_player_entity_id: u64, victim_player_entity_id: u64) {
	if killer_player_entity_id == 0 return;
	if victim_player_entity_id == 0 return;

	killer := get_player_by_entity_id(killer_player_entity_id);
	if killer == null return;
	if killer.player_role != Player_Role.WEREWOLF return;
	if killer.player_state != Player_State.ALIVE return;
	// Track on server + local player only (avoid remote-client double counting).
	if !killer.is_local_or_server() return;

	wm := killer.entity.get_component(Werewolf_Module);
	if wm != null {
		wm.kills += 1;
	}
}

// --- Role variety (no duplicates per round, maximize variety across rounds) ---
civilian_role_bag: List(Player_Role);
anarchist_role_bag: List(Player_Role);
traitor_role_bag: List(Player_Role);

shuffle_role_list :: proc(list: ref List(Player_Role)) {
	if list.elements.count <= 1 return;
	rr_refresh_rng_state();
	for i: 0..list.elements.count-1 {
		j := rng_range_int(ref rr_rng_state.value, i, list.elements.count-1);
		tmp := list.elements[i];
		list.elements[i] = list.elements[j];
		list.elements[j] = tmp;
	}
}

shuffle_player_list :: proc(list: ref List(Player)) {
	if list.elements.count <= 1 return;
	rr_refresh_rng_state();
	for i: 0..list.elements.count-1 {
		j := rng_range_int(ref rr_rng_state.value, i, list.elements.count-1);
		tmp := list.elements[i];
		list.elements[i] = list.elements[j];
		list.elements[j] = tmp;
	}
}

role_list_contains :: proc(list: List(Player_Role), role: Player_Role) -> bool {
	for i: 0..list.elements.count-1 {
		if list.elements[i] == role return true;
	}
	return false;
}

ensure_role_bag_valid :: proc(bag: ref List(Player_Role), master: List(Player_Role)) {
	// If master changed (new roles added/removed) invalidate the bag so we refill cleanly.
	for i: 0..bag.elements.count-1 {
		if !role_list_contains(master, bag.elements[i]) {
			bag = List(Player_Role).{};
			return;
		}
	}
}

refill_role_bag_if_needed :: proc(bag: ref List(Player_Role), master: List(Player_Role)) {
	ensure_role_bag_valid(ref bag, master);
	if bag.elements.count > 0 return;
	bag = List(Player_Role).{};
	for i: 0..master.elements.count-1 {
		append(ref bag, master.elements[i]);
	}
	shuffle_role_list(ref bag);
}

draw_roles_from_bag :: proc(bag: ref List(Player_Role), master: List(Player_Role), count: int, allow_duplicate_fallback: bool) -> List(Player_Role) {
	drawn: List(Player_Role);
	if count <= 0 return drawn;
	if master.elements.count <= 0 return drawn;

	to_draw := count;
	if !allow_duplicate_fallback {
		// Hard cap — never draw more than the number of distinct roles.
		to_draw = min(count, master.elements.count);
	}

	for i: 0..to_draw-1 {
		refill_role_bag_if_needed(ref bag, master);

		// Try to find a role in the bag that hasn't been drawn this round.
		found_unique := false;
		for s: 0..bag.elements.count-1 #reverse {
			candidate := bag.elements[s];
			already_drawn := false;
			for d: 0..drawn.elements.count-1 {
				if drawn.elements[d] == candidate { already_drawn = true; break; }
			}
			if !already_drawn {
				unordered_remove_by_index(ref bag, s);
				append(ref drawn, candidate);
				found_unique = true;
				break;
			}
		}

		if !found_unique {
			if allow_duplicate_fallback {
				// All unique roles exhausted — allow a duplicate.
				refill_role_bag_if_needed(ref bag, master);
				role := bag.elements[bag.elements.count - 1];
				pop(ref bag);
				append(ref drawn, role);
			} else {
				// No duplicates allowed — stop drawing.
				break;
			}
		}
	}
	return drawn;
}

MIN_NUMBER_OF_PLAYERS: int : 8;
RELAXED_MIN_NUMBER_OF_PLAYERS: int : 6;
RELAXED_MIN_PLAYERS_WAIT_SECONDS :: 60.0;

// Lobby countdown: first round after server start is longer to let players join.
FIRST_ROUND_LOBBY_COUNTDOWN_SECONDS :: 30.0;
NORMAL_LOBBY_COUNTDOWN_SECONDS :: 25.0;

// Non-body-report meetings (button/fake meetings) cooldown to prevent spam.
MEETING_COOLDOWN_SECONDS :: 60.0;

// After a meeting/voting ends, briefly lock out killing abilities to prevent instant spawn-kills.
POST_MEETING_KILL_LOCKOUT_SECONDS :: 5.0;

// At the start of each round, all player-affecting abilities (kill, stun, etc.)
// are locked out for this many seconds so players have time to spread out.
INITIAL_ROUND_ATTACK_LOCKOUT_SECONDS :: 20.0;

