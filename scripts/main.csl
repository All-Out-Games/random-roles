import "core:ao"

Door :: class : Component {
    force_locked: bool @ao_serialize;
    collider_entity: Entity @ao_serialize;
    spine_animator: Spine_Animator @ao_serialize;

    spacing: float @ao_serialize;

    is_open: bool;

    ao_start :: proc(using this: Door) {
        collider_entity->set_local_enabled(force_locked);
        this->setup_spine_animator();
    }

    setup_spine_animator :: method() {
        // Animations in the door rigs:
        // - closed_idle (loop)
        // - opening (oneshot) -> open_idle (loop)
        // - closing (oneshot) -> closed_idle (loop)
        //
        // Triggers:
        // - open_door  => opening
        // - close_door => closing
        if spine_animator == null {
            return;
        }

        spine_animator->awaken();
        if spine_animator.instance == null {
            return;
        }

        if(spacing > 0) {
            left_bone := spine_animator.instance->get_bone_local_position("vertical_upper_root");
            right_bone := spine_animator.instance->get_bone_local_position("vertical_lower_root");
            spine_animator.instance->set_bone_local_position("vertical_upper_root", left_bone + v2.{0.0, spacing});
            spine_animator.instance->set_bone_local_position("vertical_lower_root", right_bone + v2.{0.0, -spacing});
        }

        state_machine := State_Machine.create();
        open_trigger := state_machine->create_variable("open_door", .TRIGGER);
        close_trigger := state_machine->create_variable("close_door", .TRIGGER);

        layer := state_machine->create_layer("main", 0);

        closed_idle := layer->create_state("closed_idle", true);
        opening := layer->create_state("opening", false);
        open_idle := layer->create_state("open_idle", true);
        closing := layer->create_state("closing", false);

        // Pick initial state based on starting lock state.
        if force_locked {
            is_open = false;
            layer->set_initial_state(closed_idle);
        } else {
            is_open = true;
            layer->set_initial_state(open_idle);
        }

        // closed_idle -> opening -> open_idle
        closed_to_opening := layer->create_transition(closed_idle, opening, false);
        closed_to_opening->create_trigger_condition(open_trigger);

        opening_to_open_idle := layer->create_transition(opening, open_idle, true);

        // open_idle -> closing -> closed_idle
        open_idle_to_closing := layer->create_transition(open_idle, closing, false);
        open_idle_to_closing->create_trigger_condition(close_trigger);

        closing_to_closed_idle := layer->create_transition(closing, closed_idle, true);

        // Attach to spine (transfer ownership to the Spine_Instance).
        spine_animator.instance->set_state_machine(state_machine, true);
    }

    open_door :: proc(using this: Door) {
        force_locked = false;
        collider_entity->set_local_enabled(force_locked);
        is_open = true;

        if spine_animator != null {
            spine_animator->awaken();
            if spine_animator.instance != null && spine_animator.instance.state_machine != null {
                spine_animator.instance.state_machine->set_trigger("open_door");
            } else if spine_animator.instance != null {
                spine_animator.instance->set_animation("opening", false, 0);
            }
        }
    }

    close_door :: proc(using this: Door) {
        force_locked = true;
        collider_entity->set_local_enabled(force_locked);
        is_open = false;

        if spine_animator != null {
            spine_animator->awaken();
            if spine_animator.instance != null && spine_animator.instance.state_machine != null {
                spine_animator.instance.state_machine->set_trigger("close_door");
            } else if spine_animator.instance != null {
                spine_animator.instance->set_animation("closing", false, 0);
            }
        }
    }
}

world_references: World_References;

World_References :: class : Component {
    lobby_spawn: Entity @ao_serialize;
    voting_spawn: Entity @ao_serialize;
    corpse_prefab: Prefab_Asset;
    main_navmesh: Navmesh @ao_serialize;
    ghost_navmesh: Navmesh @ao_serialize;
    map_min: Entity @ao_serialize;
    map_max: Entity @ao_serialize;
    sabotage_generator_interactable: Interactable @ao_serialize;

    ao_start :: proc(using this: World_References) {
        corpse_prefab = get_asset(Prefab_Asset, "prefabs/Corpse.prefab");
        world_references = this;
    }

    teleport_near_lobby :: proc(using this: World_References, player: Player) {
        rng := rng_seed(player.entity.id);
        random_offset :=  v2.{rng_range_float(ref rng, -2.0, 2.0), rng_range_float(ref rng, -2.0,2.0)};
        player.entity->set_local_position(lobby_spawn.world_position + random_offset);
    }

    teleport_to_voting :: proc(using this: World_References, player: Player) {
        // Find player index in the players array
        player_index := 0.0;
        for i: 0..players.elements.count-1 {
            if players.elements[i] == player {
                player_index = i.(f32);
                break;
            }
        }
        
        // Calculate position in circle around voting spawn
        total_players := players.elements.count.(f32);
        if total_players == 0.0 { total_players = 1.0; }
        radius := 3.0;
        angle := (player_index / total_players) * 2.0 * PI;
        offset := v2.{cos(angle) * radius, sin(angle) * radius};
        
        nav_point: v2;
        triangle_hint: s64;
        try_find_closest_point_on_navmesh(voting_spawn.world_position + offset, ref nav_point, ref triangle_hint);
        player.entity->set_local_position(voting_spawn.world_position + offset);
    }

    spawn_corpse :: proc(using this: World_References, player: Player) {
        corpse := Scene.instantiate(corpse_prefab);
        corpse->set_local_position(player.entity.world_position);
        corpse->set_local_rotation(player.entity.world_rotation);
        corpse->set_local_scale(player.entity.world_scale);

        corpse_component := corpse->get_component(Corpse);
        if corpse_component != null {
            corpse_component.has_been_reported = false;
            corpse_component.owner_player_entity_id = player.entity.id;
        }

        spine_Animator := corpse->get_component(Spine_Animator);
        if spine_Animator != null && spine_Animator.instance != null && player.animator != null && player.animator.instance != null {
            // Note: color replace API is on the Spine instance (not the component).
            spine_Animator.instance->set_color_replace_color(player.animator.instance.color_replace_color);

            spine_Animator.instance->disable_all_skins();
            player_skins := player.animator.instance->get_skins();
            for i: 0..player_skins.count-1 {
                spine_Animator.instance->enable_skin(player_skins[i]);
            }
            spine_Animator.instance->refresh_skins();
        }
    }
}