import "core:ao"

// ============================================================================
// Goo Goo Gaga (GGG) v5 — Traitor Role
// ============================================================================

// GGG availability is determined per-player via Purchasing.owns_product.

// --- GGG Module ---
GGG_Module :: class : Component {
	// Nest
	nest_points: int;
	nest_entity: Entity;
	nest_placed: bool;
	nest_destroyed: bool;
	nest_world_pos: v2;
	nest_placing: bool;

	// Consume bonuses
	consumed_portal_maker: bool;
	consumed_doctor: bool;

	// Transform (free toggle, no duration limit)
	is_creature_form: bool;
	creature_entity: Entity;
	creature_animator: Spine_Animator;
	skeleton_swap_at: float;
	creature_visible: bool;
	speed_boost_active: bool;
	speed_original: float;

	// Crawl
	is_crawling: bool;
	crawl_ends_at: float;
	crawl_speed_active: bool;
	crawl_speed_original: float;
	crawl_original_scale: v2;
	crawl_sfx_id: u64;
	crawl_sfx_playing: bool;

	// Foil Whip pull state
	foil_whip_active: bool;
	foil_whip_target_id: u64;
	foil_whip_pull_start_pos: v2;
	foil_whip_pull_end_pos: v2;
	foil_whip_pull_start_time: float;
	foil_whip_pull_duration: float;
	foil_whip_kill_on_arrive: bool;

	// Dragging live trapped player
	dragging_live_player_id: u64;

	// Hold drag animation during nest consume arc
	nest_consume_hold_drag_until: float;

	// Nest burned by pyro — lockout timer
	nest_burned_at: float;

	// Nest placement request (client sets, server reads + acts)
	nest_place_requested: bool;
	nest_place_world_pos: v2;

	// Foil Whip targeting state (for LOS boost)
	foil_whip_targeting: bool;
}

// --- Constants ---
GGG_KILL_COOLDOWN_SECONDS :: 25.0;
GGG_CREATURE_KILL_RANGE :: 6.5;
GGG_TRANSFORM_ANIM_ENTER_SECONDS :: 0.5;
GGG_CREATURE_SPEED_MULTIPLIER :: 1.20;

GGG_CRAWL_COOLDOWN_SECONDS :: 15.0;
GGG_CRAWL_DURATION_SECONDS :: 5.0;
GGG_CRAWL_SPEED_MULTIPLIER :: 1.75;
GGG_CRAWL_SCALE_X :: 0.5;
GGG_CRAWL_SCALE_Y :: 0.5;
GGG_CRAWL_UNLOCK_NEST_POINTS :: 1;
GGG_CRAWL_SFX_RADIUS :: 15.0;

GGG_TRAP_COOLDOWN_SECONDS :: 30.0;
GGG_TRAP_PLACE_DISTANCE :: 4.0;
GGG_NEST_PLACE_DISTANCE :: 5.0;
GGG_TRAP_ROOT_SECONDS :: 15.0;
GGG_TRAP_BLIND_SECONDS :: 15.0;
GGG_TRAP_DOUBLE_CC_SECONDS :: 30.0;
GGG_TRAP_MAX_ACTIVE :: 2;
GGG_TRAP_LIFETIME_SECONDS :: 60.0;
GGG_TRAP_TRIGGER_RADIUS :: 0.8;
GGG_TRAP_RIG :: "anims/trap/004RAND_SantaTrap.spine";
GGG_TRAP_PLACE_DURATION :: 0.8;
GGG_TRAP_ACTIVATE_DURATION :: 1.2;

GGG_FOIL_WHIP_COOLDOWN_SECONDS :: 30.0;
GGG_FOIL_WHIP_UNLOCK_NEST_POINTS :: 2;
GGG_FOIL_WHIP_PULL_DURATION :: 1.0;
GGG_FOIL_WHIP_PROJECTILE_SPEED :: 16.0;
GGG_FOIL_WHIP_MISS_HANG_SECONDS :: 0.5;
GGG_FOIL_WHIP_CAMERA_ZOOMED_OUT_SIZE :: 14.0;
GGG_FOIL_WHIP_LOS_INNER :: 14.0;
GGG_FOIL_WHIP_LOS_OUTER :: 18.0;

GGG_SWARM_COOLDOWN_SECONDS :: 75.0;
GGG_SWARM_UNLOCK_NEST_POINTS :: 4;
GGG_SWARM_CRAWLER_SPEED :: 6.0;
GGG_SWARM_DURATION_SECONDS :: 12.0;
GGG_SWARM_ROOT_SECONDS :: 15.0;

GGG_HIVE_MIND_SPEED_PER_POINT :: 0.02;
GGG_NIGHT_CRAWL_SPEED_BONUS :: 0.50;

GGG_NEST_REBUILD_DELAY :: 15.0;
GGG_NEST_RIG :: "anims/hive/Nest.spine";
GGG_NEST_CONSUME_RANGE :: 1.8;
GGG_NEST_SHERIFF_REVEAL_SECONDS :: 30.0;
GGG_NEST_VISIBILITY_RANGE :: 8.0;

// Rig paths
GGG_PLAYER_RIG :: "anims/player/004RAND_Base.spine";
GGG_CREATURE_RIG :: "anims/roles/Ggg/004RAND_GooGooGaGa.spine";

// Lock/freeze reasons
GGG_TRANSFORM_LOCK_REASON :: "ggg_transform_lock";
GGG_TRAP_ROOT_REASON :: "ggg_trap_root";
GGG_TRAP_BLIND_REASON :: "ggg_trap_blind";
GGG_NAME_INVIS_REASON :: "ggg_creature_form";
GGG_FOIL_WHIP_PULL_REASON :: "ggg_foil_whip_pull";
GGG_LIVE_DRAG_REASON :: "ggg_live_drag";

ggg_voice_rng: u64;
ggg_radio_hijack_rng: u64;

rr_ggg_random_voice_sfx :: proc() -> string {
	if ggg_voice_rng == 0 { ggg_voice_rng = rng_seed(rng_root_seed() + 1009); }
	idx := rng_range_int(ref ggg_voice_rng, 1, 3);
	if idx == 1 return "sfx/ggg1.wav";
	if idx == 2 return "sfx/ggg2.wav";
	return "sfx/ggg3.wav";
}

// ============================================================================
// Kill Hook
// ============================================================================

rr_ggg_on_player_killed :: proc(killer_player_entity_id: u64, victim_player_entity_id: u64) {
	if killer_player_entity_id == 0 return;
	if victim_player_entity_id == 0 return;
	killer := get_player_by_entity_id(killer_player_entity_id);
	if killer == null return;
	if killer.player_role != Player_Role.GOO_GOO_GAGA return;
	if killer.player_state != Player_State.ALIVE return;
	if !killer.is_local_or_server() return;
	// v5: kills no longer award nest points directly — must drag body to nest.
	// All kills auto-wrap in chocolate foil (handled in abilities.csl corpse spawn).
}


// ============================================================================
// Nest System
// ============================================================================

GGG_Nest :: class : Component {
	owner_player_entity_id: u64;
	bodies_consumed: int;
	sheriff_revealed: bool;
	sheriff_reveal_ends_at: float;
	destroyed: bool;

	ao_update :: method(dt: float) {
		if !Game.is_server() return;
		// Sheriff reveal timer
		if sheriff_revealed && get_time() >= sheriff_reveal_ends_at {
			sheriff_revealed = false;
		}
	}
}

GGG_Nest_Visibility :: class : Component {
	ao_update :: method(dt: float) {
		spine := entity.get_component(Spine_Animator);
		if spine == null return;
		if spine.instance == null return;

		local_player, ok := Game.get_local_player();
		if !ok {
			spine.instance.color_multiplier = v4.{1, 1, 1, 0};
			return;
		}
		// GGG owner always sees their nest
		if local_player.player_type == Player_Type.TRAITOR {
			spine.instance.color_multiplier = v4.{1, 1, 1, 1};
			return;
		}
		// Other players only see the nest when close
		dist := length(local_player.entity.world_position - entity.world_position);
		if dist <= GGG_NEST_VISIBILITY_RANGE {
			alpha := 1.0 - clamp((dist - GGG_NEST_VISIBILITY_RANGE + 2.0) / 2.0, 0.0, 1.0);
			alpha = clamp(alpha, 0.0, 1.0);
			spine.instance.color_multiplier = v4.{1, 1, 1, alpha};
		} else {
			spine.instance.color_multiplier = v4.{1, 1, 1, 0};
		}
	}
}

rr_ggg_place_nest :: proc(player: Player, world_pos: v2) {
	if player == null return;
	if !Game.is_server() return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if gm.nest_placed return;

	// Snap position onto the navmesh
	nav_point: v2;
	triangle_hint: s64 = -1;
	if try_find_closest_point_on_navmesh(world_pos, ref nav_point, ref triangle_hint) {
		world_pos = nav_point;
	}

	nest_e := Scene.create_entity();
	nest_e.set_local_position(world_pos);
	nest_e.set_local_scale(v2.{1, 1});

	spine := nest_e.add_component(Spine_Animator);
	if spine != null {
		spine.awaken();
		if spine.instance != null {
			spine.instance.set_skeleton(get_asset(Spine_Asset, GGG_NEST_RIG));
			spine.instance.set_animation("Appear", false, 0);
		}
	}
	// Add a simple state machine: Appear -> Idle
	rr_ggg_setup_nest_state_machine(spine);

	nest_comp := nest_e.add_component(GGG_Nest);
	nest_comp.owner_player_entity_id = player.entity.id;

	nest_e.add_component(GGG_Nest_Visibility);

	gm.nest_entity = nest_e;
	gm.nest_placed = true;
	gm.nest_world_pos = world_pos;
	gm.nest_placing = false;

	player.Notify("Nest placed!");
}

rr_ggg_setup_nest_state_machine :: proc(spine: Spine_Animator) {
	if spine == null return;
	if spine.instance == null return;

	sm := State_Machine.create();
	layer := sm.create_layer("main", 0);

	appear_state := layer.create_state("Appear", false, 1.0);
	idle_state := layer.create_state("Idle", true);
	destroyed_state := layer.create_state("Destroyed", false, 1.0);

	destroy_trigger := sm.create_variable("destroy", .TRIGGER);

	layer.set_initial_state(appear_state);
	layer.create_transition(appear_state, idle_state, true);
	layer.create_global_transition(destroyed_state, false).create_trigger_condition(destroy_trigger);

	spine.instance.set_state_machine(sm, true);
}

rr_ggg_destroy_nest :: proc(gm: GGG_Module) {
	if gm == null return;
	if !gm.nest_placed return;
	if gm.nest_destroyed return;
	gm.nest_destroyed = true;
	gm.nest_burned_at = get_time();

	if gm.nest_entity != null && #alive(gm.nest_entity) {
		spine := gm.nest_entity.get_component(Spine_Animator);
		if spine != null && spine.instance != null && spine.instance.state_machine != null {
			spine.instance.state_machine.set_trigger("destroy");
		}
	}

	// Force revert to human form and notify
	player := gm.entity.get_component(Player);
	if player != null {
		if gm.is_creature_form {
			rr_ggg_force_revert(player);
		}
		player.Notify("Your nest was burned! Abilities locked for 15s.");
	}
}

rr_ggg_is_nest_burn_locked :: proc(gm: GGG_Module) -> bool {
	if gm == null return false;
	if !gm.nest_destroyed return false;
	if gm.nest_burned_at <= 0.0 return false;
	return get_time() < gm.nest_burned_at + GGG_NEST_REBUILD_DELAY;
}

rr_ggg_update_nest_burn_recovery :: proc(gm: GGG_Module) {
	if gm == null return;
	if !gm.nest_destroyed return;
	if gm.nest_burned_at <= 0.0 return;
	if get_time() < gm.nest_burned_at + GGG_NEST_REBUILD_DELAY return;

	// Lockout expired — allow re-placing the nest
	gm.nest_placed = false;
	gm.nest_destroyed = false;
	gm.nest_burned_at = 0.0;

	player := gm.entity.get_component(Player);
	if player != null {
		player.Notify("Nest lockout expired — you can place a new nest!");
	}
}

// Check if GGG is dragging a body near the nest. If so, consume it.
rr_ggg_check_nest_consumption :: proc(player: Player) {
	if player == null return;
	if !Game.is_server() return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if !gm.nest_placed return;
	if gm.nest_destroyed return;

	nest_pos := gm.nest_world_pos;
	player_pos := player.entity.world_position;
	dist := length(player_pos - nest_pos);
	if dist > GGG_NEST_CONSUME_RANGE return;

	// Check if dragging a live trapped player
	if gm.dragging_live_player_id != 0 {
		victim := get_player_by_entity_id(gm.dragging_live_player_id);
		if victim != null && #alive(victim.entity) && victim.player_state == Player_State.ALIVE {
			victim_role := victim.player_role;
			// Release drag lock before killing
			victim.remove_disable_movement_input_reason(GGG_LIVE_DRAG_REASON);
			// Kill the live player (consumed by nest)
			victim.kill_with_killer(player.entity.id);
			// Animate corpse into the nest
			for corpse: component_iterator(Corpse) {
				if corpse == null continue;
				if !#alive(corpse.entity) continue;
				if corpse.entity.world_position.x == victim.entity.world_position.x && corpse.entity.world_position.y == victim.entity.world_position.y {
					rr_ggg_start_consume_anim(corpse.entity, gm.nest_world_pos, gm.nest_entity);
					break;
				}
			}
			// Award 3 nest points for live feed
			gm.nest_points += 3;
			nest_comp := gm.nest_entity.get_component(GGG_Nest);
			if nest_comp != null {
				nest_comp.bodies_consumed += 1;
			}
			// Check consume bonuses
			rr_ggg_check_consume_bonus(player, gm, victim_role);
			player.Notify(format_string("Live feed! +3 nest points (%)", .{gm.nest_points}));
			// Hold drag anim during consume arc, then clear
			gm.nest_consume_hold_drag_until = get_time() + GGG_CONSUME_DURATION;
		}
		return;
	}

	// Check if dragging a corpse
	if player.dragging_corpse_entity_id == 0 return;

	for corpse: component_iterator(Corpse) {
		if corpse == null continue;
		if !#alive(corpse.entity) continue;
		if corpse.entity.id != player.dragging_corpse_entity_id continue;

		// Consume the body — clear drag state so it doesn't re-trigger
		corpse.dragged_by_player_entity_id = 0;
		player.dragging_corpse_entity_id = 0;
		if player.drag_body_sfx_id != 0 {
			SFX.stop(player.drag_body_sfx_id);
			player.drag_body_sfx_id = 0;
		}
		rr_ggg_start_consume_anim(corpse.entity, gm.nest_world_pos, gm.nest_entity);

		gm.nest_points += 1;
		nest_comp := gm.nest_entity.get_component(GGG_Nest);
		if nest_comp != null {
			nest_comp.bodies_consumed += 1;
		}
		player.Notify(format_string("Body consumed! +1 nest point (%)", .{gm.nest_points}));
		break;
	}
}

rr_ggg_check_consume_bonus :: proc(player: Player, gm: GGG_Module, victim_role: Player_Role) {
	if player == null return;
	if gm == null return;
	if victim_role == Player_Role.PORTAL_MAKER {
		if !gm.consumed_portal_maker {
			gm.consumed_portal_maker = true;
			player.Notify("Consumed Portal Maker! You can now teleport to nest via minimap.");
		}
	}
	if victim_role == Player_Role.DOCTOR {
		if !gm.consumed_doctor {
			gm.consumed_doctor = true;
			player.Notify("Consumed Doctor! Trap CC duration doubled.");
		}
	}
}

rr_ggg_clear_nest :: proc() {
	if !Game.is_server() return;
	for nest: component_iterator(GGG_Nest) {
		if nest == null continue;
		if nest.entity != null && #alive(nest.entity) {
			nest.entity.destroy();
		}
	}
}


// ============================================================================
// Nest Consume Animation
// ============================================================================

GGG_CONSUME_DURATION :: 1.1;
GGG_CONSUME_ARC_HEIGHT :: 3.5;
GGG_CONSUME_FLASH_DURATION :: 0.45;
GGG_CONSUME_GULP_DURATION :: 0.35;

GGG_Nest_Consume_Anim :: class : Component {
	start_pos: v2;
	end_pos: v2;
	start_time: float;
	start_scale: v2;
	nest_entity_id: u64;
	original_spine_depth: float;
	original_sprite_depth: float;
	original_spine_layer: s32;
	original_sprite_layer: s32;
	saved_depths: bool;

	ao_start :: method() {
		// Raise the entity above the world so the arc renders on top
		spine := entity.get_component(Spine_Animator);
		if spine != null {
			original_spine_depth = spine.depth_offset;
			original_spine_layer = spine.layer;
			spine.depth_offset = 999.0;
			spine.layer = 100;
		}
		sprite := entity.get_component(Sprite_Renderer);
		if sprite != null {
			original_sprite_depth = sprite.depth_offset;
			original_sprite_layer = sprite.layer;
			sprite.depth_offset = 999.0;
			sprite.layer = 100;
		}
		saved_depths = true;
	}

	ao_update :: method(dt: float) {
		t := (get_time() - start_time) / GGG_CONSUME_DURATION;

		if t >= 1.0 {
			// Restore depth before destroy
			if saved_depths {
				spine := entity.get_component(Spine_Animator);
				if spine != null { spine.depth_offset = original_spine_depth; spine.layer = original_spine_layer; }
				sr := entity.get_component(Sprite_Renderer);
				if sr != null { sr.depth_offset = original_sprite_depth; sr.layer = original_sprite_layer; }
			}
			rr_ggg_spawn_consume_flash(end_pos);
			rr_ggg_trigger_nest_gulp(nest_entity_id);
			entity.destroy();
			return;
		}

		// Position: lerp + parabolic arc upward
		x := lerp(start_pos.x, end_pos.x, t);
		y := lerp(start_pos.y, end_pos.y, t);
		arc := 4.0 * t * (1.0 - t) * GGG_CONSUME_ARC_HEIGHT;
		entity.set_local_position(v2.{x, y + arc});

		// Scale: squash-stretch at peak, shrink to nothing
		peak := 4.0 * t * (1.0 - t);
		shrink := 1.0 - t * t * t;
		sx := start_scale.x * shrink * (1.0 + peak * 0.3);
		sy := start_scale.y * shrink * (1.0 - peak * 0.15);
		entity.set_local_scale(v2.{sx, sy});
	}
}

GGG_Nest_Consume_Flash :: class : Component {
	start_time: float;

	ao_start :: method() {
		start_time = get_time();
	}

	ao_update :: method(dt: float) {
		t := (get_time() - start_time) / GGG_CONSUME_FLASH_DURATION;
		if t >= 1.0 {
			entity.destroy();
			return;
		}

		// Scale up, fade out
		scale := lerp(0.3, 2.5, t);
		entity.set_local_scale(v2.{scale, scale});

		sprite := entity.get_component(Sprite_Renderer);
		if sprite != null {
			alpha := (1.0 - t) * 0.8;
			sprite.color = v4.{1.0, 0.95, 0.7, alpha};
		}
	}
}

GGG_Nest_Gulp :: class : Component {
	start_time: float;
	base_scale: v2;
	active: bool;

	trigger :: method() {
		start_time = get_time();
		base_scale = entity.local_scale;
		active = true;
	}

	ao_update :: method(dt: float) {
		if !active return;
		t := (get_time() - start_time) / GGG_CONSUME_GULP_DURATION;
		if t >= 1.0 {
			entity.set_local_scale(base_scale);
			active = false;
			return;
		}
		// Quick bulge then settle
		bulge := sin(t * 3.14159) * 0.15;
		entity.set_local_scale(v2.{base_scale.x * (1.0 + bulge), base_scale.y * (1.0 + bulge)});
	}
}

rr_ggg_start_consume_anim :: proc(target: Entity, nest_pos: v2, nest_entity: Entity) {
	if target == null return;
	if !#alive(target) return;

	anim := target.add_component(GGG_Nest_Consume_Anim);
	anim.start_pos = target.world_position;
	anim.end_pos = nest_pos;
	anim.start_time = get_time();
	anim.start_scale = target.local_scale;
	if nest_entity != null && #alive(nest_entity) {
		anim.nest_entity_id = nest_entity.id;
	}
}

rr_ggg_spawn_consume_flash :: proc(pos: v2) {
	flash_e := Scene.create_entity();
	flash_e.set_local_position(pos);
	flash_e.set_local_scale(v2.{0.3, 0.3});

	sprite := flash_e.add_component(Sprite_Renderer);
	sprite.set_texture(get_asset(Texture_Asset, "$AO/white.png"));
	sprite.color = v4.{1.0, 0.95, 0.7, 0.8};
	sprite.layer = 100;

	flash_e.add_component(GGG_Nest_Consume_Flash);

	if Game.is_server() {
		sfx := SFX.default_sfx_desc();
		sfx.set_position(pos);
		sfx.volume = 0.375;
		sfx.speed_perturb = 0.1;
		rr_play_sfx(rr_ggg_random_voice_sfx(), sfx);
	}
}

rr_ggg_trigger_nest_gulp :: proc(nest_entity_id: u64) {
	if nest_entity_id == 0 return;
	for nest: component_iterator(GGG_Nest) {
		if nest == null continue;
		if !#alive(nest.entity) continue;
		if nest.entity.id == nest_entity_id {
			gulp := nest.entity.get_component(GGG_Nest_Gulp);
			if gulp == null {
				gulp = nest.entity.add_component(GGG_Nest_Gulp);
			}
			gulp.trigger();
			return;
		}
	}
}


// Minimap inverse: convert UI coordinates to world coordinates
rr_ggg_minimap_ui_to_world :: proc(map_rect: Rect, ui_pos: v2) -> v2 {
	wmin := rr_get_map_world_min();
	wmax := rr_get_map_world_max();

	min_x := min(wmin.x, wmax.x);
	max_x := max(wmin.x, wmax.x);
	min_y := min(wmin.y, wmax.y);
	max_y := max(wmin.y, wmax.y);

	dx := max_x - min_x;
	dy := max_y - min_y;
	if dx < 0.001 { dx = 1.0; }
	if dy < 0.001 { dy = 1.0; }

	map_w := map_rect.max.x - map_rect.min.x;
	map_h := map_rect.max.y - map_rect.min.y;
	if map_w < 0.001 { map_w = 1.0; }
	if map_h < 0.001 { map_h = 1.0; }

	u := (ui_pos.x - map_rect.min.x) / map_w;
	v := (ui_pos.y - map_rect.min.y) / map_h;
	u = clamp(u, 0.0, 1.0);
	v = clamp(v, 0.0, 1.0);

	return v2.{
		min_x + u * dx,
		min_y + v * dy,
	};
}


// ============================================================================
// Creature Entity Management
// ============================================================================

GGG_INVIS_REASON :: "ggg_creature_form";

rr_ggg_ensure_creature_entity :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if gm.creature_entity != null && #alive(gm.creature_entity) return;

	ce := Scene.create_entity();
	ce.set_parent(player.entity, false);
	ce.set_local_position(v2.{0, 0});
	ce.set_local_scale(v2.{1, 1});
	ce.set_local_rotation(0.0);

	ca := ce.add_component(Spine_Animator);
	ca.awaken();
	if ca.instance != null {
		ca.instance.set_skeleton(get_asset(Spine_Asset, GGG_CREATURE_RIG));
		ca.instance.set_animation("Idle", true, 0);
		rr_ggg_setup_creature_state_machine(ca);
		rr_apply_shadow_mask(ca.instance);
	}

	ce.set_local_enabled(false);

	gm.creature_entity = ce;
	gm.creature_animator = ca;
}

rr_ggg_destroy_creature_entity :: proc(player: Player) {
	if player == null return;
	player.remove_invisibility_reason(GGG_INVIS_REASON);
	player.remove_name_invisibility_reason(GGG_NAME_INVIS_REASON);

	gm := player.entity.get_component(GGG_Module);
	if gm != null {
		if gm.creature_entity != null && #alive(gm.creature_entity) {
			gm.creature_entity.destroy();
		}
		gm.creature_entity = null;
		gm.creature_animator = null;
		gm.creature_visible = false;
	}
}

rr_ggg_setup_creature_state_machine :: proc(ca: Spine_Animator) {
	if ca == null return;
	if ca.instance == null return;

	sm := State_Machine.create();

	is_moving := sm.create_variable("is_moving", .BOOL);
	spawn_in_trigger := sm.create_variable("spawn_in", .TRIGGER);
	crawl_start_trigger := sm.create_variable("crawl_start", .TRIGGER);
	crawl_end_trigger := sm.create_variable("crawl_end", .TRIGGER);
	crawl_moving := sm.create_variable("crawl_moving", .BOOL);
	pounce_trigger := sm.create_variable("pounce", .TRIGGER);

	layer := sm.create_layer("main", 0);

	idle_state := layer.create_state("Idle", true);
	move_state := layer.create_state("Move", true);
	spawn_in_state := layer.create_state("Transform_Monster_End", false, 1.0);
	crawl_start_state := layer.create_state("Crawl_Start", false, 0.5);
	crawl_idle_state := layer.create_state("Crawl_Idle", true);
	crawl_move_state := layer.create_state("Crawl_Move", true);
	crawl_end_state := layer.create_state("Crawl_End", false, 0.5);
	pounce_state := layer.create_state("Pounce", false, 1.0);

	layer.set_initial_state(idle_state);

	// Idle <. Move
	idle_to_move := layer.create_transition(idle_state, move_state, false);
	idle_to_move.create_bool_condition(is_moving, true);
	move_to_idle := layer.create_transition(move_state, idle_state, false);
	move_to_idle.create_bool_condition(is_moving, false);

	// Spawn in
	layer.create_global_transition(spawn_in_state, false).create_trigger_condition(spawn_in_trigger);
	layer.create_transition(spawn_in_state, idle_state, true);

	// Crawl
	layer.create_global_transition(crawl_start_state, false).create_trigger_condition(crawl_start_trigger);
	layer.create_transition(crawl_start_state, crawl_idle_state, true);

	ci_to_cm := layer.create_transition(crawl_idle_state, crawl_move_state, false);
	ci_to_cm.create_bool_condition(crawl_moving, true);
	cm_to_ci := layer.create_transition(crawl_move_state, crawl_idle_state, false);
	cm_to_ci.create_bool_condition(crawl_moving, false);

	layer.create_global_transition(crawl_end_state, false).create_trigger_condition(crawl_end_trigger);
	layer.create_transition(crawl_end_state, idle_state, true);

	// Pounce
	layer.create_global_transition(pounce_state, false).create_trigger_condition(pounce_trigger);
	layer.create_transition(pounce_state, idle_state, true);

	ca.instance.set_state_machine(sm, true);
}

rr_ggg_swap_to_creature :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if gm.creature_visible return;
	rr_ggg_ensure_creature_entity(player);
	if gm.creature_entity == null return;

	player.add_invisibility_reason(GGG_INVIS_REASON);
	player.add_name_invisibility_reason(GGG_NAME_INVIS_REASON);
	gm.creature_entity.set_local_enabled(true);
	gm.creature_visible = true;

	if gm.creature_animator != null && gm.creature_animator.instance != null {
		if gm.creature_animator.instance.state_machine != null {
			gm.creature_animator.instance.state_machine.set_trigger("spawn_in");
		}
	}
}

rr_ggg_swap_to_player :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if !gm.creature_visible return;

	if gm.creature_entity != null && #alive(gm.creature_entity) {
		gm.creature_entity.set_local_enabled(false);
	}
	gm.creature_visible = false;

	player.remove_invisibility_reason(GGG_INVIS_REASON);
	player.remove_name_invisibility_reason(GGG_NAME_INVIS_REASON);
}

rr_ggg_creature_trigger :: proc(player: Player, trigger_name: string) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if gm.creature_animator == null return;
	if gm.creature_animator.instance == null return;
	if gm.creature_animator.instance.state_machine == null return;
	gm.creature_animator.instance.state_machine.set_trigger(trigger_name);
}


// ============================================================================
// Transform Lock Component
// ============================================================================

GGG_Transform_Lock :: class : Component {
	active: bool;
	end_time: float;

	arm :: method(seconds: float) {
		if seconds <= 0.0 { seconds = 0.1; }
		end_time = get_time() + seconds;
		active = true;
		p := entity.get_component(Player);
		if p != null {
			p.add_disable_movement_input_reason(GGG_TRANSFORM_LOCK_REASON);
		}
	}

	ao_update :: method(dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null { active = false; return; }
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(GGG_TRANSFORM_LOCK_REASON);
			active = false;
			return;
		}
		if get_time() >= end_time {
			p.remove_disable_movement_input_reason(GGG_TRANSFORM_LOCK_REASON);
			active = false;
		}
	}
}


// ============================================================================
// Main Update (runs every frame for GGG players)
// ============================================================================

rr_ggg_update :: proc(player: Player, dt: float) {
	if player == null return;
	if player.player_role != Player_Role.GOO_GOO_GAGA || player.player_type != Player_Type.TRAITOR return;

	gm := player.entity.get_component(GGG_Module);
	if gm == null return;

	// Dead GGG reverts
	if player.player_state != Player_State.ALIVE {
		if gm.is_creature_form || gm.creature_visible {
			rr_ggg_force_revert(player);
		}
		return;
	}

	// Meetings: stop updating but defer visual revert until teleport
	// (setup_voting handles the actual revert so nearby players don't see it)
	if game_state != Game_State.INGAME {
		return;
	}

	// Delayed skeleton swap (after transform animation completes)
	now := get_time();
	if gm.skeleton_swap_at > 0.0 && now >= gm.skeleton_swap_at {
		gm.skeleton_swap_at = 0.0;
		if gm.is_creature_form && !gm.creature_visible {
			rr_ggg_swap_to_creature(player);
		}
	}

	// Speed boost: creature form + Hive Mind passive
	if gm.is_creature_form && gm.creature_visible && !gm.speed_boost_active {
		gm.speed_original = player.agent.movement_speed;
		gm.speed_boost_active = true;
		hive_mind_bonus := gm.nest_points.(float) * GGG_HIVE_MIND_SPEED_PER_POINT;
		player.agent.movement_speed = gm.speed_original * (GGG_CREATURE_SPEED_MULTIPLIER + hive_mind_bonus);
	} else if !gm.is_creature_form && gm.speed_boost_active {
		player.agent.movement_speed = gm.speed_original;
		gm.speed_boost_active = false;
	}

	// Hive Mind: also apply speed bonus in human form (just the nest point bonus, not creature multiplier)
	if !gm.is_creature_form && gm.nest_points > 0 {
		// Only apply if we have base speed (not modified by crawl etc)
		if !gm.crawl_speed_active {
			base_speed := player.agent.movement_speed;
			// Re-apply each frame is wasteful but simple; speed_original tracks base
			// This is a passive, so it's always active
		}
	}

	// Crawl expiration
	if gm.is_crawling && gm.crawl_ends_at > 0.0 && now >= gm.crawl_ends_at {
		rr_ggg_end_crawl(player);
	}

	// Crawl SFX: play while moving
	if Game.is_server() {
		if gm.is_crawling {
			crawl_moving := length_squared(player.agent.velocity) > 0.01;
			if crawl_moving && !gm.crawl_sfx_playing {
				crawl_desc := SFX.default_sfx_desc();
				crawl_desc.entity_to_follow = player.entity.id;
				crawl_desc.loop = true;
				crawl_desc.loop_timeout = GGG_CRAWL_DURATION_SECONDS;
				crawl_desc.volume = 0.1;
				crawl_desc.speed_perturb = 0.05;
				gm.crawl_sfx_id = rr_play_sfx("sfx/ggg_crawl.wav", crawl_desc);
				gm.crawl_sfx_playing = true;
			} else if !crawl_moving && gm.crawl_sfx_playing {
				SFX.stop(gm.crawl_sfx_id);
				gm.crawl_sfx_id = 0;
				gm.crawl_sfx_playing = false;
			}
		} else if gm.crawl_sfx_playing {
			SFX.stop(gm.crawl_sfx_id);
			gm.crawl_sfx_id = 0;
			gm.crawl_sfx_playing = false;
		}
	}

	// Foil Whip pull update
	rr_ggg_update_foil_whip_pull(player, gm, dt);

	// Live drag update: move trapped player to follow GGG
	rr_ggg_update_live_drag(player, gm, dt);

	// Nest consumption check
	rr_ggg_check_nest_consumption(player);

	// Nest burn recovery (re-enable nest placement after delay)
	rr_ggg_update_nest_burn_recovery(gm);
}


// ============================================================================
// Transform Begin / Revert helpers
// ============================================================================

rr_ggg_begin_revert :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	rr_ggg_end_crawl(player);
	gm.is_creature_form = false;
	gm.skeleton_swap_at = 0.0;
	rr_ggg_swap_to_player(player);
	player.set_trigger("ggg_revert");
}

rr_ggg_force_revert :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	rr_ggg_end_crawl(player);
	gm.is_creature_form = false;
	gm.skeleton_swap_at = 0.0;
	if gm.speed_boost_active {
		player.agent.movement_speed = gm.speed_original;
		gm.speed_boost_active = false;
	}
	if gm.creature_visible {
		rr_ggg_swap_to_player(player);
	}

	// Reset foil whip
	if gm.foil_whip_active {
		target := get_player_by_entity_id(gm.foil_whip_target_id);
		if target != null {
			target.remove_disable_movement_input_reason(GGG_FOIL_WHIP_PULL_REASON);
			rr_ggg_whip_release_target(target);
		}
		gm.foil_whip_active = false;
		gm.foil_whip_kill_on_arrive = false;
	}

	player.set_trigger("RESET");
	player.remove_disable_movement_input_reason(GGG_TRANSFORM_LOCK_REASON);
}


// ============================================================================
// Crawl Helpers
// ============================================================================

rr_ggg_start_crawl :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	gm.is_crawling = true;
	gm.crawl_ends_at = get_time() + GGG_CRAWL_DURATION_SECONDS;
	gm.crawl_original_scale = player.entity.world_scale;
	player.entity.set_local_scale(v2.{GGG_CRAWL_SCALE_X, GGG_CRAWL_SCALE_Y});
	gm.crawl_speed_original = player.agent.movement_speed;
	gm.crawl_speed_active = true;
	crawl_multiplier := GGG_CRAWL_SPEED_MULTIPLIER;
	// Night Crawler passive: +50% during power outage
	if rr_power_outage_active {
		crawl_multiplier = GGG_CRAWL_SPEED_MULTIPLIER + GGG_NIGHT_CRAWL_SPEED_BONUS;
	}
	player.agent.movement_speed = gm.crawl_speed_original * crawl_multiplier;
	if gm.creature_visible && gm.creature_animator != null && gm.creature_animator.instance != null {
		if gm.creature_animator.instance.state_machine != null {
			gm.creature_animator.instance.state_machine.set_trigger("crawl_start");
		}
	}
}

rr_ggg_end_crawl :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if gm.crawl_sfx_id != 0 {
		SFX.stop(gm.crawl_sfx_id);
		gm.crawl_sfx_id = 0;
	}
	gm.crawl_sfx_playing = false;
	if !gm.is_crawling return;
	gm.is_crawling = false;
	gm.crawl_ends_at = 0.0;
	player.entity.set_local_scale(gm.crawl_original_scale);
	if gm.crawl_speed_active {
		player.agent.movement_speed = gm.crawl_speed_original;
		gm.crawl_speed_active = false;
	}
	if gm.creature_visible && gm.creature_animator != null && gm.creature_animator.instance != null {
		if gm.creature_animator.instance.state_machine != null {
			gm.creature_animator.instance.state_machine.set_trigger("crawl_end");
		}
	}
}


// ============================================================================
// Creature Animation Controller
// ============================================================================

rr_ggg_update_creature_anims :: proc(player: Player, dt: float) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if !gm.creature_visible return;
	if gm.creature_animator == null return;
	if gm.creature_animator.instance == null return;
	sm := gm.creature_animator.instance.state_machine;
	if sm == null return;

	moving := length_squared(player.agent.velocity) > 0.01;
	sm.set_bool("is_moving", moving);

	if gm.is_crawling {
		sm.set_bool("crawl_moving", moving);
	}
}


// ============================================================================
// Chocolate Trap System (v5: human form only, no unlock, adds blind)
// ============================================================================

GGG_Trap_Entry :: class {
	pos: v2;
	owner_entity_id: u64;
	trap_entity: Entity;
	expires_at: float;
}

ggg_traps: [..]GGG_Trap_Entry;

GGG_Trap_Animator :: class : Component {
	state: int;
	state_end_at: float;

	ao_update :: method(dt: float) {
		if !Game.is_server() return;
		if state == 2 && get_time() >= state_end_at {
			entity.destroy();
			return;
		}
		spine := entity.get_component(Spine_Animator);
		if spine == null return;
		if spine.instance == null return;
		if state == 0 && get_time() >= state_end_at {
			state = 1;
			spine.instance.set_animation("Idle", true, 0);
		}
	}

	activate :: method() {
		if !Game.is_server() return;
		state = 2;
		state_end_at = get_time() + GGG_TRAP_ACTIVATE_DURATION;
		spine := entity.get_component(Spine_Animator);
		if spine == null return;
		if spine.instance == null return;
		spine.instance.set_animation("Activate", false, 0);
	}
}

GGG_Trap_Visibility :: class : Component {
	ao_update :: method(dt: float) {
		spine := entity.get_component(Spine_Animator);
		if spine == null return;
		if spine.instance == null return;

		local_player, ok := Game.get_local_player();
		if !ok {
			spine.instance.color_multiplier = v4.{1, 1, 1, 0};
			return;
		}
		if local_player.player_type == Player_Type.TRAITOR {
			spine.instance.color_multiplier = v4.{1, 1, 1, 1};
		} else {
			spine.instance.color_multiplier = v4.{1, 1, 1, 0};
		}
	}
}

rr_ggg_place_trap :: proc(player: Player, world_pos: v2) {
	if player == null return;
	if !Game.is_server() return;

	count := 0;
	for i: 0..ggg_traps.count-1 {
		t := ggg_traps[i];
		if t.owner_entity_id == player.entity.id {
			count += 1;
		}
	}
	if count >= GGG_TRAP_MAX_ACTIVE {
		player.Notify("Max traps placed!");
		return;
	}

	entry := new(GGG_Trap_Entry);
	entry.pos = world_pos;
	entry.owner_entity_id = player.entity.id;
	entry.expires_at = get_time() + GGG_TRAP_LIFETIME_SECONDS;

	trap_e := Scene.create_entity();
	trap_e.set_local_position(world_pos);
	trap_e.set_local_scale(v2.{0.6, 0.6});

	spine := trap_e.add_component(Spine_Animator);
	if spine != null {
		spine.awaken();
		if spine.instance != null {
			spine.instance.set_skeleton(get_asset(Spine_Asset, GGG_TRAP_RIG));
			spine.instance.set_animation("Place", false, 0);
		}
	}

	anim := trap_e.add_component(GGG_Trap_Animator);
	anim.state = 0;
	anim.state_end_at = get_time() + GGG_TRAP_PLACE_DURATION;
	trap_e.add_component(GGG_Trap_Visibility);
	entry.trap_entity = trap_e;

	ggg_traps.append(entry);
}

// Doctor "Free" interactable — only visible to the Doctor role
GGG_Free_Trapped_Interactable :: class : Interactable {
	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Free");
		this.set_hold_text("Freeing...");
		radius = 3.0;
		required_hold_time = 1.5;
		prompt_offset = v2.{0, 1.5};
		priority = 70;
	}

	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.DOCTOR return false;
		if player.entity == entity return false;
		root := entity.get_component(GGG_Trap_Root_Effect);
		if root == null return false;
		if !root.active return false;
		return true;
	}

	on_interact :: method(player: Player) {
		root := entity.get_component(GGG_Trap_Root_Effect);
		if root != null {
			root.heal();
			player.Notify("You freed a player from chocolate foil!");
		}
	}
}

// Root + Blind effect component (added to trapped players)
GGG_Trap_Root_Effect :: class : Component {
	root_end_time: float;
	blind_end_time: float;
	active: bool;
	is_blinded: bool;

	arm :: method(root_seconds: float, blind_seconds: float) {
		if root_seconds <= 0.0 { root_seconds = 0.1; }
		if blind_seconds <= 0.0 { blind_seconds = 0.1; }
		now := get_time();
		if active {
			// Extend existing timers instead of resetting
			root_end_time = root_end_time + root_seconds;
			blind_end_time = blind_end_time + blind_seconds;
			is_blinded = true;
		} else {
			root_end_time = now + root_seconds;
			blind_end_time = now + blind_seconds;
			active = true;
			is_blinded = true;
			p := entity.get_component(Player);
			if p != null {
				p.add_disable_movement_input_reason(GGG_TRAP_ROOT_REASON);
				p.set_trigger("ggg_trapped_start");
			}
		}
		// Add doctor-only free interactable
		existing := entity.get_component(GGG_Free_Trapped_Interactable);
		if existing == null {
			entity.add_component(GGG_Free_Trapped_Interactable);
		}
		// Play "GOO GOO GA GA" blast for trapped player
		if Game.is_server() {
			sfx := SFX.default_sfx_desc();
			sfx.entity_to_follow = entity.id;
			sfx.volume = 0.6;
			sfx.speed_perturb = 0.05;
			rr_play_sfx(rr_ggg_random_voice_sfx(), sfx);
		}
	}

	ao_update :: method(dt: float) {
		if !active return;
		if !Game.is_server() return;
		p := entity.get_component(Player);
		if p == null { active = false; return; }
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(GGG_TRAP_ROOT_REASON);
			p.set_trigger("RESET");
			active = false;
			is_blinded = false;

			return;
		}
		now := get_time();
		// Blind expires
		if is_blinded && now >= blind_end_time {
			is_blinded = false;
		}
		// Root expires
		if now >= root_end_time {
			p.remove_disable_movement_input_reason(GGG_TRAP_ROOT_REASON);
			p.set_trigger("ggg_trapped_end");
			active = false;
			is_blinded = false;

		}
	}

	heal :: method() {
		if !active return;
		p := entity.get_component(Player);
		if p != null {
			p.remove_disable_movement_input_reason(GGG_TRAP_ROOT_REASON);
			p.set_trigger("RESET");
		}
		active = false;
		is_blinded = false;

	}
}


GGG_TRAP_BLIND_LOS_INNER :: 0.5;
GGG_TRAP_BLIND_LOS_OUTER :: 0.8;

// Draw blind overlay for trapped+blinded local player
rr_ggg_draw_trap_blind_overlay :: proc(player: Player) {
	if player == null return;
	if !player.is_local() return;
	root := player.entity.get_component(GGG_Trap_Root_Effect);
	if root == null return;
	if !root.active return;
	if !root.is_blinded return;

	// Black overlay (LOS is shrunk via get_local_light_radii)
	screen := UI.get_screen_rect();
	UI.push_layer(9998);
	defer UI.pop_layer();

	bg := get_asset(Texture_Asset, "$AO/white.png");
	UI.quad(screen, bg, v4.{0.0, 0.0, 0.0, 0.92});
}

update_ggg_traps :: proc() {
	if !Game.is_server() return;
	if ggg_traps.count <= 0 return;
	now := get_time();

	i := 0;
	while i < ggg_traps.count {
		t := ggg_traps[i];

		if now >= t.expires_at {
			if t.trap_entity != null && #alive(t.trap_entity) {
				t.trap_entity.destroy();
			}
			last := ggg_traps.count - 1;
			ggg_traps[i] = ggg_traps[last];
			ggg_traps.pop();
			continue;
		}

		for j: 0..players.elements.count-1 {
			p := players.elements[j];
			if p == null continue;
			if !#alive(p.entity) continue;
			if p.player_state != Player_State.ALIVE continue;
			if p.player_type == Player_Type.TRAITOR continue;

			dist := length(p.entity.world_position - t.pos);
			if dist < GGG_TRAP_TRIGGER_RADIUS {
				// Get the GGG owner to check consumed_doctor
				ggg_owner := get_player_by_entity_id(t.owner_entity_id);
				gm: GGG_Module = null;
				if ggg_owner != null {
					gm = ggg_owner.entity.get_component(GGG_Module);
				}
				root_dur := GGG_TRAP_ROOT_SECONDS;
				blind_dur := GGG_TRAP_BLIND_SECONDS;
				if gm != null && gm.consumed_doctor {
					root_dur = GGG_TRAP_DOUBLE_CC_SECONDS;
					blind_dur = GGG_TRAP_DOUBLE_CC_SECONDS;
				}

				root := p.entity.get_component(GGG_Trap_Root_Effect);
				if root == null {
					root = p.entity.add_component(GGG_Trap_Root_Effect);
				}
				root.arm(root_dur, blind_dur);

				if t.trap_entity != null && #alive(t.trap_entity) {
					trap_anim := t.trap_entity.get_component(GGG_Trap_Animator);
					if trap_anim != null {
						trap_anim.activate();
					} else {
						t.trap_entity.destroy();
					}
				}
				last := ggg_traps.count - 1;
				ggg_traps[i] = ggg_traps[last];
				ggg_traps.pop();
				i -= 1;
				break;
			}
		}
		i += 1;
	}
}

rr_ggg_clear_traps :: proc() {
	if !Game.is_server() return;
	for i: 0..ggg_traps.count-1 {
		t := ggg_traps[i];
		if t.trap_entity != null && #alive(t.trap_entity) {
			t.trap_entity.destroy();
		}
	}
	ggg_traps.clear();
}


// ============================================================================
// Foil Whip Projectile System
// ============================================================================

GGG_Foil_Whip_Projectile :: class : Component {
	velocity: v2;
	owner_entity_id: u64;
	lifetime: float;
	spawn_time: float;
	hit: bool;
	miss_hang_end: float;

	ao_start :: method() {
		spawn_time = get_time();
		lifetime = 3.0;
	}

	ao_update :: method(dt: float) {
		now := get_time();

		// Miss hang
		if hit {
			return;
		}
		if miss_hang_end > 0.0 {
			if now >= miss_hang_end {
				entity.destroy();
			}
			return;
		}

		// Lifetime expired = miss
		if now - spawn_time >= lifetime {
			miss_hang_end = now + GGG_FOIL_WHIP_MISS_HANG_SECONDS;
			return;
		}

		// Move
		entity.add_local_position(velocity * dt);

		// Check player collisions
		if !Game.is_server() return;
		for j: 0..players.elements.count-1 {
			p := players.elements[j];
			if p == null continue;
			if !#alive(p.entity) continue;
			if p.player_state != Player_State.ALIVE continue;
			if p.entity.id == owner_entity_id continue;
			if p.player_type == Player_Type.TRAITOR continue;

			dist := length(p.entity.world_position - entity.world_position);
			if dist < 0.8 {
				// Hit! Start pulling
				hit = true;
				owner := get_player_by_entity_id(owner_entity_id);
				if owner != null {
					gm := owner.entity.get_component(GGG_Module);
					if gm != null {
						gm.foil_whip_active = true;
						gm.foil_whip_target_id = p.entity.id;
						gm.foil_whip_pull_start_pos = p.entity.world_position;
						gm.foil_whip_pull_end_pos = owner.entity.world_position;
						gm.foil_whip_pull_start_time = now;
						gm.foil_whip_pull_duration = GGG_FOIL_WHIP_PULL_DURATION;
						p.add_disable_movement_input_reason(GGG_FOIL_WHIP_PULL_REASON);
						// Mark as caught (synced to all clients for animation).
						root := p.entity.get_component(GGG_Trap_Root_Effect);
						if root == null || !root.active {
							p.whip_caught = true;
						}
					}
				}
				entity.destroy();
				return;
			}
		}
	}
}

rr_ggg_fire_foil_whip :: proc(player: Player, direction: v2) {
	if player == null return;
	if !Game.is_server() return;

	proj_e := Scene.create_entity();
	proj_e.set_local_position(player.entity.world_position);
	proj_e.set_local_scale(v2.{0.5, 0.5});

	// TODO: add proper foil whip visual asset
	sprite := proj_e.add_component(Sprite_Renderer);
	sprite.set_texture(get_asset(Texture_Asset, "$AO/white.png"));
	sprite.color = v4.{0.8, 0.7, 0.3, 1.0};

	whip := proj_e.add_component(GGG_Foil_Whip_Projectile);
	whip.velocity = direction * GGG_FOIL_WHIP_PROJECTILE_SPEED;
	whip.owner_entity_id = player.entity.id;
}

rr_ggg_whip_release_target :: proc(target: Player) {
	if target == null return;
	target.whip_caught = false;
	target.set_trigger("RESET");
}

rr_ggg_draw_whip_chord :: proc(from_pos: v2, to_pos: v2) {
	chord_tex := get_asset(Texture_Asset, "sprites/Foil_Whip_Chord.png");
	if chord_tex == null return;

	UI.push_world_draw_context();
	defer UI.pop_draw_context();

	mid := v2.{(from_pos.x + to_pos.x) * 0.5, (from_pos.y + to_pos.y) * 0.5};

	// Z-order at the midpoint y so the chord renders at character depth.
	UI.push_z(mid.y);
	defer UI.pop_z();
	diff := to_pos - from_pos;
	dist := length(diff);
	if dist < 0.01 return;

	half_len := dist * 0.5;
	half_width := 0.08;
	chord_rect := Rect.{
		v2.{mid.x - half_len, mid.y - half_width},
		v2.{mid.x + half_len, mid.y + half_width},
	};

	angle := to_degrees(atan2(diff.y, diff.x));
	UI.push_matrix(Matrix4.rotate_about_point(mid, angle));
	defer UI.pop_matrix();
	UI.quad(chord_rect, chord_tex, v4.{1, 1, 1, 1});
}

// Draw whip chord if this player has an active whip pull. Runs on all clients.
rr_ggg_draw_whip_chord_if_needed :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if !gm.foil_whip_active return;

	target := get_player_by_entity_id(gm.foil_whip_target_id);
	if target == null || !#alive(target.entity) return;

	WHIP_CHORD_Y_OFFSET :: 0.7;
	from := player.entity.world_position + v2.{0, WHIP_CHORD_Y_OFFSET};
	to := target.entity.world_position + v2.{0, WHIP_CHORD_Y_OFFSET};
	rr_ggg_draw_whip_chord(from, to);
}

rr_ggg_update_foil_whip_pull :: proc(player: Player, gm: GGG_Module, dt: float) {
	if gm == null return;
	if !gm.foil_whip_active return;

	target := get_player_by_entity_id(gm.foil_whip_target_id);
	if target == null || !#alive(target.entity) || target.player_state != Player_State.ALIVE {
		if target != null { rr_ggg_whip_release_target(target); }
		gm.foil_whip_active = false;
		return;
	}

	now := get_time();
	elapsed := now - gm.foil_whip_pull_start_time;
	t := elapsed / gm.foil_whip_pull_duration;

	// Update pull end position slightly behind GGG (avoids z-overlap).
	pull_dir := player.entity.world_position - gm.foil_whip_pull_start_pos;
	pull_len := length(pull_dir);
	if pull_len > 0.1 {
		offset := pull_dir * (1.0 / pull_len) * -0.1;
		gm.foil_whip_pull_end_pos = player.entity.world_position + offset;
	} else {
		gm.foil_whip_pull_end_pos = gm.foil_whip_pull_start_pos;
	}

	// Lerp target toward GGG
	new_pos := v2.{
		lerp(gm.foil_whip_pull_start_pos.x, gm.foil_whip_pull_end_pos.x, t),
		lerp(gm.foil_whip_pull_start_pos.y, gm.foil_whip_pull_end_pos.y, t),
	};
	if t >= 1.0 {
		new_pos = gm.foil_whip_pull_end_pos;
	}
	target.entity.set_local_position(new_pos);

	// Check if pulled target enters nest range while trapped → auto-consume
	if Game.is_server() && gm.nest_placed && !gm.nest_destroyed {
		target_pos := target.entity.world_position;
		nest_dist := length(target_pos - gm.nest_world_pos);
		root := target.entity.get_component(GGG_Trap_Root_Effect);
		if nest_dist <= GGG_NEST_CONSUME_RANGE && root != null && root.active {
			// Release whip pull
			target.remove_disable_movement_input_reason(GGG_FOIL_WHIP_PULL_REASON);
			rr_ggg_whip_release_target(target);
			gm.foil_whip_active = false;
			gm.foil_whip_kill_on_arrive = false;
			// Kill and consume
			victim_role := target.player_role;
			target.kill_with_killer(player.entity.id);
			for corpse: component_iterator(Corpse) {
				if corpse == null continue;
				if !#alive(corpse.entity) continue;
				if corpse.entity.world_position.x == target.entity.world_position.x && corpse.entity.world_position.y == target.entity.world_position.y {
					rr_ggg_start_consume_anim(corpse.entity, gm.nest_world_pos, gm.nest_entity);
					break;
				}
			}
			gm.nest_points += 3;
			nest_comp := gm.nest_entity.get_component(GGG_Nest);
			if nest_comp != null {
				nest_comp.bodies_consumed += 1;
			}
			rr_ggg_check_consume_bonus(player, gm, victim_role);
			player.Notify(format_string("Whip feed! +3 nest points (%)", .{gm.nest_points}));
			return;
		}
	}

	// Kill on arrive: if kill was queued during whip pull
	if t >= 1.0 && Game.is_server() && gm.foil_whip_kill_on_arrive {
		gm.foil_whip_kill_on_arrive = false;
		target.remove_disable_movement_input_reason(GGG_FOIL_WHIP_PULL_REASON);
		rr_ggg_whip_release_target(target);
		gm.foil_whip_active = false;
		player.set_facing_right(target.entity.world_position.x > player.entity.world_position.x);
		player.set_trigger("traitor_kill");
		target.kill_with_killer(player.entity.id);
		rr_ggg_creature_trigger(player, "pounce");
		if Game.is_server() {
			pounce_sfx := SFX.default_sfx_desc();
			pounce_sfx.set_position(target.entity.world_position);
			pounce_sfx.volume = 0.15;
			pounce_sfx.speed_perturb = 0.05;
			rr_play_sfx("sfx/ggg_pounce_wrap.wav", pounce_sfx);
		}
		return;
	}

	if t >= 1.0 {
		// Pull complete — release
		target.remove_disable_movement_input_reason(GGG_FOIL_WHIP_PULL_REASON);
		rr_ggg_whip_release_target(target);
		gm.foil_whip_active = false;
		gm.foil_whip_kill_on_arrive = false;
	}
}


// ============================================================================
// Swarm System (v5: spawns from nest, crawlers = bodies consumed, root on contact)
// ============================================================================

GGG_Decoy_Entry :: class {
	decoy_entity: Entity;
	expires_at: float;
}

ggg_decoys: [..]GGG_Decoy_Entry;

GGG_SWARM_BURST_DURATION :: 0.5;
GGG_SWARM_BURST_SPEED :: 6.0;

GGG_Decoy :: class : Component {
	rng: u64;
	speed: float;
	expires_at: float;
	agent: Movement_Agent;
	sfx_id: u64;
	sfx_next_play_at: float;
	target_player_id: u64;
	retarget_at: float;
	has_rooted: bool;
	target_index: s64;
	burst_dir: v2;
	burst_until: float;

	ao_start :: method() {
		rng = rng_seed(entity.id);
		speed = GGG_SWARM_CRAWLER_SPEED;
		agent = entity.get_component(Movement_Agent);
		if agent != null && world_references.main_navmesh != null {
			agent.set_navmesh_to_lock_to(world_references.main_navmesh);
		}
		retarget_at = 0.0;
		sfx_next_play_at = get_time() + rng_range_float(ref rng, 0.0, 4.0);
		burst_until = get_time() + GGG_SWARM_BURST_DURATION;
	}

	find_nearest_civilian :: method() {
		// Collect all valid civilians
		civilian_ids: [..]u64;
		for j: 0..players.elements.count-1 {
			p := players.elements[j];
			if p == null continue;
			if !#alive(p.entity) continue;
			if p.player_state != Player_State.ALIVE continue;
			if p.player_type == Player_Type.TRAITOR continue;
			civilian_ids.append(p.entity.id);
		}
		if civilian_ids.count > 0 {
			idx := target_index % civilian_ids.count;
			if idx < 0 { idx = idx + civilian_ids.count; }
			target_player_id = civilian_ids[idx];
		} else {
			target_player_id = 0;
		}
		retarget_at = get_time() + rng_range_float(ref rng, 1.5, 3.0);
	}

	ao_end :: method() {
		if sfx_id != 0 {
			SFX.stop(sfx_id);
			sfx_id = 0;
		}
	}

	ao_update :: method(dt: float) {
		now := get_time();

		if now >= expires_at {
			entity.destroy();
			return;
		}

		// Burst scatter phase — move outward from nest before chasing
		if now < burst_until {
			new_pos := entity.world_position + burst_dir * GGG_SWARM_BURST_SPEED * dt;
			entity.set_local_position(new_pos);
			s := entity.local_scale;
			if burst_dir.x > 0.01 {
				entity.set_local_scale(v2.{abs(s.x), s.y});
			} else if burst_dir.x < -0.01 {
				entity.set_local_scale(v2.{-abs(s.x), s.y});
			}
			return;
		}

		// Retarget periodically
		if now >= retarget_at {
			find_nearest_civilian();
		}

		// Play ggg sound
		if Game.is_server() && now >= sfx_next_play_at {
			if sfx_id != 0 {
				SFX.stop(sfx_id);
				sfx_id = 0;
			}
			sfx_desc := SFX.default_sfx_desc();
			sfx_desc.entity_to_follow = entity.id;
			sfx_desc.volume = 0.2;
			sfx_desc.speed_perturb = 0.15;
			variant := rng_range_int(ref rng, 1, 3);
			sfx_path := format_string("sfx/ggg%.wav", .{variant});
			sfx_id = rr_play_sfx(sfx_path, sfx_desc);
			sfx_next_play_at = now + rng_range_float(ref rng, 3.0, 5.0);
		}

		// Chase target
		target := get_player_by_entity_id(target_player_id);
		if target == null || !#alive(target.entity) || target.player_state != Player_State.ALIVE {
			find_nearest_civilian();
			target = get_player_by_entity_id(target_player_id);
		}
		if target == null return;

		target_pos := target.entity.world_position;

		// Check contact: root on touch
		if Game.is_server() && !has_rooted {
			dist := length(target_pos - entity.world_position);
			if dist < 0.8 {
				root := target.entity.get_component(GGG_Trap_Root_Effect);
				if root == null {
					root = target.entity.add_component(GGG_Trap_Root_Effect);
				}
				// Stack root duration if already rooted
				root.arm(GGG_SWARM_ROOT_SECONDS, 0.1);
				has_rooted = true;
				// Play "GOO GOO GA GA" for this target
				sfx_desc2 := SFX.default_sfx_desc();
				sfx_desc2.entity_to_follow = target.entity.id;
				sfx_desc2.volume = 0.45;
				rr_play_sfx(rr_ggg_random_voice_sfx(), sfx_desc2);
				entity.destroy();
				return;
			}
		}

		// Move toward target
		if agent != null {
			result := agent.set_path_target(target_pos, speed);
			if result.success {
				new_pos := entity.world_position + result.move_direction * speed * dt;
				entity.set_local_position(new_pos);

				s := entity.local_scale;
				if result.move_direction.x > 0.01 {
					entity.set_local_scale(v2.{abs(s.x), s.y});
				} else if result.move_direction.x < -0.01 {
					entity.set_local_scale(v2.{-abs(s.x), s.y});
				}
			}
		}
	}
}

rr_ggg_spawn_swarm :: proc(player: Player) {
	if player == null return;
	if !Game.is_server() return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if !gm.nest_placed return;
	if gm.nest_destroyed return;

	nest_comp := gm.nest_entity.get_component(GGG_Nest);
	if nest_comp == null return;

	crawler_count := gm.nest_points;
	if crawler_count <= 0 {
		player.Notify("No nest points — no crawlers to spawn!");
		return;
	}

	now := get_time();
	spawn_rng: u64 = rng_seed(rng_root_seed() + gm.nest_entity.id + crawler_count.(u64) + get_frame_number());
	for i: 0..crawler_count-1 {
		// Scatter spawn positions in a ring around the nest
		angle := i.(float) / crawler_count.(float) * 6.2832;
		angle_offset := rng_range_float(ref spawn_rng, -0.4, 0.4);
		angle = angle + angle_offset;
		dir_x := cos(angle);
		dir_y := sin(angle);
		spawn_offset := v2.{dir_x * 0.5, dir_y * 0.5};

		decoy_e := Scene.create_entity();
		decoy_e.set_local_position(v2.{gm.nest_world_pos.x + spawn_offset.x, gm.nest_world_pos.y + spawn_offset.y});
		decoy_e.set_local_scale(v2.{0.7, 0.7});

		spine := decoy_e.add_component(Spine_Animator);
		if spine != null {
			spine.awaken();
			if spine.instance != null {
				spine.instance.set_skeleton(get_asset(Spine_Asset, GGG_CREATURE_RIG));
				spine.instance.set_animation("Crawl_Move", true, 0);
			}
		}

		agent := decoy_e.add_component(Movement_Agent);
		agent.movement_speed = 0;

		stagger := rng_range_float(ref spawn_rng, 0.0, 2.0);
		decoy_comp := decoy_e.add_component(GGG_Decoy);
		decoy_comp.expires_at = now + GGG_SWARM_DURATION_SECONDS + stagger;
		decoy_comp.target_index = i.(s64);
		decoy_comp.burst_dir = v2.{dir_x, dir_y};

		entry := new(GGG_Decoy_Entry);
		entry.decoy_entity = decoy_e;
		entry.expires_at = now + GGG_SWARM_DURATION_SECONDS + stagger;
		ggg_decoys.append(entry);
	}
}

update_ggg_decoys :: proc() {
	if !Game.is_server() return;
	if ggg_decoys.count <= 0 return;

	i := 0;
	while i < ggg_decoys.count {
		d := ggg_decoys[i];
		if d.decoy_entity == null || !#alive(d.decoy_entity) {
			last := ggg_decoys.count - 1;
			ggg_decoys[i] = ggg_decoys[last];
			ggg_decoys.pop();
			continue;
		}
		i += 1;
	}
}

rr_ggg_clear_decoys :: proc() {
	if !Game.is_server() return;
	for i: 0..ggg_decoys.count-1 {
		d := ggg_decoys[i];
		if d.decoy_entity != null && #alive(d.decoy_entity) {
			d.decoy_entity.destroy();
		}
	}
	ggg_decoys.clear();
}

rr_ggg_get_closest_decoy_in_range :: proc(pos: v2, range: float) -> Entity, bool {
	closest_dist := range;
	closest_entity: Entity;
	found := false;
	for i: 0..ggg_decoys.count-1 {
		d := ggg_decoys[i];
		if d.decoy_entity == null continue;
		if !#alive(d.decoy_entity) continue;
		dist := length(d.decoy_entity.world_position - pos);
		if dist < closest_dist {
			closest_dist = dist;
			closest_entity = d.decoy_entity;
			found = true;
		}
	}
	return closest_entity, found;
}

rr_ggg_destroy_decoy :: proc(decoy_entity: Entity) {
	if decoy_entity == null return;
	for i: 0..ggg_decoys.count-1 {
		d := ggg_decoys[i];
		if d.decoy_entity == decoy_entity {
			if #alive(decoy_entity) {
				decoy_entity.destroy();
			}
			last := ggg_decoys.count - 1;
			ggg_decoys[i] = ggg_decoys[last];
			ggg_decoys.pop();
			return;
		}
	}
}


// ============================================================================
// Live Drag System (dragging trapped+blinded players to the nest)
// ============================================================================

rr_ggg_get_closest_draggable_trapped_player :: proc(player: Player) -> Player {
	if player == null return null;
	best_dist := 2.5;
	best: Player = null;
	for j: 0..players.elements.count-1 {
		p := players.elements[j];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.player_type == Player_Type.TRAITOR continue;
		root := p.entity.get_component(GGG_Trap_Root_Effect);
		if root == null continue;
		if !root.active continue;
		// Check not already being dragged
		gm := player.entity.get_component(GGG_Module);
		if gm != null && gm.dragging_live_player_id == p.entity.id continue;
		dist := length(p.entity.world_position - player.entity.world_position);
		if dist < best_dist {
			best_dist = dist;
			best = p;
		}
	}
	return best;
}

rr_ggg_start_live_drag :: proc(player: Player, target: Player) {
	if player == null return;
	if target == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	gm.dragging_live_player_id = target.entity.id;
	target.add_disable_movement_input_reason(GGG_LIVE_DRAG_REASON);
}

rr_ggg_stop_live_drag :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if gm.dragging_live_player_id == 0 return;
	target := get_player_by_entity_id(gm.dragging_live_player_id);
	if target != null && #alive(target.entity) {
		target.remove_disable_movement_input_reason(GGG_LIVE_DRAG_REASON);
	}
	gm.dragging_live_player_id = 0;
}

rr_ggg_update_live_drag :: proc(player: Player, gm: GGG_Module, dt: float) {
	if gm == null return;
	if gm.dragging_live_player_id == 0 return;

	// Hold drag anim during nest consume arc
	if gm.nest_consume_hold_drag_until > 0.0 && get_time() < gm.nest_consume_hold_drag_until {
		return;
	}
	if gm.nest_consume_hold_drag_until > 0.0 {
		gm.nest_consume_hold_drag_until = 0.0;
		gm.dragging_live_player_id = 0;
		return;
	}

	target := get_player_by_entity_id(gm.dragging_live_player_id);
	if target == null || !#alive(target.entity) || target.player_state != Player_State.ALIVE {
		gm.dragging_live_player_id = 0;
		return;
	}

	// Check if trap effect expired — if so, stop drag
	root := target.entity.get_component(GGG_Trap_Root_Effect);
	if root == null || !root.active {
		rr_ggg_stop_live_drag(player);
		return;
	}

	// Move victim to follow GGG
	player_pos := player.entity.world_position;
	target_pos := target.entity.world_position;
	follow_pos := player_pos;
	// Offset behind the player
	s := player.entity.local_scale;
	offset_x := -0.5;
	if s.x < 0.0 { offset_x = 0.5; }
	follow_pos.x = follow_pos.x + offset_x;

	new_pos := v2.{
		lerp(target_pos.x, follow_pos.x, 6.0 * dt),
		lerp(target_pos.y, follow_pos.y, 6.0 * dt),
	};
	target.entity.set_local_position(new_pos);
}


// ============================================================================
// Radio Hijack Passive (during comms sabotage)
// ============================================================================

ggg_radio_hijack_sfx_id: u64;
ggg_radio_hijack_next_play: float;

rr_ggg_update_radio_hijack :: proc() {
	if !Game.is_server() return;
	// Check if any GGG player exists and comms is down
	if !rr_comms_outage_active {
		if ggg_radio_hijack_sfx_id != 0 {
			SFX.stop(ggg_radio_hijack_sfx_id);
			ggg_radio_hijack_sfx_id = 0;
		}
		return;
	}

	has_ggg := false;
	for p: component_iterator(Player) {
		if p == null continue;
		if p.player_role == Player_Role.GOO_GOO_GAGA && p.player_state == Player_State.ALIVE {
			has_ggg = true;
			break;
		}
	}
	if !has_ggg return;

	now := get_time();
	if now >= ggg_radio_hijack_next_play {
		if ggg_radio_hijack_sfx_id != 0 {
			SFX.stop(ggg_radio_hijack_sfx_id);
		}
		sfx := SFX.default_sfx_desc();
		sfx.volume = 0.15;
		sfx.speed_perturb = 0.1;
		if ggg_radio_hijack_rng == 0 {
			ggg_radio_hijack_rng = rng_seed(rng_root_seed() + 2003);
		}
		variant := rng_range_int(ref ggg_radio_hijack_rng, 1, 3);
		ggg_radio_hijack_sfx_id = rr_play_sfx(format_string("sfx/ggg%.wav", .{variant}), sfx);
		ggg_radio_hijack_next_play = now + 5.0;
	}
}


// ============================================================================
// Ability: Place Nest (one-time)
// ============================================================================

GGG_Place_Nest_Ability :: class : Ability_Base {
	NAME :: "Place Nest";

	was_targeting: bool;
	activated_this_session: bool;

	on_init :: proc(instance: GGG_Place_Nest_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/ggg/Nest_icon.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.GOO_GOO_GAGA return false;
		gm := player.entity.get_component(GGG_Module);
		if gm == null return false;
		if gm.nest_placed return false;
		return true;
	}

	cleanup_targeting :: method() {
		was_targeting = false;
		activated_this_session = false;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;

		if targeting && !params.can_use {
			player.active_ability = null;
			cleanup_targeting();
			return;
		}

		if targeting && !was_targeting {
			activated_this_session = false;
			was_targeting = true;
		}
		if !targeting {
			if was_targeting {
				cleanup_targeting();
			}
			return;
		}

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel {
			player.active_ability = null;
			cleanup_targeting();
			return;
		}

		target_pos := get_mouse_world_position();
		{
			origin := player.entity.world_position;
			delta := target_pos - origin;
			max_r := GGG_NEST_PLACE_DISTANCE;
			if length_squared(delta) > max_r * max_r {
				if length_squared(delta) < 0.001 {
					delta = v2.{1, 0};
				} else {
					delta = normalize(delta);
				}
				target_pos = origin + delta * max_r;
			}
		}

		// Preview
		if player.is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();

			// Range circle
			reticle := get_asset(Texture_Asset, GROUND_RETICLE_TEXTURE_PATH);
			reticle_rect := Rect{target_pos, target_pos}.grow(1.0, 1.0, 1.0, 1.0);
			UI.quad(reticle_rect.fit_aspect(reticle.get_aspect()), reticle, v4.{1, 1, 1, 0.8});

			// Nest icon preview
			nest_preview := get_asset(Texture_Asset, "sprites/icons/ggg/Nest_icon.png");
			pulse := sin(get_time() * 3.5) * 0.5 + 0.5;
			preview_alpha := 0.35 + pulse * 0.2;
			preview_rect := Rect{target_pos, target_pos}.grow(0.75, 0.75, 0.75, 0.75);
			UI.quad(preview_rect.fit_aspect(nest_preview.get_aspect()), nest_preview, v4.{1.0, 0.85, 0.0, preview_alpha});
		}

		if activated_this_session return;

		if aiming.activate && params.can_use {
			activated_this_session = true;
			rr_ggg_place_nest(player, target_pos);
			player.active_ability = null;
			cleanup_targeting();
		}
	}

	on_draw_button :: proc(instance: GGG_Place_Nest_Ability, rect: Rect) {
		draw_ability_name_label(rect, GGG_Place_Nest_Ability.NAME);

		p := instance.player;
		if p != null {
			gm := p.entity.get_component(GGG_Module);
			if gm != null && !gm.nest_placed {
				// Pulsing circular glow
				t := get_time() * 3.5;
				pulse := sin(t) * 0.5 + 0.5;
				glow_alpha := pulse * 0.5;
				glow_rect := rect.grow_unscaled(14.0, 14.0, 14.0, 14.0);
				circle := get_asset(Texture_Asset, "sprites/Shapes/shape_circle_blurred.png");
				UI.quad(glow_rect, circle, v4.{1.0, 0.85, 0.0, glow_alpha});
			}
		}
	}
}


// ============================================================================
// Ability: Transform (v5: free toggle, no duration, no cooldown)
// ============================================================================

GGG_Transform_Ability :: class : Ability_Base {
	NAME :: "Transform";

	on_init :: proc(instance: GGG_Transform_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.GOO_GOO_GAGA return false;
		gm := player.entity.get_component(GGG_Module);
		if gm != null && rr_ggg_is_nest_burn_locked(gm) return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && !params.can_use {
			gm := player.entity.get_component(GGG_Module);
			if gm != null && rr_ggg_is_nest_burn_locked(gm) {
				player.Notify("Nest burned — abilities locked!");
			}
		}
		if params.clicked && params.can_use {
			gm := player.entity.get_component(GGG_Module);
			if gm == null return;
			if gm.is_creature_form {
				// Revert to human
				rr_ggg_begin_revert(player);
			} else {
				// Enter creature form
				gm.is_creature_form = true;

				player.set_trigger("ggg_transform");

				lock := player.entity.get_component(GGG_Transform_Lock);
				if lock == null {
					lock = player.entity.add_component(GGG_Transform_Lock);
				}
				lock.arm(GGG_TRANSFORM_ANIM_ENTER_SECONDS);

				gm.skeleton_swap_at = get_time() + GGG_TRANSFORM_ANIM_ENTER_SECONDS;

				if Game.is_server() {
					sfx := SFX.default_sfx_desc();
					sfx.set_position(player.entity.world_position);
					sfx.volume = 0.9 * 0.25;
					sfx.volume_perturb = 0.05 * 0.25;
					sfx.speed_perturb = 0.05;
					rr_play_sfx("sfx/killer_transform.wav", sfx);

					ggg_sfx := SFX.default_sfx_desc();
					ggg_sfx.speed_perturb = 0.05;
					if rr_power_outage_active {
						ggg_sfx.volume = 0.225;
					} else {
						ggg_sfx.set_position(player.entity.world_position);
						ggg_sfx.volume = 0.225;
					}
					rr_play_sfx(rr_ggg_random_voice_sfx(), ggg_sfx);
				}
			}
		}
	}

	on_draw_button :: proc(instance: GGG_Transform_Ability, rect: Rect) {
		p := instance.player;
		pgm := p.entity.get_component(GGG_Module);
		if p != null && pgm != null && pgm.is_creature_form {
			instance.icon = get_asset(Texture_Asset, "sprites/icons/transform_good.png");
		} else {
			instance.icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png");
		}
		draw_ability_name_label(rect, GGG_Transform_Ability.NAME);
	}
}


// ============================================================================
// Ability: Crawl (v5: 1 nest point unlock, 15s CD, 5s duration)
// ============================================================================

GGG_Crawl_Ability :: class : Ability_Base {
	NAME :: "Crawl";

	on_init :: proc(instance: GGG_Crawl_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/ggg/crawl_speedup.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.GOO_GOO_GAGA return false;
		gm := player.entity.get_component(GGG_Module);
		if gm == null return false;
		if rr_ggg_is_nest_burn_locked(gm) return false;
		if !gm.is_creature_form return false;
		if gm.nest_points < GGG_CRAWL_UNLOCK_NEST_POINTS return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && !params.can_use {
			gm := player.entity.get_component(GGG_Module);
			if gm != null && rr_ggg_is_nest_burn_locked(gm) {
				player.Notify("Nest burned — abilities locked!");
			} else if player != null && player.player_role == Player_Role.GOO_GOO_GAGA && gm != null && gm.is_creature_form && gm.nest_points < GGG_CRAWL_UNLOCK_NEST_POINTS {
				player.Notify(format_string("Crawl locked: %/% nest points to unlock.", .{
					gm.nest_points, GGG_CRAWL_UNLOCK_NEST_POINTS
				}));
			}
		}
		if params.clicked && params.can_use {
			gm2 := player.entity.get_component(GGG_Module);
			if gm2 != null && gm2.is_crawling {
				rr_ggg_end_crawl(player);
			} else {
				rr_ggg_start_crawl(player);
			}
			current_cooldown = GGG_CRAWL_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: GGG_Crawl_Ability, rect: Rect) {
		draw_ability_name_label(rect, GGG_Crawl_Ability.NAME);
		p := instance.player;
		pgm := p.entity.get_component(GGG_Module);
		if p != null && p.player_role == Player_Role.GOO_GOO_GAGA && pgm != null && pgm.nest_points < GGG_CRAWL_UNLOCK_NEST_POINTS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");
		}
	}
}


// ============================================================================
// Ability: Chocolate Trap (v5: human form only, no unlock, root + blind)
// ============================================================================

GGG_Chocolate_Trap_Ability :: class : Ability_Base {
	NAME :: "Trap";

	was_targeting: bool;
	activated_this_session: bool;

	on_init :: proc(instance: GGG_Chocolate_Trap_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/ggg/santa_trap.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.GOO_GOO_GAGA return false;
		gm := player.entity.get_component(GGG_Module);
		if gm == null return false;
		// v5: human form only, no unlock requirement
		if gm.is_creature_form return false;
		return true;
	}

	cleanup_targeting :: method() {
		was_targeting = false;
		activated_this_session = false;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;

		if targeting && !params.can_use {
			player.active_ability = null;
			cleanup_targeting();
			return;
		}

		if targeting && !was_targeting {
			activated_this_session = false;
			was_targeting = true;
		}
		if !targeting {
			if was_targeting {
				cleanup_targeting();
			}
			return;
		}

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel {
			player.active_ability = null;
			cleanup_targeting();
			return;
		}

		target_pos := get_mouse_world_position();
		{
			origin := player.entity.world_position;
			delta := target_pos - origin;
			max_r := GGG_TRAP_PLACE_DISTANCE;
			if length_squared(delta) > max_r * max_r {
				if length_squared(delta) < 0.001 {
					delta = v2.{1, 0};
				} else {
					delta = normalize(delta);
				}
				target_pos = origin + delta * max_r;
			}
		}

		if player.is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			reticle := get_asset(Texture_Asset, GROUND_RETICLE_TEXTURE_PATH);
			reticle_rect := Rect{target_pos, target_pos}.grow(0.80, 0.80, 0.80, 0.80);
			UI.quad(reticle_rect.fit_aspect(reticle.get_aspect()), reticle, v4.{1, 1, 1, 0.95});
			trap_preview := get_asset(Texture_Asset, "sprites/icons/ggg/santa_trap.png");
			preview_rect := Rect{target_pos, target_pos}.grow(0.60, 0.60, 0.60, 0.60);
			UI.quad(preview_rect.fit_aspect(trap_preview.get_aspect()), trap_preview, v4.{1, 1, 1, 0.45});
		}

		if activated_this_session return;

		if aiming.activate && params.can_use {
			activated_this_session = true;
			current_cooldown = GGG_TRAP_COOLDOWN_SECONDS;
			rr_ggg_place_trap(player, target_pos);
			player.active_ability = null;
			cleanup_targeting();
		}
	}

	on_draw_button :: proc(instance: GGG_Chocolate_Trap_Ability, rect: Rect) {
		draw_ability_name_label(rect, GGG_Chocolate_Trap_Ability.NAME);
	}
}


// ============================================================================
// Ability: Foil Whip (v5: new, 3 nest points, creature form only)
// ============================================================================

GGG_Foil_Whip_Ability :: class : Ability_Base {
	NAME :: "Foil Whip";

	camera_zoom_active: bool;
	camera_original_size: float;

	on_init :: proc(instance: GGG_Foil_Whip_Ability) {
		// TODO: proper foil whip icon
		instance.icon = get_asset(Texture_Asset, "sprites/icons/ggg/kill_wrap_player.png");
		instance.is_aimed_ability = true;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.GOO_GOO_GAGA return false;
		gm := player.entity.get_component(GGG_Module);
		if gm == null return false;
		if rr_ggg_is_nest_burn_locked(gm) return false;
		if !gm.is_creature_form return false;
		if gm.nest_points < GGG_FOIL_WHIP_UNLOCK_NEST_POINTS return false;
		return true;
	}

	set_camera_zoom :: proc(using this: GGG_Foil_Whip_Ability, active: bool) {
		if !player.is_local_or_server() return;
		gm := player.entity.get_component(GGG_Module);
		if active {
			if !camera_zoom_active {
				camera_original_size = player.camera.size;
				player.camera.size = GGG_FOIL_WHIP_CAMERA_ZOOMED_OUT_SIZE;
				camera_zoom_active = true;
			}
			if gm != null { gm.foil_whip_targeting = true; }
		} else {
			if camera_zoom_active {
				player.camera.size = camera_original_size;
				camera_zoom_active = false;
			}
			if gm != null { gm.foil_whip_targeting = false; }
		}
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && !params.can_use {
			gm := player.entity.get_component(GGG_Module);
			if gm != null && rr_ggg_is_nest_burn_locked(gm) {
				player.Notify("Nest burned — abilities locked!");
			} else if player != null && player.player_role == Player_Role.GOO_GOO_GAGA && gm != null && gm.is_creature_form && gm.nest_points < GGG_FOIL_WHIP_UNLOCK_NEST_POINTS {
				player.Notify(format_string("Foil Whip locked: %/% nest points.", .{
					gm.nest_points, GGG_FOIL_WHIP_UNLOCK_NEST_POINTS
				}));
			}
		}

		gm := player.entity.get_component(GGG_Module);
		targeting := player.active_ability != null && player.active_ability.#type == GGG_Foil_Whip_Ability;
		pulling := gm != null && gm.foil_whip_active;
		this.set_camera_zoom(targeting || pulling);

		activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);
		if params.can_use && activation.activate {
			rr_ggg_fire_foil_whip(player, activation.direction);
			current_cooldown = GGG_FOIL_WHIP_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: GGG_Foil_Whip_Ability, rect: Rect) {
		draw_ability_name_label(rect, GGG_Foil_Whip_Ability.NAME);
		p := instance.player;
		pgm := p.entity.get_component(GGG_Module);
		if p != null && p.player_role == Player_Role.GOO_GOO_GAGA && pgm != null && pgm.nest_points < GGG_FOIL_WHIP_UNLOCK_NEST_POINTS {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .CENTER;
			ts.valign = .TOP;
			ts.do_outline = true;
			ts.outline_thickness = 2;
			ts.outline_color = v4.{0, 0, 0, 1};
			UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");
		}
	}
}


// ============================================================================
// Ability: The Swarm (v5: spawns from nest, count = bodies consumed)
// ============================================================================

GGG_Swarm_Ability :: class : Ability_Base {
	NAME :: "Swarm";

	on_init :: proc(instance: GGG_Swarm_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/ggg/swarm.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.has_task_in_progress() return false;
		if player.player_type != Player_Type.TRAITOR return false;
		if player.player_role != Player_Role.GOO_GOO_GAGA return false;
		gm := player.entity.get_component(GGG_Module);
		if gm == null return false;
		if !gm.is_creature_form return false;
		if gm.nest_points < GGG_SWARM_UNLOCK_NEST_POINTS return false;
		if gm.nest_destroyed return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && !params.can_use {
			gm := player.entity.get_component(GGG_Module);
			if player != null && player.player_role == Player_Role.GOO_GOO_GAGA && gm != null && gm.is_creature_form {
				if gm.nest_destroyed {
					player.Notify("Nest destroyed — Swarm disabled!");
				} else if gm.nest_points < GGG_SWARM_UNLOCK_NEST_POINTS {
					player.Notify(format_string("Swarm locked: %/% nest points.", .{
						gm.nest_points, GGG_SWARM_UNLOCK_NEST_POINTS
					}));
				}
			}
		}
		if params.clicked && params.can_use {
			rr_ggg_spawn_swarm(player);
			current_cooldown = GGG_SWARM_COOLDOWN_SECONDS;
		}
	}

	on_draw_button :: proc(instance: GGG_Swarm_Ability, rect: Rect) {
		draw_ability_name_label(rect, GGG_Swarm_Ability.NAME);
		p := instance.player;
		pgm := p.entity.get_component(GGG_Module);
		if p != null && p.player_role == Player_Role.GOO_GOO_GAGA && pgm != null {
			if pgm.nest_destroyed {
				ts := UI.default_text_settings();
				ts.size = 16;
				ts.halign = .CENTER;
				ts.valign = .TOP;
				ts.do_outline = true;
				ts.outline_thickness = 2;
				ts.outline_color = v4.{0, 0, 0, 1};
				ts.color = v4.{1.0, 0.3, 0.3, 1.0};
				UI.text(rect.inset(2).cut_top(20), ts, "DISABLED");
			} else if pgm.nest_points < GGG_SWARM_UNLOCK_NEST_POINTS {
				ts := UI.default_text_settings();
				ts.size = 18;
				ts.halign = .CENTER;
				ts.valign = .TOP;
				ts.do_outline = true;
				ts.outline_thickness = 2;
				ts.outline_color = v4.{0, 0, 0, 1};
				UI.text(rect.inset(2).cut_top(20), ts, "LOCKED");
			}
		}
	}
}


// ============================================================================
// Nest Teleport (consume bonus: Portal Maker)
// ============================================================================

rr_ggg_teleport_to_nest :: proc(player: Player) {
	if player == null return;
	gm := player.entity.get_component(GGG_Module);
	if gm == null return;
	if !gm.consumed_portal_maker return;
	if !gm.nest_placed return;
	if gm.nest_destroyed return;

	player.entity.set_local_position(gm.nest_world_pos);
	player.Notify("Teleported to nest!");
}
