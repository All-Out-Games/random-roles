import "core:ao"

// Phase 1: show voting grid + vote markers revealing who voted for who.
// Phase 2: show the outcome panel ("No one was ejected" / "X has been ejected!").
RR_VOTE_MARKER_PHASE_SECONDS :: 4;

rr_draw_vote_result_ui :: proc(local_player: Player) {
	reveal_start := rr_vote_results_end_time - RR_VOTE_RESULTS_REVEAL_SECONDS;
	elapsed := get_time() - reveal_start;
	if elapsed < 0.0 { elapsed = 0.0; }

	if elapsed < RR_VOTE_MARKER_PHASE_SECONDS {
		// Phase 1: voting grid with marker reveal overlay.
		rr_draw_voting_ui(local_player);
		rr_draw_vote_reveal_overlay();
	} else {
		// Phase 2: outcome panel.
		rr_draw_vote_outcome_panel();
	}
}

rr_draw_vote_outcome_panel :: proc() {
	screen := UI.get_safe_screen_rect();
	white := get_asset(Texture_Asset, "$AO/white.png");

	UI.push_layer(20000);
	defer UI.pop_layer();

	UI.quad(screen, white, v4.{0, 0, 0, 0.82});

	panel_rect := screen.center_rect().grow(470, 700, 470, 700).offset(120, 0);
	rr_ui_draw_modal_panel(panel_rect);

	content := panel_rect.inset(26);
	header := content.cut_top(80);
	body := content;

	title_ts := UI.default_text_settings();
	title_ts.size = 44;
	title_ts.color = v4.{0.95, 0.97, 1.0, 1};
	title_ts.halign = .CENTER;
	title_ts.valign = .CENTER;
	title_ts.do_outline = true;
	title_ts.outline_thickness = 3;
	title_ts.outline_color = v4.{0, 0, 0, 1};

	if rr_last_vote_was_fake_meeting {
		title_ts.color = v4.{0.9, 0.6, 0.1, 1};
		UI.text(header, title_ts, "FAKE MEETING");
	} else {
		UI.text(header, title_ts, "VOTE RESULT");
	}

	message := "No one was ejected.";
	if rr_last_vote_was_fake_meeting {
		if rr_last_vote_prankster_got_voted {
			message = "Fake meeting! You got played by the prankster!";
		} else {
			message = "It was a fake meeting!";
		}
	} else if rr_last_vote_ejected_player_id != 0 {
		p := get_player_by_entity_id(rr_last_vote_ejected_player_id);
		name := "Someone";
		if p != null {
			name = p.entity.get_name();
		}
		message = format_string("% has been ejected!", .{name});
	}

	msg_ts := UI.default_text_settings();
	msg_ts.size = 34;
	msg_ts.color = v4.{1, 1, 1, 1};
	msg_ts.halign = .CENTER;
	msg_ts.valign = .CENTER;
	msg_ts.word_wrap = true;
	msg_ts.do_outline = true;
	msg_ts.outline_thickness = 2;
	msg_ts.outline_color = v4.{0, 0, 0, 1};
	UI.text(body, msg_ts, message);
}

rr_draw_vote_reveal_overlay :: proc() {
	screen := UI.get_safe_screen_rect();
	white := get_asset(Texture_Asset, "$AO/white.png");
	vote_point := get_asset(Texture_Asset, "sprites/voting_point.png");
	vote_tile_backing := get_asset(Texture_Asset, "ui/voting/player_backing.png");

	UI.push_layer(20010);
	defer UI.pop_layer();

	panel_rect := screen.center_rect().grow(470, 700, 470, 700).offset(120, 0);
	content := panel_rect.inset(26);
	header := content.cut_top(120);
	footer := content.cut_bottom(120);
	grid := content;

	// --- Build vote lists (entity IDs for stable network matching) ---
	voters: [..]Player;
	voted_target_ids: [..]u64;
	is_presidential_votes: [..]bool;
	voter_sort_ids: [..]u64;

	skip_voters: [..]Player;
	skip_sort_ids: [..]u64;

	for i: 0..players.elements.count-1 {
		voter := players.elements[i];
		if voter == null continue;
		if voter.player_state != Player_State.ALIVE continue;
		if !voter.has_voted continue;

		if voter.voted_skip {
			ins := skip_voters.count;
			for j: 0..skip_sort_ids.count-1 {
				if voter.entity.id < skip_sort_ids[j] {
					ins = j;
					break;
				}
			}
			skip_voters.append(voter);
			skip_sort_ids.append(voter.entity.id);
			sk := skip_voters.count - 1;
			while sk > ins {
				p := sk - 1;
				tmp_sv := skip_voters[p]; skip_voters[p] = skip_voters[sk]; skip_voters[sk] = tmp_sv;
				tmp_si := skip_sort_ids[p]; skip_sort_ids[p] = skip_sort_ids[sk]; skip_sort_ids[sk] = tmp_si;
				sk -= 1;
			}
			continue;
		}

		if voter.voted_for == null continue;
		if voter.voted_for.entity == null continue;

		insert_idx := voters.count;
		for j: 0..voter_sort_ids.count-1 {
			if voter.entity.id < voter_sort_ids[j] {
				insert_idx = j;
				break;
			}
		}

		voters.append(voter);
		voted_target_ids.append(voter.voted_for.entity.id);
		is_presidential_votes.append(voter.player_role == Player_Role.PRESIDENT);
		voter_sort_ids.append(voter.entity.id);

		k := voters.count - 1;
		while k > insert_idx {
			prev := k - 1;
			tmp_v := voters[prev]; voters[prev] = voters[k]; voters[k] = tmp_v;
			tmp_t := voted_target_ids[prev]; voted_target_ids[prev] = voted_target_ids[k]; voted_target_ids[k] = tmp_t;
			tmp_p := is_presidential_votes[prev]; is_presidential_votes[prev] = is_presidential_votes[k]; is_presidential_votes[k] = tmp_p;
			tmp_i := voter_sort_ids[prev]; voter_sort_ids[prev] = voter_sort_ids[k]; voter_sort_ids[k] = tmp_i;
			k -= 1;
		}
	}

	// --- Compute card rects (same formula as voting page) ---
	tile_entity_ids: [..]u64;
	target_rects: [..]Rect;

	total_players := players.elements.count;
	cols :: 4;
	rows :: 3;
	tile_aspect := 3.15;
	if vote_tile_backing != null {
		tile_aspect = vote_tile_backing.get_aspect();
	}

	spacing := 16.0;
	gw := grid.width();
	gh := grid.height();
	max_w_per := (gw - spacing * (cols - 1).(float)) / cols.(float);
	max_h_per := (gh - spacing * (rows - 1).(float)) / rows.(float);
	card_h := min(max_h_per, max_w_per / tile_aspect);
	if card_h < 1.0 { card_h = 1.0; }
	card_w := card_h * tile_aspect;
	total_w := card_w * cols.(float) + spacing * (cols - 1).(float);
	start_x := grid.min.x + (gw - total_w) * 0.5;
	start_y_top := grid.max.y;

	max_cells := cols * rows;
	for i: 0..min(total_players, max_cells)-1 {
		p := players.elements[i];
		if p == null continue;

		col := i % cols;
		row := i / cols;
		x0 := start_x + col.(float) * (card_w + spacing);
		y_top := start_y_top - row.(float) * (card_h + spacing);
		y0 := y_top - card_h;
		card_rect := Rect.{v2.{x0, y0}, v2.{x0 + card_w, y0 + card_h}};

		tile_entity_ids.append(p.entity.id);
		target_rects.append(card_rect);
	}

	marker_slots: [..]int;
	for i: 0..tile_entity_ids.count-1 {
		marker_slots.append(0);
	}

	// Derive reveal start from the synced global end time (avoids per-instance
	// field being overwritten by network sync, which was resetting the animation).
	reveal_start := rr_vote_results_end_time - RR_VOTE_RESULTS_REVEAL_SECONDS;
	reveal_elapsed := get_time() - reveal_start;
	if reveal_elapsed < 0.0 { reveal_elapsed = 0.0; }

	stagger_seconds :: 0.16;
	appear_seconds :: 0.22;

	two_x_ts := UI.default_text_settings();
	two_x_ts.size = 18;
	two_x_ts.color = v4.{1, 1, 1, 1};
	two_x_ts.halign = .CENTER;
	two_x_ts.valign = .CENTER;
	two_x_ts.do_outline = true;
	two_x_ts.outline_thickness = 2;
	two_x_ts.outline_color = v4.{0, 0, 0, 1};

	// --- Draw player vote markers on target tiles ---
	for i: 0..voters.count-1 {
		appearance_time := i.(float) * stagger_seconds;
		if reveal_elapsed < appearance_time {
			continue;
		}

		target_id := voted_target_ids[i];
		target_idx := -1;
		for j: 0..tile_entity_ids.count-1 {
			if tile_entity_ids[j] == target_id {
				target_idx = j;
				break;
			}
		}
		if target_idx < 0 continue;

		target_rect := target_rects[target_idx];
		slot := marker_slots[target_idx];
		marker_slots[target_idx] += 1;

		marker_size := clamp(target_rect.height() * 0.25, 22.0, 40.0);
		gap := marker_size * 0.15;

		tile_center := target_rect.center();
		base_x := tile_center.x + slot.(float) * (marker_size + gap);
		// Raise marker line so dots sit in the visual center of each vote tile.
		base_y := tile_center.y + target_rect.height() * 0.10;

		local_t := reveal_elapsed - appearance_time;
		appear_t := clamp(local_t / appear_seconds, 0.0, 1.0);
		anim_scale := lerp(0.35, 1.0, Ease.out_back(appear_t));
		alpha := clamp(local_t / 0.08, 0.0, 1.0);

		half := marker_size * 0.5 * anim_scale;
		draw_rect := Rect.{v2.{base_x - half, base_y - half}, v2.{base_x + half, base_y + half}};
		if vote_point != null {
			draw_rect = draw_rect.fit_aspect(vote_point.get_aspect());
		}

		voter := voters[i];
		if voter != null {
			UI.push_player_material(voter);
		}
		if vote_point != null {
			UI.quad(draw_rect, vote_point, v4.{1, 1, 1, alpha});
		} else {
			UI.quad(draw_rect, white, v4.{1, 1, 1, alpha});
		}
		if voter != null {
			UI.pop_material();
		}

		if is_presidential_votes[i] {
			tag_size := marker_size * 0.35;
			tag_cx := draw_rect.min.x + tag_size;
			tag_cy := draw_rect.min.y + tag_size;
			tag_rect := Rect.{v2.{tag_cx - tag_size, tag_cy - tag_size}, v2.{tag_cx + tag_size, tag_cy + tag_size}};
			UI.quad(tag_rect, white, v4.{0.05, 0.05, 0.05, 0.85 * alpha});
			UI.text(tag_rect, two_x_ts, "2x");
		}
	}

	// --- Draw skip vote markers to the right of the skip button ---
	if skip_voters.count > 0 {
		footer_inner := footer.inset(18).cut_top_unscaled(20);
		skip_btn_rect := footer_inner.bottom_center_rect().grow(36, 260, 36, 260);
		vote_skip_button := get_asset(Texture_Asset, "ui/voting/skip_vote_button.png");
		if vote_skip_button != null {
			skip_btn_rect = skip_btn_rect.fit_aspect(vote_skip_button.get_aspect());
		}

		skip_marker_size := clamp(skip_btn_rect.height() * 0.45, 22.0, 40.0);
		skip_gap := skip_marker_size * 0.15;
		skip_start_x := skip_btn_rect.max.x + skip_gap + skip_marker_size * 0.5;
		skip_cy := skip_btn_rect.center().y;

		total_vote_count := voters.count;

		for i: 0..skip_voters.count-1 {
			global_idx := total_vote_count + i;
			appearance_time := global_idx.(float) * stagger_seconds;
			if reveal_elapsed < appearance_time {
				continue;
			}

			sx := skip_start_x + i.(float) * (skip_marker_size + skip_gap);

			local_t := reveal_elapsed - appearance_time;
			appear_t := clamp(local_t / appear_seconds, 0.0, 1.0);
			anim_scale := lerp(0.35, 1.0, Ease.out_back(appear_t));
			alpha := clamp(local_t / 0.08, 0.0, 1.0);

			half := skip_marker_size * 0.5 * anim_scale;
			draw_rect := Rect.{v2.{sx - half, skip_cy - half}, v2.{sx + half, skip_cy + half}};
			if vote_point != null {
				draw_rect = draw_rect.fit_aspect(vote_point.get_aspect());
			}

			voter := skip_voters[i];
			if voter != null {
				UI.push_player_material(voter);
			}
			if vote_point != null {
				UI.quad(draw_rect, vote_point, v4.{1, 1, 1, alpha});
			} else {
				UI.quad(draw_rect, white, v4.{1, 1, 1, alpha});
			}
			if voter != null {
				UI.pop_material();
			}
		}
	}
}

// Returns true if the user clicked "Continue" (caller should close the deaths screen).
rr_draw_recent_deaths_ui :: proc(local_player: Player, open_time: float) -> bool {
	screen := UI.get_safe_screen_rect();

	white := get_asset(Texture_Asset, "$AO/white.png");
	// Match voting screen layer (above all gameplay UI).
	UI.push_layer(20000);
	defer UI.pop_layer();
	// Slide-in animation (left -> center)
	now := get_time();
	t := 1.0;
	if open_time > 0.0 {
		elapsed := now - open_time;
		t = clamp(elapsed / 0.35, 0.0, 1.0);
	}
	x_off := lerp(-520.0, 0.0, t);
	overlay_alpha := lerp(0.0, 0.82, t);

	UI.quad(screen, white, v4.{0, 0, 0, overlay_alpha});

	panel_rect := screen.center_rect().grow(470, 700, 470, 700).offset(x_off + 120.0, 0);
	rr_ui_draw_modal_panel(panel_rect);

	content := panel_rect.inset(24);
	header := content.cut_top(70);
	footer := content.cut_bottom(72);

	title_ts := UI.default_text_settings();
	title_ts.size = 44;
	title_ts.color = v4.{0.95, 0.97, 1.0, 1};
	title_ts.halign = .CENTER;
	title_ts.valign = .CENTER;
	title_ts.do_outline = true;
	title_ts.outline_thickness = 3;
	title_ts.outline_color = v4.{0, 0, 0, 1};
	UI.text(header, title_ts, "RECENT DEATHS");

	// Scrollable list of deaths since last meeting.
	scroll_area := content;
	scroll_bar_area := scroll_area.cut_right(10).inset(2);

	svs: Scroll_View_Settings;
	svs.vertical = true;
	svs.horizontal = false;
	svs.clip_padding = v4.{10, 10, 10, 10};

	sv := UI.push_scroll_view(scroll_area, "recent_deaths", svs); {
		defer UI.pop_scroll_view();

		list_rect := sv.content_rect;
		row_ts := UI.default_text_settings();
		row_ts.size = 34;
		row_ts.color = v4.{0.9, 0.92, 0.98, 1};
		row_ts.halign = .LEFT;
		row_ts.valign = .CENTER;
		row_ts.do_drop_shadow = true;
		row_ts.drop_shadow_offset = v2.{1, -1};
		row_ts.drop_shadow_color = v4.{0, 0, 0, 1};

		if deaths_since_last_meeting.elements.count <= 0 {
			none_rect := list_rect.cut_top(64);
			row_ts.halign = .CENTER;
			UI.text(none_rect, row_ts, "None");
		} else {
			for i: 0..deaths_since_last_meeting.elements.count-1 {
				id := deaths_since_last_meeting.elements[i];
				p := get_player_by_entity_id(id);
				name := "Unknown";
				if p != null {
					name = p.entity.get_name();
				}

				row := list_rect.cut_top(64);
				UI.quad(row.inset(2), white, v4.{0.08, 0.1, 0.14, 0.65});
				UI.text(row.inset(14, 14, 14, 14), row_ts, name);

				list_rect.cut_top(8);
			}
		}
	}

	// Manual scroll bar
	scroll_bar_rect := sv.compute_scroll_bar_rect(scroll_bar_area);
	UI.quad(scroll_bar_area, white, v4.{0.025, 0.025, 0.025, 1});
	UI.quad(scroll_bar_rect, white, v4.{0.12, 0.12, 0.12, 1});

	// Continue button
	btn_rect := footer.center_rect().grow(18, 170, 18, 170);
	bs := UI.default_button_settings();
	bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png"); // green
	bs.press_scaling = 0.96;
	rr_ui_apply_button_click_sound(ref bs);
	ts := UI.default_text_settings();
	ts.size = 30;
	ts.color = v4.{1, 1, 1, 1};
	ts.halign = .CENTER;
	ts.valign = .CENTER;

	if UI.button(btn_rect, bs, ts, "CONTINUE").clicked {
		return true;
	}
	return false;
}

rr_draw_voting_ui :: proc(local_player: Player) {
	screen := UI.get_safe_screen_rect();
	// Note: `UI.spine` is affected by the UI scale factor. Our tile layout math uses rect
	// pixel sizes (from `rect.width()/height()`), so convert any pixel-derived scale values
	// back into "1080p units" by dividing by the current UI scale factor.
	ui_scale := UI.get_current_scale_factor();
	if ui_scale <= 0.001 { ui_scale = 1.0; }

	// Render above everything (popups are 10000).
	UI.push_layer(20000);
	defer UI.pop_layer();

	// --- Style / assets (prefer $AO/ui/kit; fall back safely if missing) ---
	white := get_asset(Texture_Asset, "$AO/white.png");

	// Use kit modal textures and draw them with nine-slice so borders/corners don't stretch.
	// Use transp_black1 as base for tinting (it has nice rounded corners and no color override).
	kit_panel := get_asset(Texture_Asset, "ui/voting/modal_backing.png");
	if kit_panel == null { kit_panel = get_asset(Texture_Asset, "$AO/ui/kit/Modals/modal_windows/modal_simple_black1.png"); }
	if kit_panel == null { kit_panel = white; }

	// Voting UI specific textures (project assets in /res/ui/voting)
	vote_dead_icon := get_asset(Texture_Asset, "ui/voting/dead_crew_icon.png");
	vote_tile_backing := get_asset(Texture_Asset, "ui/voting/player_backing.png");
	vote_tile_top := get_asset(Texture_Asset, "ui/voting/player_backing_top.png");
	vote_tile_selected := get_asset(Texture_Asset, "ui/voting/player_backing_selected.png");
	vote_schleem_shadow := get_asset(Texture_Asset, "ui/voting/schleem_shadow.png");
	vote_skip_button := get_asset(Texture_Asset, "ui/voting/skip_vote_button.png");

	check_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/green_tick_outline.png");
	if check_icon == null { check_icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/white_tick.png"); }
	if check_icon == null { check_icon = get_asset(Texture_Asset, "sprites/icons/vote_select_icon.png"); }
	vote_weapon_icon := get_asset(Texture_Asset, "ui/voting/shoot_weapon_icon.png");
	gun_icon := vote_weapon_icon;
	if gun_icon == null { gun_icon = get_asset(Texture_Asset, "sprites/icons/revolver.png"); }
	plus_icon := get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/plus_button2.png");
	if plus_icon == null { plus_icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/plus_button.png"); }
	call_meeting_icon := get_asset(Texture_Asset, "sprites/icons/call_meeting_icon.png");
	timer_texture := get_asset(Texture_Asset, "ui/voting/timer.png");
	dead_icon := vote_dead_icon;
	if dead_icon == null { dead_icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/misc_icons_2/red_cross.png"); }
	if dead_icon == null { dead_icon = get_asset(Texture_Asset, "sprites/icons/kill_ability.png"); }

	c_overlay := v4.{0, 0, 0, 0.55};
	c_panel_tint := v4.{1, 1, 1, 1};
	if kit_panel == white { c_panel_tint = v4.{0.05, 0.06, 0.08, 0.92}; }

	c_text := v4.{0.95, 0.97, 1.0, 1};
	c_muted := v4.{0.80, 0.84, 0.92, 1};
	c_good := v4.{0.25, 0.90, 0.45, 1};
	c_bad := v4.{1.0, 0.25, 0.25, 1};

	// Background overlay
	UI.quad(screen, white, c_overlay);

	// Main panel (9-sliced)
	panel_rect := screen.center_rect().grow(470, 700, 470, 700).offset(120, 0);
	{
		bs_panel := UI.default_button_settings();
		bs_panel.sprite = kit_panel;
		bs_panel.press_scaling = 1.0;
		rr_ui_apply_button_click_sound(ref bs_panel);
		bs_panel.color = c_panel_tint;
		bs_panel.hovered_color = c_panel_tint;
		bs_panel.pressed_color = c_panel_tint;
		bs_panel.disabled_color = c_panel_tint;
		bs_panel.background_color_multiplier = v4.{1, 1, 1, 1};

		NINE_SLICE_PX :: 96.0;
		bs_panel.nine_slice_data.slice = v4.{NINE_SLICE_PX, NINE_SLICE_PX, NINE_SLICE_PX, NINE_SLICE_PX};
		bs_panel.nine_slice_data.slice_scale = 1.0;

		UI.push_disabled(true);
		defer UI.pop_disabled();
		UI.begin_button(panel_rect, bs_panel, {}, ""); { defer UI.end_button(); }
	}

	content := panel_rect.inset(26);
	header := content.cut_top(120);
	footer := content.cut_bottom(120);
	grid := content;

	// --- Timer (top-right) ---
	current_time := get_time();
	vote_deadline := voting_start_time + 60.0;
	if rr_vote_hurry_deadline > 0.0 && rr_vote_hurry_deadline < vote_deadline {
		vote_deadline = rr_vote_hurry_deadline;
	}
	remaining := vote_deadline - current_time;
	if remaining < 0.0 { remaining = 0.0; }
	total_duration := vote_deadline - voting_start_time;
	if total_duration < 1.0 { total_duration = 1.0; }
	pct := remaining / total_duration;
	if pct < 0.0 { pct = 0.0; }
	if pct > 1.0 { pct = 1.0; }

	title_row := header.cut_top(64);
	title_full := title_row;
	called_by_w := min(320.0, title_row.width() * 0.33);
	called_by_area := title_row.cut_left_unscaled(called_by_w).inset(6, 6, 6, 6);
	timer_w := min(310.0, title_row.width() * 0.33);
	timer_area := title_row.cut_right_unscaled(timer_w);
	title_rect := title_full;

	title_ts := UI.default_text_settings();
	title_ts.size = 58;
	title_ts.color = c_text;
	title_ts.halign = .CENTER;
	title_ts.valign = .CENTER;
	title_ts.do_outline = true;
	title_ts.outline_thickness = 4;
	title_ts.outline_color = v4.{0, 0, 0, 1};
	UI.text(title_rect, title_ts, "Voting Screen");

	timer_box := timer_area.inset(12, 18, 12, 18);
	timer_panel_color := v4.{0.14, 0.26, 0.55, 0.92};
	UI.quad(timer_box, white, timer_panel_color);

	t_color := c_text;
	if remaining <= 10.0 {
		t_color = v4.{1.0, 0.35, 0.35, 1.0};
	} else if remaining <= 30.0 {
		t_color = v4.{1.0, 0.85, 0.25, 1.0};
	}
	badge_size := timer_box.height() * 2;
	badge_rect := timer_box.left_center_rect().grow_unscaled(badge_size * 0.5, badge_size * 0.5, badge_size * 0.5, badge_size * 0.5);
	badge_rect = badge_rect.offset_unscaled(-badge_size * 0.3, 0.2);
	if timer_texture != null {
		badge_draw := badge_rect.fit_aspect(timer_texture.get_aspect());
		UI.quad(badge_draw, timer_texture, v4.{1, 1, 1, 1});
	} else {
		UI.quad(badge_rect, white, v4.{0.12, 0.16, 0.25, 1});
	}

	num_rect := badge_rect.inset(12);
	num_ts := UI.default_text_settings();
	num_ts.size = 42;
	num_ts.color = t_color;
	num_ts.halign = .CENTER;
	num_ts.valign = .CENTER;
	num_ts.do_outline = true;
	num_ts.outline_thickness = 3;
	num_ts.outline_color = v4.{0, 0, 0, 1};

	bar_rect := timer_box.inset(12, 16, 12, 16).cut_bottom_unscaled(8);
	UI.quad(bar_rect, white, v4.{0.20, 0.45, 0.85, 0.95});
	fill := bar_rect.inset(2).subrect(0, 0, pct, 1);
	UI.quad(fill, white, v4.{0.95, 0.20, 0.20, 1});

	UI.text(num_rect, num_ts, format_string("%", .{format_float(remaining, decimals=0)}));

	// --- Called by (top-left) ---
	icon_rect := called_by_area.cut_left_unscaled(64);
	label_rect := called_by_area.cut_top_unscaled(24);
	name_rect := called_by_area;

	label_ts := UI.default_text_settings();
	label_ts.size = 22;
	label_ts.color = c_muted;
	label_ts.halign = .LEFT;
	label_ts.valign = .CENTER;
	label_ts.do_drop_shadow = true;
	label_ts.drop_shadow_offset = v2.{1, -1};
	label_ts.drop_shadow_color = v4.{0, 0, 0, 1};

	name_ts := UI.default_text_settings();
	name_ts.size = 36;
	name_ts.color = c_text;
	name_ts.halign = .LEFT;
	name_ts.valign = .CENTER;
	name_ts.do_outline = true;
	name_ts.outline_thickness = 3;
	name_ts.outline_color = v4.{0, 0, 0, 1};

	initiator_str := "";
	caller_name := "";
	if meeting_initiator_id != 0 {
		caller := get_player_by_entity_id(meeting_initiator_id);
		caller_name = "Unknown";
		if caller != null { caller_name = caller.entity.get_name(); }
		initiator_str = "Called by:";
	}
	if initiator_str.count > 0 {
		if call_meeting_icon != null {
			icon_draw := icon_rect.fit_aspect(call_meeting_icon.get_aspect());
			icon_draw = icon_draw.scale(-1.0, 1.0);
			UI.quad(icon_draw, call_meeting_icon, v4.{1, 1, 1, 1});
		}
		UI.text(label_rect, label_ts, initiator_str);
		UI.text(name_rect, name_ts, caller_name);
	}

	// --- Grid of players (alive + dead) ---
	total_players := players.elements.count;
	if total_players <= 0 {
		empty_ts := UI.default_text_settings();
		empty_ts.size = 44;
		empty_ts.color = c_text;
		empty_ts.halign = .CENTER;
		empty_ts.valign = .CENTER;
		empty_ts.do_outline = true;
		empty_ts.outline_thickness = 3;
		empty_ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(grid, empty_ts, "No players");
	} else {
		cols :: 4;
		rows :: 3;
		tile_aspect := 3.15;
		if vote_tile_backing != null {
			tile_aspect = vote_tile_backing.get_aspect();
		}

		spacing := 16.0;
		gw := grid.width();
		gh := grid.height();

		max_w_per := (gw - spacing * (cols - 1).(float)) / cols.(float);
		max_h_per := (gh - spacing * (rows - 1).(float)) / rows.(float);

		card_h := min(max_h_per, max_w_per / tile_aspect);
		if card_h < 1.0 { card_h = 1.0; }
		card_w := card_h * tile_aspect;

		total_w := card_w * cols.(float) + spacing * (cols - 1).(float);
		start_x := grid.min.x + (gw - total_w) * 0.5;
		start_y_top := grid.max.y;

		name_ts := UI.default_text_settings();
		name_ts.size = 52;
		name_ts.color = v4.{1, 1, 1, 1};
		name_ts.halign = .CENTER;
		name_ts.valign = .CENTER;
		name_ts.do_outline = true;
		name_ts.outline_thickness = 5;
		name_ts.outline_color = v4.{0, 0, 0, 1};

		card_bs := UI.default_button_settings();
		card_bs.press_scaling = 0.98;
		card_bs.sprite_fit_aspect = true;

		get_vote_tile_bg :: proc(color: Color_Replace_Color) -> v4 {
			switch color {
				case .RED:        return v4.{1.00, 0.70, 0.70, 1.0};
				case .RED2:       return v4.{1.00, 0.70, 0.70, 1.0};
				case .CYAN:       return v4.{0.60, 0.85, 1.00, 1.0};
				case .GREEN:      return v4.{0.60, 1.00, 0.70, 1.0};
				case .GREEN3:     return v4.{0.60, 1.00, 0.70, 1.0};
				case .LIGHT_GREEN:return v4.{0.60, 1.00, 0.70, 1.0};
				case .BLUE2:      return v4.{0.60, 0.80, 1.00, 1.0};
				case .PINK:       return v4.{1.00, 0.70, 0.90, 1.0};
				case .PURPLE:     return v4.{0.85, 0.70, 1.00, 1.0};
				case .PURPLE2:    return v4.{0.85, 0.70, 1.00, 1.0};
				case .PURPLE3:    return v4.{0.85, 0.70, 1.00, 1.0};
				case .YELLOW:     return v4.{1.00, 0.92, 0.60, 1.0};
				case .ORANGE:     return v4.{1.00, 0.85, 0.60, 1.0};
				case .ORANGE2:    return v4.{1.00, 0.85, 0.60, 1.0};
				case .LIGHT_GRAY: return v4.{1.00, 0.70, 0.70, 1.0};
				case .WHITE1:     return v4.{1.00, 0.70, 0.70, 1.0};
				case .BLACK:      return v4.{1.00, 0.70, 0.70, 1.0};
				case .BLACK2:     return v4.{1.00, 0.70, 0.70, 1.0};
				case .BROWN1:     return v4.{0.85, 0.75, 0.65, 1.0};
			}
			return v4.{0.90, 0.90, 0.90, 1.0};
		}

		get_vote_tile_name :: proc(color: Color_Replace_Color) -> v4 {
			switch color {
				case .RED:        return v4.{1.00, 0.25, 0.25, 1.0};
				case .RED2:       return v4.{1.00, 0.25, 0.25, 1.0};
				case .CYAN:       return v4.{0.10, 0.65, 1.00, 1.0};
				case .GREEN:      return v4.{0.20, 0.90, 0.35, 1.0};
				case .GREEN3:     return v4.{0.20, 0.90, 0.35, 1.0};
				case .LIGHT_GREEN:return v4.{0.20, 0.90, 0.35, 1.0};
				case .BLUE2:      return v4.{0.25, 0.55, 1.00, 1.0};
				case .PINK:       return v4.{1.00, 0.20, 0.70, 1.0};
				case .PURPLE:     return v4.{0.75, 0.30, 1.00, 1.0};
				case .PURPLE2:    return v4.{0.75, 0.30, 1.00, 1.0};
				case .PURPLE3:    return v4.{0.75, 0.30, 1.00, 1.0};
				case .YELLOW:     return v4.{0.25, 0.90, 0.35, 1.0};
				case .ORANGE:     return v4.{1.00, 0.55, 0.15, 1.0};
				case .ORANGE2:    return v4.{1.00, 0.55, 0.15, 1.0};
				case .LIGHT_GRAY: return v4.{1.00, 0.25, 0.25, 1.0};
				case .WHITE1:     return v4.{1.00, 0.25, 0.25, 1.0};
				case .BLACK:      return v4.{1.00, 0.25, 0.25, 1.0};
				case .BLACK2:     return v4.{1.00, 0.25, 0.25, 1.0};
				case .BROWN1:     return v4.{0.25, 0.25, 0.25, 1.0};
			}
			return v4.{0.25, 0.25, 0.25, 1.0};
		}

		max_cells := cols * rows;
		for i: 0..min(total_players, max_cells)-1 {
			p := players.elements[i];
			if p == null continue;

			col := i % cols;
			row := i / cols;

			x0 := start_x + col.(float) * (card_w + spacing);
			y_top := start_y_top - row.(float) * (card_h + spacing);
			y0 := y_top - card_h;
			card_rect := Rect.{v2.{x0, y0}, v2.{x0 + card_w, y0 + card_h}};

			is_dead := p.player_state != Player_State.ALIVE;
			is_selected := (local_player.voted_for == p);
			can_vote_for := !local_player.has_voted && !is_dead && p != local_player;

			UI.push_id("vote_card_%", .{p.entity.id});
			defer UI.pop_id();

			clicked := false;
			draw_rect := card_rect;

			if can_vote_for {
				hit_bs := UI.default_button_settings();
				hit_bs.sprite = white;
				hit_bs.press_scaling = 1.0;
				rr_ui_apply_button_click_sound(ref hit_bs);
				hit_bs.color = v4.{1, 1, 1, 0.0};
				hit_bs.hovered_color = hit_bs.color;
				hit_bs.pressed_color = hit_bs.color;
				hit_bs.disabled_color = hit_bs.color;

				btn := UI.begin_button(card_rect, hit_bs, {}, ""); {
					defer UI.end_button();
					clicked = btn.clicked;
					draw_rect = btn.rect;
				}
			} else {
				draw_rect = card_rect;
			}

			top_color := v4.{1, 1, 1, 1};
			if is_dead {
				top_color = v4.{0.1, 0.1, 0.1, 1.0};
			} else if !is_selected {
				top_color = get_vote_tile_bg(p.avatar_color);
			}

			if is_selected {
				if vote_tile_selected != null {
					UI.quad(draw_rect, vote_tile_selected, v4.{1, 1, 1, 1});
				} else {
					UI.quad(draw_rect, white, v4.{1, 0.20, 0.20, 1});
				}
			} else {
				if is_dead {
					UI.quad(draw_rect, vote_tile_backing, v4.{0.5, 0.5, 0.5, 1});
				} else {
					UI.quad(draw_rect, vote_tile_backing, v4.{1, 1, 1, 1});
				}

				if vote_tile_top != null {
					overlay_aspect := vote_tile_top.get_aspect();
					overlay_w := draw_rect.width();
					overlay_h := overlay_w / overlay_aspect;
					if overlay_h > draw_rect.height() {
						overlay_h = draw_rect.height();
						overlay_w = overlay_h * overlay_aspect;
					}
					overlay_x0 := draw_rect.min.x + (draw_rect.width() - overlay_w) * 0.5;
					overlay_y1 := draw_rect.max.y;
					overlay_rect := Rect.{v2.{overlay_x0, overlay_y1 - overlay_h}, v2.{overlay_x0 + overlay_w, overlay_y1}};
					UI.quad(overlay_rect, vote_tile_top, top_color);
				}

				if is_dead {
					UI.quad(draw_rect, white, v4.{0, 0, 0, 0.26});
				}
			}

			rig_area := draw_rect.subrect(0.15, 0.1, 0.26, 0.8);
			if p.animator != null && p.animator.instance != null {
				if is_dead {
					UI.push_color_multiplier(v4.{0.55, 0.55, 0.55, 0.95});
				}
				
				UI.push_player_material(p);
				defer UI.pop_material();
				if is_dead {
					defer UI.pop_color_multiplier();
				}

				if is_selected || is_dead {
					shadow_pos := rig_area.center() + v2.{-draw_rect.width() * 0.06, -draw_rect.height() * 0.01};
					shadow_size := (rig_area.height() * 0.55) / ui_scale;
					shadow_rect := Rect.{shadow_pos, shadow_pos}.grow(shadow_size);
					UI.quad(shadow_rect.fit_aspect(vote_schleem_shadow.get_aspect()), vote_schleem_shadow, v4.{1, 1, 1, 1.0});
				}

				s := (rig_area.height() * 1.15) / ui_scale;
				s = clamp(s, 90.0, 165.0);
				pos := rig_area.center() + v2.{-draw_rect.width() * 0.01, -draw_rect.height() * 0.30};
				UI.spine(pos, p.animator.instance, v2.{s, s}, 0.0);
			}

			name_area := draw_rect.subrect(0.20, 0.00, 1.00, 0.50).inset(10, 10, 10, 10);
			if is_selected {
				name_ts.color = v4.{1, 1, 1, 1};
			} else if is_dead {
				name_ts.color = v4.{0.35, 0.35, 0.35, 1};
			} else {
				name_ts.color = get_vote_tile_name(p.avatar_color);
			}
			UI.text(name_area, name_ts, p.entity.get_name());

			if check_icon != null && p.has_voted {
				check_rect := draw_rect.top_right_rect().offset(-24, -24).grow(22);
				UI.quad(check_rect.fit_aspect(check_icon.get_aspect()), check_icon, c_good);
			}

			if gun_icon != null && is_selected {
				gun_rect := draw_rect.top_left_rect().offset(150, -24).grow(32);
				UI.quad(gun_rect.fit_aspect(gun_icon.get_aspect()), gun_icon, v4.{1, 1, 1, 1});
			}

			if is_dead {
				if dead_icon != null {
					dead_rect := draw_rect.center_rect().offset(0, 0).grow(42);
					UI.quad(dead_rect.fit_aspect(dead_icon.get_aspect()), dead_icon, v4.{1, 1, 1, 1});
				}
			}

			if clicked && can_vote_for {
				cast_vote(local_player, p);
				if local_player != null && local_player.is_local() {
					sfx := SFX.default_sfx_desc();
					sfx.set_position(local_player.entity.world_position);
					sfx.volume = 0.85;
					sfx.volume_perturb = 0.1;
					sfx.speed_perturb = 0.05;
					sfx.volume *= 0.25;
					sfx.volume_perturb *= 0.25;
					rr_play_sfx("sfx/cast_vote.wav", sfx);
				}
			}
		}
	}

	// --- Footer: Skip Vote button ---
	footer_inner := footer.inset(18).cut_top_unscaled(20);
	btn_rect := footer_inner.bottom_center_rect().grow(36, 260, 36, 260);

	skip_bs := UI.default_button_settings();
	skip_bs.sprite = vote_skip_button;
	if skip_bs.sprite == null {
		skip_bs.sprite = get_asset(Texture_Asset, "$AO/ui/kit/Modals/basic_buttons/button_large_arrow_green1.png");
	}
	skip_bs.press_scaling = 0.96;
	skip_bs.sprite_fit_aspect = true;
	rr_ui_apply_button_click_sound(ref skip_bs);
	skip_bs.color_multiplier = v4.{0.9, 0.9, 0.9, 1.0};

	skip_ts := UI.default_text_settings();
	skip_ts.size = 44;
	skip_ts.color = v4.{1, 1, 1, 1};
	skip_ts.halign = .CENTER;
	skip_ts.valign = .CENTER;
	skip_ts.do_outline = true;
	skip_ts.outline_thickness = 3;
	skip_ts.outline_color = v4.{0, 0, 0, 1};

	skip_disabled := local_player.has_voted;
	if skip_disabled {
		UI.push_disabled(true);
		UI.push_color_multiplier(v4.{1, 1, 1, 0.55});
	}

	if skip_bs.sprite != null {
		btn_rect = btn_rect.fit_aspect(skip_bs.sprite.get_aspect());
	}

	if UI.button(btn_rect, skip_bs, skip_ts, "Skip Vote").clicked {
		cast_skip_vote(local_player);
		if local_player != null && local_player.is_local() {
			sfx := SFX.default_sfx_desc();
			sfx.set_position(local_player.entity.world_position);
			sfx.volume = 0.85;
			sfx.volume_perturb = 0.1;
			sfx.speed_perturb = 0.05;
			sfx.volume *= 0.25;
			sfx.volume_perturb *= 0.25;
			rr_play_sfx("sfx/cast_vote.wav", sfx);
		}
	}

	if skip_disabled {
		UI.pop_color_multiplier();
		UI.pop_disabled();
	}
}
