// Dev backup/restore: /backup toggles INGAME auto-snapshot (JSON to game save, survives restart);
// /restore applies it to connected players by user_id. Snapshot persists; the enabled flag does not.

BACKUP_POLL_INTERVAL :: 0.5;
// Recapture when a player has moved at least this far (squared world units) since the last
// snapshot. A threshold keeps idle/reconciliation jitter from forcing a re-save every poll while
// still keeping restored positions reasonably fresh as players walk around.
BACKUP_POSITION_EPSILON_SQ :: 1.0;
RR_BACKUP_SAVE_KEY :: "rr_backup_snapshot";
RR_BACKUP_SCHEMA_VERSION :: 9;
RR_BACKUP_MAX_SAVE_BYTES :: 200000;

// Enums serialized as ints — JSON support for enums is unspecified, ints are
// portable. Schema version bump guards against enum reordering.
Backup_Player_Entry :: class {
	user_id: string @ao_serialize;
	role_i: int @ao_serialize;
	type_i: int @ao_serialize;
	state_i: int @ao_serialize;
	world_pos: v2 @ao_serialize; // player's world position at capture
	completed_task_ids: [..]string @ao_serialize;

	werewolf_kills: int @ao_serialize;
	hitman_kills: int @ao_serialize;
	pirate_treasure: int @ao_serialize;
	mimicer_kills: int @ao_serialize;

	// Per-role world-state bools (Lily planted/carrying, GGG nest placed, Portal red/blue placed,
	// Guardian form) are packed into role_flags (RBF_*). They serialize on EVERY player entry
	// regardless of role, so packing 7 bools into one int keeps the snapshot payload small.
	// The matching positions/counters stay as their own fields.
	role_flags: int @ao_serialize;

	// Lily
	lily_tree_pos: v2 @ao_serialize;
	lily_tree_fulfilled: int @ao_serialize;

	// Big Charlie (anarchist) — checklist counters
	bc_planted_nugget_total: int @ao_serialize;
	bc_infection_count: int @ao_serialize;

	// Goo Goo Gaga
	ggg_nest_pos: v2 @ao_serialize;
	ggg_nest_points: int @ao_serialize;

	// Portal Maker (zero pos = not placed)
	portal_red_pos: v2 @ao_serialize;
	portal_blue_pos: v2 @ao_serialize;

	// Hitman
	hitman_mine_positions: [..]v2 @ao_serialize;

	// Movie Star — placed autograph traps (filtered from the global list by owner).
	movie_star_trap_positions: [..]v2 @ao_serialize;

	// The Mech (THE_MECH) — progression: currencies + built upgrades + form/once-per-game flags.
	// All 13 mech bools are packed into one bitmask (MECH_BF_*) so this entry — serialized for
	// EVERY player, not just the mech — stays tiny and the snapshot payload doesn't grow (the
	// string-concat save path is arena-sensitive; see header note). Transient combat/cinematic
	// state (showdown, missile aim, carry, cam holds) is not snapshotted; the avatar is rebuilt
	// from the form bits by rr_mech_update on restore.
	mech_flags: int @ao_serialize;
	mech_power_cores: int @ao_serialize;
	mech_magnet_cores: int @ao_serialize;
	mech_power_cells: int @ao_serialize;
	mech_circuits: int @ao_serialize;
	mech_schematics: int @ao_serialize;
	mech_gears: int @ao_serialize;

	minion_master_user_id: string @ao_serialize;
	minion_original_type_i: int @ao_serialize; // the pre-conversion Player_Type (effect_end restores it)
	minion_power_cells: int @ao_serialize;
	minion_circuits: int @ao_serialize;
	minion_schematics: int @ao_serialize;
	minion_gears: int @ao_serialize;
}

// Bit layout for Backup_Player_Entry.role_flags — per-role world-state bools, packed because
// they serialize on every player entry. Roles are mutually exclusive so the bits never collide.
RBF_LILY_TREE_PLANTED :: 1 << 0;
RBF_LILY_CARRY_EYES   :: 1 << 1;
RBF_LILY_CARRY_LEGS   :: 1 << 2;
RBF_GGG_NEST_PLACED   :: 1 << 3;
RBF_PORTAL_RED        :: 1 << 4;
RBF_PORTAL_BLUE       :: 1 << 5;
RBF_GUARDIAN_FORM     :: 1 << 6; // Guardian (GUARDIAN): persistent transform flag; Showdown state is transient.

// Pack a player's live per-role world-state bools into the role_flags bitmask (single source of
// truth for both capture and the cheap change-detection compare). Modules are mutually exclusive.
rr_backup_role_flags :: proc(p: Player) -> int {
	f := 0;
	lm := p.entity.get_component(Lily_Module);
	if lm != null {
		if lm.hair_tree_planted f |= RBF_LILY_TREE_PLANTED;
		if lm.carrying_eyes     f |= RBF_LILY_CARRY_EYES;
		if lm.carrying_legs     f |= RBF_LILY_CARRY_LEGS;
	}
	gm := p.entity.get_component(GGG_Module);
	if gm != null {
		if gm.nest_placed f |= RBF_GGG_NEST_PLACED;
	}
	pmm := p.entity.get_component(Portal_Maker_Module);
	if pmm != null {
		if pmm.red_portal != null && #alive(pmm.red_portal)   f |= RBF_PORTAL_RED;
		if pmm.blue_portal != null && #alive(pmm.blue_portal) f |= RBF_PORTAL_BLUE;
	}
	gdm := p.entity.get_component(Guardian_Module);
	if gdm != null {
		if gdm.is_guardian_form f |= RBF_GUARDIAN_FORM;
	}
	return f;
}

// Bit layout for Backup_Player_Entry.mech_flags.
MECH_BF_MECH_FORM  :: 1 << 0;
MECH_BF_APEX       :: 1 << 1;
MECH_BF_APEX_USED  :: 1 << 2;
MECH_BF_APEX_LOST  :: 1 << 3;
MECH_BF_CONVERSION :: 1 << 4;
MECH_BF_MINION_REV :: 1 << 5;
MECH_BF_VISITED_WB :: 1 << 6;
MECH_BF_HELMET     :: 1 << 7;
MECH_BF_RAM        :: 1 << 8;
MECH_BF_MAGNET     :: 1 << 9;
MECH_BF_MISSILE    :: 1 << 10;
MECH_BF_WRECKAGE   :: 1 << 11;
MECH_BF_ENDGAME    :: 1 << 12;

// Pack a live Mech_Module's persistent bools into the bitmask (single source of truth for
// both capture and the cheap change-detection compare).
rr_backup_mech_flags :: proc(m: Mech_Module) -> int {
	if m == null return 0;
	f := 0;
	if m.is_mech_form              f |= MECH_BF_MECH_FORM;
	if m.is_apex                   f |= MECH_BF_APEX;
	if m.apex_used                 f |= MECH_BF_APEX_USED;
	if m.apex_lost                 f |= MECH_BF_APEX_LOST;
	if m.conversion_used           f |= MECH_BF_CONVERSION;
	if m.minion_revive_used        f |= MECH_BF_MINION_REV;
	if m.visited_workbench         f |= MECH_BF_VISITED_WB;
	if m.helmet_trap_unlocked      f |= MECH_BF_HELMET;
	if m.ram_charge_unlocked       f |= MECH_BF_RAM;
	if m.magnet_cannon_unlocked    f |= MECH_BF_MAGNET;
	if m.missile_barrage_unlocked  f |= MECH_BF_MISSILE;
	if m.wreckage_warp_unlocked    f |= MECH_BF_WRECKAGE;
	if m.endgame_unlocked          f |= MECH_BF_ENDGAME;
	return f;
}

Backup_Corpse_Entry :: class {
	owner_user_id: string @ao_serialize;
	world_pos: v2 @ao_serialize;
	death_anim: string @ao_serialize;
	// 6 corpse-state bools packed into one bitmask (CBF_*). One entry exists per corpse and
	// corpses scale with the player count, so this is the heaviest repeated structure — packing
	// keeps the serialized snapshot small.
	flags: int @ao_serialize;
}

// Bit layout for Backup_Corpse_Entry.flags.
CBF_REPORTED     :: 1 << 0;
CBF_DNA_SAMPLED  :: 1 << 1;
CBF_PYRO_BURNED  :: 1 << 2;
CBF_PIRATE_MAP   :: 1 << 3;
CBF_GGG_WRAPPED  :: 1 << 4;
CBF_MIMICER_KILL :: 1 << 5;

Backup_Snapshot :: class {
	version: int @ao_serialize;
	// Seconds-since-boot at capture, int to avoid f32→string precision junk
	// that trips strict JSON parsers.
	captured_at_s: int @ao_serialize;
	entries: [..]Backup_Player_Entry @ao_serialize;
	corpses: [..]Backup_Corpse_Entry @ao_serialize;
}

rr_backup_enabled: bool;
rr_backup_snapshot: Backup_Snapshot;
rr_backup_last_poll_at: float;
rr_backup_boot_loaded: bool;

// --- Scalar accessors (null-safe) ------------------------------------------

rr_backup_get_werewolf_kills :: proc(p: Player) -> int {
	m := p.entity.get_component(Werewolf_Module);
	if m == null return 0;
	return m.kills;
}

rr_backup_get_hitman_kills :: proc(p: Player) -> int {
	m := p.entity.get_component(Hitman_Module);
	if m == null return 0;
	return m.kills;
}

rr_backup_get_pirate_treasure :: proc(p: Player) -> int {
	m := p.entity.get_component(Pirate_Module);
	if m == null return 0;
	return m.treasure;
}

rr_backup_get_mimicer_kills :: proc(p: Player) -> int {
	m := p.entity.get_component(Mimicer_Module);
	if m == null return 0;
	return m.kills;
}

rr_backup_count_completed_tasks :: proc(p: Player) -> int {
	completed := 0;
	for j: 0..p.active_tasks.elements.count-1 {
		t := p.active_tasks.elements[j];
		if t == null continue;
		if t.completed completed += 1;
	}
	return completed;
}

rr_backup_completed_tasks_match :: proc(e: Backup_Player_Entry, p: Player) -> bool {
	if e == null return false;
	if e.completed_task_ids.count != rr_backup_count_completed_tasks(p) return false;
	for k: 0..e.completed_task_ids.count-1 {
		id := e.completed_task_ids[k];
		found := false;
		for j: 0..p.active_tasks.elements.count-1 {
			t := p.active_tasks.elements[j];
			if t == null continue;
			if t.completed && t.id == id { found = true; break; }
		}
		if !found return false;
	}
	return true;
}

// --- Persistence (game-level save string, JSON-encoded) --------------------

rr_backup_last_saved_bytes: int;


// Strip structural whitespace and swap `"` -> `'` (save backend rejects raw JSON-like
// values); apostrophes are rare in our data and we swap them back on load.
RR_BACKUP_QUOTE_SENTINEL :: "'";

rr_backup_encode_for_save :: proc(s: string) -> string {
	// First pass: strip newlines/tabs via split+join.
	no_ws := s;
	parts := string_split(no_ws, "\n");
	no_ws = "";
	for i: 0..parts.count-1 {
		no_ws = format_string("%0%", .{no_ws, parts[i]});
	}
	parts = string_split(no_ws, "\r");
	no_ws = "";
	for i: 0..parts.count-1 {
		no_ws = format_string("%0%", .{no_ws, parts[i]});
	}
	parts = string_split(no_ws, "\t");
	no_ws = "";
	for i: 0..parts.count-1 {
		no_ws = format_string("%0%", .{no_ws, parts[i]});
	}

	// Second pass: replace `"` with sentinel so the backend doesn't try to
	// parse our value as JSON.
	q_parts := string_split(no_ws, "\"");
	result := "";
	for i: 0..q_parts.count-1 {
		if i == 0 {
			result = q_parts[i];
		} else {
			result = format_string("%0%0%", .{result, RR_BACKUP_QUOTE_SENTINEL, q_parts[i]});
		}
	}
	return result;
}

rr_backup_decode_from_save :: proc(s: string) -> string {
	parts := string_split(s, RR_BACKUP_QUOTE_SENTINEL);
	result := "";
	for i: 0..parts.count-1 {
		if i == 0 {
			result = parts[i];
		} else {
			result = format_string("%0\"%", .{result, parts[i]});
		}
	}
	return result;
}

rr_backup_save_to_disk :: proc() {
	if rr_backup_snapshot == null return;
	rr_backup_snapshot.version = RR_BACKUP_SCHEMA_VERSION;
	json := JSON.serialize(ref rr_backup_snapshot);
	if json.count > RR_BACKUP_MAX_SAVE_BYTES {
		// Keep this dev snapshot system from ever writing a payload large enough
		// to make the next load expensive or arena-heavy.
		rr_backup_last_saved_bytes = json.count;
		return;
	}
	payload := rr_backup_encode_for_save(json);
	if payload.count > RR_BACKUP_MAX_SAVE_BYTES {
		rr_backup_last_saved_bytes = payload.count;
		return;
	}
	rr_backup_last_saved_bytes = payload.count;
	Save.set_game_string(RR_BACKUP_SAVE_KEY, payload);
}

rr_backup_load_from_disk :: proc() -> bool {
	payload := Save.get_game_string(RR_BACKUP_SAVE_KEY, "");
	if payload.count == 0 return false;
	if payload.count > RR_BACKUP_MAX_SAVE_BYTES {
		// Guard: oversized payloads (stale/corrupt) decode via repeated string
		// concat and can exhaust the engine arena — ignore them.
		return false;
	}

	json := rr_backup_decode_from_save(payload);
	loaded: Backup_Snapshot;
	if !JSON.try_deserialize(json, ref loaded) return false;
	if loaded == null return false;
	if loaded.version != RR_BACKUP_SCHEMA_VERSION return false;
	rr_backup_snapshot = loaded;
	return true;
}

// Load persisted snapshot once per process boot. Enabled flag is NOT persisted.
rr_backup_ensure_loaded :: proc() {
	if rr_backup_boot_loaded return;
	rr_backup_boot_loaded = true;
	rr_backup_load_from_disk();
}

// --- Capture ----------------------------------------------------------------

rr_backup_fill_entry :: proc(e: Backup_Player_Entry, p: Player) {
	e.user_id = p.get_user_id();
	e.role_i = p.player_role.(int);
	e.type_i = p.player_type.(int);
	e.state_i = p.player_state.(int);
	e.world_pos = p.entity.world_position;
	e.werewolf_kills = rr_backup_get_werewolf_kills(p);
	e.hitman_kills = rr_backup_get_hitman_kills(p);
	e.pirate_treasure = rr_backup_get_pirate_treasure(p);
	e.mimicer_kills = rr_backup_get_mimicer_kills(p);

	e.completed_task_ids.clear();
	for j: 0..p.active_tasks.elements.count-1 {
		t := p.active_tasks.elements[j];
		if t == null continue;
		if !t.completed continue;
		append(ref e.completed_task_ids, t.id);
	}

	// Per-role world-state bools (Lily/GGG/Portal/Guardian) packed in one pass.
	e.role_flags = rr_backup_role_flags(p);

	// Lily — tree position + fulfilled stage (the planted/carrying bools live in role_flags).
	lm := p.entity.get_component(Lily_Module);
	if lm != null {
		if lm.hair_tree_entity != null && #alive(lm.hair_tree_entity) {
			e.lily_tree_pos = lm.hair_tree_entity.world_position;
			tree_comp := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
			if tree_comp != null {
				e.lily_tree_fulfilled = tree_comp.fulfilled_count;
			}
		}
	}

	// Big Charlie
	bcm := p.entity.get_component(Big_Charlie_Module);
	if bcm != null {
		e.bc_planted_nugget_total = bcm.planted_nugget_total;
		e.bc_infection_count = bcm.infected_player_ids.count;
	}

	// GGG — nest position + points (the placed bool lives in role_flags).
	gm := p.entity.get_component(GGG_Module);
	if gm != null {
		e.ggg_nest_pos = gm.nest_world_pos;
		e.ggg_nest_points = gm.nest_points;
	}

	// Portal Maker — positions (the placed bools live in role_flags).
	pmm := p.entity.get_component(Portal_Maker_Module);
	if pmm != null {
		if pmm.red_portal != null && #alive(pmm.red_portal) {
			e.portal_red_pos = pmm.red_portal.world_position;
		}
		if pmm.blue_portal != null && #alive(pmm.blue_portal) {
			e.portal_blue_pos = pmm.blue_portal.world_position;
		}
	}

	// The Mech
	mechm := p.entity.get_component(Mech_Module);
	if mechm != null {
		e.mech_flags = rr_backup_mech_flags(mechm);
		e.mech_power_cores = mechm.power_cores;
		e.mech_magnet_cores = mechm.magnet_cores;
		e.mech_power_cells = mechm.power_cells;
		e.mech_circuits = mechm.circuits;
		e.mech_schematics = mechm.schematics;
		e.mech_gears = mechm.gears;
	}

	// Mech Minion — who converted this player + their pre-conversion type and carried parts, so the
	// conversion can be rebuilt on restore. role_i already holds the Minion's original role.
	e.minion_master_user_id = "";
	me := rr_mech_get_minion_effect(p);
	if me != null && me.converted_by_mech_id != 0 {
		e.minion_master_user_id = rr_backup_user_id_for_entity_id(me.converted_by_mech_id);
		e.minion_original_type_i = me.original_type.(int);
		e.minion_power_cells = me.power_cells;
		e.minion_circuits = me.circuits;
		e.minion_schematics = me.schematics;
		e.minion_gears = me.gears;
	}

	// Hitman mines — filter global list by owner.
	e.hitman_mine_positions.clear();
	if p.player_role == Player_Role.HITMAN {
		for i: 0..hitman_mines.elements.count-1 {
			m := hitman_mines.elements[i];
			if m == null continue;
			if m.owner_entity_id != p.entity.id continue;
			if m.mine_entity == null || !#alive(m.mine_entity) continue;
			append(ref e.hitman_mine_positions, m.pos);
		}
	}

	// Movie Star autograph traps — filter global list by owner. (The trap entity is server-only,
	// so we key on the entry/owner, not entity aliveness; the update loop prunes expired entries.)
	e.movie_star_trap_positions.clear();
	if p.player_role == Player_Role.MOVIE_STAR {
		for i: 0..autograph_traps.elements.count-1 {
			t := autograph_traps.elements[i];
			if t == null continue;
			if t.owner_entity_id != p.entity.id continue;
			append(ref e.movie_star_trap_positions, t.pos);
		}
	}
}

// Map a live entity_id to a player's user_id. Returns "" if not a player.
rr_backup_user_id_for_entity_id :: proc(entity_id: u64) -> string {
	if entity_id == 0 return "";
	for p: component_iterator(Player) {
		if p == null continue;
		if p.entity.id == entity_id return p.get_user_id();
	}
	return "";
}

rr_backup_capture :: proc() {
	if rr_backup_snapshot == null {
		rr_backup_snapshot = new(Backup_Snapshot);
	}
	snap := rr_backup_snapshot;
	snap.version = RR_BACKUP_SCHEMA_VERSION;
	snap.captured_at_s = get_time().(int);
	snap.entries.clear();
	snap.corpses.clear();

	for p: component_iterator(Player) {
		if p == null continue;
		e := new(Backup_Player_Entry);
		rr_backup_fill_entry(e, p);
		append(ref snap.entries, e);
	}

	for c: component_iterator(Corpse) {
		if c == null continue;
		if !#alive(c.entity) continue;
		ce := new(Backup_Corpse_Entry);
		ce.owner_user_id = rr_backup_user_id_for_entity_id(c.owner_player_entity_id);
		ce.world_pos = c.entity.world_position;
		ce.death_anim = c.death_anim;
		f := 0;
		if c.has_been_reported      f |= CBF_REPORTED;
		if c.has_dna_been_sampled   f |= CBF_DNA_SAMPLED;
		if c.pyro_has_been_burned   f |= CBF_PYRO_BURNED;
		if c.pirate_map_taken       f |= CBF_PIRATE_MAP;
		if c.ggg_is_wrapped         f |= CBF_GGG_WRAPPED;
		if c.mimicer_disguised_kill f |= CBF_MIMICER_KILL;
		ce.flags = f;
		append(ref snap.corpses, ce);
	}

	rr_backup_save_to_disk();
}

// Cheap per-player surrogate digest — recapture if any tracked field shifts.
// Not a rigorous diff; misses some world-state the next poll picks up anyway.
rr_backup_state_changed :: proc() -> bool {
	if rr_backup_snapshot == null return true;
	snap := rr_backup_snapshot;

	live_count := 0;
	for p: component_iterator(Player) {
		if p == null continue;
		live_count += 1;
	}
	if live_count != snap.entries.count return true;

	live_corpses := 0;
	for c: component_iterator(Corpse) {
		if c == null continue;
		if !#alive(c.entity) continue;
		live_corpses += 1;
	}
	if live_corpses != snap.corpses.count return true;

	for p: component_iterator(Player) {
		if p == null continue;
		uid := p.get_user_id();
		found := false;
		for i: 0..snap.entries.count-1 {
			e := snap.entries[i];
			if e == null continue;
			if e.user_id != uid continue;
			found = true;
			if e.role_i != p.player_role.(int) return true;
			if e.type_i != p.player_type.(int) return true;
			if e.state_i != p.player_state.(int) return true;
			if e.werewolf_kills != rr_backup_get_werewolf_kills(p) return true;
			if e.hitman_kills != rr_backup_get_hitman_kills(p) return true;
			if e.pirate_treasure != rr_backup_get_pirate_treasure(p) return true;
			if e.mimicer_kills != rr_backup_get_mimicer_kills(p) return true;
			if !rr_backup_completed_tasks_match(e, p) return true;

			// Player moved far enough to be worth re-snapshotting (see BACKUP_POSITION_EPSILON_SQ).
			if length_squared(p.entity.world_position - e.world_pos) >= BACKUP_POSITION_EPSILON_SQ return true;

			// All per-role world-state bools in one compare.
			if e.role_flags != rr_backup_role_flags(p) return true;

			lm := p.entity.get_component(Lily_Module);
			if lm != null {
				if lm.hair_tree_entity != null && #alive(lm.hair_tree_entity) {
					tree_comp := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
					if tree_comp != null && e.lily_tree_fulfilled != tree_comp.fulfilled_count return true;
				}
			}

			bcm := p.entity.get_component(Big_Charlie_Module);
			if bcm != null {
				if e.bc_planted_nugget_total != bcm.planted_nugget_total return true;
				if e.bc_infection_count != bcm.infected_player_ids.count return true;
			}

			gm := p.entity.get_component(GGG_Module);
			if gm != null {
				if e.ggg_nest_points != gm.nest_points return true;
			}

			mechm := p.entity.get_component(Mech_Module);
			if mechm != null {
				if e.mech_flags != rr_backup_mech_flags(mechm) return true;
				if e.mech_power_cores != mechm.power_cores return true;
				if e.mech_magnet_cores != mechm.magnet_cores return true;
				if e.mech_power_cells != mechm.power_cells return true;
				if e.mech_circuits != mechm.circuits return true;
				if e.mech_schematics != mechm.schematics return true;
				if e.mech_gears != mechm.gears return true;
			}

			// Minion conversion gained/lost (becoming a Minion also flips type to TRAITOR, but compare
			// the master directly so a re-convert by a different Mech is caught too).
			me := rr_mech_get_minion_effect(p);
			cur_master := me != null && me.converted_by_mech_id != 0 ? rr_backup_user_id_for_entity_id(me.converted_by_mech_id) : "";
			if e.minion_master_user_id != cur_master return true;

			if p.player_role == Player_Role.HITMAN {
				live_mines := 0;
				for mi: 0..hitman_mines.elements.count-1 {
					m := hitman_mines.elements[mi];
					if m == null continue;
					if m.owner_entity_id != p.entity.id continue;
					if m.mine_entity == null || !#alive(m.mine_entity) continue;
					live_mines += 1;
				}
				if e.hitman_mine_positions.count != live_mines return true;
			}

			if p.player_role == Player_Role.MOVIE_STAR {
				live_traps := 0;
				for ti: 0..autograph_traps.elements.count-1 {
					t := autograph_traps.elements[ti];
					if t == null continue;
					if t.owner_entity_id != p.entity.id continue;
					live_traps += 1;
				}
				if e.movie_star_trap_positions.count != live_traps return true;
			}

			break;
		}
		if !found return true;
	}
	return false;
}

rr_backup_maybe_auto :: proc() {
	if !rr_backup_enabled return;
	rr_backup_ensure_loaded();
	if game_state != Game_State.INGAME return;

	now := get_time();
	if now - rr_backup_last_poll_at < BACKUP_POLL_INTERVAL return;
	rr_backup_last_poll_at = now;

	if rr_backup_snapshot == null {
		rr_backup_capture();
		return;
	}
	if rr_backup_state_changed() {
		rr_backup_capture();
	}
}

// --- Restore ----------------------------------------------------------------

rr_backup_find_entry :: proc(uid: string) -> Backup_Player_Entry {
	if rr_backup_snapshot == null return null;
	for i: 0..rr_backup_snapshot.entries.count-1 {
		e := rr_backup_snapshot.entries[i];
		if e == null continue;
		if e.user_id == uid return e;
	}
	return null;
}

rr_backup_restore_lily :: proc(p: Player, e: Backup_Player_Entry) {
	lm := p.entity.get_component(Lily_Module);
	if lm == null return;

	lm.carrying_eyes = (e.role_flags & RBF_LILY_CARRY_EYES) != 0;
	lm.carrying_legs = (e.role_flags & RBF_LILY_CARRY_LEGS) != 0;

	if (e.role_flags & RBF_LILY_TREE_PLANTED) == 0 return;

	// Plant if not already, then move to saved position and stamp fulfilled_count.
	if !lm.hair_tree_planted {
		rr_lily_place_hair_tree(p);
	}
	if lm.hair_tree_entity == null || !#alive(lm.hair_tree_entity) return;
	lm.hair_tree_entity.set_local_position(e.lily_tree_pos);

	tree_comp := lm.hair_tree_entity.get_component(Lily_Hair_Tree);
	if tree_comp == null return;
	tree_comp.fulfilled_count = e.lily_tree_fulfilled;

	// Visual: set correct growth-stage skin.
	if tree_comp.tree_animator != null && tree_comp.tree_animator.instance != null {
		tree_comp.tree_animator.instance.set_skin(rr_lily_get_tree_skin_for_stage(e.lily_tree_fulfilled));
	}

	// Re-apply tree buffs so speed/cooldown multipliers match the stage.
	rr_lily_apply_tree_buffs(p);
}

rr_backup_restore_bc :: proc(p: Player, e: Backup_Player_Entry) {
	bcm := p.entity.get_component(Big_Charlie_Module);
	if bcm == null bcm = p.entity.add_component(Big_Charlie_Module);
	bcm.planted_nugget_total = e.bc_planted_nugget_total;
	// Infection count isn't snapshotted (needs entity-id stability); leave the
	// list empty and let new cocoons rebuild it.
	bcm.infected_player_ids.clear();
}

rr_backup_restore_ggg :: proc(p: Player, e: Backup_Player_Entry) {
	gm := p.entity.get_component(GGG_Module);
	if gm == null return;

	// Clean any existing nest so we don't double-up.
	if gm.nest_entity != null && #alive(gm.nest_entity) {
		gm.nest_entity.destroy();
	}
	gm.nest_entity = null;
	gm.nest_placed = false;

	if (e.role_flags & RBF_GGG_NEST_PLACED) == 0 return;
	rr_ggg_place_nest(p, e.ggg_nest_pos);
	gm.nest_points = e.ggg_nest_points;
}

rr_backup_restore_portals :: proc(p: Player, e: Backup_Player_Entry) {
	if (e.role_flags & RBF_PORTAL_RED) != 0 {
		rr_portal_maker_place_portal(p, true, e.portal_red_pos, v2.{1, 0});
	}
	if (e.role_flags & RBF_PORTAL_BLUE) != 0 {
		rr_portal_maker_place_portal(p, false, e.portal_blue_pos, v2.{1, 0});
	}
}

rr_backup_restore_mines :: proc(p: Player, e: Backup_Player_Entry) {
	if p.player_role != Player_Role.HITMAN return;
	for i: 0..e.hitman_mine_positions.count-1 {
		rr_hitman_place_mine(p, e.hitman_mine_positions[i]);
	}
}

rr_backup_restore_movie_star_traps :: proc(p: Player, e: Backup_Player_Entry) {
	if p.player_role != Player_Role.MOVIE_STAR return;
	for i: 0..e.movie_star_trap_positions.count-1 {
		rr_add_autograph_trap(p, e.movie_star_trap_positions[i]);
	}
}

rr_backup_restore_mech :: proc(p: Player, e: Backup_Player_Entry) {
	mech := p.entity.get_component(Mech_Module);
	if mech == null mech = p.entity.add_component(Mech_Module);

	f := e.mech_flags;
	mech.power_cores = e.mech_power_cores;
	mech.magnet_cores = e.mech_magnet_cores;
	mech.power_cells = e.mech_power_cells;
	mech.circuits = e.mech_circuits;
	mech.schematics = e.mech_schematics;
	mech.gears = e.mech_gears;

	mech.helmet_trap_unlocked     = (f & MECH_BF_HELMET) != 0;
	mech.ram_charge_unlocked      = (f & MECH_BF_RAM) != 0;
	mech.magnet_cannon_unlocked   = (f & MECH_BF_MAGNET) != 0;
	mech.missile_barrage_unlocked = (f & MECH_BF_MISSILE) != 0;
	mech.wreckage_warp_unlocked   = (f & MECH_BF_WRECKAGE) != 0;
	mech.endgame_unlocked         = (f & MECH_BF_ENDGAME) != 0;

	mech.conversion_used    = (f & MECH_BF_CONVERSION) != 0;
	mech.minion_revive_used = (f & MECH_BF_MINION_REV) != 0;
	mech.visited_workbench  = (f & MECH_BF_VISITED_WB) != 0;
	mech.apex_used          = (f & MECH_BF_APEX_USED) != 0;
	mech.apex_lost          = (f & MECH_BF_APEX_LOST) != 0;

	// Form flags are the source of truth for the avatar: rr_mech_update lazily builds + shows the
	// creature every frame from these, so we don't touch the runtime creature entity here. APEX
	// implies mech form. Pre-set the skin-reveal flag so a restored APEX shows its titan skin
	// immediately instead of replaying the one-shot morph reveal (VFX + scale ramp).
	is_apex := (f & MECH_BF_APEX) != 0;
	mech.is_apex = is_apex;
	mech.is_mech_form = is_apex || (f & MECH_BF_MECH_FORM) != 0;
	if is_apex {
		mech.apex_skin_revealed = true;
		mech.apex_reveal_at = 0.0;
	}
}

rr_backup_restore_guardian :: proc(p: Player, e: Backup_Player_Entry) {
	guard := p.entity.get_component(Guardian_Module);
	if guard == null guard = p.entity.add_component(Guardian_Module);
	// rr_mech_update shows/hides the Guardian avatar each frame from this synced flag.
	guard.is_guardian_form = (e.role_flags & RBF_GUARDIAN_FORM) != 0;
}

// Rebuild a Mech Minion conversion: re-add the Mech_Minion_Effect linked to the converting Mech
// (resolved from its user_id) so the Minion keeps its TRAITOR alignment, per-viewer disguise, and
// carried-parts. Role-independent — a Minion keeps its original role, so this runs for any role.
rr_backup_restore_minion :: proc(p: Player, e: Backup_Player_Entry) {
	if e.minion_master_user_id.count == 0 return;
	// Already a Minion (status survived through the round) — don't double-add the effect.
	if rr_mech_get_minion_effect(p) != null return;
	master := rr_backup_find_player_by_user_id(e.minion_master_user_id);
	if master == null return; // the converting Mech isn't in this session — can't relink
	minion := new(Mech_Minion_Effect);
	minion.converted_by_mech_id = master.entity.id;
	minion.original_role = e.role_i.(Player_Role);
	minion.original_type = e.minion_original_type_i.(Player_Type);
	minion.power_cells = e.minion_power_cells;
	minion.circuits = e.minion_circuits;
	minion.schematics = e.minion_schematics;
	minion.gears = e.minion_gears;
	// Snapshot the current (un-disguised) cosmetics so effect_end can restore them; the per-viewer
	// half-cyborg disguise re-applies itself on traitor clients once the effect is live.
	minion.saved_skins.clear();
	if p.animator != null && p.animator.instance != null {
		skins := p.animator.instance.get_skins();
		for i: 0..skins.count-1 {
			minion.saved_skins.append(skins[i]);
		}
	}
	minion.saved_color = p.avatar_color;
	p.entity.add_passive_effect(minion);
}

rr_backup_find_player_by_user_id :: proc(uid: string) -> Player {
	if uid.count == 0 return null;
	for p: component_iterator(Player) {
		if p == null continue;
		if p.get_user_id() == uid return p;
	}
	return null;
}

rr_backup_restore_corpses :: proc() {
	if rr_backup_snapshot == null return;

	// Destroy any existing corpses first so we can rebuild from the snapshot.
	for c: component_iterator(Corpse) {
		if c == null continue;
		if #alive(c.entity) c.entity.destroy();
	}

	for i: 0..rr_backup_snapshot.corpses.count-1 {
		ce := rr_backup_snapshot.corpses[i];
		if ce == null continue;
		owner := rr_backup_find_player_by_user_id(ce.owner_user_id);
		if owner == null continue; // owner not present this session — skip

		// spawn_corpse uses the player's current world_position; we override after.
		world_references.spawn_corpse(owner, 0);
	}

	// Second pass: stamp saved state onto the just-spawned corpses, pairing by
	// index since spawn order matches snapshot iteration order.
	idx := 0;
	for c: component_iterator(Corpse) {
		if c == null continue;
		if !#alive(c.entity) continue;
		if idx >= rr_backup_snapshot.corpses.count break;
		ce := rr_backup_snapshot.corpses[idx];
		idx += 1;
		if ce == null continue;
		if rr_backup_find_player_by_user_id(ce.owner_user_id) == null continue;

		c.entity.set_local_position(ce.world_pos);
		c.has_been_reported      = (ce.flags & CBF_REPORTED) != 0;
		c.has_dna_been_sampled   = (ce.flags & CBF_DNA_SAMPLED) != 0;
		c.pyro_has_been_burned   = (ce.flags & CBF_PYRO_BURNED) != 0;
		c.pirate_map_taken       = (ce.flags & CBF_PIRATE_MAP) != 0;
		c.ggg_is_wrapped         = (ce.flags & CBF_GGG_WRAPPED) != 0;
		c.mimicer_disguised_kill = (ce.flags & CBF_MIMICER_KILL) != 0;
		if ce.death_anim.count > 0 c.death_anim = ce.death_anim;
	}
}

rr_backup_apply_to_player :: proc(p: Player, e: Backup_Player_Entry) {
	role := e.role_i.(Player_Role);
	p.player_role = role;
	p.player_type = e.type_i.(Player_Type);

	// Ensure per-role module exists, then stamp scalar counters.
	if role == Player_Role.WEREWOLF {
		wm := p.entity.get_component(Werewolf_Module);
		if wm == null wm = p.entity.add_component(Werewolf_Module);
		wm.kills = e.werewolf_kills;
	}
	if role == Player_Role.HITMAN {
		hm := p.entity.get_component(Hitman_Module);
		if hm == null hm = p.entity.add_component(Hitman_Module);
		hm.kills = e.hitman_kills;
	}
	if role == Player_Role.PIRATE {
		pm := p.entity.get_component(Pirate_Module);
		if pm == null pm = p.entity.add_component(Pirate_Module);
		pm.treasure = e.pirate_treasure;
	}
	if role == Player_Role.MIMICER {
		mm := p.entity.get_component(Mimicer_Module);
		if mm == null mm = p.entity.add_component(Mimicer_Module);
		mm.kills = e.mimicer_kills;
	}

	// World entities — restore before state transition so the new state sees
	// the rebuilt world.
	if role == Player_Role.LILY_LOVEBRAIDS rr_backup_restore_lily(p, e);
	if role == Player_Role.BIG_CHARLIE rr_backup_restore_bc(p, e);
	if role == Player_Role.GOO_GOO_GAGA rr_backup_restore_ggg(p, e);
	if role == Player_Role.PORTAL_MAKER rr_backup_restore_portals(p, e);
	if role == Player_Role.HITMAN rr_backup_restore_mines(p, e);
	if role == Player_Role.MOVIE_STAR rr_backup_restore_movie_star_traps(p, e);
	if role == Player_Role.THE_MECH rr_backup_restore_mech(p, e);
	if role == Player_Role.GUARDIAN rr_backup_restore_guardian(p, e);
	// Minion link is independent of the (original) role — restore it for any role.
	rr_backup_restore_minion(p, e);

	// Use existing handlers so side effects (ghost nav, voice masks, speed
	// reset) stay consistent with a normal state transition.
	target_state := e.state_i.(Player_State);
	if target_state == Player_State.ALIVE && p.player_state != Player_State.ALIVE {
		on_player_go_alive(p);
	} else if target_state == Player_State.DEAD && p.player_state != Player_State.DEAD {
		on_player_go_dead(p);
	} else if target_state == Player_State.PASSIVE && p.player_state != Player_State.PASSIVE {
		on_player_go_passive(p);
	}

	// Teleport to the saved position AFTER the state transition — on_player_go_alive calls
	// revive(), which can reposition the player, so this must run last to win.
	p.entity.set_local_position(e.world_pos);

	// Apply task completion flags to existing tasks (by id match).
	for j: 0..p.active_tasks.elements.count-1 {
		t := p.active_tasks.elements[j];
		if t == null continue;
		should_complete := false;
		for k: 0..e.completed_task_ids.count-1 {
			if t.id == e.completed_task_ids[k] {
				should_complete = true;
				break;
			}
		}
		t.completed = should_complete;
	}
}

// --- Chat commands ----------------------------------------------------------

// /backup_on — enables snapshot. Captures once immediately on enable.
backup_on :: proc(player: Player) {
	if rr_backup_enabled
		return;

	rr_backup_enabled = true;
	rr_backup_last_poll_at = 0.0;
	rr_backup_capture();
	Chat.server_send_message(
		format_string("Backup ENABLED. Captured % players + % corpses. JSON=%b.",
			.{rr_backup_snapshot.entries.count, rr_backup_snapshot.corpses.count,
			rr_backup_last_saved_bytes}),
		player);
} @chat_command @youtuber

// /backup — toggles auto-snapshot. Captures once immediately on enable.
backup :: proc(player: Player) {
	rr_backup_enabled = !rr_backup_enabled;

	if rr_backup_enabled {
		rr_backup_last_poll_at = 0.0;
		rr_backup_capture();
		Chat.server_send_message(
			format_string("Backup ENABLED. Captured % players + % corpses. JSON=%b.",
				.{rr_backup_snapshot.entries.count, rr_backup_snapshot.corpses.count,
				  rr_backup_last_saved_bytes}),
			player);
		return;
	}
	Chat.server_send_message("Backup DISABLED. Last snapshot retained on disk; /restore still works.", player);
} @chat_command @youtuber

// /restore — applies the latest snapshot to connected players by user_id.
// Requires INGAME so the task list and modules already exist for this round.
restore :: proc(player: Player) {
	rr_backup_ensure_loaded();
	if rr_backup_snapshot == null || rr_backup_snapshot.entries.count == 0 {
		Chat.server_send_message("No backup snapshot. Run /backup first (during a round).", player);
		return;
	}
	if game_state != Game_State.INGAME {
		Chat.server_send_message("/restore only works during INGAME. Start a round first, then /restore.", player);
		return;
	}

	// Clear globally-owned world state so restore can rebuild it from scratch.
	rr_hitman_clear_mines();
	rr_autograph_clear_traps();
	rr_backup_restore_corpses();

	restored := 0;
	skipped := 0;
	for p: component_iterator(Player) {
		if p == null continue;
		uid := p.get_user_id();
		e := rr_backup_find_entry(uid);
		if e == null { skipped += 1; continue; }
		rr_backup_apply_to_player(p, e);
		restored += 1;
	}

	age := get_time().(int) - rr_backup_snapshot.captured_at_s;
	Chat.server_send_message(
		format_string("Restored % players + % corpses from snapshot (% skipped, %s old).",
			.{restored, rr_backup_snapshot.corpses.count, skipped, age}),
		player);
} @chat_command @youtuber
