// loadout.csl — game-side reader for the per-player loadout chosen in the hub.
// Loadout_Data MUST mirror the hub's class exactly (field names, types, @ao_serialize) or deserialize fails.

LOADOUT_SAVE_KEY     :: "loadout_v2";
LOADOUT_DATA_VERSION :: 2;

Loadout_Data :: class {
    version:    int        @ao_serialize;
    traitors:   [..]string @ao_serialize;
    civilians:  [..]string @ao_serialize;
    anarchists: [..]string @ao_serialize;

    traitor_boost_games:   int @ao_serialize;
    civilian_boost_games:  int @ao_serialize;
    anarchist_boost_games: int @ao_serialize;
}

// Hub-side stable role IDs → game-side enum. Anything not in this map is
// treated as always-eligible (see loadout_is_role_managed below).
loadout_role_id_to_player_role :: proc(id: string) -> Player_Role {
    if id == "sheriff"         return Player_Role.SHERIFF;
    if id == "doctor"          return Player_Role.DOCTOR;
    if id == "president"       return Player_Role.PRESIDENT;
    if id == "movie_star"      return Player_Role.MOVIE_STAR;
    if id == "coroner"         return Player_Role.CORONER;
    if id == "portal_maker"    return Player_Role.PORTAL_MAKER;
    if id == "hunter"          return Player_Role.HUNTER;
    if id == "prankster"       return Player_Role.PRANKSTER;
    if id == "pyromaniac"      return Player_Role.PYROMANIAC;
    if id == "hacker"          return Player_Role.HACKER;
    if id == "pirate"          return Player_Role.PIRATE;
    if id == "hitman"          return Player_Role.HITMAN;
    if id == "werewolf"        return Player_Role.WEREWOLF;
    if id == "goo_goo_gaga"    return Player_Role.GOO_GOO_GAGA;
    if id == "mimicer"         return Player_Role.MIMICER;
    if id == "lily_lovebraids" return Player_Role.LILY_LOVEBRAIDS;
    return Player_Role.NONE;
}

// True iff the hub exposes this role in its loadout picker.
// Roles outside the picker (e.g. BIG_CHARLIE) are not gated by loadout.
loadout_is_role_managed :: proc(role: Player_Role) -> bool {
    if role == Player_Role.SHERIFF         return true;
    if role == Player_Role.DOCTOR          return true;
    if role == Player_Role.PRESIDENT       return true;
    if role == Player_Role.MOVIE_STAR      return true;
    if role == Player_Role.CORONER         return true;
    if role == Player_Role.PORTAL_MAKER    return true;
    if role == Player_Role.HUNTER          return true;
    if role == Player_Role.PRANKSTER       return true;
    if role == Player_Role.PYROMANIAC      return true;
    if role == Player_Role.HACKER          return true;
    if role == Player_Role.PIRATE          return true;
    if role == Player_Role.HITMAN          return true;
    if role == Player_Role.WEREWOLF        return true;
    if role == Player_Role.GOO_GOO_GAGA    return true;
    if role == Player_Role.MIMICER         return true;
    if role == Player_Role.LILY_LOVEBRAIDS return true;
    return false;
}

// Read the player's saved loadout (may return null = legacy default, allow all).
// It's a disk read — callers should cache rather than calling per-attempt.
loadout_load_for_player :: proc(player: Player) -> Loadout_Data {
    ld: Loadout_Data;
    if player == null return ld;
    Save.try_get_json(player, LOADOUT_SAVE_KEY, ref ld);
    return ld;
}

loadout_save_for_player :: proc(player: Player, ld: Loadout_Data) {
    if player == null return;
    if ld == null return;
    ld.version = LOADOUT_DATA_VERSION;
    if Game.is_server() {
        Save.set_json(player, LOADOUT_SAVE_KEY, ref ld);
    }
}

loadout_role_boost_remaining :: proc(ld: Loadout_Data, ptype: Player_Type) -> int {
    if ld == null return 0;
    if ptype == Player_Type.TRAITOR return ld.traitor_boost_games;
    if ptype == Player_Type.CIVILIAN return ld.civilian_boost_games;
    if ptype == Player_Type.ANARCHIST return ld.anarchist_boost_games;
    return 0;
}

loadout_role_boost_consume :: proc(player: Player, ld: Loadout_Data, ptype: Player_Type) -> bool {
    if ld == null return false;
    if ptype == Player_Type.TRAITOR {
        if ld.traitor_boost_games <= 0 return false;
        ld.traitor_boost_games -= 1;
        loadout_save_for_player(player, ld);
        return true;
    }
    if ptype == Player_Type.CIVILIAN {
        if ld.civilian_boost_games <= 0 return false;
        ld.civilian_boost_games -= 1;
        loadout_save_for_player(player, ld);
        return true;
    }
    if ptype == Player_Type.ANARCHIST {
        if ld.anarchist_boost_games <= 0 return false;
        ld.anarchist_boost_games -= 1;
        loadout_save_for_player(player, ld);
        return true;
    }
    return false;
}

// True iff `role` is allowed by `ld` (pre-loaded so role-pool code caches one Save read per round).
// Returns true for null ld, unmanaged roles, empty team array, or a listed role; else false.
loadout_player_allows_role :: proc(ld: Loadout_Data, role: Player_Role) -> bool {
    if ld == null return true;
    if !loadout_is_role_managed(role) return true;

    rt := rr_get_role_type(role);
    if rt == Player_Type.TRAITOR {
        if ld.traitors.count == 0 return true;
        for i: 0..ld.traitors.count - 1 {
            if loadout_role_id_to_player_role(ld.traitors[i]) == role return true;
        }
        return false;
    }
    if rt == Player_Type.CIVILIAN {
        if ld.civilians.count == 0 return true;
        for i: 0..ld.civilians.count - 1 {
            if loadout_role_id_to_player_role(ld.civilians[i]) == role return true;
        }
        return false;
    }
    if rt == Player_Type.ANARCHIST {
        if ld.anarchists.count == 0 return true;
        for i: 0..ld.anarchists.count - 1 {
            if loadout_role_id_to_player_role(ld.anarchists[i]) == role return true;
        }
        return false;
    }
    return true;
}

// Convenience read + check in one call (fresh disk read each time).
// Use only for one-off queries (chat commands, debug), not the role-pool loop.
loadout_player_allows_role_uncached :: proc(player: Player, role: Player_Role) -> bool {
    return loadout_player_allows_role(loadout_load_for_player(player), role);
}

// ── Chat command — /my_loadout ──
// Dumps the deserialized loadout for the calling player (verify hub→game round-trip).
my_loadout :: proc(player: Player) {
    ld := loadout_load_for_player(player);
    if ld == null {
        Chat.server_send_message("No loadout saved.", player);
        return;
    }
    msg := format_string("Loadout v%: T=% C=% A=%",
        {ld.version, ld.traitors.count, ld.civilians.count, ld.anarchists.count});
    Chat.server_send_message(msg, player);
} @chat_command @youtuber
