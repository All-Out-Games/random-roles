import "core:ao"

// =============================================================================
// Big Charlie — Anarchist Role (Nugget Mother)
// =============================================================================
//
// Win condition (solo Anarchist):
//   - Plant 5 Lil' Nuggets on the map
//   - Infect 3 different players (Flesh Cocoon -> Incubate -> Hatch)
//   - Fire Mass Birth -> all infected players become mini Big Charlies and
//     stampede the map; Big Charlie wins the round.
//
// Forms:
//   - Schleem form: normal player rig & speed; can use Nugget Scouting Network.
//   - Big Charlie form: visible monster rig at +10% movespeed; can use
//     Birth Nugget, Flesh Cocoon and (when checklist complete) Mass Birth.
//     Incubate is an interact prompt on cocooned victims, only visible to Big Charlie.
//
// =============================================================================

// --- Tunable constants (NOT serialized — same convention as other roles) ---

// Asset paths
BC_CREATURE_RIG :: "anims/roles/BigCharlie/Big Charlie/004RAND_Big_Charlie.spine";
BC_NUGGET_RIG   :: "anims/roles/BigCharlie/Lil Nugget/004RAND_LilNugget.spine";
BC_COCOON_RIG   :: "anims/roles/BigCharlie/FleshyMound/004RAND_Fleshy_Mound.spine";

// Transform
BC_TRANSFORM_ANIM_SECONDS    :: 1.0;
BC_BIG_CHARLIE_SPEED_MULT    :: 1.10;   // X[110]% speed in Big Charlie form

// Birth Nugget
BC_NUGGET_COOLDOWN           :: 30.0;   // X[30]s
BC_NUGGET_MAX_PLANTED        :: 5;       // X[5]
BC_NUGGET_WANDER_RADIUS      :: 0.0;     // planted Nuggets are stationary
BC_NUGGET_BREAK_HOLD         :: 3.0;     // X[3]s
BC_NUGGET_BREAK_PLAYERS      :: 1;       // X[1] non-traitor player
BC_NUGGET_INTERACT_RADIUS    :: 2.0;
BC_NUGGET_VISIBILITY_RANGE   :: 4.0;     // non-Charlie players only see nuggets when close
BC_NUGGET_FOLLOWER_OFFSET    :: v2.{0.0, -0.6}; // behind infected player

// Flesh Cocoon
BC_COCOON_COOLDOWN           :: 40.0;    // X[40]s
BC_COCOON_RANGE              :: 2.5;
BC_COCOON_DURATION           :: 20.0;    // X[20]s
BC_COCOON_FREE_HOLD          :: 3.0;     // X[3]s
BC_COCOON_FREE_PLAYERS       :: 2;       // X[2] players
BC_COCOON_INTERACT_RADIUS    :: 2.5;
BC_COCOON_FORM_DURATION      :: 1.5833;  // length of the Form anim before it loops on Idle_Fresh

// Incubate
BC_INCUBATE_NUGGET_SEARCH    :: 12.0;
BC_INCUBATE_NUGGET_SPEED     :: 4.0;
BC_INCUBATE_NUGGET_ARRIVAL   :: 1.0;
BC_INCUBATE_HATCH_DELAY      :: 10.0;    // X[10]s

// Checklist (win-condition counters)
BC_CHECKLIST_NUGGETS         :: 5;
BC_CHECKLIST_INFECTIONS      :: 3;
BC_DUMMY_INFECTION_ID_BASE   :: 9000000000; // /unlock low-player playtest padding

// Growth Stages — monster form swells visibly per infection.
// 0 infections = 1.00, 1 = 1.10, 2 = 1.20, 3 (Full Size) = 1.30 + pulsing veins.
BC_GROWTH_SCALE_PER_INFECTION :: 0.10;       // X[10]% per infection
BC_GROWTH_PULSE_THRESHOLD     :: 3;          // Full-size veiny pulse at 3+ infections
BC_GROWTH_PULSE_RATE          :: 4.0;        // rad/s (~0.64 Hz visible throb)
BC_GROWTH_PULSE_SCALE_AMP     :: 0.04;       // ±4% breathing on top of base scale

// Shockwave (Absorb_Expansion knockback burst — Big Charlie form)
BC_SHOCKWAVE_COOLDOWN        :: 20.0;    // X[20]s
BC_SHOCKWAVE_RANGE           :: 7.0;     // X[7] stud max blast radius (clipped by walls)
BC_SHOCKWAVE_WINDUP          :: 0.5;     // delay before knockback fires (lines up with anim impact)
BC_SHOCKWAVE_FLING_SECS      :: 0.8;     // max time the fling can travel (collides early on walls)
BC_SHOCKWAVE_FLING_SPEED     :: 16.0;    // applied every frame during fling — sends victim to the wall
BC_SHOCKWAVE_STUN_SECS       :: 2.7;     // stun window — matches Land_On_Front_Recover_Stationary anim length
BC_SHOCKWAVE_STEP            :: 0.25;    // sample step along the wave (smaller = tighter wall-stop)
BC_SHOCKWAVE_OFFNAV_TOL      :: 0.4;     // sample is "behind a wall" when navmesh nearest point is this far
BC_SHOCKWAVE_FLING_REASON    :: "bc_shockwave_fling";
BC_SHOCKWAVE_STUN_REASON     :: "bc_shockwave_stun";

// Mass Birth
BC_MASS_BIRTH_STAMPEDE_DELAY :: 1.0;     // bellow wind-up before mini Charlies launch
BC_MASS_BIRTH_STAMPEDE_SPEED :: 6.0;     // mini Big Charlie converge speed
BC_MASS_BIRTH_MINI_SCALE     :: v2.{0.62, 0.62};
BC_MASS_BIRTH_CHANT_RADIUS   :: 1.4;     // inner ring: mini Charlies form a circle at this distance from Big Charlie
BC_MASS_BIRTH_NUGGET_RADIUS  :: 2.4;     // outer ring: nuggets form a circle further out

// Cinematic camera lock + transform screenshake (driven from Player.ao_late_update)
BC_MASS_BIRTH_CAM_Y_OFFSET    :: 0.5;    // raise the cinematic camera a bit above Charlie's feet
BC_MASS_BIRTH_SHAKE_DURATION  :: 0.6;    // total shake window after sync
BC_MASS_BIRTH_SHAKE_INTENSITY :: 0.5;    // medium intensity (matches Lily deathbraid scale)
BC_MASS_BIRTH_SHAKE_SPEED     :: 28.0;   // rad/s

// --- Reasons (movement/freeze/invisibility lock keys) ---
BC_TRANSFORM_LOCK_REASON     :: "bc_transform_lock";
BC_INVIS_REASON              :: "bc_monster_form";
BC_NAME_INVIS_REASON         :: "bc_monster_form";
BC_CAMERA_LOCK_REASON        :: "bc_camera_viewing";
BC_COCOON_FREEZE_REASON      :: "bc_cocoon";
BC_COCOON_BLIND_REASON       :: "bc_cocoon_blind";
BC_MASS_BIRTH_LOCK_REASON    :: "bc_mass_birth";

// --- SFX paths (placeholders — replace with dedicated BC SFX) ---
BC_SFX_TRANSFORM             :: "sfx/transform_poof_2da056.wav";
BC_SFX_TRANSFORM_SCREAM      :: "sfx/roar_f23931.wav"; // Charlie's scream when Schleem -> Big Charlie
BC_SFX_TRANSFORM_SCREAM_DELAY :: 0.25;                  // line up with the visible scream beat
BC_SFX_TRANSFORM_BACK        :: "sfx/cast_freeze_spell_244d4c.wav";
BC_SFX_NUGGET_BIRTH          :: "sfx/plant_seed_end_1ff22e.wav";
BC_SFX_COCOON_WRAP           :: "sfx/cast_invis_spell_d2e239.wav";
BC_SFX_INCUBATE              :: "sfx/emerge_43c728.wav";
BC_SFX_HATCH                 :: "sfx/emerge_ab8828.wav";
BC_SFX_MASS_BIRTH_BELLOW     :: "sfx/roar_f23931.wav";
BC_SFX_NUGGET_BREAK          :: "sfx/jumpscare_01_026eef.wav";
BC_SFX_SHOCKWAVE             :: "sfx/roar_f23931.wav";

// =============================================================================
// Round-start / cleanup
// =============================================================================

rr_bc_round_start :: proc(p: Player) {
	rr_bc_cleanup(p);
	if p.player_role != Player_Role.BIG_CHARLIE return;

	bcm := p.entity.get_component(Big_Charlie_Module);
	if bcm == null {
		bcm = p.entity.add_component(Big_Charlie_Module);
	}
	bcm.is_big_charlie_form = false;
	bcm.creature_visible = false;
	bcm.skeleton_swap_at = 0.0;
	bcm.bc_form_speed_active = false;
	bcm.nugget_entities.clear();
	bcm.planted_nugget_total = 0;
	bcm.infected_player_ids.clear();
	bcm.camera_active = false;
	bcm.camera_nugget_index = 0;
	bcm.camera_lockout_until = 0.0;
	bcm.mass_birth_active = false;
	bcm.mass_birth_started_at = 0.0;
	bcm.mass_birth_sync_at = 0.0;
	bcm.shockwave_pending = false;
	bcm.shockwave_fire_at = 0.0;
	bcm.cocoon_entities.clear();

	// BC uses its own custom checklist HUD (see rr_bc_draw_checklist_panel) — no task-list entries.
	p.active_tasks = List(Task_Base).{};
}

// Belt-and-suspenders global sweep: nukes every BC scene entity (cocoons,
// nuggets, mini-Charlie creatures) regardless of which Big_Charlie_Module owns
// them. Called once at round start so a previous Charlie who disconnected or
// rerolled cannot leak entities into the new round. Per-player cleanup
// (rr_bc_cleanup) still handles victim flags and Charlie's own state.
rr_bc_round_global_cleanup :: proc() {
	// Release cocoon victims, then collect entities to destroy after iteration.
	cocoon_ents: [..]Entity;
	for c: component_iterator(BC_Flesh_Cocoon) {
		if c == null continue;
		if c.entity == null || !#alive(c.entity) continue;
		rr_bc_release_cocoon_victim(c);
		cocoon_ents.append(c.entity);
	}
	for i: 0..cocoon_ents.count-1 {
		if cocoon_ents[i] != null && #alive(cocoon_ents[i]) cocoon_ents[i].destroy();
	}

	nugget_ents: [..]Entity;
	for n: component_iterator(BC_Lil_Nugget) {
		if n == null continue;
		if n.entity == null || !#alive(n.entity) continue;
		nugget_ents.append(n.entity);
	}
	for i: 0..nugget_ents.count-1 {
		if nugget_ents[i] != null && #alive(nugget_ents[i]) nugget_ents[i].destroy();
	}
}

// Cleanup all BC-owned entities/state. Idempotent. Safe to call on any player.
rr_bc_cleanup :: proc(player: Player) {
	if player == null return;

	// Victim-side reset — runs for every player, not just last round's Charlie.
	// A player who was cocooned / infected / mass-birthed in the previous round
	// must come into the new round with a clean slate, even if the Charlie who
	// owned them has rerolled to another role and no longer has the module.
	if player.bc_cocooned {
		rr_bc_release_player_from_cocoon(player);
	}
	rr_bc_clear_infected_player(player);

	bc := player.entity.get_component(Big_Charlie_Module);
	if bc != null {
		// Free any cocoons (release victims first)
		for i: 0..bc.cocoon_entities.count-1 {
			ce := bc.cocoon_entities[i];
			if ce == null || !#alive(ce) continue;
			cocoon := ce.get_component(BC_Flesh_Cocoon);
			if cocoon != null {
				rr_bc_release_cocoon_victim(cocoon);
			}
			ce.destroy();
		}
		bc.cocoon_entities.clear();

		// Destroy nuggets
		for i: 0..bc.nugget_entities.count-1 {
			ne := bc.nugget_entities[i];
			if ne != null && #alive(ne) {
				ne.destroy();
			}
		}
		bc.nugget_entities.clear();
		bc.planted_nugget_total = 0;

		// Clear infected followers' state on each victim
		for i: 0..bc.infected_player_ids.count-1 {
			vp := get_player_by_entity_id(bc.infected_player_ids[i]);
			if vp == null continue;
			rr_bc_clear_infected_player(vp);
		}
		bc.infected_player_ids.clear();
	}

	// Destroy creature rig + clear visibility
	rr_bc_destroy_creature_entity(player);
	rr_bc_exit_camera(player);

	player.remove_disable_movement_input_reason(BC_TRANSFORM_LOCK_REASON);
	player.remove_disable_movement_input_reason(BC_MASS_BIRTH_LOCK_REASON);
	player.remove_freeze_reason(BC_CAMERA_LOCK_REASON);
}

// Reset to schleem form (called on death / meeting / state change).
rr_bc_force_revert :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;

	if bc.bc_form_speed_active && player.baseline_movement_speed_saved {
		player.agent.movement_speed = player.baseline_movement_speed;
	}
	bc.bc_form_speed_active = false;
	bc.is_big_charlie_form = false;
	bc.skeleton_swap_at = 0.0;
	bc.shockwave_pending = false;
	bc.shockwave_fire_at = 0.0;

	rr_bc_swap_to_player(player);
	player.set_trigger("RESET");
	player.remove_disable_movement_input_reason(BC_TRANSFORM_LOCK_REASON);
	rr_bc_exit_camera(player);
}

// Per-player unstuck (called from gamemanager rr_unstuck_player).
rr_bc_unstuck_player :: proc(player: Player) {
	if player == null return;
	if player.entity == null return;
	if !#alive(player.entity) return;

	// Victim side: release any cocoon effect on this player
	if player.bc_cocooned {
		rr_bc_release_player_from_cocoon(player);
	}

	// Big Charlie side: reset form + camera
	if player.player_role == Player_Role.BIG_CHARLIE {
		rr_bc_force_revert(player);
	}

	// Drain any locks
	player.remove_disable_movement_input_reason(BC_TRANSFORM_LOCK_REASON);
	player.remove_disable_movement_input_reason(BC_MASS_BIRTH_LOCK_REASON);
	player.remove_freeze_reason(BC_CAMERA_LOCK_REASON);
	player.remove_freeze_reason(BC_COCOON_FREEZE_REASON);
	player.remove_invisibility_reason(BC_INVIS_REASON);
	player.remove_name_invisibility_reason(BC_NAME_INVIS_REASON);
	player.remove_invisibility_reason(BC_COCOON_BLIND_REASON);
}

// =============================================================================
// Creature entity management
// =============================================================================

rr_bc_ensure_creature_entity :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if bc.creature_entity != null && #alive(bc.creature_entity) return;

	ce := Scene.create_entity();
	ce.set_parent(player.entity, false);
	ce.set_local_position(v2.{0, 0});
	ce.set_local_scale(v2.{1, 1});
	ce.set_local_rotation(0.0);

	ca := ce.add_component(Spine_Animator);
	ca.awaken();
	if ca.instance != null {
		ca.instance.set_skeleton(get_asset(Spine_Asset, BC_CREATURE_RIG));
		ca.instance.set_skin("BigCharlie_Base");
		ca.instance.refresh_skins();
		ca.instance.set_animation("Idle", true, 0);
		rr_bc_setup_creature_state_machine(ca);
		rr_apply_shadow_mask(ca.instance);
	}

	ce.set_local_enabled(false);
	bc.creature_entity = ce;
	bc.creature_animator = ca;
	bc.creature_full_size_skin = false;
}

rr_bc_destroy_creature_entity :: proc(player: Player) {
	player.remove_invisibility_reason(BC_INVIS_REASON);
	player.remove_name_invisibility_reason(BC_NAME_INVIS_REASON);

	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if bc.creature_entity != null && #alive(bc.creature_entity) {
		bc.creature_entity.destroy();
	}
	bc.creature_entity = null;
	bc.creature_animator = null;
	bc.creature_visible = false;
	bc.creature_full_size_skin = false;
}

rr_bc_swap_to_creature :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	rr_bc_ensure_creature_entity(player);
	if bc.creature_entity == null return;

	player.add_invisibility_reason(BC_INVIS_REASON);
	player.add_name_invisibility_reason(BC_NAME_INVIS_REASON);
	bc.creature_entity.set_local_enabled(true);
	bc.creature_visible = true;

	if bc.creature_animator != null && bc.creature_animator.instance != null {
		if bc.creature_animator.instance.state_machine != null {
			bc.creature_animator.instance.state_machine.set_trigger("spawn_in");
		}
	}
}

rr_bc_swap_to_player :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if !bc.creature_visible return;
	if bc.creature_entity != null && #alive(bc.creature_entity) {
		bc.creature_entity.set_local_enabled(false);
	}
	bc.creature_visible = false;
	player.remove_invisibility_reason(BC_INVIS_REASON);
	player.remove_name_invisibility_reason(BC_NAME_INVIS_REASON);
}

// Growth Stages: Big Charlie's monster form swells visibly per infection
// (re-infections of the same victim stack and grow her further).
// Scale scales linearly with infection count (capped at BC_CHECKLIST_INFECTIONS).
// At full size (3+), swap to BigCharlie_Stampede skin (pulsing veins) and add a
// sin-wave breathing scale on top.
// Scale is re-applied every frame because server->client sync overwrites local
// transform; skin is only swapped when the target stage crosses the threshold.
rr_bc_apply_growth_visuals :: proc(bc: Big_Charlie_Module, now: float) {
	if bc == null return;
	if bc.creature_entity == null || !#alive(bc.creature_entity) return;

	stage := bc.infected_player_ids.count;
	if stage > BC_CHECKLIST_INFECTIONS stage = BC_CHECKLIST_INFECTIONS;

	base_scale := 1.0 + cast(float) stage * BC_GROWTH_SCALE_PER_INFECTION;

	full_size := stage >= BC_GROWTH_PULSE_THRESHOLD;
	scale := base_scale;
	if full_size {
		scale = base_scale + sin(now * BC_GROWTH_PULSE_RATE) * BC_GROWTH_PULSE_SCALE_AMP;
	}

	bc.creature_entity.set_local_scale(v2.{scale, scale});

	if bc.creature_animator != null && bc.creature_animator.instance != null {
		if full_size != bc.creature_full_size_skin {
			bc.creature_animator.instance.set_skin(full_size ? "BigCharlie_Stampede" : "BigCharlie_Base");
			bc.creature_animator.instance.refresh_skins();
			bc.creature_full_size_skin = full_size;
		}
	}
}

rr_bc_creature_trigger :: proc(player: Player, trigger_name: string) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if bc.creature_animator == null return;
	if bc.creature_animator.instance == null return;
	if bc.creature_animator.instance.state_machine != null {
		bc.creature_animator.instance.state_machine.set_trigger(trigger_name);
	}
}

rr_bc_setup_creature_state_machine :: proc(ca: Spine_Animator) {
	sm := State_Machine.create();
	layer := sm.create_layer("main", 0);

	is_moving         := sm.create_variable("is_moving", .BOOL);
	spawn_in_trigger  := sm.create_variable("spawn_in", .TRIGGER);
	cocoon_trigger    := sm.create_variable("cocoon", .TRIGGER);
	bellow_trigger    := sm.create_variable("bellow", .TRIGGER);
	birth_trigger     := sm.create_variable("birth", .TRIGGER);
	shockwave_trigger := sm.create_variable("shockwave", .TRIGGER);

	idle_state := layer.create_state("Idle", true, 0.0);
	run_state  := layer.create_state("Run", true, 0.0);
	layer.set_initial_state(idle_state);

	idle_to_run := layer.create_transition(idle_state, run_state, false);
	idle_to_run.create_bool_condition(is_moving, true);
	run_to_idle := layer.create_transition(run_state, idle_state, false);
	run_to_idle.create_bool_condition(is_moving, false);

	// Spawn in (after Schleem -> BC transform finishes)
	// [ART] Animation name "Transform_Monster_End" used by old rig.
	spawn_state := layer.create_state("Transform_Monster_End", false, 1.0);
	to_spawn := layer.create_global_transition(spawn_state, false);
	to_spawn.create_trigger_condition(spawn_in_trigger);
	layer.create_transition(spawn_state, idle_state, true);

	// Cocoon-cast — reuses old "Absorb_Start" anim as a pulse cast.
	// [ART] Replace with dedicated "Spawn_Cocoon" once art lands.
	cocoon_state := layer.create_state("Absorb_Start", false, 0.6);
	to_cocoon := layer.create_global_transition(cocoon_state, true);
	to_cocoon.create_trigger_condition(cocoon_trigger);
	layer.create_transition(cocoon_state, idle_state, true);

	// Birth Nugget — reuses "Spawn_Nugget" intro birth anim.
	// The full anim is 1.4s but BigCharlie's skeleton only animates over the
	// first ~0.55s (the remaining 0.85s is just trailing VFX particles, with
	// the body locked on its last pose). Speed the state up so the spine track
	// completes inside the state's runtime — otherwise the body holds its
	// final frame for ~0.85s before the SM transitions back to Idle.
	// [ART] If a dedicated "Birth_Nugget_Idle" is added, point this at it.
	birth_state := layer.create_state("Spawn_Nugget", false, 0.55);
	birth_state.speed = 1.4 / 0.55; // ~2.55x — full anim resolves in 0.55s
	to_birth := layer.create_global_transition(birth_state, true);
	to_birth.create_trigger_condition(birth_trigger);
	layer.create_transition(birth_state, idle_state, true);

	// Mass Birth chant — Big Charlie holds Stampede_Roar in a loop while the
	// mini Charlies converge and chant alongside her. Round ends before exit.
	bellow_state := layer.create_state("Stampede_Roar", true, 0.0);
	to_bellow := layer.create_global_transition(bellow_state, false);
	to_bellow.create_trigger_condition(bellow_trigger);

	// Shockwave knockback burst — full 2.5s Absorb_Expansion anim.
	shockwave_state := layer.create_state("Absorb_Expansion", false, 2.5);
	to_shockwave := layer.create_global_transition(shockwave_state, false);
	to_shockwave.create_trigger_condition(shockwave_trigger);
	layer.create_transition(shockwave_state, idle_state, true);

	ca.awaken();
	ca.instance.set_state_machine(sm, true);
}

// =============================================================================
// Lil' Nugget
// =============================================================================

BC_Lil_Nugget :: class : Component {
	owner_player_entity_id: u64;
	spawn_pos: v2;
	rng: u64;

	// Follower (attached to an infected player)
	is_follower: bool;
	follower_target_id: u64;
	follower_phase: float;

	// Incubate (sent to a cocoon)
	is_incubating: bool;
	incubate_cocoon_id: u64;
	incubate_target_pos: v2;

	// Mass Birth: assigned slot on the outer ring around Big Charlie + chant flag.
	is_stampeding: bool;
	stampede_target_pos: v2;
	chant_angle: float;
	chanting: bool;

	// Break interactable (planted nuggets only)
	break_progress: float;
	break_players_this_frame: int;

	// Pending destroy (deferred to allow despawn animation)
	pending_destroy: bool;
	destroy_at: float;

	ao_start :: method() {
		rng = rng_seed(entity.id);
		follower_phase = rng_range_float(ref rng, 0.0, 6.28);
		apply_local_visibility();
	}

	// Proximity-based local visibility — Big Charlie always sees nuggets;
	// non-Charlie players only see planted nuggets when close, like Lily trees /
	// GGG nests. Follower nuggets are always fully visible (they trail an
	// infected player — proximity-fade would obscure the diegetic warning).
	apply_local_visibility :: method() {
		spine := entity.get_component(Spine_Animator);
		if spine == null return;
		if spine.instance == null return;

		local_player, ok := Game.get_local_player();
		if !ok {
			spine.instance.color_multiplier = v4.{1, 1, 1, 0};
			return;
		}

		if local_player.player_role == Player_Role.BIG_CHARLIE {
			spine.instance.color_multiplier = v4.{1, 1, 1, 1};
			return;
		}

		if is_follower {
			spine.instance.color_multiplier = v4.{1, 1, 1, 1};
			return;
		}

		dist := length(local_player.entity.world_position - entity.world_position);
		if dist <= BC_NUGGET_VISIBILITY_RANGE {
			alpha := 1.0 - clamp((dist - BC_NUGGET_VISIBILITY_RANGE + 2.0) / 2.0, 0.0, 1.0);
			alpha = clamp(alpha, 0.0, 1.0);
			spine.instance.color_multiplier = v4.{1, 1, 1, alpha};
		} else {
			spine.instance.color_multiplier = v4.{1, 1, 1, 0};
		}
	}

	ao_update :: method(dt: float) {
		apply_local_visibility();

		now := get_time();

		if pending_destroy {
			if now >= destroy_at {
				entity.destroy();
			}
			return;
		}

		// Mass Birth: each nugget is assigned a slot on the outer ring around
		// Big Charlie (target updated by BC's update) and switches to the chant
		// loop once it arrives.
		if is_stampeding {
			cur := entity.world_position;
			diff := stampede_target_pos - cur;
			dist := length(diff);
			if dist > 0.2 {
				step := normalize(diff) * 14.0 * dt;
				if length(step) > dist step = diff;
				new_pos := cur + step;
				nav_pt: v2;
				tri: s64;
				if try_find_closest_point_on_navmesh(new_pos, ref nav_pt, ref tri) {
					entity.set_local_position(nav_pt);
				} else {
					entity.set_local_position(new_pos);
				}
			} else if !chanting {
				chanting = true;
				spine := entity.get_component(Spine_Animator);
				if spine != null && spine.instance != null {
					spine.instance.set_animation("Look_Up_Loop", true, 0);
				}
			}
			return;
		}

		// Follower: confidently trail near the infected player without being
		// glued to one static offset. It keeps a small orbit/range around them,
		// lags behind movement, and catches up faster if it falls too far back.
		if is_follower {
			target := get_player_by_entity_id(follower_target_id);
			if target == null || target.player_state != Player_State.ALIVE {
				// Victim died/left ? remove follower.
				pending_destroy = true;
				destroy_at = now + 0.1;
				return;
			}

			center := target.entity.world_position;
			cur := entity.world_position;
			velocity := target.agent.velocity;
			speed := length(velocity);
			from_player := cur - center;
			from_player_dist := length(from_player);

			target_pos := cur;

			orbit_amp_x := 0.45;
			orbit_amp_y := 0.25;
			if speed <= 0.2 {
				// When the host is idle, preserve whichever side/ring the nugget
				// is already on. Do not reset to the default offset in front/behind
				// the player; only correct if too close or too far.
				if from_player_dist >= 0.65 && from_player_dist <= 1.25 {
					return;
				}

				if from_player_dist > 0.05 {
					ring_dir := normalize(from_player);
					target_pos = center + ring_dir * 0.95;
				} else {
					target_pos = center + v2.{cos(follower_phase), sin(follower_phase)} * 0.95;
				}
			} else {
				move_dir := normalize(velocity);
				trail := move_dir * -0.95;
				orbit_amp_x = 0.45;
				orbit_amp_y = 0.25;
				orbit := v2.{
					cos(now * 1.7 + follower_phase) * orbit_amp_x,
					sin(now * 2.1 + follower_phase) * orbit_amp_y
				};
				target_pos = center + trail + orbit;
			}

			// If the follower is crowding the player, push the desired point out
			// to a comfortable ring instead of sitting under their feet.
			if speed > 0.2 && from_player_dist < 0.55 {
				if from_player_dist > 0.05 {
					target_pos = center + normalize(from_player) * 0.9;
				} else {
					target_pos = center + v2.{cos(follower_phase), sin(follower_phase)} * 0.9;
				}
			}

			diff := target_pos - cur;
			dist := length(diff);

			if dist > 0.10 {
				follow_speed := 5.5;
				if speed <= 0.2 follow_speed = 1.8;
				if dist > 0.8 follow_speed = 8.0;
				if length(cur - center) > 2.0 follow_speed = 11.0;

				step := normalize(diff) * min(dist, follow_speed * dt);
				new_pos := cur + step;
				nav_pt: v2;
				tri: s64;
				if try_find_closest_point_on_navmesh(new_pos, ref nav_pt, ref tri) {
					entity.set_local_position(nav_pt);
				} else {
					entity.set_local_position(new_pos);
				}
			}
			return;
		}

		// Incubating: walk toward cocoon. On arrival, harden.
		if is_incubating {
			cocoon_entity: Entity = null;
			for c: component_iterator(BC_Flesh_Cocoon) {
				if c == null continue;
				if c.entity != null && c.entity.id == incubate_cocoon_id {
					cocoon_entity = c.entity;
					incubate_target_pos = c.entity.world_position;
					break;
				}
			}
			if cocoon_entity == null {
				// Cocoon gone — abort and resume wandering.
				is_incubating = false;
				return;
			}

			cur := entity.world_position;
			diff := incubate_target_pos - cur;
			dist := length(diff);
			if dist <= BC_INCUBATE_NUGGET_ARRIVAL {
				cocoon_comp := cocoon_entity.get_component(BC_Flesh_Cocoon);
				if cocoon_comp != null {
					rr_bc_harden_cocoon(cocoon_comp);
				}
				// Nugget is consumed by the cocoon.
				pending_destroy = true;
				destroy_at = now + 0.05;
				return;
			}
			step := normalize(diff) * BC_INCUBATE_NUGGET_SPEED * dt;
			new_pos := cur + step;
			nav_pt: v2;
			tri: s64;
			if try_find_closest_point_on_navmesh(new_pos, ref nav_pt, ref tri) {
				entity.set_local_position(nav_pt);
			} else {
				entity.set_local_position(new_pos);
			}
			return;
		}

		// Planted Nuggets stay exactly where Big Charlie birthed them. This
		// avoids the old first-frame snap/wander offset and matches the design:
		// stationary, visible map hazards that players can spend 3s destroying.
		entity.set_local_position(spawn_pos);

		// Reset per-frame break counter (set by Interactable.on_holding).
		if break_players_this_frame < BC_NUGGET_BREAK_PLAYERS {
			break_progress = 0.0;
		}
		break_players_this_frame = 0;
	}
}

// Any single non-traitor player can hold to destroy a planted Lil' Nugget.
BC_Nugget_Break_Interactable :: class : Interactable {
	nugget: BC_Lil_Nugget;

	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Smush Nugget");
		this.set_hold_text("Smushing...");
		required_hold_time = BC_NUGGET_BREAK_HOLD;
		radius = BC_NUGGET_INTERACT_RADIUS;
		prompt_offset = v2.{0, 1.0};
		priority = 16;
	}

	can_use :: method(player: Player) -> bool {
		if nugget == null return false;
		if !#alive(nugget.entity) return false;
		if nugget.is_follower return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role == Player_Role.BIG_CHARLIE return false;
		if player.bc_cocooned return false;
		return true;
	}

	on_holding :: method(player: Player) {
		if nugget == null return;
		nugget.break_players_this_frame += 1;
	}

	on_interact :: method(player: Player) {
		if nugget == null return;
		rr_bc_destroy_planted_nugget(nugget);
	}
}

// Spawn a planted nugget at the given position. Caps at BC_NUGGET_MAX_PLANTED.
// Returns the spawned entity, or null if the cap would be exceeded.
rr_bc_spawn_planted_nugget :: proc(player: Player, position: v2) -> Entity {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return null;

	rr_bc_cleanup_dead_nuggets(bc);
	if rr_bc_count_planted_nuggets(bc) >= BC_NUGGET_MAX_PLANTED return null;

	ne := Scene.create_entity();
	ne.set_local_position(position);
	ne.set_local_scale(v2.{1.0, 1.0});

	spine := ne.add_component(Spine_Animator);
	spine.awaken();
	if spine.instance != null {
		spine.instance.set_skeleton(get_asset(Spine_Asset, BC_NUGGET_RIG));
		spine.instance.set_skin("normal");
		spine.instance.refresh_skins();
		spine.instance.set_animation("Idle", true, 0);
		rr_apply_shadow_mask(spine.instance);
	}

	nugget := ne.add_component(BC_Lil_Nugget);
	nugget.owner_player_entity_id = player.entity.id;
	nugget.spawn_pos = position;
	nugget.is_follower = false;

	// Add the break interactable so players can simultaneously hold to destroy.
	brk := ne.add_component(BC_Nugget_Break_Interactable);
	brk.nugget = nugget;

	bc.nugget_entities.append(ne);
	bc.planted_nugget_total += 1;
	return ne;
}

// Spawn a follower nugget attached to an infected player.
rr_bc_spawn_follower_nugget :: proc(bc_player: Player, victim: Player) -> Entity {
	bc := bc_player.entity.get_component(Big_Charlie_Module);
	if bc == null return null;

	ne := Scene.create_entity();
	ne.set_local_position(victim.entity.world_position + BC_NUGGET_FOLLOWER_OFFSET);
	ne.set_local_scale(v2.{1.0, 1.0});

	spine := ne.add_component(Spine_Animator);
	spine.awaken();
	if spine.instance != null {
		spine.instance.set_skeleton(get_asset(Spine_Asset, BC_NUGGET_RIG));
		spine.instance.set_skin("normal");
		spine.instance.refresh_skins();
		spine.instance.set_animation("Run", true, 0);
		rr_apply_shadow_mask(spine.instance);
	}

	nugget := ne.add_component(BC_Lil_Nugget);
	nugget.owner_player_entity_id = bc_player.entity.id;
	nugget.spawn_pos = victim.entity.world_position;
	nugget.is_follower = true;
	nugget.follower_target_id = victim.entity.id;

	bc.nugget_entities.append(ne);
	return ne;
}

// Player initiated destruction of a planted nugget (smush animation).
rr_bc_destroy_planted_nugget :: proc(nugget: BC_Lil_Nugget) {
	if nugget == null return;
	if !#alive(nugget.entity) return;

	if Game.is_server() {
		desc := SFX.default_sfx_desc();
		desc.entity_to_follow = nugget.entity.id;
		desc.volume = 0.3;
		rr_play_sfx(BC_SFX_NUGGET_BREAK, desc);
	}

	nugget.pending_destroy = true;
	nugget.destroy_at = get_time() + 0.4;
}

rr_bc_cleanup_dead_nuggets :: proc(bc: Big_Charlie_Module) {
	if bc == null return;
	i := 0;
	while i < bc.nugget_entities.count {
		e := bc.nugget_entities[i];
		if e == null || !#alive(e) {
			bc.nugget_entities.unordered_remove_by_index(i);
		} else {
			i += 1;
		}
	}
}

rr_bc_count_planted_nuggets :: proc(bc: Big_Charlie_Module) -> int {
	count := 0;
	for i: 0..bc.nugget_entities.count-1 {
		e := bc.nugget_entities[i];
		if e == null || !#alive(e) continue;
		n := e.get_component(BC_Lil_Nugget);
		if n == null continue;
		if !n.is_follower count += 1;
	}
	return count;
}

// =============================================================================
// Flesh Cocoon
// =============================================================================

BC_Flesh_Cocoon :: class : Component {
	bc_player_entity_id: u64;
	victim_player_entity_id: u64;
	created_at: float;
	expires_at: float;

	// Hardened: incubated; immune to Doctor heal & player breakouts.
	hardened: bool;
	hatch_at: float;

	// Free interaction (only valid before hardening).
	free_progress: float;
	free_players_this_frame: int;

	// Has a nugget already been dispatched to incubate?
	incubation_dispatched: bool;

	// Pending destroy (so wrap-out animation can play before removal).
	pending_destroy: bool;
	destroy_at: float;

	// Idle animation tracking — swap from one-shot Form to looped Idle_Fresh once Form ends.
	idle_anim_set: bool;

	ao_start :: method() {
		created_at = get_time();
		expires_at = created_at + BC_COCOON_DURATION;
	}

	ao_update :: method(dt: float) {
		now := get_time();

		if pending_destroy {
			if now >= destroy_at {
				entity.destroy();
			}
			return;
		}

		// Hardened cocoons hatch on a timer, releasing the victim with a
		// permanent nugget follower.
		if hardened {
			if now >= hatch_at {
				rr_bc_hatch_cocoon(this);
			}
			return;
		}

		// Once Form finishes, settle onto looping Idle_Fresh until incubated.
		if !idle_anim_set && now >= created_at + BC_COCOON_FORM_DURATION {
			spine := entity.get_component(Spine_Animator);
			if spine != null && spine.instance != null {
				spine.instance.set_animation("Idle_Fresh", true, 0);
			}
			idle_anim_set = true;
		}

		// Unhardened cocoons expire after BC_COCOON_DURATION (victim freed).
		if now >= expires_at {
			rr_bc_release_cocoon_victim(this);
			pending_destroy = true;
			destroy_at = now + 0.5;
			return;
		}

		// Reset break counter each frame (interactable on_holding sets it).
		if free_players_this_frame < BC_COCOON_FREE_PLAYERS {
			free_progress = 0.0;
		}
		free_players_this_frame = 0;

		// Pin victim into the cocoon position (in case anything else moved them).
		victim := get_player_by_entity_id(victim_player_entity_id);
		if victim != null && victim.player_state == Player_State.ALIVE && victim.bc_cocooned {
			victim.entity.set_local_position(entity.world_position);
		}
	}
}

// Players hold simultaneously to free a cocooned ally (only before hardening).
BC_Cocoon_Free_Interactable :: class : Interactable {
	cocoon: BC_Flesh_Cocoon;

	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Free Cocoon");
		this.set_hold_text("Tearing open...");
		required_hold_time = BC_COCOON_FREE_HOLD;
		radius = BC_COCOON_INTERACT_RADIUS;
		prompt_offset = v2.{0, 1.5};
		priority = 25;
	}

	can_use :: method(player: Player) -> bool {
		if cocoon == null return false;
		if !#alive(cocoon.entity) return false;
		if cocoon.hardened return false;
		if cocoon.pending_destroy return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role == Player_Role.BIG_CHARLIE return false;
		// The cocooned victim can't free themselves — needs outside help.
		if player.entity.id == cocoon.victim_player_entity_id return false;
		return true;
	}

	on_holding :: method(player: Player) {
		if cocoon == null return;
		if player.entity.id == cocoon.victim_player_entity_id return;
		cocoon.free_players_this_frame += 1;
	}

	on_interact :: method(player: Player) {
		if cocoon == null return;
		if cocoon.hardened return;
		if player.entity.id == cocoon.victim_player_entity_id return;
		if cocoon.free_players_this_frame >= BC_COCOON_FREE_PLAYERS {
			rr_bc_release_cocoon_victim(cocoon);
			cocoon.pending_destroy = true;
			cocoon.destroy_at = get_time() + 0.5;
		} else {
			Notifier.notify(player, format_string("Need % players to free!", {BC_COCOON_FREE_PLAYERS}));
		}
	}
}

// Big Charlie interact: dispatch a nearby Lil' Nugget to incubate the cocoon.
BC_Cocoon_Incubate_Interactable :: class : Interactable {
	cocoon: BC_Flesh_Cocoon;

	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Incubate");
		this.set_hold_text("Calling Nugget...");
		required_hold_time = 0.5;
		radius = BC_COCOON_INTERACT_RADIUS;
		prompt_offset = v2.{0, 1.5};
		priority = 30;
	}

	can_use :: method(player: Player) -> bool {
		if cocoon == null return false;
		if !#alive(cocoon.entity) return false;
		if cocoon.hardened return false;
		if cocoon.pending_destroy return false;
		if cocoon.incubation_dispatched return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.BIG_CHARLIE return false;
		// Big Charlie form only.
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null || !bc.is_big_charlie_form return false;
		// Must own the cocoon and have a nugget within search range.
		if cocoon.bc_player_entity_id != player.entity.id return false;
		return rr_bc_find_nearest_planted_nugget_for_incubate(player, cocoon.entity.world_position) != null;
	}

	on_interact :: method(player: Player) {
		if cocoon == null return;
		if cocoon.hardened return;
		if cocoon.incubation_dispatched return;
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return;

		nugget := rr_bc_find_nearest_planted_nugget_for_incubate(player, cocoon.entity.world_position);
		if nugget == null return;

		nugget_comp := nugget.get_component(BC_Lil_Nugget);
		if nugget_comp == null return;

		nugget_comp.is_incubating = true;
		nugget_comp.incubate_cocoon_id = cocoon.entity.id;
		nugget_comp.incubate_target_pos = cocoon.entity.world_position;
		cocoon.incubation_dispatched = true;

		if Game.is_server() {
			desc := SFX.default_sfx_desc();
			desc.entity_to_follow = cocoon.entity.id;
			desc.volume = 0.3;
			rr_play_sfx(BC_SFX_INCUBATE, desc);
		}
		Notifier.notify(player, "Nugget dispatched to incubate!");
	}
}

// Find the closest planted nugget owned by `player` to position `pos`,
// within BC_INCUBATE_NUGGET_SEARCH range. Returns null if none.
rr_bc_find_nearest_planted_nugget_for_incubate :: proc(player: Player, pos: v2) -> Entity {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return null;
	rr_bc_cleanup_dead_nuggets(bc);
	best: Entity = null;
	best_dist := BC_INCUBATE_NUGGET_SEARCH;
	for i: 0..bc.nugget_entities.count-1 {
		e := bc.nugget_entities[i];
		if e == null || !#alive(e) continue;
		n := e.get_component(BC_Lil_Nugget);
		if n == null continue;
		if n.is_follower continue;        // followers stay with their host
		if n.is_incubating continue;       // already busy
		if n.is_stampeding continue;
		if n.pending_destroy continue;
		dist := length(e.world_position - pos);
		if dist < best_dist {
			best_dist = dist;
			best = e;
		}
	}
	return best;
}

// Spawn a flesh cocoon, root + blind the victim.
rr_bc_create_cocoon :: proc(player: Player, victim: Player) -> Entity {
	if player == null return null;
	if player.entity == null || !#alive(player.entity) return null;
	if player.player_state != Player_State.ALIVE return null;
	if victim == null return null;
	if victim == player return null;
	if victim.entity == null return null;
	if !#alive(victim.entity) return null;
	if victim.player_state != Player_State.ALIVE return null;
	if victim.bc_cocooned return null;

	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return null;
	if !bc.is_big_charlie_form return null;

	pos := victim.entity.world_position;

	ce := Scene.create_entity();
	ce.set_local_position(pos);
	ce.set_local_scale(v2.{1.0, 1.0});

	spine := ce.add_component(Spine_Animator);
	spine.awaken();
	if spine.instance != null {
		spine.instance.set_skeleton(get_asset(Spine_Asset, BC_COCOON_RIG));
		spine.instance.set_animation("Form", false, 0);
		rr_apply_shadow_mask(spine.instance);
	}

	cocoon := ce.add_component(BC_Flesh_Cocoon);
	cocoon.bc_player_entity_id = player.entity.id;
	cocoon.victim_player_entity_id = victim.entity.id;

	// Free interaction (only before hardening) — anyone can hold to break out an ally.
	free_int := ce.add_component(BC_Cocoon_Free_Interactable);
	free_int.cocoon = cocoon;

	// Big Charlie's incubate prompt — only she sees/uses this.
	inc_int := ce.add_component(BC_Cocoon_Incubate_Interactable);
	inc_int.cocoon = cocoon;

	bc.cocoon_entities.append(ce);

	// Pin victim
	victim.bc_cocooned = true;
	victim.bc_cocoon_entity = ce;
	victim.entity.set_local_position(pos);
	victim.add_freeze_reason(BC_COCOON_FREEZE_REASON);
	victim.add_invisibility_reason(BC_COCOON_BLIND_REASON);
	victim.add_name_invisibility_reason(BC_COCOON_BLIND_REASON);

	if Game.is_server() {
		desc := SFX.default_sfx_desc();
		desc.entity_to_follow = ce.id;
		desc.volume = 0.45;
		rr_play_sfx(BC_SFX_COCOON_WRAP, desc);
	}

	return ce;
}

// Release the cocoon's victim (un-root, un-blind). Does not destroy the cocoon entity.
rr_bc_release_cocoon_victim :: proc(cocoon: BC_Flesh_Cocoon) {
	if cocoon == null return;
	victim := get_player_by_entity_id(cocoon.victim_player_entity_id);
	if victim != null {
		rr_bc_release_player_from_cocoon(victim);
	}
}

// Strip cocoon flags + locks off a player (idempotent).
rr_bc_release_player_from_cocoon :: proc(victim: Player) {
	if victim == null return;
	victim.bc_cocooned = false;
	victim.bc_cocoon_entity = null;
	victim.remove_freeze_reason(BC_COCOON_FREEZE_REASON);
	victim.remove_invisibility_reason(BC_COCOON_BLIND_REASON);
	victim.remove_name_invisibility_reason(BC_COCOON_BLIND_REASON);
}

// Mark a cocoon as hardened and schedule its hatch.
rr_bc_harden_cocoon :: proc(cocoon: BC_Flesh_Cocoon) {
	if cocoon == null return;
	if cocoon.hardened return;
	cocoon.hardened = true;
	cocoon.hatch_at = get_time() + BC_INCUBATE_HATCH_DELAY;

	// Settled, incubated visual — loop the hardened idle.
	spine := cocoon.entity.get_component(Spine_Animator);
	if spine != null && spine.instance != null {
		spine.instance.set_animation("Idle_Solid", true, 0);
	}
}

// Hatch a cocoon: free victim, attach a permanent Nugget follower to them,
// tick the infection checklist.
rr_bc_hatch_cocoon :: proc(cocoon: BC_Flesh_Cocoon) {
	if cocoon == null return;
	if !#alive(cocoon.entity) return;

	bc_player := get_player_by_entity_id(cocoon.bc_player_entity_id);
	victim := get_player_by_entity_id(cocoon.victim_player_entity_id);

	rr_bc_release_cocoon_victim(cocoon);

	if bc_player != null && victim != null && victim.player_state == Player_State.ALIVE {
		bc := bc_player.entity.get_component(Big_Charlie_Module);
		if bc != null {
			// Each infection counts toward the goal — re-infecting the same
			// victim stacks another nugget follower and another tally.
			bc.infected_player_ids.append(victim.entity.id);

			follower := rr_bc_spawn_follower_nugget(bc_player, victim);
			if follower != null {
				victim.bc_nugget_follower_entities.append(follower);
			}
			victim.bc_infected_by_id = bc_player.entity.id;
		}
	}

	if Game.is_server() {
		desc := SFX.default_sfx_desc();
		desc.entity_to_follow = cocoon.entity.id;
		desc.volume = 0.2;
		rr_play_sfx(BC_SFX_HATCH, desc);
	}

	// Play break-open animation, then destroy cocoon.
	spine := cocoon.entity.get_component(Spine_Animator);
	if spine != null && spine.instance != null {
		spine.instance.set_animation("Broken_Open_Fresh", false, 0);
	}
	cocoon.pending_destroy = true;
	cocoon.destroy_at = get_time() + 1.2;

	// Drop tracking from owning BC's cocoon list (cleanup runs on destroy too).
	if bc_player != null {
		bc := bc_player.entity.get_component(Big_Charlie_Module);
		if bc != null {
			bc.cocoon_entities.unordered_remove_by_value(cocoon.entity);
		}
	}
}

// Called from Player.on_killed — clear all BC effects targeting the dead player
// across every active Big Charlie in the round.
rr_bc_on_player_died :: proc(dead_player_entity_id: u64) {
	dead := get_player_by_entity_id(dead_player_entity_id);
	if dead == null return;

	// Owner-side: if Big Charlie dies during a predicted cocoon/nugget action,
	// immediately tear down all locally-owned BC state. This prevents stale
	// client-predicted cocoons from pinning a killer or ticking after the server
	// reconciles the kill first. rr_bc_cleanup already releases the victim half.
	if dead.player_role == Player_Role.BIG_CHARLIE {
		rr_bc_cleanup(dead);
	} else if dead.bc_cocooned {
		rr_bc_release_player_from_cocoon(dead);
	}

	for bc_player: component_iterator(Player) {
		if bc_player == null continue;
		if bc_player.player_role != Player_Role.BIG_CHARLIE continue;
		bc := bc_player.entity.get_component(Big_Charlie_Module);
		if bc == null continue;

		// Drop every infection slot for this victim (re-infections stack). Each
		// slot was paid for with one consumed planted Nugget, so decrement the
		// task-list checklist tally by however many followers this victim was
		// carrying — Charlie has to re-plant to make up for the lost infection.
		removed := 0;
		i := 0;
		while i < bc.infected_player_ids.count {
			if bc.infected_player_ids[i] == dead_player_entity_id {
				bc.infected_player_ids.unordered_remove_by_index(i);
				removed += 1;
				continue;
			}
			i += 1;
		}
		if removed > 0 {
			bc.planted_nugget_total -= removed;
			if bc.planted_nugget_total < 0 bc.planted_nugget_total = 0;
		}
		rr_bc_clear_infected_player(dead);

		// Tear down any cocoon owned by this BC that was targeting the dead player.
		i = 0;
		while i < bc.cocoon_entities.count {
			ce := bc.cocoon_entities[i];
			if ce == null || !#alive(ce) {
				bc.cocoon_entities.unordered_remove_by_index(i);
				continue;
			}
			cocoon := ce.get_component(BC_Flesh_Cocoon);
			if cocoon != null && cocoon.victim_player_entity_id == dead_player_entity_id {
				rr_bc_release_cocoon_victim(cocoon);
				cocoon.pending_destroy = true;
				cocoon.destroy_at = get_time() + 0.4;
				bc.cocoon_entities.unordered_remove_by_index(i);
			} else {
				i += 1;
			}
		}
	}
}

// Strip infected/follower state from a player (called on cleanup / death).
rr_bc_clear_infected_player :: proc(victim: Player) {
	if victim == null return;
	for i: 0..victim.bc_nugget_follower_entities.count-1 {
		fe := victim.bc_nugget_follower_entities[i];
		if fe != null && #alive(fe) fe.destroy();
	}
	victim.bc_nugget_follower_entities.clear();
	victim.bc_infected_by_id = 0;
	if victim.bc_mini_charlie_creature_entity != null && #alive(victim.bc_mini_charlie_creature_entity) {
		victim.bc_mini_charlie_creature_entity.destroy();
	}
	victim.bc_mini_charlie_creature_entity = null;
	victim.bc_is_mini_charlie = false;
	victim.bc_mini_chanting = false;
	victim.bc_mini_chant_angle = 0.0;
	victim.remove_disable_movement_input_reason(BC_MASS_BIRTH_LOCK_REASON);
	victim.remove_invisibility_reason(BC_INVIS_REASON);
	victim.remove_name_invisibility_reason(BC_NAME_INVIS_REASON);
}

// =============================================================================
// Camera (Nugget Scouting Network)
// =============================================================================

// Returns the count of active camera-eligible nuggets (planted + followers).
rr_bc_count_camera_nuggets :: proc(bc: Big_Charlie_Module) -> int {
	rr_bc_cleanup_dead_nuggets(bc);
	count := 0;
	for i: 0..bc.nugget_entities.count-1 {
		e := bc.nugget_entities[i];
		if e == null || !#alive(e) continue;
		count += 1;
	}
	return count;
}

rr_bc_get_camera_nugget_at :: proc(bc: Big_Charlie_Module, idx: int) -> Entity {
	rr_bc_cleanup_dead_nuggets(bc);
	if idx < 0 return null;
	if idx >= bc.nugget_entities.count return null;
	return bc.nugget_entities[idx];
}

rr_bc_enter_camera :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if bc.camera_active return;
	if bc.is_big_charlie_form return;       // Schleem form only
	if get_time() < bc.camera_lockout_until return;
	if rr_bc_count_camera_nuggets(bc) == 0 return;

	bc.camera_active = true;
	bc.camera_nugget_index = 0;
	player.add_freeze_reason(BC_CAMERA_LOCK_REASON);

	if player.is_local() {
		bc.camera_original_size = player.camera.size;
		player.camera.follow_player = false;
		player.camera.size = player.camera_default_size;
	}
}

rr_bc_exit_camera :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if !bc.camera_active return;

	bc.camera_active = false;
	player.remove_freeze_reason(BC_CAMERA_LOCK_REASON);

	if player.is_local() {
		player.camera.follow_player = true;
		if bc.camera_original_size > 0.0 {
			player.camera.size = bc.camera_original_size;
		}
	}
}

rr_bc_camera_next :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if !bc.camera_active return;
	count := rr_bc_count_camera_nuggets(bc);
	if count == 0 { rr_bc_exit_camera(player); return; }
	bc.camera_nugget_index = (bc.camera_nugget_index + 1) % count;
}

rr_bc_camera_prev :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if !bc.camera_active return;
	count := rr_bc_count_camera_nuggets(bc);
	if count == 0 { rr_bc_exit_camera(player); return; }
	bc.camera_nugget_index -= 1;
	if bc.camera_nugget_index < 0 bc.camera_nugget_index = count - 1;
}

rr_bc_camera_select :: proc(player: Player, idx: int) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if !bc.camera_active return;
	count := rr_bc_count_camera_nuggets(bc);
	if count == 0 { rr_bc_exit_camera(player); return; }
	if idx < 0 return;
	if idx >= count return;
	bc.camera_nugget_index = idx;
}

rr_bc_get_active_camera_nugget :: proc(player: Player) -> Entity {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return null;
	if !bc.camera_active return null;
	count := rr_bc_count_camera_nuggets(bc);
	if count == 0 return null;
	if bc.camera_nugget_index >= count bc.camera_nugget_index = 0;
	return rr_bc_get_camera_nugget_at(bc, bc.camera_nugget_index);
}

// =============================================================================
// Transform (Schleem <-> Big Charlie)
// =============================================================================

rr_bc_start_transform :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if bc.is_big_charlie_form return;

	bc.is_big_charlie_form = true;
	bc.skeleton_swap_at = get_time() + BC_TRANSFORM_ANIM_SECONDS;

	player.set_trigger("bc_transform");
	player.remove_disable_movement_input_reason(BC_TRANSFORM_LOCK_REASON);
	player.add_disable_movement_input_reason(BC_TRANSFORM_LOCK_REASON);

	if Game.is_server() {
		sfx := SFX.default_sfx_desc();
		sfx.entity_to_follow = player.entity.id;
		sfx.volume = 0.5;
		rr_play_sfx(BC_SFX_TRANSFORM, sfx);

		// Layer Charlie's scream on top of the poof so the transform feels
		// monstrous, not just smoky. Delayed slightly to land on the visible
		// scream beat in the transform anim.
		scream := SFX.default_sfx_desc();
		scream.entity_to_follow = player.entity.id;
		scream.volume = 0.3;
		scream.delay = BC_SFX_TRANSFORM_SCREAM_DELAY;
		scream.range_multiplier = 0.3;
		rr_play_sfx(BC_SFX_TRANSFORM_SCREAM, scream);
	}
}

rr_bc_start_revert :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if !bc.is_big_charlie_form return;

	bc.is_big_charlie_form = false;
	if bc.bc_form_speed_active && player.baseline_movement_speed_saved {
		player.agent.movement_speed = player.baseline_movement_speed;
		bc.bc_form_speed_active = false;
	}

	player.set_trigger("bc_revert");
	player.add_disable_movement_input_reason(BC_TRANSFORM_LOCK_REASON);

	rr_bc_swap_to_player(player);
	bc.skeleton_swap_at = get_time() + BC_TRANSFORM_ANIM_SECONDS;

	if Game.is_server() {
		sfx := SFX.default_sfx_desc();
		sfx.entity_to_follow = player.entity.id;
		sfx.volume = 0.4;
		rr_play_sfx(BC_SFX_TRANSFORM_BACK, sfx);
	}
}

// =============================================================================
// Mass Birth
// =============================================================================

// Counts alive non-BC players who haven't been infected yet. The Mass Birth
// goal is "infect everyone" — when this hits 0 (and at least one real victim
// is in the infected list), the checklist completes.
rr_bc_remaining_to_infect :: proc(bc_player: Player, bc: Big_Charlie_Module) -> int {
	if bc_player == null || bc == null return 0;
	remaining := 0;
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p == bc_player continue;
		if p.player_state != Player_State.ALIVE continue;

		already := false;
		for j: 0..bc.infected_player_ids.count-1 {
			if bc.infected_player_ids[j] == p.entity.id {
				already = true;
				break;
			}
		}
		if !already remaining += 1;
	}
	return remaining;
}

rr_bc_can_mass_birth :: proc(bc_player: Player, bc: Big_Charlie_Module) -> bool {
	if bc == null return false;
	if bc_player == null return false;
	if bc.planted_nugget_total < BC_CHECKLIST_NUGGETS return false;
	if bc.infected_player_ids.count == 0 return false;
	if rr_bc_remaining_to_infect(bc_player, bc) > 0 return false;
	return true;
}

rr_bc_spawn_mini_charlie_visual :: proc(victim: Player) {
	if victim == null return;
	if victim.bc_mini_charlie_creature_entity != null && #alive(victim.bc_mini_charlie_creature_entity) return;

	mini := Scene.create_entity();
	mini.set_parent(victim.entity, false);
	mini.set_local_position(v2.{0, 0});
	mini.set_local_scale(BC_MASS_BIRTH_MINI_SCALE);
	mini_spine := mini.add_component(Spine_Animator);
	mini_spine.awaken();
	if mini_spine.instance != null {
		mini_spine.instance.set_skeleton(get_asset(Spine_Asset, BC_CREATURE_RIG));
		mini_spine.instance.set_skin("BigCharlie_Base");
		mini_spine.instance.refresh_skins();
		mini_spine.instance.set_animation("Run", true, 0);
		rr_apply_shadow_mask(mini_spine.instance);
	}
	victim.bc_mini_charlie_creature_entity = mini;
}

rr_bc_start_mass_birth :: proc(player: Player) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if bc.mass_birth_active return;
	if !rr_bc_can_mass_birth(player, bc) return;

	bc.mass_birth_active = true;
	bc.mass_birth_started_at = get_time();
	bc.mass_birth_sync_at = 0.0;

	// Charlie stays planted at her birthing spot — the cinematic camera locks
	// onto her for everyone, so she must not be able to walk during it. Mirrors
	// the lily deathbraid pattern (LILY_DEATHBRAID_REASON freezes Lily too).
	player.add_freeze_reason(BC_MASS_BIRTH_LOCK_REASON);

	rr_bc_creature_trigger(player, "bellow");

	// Collect unique chasers and assign each one a stable angle on the inner
	// ring around Big Charlie. Re-infections stack in infected_player_ids so we
	// de-dupe here. NOTE: at this stage victims keep their HUMAN appearance —
	// they stampede in as themselves and only transform into mini Big Charlies
	// when they personally reach the chant ring (see rr_bc_update_mass_birth).
	mini_players: [..]Player;
	for i: 0..bc.infected_player_ids.count-1 {
		victim := get_player_by_entity_id(bc.infected_player_ids[i]);
		if victim == null continue;
		if victim.player_state != Player_State.ALIVE continue;
		if victim.bc_is_mini_charlie continue;

		seen := false;
		for k: 0..mini_players.count-1 {
			if mini_players[k] == victim { seen = true; break; }
		}
		if seen continue;
		mini_players.append(victim);
	}
	mini_count := mini_players.count;
	for i: 0..mini_count-1 {
		victim := mini_players[i];
		angle := (i.(float) / max(mini_count, 1).(float)) * 2.0 * PI;
		// bc_is_mini_charlie marks this victim as a chaser slot in the
		// stampede update; the visual / invisibility swap is deferred until
		// arrival so they appear as humans during the run-in.
		victim.bc_is_mini_charlie = true;
		victim.bc_mini_chant_angle = angle;
		victim.bc_mini_chanting = false;
		victim.entity.set_local_position(victim.entity.world_position);
		victim.add_disable_movement_input_reason(BC_MASS_BIRTH_LOCK_REASON);
	}

	// Defensive: any alive non-Charlie who somehow isn't infected (race conditions,
	// late joiners) dies on the spot — the cinematic only shows the gathered horde.
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if !#alive(p.entity) continue;
		if p == player continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.bc_is_mini_charlie continue;
		p.kill_with_killer(player.entity.id);
	}

	// Every owned nugget gets a slot on the outer ring. The actual target_pos is
	// recomputed every frame in rr_bc_update_mass_birth so it tracks Big Charlie.
	live_nuggets: [..]BC_Lil_Nugget;
	for i: 0..bc.nugget_entities.count-1 {
		ne := bc.nugget_entities[i];
		if ne == null || !#alive(ne) continue;
		n := ne.get_component(BC_Lil_Nugget);
		if n == null continue;
		live_nuggets.append(n);
	}
	nugget_count := live_nuggets.count;
	for i: 0..nugget_count-1 {
		n := live_nuggets[i];
		n.is_stampeding = true;
		n.is_incubating = false;
		n.chanting = false;
		n.chant_angle = (i.(float) / max(nugget_count, 1).(float)) * 2.0 * PI;
		n.stampede_target_pos = player.entity.world_position
			+ v2.{cos(n.chant_angle), sin(n.chant_angle)} * BC_MASS_BIRTH_NUGGET_RADIUS;
	}

	// Big Charlie's mass-birth scream — anchored to her so the SFX replicates
	// to every client (non-positional bellows don't propagate). Volume cranked
	// + extended range so the cinematic crowd hears it from anywhere on the map.
	if Game.is_server() {
		desc := SFX.default_sfx_desc();
		desc.entity_to_follow = player.entity.id;
		desc.volume = 1.0;
		desc.range_multiplier = 50.0;
		rr_play_sfx(BC_SFX_MASS_BIRTH_BELLOW, desc);

		// Hand off to gamemanager: freeze game state into ANIM_BC_MASS_BIRTH and
		// queue the win cinematic + endgame.
		rr_bc_trigger_endgame_cinematic(player);
	}
}

// Per-frame: minis + nuggets converge on their assigned circle slots around
// Big Charlie; once arrived, both switch to a looping chant animation.
rr_bc_update_mass_birth :: proc(player: Player, dt: float) {
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if !bc.mass_birth_active return;

	now := get_time();
	if now < bc.mass_birth_started_at + BC_MASS_BIRTH_STAMPEDE_DELAY return;

	bc_pos := player.entity.world_position;

	// Track which mini IDs we've already moved this frame so re-infections
	// (duplicate entries in infected_player_ids) don't double-step the same victim.
	stepped: [..]u64;
	for i: 0..bc.infected_player_ids.count-1 {
		chaser := get_player_by_entity_id(bc.infected_player_ids[i]);
		if chaser == null continue;
		if chaser.player_state != Player_State.ALIVE continue;
		if !chaser.bc_is_mini_charlie continue;

		dup := false;
		for k: 0..stepped.count-1 {
			if stepped[k] == chaser.entity.id { dup = true; break; }
		}
		if dup continue;
		stepped.append(chaser.entity.id);

		// Fire the staggered follow-up scream once its scheduled time hits.
		// Server-only — bc_mini_second_scream_at is server-stamped at arrival
		// and replicates to clients only as a flag; the actual SFX play is
		// kicked off here so engine-side delay limits can't drop it.
		if Game.is_server() && chaser.bc_mini_second_scream_at > 0.0 && get_time() >= chaser.bc_mini_second_scream_at {
			scream2 := SFX.default_sfx_desc();
			scream2.entity_to_follow = chaser.entity.id;
			scream2.volume = 0.7;
			scream2.speed = 1.5;
			scream2.speed_perturb = 0.15;
			scream2.volume_perturb = 0.1;
			scream2.range_multiplier = 4.0;
			rr_play_sfx(BC_SFX_TRANSFORM_SCREAM, scream2);
			chaser.bc_mini_second_scream_at = 0.0;
		}

		slot_pos := bc_pos + v2.{cos(chaser.bc_mini_chant_angle), sin(chaser.bc_mini_chant_angle)} * BC_MASS_BIRTH_CHANT_RADIUS;
		cur := chaser.entity.world_position;
		diff := slot_pos - cur;
		dist := length(diff);

		if dist <= 0.15 {
			chaser.agent.velocity = v2.{0, 0};
			face_diff := bc_pos - cur;
			chaser.set_facing_right(face_diff.x > 0.0);
			if !chaser.bc_mini_chanting {
				chaser.bc_mini_chanting = true;
				// Transform on arrival: spawn the mini-Charlie visual, hide the
				// human rig + nameplate, and play a higher-pitched poof so each
				// arrival has its own punctuation. Earlier in the cinematic the
				// chaser stampedes in as their human self — the transform is
				// deliberately deferred to this beat.
				rr_bc_spawn_mini_charlie_visual(chaser);
				chaser.add_invisibility_reason(BC_INVIS_REASON);
				chaser.add_name_invisibility_reason(BC_NAME_INVIS_REASON);
				if Game.is_server() {
					sfx := SFX.default_sfx_desc();
					sfx.entity_to_follow = chaser.entity.id;
					sfx.volume = 0.4;
					sfx.speed = 1.5; // pitched-up — small charlies have small voices
					rr_play_sfx(BC_SFX_TRANSFORM, sfx);

					// Pitched-up scream #1 plays right after the poof (engine
					// handles the short delay). Scream #2 is server-scheduled
					// for a later beat via bc_mini_second_scream_at — long
					// engine-side delays don't replicate reliably, so we fire
					// the follow-up explicitly from rr_bc_update_mass_birth.
					rng: u64 = rng_root_seed();
					first_delay := BC_SFX_TRANSFORM_SCREAM_DELAY + rng_range_float(ref rng, 0.0, 0.4);

					scream := SFX.default_sfx_desc();
					scream.entity_to_follow = chaser.entity.id;
					scream.volume = 0.7;
					scream.speed = 1.5;
					scream.speed_perturb = 0.15;
					scream.volume_perturb = 0.1;
					scream.delay = first_delay;
					scream.range_multiplier = 4.0;
					rr_play_sfx(BC_SFX_TRANSFORM_SCREAM, scream);

					chaser.bc_mini_second_scream_at = get_time() + first_delay + rng_range_float(ref rng, 1.0, 4.0);
				}
				mini := chaser.bc_mini_charlie_creature_entity;
				if mini != null && #alive(mini) {
					ms := mini.get_component(Spine_Animator);
					if ms != null && ms.instance != null {
						ms.instance.set_animation("Stampede_Roar", true, 0);
					}
				}
			}
			continue;
		}

		// Route around walls via the navmesh: ask the agent to path to the slot,
		// then step toward the returned next waypoint. We can't let the agent
		// drive itself because chasers have movement input disabled for the
		// cinematic — set_path_target gives us the routed waypoint, we integrate.
		path := chaser.agent.set_path_target(slot_pos, BC_MASS_BIRTH_STAMPEDE_SPEED);
		step_target := slot_pos;
		if path.success {
			step_target = path.next_point;
		}
		step_diff := step_target - cur;
		step_dist := length(step_diff);
		if step_dist <= 0.001 continue;
		dir := normalize(step_diff);
		chaser.set_facing_right((bc_pos - cur).x > 0.0);
		chaser.agent.velocity = dir * BC_MASS_BIRTH_STAMPEDE_SPEED;
		step := dir * BC_MASS_BIRTH_STAMPEDE_SPEED * dt;
		if length(step) > step_dist step = step_diff;
		new_pos := cur + step;
		nav_pt: v2;
		tri: s64;
		if try_find_closest_point_on_navmesh(new_pos, ref nav_pt, ref tri) {
			chaser.entity.set_local_position(nav_pt);
		} else {
			chaser.entity.set_local_position(new_pos);
		}
	}

	// Nugget swarm: each nugget tracks its outer-ring slot relative to BC.
	for i: 0..bc.nugget_entities.count-1 {
		ne := bc.nugget_entities[i];
		if ne == null || !#alive(ne) continue;
		n := ne.get_component(BC_Lil_Nugget);
		if n == null continue;
		if !n.is_stampeding continue;
		n.stampede_target_pos = bc_pos + v2.{cos(n.chant_angle), sin(n.chant_angle)} * BC_MASS_BIRTH_NUGGET_RADIUS;
	}

	// Stamp the synced-transform timestamp once every chaser has arrived at
	// the chant ring. This drives the camera screenshake on every client (each
	// client reads the synced timestamp off the BC module).
	if Game.is_server() && bc.mass_birth_sync_at == 0.0 {
		any_chaser := false;
		all_arrived := true;
		seen: [..]u64;
		for i: 0..bc.infected_player_ids.count-1 {
			id := bc.infected_player_ids[i];
			dup := false;
			for k: 0..seen.count-1 {
				if seen[k] == id { dup = true; break; }
			}
			if dup continue;
			seen.append(id);

			chaser := get_player_by_entity_id(id);
			if chaser == null continue;
			if chaser.player_state != Player_State.ALIVE continue;
			if !chaser.bc_is_mini_charlie continue;
			any_chaser = true;
			if !chaser.bc_mini_chanting {
				all_arrived = false;
				break;
			}
		}
		if any_chaser && all_arrived {
			bc.mass_birth_sync_at = now;
		}
	}
}

// =============================================================================
// Per-frame update (entry point from Player.ao_update)
// =============================================================================

rr_bc_update :: proc(player: Player, dt: float) {
	if player == null return;
	if player.player_role != Player_Role.BIG_CHARLIE return;

	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;

	now := get_time();

	// Dead Big Charlie reverts.
	if player.player_state != Player_State.ALIVE {
		if bc.is_big_charlie_form || bc.creature_visible {
			rr_bc_force_revert(player);
		}
		return;
	}

	// Mass Birth continues after the round enters its endgame cinematic state.
	if bc.mass_birth_active {
		rr_bc_update_mass_birth(player, dt);
	}

	// Meetings: defer visual revert until teleport
	if game_state != Game_State.INGAME {
		return;
	}

	// Delayed skeleton swap (after the 1s transform animation plays).
	if bc.skeleton_swap_at > 0.0 && now >= bc.skeleton_swap_at {
		bc.skeleton_swap_at = 0.0;
		player.remove_disable_movement_input_reason(BC_TRANSFORM_LOCK_REASON);
		if bc.is_big_charlie_form && !bc.creature_visible {
			rr_bc_swap_to_creature(player);
			// Apply Big Charlie speed bonus on the same frame the visuals swap.
			if !bc.bc_form_speed_active {
				bc.bc_form_speed_active = true;
				if player.baseline_movement_speed_saved {
					player.agent.movement_speed = player.baseline_movement_speed * BC_BIG_CHARLIE_SPEED_MULT;
				}
			}
		}
	}

	// Creature locomotion. Facing flip comes from the parent player entity
	// (it auto-flips via set_facing_right), so the creature inherits direction.
	if bc.creature_visible && bc.creature_animator != null && bc.creature_animator.instance != null {
		if bc.creature_animator.instance.state_machine != null {
			is_moving := length(player.agent.velocity) > 0.5;
			bc.creature_animator.instance.state_machine.set_bool("is_moving", is_moving);
		}
	}

	// Growth Stages: scale up monster form per infection (re-applied every frame
	// because server->client sync resets local transform).
	if bc.creature_visible {
		rr_bc_apply_growth_visuals(bc, now);
	}

	// Shockwave windup: fire knockback once the anim reaches its impact frame.
	if bc.shockwave_pending && now >= bc.shockwave_fire_at {
		bc.shockwave_pending = false;
		rr_bc_apply_shockwave(player);
	}

	// Camera per-frame override (server sync resets follow_player).
	if bc.camera_active && player.is_local() {
		player.camera.follow_player = false;
		player.camera.size = player.camera_default_size;
		nugget := rr_bc_get_active_camera_nugget(player);
		if nugget != null && #alive(nugget) {
			player.camera.position = nugget.world_position;
		} else {
			rr_bc_exit_camera(player);
		}
	}


	// Cleanup any infected players who died — drop their follower & infection
	// slot. Mirrors rr_bc_on_player_died: each slot represents one consumed
	// planted Nugget, so the checklist tally decrements alongside.
	i := 0;
	while i < bc.infected_player_ids.count {
		infected_id := bc.infected_player_ids[i];
		if infected_id >= BC_DUMMY_INFECTION_ID_BASE {
			i += 1;
			continue;
		}
		vp := get_player_by_entity_id(infected_id);
		if vp == null || vp.player_state != Player_State.ALIVE {
			if vp != null rr_bc_clear_infected_player(vp);
			bc.infected_player_ids.unordered_remove_by_index(i);
			bc.planted_nugget_total -= 1;
			if bc.planted_nugget_total < 0 bc.planted_nugget_total = 0;
		} else {
			i += 1;
		}
	}

	// Cleanup destroyed cocoons from tracking list.
	j := 0;
	while j < bc.cocoon_entities.count {
		e := bc.cocoon_entities[j];
		if e == null || !#alive(e) {
			bc.cocoon_entities.unordered_remove_by_index(j);
		} else {
			j += 1;
		}
	}
}

// =============================================================================
// HUD draws (called from player.ao_late_update)
// =============================================================================

rr_bc_draw_camera_ui :: proc(player: Player, dt: float) {
	if player == null return;
	if !player.is_local_or_server() return;
	if player.player_role != Player_Role.BIG_CHARLIE return;

	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;
	if !bc.camera_active return;

	nugget := rr_bc_get_active_camera_nugget(player);
	if nugget == null || !#alive(nugget) {
		rr_bc_exit_camera(player);
		return;
	}

	// Camera-feel post processing — only meaningful for the local viewer's screen.
	if player.is_local() {
		vig: Post_Processing.Vignette_Config;
		vig.radius   = 0.95;
		vig.softness = 0.30;
		Post_Processing.vignette(vig);

		ca: Post_Processing.Chromatic_Aberration_Config;
		ca.channel_offsets = v3.{-0.0025, 0.0, 0.0025};
		ca.focal_point     = v2.{0.5, 0.5};
		Post_Processing.chromatic_aberration(ca);

		grain: Post_Processing.Film_Grain_Config;
		grain.strength    = 0.18;
		grain.noise_scale = 1.6;
		Post_Processing.film_grain(grain);
	}

	// Full-screen camera viewfinder overlay — sits above the world but
	// below the ability buttons (default layer) and HUD so the player's
	// regular UI stays unobstructed.
	overlay_tex := get_asset(Texture_Asset, "sprites/ew_UI.png");
	UI.push_layer(-10);
	UI.quad(UI.get_screen_rect(), overlay_tex, v4.{1, 1, 1, 1});
	UI.pop_layer();

	count := rr_bc_count_camera_nuggets(bc);
	safe := UI.get_safe_screen_rect();

	UI.push_layer(9990);
	defer UI.pop_layer();

	// Header label
	ts := UI.default_text_settings();
	ts.size = 28;
	ts.color = v4.{1.0, 0.8, 0.8, 1.0};
	ts.halign = .CENTER;
	ts.valign = .TOP;
	ts.do_outline = true;
	ts.outline_thickness = 2;
	ts.outline_color = v4.{0, 0, 0, 1};

	label_rect := safe.top_center_rect().grow(22, 220, 22, 220).offset(0, -120);
	UI.text(label_rect, ts, "Nugget Camera %/%", {bc.camera_nugget_index + 1, count});

	info_ts := UI.default_text_settings();
	info_ts.size = 18;
	info_ts.color = v4.{1.0, 0.7, 0.7, 0.9};
	info_ts.halign = .CENTER;
	info_ts.valign = .TOP;
	info_ts.do_outline = true;
	info_ts.outline_thickness = 2;
	info_ts.outline_color = v4.{0, 0, 0, 1};
	UI.text(label_rect.offset(0, -32), info_ts, "You are frozen and vulnerable");

	bs := UI.default_button_settings();
	bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png");
	btn_ts := UI.default_text_settings();
	btn_ts.size = 26;
	btn_ts.do_outline = true;
	btn_ts.outline_thickness = 2;
	btn_ts.outline_color = v4.{0, 0, 0, 1};

	control_area := safe.bottom_center_rect().grow(34, 320, 34, 320).offset(0, 86);
	exit_rect := control_area.subrect(0.34, 0.0, 0.66, 1.0);
	prev_rect := control_area.subrect(0.0,  0.0, 0.30, 1.0);
	next_rect := control_area.subrect(0.70, 0.0, 1.0,  1.0);

	if count > 1 {
		UI.push_id("bc_cam_prev", {});
		if UI.button(prev_rect, bs, btn_ts, "< Prev").clicked {
			rr_bc_camera_prev(player);
		}
		UI.pop_id();

		UI.push_id("bc_cam_next", {});
		if UI.button(next_rect, bs, btn_ts, "Next >").clicked {
			rr_bc_camera_next(player);
		}
		UI.pop_id();
	}

	UI.push_id("bc_cam_exit", {});
	if UI.button(exit_rect, bs, btn_ts, "Exit").clicked {
		rr_bc_exit_camera(player);
	}
	UI.pop_id();
}

// Side checklist — drawn from draw_bc_role_hud in player.csl.
rr_bc_draw_checklist_panel :: proc(player: Player) {
	if player == null return;
	if !player.is_local_or_server() return;
	if player.player_role != Player_Role.BIG_CHARLIE return;

	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return;

	UI.push_layer(1600);
	defer UI.pop_layer();

	_pushed_scale := rr_push_mobile_ui_scale(player);
	defer rr_pop_mobile_ui_scale(_pushed_scale);

	safe := UI.get_safe_screen_rect();
	PANEL_W :: 320.0;
	ROW_H :: 32.0;
	LIST_PAD :: 10.0;
	DROPDOWN_SLICE_PX :: 16.0;

	planted := bc.planted_nugget_total;
	infected := bc.infected_player_ids.count;
	remaining_to_infect := rr_bc_remaining_to_infect(player, bc);
	mass_birth_ready := rr_bc_can_mass_birth(player, bc);

	row_count := 4; // Form + nugget row + infect row + status row
	list_h := (row_count.(float)) * ROW_H + (LIST_PAD * 2.0);

	header_rect := rr_draw_task_list_header(safe, false, player);
	if !player.task_list_open return;

	list_rect := header_rect.bottom_left_rect().grow(0.0, PANEL_W, list_h, 0.0);
	list_bg := get_asset(Texture_Asset, "ui/task list/task_list_dropdown_area.png");
	checkbox := get_asset(Texture_Asset, "ui/task list/checkbox.png");
	checkbox_filled := get_asset(Texture_Asset, "ui/task list/checkbox_filled.png");

	rr_ui_draw_nine_slice_panel(list_rect, list_bg, DROPDOWN_SLICE_PX);

	base_ts := UI.default_text_settings();
	base_ts.size = 20;
	base_ts.halign = .LEFT;
	base_ts.valign = .CENTER;
	base_ts.do_outline = true;
	base_ts.outline_thickness = 3;
	base_ts.outline_color = v4.{0, 0, 0, 1};

	list_content := list_rect.inset(LIST_PAD, LIST_PAD, LIST_PAD, LIST_PAD);

	// Row 1: form
	{
		entry_rect := list_content.cut_top(ROW_H);
		entry_content := entry_rect.inset(0.0, 6.0, 0.0, 6.0);
		entry_content.cut_left(24.0);
		ts := base_ts;
		if bc.is_big_charlie_form {
			ts.color = v4.{1.0, 0.4, 0.3, 1.0};
			UI.text(entry_content.inset(0, 4, 0, 4), ts, "BIG CHARLIE");
		} else {
			ts.color = v4.{0.9, 0.9, 0.9, 1.0};
			UI.text(entry_content.inset(0, 4, 0, 4), ts, "Schleem");
		}
	}
	// Row 2: planted nuggets
	{
		entry_rect := list_content.cut_top(ROW_H);
		entry_content := entry_rect.inset(0.0, 6.0, 0.0, 6.0);
		checkbox_slot := entry_content.cut_left(24.0);
		checkbox_rect := checkbox_slot.center_rect().grow(9.0);
		done := planted >= BC_CHECKLIST_NUGGETS;
		if done {
			UI.quad(checkbox_rect.fit_aspect(checkbox_filled.get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
		} else {
			UI.quad(checkbox_rect.fit_aspect(checkbox.get_aspect()), checkbox, v4.{1, 1, 1, 1});
		}
		ts := base_ts;
		ts.color = done ? v4.{0.6, 1.0, 0.4, 1.0} : v4.{1, 1, 1, 1};
		UI.text(entry_content.inset(0, 4, 0, 4), ts,
			format_string("Plant Nuggets: %/%", .{min(planted, BC_CHECKLIST_NUGGETS), BC_CHECKLIST_NUGGETS}));
	}
	// Row 3: infections
	{
		entry_rect := list_content.cut_top(ROW_H);
		entry_content := entry_rect.inset(0.0, 6.0, 0.0, 6.0);
		checkbox_slot := entry_content.cut_left(24.0);
		checkbox_rect := checkbox_slot.center_rect().grow(9.0);
		done := remaining_to_infect == 0 && infected > 0;
		if done {
			UI.quad(checkbox_rect.fit_aspect(checkbox_filled.get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
		} else {
			UI.quad(checkbox_rect.fit_aspect(checkbox.get_aspect()), checkbox, v4.{1, 1, 1, 1});
		}
		ts := base_ts;
		ts.color = done ? v4.{0.6, 1.0, 0.4, 1.0} : v4.{1, 1, 1, 1};
		UI.text(entry_content.inset(0, 4, 0, 4), ts,
			format_string("Infect everyone (% left)", .{remaining_to_infect}));
	}
	// Row 4: status callout
	{
		entry_rect := list_content.cut_top(ROW_H);
		entry_content := entry_rect.inset(0.0, 6.0, 0.0, 6.0);
		entry_content.cut_left(24.0);
		ts := base_ts;
		ts.size = 18;
		if mass_birth_ready {
			ts.color = v4.{0.6, 1.0, 0.4, 1.0};
			UI.text(entry_content.inset(0, 4, 0, 4), ts, "MASS BIRTH READY");
		} else if bc.camera_active {
			ts.color = v4.{1.0, 0.85, 0.45, 1.0};
			UI.text(entry_content.inset(0, 4, 0, 4), ts, "Scouting: ACTIVE");
		} else {
			cocoons := bc.cocoon_entities.count;
			ts.color = v4.{0.9, 0.9, 0.9, 1.0};
			UI.text(entry_content.inset(0, 4, 0, 4), ts, format_string("Active Cocoons: %", .{cocoons}));
		}
	}
}

// =============================================================================
// Endgame cinematic hookup (server-side trigger)
// =============================================================================
//
// Defined in gamemanager.csl: calls back into game-state machinery to freeze
// the round, play a cinematic, and end with anarchist victory.
// Implemented here as a forward-declared call to keep BC self-contained.
rr_bc_trigger_endgame_cinematic :: proc(player: Player) {
	start_bc_mass_birth_cinematic(player);
}

// =============================================================================
// Abilities
// =============================================================================

// --- Transform: toggle Schleem <-> Big Charlie ---
BC_Transform_Ability :: class : Ability_Base {
	NAME :: "Transform";

	on_init :: proc(instance: BC_Transform_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.BIG_CHARLIE return false;

		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return false;
		if bc.skeleton_swap_at > 0.0 return false;
		if bc.camera_active return false;
		if bc.mass_birth_active return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if !params.clicked return;
		if !params.can_use return;
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return;
		if bc.is_big_charlie_form {
			rr_bc_start_revert(player);
		} else {
			rr_bc_start_transform(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc != null && bc.is_big_charlie_form {
			icon = get_asset(Texture_Asset, "sprites/icons/transform_good.png");
			draw_ability_name_label(rect, "Schleem");
		} else {
			icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png");
			draw_ability_name_label(rect, NAME);
		}
	}
}

// --- Birth Nugget (Big Charlie form only) ---
BC_Birth_Nugget_Ability :: class : Ability_Base {
	NAME :: "Birth Nugget";

	on_init :: proc(instance: BC_Birth_Nugget_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/big_charlie/Lil_Nugget.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.BIG_CHARLIE return false;
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return false;
		if !bc.is_big_charlie_form return false;
		if bc.skeleton_swap_at > 0.0 return false;
		if bc.camera_active return false;
		if bc.mass_birth_active return false;
		if rr_bc_count_planted_nuggets(bc) >= BC_NUGGET_MAX_PLANTED return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if !params.clicked return;
		if !params.can_use return;
		spawned := rr_bc_spawn_planted_nugget(player, player.entity.world_position);
		if spawned != null {
			current_cooldown = BC_NUGGET_COOLDOWN;
			rr_bc_creature_trigger(player, "birth");

			if Game.is_server() {
				sfx := SFX.default_sfx_desc();
				sfx.entity_to_follow = player.entity.id;
				sfx.volume = 0.4;
				rr_play_sfx(BC_SFX_NUGGET_BIRTH, sfx);
			}
		}
	}

	on_draw_button :: method(rect: Rect) {
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc != null {
			ts := UI.default_text_settings();
			ts.size = 18;
			ts.halign = .RIGHT;
			ts.valign = .BOTTOM;
			UI.text(rect.inset(5), ts, "%/%", {rr_bc_count_planted_nuggets(bc), BC_NUGGET_MAX_PLANTED});
		}
		draw_ability_name_label(rect, NAME);
	}
}

// --- Nugget Scouting Network (Schleem only — toggle camera) ---
BC_Scouting_Ability :: class : Ability_Base {
	NAME :: "Scouting";

	on_init :: proc(instance: BC_Scouting_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/big_charlie/Lil_Nugget.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.BIG_CHARLIE return false;
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return false;
		if bc.is_big_charlie_form return false;
		if bc.mass_birth_active return false;
		if bc.camera_active return true;       // can always toggle off
		return rr_bc_count_camera_nuggets(bc) > 0;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if !params.clicked return;
		if !params.can_use return;
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return;
		if bc.camera_active {
			rr_bc_exit_camera(player);
		} else {
			rr_bc_enter_camera(player);
		}
	}

	on_draw_button :: method(rect: Rect) {
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc != null && bc.camera_active {
			draw_ability_name_label(rect, "Exit Camera");
		} else {
			draw_ability_name_label(rect, NAME);
		}
	}
}

// --- Flesh Cocoon (Big Charlie form only) ---
BC_Flesh_Cocoon_Ability :: class : Ability_Base {
	NAME :: "Flesh Cocoon";

	on_init :: proc(instance: BC_Flesh_Cocoon_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/big_charlie/abilities/Slough_Icon.png");
		// [ART] Replace icon when a dedicated cocoon icon ships.
	}

	get_target :: proc(instance: BC_Flesh_Cocoon_Ability, p: Player) -> Player {
		finder := make_finder(Player, p.entity.world_position, BC_COCOON_RANGE);
		for target: component_iterator(Player) {
			if target == null continue;
			if !#alive(target.entity) continue;
			if target == p continue;
			if target.player_state != Player_State.ALIVE continue;
			if target.bc_cocooned continue;
			if target.bc_is_mini_charlie continue;
			finder.check(target, target.entity.world_position);
		}
		return finder.closest;
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.BIG_CHARLIE return false;
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return false;
		if !bc.is_big_charlie_form return false;
		if bc.camera_active return false;
		if bc.mass_birth_active return false;
		return get_target(this, player) != null;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if !params.clicked return;
		if !params.can_use return;
		target := get_target(this, player);
		if target == null return;

		created := rr_bc_create_cocoon(player, target);
		if created == null return;
		player.set_facing_right(target.entity.world_position.x > player.entity.world_position.x);
		rr_bc_creature_trigger(player, "cocoon");
		current_cooldown = BC_COCOON_COOLDOWN;
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, NAME);
	}
}

// --- Shockwave (Big Charlie form only — Absorb_Expansion knockback) ---
BC_Shockwave_Ability :: class : Ability_Base {
	NAME :: "Shockwave";

	on_init :: proc(instance: BC_Shockwave_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/big_charlie/abilities/Marrow_Icon.png");
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.BIG_CHARLIE return false;
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return false;
		if !bc.is_big_charlie_form return false;
		if bc.skeleton_swap_at > 0.0 return false;
		if bc.camera_active return false;
		if bc.mass_birth_active return false;
		return true;
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if !params.clicked return;
		if !params.can_use return;

		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return;

		rr_bc_creature_trigger(player, "shockwave");
		bc.shockwave_pending = true;
		bc.shockwave_fire_at = get_time() + BC_SHOCKWAVE_WINDUP;
		current_cooldown = BC_SHOCKWAVE_COOLDOWN;

		if Game.is_server() {
			sfx := SFX.default_sfx_desc();
			sfx.entity_to_follow = player.entity.id;
			sfx.volume = 0.25;
			sfx.delay = BC_SHOCKWAVE_WINDUP; // fire SFX with the impact, not the windup
			rr_play_sfx(BC_SFX_SHOCKWAVE, sfx);
		}
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, NAME);
	}
}

// Walk the navmesh from `origin` toward `target` in fixed steps; return true if
// the straight line stays on (or near) the navmesh the whole way — i.e. no
// wall sits between the two points. The shockwave uses this so the blast
// stops at obstacles like a Hitman mine's expansion ring. Engine has no
// raycast API; nearest-point-on-navmesh sampling is the closest analogue.
rr_bc_line_clear_on_navmesh :: proc(origin: v2, target: v2) -> bool {
	diff := target - origin;
	dist := length(diff);
	if dist <= 0.001 return true;
	dir := diff / dist;

	steps := (dist / BC_SHOCKWAVE_STEP).(int);
	if steps < 1 steps = 1;

	tol_sq := BC_SHOCKWAVE_OFFNAV_TOL * BC_SHOCKWAVE_OFFNAV_TOL;
	for i: 1..steps {
		t := i.(float) * BC_SHOCKWAVE_STEP;
		if t > dist t = dist;
		sample := origin + dir * t;

		nav_pt: v2;
		tri: s64;
		if !try_find_closest_point_on_navmesh(sample, ref nav_pt, ref tri) {
			return false;
		}
		off := sample - nav_pt;
		if length_squared(off) > tol_sq return false;
	}
	return true;
}

// Active fling phase — re-applies the outward velocity every frame so the
// victim travels until they hit a wall (or the timeout expires), like a
// Hitman mine fling. This is what makes the shockwave throw players to the
// edge of the room rather than a few studs from Charlie. On collision /
// timeout, hands off to BC_Shockwave_Stun for the post-knockback stun.
BC_Shockwave_Knockback :: class : Component {
	active: bool;
	end_time: float;
	dir: v2;
	last_pos: v2;
	stuck_frames: int;

	arm :: proc(using this: BC_Shockwave_Knockback, seconds: float, direction: v2, speed: float) {
		if seconds <= 0.0 seconds = 0.1;
		end_time = get_time() + seconds;
		active = true;
		dir = direction;
		last_pos = entity.world_position;
		stuck_frames = 0;

		p := entity.get_component(Player);
		if p != null {
			p.add_disable_movement_input_reason(BC_SHOCKWAVE_FLING_REASON);
			// Reuse the merged-rig fly-forward state (originally added for the
			// Hitman mine fling) so the victim looks airborne instead of
			// jogging while being pushed.
			p.set_facing_right(dir.x > 0);
			p.set_trigger("hitman_fly_forward");
			p.agent.velocity = dir * speed;
		}
	}

	ao_update :: proc(using this: BC_Shockwave_Knockback, dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(BC_SHOCKWAVE_FLING_REASON);
			active = false;
			return;
		}

		// Keep pushing every frame until something stops us.
		p.agent.velocity = dir * BC_SHOCKWAVE_FLING_SPEED;

		pos := entity.world_position;
		moved := length(pos - last_pos);
		last_pos = pos;

		if moved < 0.01 {
			stuck_frames += 1;
		} else {
			stuck_frames = 0;
		}

		collided := stuck_frames >= 3;
		if collided || get_time() >= end_time {
			p.remove_disable_movement_input_reason(BC_SHOCKWAVE_FLING_REASON);
			// Hard-landing pose, then settles into the broken-leg stun loop.
			p.set_trigger("hitman_collide_midair_land");

			stun := entity.get_component(BC_Shockwave_Stun);
			if stun == null {
				stun = entity.add_component(BC_Shockwave_Stun);
			}
			stun.arm(BC_SHOCKWAVE_STUN_SECS);

			active = false;
		}
	}
}

// Post-fling stun — keeps movement input disabled for BC_SHOCKWAVE_STUN_SECS
// after the victim lands. Modelled on Hitman_Mine_Stun.
BC_Shockwave_Stun :: class : Component {
	active: bool;
	end_time: float;

	arm :: proc(using this: BC_Shockwave_Stun, seconds: float) {
		if seconds <= 0.0 seconds = 0.1;
		end_time = get_time() + seconds;
		active = true;

		p := entity.get_component(Player);
		if p != null {
			p.add_disable_movement_input_reason(BC_SHOCKWAVE_STUN_REASON);
			// Fall_To_Ground_Hurt one-shot — anim length (3.4s) matches the
			// stun window, so the player gets up at the same moment movement
			// input re-enables.
			p.set_trigger("bc_shockwave_stun");
		}
	}

	ao_update :: proc(using this: BC_Shockwave_Stun, dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null {
			active = false;
			return;
		}

		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE {
			p.remove_disable_movement_input_reason(BC_SHOCKWAVE_STUN_REASON);
			p.set_trigger("RESET");
			active = false;
			return;
		}

		if get_time() >= end_time {
			p.remove_disable_movement_input_reason(BC_SHOCKWAVE_STUN_REASON);
			p.set_trigger("RESET");
			active = false;
			return;
		}
	}
}

// Knock every alive non-cocooned non-self player within BC_SHOCKWAVE_RANGE
// outward from Charlie's position. The wave is blocked by walls (sampled on
// the navmesh, like a Hitman mine ring), so players safely behind cover are
// untouched. Each victim gets a sustained outward fling until they hit a
// wall, followed by a 2s stun.
rr_bc_apply_shockwave :: proc(player: Player) {
	origin := player.entity.world_position;
	range_sq := BC_SHOCKWAVE_RANGE * BC_SHOCKWAVE_RANGE;
	for p: component_iterator(Player) {
		if p == null continue;
		if p == player continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.bc_cocooned continue;
		if p.entity == null || !#alive(p.entity) continue;

		d := p.entity.world_position - origin;
		dist_sq := length_squared(d);
		if dist_sq > range_sq continue;

		// Wall-stop: the wave only reaches players with an unobstructed path.
		if !rr_bc_line_clear_on_navmesh(origin, p.entity.world_position) continue;

		dir := d;
		if length_squared(dir) < 0.001 {
			dir = v2.{1, 0};
		} else {
			dir = normalize(dir);
		}

		knock := p.entity.get_component(BC_Shockwave_Knockback);
		if knock == null {
			knock = p.entity.add_component(BC_Shockwave_Knockback);
		}
		knock.arm(BC_SHOCKWAVE_FLING_SECS, dir, BC_SHOCKWAVE_FLING_SPEED);
	}
}

// --- Mass Birth (Big Charlie form, checklist complete) ---
BC_Mass_Birth_Ability :: class : Ability_Base {
	NAME :: "Mass Birth";

	on_init :: proc(instance: BC_Mass_Birth_Ability) {
		instance.icon = get_asset(Texture_Asset, "sprites/icons/big_charlie/abilities/Stampede_Icon.png");
		// [ART] Replace icon when a dedicated Mass Birth icon ships.
	}

	can_use :: method() -> bool {
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if player.player_role != Player_Role.BIG_CHARLIE return false;
		bc := player.entity.get_component(Big_Charlie_Module);
		if bc == null return false;
		if !bc.is_big_charlie_form return false;
		if bc.camera_active return false;
		if bc.mass_birth_active return false;
		return rr_bc_can_mass_birth(player, bc);
	}

	on_update :: method(params: ref Ability_Update_Params) {
		if !params.clicked return;
		if !params.can_use return;
		rr_bc_start_mass_birth(player);
	}

	on_draw_button :: method(rect: Rect) {
		draw_ability_name_label(rect, NAME);
	}
}

// =============================================================================
// Ability layout (called from player.ao_late_update via player_role switch)
// =============================================================================

rr_bc_draw_abilities :: proc(player: Player, idx: int) -> int {
	abilityIndex := idx;
	bc := player.entity.get_component(Big_Charlie_Module);
	if bc == null return abilityIndex;

	// Always: Transform
	draw_ability_button(player, BC_Transform_Ability, abilityIndex);
	abilityIndex += 1;

	if bc.is_big_charlie_form {
		// Big Charlie form: Birth Nugget, Flesh Cocoon, Mass Birth (gated)
		draw_ability_button(player, BC_Birth_Nugget_Ability, abilityIndex);
		abilityIndex += 1;

		draw_ability_button(player, BC_Flesh_Cocoon_Ability, abilityIndex);
		abilityIndex += 1;

		draw_ability_button(player, BC_Shockwave_Ability, abilityIndex);
		abilityIndex += 1;

		if rr_bc_can_mass_birth(player, bc) {
			draw_ability_button(player, BC_Mass_Birth_Ability, abilityIndex);
			abilityIndex += 1;
		}
	} else {
		// Schleem form: Scouting
		draw_ability_button(player, BC_Scouting_Ability, abilityIndex);
		abilityIndex += 1;
	}

	return abilityIndex;
}
