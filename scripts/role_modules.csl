import "core:ao"

// Role-specific data modules. Added to a player entity at round start,
// removed at round end.  Only the player with that role gets the component.

// --- Sheriff ---
Sheriff_Module :: class : Component {
	gun_ammo: int;
}

// --- Doctor ---
Doctor_Module :: class : Component {
	resurrects_used: int;
}

// --- Transformers: The Mech / Guardian ---
Mech_Module :: class : Component {
	is_mech_form: bool;
	is_apex: bool;
	apex_used: bool;
	apex_lost: bool;
	apex_transform_locked: bool; // movement locked while the APEX transform anim plays
	// The avatar keeps its pre-APEX mech skin until apex_reveal_at, then swaps to the APEX
	// skin at the transform's morph climax. apex_skin_revealed gates that one-time swap so
	// the skin doesn't snap in on frame one and spoil the morph illusion.
	apex_skin_revealed: bool;
	apex_reveal_at: float;

	power_cores: int;
	// Magnet Cores — looted from magnetised (trapped) living players via the Magnet Cannon.
	// A distinct currency from the four task components; spent on the higher tiers of the
	// escalating upgrade cost ladder (see rr_mech_upgrade_cost).
	magnet_cores: int;
	power_cells: int;
	circuits: int;
	schematics: int;
	gears: int;

	helmet_trap_unlocked: bool;
	ram_charge_unlocked: bool;
	magnet_cannon_unlocked: bool;
	missile_barrage_unlocked: bool;
	wreckage_warp_unlocked: bool;
	endgame_unlocked: bool;
	// When End Game became available. Gated by a short arm delay so the Mech can't
	// fumble straight from Showdown-mashing into the round-ending barrage.
	endgame_unlocked_at: float;
	conversion_used: bool;

	// Smashing a task panel re-arms this; the Smash prompt is gated until get_time() passes it.
	// 0 (the default) reads as "ready" since get_time() is always >= 0 (matches showdown_cooldown_until).
	smash_cooldown_until: float;

	carried_player_id: u64;
	carried_corpse_id: u64;

	workbench_ui_open: bool;

	// While > 0 (and not yet elapsed) the follow camera is held zoomed out to the aim size,
	// so the Magnet Cannon's wide framing lingers briefly AFTER the last rod is fired instead
	// of snapping back the instant placement ends. Synced so client + server agree on the size.
	magnet_cam_hold_until: float;

	// Missile Barrage free-cam placement. While targeting, the avatar is frozen in place
	// (movement-input lock) and ONLY the camera roams — missile_aim_center is the detached
	// camera/cursor position panned by the player's movement input; markers are the chosen
	// ground strike points. missile_cam_hold_until keeps the camera parked over the strike
	// zone for a beat AFTER firing so the player watches the rockets land (mirrors the magnet
	// cam hold). Synced so client + server agree.
	missile_aim_active: bool;
	missile_aim_center: v2;
	// The Mech's body is pinned here every frame while placing missiles (it must hold position; the
	// pan input only roams the camera). Captured at aim start; see Mech_Missile_Aim_Controller.
	missile_aim_anchor: v2;
	missile_markers: [6]v2;
	missile_markers_placed: int;
	missile_cam_hold_until: float;

	showdown_active: bool;
	showdown_opponent_id: u64;
	showdown_mashes: int;
	showdown_ends_at: float;
	// Lost a Showdown while NOT in APEX form: the Mech is downed (frozen on the Lose_Death last
	// frame, kit hidden) awaiting a Minion revive. If a living Minion revives it (once per game) it
	// gets back up; otherwise — no living Minion or the revive already spent — it actually dies, with
	// the kill firing at showdown_death_at (killer = the Guardian who won, like a lost-Showdown death).
	showdown_downed: bool;
	showdown_death_at: float;
	showdown_death_killer_id: u64;
	minion_revive_used: bool;

	// End Game cinematic: the Mech floats up and barrages the whole map before the round ends.
	endgame_active: bool;
	endgame_started_at: float;
	endgame_next_wave_at: float;
	// Incremented per barrage wave; seeds the deterministic scatter of the saturation
	// (carpet-bombing) missiles so client and server rain them on the same spots.
	endgame_wave_index: int;
	// Time of the most recent finale missile impact — drives the brief, soft post-FX punch on
	// the cinematic (post-FX only fires on impacts, not continuously).
	endgame_last_impact_at: float;
	// Stable world position captured at cutscene start so the cinematic camera doesn't bob
	// with the frozen player's per-frame position jitter (the avatar is parented to it).
	endgame_anchor: v2;

	creature_entity: Entity;
	creature_animator: Spine_Animator;
	creature_visible: bool;
	last_anim: string;
	anim_lock_until: float;
	transform_anim_ends_at: float;
	// Carry pose lives on overlay track 1 (locomotion stays on track 0). overlay_clear_at
	// is when the grab anim ends; last_overlay_anim is track 1's current anim (empty = cleared).
	overlay_clear_at: float;
	last_overlay_anim: string;

	// Bitmask of bolt-on parts currently reflected on the avatar (helmet=1, ram=2,
	// magnet=4, missile=8). Lets rr_mech_update notice a freshly-built part and play the
	// part-reveal flourish, and keeps the avatar's skins in sync across all clients.
	shown_upgrade_sig: int;
	// Part-build reveal cinematic: the mech is slid back off the workbench, frozen, and the
	// camera punches in behind letterbox bars while the forging slam plays. Synced so the
	// freeze/slide-back is authoritative; camera + bars are layered on locally.
	part_reveal_active: bool;
	part_reveal_started_at: float;
	part_reveal_ends_at: float;
}

Guardian_Module :: class : Component {
	is_guardian_form: bool;
	carried_player_id: u64;
	showdown_active: bool;
	showdown_opponent_id: u64;
	showdown_mashes: int;
	showdown_ends_at: float;
	// Stable clash midpoint captured once at Showdown start. The camera/crowd frame this
	// instead of the live fighter positions, which jitter from server reconciliation.
	showdown_anchor: v2;
	// Losing a Showdown is fatal: the kill fires at the end of the lose-death anim.
	// 0 when no death is pending; killer is showdown_death_killer_id (the APEX Mech).
	showdown_death_at: float;
	showdown_death_killer_id: u64;
	// Long cooldown gating repeat Showdowns (re-armed each time one resolves). Auto-reset once
	// when the Mech awakens APEX so the Guardian always gets a fresh shot at the titan form.
	// 0 (the default) reads as "ready" since get_time() is always >= 0.
	showdown_cooldown_until: float;

	creature_entity: Entity;
	creature_animator: Spine_Animator;
	creature_visible: bool;
	last_anim: string;
	anim_lock_until: float;
	transform_anim_ends_at: float;
	overlay_clear_at: float;
	last_overlay_anim: string;
}

Mech_Minion_Effect :: class : Effect_Base {
	converted_by_mech_id: u64;
	original_role: Player_Role;
	original_type: Player_Type;
	saved_skins: [..]string;
	saved_color: Color_Replace_Color;
	power_cells: int;
	circuits: int;
	schematics: int;
	gears: int;

	// Smash cooldown for a converted Minion (same role as Mech_Module.smash_cooldown_until).
	smash_cooldown_until: float;

	// Conversion timestamp — drives the synced one-shot "You are now a Minion" warning
	// banner (rr_mech_draw_minion_warning), shown for a fixed window from the server stamp.
	warning_started_at: float;

	effect_start :: method() {
		if player == null return;
		player.player_type = Player_Type.TRAITOR;
		// The half-cyborg disguise is applied PER-VIEWER (only traitors see it) by
		// rr_mech_apply_minion_disguise_for_viewer on each local client — NOT here, where it
		// would replicate to everyone. See player.csl ao_update.
		// Show the custom full-screen warning instead of a plain notification.
		warning_started_at = get_time();
	}

	effect_update :: method(dt: float) {
		if player == null { remove_effect(false); return; }
		if !#alive(player.entity) { remove_effect(false); return; }
		if game_state != Game_State.INGAME { remove_effect(false); return; }
		if player.player_state != Player_State.ALIVE { remove_effect(false); return; }
		if converted_by_mech_id == 0 { remove_effect(false); return; }
		player.player_type = Player_Type.TRAITOR;
	}

	effect_end :: method(interrupt: bool) {
		if player == null return;
		if !#alive(player.entity) return;
		player.player_type = original_type;
		player.player_role = original_role;
		if player.animator != null && player.animator.instance != null {
			// Strip the per-viewer disguise skin and rebuild the original cosmetics. Local clients'
			// per-viewer pass also clears it once the player stops being a minion, but rebuild here
			// too so the restore is authoritative the instant the effect ends.
			player.animator.instance.disable_all_skins();
			if saved_skins.count > 0 {
				for i: 0..saved_skins.count-1 {
					if saved_skins[i] == MECH_MINION_SKIN continue;
					player.animator.instance.enable_skin(saved_skins[i]);
				}
			} else {
				player.animator.instance.enable_skin("base/crewchsia");
			}
			player.animator.instance.refresh_skins();
			player.animator.instance.set_color_replace_color(saved_color);
		}
		converted_by_mech_id = 0;
	}
}

// --- Coroner ---
Coroner_Module :: class : Component {
	dna_vials: [..]u64;
}

// --- Prankster ---
Prankster_Module :: class : Component {
	prank_count: int;
	fake_meetings_called: int;
	fake_meeting_target_id: u64;
	jester_unlocked_time: float;
}

// --- Werewolf ---
Werewolf_Module :: class : Component {
	kills: int;
	is_wolf_form: bool;
	transform_ends_at: float;
	speed_boost_active: bool;
	speed_original: float;
}

// --- Hitman ---
Hitman_Kill_Style :: enum {
	NONE;
	NECK_SNAP;
	SNIPER;
}

Hitman_Module :: class : Component {
	kills: int;
	contract_target_id: u64;
	kill_cooldown_adjust_seconds: float;
	last_kill_style: Hitman_Kill_Style;
}

// --- Pirate ---
Pirate_Module :: class : Component {
	treasure: int;
	black_flag_unlocked: bool;
	powder_keg_unlocked: bool;
}

// --- Mimicer ---
Mimicer_Module :: class : Component {
	kills: int;
	stolen_faces: int;
	last_kill_was_disguised: bool;

	// Transform (Schleem ↔ Monster)
	is_monster_form: bool;
	creature_entity: Entity;
	creature_animator: Spine_Animator;
	creature_visible: bool;
	skeleton_swap_at: float;

	// Prowl
	is_prowling: bool;
	prowl_speed_active: bool;
	prowl_speed_original: float;
	prowl_near_wall: bool;

	// Monster form speed bonus
	monster_speed_active: bool;

	// Void Tether speed bonus
	tether_speed_active: bool;

	// Disguise (from Void Pillars)
	is_disguised: bool;
	disguise_ends_at: float;
	disguise_target_id: u64;
	disguise_target_name: string;
	disguise_saved_skins: [..]string;
	disguise_saved_color: Color_Replace_Color;

	// Spew cast lock
	spew_lock_until: float;

	// Void Lunge
	void_lunge_active: bool;
	void_lunge_start_pos: v2;
	void_lunge_target_pos: v2;
	void_lunge_start_time: float;
	void_lunge_duration: float;

	// Void Pillars
	void_pillars: [..]Entity;
	teleport_cooldown: float;
	teleport_pillar_index: int;

	// Unleash: Dark Flame Pillars
	unleash_used: bool;
	is_ultimate_form: bool;
	unleash_placing: bool;
	unleash_pillars_placed: int;
	unleash_pillars: [..]Entity;
	unleash_pillars_consumed: int;
	unleash_active: bool;
	unleash_camera_saved_size: float;

	// Client-side prowl invisibility for non-traitors
	ao_on_state_sync :: method() {
		local_player, ok := Game.get_local_player();
		if !ok return;

		player := entity.get_component(Player);
		if player == null return;

		if is_prowling && prowl_near_wall && local_player.player_type != Player_Type.TRAITOR {
			player.add_invisibility_reason(MIMICER_PROWL_INVIS_REASON);
			player.add_name_invisibility_reason(MIMICER_PROWL_INVIS_REASON);
			if creature_visible && creature_entity != null {
				creature_entity.set_local_enabled(false);
			}
		} else {
			player.remove_invisibility_reason(MIMICER_PROWL_INVIS_REASON);
			player.remove_name_invisibility_reason(MIMICER_PROWL_INVIS_REASON);
			if creature_visible && creature_entity != null {
				creature_entity.set_local_enabled(true);
			}
		}
	}
}

// --- Big Charlie ---
// Solo Anarchist role. Win condition: plant 5 Lil' Nuggets + infect 3 unique
// players, then fire Mass Birth.
Big_Charlie_Module :: class : Component {
	// Form (Schleem <-> Big Charlie)
	is_big_charlie_form: bool;
	creature_entity: Entity;
	creature_animator: Spine_Animator;
	creature_visible: bool;
	skeleton_swap_at: float;
	bc_form_speed_active: bool;

	// Cached flag for whether the creature rig shows the full-size Stampede skin
	// (applied at BC_GROWTH_PULSE_THRESHOLD infections), to avoid re-skinning every frame.
	creature_full_size_skin: bool;

	// Nugget tracking (planted + follower nuggets share this list).
	// Cap of BC_NUGGET_MAX_PLANTED applies only to planted (non-follower) entries.
	nugget_entities: [..]Entity;
	planted_nugget_total: int;       // running total for the win-condition checklist

	// Cocoon tracking (entities owned by this Big Charlie)
	cocoon_entities: [..]Entity;

	// Infections — unique entity IDs of players who have hatched a Lil' Nugget.
	infected_player_ids: [..]u64;

	// Camera (Nugget Scouting Network) — Schleem form only
	camera_active: bool;
	camera_nugget_index: int;
	camera_original_size: float;
	camera_lockout_until: float;

	// Mass Birth (game-ending ability)
	mass_birth_active: bool;
	mass_birth_started_at: float;
	// Server stamps this once all infected victims reach the chant ring and become mini Big
	// Charlies — drives the synced transform poof + screenshake. 0.0 means "not yet".
	mass_birth_sync_at: float;

	// Shockwave (Absorb_Expansion knockback) — fires after a windup delay so the
	// knockback lands when the visible blast actually happens in the anim.
	shockwave_pending: bool;
	shockwave_fire_at: float;
}

// --- Lily ---
Lily_Module :: class : Component {
	kills: int;

	// Transform (Schleem ↔ Lily)
	is_lily_form: bool;
	creature_entity: Entity;
	creature_animator: Spine_Animator;
	creature_visible: bool;
	skeleton_swap_at: float;

	// Lily form speed bonus
	lily_speed_active: bool;

	// String system
	strung_player_ids: [..]u64;

	// Thread Count passive speed
	thread_speed_active: bool;
	thread_speed_multiplier: float;

	// Hair Tree (Plant Tree — one-time use, permanent base)
	hair_tree_entity: Entity;
	hair_tree_planted: bool;
	tree_teleport_cooldown: float;

	// Carried stolen items (for tree requests)
	carrying_eyes: bool;
	carrying_legs: bool;
	stolen_eyes_from_id: u64;  // player entity ID eyes were stolen from
	stolen_legs_from_id: u64;  // player entity ID legs were stolen from

	// Tree growth buffs (applied per fulfilled request)
	tree_speed_buff_active: bool;
	tree_speed_multiplier: float;
	tree_cd_multiplier: float;  // cooldown multiplier (0.9 = 10% reduction)

	// Pull (base ability — drag strung to tree)
	pull_active: bool;
	pull_target_index: int;
	pull_progress: float;
	pull_tree_entity: Entity;
	pull_snapping: bool;

	// Tea Party (single target, 3 cups)
	tea_table_entity: Entity;
	tea_table_animator: Spine_Animator;
	tea_tray_entity: Entity;
	tea_cup_entities: [..]Entity;
	tea_party_active: bool;
	tea_party_ends_at: float;
	tea_party_start_time: float;
	tea_party_target_id: u64;
	tea_party_cup_effects: [3]int;   // shuffled effect per cup index: 0=caffeine, 1=poison, 2=live
	tea_party_choice_deadline: float;
	tea_party_victim_chose: bool;
	tea_party_chosen_cup: int;       // which cup was picked (1, 2, or 3)
	tea_party_settle_at: float;      // when cup arrives in front of player
	tea_party_drinking: bool;        // drink anim playing
	tea_party_drink_done_at: float;  // when drink anim finishes → apply effect
	tea_party_drink_done: bool;
	tea_party_camera_saved_size: float;
	tea_party_camera_saved_follow: bool;

	// Mind Control
	mind_control_active: bool;
	mind_control_ends_at: float;
	mind_control_target_id: u64;
	mind_control_picking: bool; // UIK player picker is open
	mind_control_unlock_cd_applied: bool; // initial 20s CD applied on first unlock this round

	// String Trap
	dragging_live_player_id: u64; // entity ID of trapped player being dragged

	// Remote-body abilities (spider / eye machine): Lily's entity teleports to the remote
	// body for voice/SFX; her detached rig stays at `ability_origin_pos` as a ghost marker.
	ability_origin_pos: v2;
	ability_body_detached: bool;
	ability_creature_was_visible: bool;

	// Spider (Leg Steal)
	spider_active: bool;
	spider_entity: Entity;
	spider_animator: Spine_Animator;
	spider_has_legs: bool;          // spider successfully stole legs
	spider_victim_id: u64;          // entity ID of player whose legs were stolen
	spider_return_deadline: float;  // time by which spider must reach player
	spider_attack_cooldown: float;  // prevent spam chomps
	spider_leg_sprite: Entity;      // dismembered leg shown on spider while carrying
	spider_move_sfx_id: u64;        // looping spider scurry SFX handle

	// Above-head carried item icon entities (shadow-maskable)
	carried_eye_icon: Entity;
	carried_leg_icon: Entity;

	// Eye Steal (Machine)
	eye_machine_active: bool;
	eye_machine_pos: v2;              // current world position of the machine/camera
	eye_machine_tube_entity: Entity;      // suction tube front spine (visible to all)
	eye_machine_tube_back_entity: Entity; // back layer, parented to front (renders behind players)
	eye_machine_aoe_entity: Entity;   // AOE reticle (visible to Lily only)
	eye_machine_camera_saved_size: float;
	eye_machine_camera_saved_follow: bool;
	eye_machine_has_target: bool;     // a valid player is in range
	eye_machine_lowering: bool;       // zoom-in + suction phase
	eye_machine_lower_done_at: float; // when suction finishes → steal
	eye_machine_lower_start_at: float; // when attack started (for lerps)
	eye_machine_linger_until: float;  // tube fly-up + camera return phase
	eye_machine_linger_start: float;  // when linger started
	eye_machine_victim_pos: v2;       // victim world pos (camera target)
	eye_machine_victim_id: u64;       // frozen victim entity ID
	eye_machine_suction_sfx_id: u64;  // looping suction SFX handle
	eye_machine_propeller_sfx_id: u64; // looping propeller SFX handle (tube idle)

	// Eye Pickup (dropped after machine steals eyes)
	eye_pickup_entity: Entity;
	eye_pickup_animator: Spine_Animator;
	eye_pickup_active: bool;
	eye_pickup_victim_id: u64;        // whose eyes these are

	// Leg Pickup (dropped after tea party poison or spider steal)
	leg_pickup_entity: Entity;
	leg_pickup_active: bool;
	leg_pickup_victim_id: u64;        // whose legs these are

	// Deathbraid
	deathbraid_active: bool;
	deathbraid_tree_entity: Entity;
	deathbraid_mouth_entity: Entity;
	deathbraid_ground_entity: Entity;
	deathbraid_vortex_entity: Entity;
	deathbraid_tentacle_entities: [..]Entity;
	deathbraid_start_time: float;
	deathbraid_camera_saved_size: float;
	deathbraid_pull_order: [..]u64;     // entity IDs sorted by distance, for staggered pull
	deathbraid_last_kill_time: float;   // last kill timestamp — drives zoom punch + shake burst
	deathbraid_vortex_sfx_id: u64;      // looping vortex suction SFX handle
	deathbraid_roar_played: bool;       // has roar fired this cinematic
	deathbraid_vortex_sfx_started: bool; // has vortex loop fired this cinematic
	deathbraid_finale_ends_at: float;   // when post-kill cinematic hold ends (0 = not started)


	// Web Sense passive arrow tracking
	web_sense_arrow_targets: [..]u64;

	// Client-side invisibility for mind control & spider (hide from non-traitors)
	ao_on_state_sync :: method() {
		local_player, ok := Game.get_local_player();
		if !ok return;

		player := entity.get_component(Player);
		if player == null return;

		is_using_ability := mind_control_active || spider_active || eye_machine_active;

		if is_using_ability && local_player.player_type != Player_Type.TRAITOR {
			player.add_invisibility_reason(LILY_ABILITY_INVIS_REASON);
			player.add_name_invisibility_reason(LILY_ABILITY_INVIS_REASON);
			// Hide creature entity from non-traitors during abilities (mind control uses lily form)
			if creature_entity != null && #alive(creature_entity) {
				creature_entity.set_local_enabled(false);
			}
		} else {
			player.remove_invisibility_reason(LILY_ABILITY_INVIS_REASON);
			player.remove_name_invisibility_reason(LILY_ABILITY_INVIS_REASON);
			// Restore creature visibility if it should be showing
			if creature_visible && creature_entity != null && #alive(creature_entity) {
				creature_entity.set_local_enabled(true);
			}
		}
	}
}
