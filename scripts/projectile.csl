import "core:ao"

RR_Projectile :: class : Component {
    sprite: Sprite_Renderer @ao_serialize;
    velocity: v2;
    lifetime: float;
    damage: int;

    spawn_time: float;
    owner: Entity;
    hit_radius: float;
    lobby_minigame: bool;

    triangle_hint: s64;

    ao_start :: proc(using this: RR_Projectile) {
        spawn_time = get_time();
        if hit_radius == 0 {
            hit_radius = 0.5;
        }
    }

    ao_update :: proc(using this: RR_Projectile, dt: float) {
        // Set rotation to face the direction of travel
        direction_angle := to_degrees(atan2(velocity.y, velocity.x));
        sprite.entity.set_local_rotation(direction_angle);

        time_alive := get_time() - spawn_time;

        // Move RR_Projectile
        entity.add_local_position(velocity * dt);

        destroy_self := false;

		// Lobby projectiles must NEVER fall through to the real-damage branch.
		if lobby_minigame && (game_state != Game_State.LOBBY || !lobby_minigame_active) {
			destroy_self = true;
		}

		// A decoy is a world target, not a player and never a false-fire victim.
        if !lobby_minigame && !destroy_self && #alive(owner) {
            from := entity.world_position - velocity * dt;
            body := rr_ninja_projectile_body(owner.get_component(Player), from, entity.world_position, hit_radius, false);
            if rr_ninja_hit_decoy_ray(owner.get_component(Player), from, normalize(velocity), length(velocity) * dt + hit_radius, hit_radius, body) {
                destroy_self = true;
            }
        }
        // Check for player collisions
        if !destroy_self {
            for player: component_iterator(Player) {
                if player.player_state == Player_State.DEAD continue;
                if #alive(owner) && owner == player.entity continue;

				owner_player: Player = null;
				if #alive(owner) {
					owner_player = owner.get_component(Player);
				}

				if lobby_minigame {
					mg := rr_get_lobby_minigame_effect(player);
					if mg == null continue;
					if get_time() < mg.respawn_until continue;
				if in_range(player.entity.world_position - entity.world_position, hit_radius) {
						rr_lobby_minigame_handle_projectile_hit(owner_player, player, entity.world_position);
						destroy_self = true;
						break;
					}
					continue;
				}

				if rr_ninja_smoke_protects(player) continue;
                // Resolve the Guardian's carry shield before any team-dependent filtering.
				// Every held target must produce the same collision outcome or the shot is
				// still an allegiance oracle for roles beyond Sheriff/Hunter.
				if in_range(player.entity.world_position - entity.world_position, hit_radius) && rr_guardian_is_carrying(player) {
					rr_mech_play_sfx_at("minigame/shield_block_390d4b.wav", player.entity.world_position, 0.4);
					rr_mech_spawn_flash(entity.world_position, 0.7, v4.{0.45, 1.0, 0.55, 0.75}, 0.22);
					destroy_self = true;
					break;
				}

				// Traitors shouldn't be able to projectile-kill other traitors — except a Mech Minion
				// when the killable-minions toggle is on (it then dies like a normal player, same reward).
				if owner_player != null && owner_player.player_type == Player_Type.TRAITOR && player.player_type == Player_Type.TRAITOR {
					if !(MECH_MINIONS_KILLABLE && rr_mech_is_minion_active(player)) {
						continue;
					}
				}

                if in_range(player.entity.world_position - entity.world_position, hit_radius) {
					killer_id: u64 = 0;
					if #alive(owner) {
						killer_id = owner.id;
					}

					if player.player_role == Player_Role.GUARDIAN {
						if owner_player != null {
							owner_player.Notify("TARGET IS GUARDIAN");
						}
						// Shield deflect: dedicated bounce SFX + golden ring flash at impact.
						rr_mech_play_sfx_at("minigame/shield_block_390d4b.wav", player.entity.world_position, 0.4);
						rr_mech_spawn_flash(entity.world_position, 0.7, v4.{1.0, 0.95, 0.45, 0.75}, 0.22);
						rr_mech_spawn_flash(entity.world_position, 0.4, v4.{1.0, 1.0, 0.85, 0.9}, 0.16);
						destroy_self = true;
						break;
					}

                    // False Fire: Sheriff shooting a civilian kills BOTH the victim and the Sheriff.
                    // Also applies to a Hacker who has stolen the Sheriff's gun.
                    if owner_player != null {
                        is_sheriff := owner_player.player_type == Player_Type.CIVILIAN && owner_player.player_role == Player_Role.SHERIFF;
                        has_stolen_gun := rr_hacker_has_stolen_civilian_role(owner_player, Player_Role.SHERIFF);
                        target_is_civilian := player.player_type == Player_Type.CIVILIAN;

                        if (is_sheriff || has_stolen_gun) && target_is_civilian {
                            owner_player.Notify("False Fire! You shot an innocent!");
                            player.kill_with_killer(killer_id);
                            owner_player.kill_with_killer(killer_id);
                            destroy_self = true;
                            {
                                sfx := SFX.default_sfx_desc();
                                sfx.set_position(player.entity.world_position);
                                sfx.volume = 0.75;
                                sfx.volume_perturb = 0.1;
                                sfx.speed_perturb = 0.2;
                                sfx.volume *= 0.25;
                                sfx.volume_perturb *= 0.25;
                                rr_play_sfx("sfx/other_death.wav", sfx);
                            }
                            break;
                        }
                    }

                    player.kill_with_killer(killer_id);
                    destroy_self = true;
                    {
                        sfx := SFX.default_sfx_desc();
                        sfx.set_position(player.entity.world_position);
                        sfx.volume = 0.75;
                        sfx.volume_perturb = 0.1;
                        sfx.speed_perturb = 0.2;
						// Explicit death SFX (traitor_kill_death.wav reserved for knife/neck-snap kills).
						// Global SFX mix: everything at 25% volume.
						sfx.volume *= 0.25;
						sfx.volume_perturb *= 0.25;
                        rr_play_sfx("sfx/other_death.wav", sfx);
                    }
                    break;
                }
            }
        }

		// Check for GGG nest collisions (Sheriff shoots nest → reveals on minimap)
		if !destroy_self {
			owner_player: Player = null;
			if #alive(owner) {
				owner_player = owner.get_component(Player);
			}
			if owner_player != null && owner_player.player_role == Player_Role.SHERIFF {
				for nest: component_iterator(GGG_Nest) {
					if nest == null continue;
					if nest.destroyed continue;
					if nest.entity == null || !#alive(nest.entity) continue;
					if in_range(nest.entity.world_position - entity.world_position, hit_radius + 1.0) {
						nest.sheriff_revealed = true;
						nest.sheriff_reveal_ends_at = get_time() + GGG_NEST_SHERIFF_REVEAL_SECONDS;
						for pi: 0..players.elements.count-1 {
							p := players.elements[pi];
							if p == null continue;
							if p.player_state == Player_State.DEAD continue;
							p.Notify("A nest has been revealed on the minimap!");
						}
						destroy_self = true;
						break;
					}
				}
			}
		}

        if time_alive >= lifetime {
            destroy_self = true;
        }

        if !destroy_self {
            point: v2;
            if try_find_closest_point_on_navmesh(entity.world_position, ref point, ref triangle_hint) {
                if !in_range(point - entity.world_position, 0.01) {
                    destroy_self = true;
                }
            }
        }

        if destroy_self {
            hit_effect := get_asset(Prefab_Asset, "prefabs/hit_effect.prefab");
            effect := Scene.instantiate(hit_effect);
            rng := rng_seed(entity.id);
            effect.get_first_child().set_local_rotation(rng_range_float(ref rng, 0, 360));
            effect.set_local_position(entity.world_position);
            effect.queue_for_destruction(0.5);
            entity.destroy();
        }
    }
}
