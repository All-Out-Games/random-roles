rr_mech_play_sfx_at :: proc(path: string, pos: v2, volume: float) {
	sfx := SFX.default_sfx_desc();
	sfx.set_position(pos);
	sfx.volume = volume;
	sfx.volume_perturb = 0.06;
	sfx.speed_perturb = 0.06;
	rr_play_sfx(path, sfx);
}

rr_mech_anim_duration :: proc(anim_name: string) -> float {
	if anim_name == "009SG/APEX_transform" return 3.3;
	if anim_name == "009SG/APEX_transform_grounded" return 4.1;
	if anim_name == "009SG/Smash_Task" return MECH_SMASH_ANIM_LOOP;
	if anim_name == "009SG/Loot_Body" return 1.05;
	if anim_name == "009SG/Kill" return 0.9;
	if anim_name == "009SG/cm_pick_up" return 0.9;
	if anim_name == "009SG/Throw_Player_AL" return 0.5;
	if anim_name == "009SG/Magnet_Cannon_Shoot" return 0.7;
	if anim_name == "009SG/Missile_Fire" return 0.75;
	if anim_name == "009SG/Transform_Truck_In" return 0.45;
	if anim_name == "009SG/Transform_Truck_out" return 0.38;
	if anim_name == "009SG/Convert" return 1.18;
	if anim_name == "009SG/Showdown_Start" return 1.6;
	if anim_name == "009SG/Showdown_Win" return 0.85;
	if anim_name == "009SG/Showdown_Lose_Death" return 1.1;
	if anim_name == "009SG/Showdown_Lose_Survive" return 1.15;
	if anim_name == "009SG/Warp_Appear" return 0.6;
	return 0.45;
}

// =====================================================================
// Mech / Guardian avatar (009SG rig) animation — driven by a State_Machine
// rather than raw set_animation. A state machine only re-issues an animation
// on an actual STATE CHANGE, so it can't thrash Spine's mixingFrom chain.
// (The old approach drove two tracks with per-frame set_animation; a flicker
//  or rapid re-issue grew the mixingFrom chain without bound and overflowed
//  the stack in _spAnimationState_applyMixingFrom.)
//   - Main layer    (track 0): full-body locomotion + one-shot actions.
//   - Overlay layer (track 1): arm-layer (_AL) gestures + carry hold; idles on
//     a cleared track so it never doubles the body anim.
// =====================================================================
rr_mech_setup_avatar_state_machine :: proc(anim: Spine_Animator) {
	if anim == null || anim.instance == null return;
	sm := State_Machine.create();
	rr_mech_build_avatar_main_layer(sm);
	rr_mech_build_avatar_overlay_layer(sm);
	anim.instance.set_state_machine(sm, true);
}

rr_mech_build_avatar_main_layer :: proc(sm: State_Machine) {
	layer := sm.create_layer("main", 0);

	is_moving   := sm.create_variable("is_moving", .BOOL);
	is_apex     := sm.create_variable("is_apex", .BOOL);
	is_guardian := sm.create_variable("is_guardian", .BOOL);
	in_showdown := sm.create_variable("in_showdown", .BOOL);
	downed      := sm.create_variable("downed", .BOOL);

	// Locomotion (loop). "009SG/Idle" is shared by the mech + guardian forms; apex flies.
	// Durations of 0 are pulled from the rig so they never drift if an anim is re-exported.
	idle_state    := layer.create_state("009SG/Idle", true, 0.0);
	run_mech      := layer.create_state("009SG/Run_mech", true, 0.0);
	run_guardian  := layer.create_state("009SG/Run_guardian", true, 0.0);
	fly_idle      := layer.create_state("009SG/Fly_Idle", true, 0.0);
	fly_run       := layer.create_state("009SG/Fly_Run", true, 0.0);
	showdown_loop := layer.create_state("009SG/Showdown_Loop", true, 0.0);
	death_freeze  := layer.create_state("009SG/Showdown_Lose_Death", false, 0.0);
	layer.set_initial_state(idle_state);

	// idle -> run / fly / showdown-loop
	i2rm := layer.create_transition(idle_state, run_mech, false);
	i2rm.create_bool_condition(is_moving, true);
	i2rm.create_bool_condition(is_apex, false);
	i2rm.create_bool_condition(is_guardian, false);

	i2rg := layer.create_transition(idle_state, run_guardian, false);
	i2rg.create_bool_condition(is_moving, true);
	i2rg.create_bool_condition(is_guardian, true);

	i2fi := layer.create_transition(idle_state, fly_idle, false);
	i2fi.create_bool_condition(is_apex, true);
	i2fi.create_bool_condition(is_moving, false);

	i2fr := layer.create_transition(idle_state, fly_run, false);
	i2fr.create_bool_condition(is_apex, true);
	i2fr.create_bool_condition(is_moving, true);

	i2sd := layer.create_transition(idle_state, showdown_loop, false);
	i2sd.create_bool_condition(in_showdown, true);

	// run / fly -> idle (or between fly states)
	rm2i := layer.create_transition(run_mech, idle_state, false);
	rm2i.create_bool_condition(is_moving, false);
	rg2i := layer.create_transition(run_guardian, idle_state, false);
	rg2i.create_bool_condition(is_moving, false);

	fi2i := layer.create_transition(fly_idle, idle_state, false);
	fi2i.create_bool_condition(is_apex, false);
	fi2fr := layer.create_transition(fly_idle, fly_run, false);
	fi2fr.create_bool_condition(is_moving, true);
	fr2i := layer.create_transition(fly_run, idle_state, false);
	fr2i.create_bool_condition(is_apex, false);
	fr2fi := layer.create_transition(fly_run, fly_idle, false);
	fr2fi.create_bool_condition(is_moving, false);

	// Showdown loop falls back to idle if the clash ends without a resolution anim.
	sd2i := layer.create_transition(showdown_loop, idle_state, false);
	sd2i.create_bool_condition(in_showdown, false);

	// Downed (faked death): freeze on the lose-death pose from ANY state until revived.
	// loop=false holds the final frame; the only exit is downed clearing (revive/cleanup).
	d2f := layer.create_global_transition(death_freeze, false);
	d2f.create_bool_condition(downed, true);
	f2i := layer.create_transition(death_freeze, idle_state, false);
	f2i.create_bool_condition(downed, false);

	// APEX morph returns straight to flight; the showdown intro chains into its loop.
	t_apex := sm.create_variable("t_apex", .TRIGGER);
	apex_state := layer.create_state("009SG/APEX_transform", false, 0.0);
	layer.create_global_transition(apex_state, false).create_trigger_condition(t_apex);
	layer.create_transition(apex_state, fly_idle, true);

	t_showdown_start := sm.create_variable("t_showdown_start", .TRIGGER);
	showdown_start := layer.create_state("009SG/Showdown_Start", false, 0.0);
	layer.create_global_transition(showdown_start, false).create_trigger_condition(t_showdown_start);
	layer.create_transition(showdown_start, showdown_loop, true);

	rr_mech_build_avatar_actions(sm, layer, idle_state);
}

// One state-machine one-shot: a global trigger entry (so it can interrupt anything)
// that returns to idle once the clip completes. idle then re-dispatches to the correct
// locomotion (run/fly) via the bool conditions.
rr_mech_add_avatar_oneshot :: proc(sm: State_Machine, layer: State_Machine_Layer, idle_state: State_Machine_State, anim: string, trig_name: string) {
	trig := sm.create_variable(trig_name, .TRIGGER);
	st := layer.create_state(anim, false, 0.0);
	layer.create_global_transition(st, false).create_trigger_condition(trig);
	layer.create_transition(st, idle_state, true);
}

// One-shot action states for the main layer (track 0).
rr_mech_build_avatar_actions :: proc(sm: State_Machine, layer: State_Machine_Layer, idle_state: State_Machine_State) {
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Transform_Truck_In",    "t_transform_in");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Transform_Truck_out",   "t_transform_out");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Smash_Task",            "t_smash");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Kill",                  "t_kill");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Convert",               "t_convert");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Loot_Body",             "t_loot");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Warp_Appear",           "t_warp");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Magnet_Cannon_Aim",     "t_magnet_aim");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Magnet_Cannon_Shoot",   "t_magnet_shoot");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Missile_Fire",          "t_missile");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Showdown_Win",          "t_showdown_win");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Showdown_Lose_Survive", "t_lose_survive");
	rr_mech_add_avatar_oneshot(sm, layer, idle_state, "009SG/Showdown_Lose_Death",   "t_lose_death");
}

rr_mech_build_avatar_overlay_layer :: proc(sm: State_Machine) {
	layer := sm.create_layer("overlay", 1);

	o_carrying := sm.create_variable("o_carrying", .BOOL);
	o_throw    := sm.create_variable("o_throw", .TRIGGER);
	o_pickup   := sm.create_variable("o_pickup", .TRIGGER);
	o_shoot    := sm.create_variable("o_shoot", .TRIGGER);

	// Cleared track = nothing on the arm layer, so track 0 owns the body unobstructed.
	clear_state := layer.create_state("__CLEAR_TRACK__", true, 0.0);
	carry_state := layer.create_state("009SG/Carry_Player_AL", true, 0.0);
	layer.set_initial_state(clear_state);

	c2carry := layer.create_transition(clear_state, carry_state, false);
	c2carry.create_bool_condition(o_carrying, true);
	carry2c := layer.create_transition(carry_state, clear_state, false);
	carry2c.create_bool_condition(o_carrying, false);

	// One-shot gestures play over the body, then clear (carry re-enters if still holding).
	throw_state := layer.create_state("009SG/Throw_Player_AL", false, 0.0);
	layer.create_global_transition(throw_state, false).create_trigger_condition(o_throw);
	layer.create_transition(throw_state, clear_state, true);

	pickup_state := layer.create_state("009SG/cm_pick_up", false, 0.0);
	layer.create_global_transition(pickup_state, false).create_trigger_condition(o_pickup);
	layer.create_transition(pickup_state, clear_state, true);

	shoot_state := layer.create_state("009SG/Shoot_AL", false, 0.0);
	layer.create_global_transition(shoot_state, false).create_trigger_condition(o_shoot);
	layer.create_transition(shoot_state, clear_state, true);
}

// Maps an avatar animation name to its state-machine drive. Locomotion names
// (Idle/Run_*/Fly_*) and Showdown_Loop are intentionally NOT triggered here —
// they're driven by bools / state chaining in rr_mech_update_avatar_locomotion.
rr_mech_avatar_trigger :: proc(anim: Spine_Animator, anim_name: string) {
	if anim == null || anim.instance == null return;
	sm := anim.instance.state_machine;
	if sm == null return;
	if anim_name == "009SG/Transform_Truck_In"    { sm.set_trigger("t_transform_in"); return; }
	if anim_name == "009SG/Transform_Truck_out"   { sm.set_trigger("t_transform_out"); return; }
	if anim_name == "009SG/Smash_Task"            { sm.set_trigger("t_smash"); return; }
	if anim_name == "009SG/Kill"                  { sm.set_trigger("t_kill"); return; }
	if anim_name == "009SG/Convert"               { sm.set_trigger("t_convert"); return; }
	if anim_name == "009SG/Loot_Body"             { sm.set_trigger("t_loot"); return; }
	if anim_name == "009SG/Warp_Appear"           { sm.set_trigger("t_warp"); return; }
	if anim_name == "009SG/Magnet_Cannon_Aim"     { sm.set_trigger("t_magnet_aim"); return; }
	if anim_name == "009SG/Magnet_Cannon_Shoot"   { sm.set_trigger("t_magnet_shoot"); return; }
	if anim_name == "009SG/Missile_Fire"          { sm.set_trigger("t_missile"); return; }
	if anim_name == "009SG/APEX_transform"        { sm.set_trigger("t_apex"); return; }
	if anim_name == "009SG/Showdown_Start"        { sm.set_trigger("t_showdown_start"); return; }
	if anim_name == "009SG/Showdown_Win"          { sm.set_trigger("t_showdown_win"); return; }
	if anim_name == "009SG/Showdown_Lose_Survive" { sm.set_trigger("t_lose_survive"); return; }
	if anim_name == "009SG/Showdown_Lose_Death"   { sm.set_trigger("t_lose_death"); return; }
}

rr_mech_spawn_flash :: proc(pos: v2, scale: float, color: v4, duration: float, layer := -7) {
	e := Scene.create_entity();
	e.set_local_position(pos);
	e.set_local_scale(v2.{scale, scale});
	sr := e.add_component(Sprite_Renderer);
	// Soft radial gradient reads as a glow burst instead of a flat colored square.
	sr.set_texture(get_asset(Texture_Asset, "sprites/Shapes/shape_circle_gradient.png"));
	sr.color = color;
	// Default -7 sits the glow behind characters; callers that must clear the floor (e.g. the
	// Minion call/delivery FX, which were buried under the ground) pass a positive layer.
	sr.layer = layer.(s32);
	vfx := e.add_component(Mech_Flash_Vfx);
	vfx.start_scale = scale;
	vfx.end_scale = scale * 2.2;
	vfx.color = color;
	vfx.duration = duration;
}

// Expanding hollow ring that ripples outward from a blast/transform — a shockwave. Reuses
// Mech_Flash_Vfx (expand scale + fade alpha) with a ring texture instead of the filled glow.
rr_mech_spawn_shockwave :: proc(pos: v2, start_scale: float, end_scale: float, color: v4, duration: float, layer := -7) {
	e := Scene.create_entity();
	e.set_local_position(pos);
	e.set_local_scale(v2.{start_scale, start_scale});
	sr := e.add_component(Sprite_Renderer);
	sr.set_texture(get_asset(Texture_Asset, "$AO/ui/kit/Game UI/Additional Elements/Circle Portholes/white_ring.png"));
	sr.color = color;
	sr.layer = layer.(s32);
	vfx := e.add_component(Mech_Flash_Vfx);
	vfx.start_scale = start_scale;
	vfx.end_scale = end_scale;
	vfx.color = color;
	vfx.duration = duration;
}

// Shakes every alive player within `radius` of a blast, scaled down by distance so the
// impact is felt strongest at ground zero. Used for the heavy missile detonations so the
// explosion is felt map-wide, not just by the Mech who fired it.
rr_mech_shake_players_near :: proc(center: v2, radius: float, intensity: float, seconds: float) {
	for p: component_iterator(Player) {
		if p == null || !#alive(p.entity) continue;
		d := length(p.entity.world_position - center);
		if d > radius continue;
		falloff := 1.0 - clamp(d / radius, 0.0, 1.0);
		rr_mech_add_screenshake(p, intensity * falloff, seconds);
	}
}

// Drops a scorched crater spine on the ground at an impact point. It plays its appear anim,
// holds an idle loop, then plays disappear and tears itself down so the total on-screen
// lifetime matches `lifetime`.
rr_mech_spawn_crater :: proc(at: v2, lifetime: float, scale := 1.2) {
	e := Scene.create_entity();
	e.set_local_position(at);
	e.set_local_scale(v2.{scale, scale});
	e.add_component(Spine_Animator);
	c := e.add_component(Mech_Crater);
	c.lifetime = lifetime;
}

// Billowing smoke puff left in the air by a big blast. Plays the smoke "Start" one-shot and
// tears itself down after `lifetime`.
rr_mech_spawn_smoke_puff :: proc(at: v2, scale: float, lifetime := 1.6) {
	e := Scene.create_entity();
	e.set_local_position(at);
	e.set_local_scale(v2.{scale, scale});
	a := e.add_component(Spine_Animator);
	a.awaken();
	a.layer = -6;
	if a.instance != null {
		a.instance.set_skeleton(get_asset(Spine_Asset, MECH_WRECKAGE_SMOKE_RIG));
		a.instance.set_animation("010WD2/Start", false, 0);
	}
	lt := e.add_component(Mech_Vfx_Lifetime);
	lt.lifetime = lifetime;
}

// Calls down a vertical lightning bolt that strikes the ground at `at` (used when a magnet
// rod lands). Sequences the strike's start -> end one-shot, then tears itself down. Drawn
// high (layer 10) so the bolt reads as crashing down in front of everything.
rr_mech_spawn_lightning_strike :: proc(at: v2, scale := 1.0) {
	e := Scene.create_entity();
	e.set_local_position(at);
	e.set_local_scale(v2.{scale, scale});
	a := e.add_component(Spine_Animator);
	a.awaken();
	a.layer = 10;
	if a.instance != null {
		a.instance.set_skeleton(get_asset(Spine_Asset, MECH_LIGHTNING_RIG));
		a.instance.set_animation("start", false, 0);
	}
	e.add_component(Mech_Lightning_Strike);
	rr_mech_play_sfx_at(MECH_LIGHTNING_SFX, at, 0.55);
}

rr_mech_upgrades_owned :: proc(mech: Mech_Module) -> int {
	if mech == null return 0;
	count := 0;
	if mech.helmet_trap_unlocked { count += 1; }
	if mech.ram_charge_unlocked { count += 1; }
	if mech.magnet_cannon_unlocked { count += 1; }
	if mech.missile_barrage_unlocked { count += 1; }
	return count;
}

// All purchasable upgrades owned (the four arsenal weapons + Wreckage Warp). Drives the
// escalating cost ladder, which scales with how many upgrades you've already bought.
rr_mech_upgrades_owned_total :: proc(mech: Mech_Module) -> int {
	if mech == null return 0;
	count := rr_mech_upgrades_owned(mech);
	if mech.wreckage_warp_unlocked { count += 1; }
	return count;
}

// Cost of the NEXT upgrade given how many are already owned — returns (components, magnet
// cores). Escalates by purchase order, leaving the Mech free to choose WHICH upgrade fills
// each slot: 1st = 1 component, 2nd = 2 components, 3rd = 1 component + 1 Magnet Core,
// 4th and beyond = 2 components + 1 Magnet Core.
rr_mech_upgrade_cost :: proc(owned: int) -> int, int {
	if owned <= 0 return 1, 0;
	if owned == 1 return 2, 0;
	if owned == 2 return 1, 1;
	return 2, 1;
}

// Magnet Cores can only be farmed once the Magnet Cannon is built (it's what magnetises
// players). So a core in the cost is waived until the Cannon is owned — this stops a player
// who skipped the Cannon early from being soft-locked out of all further upgrades.
rr_mech_upgrade_core_cost :: proc(mech: Mech_Module, raw_cores: int) -> int {
	if mech == null return 0;
	if !mech.magnet_cannon_unlocked return 0;
	return raw_cores;
}

rr_mech_plural :: proc(word: string, n: int) -> string {
	if n == 1 return word;
	return format_string("%s", .{word});
}

// Human label naming the SPECIFIC component a build needs, e.g. "2 Schematics",
// "2 Circuits + 1 Magnet Core". comp_kind 0 = any component ("Component").
rr_mech_cost_label :: proc(comp_kind: int, qty: int, core_cost: int) -> string {
	cname := comp_kind != 0 ? rr_mech_component_name(comp_kind) : "Component";
	parts := format_string("% %", .{qty, rr_mech_plural(cname, qty)});
	if core_cost <= 0 return parts;
	cores := format_string("% %", .{core_cost, rr_mech_plural("Magnet Core", core_cost)});
	return format_string("% + %", .{parts, cores});
}

rr_mech_spawn_transform_vfx :: proc(player: Player, duration := MECH_TRANSFORM_VFX_DURATION) {
	if player == null || !#alive(player.entity) return;
	e := Scene.create_entity();
	e.set_parent(player.entity, false);
	e.set_local_position(v2.{0, 0.55});
	e.set_local_scale(v2.{1, 1});
	anim := e.add_component(Spine_Animator);
	anim.awaken();
	anim.layer = 10;
	if anim.instance != null {
		anim.instance.set_skeleton(get_asset(Spine_Asset, MECH_TRANSFORM_VFX_RIG));
		anim.instance.set_animation("repairing", false, 0);
	}
	vfx := new(Mech_Transform_Vfx_Effect);
	vfx.set_duration(duration);
	e.add_passive_effect(vfx);
}

// Small transform VFX burst over a specific spot on the avatar (used for the per-part
// reveal flourish), parented to the player so it tracks them.
rr_mech_spawn_part_transform_vfx :: proc(player: Player, offset: v2, scale: float, duration: float) {
	if player == null || !#alive(player.entity) return;
	e := Scene.create_entity();
	e.set_parent(player.entity, false);
	e.set_local_position(offset);
	e.set_local_scale(v2.{scale, scale});
	anim := e.add_component(Spine_Animator);
	anim.awaken();
	anim.layer = 11;
	if anim.instance != null {
		anim.instance.set_skeleton(get_asset(Spine_Asset, MECH_TRANSFORM_VFX_RIG));
		anim.instance.set_animation("repairing", false, 0);
	}
	vfx := new(Mech_Transform_Vfx_Effect);
	vfx.set_duration(duration);
	e.add_passive_effect(vfx);
}

// Bitmask of bolt-on parts that visibly attach to the mech avatar (built at the workbench).
rr_mech_upgrade_sig :: proc(mech: Mech_Module) -> int {
	if mech == null return 0;
	sig := 0;
	if mech.helmet_trap_unlocked     { sig |= 1; }
	if mech.ram_charge_unlocked      { sig |= 2; }
	if mech.magnet_cannon_unlocked   { sig |= 4; }
	if mech.missile_barrage_unlocked { sig |= 8; }
	return sig;
}

// Sequences a part reveal in time with the mech's forging slam (begin_part_reveal plays the
// body anim + winds up the VFX): holds until the slam's peak, then lands the new part with a
// lightning crack, metal clang and scale-punch on the downbeat. Runs on its own throwaway
// entity (on every client) so nothing persists on the player.
Mech_Part_Reveal :: class : Component {
	player_id: u64;
	apply_at: float;
	part_offset: v2;
	settle_at: float;
	target_scale: float;
	applied: bool;

	ao_update :: method(dt: float) {
		p := get_player_by_entity_id(player_id);
		if p == null || !#alive(p.entity) { entity.destroy(); return; }
		mech := p.entity.get_component(Mech_Module);
		if mech == null || mech.creature_entity == null || !#alive(mech.creature_entity) { entity.destroy(); return; }

		if !applied {
			if get_time() < apply_at return;
			// Slam peak: snap the new part on, punch the scale, and sell the impact with a
			// lightning strike down the part, a heavy metal clang and a shockwave + shake.
			rr_mech_apply_avatar_skins(p);
			target_scale = 1.06 + rr_mech_upgrades_owned(mech).(float) * 0.08;
			mech.creature_entity.set_local_scale(v2.{target_scale * 1.22, target_scale * 1.22});
			applied = true;
			settle_at = get_time() + 0.22;

			impact_pos := p.entity.world_position + part_offset;
			rr_mech_spawn_lightning_strike(impact_pos, 0.9); // bolt VFX + lightning SFX
			rr_mech_play_sfx_at("sfx/metal_hit_827869.wav", p.entity.world_position, 0.5);
			rr_mech_spawn_flash(impact_pos, 0.9, v4.{0.55, 0.85, 1.0, 0.75}, 0.26);
			rr_mech_spawn_shockwave(p.entity.world_position + v2.{0, 0.5}, 0.4, 4.0, v4.{0.6, 0.9, 1.0, 0.7}, 0.4);
			rr_mech_add_screenshake(p, 0.14, 0.28);
			return;
		}

		remaining := (settle_at - get_time()) / 0.22;
		if remaining <= 0.0 {
			mech.creature_entity.set_local_scale(v2.{target_scale, target_scale});
			entity.destroy();
			return;
		}
		s := target_scale * (1.0 + 0.22 * remaining);
		mech.creature_entity.set_local_scale(v2.{s, s});
	}
}

// Kicks off the reveal for the newly-built part(s). The mech rears back into a forging slam
// (played on every client so the whole lobby sees the upgrade land), sparks shimmer over the
// changing body region during the wind-up, and the Mech_Part_Reveal entity lands the part at
// the slam's peak.
rr_mech_begin_part_reveal :: proc(player: Player, new_bits: int) {
	if player == null || !#alive(player.entity) return;
	mech := player.entity.get_component(Mech_Module);
	if mech == null return;
	offset := v2.{0, 0.55};
	if (new_bits & 8) != 0 { offset = v2.{0, 1.0}; }       // missile launchers — shoulders
	else if (new_bits & 4) != 0 { offset = v2.{0, 0.5}; }  // magnet cannons — arms
	else if (new_bits & 2) != 0 { offset = v2.{0, 0.7}; }  // power core — chest
	else if (new_bits & 1) != 0 { offset = v2.{0, 0.25}; } // legs / jetpack

	// The mech forges the part on with a full-body slam; the part lands on the impact.
	slam_dur := rr_mech_anim_duration("009SG/Smash_Task");
	rr_mech_play_avatar_anim(player, "009SG/Smash_Task", false);

	// Cinematic framing: freeze + slide the mech back off the workbench edge so the avatar is
	// unobstructed, and arm the camera punch-in + letterbox window (driven in late_update).
	// Runs on every client for this player, so the authoritative slide-back stays in sync.
	// The freeze + slide only happen on the leading edge so a back-to-back build can't
	// double-freeze (which would leak the movement lock); the window just extends.
	if !mech.part_reveal_active {
		player.add_disable_movement_input_reason(MECH_LOCK_REASON);
		back_dir := v2.{0, -1};
		if mech_workbench_entity != null && #alive(mech_workbench_entity) {
			away := player.entity.world_position - mech_workbench_entity.world_position;
			if length(away) > 0.01 { back_dir = normalize(away); }
		}
		player.entity.set_local_position(player.entity.world_position + back_dir * MECH_PART_REVEAL_BACK_DISTANCE);
		mech.part_reveal_started_at = get_time();
	}
	mech.part_reveal_active = true;
	mech.part_reveal_ends_at = max(mech.part_reveal_ends_at, get_time() + slam_dur + MECH_PART_REVEAL_SETTLE);

	rr_mech_spawn_part_transform_vfx(player, offset, 0.85, slam_dur);
	rr_mech_play_sfx_at("$AO/sfx/FUI Holo Mechanism Activate.wav", player.entity.world_position, 0.35);

	e := Scene.create_entity();
	r := e.add_component(Mech_Part_Reveal);
	r.player_id = player.entity.id;
	r.part_offset = offset;
	// Land the part on the slam's downbeat rather than a fixed early beat.
	r.apply_at = get_time() + slam_dur * 0.55;
}

rr_mech_in_part_reveal_cinematic :: proc(player: Player) -> bool {
	if player == null || player.player_role != Player_Role.THE_MECH return false;
	mech := player.entity.get_component(Mech_Module);
	return mech != null && mech.part_reveal_active;
}

// Releases the part-reveal cinematic (unfreeze) once its window elapses. Safe to call every
// frame; also call directly to force-clear when a round/state interruption cuts it short.
rr_mech_end_part_reveal :: proc(player: Player, mech: Mech_Module) {
	if mech == null || !mech.part_reveal_active return;
	mech.part_reveal_active = false;
	if player != null { player.remove_disable_movement_input_reason(MECH_LOCK_REASON); }
}

rr_mech_add_screenshake :: proc(player: Player, intensity: float, seconds: float) {
	if player == null return;
	shake := player.entity.get_component(Mech_Screenshake_Status);
	if shake == null { shake = player.entity.add_component(Mech_Screenshake_Status); }
	shake.arm(intensity, seconds);
}

rr_mech_reset_module :: proc(mech: Mech_Module) {
	if mech == null return;
	// Clear the transform invisibility reason — otherwise a player whose round ended while
	// transformed keeps the real avatar hidden, since the normal revert path (which removes it)
	// never runs at round end.
	player := mech.entity.get_component(Player);
	if player != null { rr_mech_enable_player_hidden(player, false); }
	if mech.creature_entity != null && #alive(mech.creature_entity) {
		mech.creature_entity.destroy();
	}
	mech.is_mech_form = false;
	mech.is_apex = false;
	mech.apex_used = false;
	mech.apex_lost = false;
	mech.apex_transform_locked = false;
	mech.apex_skin_revealed = false;
	mech.apex_reveal_at = 0.0;
	mech.power_cores = 0;
	mech.magnet_cores = 0;
	mech.power_cells = 0;
	mech.circuits = 0;
	mech.schematics = 0;
	mech.gears = 0;
	mech.helmet_trap_unlocked = false;
	mech.ram_charge_unlocked = false;
	mech.magnet_cannon_unlocked = false;
	mech.missile_barrage_unlocked = false;
	mech.wreckage_warp_unlocked = false;
	mech.endgame_unlocked = false;
	mech.conversion_used = false;
	mech.carried_player_id = 0;
	mech.carried_corpse_id = 0;
	mech.workbench_ui_open = false;
	mech.visited_workbench = false;
	mech.minimap_hint_kind = 0;
	mech.minimap_hint_until = 0.0;
	mech.magnet_cam_hold_until = 0.0;
	mech.missile_aim_active = false;
	mech.missile_aim_center = v2.{0, 0};
	mech.missile_aim_anchor = v2.{0, 0};
	mech.missile_markers_placed = 0;
	mech.missile_cam_hold_until = 0.0;
	mech.showdown_active = false;
	mech.showdown_opponent_id = 0;
	mech.showdown_mashes = 0;
	mech.showdown_ends_at = 0.0;
	mech.showdown_downed = false;
	mech.showdown_death_at = 0.0;
	mech.showdown_death_killer_id = 0;
	mech.minion_revive_used = false;
	mech.creature_entity = null;
	mech.creature_animator = null;
	mech.creature_visible = false;
	mech.player_hidden_applied = false; // matches the rr_mech_enable_player_hidden(false) above
	mech.last_anim = "";
	mech.anim_lock_until = 0.0;
	mech.transform_anim_ends_at = 0.0;
	mech.overlay_clear_at = 0.0;
	mech.last_overlay_anim = "";
	mech.shown_upgrade_sig = 0;
	mech.part_reveal_active = false;
	mech.part_reveal_started_at = 0.0;
	mech.part_reveal_ends_at = 0.0;
	if player != null { player.remove_disable_movement_input_reason(MECH_LOCK_REASON); }
}

rr_guardian_reset_module :: proc(guard: Guardian_Module) {
	if guard == null return;
	// Clear the transform invisibility reason — otherwise a player whose round ended while
	// transformed keeps the real avatar hidden, since the normal revert path (which removes it)
	// never runs at round end.
	player := guard.entity.get_component(Player);
	if player != null { rr_mech_enable_player_hidden(player, false); }
	if guard.creature_entity != null && #alive(guard.creature_entity) {
		guard.creature_entity.destroy();
	}
	guard.is_guardian_form = false;
	guard.carried_player_id = 0;
	guard.showdown_active = false;
	guard.showdown_opponent_id = 0;
	guard.showdown_mashes = 0;
	guard.showdown_ends_at = 0.0;
	guard.showdown_death_at = 0.0;
	guard.showdown_death_killer_id = 0;
	guard.showdown_cooldown_until = 0.0;
	guard.creature_entity = null;
	guard.creature_animator = null;
	guard.creature_visible = false;
	guard.player_hidden_applied = false; // matches the rr_mech_enable_player_hidden(false) above
	guard.last_anim = "";
	guard.anim_lock_until = 0.0;
	guard.transform_anim_ends_at = 0.0;
	guard.overlay_clear_at = 0.0;
	guard.last_overlay_anim = "";
}

// Reverts a transformed Mech / Guardian to their human ("schleem") form for a meeting. Run from
// setup_voting right after the teleport so the swap is masked by the jump — matching every other
// transforming role (which is why the Mech is added to rr_force_revert_all_roles_for_meeting).
// The Mech's is_mech_form is CLEARED so the revert sticks: after the meeting the Mech stays in
// schleem and must press Transform again to re-enter mech form — otherwise it would visibly pop
// back into the titan in the voting circle, outing itself to everyone present. The once-per-game
// APEX state (is_apex) is preserved (APEX can never be schleem, so it re-shows on resume), as is
// the Guardian's is_guardian_form (a public hero role — no need to hide its form).
rr_mech_force_revert :: proc(player: Player) {
	if player == null || !#alive(player.entity) return;
	mech := player.entity.get_component(Mech_Module);
	guard := player.entity.get_component(Guardian_Module);
	if mech == null && guard == null return;

	transformed_or_showing :=
		(mech != null && (mech.is_mech_form || mech.is_apex || mech.creature_visible)) ||
		(guard != null && (guard.is_guardian_form || guard.creature_visible));
	if !transformed_or_showing {
		// Defensive: make sure no stale transform invis reason is left hiding the real player.
		rr_mech_enable_player_hidden(player, false);
		if mech != null { mech.player_hidden_applied = false; }
		if guard != null { guard.player_hidden_applied = false; }
		return;
	}

	// Hide the creature avatar and clear the transform invis reason unconditionally (not gated on
	// creature_visible) so a desynced/half-applied transform can't leave the real player invisible.
	rr_mech_show_avatar(player, false);
	player.remove_disable_movement_input_reason(MECH_LOCK_REASON);

	// Tear down an in-progress Ram so its truck rig doesn't linger in the voting circle.
	// restore_mech also hands back the driven walk speed + clears the forced move input.
	ram := player.entity.get_component(Mech_Ram_Charge_Status);
	if ram != null {
		ram.restore_mech(player);
		ram.active = false;
	}

	if mech != null {
		// Drop out of mech form for good — the player resumes in schleem after the meeting and only
		// re-transforms when they choose to (Transform ability). APEX is forced back on by the
		// Transform ability anyway, and auto-re-shows via is_apex, so this is a no-op for APEX.
		if !mech.is_apex { mech.is_mech_form = false; }
		mech.transform_anim_ends_at = 0.0;
		mech.carried_player_id = 0;
		mech.carried_corpse_id = 0;
		mech.showdown_active = false;
		mech.showdown_opponent_id = 0;
		mech.showdown_mashes = 0;
		mech.showdown_ends_at = 0.0;
		// A meeting interrupting a downed Mech un-downs it (it reverts to human form like everyone
		// else); don't leave it frozen. minion_revive_used persists (still once per game).
		mech.showdown_downed = false;
		mech.showdown_death_at = 0.0;
		mech.apex_transform_locked = false;
		mech.last_anim = "";
		mech.anim_lock_until = 0.0;
		mech.overlay_clear_at = 0.0;
		mech.last_overlay_anim = "";
	}
	if guard != null {
		guard.carried_player_id = 0;
		guard.showdown_active = false;
		guard.showdown_opponent_id = 0;
		guard.showdown_mashes = 0;
		guard.showdown_ends_at = 0.0;
		guard.showdown_death_at = 0.0;
		guard.showdown_death_killer_id = 0;
		guard.last_anim = "";
		guard.anim_lock_until = 0.0;
		guard.overlay_clear_at = 0.0;
		guard.last_overlay_anim = "";
	}
}

// Tears down all Mech world entities and reverts per-player mech/guardian/minion state.
// Safe to call at round end (victory/lobby) and round start; does NOT spawn the workbench.
rr_mech_clear_world_and_state :: proc() {
	if mech_workbench_entity != null && #alive(mech_workbench_entity) {
		mech_workbench_entity.destroy();
	}
	mech_workbench_entity = null;
	if mech_convert_interactable_entity != null && #alive(mech_convert_interactable_entity) {
		mech_convert_interactable_entity.destroy();
	}
	mech_convert_interactable_entity = null;
	for w: component_iterator(Mech_Wreckage) {
		if w != null && #alive(w.entity) { w.entity.destroy(); }
	}
	for h: component_iterator(Mech_Helmet_Trap) {
		if h != null && #alive(h.entity) { h.entity.destroy(); }
	}
	for m: component_iterator(Mech_Magnet_Node) {
		if m != null && #alive(m.entity) { m.entity.destroy(); }
	}
	for cp: component_iterator(Mech_Component_Pickup) {
		if cp != null && #alive(cp.entity) { cp.entity.destroy(); }
	}
	// Tear down any burning fire pillars (missile zone-denial) and recall-portal VFX so they
	// don't linger into the next round (and so their per-frame pushback stops blocking players).
	for fp: component_iterator(Mech_Fire_Pillar) {
		if fp != null && #alive(fp.entity) { fp.entity.destroy(); }
	}
	for rp: component_iterator(Mech_Recall_Portal) {
		if rp != null && #alive(rp.entity) { rp.entity.destroy(); }
	}
	// Clear smashed-task state on the persistent task panels. The wreckage entities are
	// destroyed above, but mech_smashed lives on the long-lived Task_Interactable and would
	// otherwise leave the panel stuck showing "Repair" (blocking its normal task) next round.
	for t: component_iterator(Task_Interactable) {
		if t == null || !#alive(t.entity) continue;
		t.mech_smashed = false;
		t.mech_wreckage_entity = null;
	}
	// Revert mech/guardian transforms and strip minion effects for EVERY player, not just the
	// current holders: these modules persist across rounds and role reassignment, so a player
	// who was the Mech/Guardian last round would otherwise carry their transform state over.
	for p: component_iterator(Player) {
		if p == null continue;
		if !#alive(p.entity) continue;
		remove_effect(p.entity, Mech_Minion_Effect, false);
		// Strip any lingering Helmet-Trap helmet so a victim trapped when the round ended doesn't
		// carry the skin into the next round (the status component persists across rounds).
		helm := p.entity.get_component(Mech_Helmeted_Status);
		if helm != null { helm.active = false; helm.helmet_on = false; } // clear both so a re-trap next round re-applies the skin
		rr_mech_set_magnet_helmet(p, false);
		mech := p.entity.get_component(Mech_Module);
		if mech != null { rr_mech_reset_module(mech); }
		guard := p.entity.get_component(Guardian_Module);
		if guard != null { rr_guardian_reset_module(guard); }
	}
}

rr_mech_round_global_cleanup :: proc() {
	rr_mech_clear_world_and_state();
	rr_mech_spawn_workbench_if_needed();
}

rr_mech_spawn_workbench_if_needed :: proc() {
	has_mech := false;
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p != null && p.player_role == Player_Role.THE_MECH {
			has_mech = true;
			break;
		}
	}
	if !has_mech return;

	pos := v2.{0, 0};
	found := false;
	for i: 0..rr_task_destination_entries.elements.count-1 {
		entry := rr_task_destination_entries.elements[i];
		if entry == null continue;
		if entry.task_id == "rnd_workbench" {
			pos = entry.pos;
			found = true;
			break;
		}
	}
	if !found {
		for i: 0..rr_task_destination_entries.elements.count-1 {
			entry := rr_task_destination_entries.elements[i];
			if entry == null continue;
			if entry.task_id == "calibrate_teleporter" {
				pos = entry.pos;
				break;
			}
		}
	}
	// No visible sprite — the Mech walks to the existing rnd_workbench prop
	// and gets the "R&D Workbench" interactable prompt when in range.
	mech_workbench_entity = Scene.create_entity();
	mech_workbench_entity.set_local_position(pos);
	mech_workbench_entity.add_component(Mech_Workbench_Interactable);

	// Smash is a world interactable (prompt above each smashable task panel) instead of an
	// ability button. Attach one to every component task; can_use gates it to the mech /
	// minion so civilians still see only the normal task prompt.
	for t: component_iterator(Task_Interactable) {
		if t == null || !#alive(t.entity) continue;
		if !rr_mech_task_is_smashable(t) continue;
		if t.entity.get_component(Mech_Smash_Interactable) == null {
			t.entity.add_component(Mech_Smash_Interactable);
		}
	}

	// Conversion is a world interactable that hovers over the nearest civilian in reach.
	mech_convert_interactable_entity = Scene.create_entity();
	mech_convert_interactable_entity.set_local_position(v2.{99999, 99999});
	mech_convert_interactable_entity.add_component(Mech_Convert_Interactable);
}

rr_mech_get_owner :: proc(player: Player) -> Player {
	if player == null return null;
	if player.player_role == Player_Role.THE_MECH return player;
	minion := rr_mech_get_minion_effect(player);
	if minion != null && minion.converted_by_mech_id != 0 {
		return get_player_by_entity_id(minion.converted_by_mech_id);
	}
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p != null && p.player_role == Player_Role.THE_MECH {
			return p;
		}
	}
	return null;
}

rr_mech_is_minion_active :: proc(player: Player) -> bool {
	minion := rr_mech_get_minion_effect(player);
	return minion != null && minion.converted_by_mech_id != 0;
}

rr_mech_get_minion_effect :: proc(player: Player) -> Mech_Minion_Effect {
	if player == null return null;
	if !#alive(player.entity) return null;
	e, _ := get_effect(player.entity, Mech_Minion_Effect);
	return e;
}

// True if `player` is a converted Minion whose ORIGINAL (pre-conversion) type + role match. A
// Minion's player_type is forced to TRAITOR for alignment, so ability gates that key off the live
// type/role miss them — they consult this to honor the powers the player keeps as a Minion. This
// is what lets converted civilians/anarchists keep using their original kit on top of the Minion's.
rr_minion_has_original_power :: proc(player: Player, type: Player_Type, role: Player_Role) -> bool {
	minion := rr_mech_get_minion_effect(player);
	if minion == null || minion.converted_by_mech_id == 0 return false;
	return minion.original_type == type && minion.original_role == role;
}

// Per-viewer Minion disguise: the half-cyborg skin marks converted Minions as Mech-aligned, but
// only fellow TRAITORS should see it (innocents see the player's normal cosmetics). Like
// setup_player_colors, this runs ONLY on the local client and re-applies every frame so it
// survives server reconciliation wiping client-only skin state. Gated on a want/has diff so the
// (cheap) skin-list rebuild only fires on an edge, not every frame.
rr_mech_apply_minion_disguise_for_viewer :: proc(viewer: Player) {
	if viewer == null return;
	local_is_traitor := viewer.player_type == Player_Type.TRAITOR;
	for p: component_iterator(Player) {
		if p == null continue;
		if !#alive(p.entity) continue;
		want := local_is_traitor && rr_mech_is_minion_active(p);
		has := Player.rr_player_has_skin(p, MECH_MINION_SKIN);
		if want != has { Player.rr_player_set_skin_enabled(p, MECH_MINION_SKIN, want); }
	}
}

rr_mech_is_transformed :: proc(player: Player) -> bool {
	if player == null return false;
	mech := player.entity.get_component(Mech_Module);
	if mech != null return mech.is_mech_form || mech.is_apex;
	guard := player.entity.get_component(Guardian_Module);
	if guard != null return guard.is_guardian_form;
	return false;
}

rr_mech_enable_player_hidden :: proc(player: Player, hidden: bool) {
	if player == null return;
	if hidden {
		player.add_invisibility_reason(MECH_INVIS_REASON);
		player.add_name_invisibility_reason(MECH_INVIS_REASON);
	} else {
		player.remove_invisibility_reason(MECH_INVIS_REASON);
		player.remove_name_invisibility_reason(MECH_INVIS_REASON);
	}
}

rr_mech_ensure_avatar :: proc(player: Player) {
	if player == null return;
	mech := player.entity.get_component(Mech_Module);
	guard := player.entity.get_component(Guardian_Module);
	if mech == null && guard == null return;
	if mech != null && mech.creature_entity != null && #alive(mech.creature_entity) return;
	if guard != null && guard.creature_entity != null && #alive(guard.creature_entity) return;

	e := Scene.create_entity();
	e.set_parent(player.entity, false);
	e.set_local_position(v2.{0, 0});
	e.set_local_rotation(0.0);
	e.set_local_scale(v2.{1, 1});

	anim := e.add_component(Spine_Animator);
	anim.awaken();
	if anim.instance != null {
		anim.instance.set_skeleton(get_asset(Spine_Asset, MECH_RIG));
		rr_mech_setup_avatar_state_machine(anim);
		rr_apply_shadow_mask(anim.instance);
	}
	e.set_local_enabled(false);

	if mech != null {
		mech.creature_entity = e;
		mech.creature_animator = anim;
		mech.creature_visible = false;
	}
	if guard != null {
		guard.creature_entity = e;
		guard.creature_animator = anim;
		guard.creature_visible = false;
	}
}

rr_mech_apply_avatar_skins :: proc(player: Player) {
	if player == null return;
	mech := player.entity.get_component(Mech_Module);
	guard := player.entity.get_component(Guardian_Module);
	anim: Spine_Animator = null;
	ce: Entity = null;
	if mech != null { anim = mech.creature_animator; ce = mech.creature_entity; }
	if guard != null { anim = guard.creature_animator; ce = guard.creature_entity; }
	// Creature entity/animator are local, runtime-spawned, and may be unbuilt or torn down
	// on a remote client — touching a dangling animator crashes refresh_skins, so bail first.
	if ce == null || !#alive(ce) return;
	if anim == null || anim.instance == null return;
	// Rig asset may still be streaming on a remote client; refresh_skins derefs a null
	// skeleton and crashes if we touch it before it's loaded.
	if anim.instance.get_skeleton() == null return;

	anim.instance.disable_all_skins();
	if guard != null {
		anim.instance.enable_skin("Full/Guardian");
		if guard.creature_entity != null {
			guard.creature_entity.set_local_scale(v2.{1.18, 1.18});
		}
	} else if mech != null {
		// Only render the APEX skin once the transform has hit its reveal beat — until then
		// the body keeps the regular mech skin so the morph reads as a transformation, not a
		// pop. rr_mech_update flips apex_skin_revealed at apex_reveal_at.
		if mech.is_apex && mech.apex_skin_revealed {
			anim.instance.enable_skin("Full/Mecha_APEX");
			if mech.creature_entity != null { mech.creature_entity.set_local_scale(v2.{1.55, 1.55}); }
		} else {
			anim.instance.enable_skin("Full/Mecha_skeleton");
			anim.instance.enable_skin("Head");
			anim.instance.enable_skin("Arms");
			// Chest_empty and Chest_full are mutually exclusive variants of the same slot —
			// enabling BOTH corrupts the skin combine and crashes refresh_skins (this is why
			// only the Ram/power-core upgrade crashed). Pick exactly one.
			// Bolt-on parts appear when the matching upgrade is BUILT at the workbench,
			// not when raw components are collected.
			if mech.ram_charge_unlocked { anim.instance.enable_skin("Chest_full"); }
			else { anim.instance.enable_skin("Chest_empty"); }
			if mech.magnet_cannon_unlocked { anim.instance.enable_skin("Full/Mecha"); }
			if mech.missile_barrage_unlocked { anim.instance.enable_skin("Missiles"); }
			if mech.helmet_trap_unlocked { anim.instance.enable_skin("Legs"); }
			scale := 1.06 + rr_mech_upgrades_owned(mech).(float) * 0.08;
			if mech.creature_entity != null { mech.creature_entity.set_local_scale(v2.{scale, scale}); }
		}
	}
	anim.instance.refresh_skins();
}

rr_mech_show_avatar :: proc(player: Player, show: bool) {
	rr_mech_ensure_avatar(player);
	mech := player.entity.get_component(Mech_Module);
	guard := player.entity.get_component(Guardian_Module);
	e: Entity = null;
	if mech != null { e = mech.creature_entity; mech.creature_visible = show; }
	if guard != null { e = guard.creature_entity; guard.creature_visible = show; }
	if e != null && #alive(e) { e.set_local_enabled(show); }
	// Toggle the real-player invisibility reason against a DEDICATED applied-flag (NOT creature_visible).
	// The reason is ref-counted, so it must be added and removed exactly once per hide episode. Gating
	// on creature_visible was unsafe: a transform-time reconciliation (e.g. being stunned by Charlie
	// mid-transform) could flip creature_visible back to false while the reason was still applied, so
	// the next show_avatar(true) re-added it — and the single remove on revert left the player stuck
	// invisible. player_hidden_applied changes ONLY here, in lockstep with the add/remove, so unrelated
	// state can't desync it and the ref count stays balanced. Always clears on hide.
	already_applied := false;
	if mech != null { already_applied = mech.player_hidden_applied; }
	if guard != null { already_applied = guard.player_hidden_applied; }
	if show {
		if !already_applied {
			rr_mech_enable_player_hidden(player, true);
			if mech != null { mech.player_hidden_applied = true; }
			if guard != null { guard.player_hidden_applied = true; }
		}
	} else {
		if already_applied {
			rr_mech_enable_player_hidden(player, false);
			if mech != null { mech.player_hidden_applied = false; }
			if guard != null { guard.player_hidden_applied = false; }
		}
	}
	if show {
		rr_mech_apply_avatar_skins(player);
		// Baseline the shown-parts mask to whatever is already owned, so transforming in
		// doesn't trigger a per-part reveal for parts the mech already had.
		if mech != null { mech.shown_upgrade_sig = rr_mech_upgrade_sig(mech); }
	}
}

rr_mech_play_avatar_anim :: proc(player: Player, anim_name: string, loop: bool) {
	if player == null return;
	mech := player.entity.get_component(Mech_Module);
	guard := player.entity.get_component(Guardian_Module);
	anim: Spine_Animator = null;
	if mech != null {
		anim = mech.creature_animator;
		mech.last_anim = anim_name;
		if !loop { mech.anim_lock_until = get_time() + rr_mech_anim_duration(anim_name); }
	}
	if guard != null {
		anim = guard.creature_animator;
		guard.last_anim = anim_name;
		if !loop { guard.anim_lock_until = get_time() + rr_mech_anim_duration(anim_name); }
	}
	if anim == null || anim.instance == null return;
	// Route through the state machine: one-shot gestures fire a trigger, locomotion /
	// showdown-loop names are no-ops here (driven by bools in update_avatar_locomotion).
	rr_mech_avatar_trigger(anim, anim_name);
}

// Per-frame locomotion: feed the avatar state machine the bools it dispatches on
// (form + movement + showdown + downed). The SM picks Idle/Run/Fly itself and never
// re-issues an animation unless the STATE actually changes, so it can't thrash the
// Spine mixingFrom chain the way per-frame set_animation did.
rr_mech_update_avatar_locomotion :: proc(player: Player) {
	if player == null return;
	if !rr_mech_is_transformed(player) return;
	mech := player.entity.get_component(Mech_Module);
	guard := player.entity.get_component(Guardian_Module);
	anim: Spine_Animator = null;
	if guard != null { anim = guard.creature_animator; }
	else if mech != null { anim = mech.creature_animator; }
	if anim == null || anim.instance == null return;
	sm := anim.instance.state_machine;
	if sm == null return;

	moving := length(player.agent.velocity) > 0.25;
	// While placing missiles the Mech holds position (input pans the camera, not the body). The
	// synced velocity can briefly spike from that pan input, which on REMOTE viewers flickers the
	// locomotion between Run and Idle and makes the avatar jitter. missile_aim_active is synced, so
	// forcing Idle here keeps every client's avatar still and in agreement.
	if mech != null && mech.missile_aim_active { moving = false; }

	sm.set_bool("is_moving", moving);
	sm.set_bool("is_apex", mech != null && mech.is_apex);
	sm.set_bool("is_guardian", guard != null);
	// Holds derived from synced source-of-truth state (immune to reconciliation): the
	// showdown loop and the downed faked-death freeze.
	in_showdown := (mech != null && mech.showdown_active) || (guard != null && guard.showdown_active);
	sm.set_bool("in_showdown", in_showdown);
	sm.set_bool("downed", mech != null && mech.showdown_downed);
}

rr_mech_update :: proc(player: Player, dt: float) {
	if player == null return;
	mech := player.entity.get_component(Mech_Module);
	guard := player.entity.get_component(Guardian_Module);
	if mech != null {
		if game_state != Game_State.INGAME || player.player_state != Player_State.ALIVE {
			// Defer the visual transform-revert for meetings to teleport time (rr_mech_force_revert
			// in setup_voting) so nearby players don't see the pop and it survives reconciliation —
			// matching the other transforming roles. Dead players have no meeting teleport, so they
			// still revert here.
			if player.player_state != Player_State.ALIVE && mech.creature_visible { rr_mech_show_avatar(player, false); }
			mech.carried_player_id = 0;
			mech.carried_corpse_id = 0;
			mech.showdown_active = false;
			mech.showdown_downed = false;
			mech.showdown_death_at = 0.0;
			// If the cinematic was interrupted (Mech died / game ended otherwise), unfreeze the
			// lobby and restore the avatar's float offset + render layer.
			if mech.endgame_active {
				mech.endgame_active = false;
				if mech.creature_entity != null && #alive(mech.creature_entity) {
					mech.creature_entity.set_local_position(v2.{0, 0});
				}
				if mech.creature_animator != null { mech.creature_animator.layer = 0; }
				for p: component_iterator(Player) {
					if p == null continue;
					rr_remove_freeze_reason_all(p, MECH_ENDGAME_FREEZE_REASON);
				}
			}
			player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
			mech.apex_transform_locked = false;
			rr_mech_end_part_reveal(player, mech);
			// If a missile placement / cam-hold was interrupted (Mech died / meeting), drop the
			// free-cam and restore the follow camera so the view isn't left detached.
			if mech.missile_aim_active || mech.missile_cam_hold_until > 0.0 {
				mech.missile_aim_active = false;
				mech.missile_cam_hold_until = 0.0;
				if player.is_local_or_server() && player.camera_default_size_saved {
					player.camera.follow_player = true;
					player.camera.size = player.camera_default_size;
				}
			}
		} else {
			// Minions hand-deliver any collected parts when they walk up to the Mech.
			rr_mech_update_minion_delivery(player);

			// Magnet Cannon camera hold: keep the wide aim framing for a beat after the last rod
			// fires, then ease back to the saved default. Applied on client AND server (the camera
			// is synced and re-applied every frame), mirroring the cannon's own zoom logic.
			if player.is_local_or_server() && mech.magnet_cam_hold_until > 0.0 && player.camera_default_size_saved {
				if get_time() < mech.magnet_cam_hold_until {
					player.camera.size = max(player.camera.size, MECH_AIM_CAMERA_SIZE);
				} else {
					player.camera.size = player.camera_default_size;
					mech.magnet_cam_hold_until = 0.0;
				}
			}

			// Missile Barrage camera hold: after the salvo fires, keep the camera parked over the
			// strike centroid (detached, zoomed out) for a beat so the player watches the rockets
			// crash down, then restore the follow camera. Applied on client + server (camera synced).
			if player.is_local_or_server() && mech.missile_cam_hold_until > 0.0 && player.camera_default_size_saved {
				if get_time() < mech.missile_cam_hold_until {
					player.camera.follow_player = false;
					player.camera.position = mech.missile_aim_center;
					player.camera.size = max(player.camera.size, MECH_AIM_CAMERA_SIZE);
				} else {
					player.camera.follow_player = true;
					player.camera.size = player.camera_default_size;
					mech.missile_cam_hold_until = 0.0;
				}
			}

			// Enforce visibility each frame (survives reconciliation); keep the
			// avatar visible while a transform-out anim is still playing.
			target_visible := mech.is_mech_form || mech.is_apex || get_time() < mech.transform_anim_ends_at;
			if mech.creature_visible != target_visible {
				rr_mech_show_avatar(player, target_visible);
			}
			// Release the APEX-transform movement lock once the transform anim has played out.
			if mech.apex_transform_locked && get_time() >= mech.transform_anim_ends_at {
				player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
				mech.apex_transform_locked = false;
			}
			// APEX skin reveal: at the morph climax, swap the held mech skin for the APEX skin
			// so the body transforms instead of popping. The skin swap runs on every client
			// (each flips its own synced flag as time passes); the burst/flash is local polish.
			if mech.is_apex && !mech.apex_skin_revealed && get_time() >= mech.apex_reveal_at {
				mech.apex_skin_revealed = true;
				rr_mech_apply_avatar_skins(player);
				if player.is_local() {
					rr_mech_spawn_part_transform_vfx(player, v2.{0, 0.7}, 1.1, 0.6);
					rr_mech_spawn_flash(player.entity.world_position + v2.{0, 0.6}, 1.4, v4.{1.0, 0.45, 0.1, 0.75}, 0.4);
					// Heavy double shockwave + harder shake at the morph climax — the body bursts into APEX.
					rr_mech_spawn_shockwave(player.entity.world_position, 0.8, 9.0, v4.{1.0, 0.35, 0.1, 0.9}, 0.7);
					rr_mech_spawn_shockwave(player.entity.world_position, 0.5, 6.5, v4.{0.85, 0.3, 1.0, 0.8}, 0.55);
					rr_mech_add_screenshake(player, 0.32, 0.5);
					rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", player.entity.world_position, 0.4);
				}
			}
			// Smoothly grow the avatar from its mech size to full APEX size across the whole
			// transform anim, so the scale ramps with the morph instead of snapping when the
			// skin swaps. Runs after the reveal block so it overrides the scale apply_skins set.
			if mech.is_apex && get_time() < mech.transform_anim_ends_at && mech.creature_entity != null && #alive(mech.creature_entity) {
				anim_dur := rr_mech_anim_duration("009SG/APEX_transform");
				t := clamp((get_time() - (mech.transform_anim_ends_at - anim_dur)) / anim_dur, 0.0, 1.0);
				ease := t * t * (3.0 - 2.0 * t);
				start_scale := 1.06 + rr_mech_upgrades_owned(mech).(float) * 0.08; // matches mech-skin scale
				s := lerp(start_scale, 1.55, ease); // 1.55 = APEX skin scale in rr_mech_apply_avatar_skins
				mech.creature_entity.set_local_scale(v2.{s, s});
			}
			rr_mech_update_carried(player, mech.carried_player_id, mech.carried_corpse_id);
			rr_mech_update_showdown_for_mech(player, mech);
			rr_mech_update_endgame(player, mech, dt);
			rr_mech_update_overlay(mech.creature_animator, mech.carried_player_id != 0 || mech.carried_corpse_id != 0);

			// Keep the avatar's bolt-on parts in sync with built upgrades on every client,
			// and play the forging-slam reveal on every client when a new part is built
			// mid-form so the whole lobby sees it. (APEX has its own full skin, no per-part reveal.)
			if mech.is_mech_form && !mech.is_apex && mech.creature_visible {
				cur_sig := rr_mech_upgrade_sig(mech);
				if cur_sig != mech.shown_upgrade_sig {
					new_bits := 0;
					if (cur_sig & 1) != 0 && (mech.shown_upgrade_sig & 1) == 0 { new_bits |= 1; }
					if (cur_sig & 2) != 0 && (mech.shown_upgrade_sig & 2) == 0 { new_bits |= 2; }
					if (cur_sig & 4) != 0 && (mech.shown_upgrade_sig & 4) == 0 { new_bits |= 4; }
					if (cur_sig & 8) != 0 && (mech.shown_upgrade_sig & 8) == 0 { new_bits |= 8; }
					mech.shown_upgrade_sig = cur_sig;
					if new_bits != 0 && get_time() >= mech.transform_anim_ends_at {
						rr_mech_begin_part_reveal(player, new_bits);
					} else {
						rr_mech_apply_avatar_skins(player);
					}
				}
			}

			// Release the part-reveal cinematic (unfreeze) once the slam + settle has played out.
			if mech.part_reveal_active && get_time() >= mech.part_reveal_ends_at {
				rr_mech_end_part_reveal(player, mech);
			}
		}
	}
	if guard != null {
		if game_state != Game_State.INGAME || player.player_state != Player_State.ALIVE {
			// Meeting revert is deferred to teleport (rr_mech_force_revert in setup_voting) like the
			// other transforming roles; dead Guardians have no teleport, so revert them here.
			if player.player_state != Player_State.ALIVE && guard.creature_visible { rr_mech_show_avatar(player, false); }
			guard.carried_player_id = 0;
			guard.showdown_active = false;
			guard.showdown_death_at = 0.0;
			player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
		} else {
			target_visible := guard.is_guardian_form || get_time() < guard.transform_anim_ends_at;
			if guard.creature_visible != target_visible {
				rr_mech_show_avatar(player, target_visible);
			}
			rr_mech_update_carried(player, guard.carried_player_id, 0);
			rr_mech_update_showdown_for_guardian(player, guard);
			rr_mech_update_overlay(guard.creature_animator, guard.carried_player_id != 0);
		}
	}
	// Ensure the missile-aim freeze controller exists on EVERY client (remotes included), so the
	// body pins to the anchor on all of them while aiming. The ability only runs on local+server,
	// so it can't add this for remote viewers — without it they'd see the Mech vibrate. The
	// controller is passive (early-returns) whenever placement isn't active.
	if mech != null && player.entity.get_component(Mech_Missile_Aim_Controller) == null {
		player.entity.add_component(Mech_Missile_Aim_Controller);
	}
	rr_mech_update_avatar_locomotion(player);
}

// Plays a one-shot arm-layer (_AL) gesture (grab/throw/shoot) on the overlay layer
// (track 1) so track-0 locomotion keeps running underneath. Fires a state-machine
// trigger; the gesture plays out then clears the track on its own.
rr_mech_play_overlay_oneshot :: proc(player: Player, anim_name: string) {
	if player == null return;
	mech := player.entity.get_component(Mech_Module);
	guard := player.entity.get_component(Guardian_Module);
	anim: Spine_Animator = null;
	until := get_time() + rr_mech_anim_duration(anim_name);
	if mech != null { anim = mech.creature_animator; mech.overlay_clear_at = until; mech.last_overlay_anim = anim_name; }
	if guard != null { anim = guard.creature_animator; guard.overlay_clear_at = until; guard.last_overlay_anim = anim_name; }
	if anim == null || anim.instance == null return;
	sm := anim.instance.state_machine;
	if sm == null return;
	if anim_name == "009SG/Throw_Player_AL" { sm.set_trigger("o_throw"); }
	else if anim_name == "009SG/cm_pick_up" { sm.set_trigger("o_pickup"); }
	else if anim_name == "009SG/Shoot_AL"   { sm.set_trigger("o_shoot"); }
	// 009SG/Showdown_Lose_Death on the overlay is intentionally NOT mirrored: the track-0
	// downed freeze already holds that pose, and the overlay clears so it isn't doubled.
}

// Drives overlay track 1: holds the Carry_Player_AL arm pose while carrying, else the
// overlay layer sits on its cleared track. One-shot gestures (rr_mech_play_overlay_oneshot)
// play out and clear on their own. Driven from synced carry state each frame.
rr_mech_update_overlay :: proc(anim: Spine_Animator, carrying: bool) {
	if anim == null || anim.instance == null return;
	sm := anim.instance.state_machine;
	if sm == null return;
	sm.set_bool("o_carrying", carrying);
}

rr_mech_update_carried :: proc(carrier: Player, carried_player_id: u64, carried_corpse_id: u64) {
	if carrier == null return;
	// Float the grabbed entity well in front of the carrier (facing direction), with
	// a gentle bob so it visibly hovers in the grip.
	forward := 1.0;
	if carrier.entity.world_scale.x < 0.0 { forward = -1.0; }
	bob := sin(get_time() * 3.0) * 0.18;
	offset := v2.{forward * 1.8, 0.75 + bob};
	if carried_player_id != 0 {
		target := get_player_by_entity_id(carried_player_id);
		if target != null && target.player_state == Player_State.ALIVE {
			target.entity.set_local_position(carrier.entity.world_position + offset);
			target.agent.velocity = v2.{0, 0};

			// Route the held player's prediction through the carrier so its synced position
			// reconciles against the CARRIER's movement instead of its own (frozen) client.
			// Without this the held player predicts itself stuck in place while the carrier
			// teleports it each frame, and the 4-frame server reconciliation fights that —
			// the visible carry jitter. Mirrors Lily's mind-control puppet (player_for_prediction).
			// Cleared in Mech_Carried_Status.clear when the grab is released.
			target.player_for_prediction = carrier;

			// Held feedback: magnetised pose + VFX on the victim. Mech_Carried_Status
			// owns the edge-triggered movement lock (re-adding every frame would leak).
			rr_mech_mark_carried(target);
			rr_mech_mark_magnetised(target, false);

			// Guardian-only: draw protective shield (allies) or restraint (enemies)
			// so it's visually obvious whether the held player is being saved or subdued.
			if carrier.player_role == Player_Role.GUARDIAN {
				rr_guardian_draw_carry_aura(carrier, target);
			}
		}
	}
	if carried_corpse_id != 0 {
		c := rr_drag_body_find_corpse_by_entity_id(carried_corpse_id);
		if c != null {
			c.entity.set_local_position(carrier.entity.world_position + offset);
		}
	}
}

// Status applied while a player is held by a Mech/Guardian; drives the magnetised pose
// and is the source of truth for "grabbed". Refreshed each frame; auto-clears otherwise.
Mech_Carried_Status :: class : Component {
	active: bool;
	expires_at: float;

	refresh :: proc(using this: Mech_Carried_Status) {
		expires_at = get_time() + 0.2;
		if active return;
		active = true;
		p := entity.get_component(Player);
		if p == null return;
		p.add_disable_movement_input_reason(MECH_CARRY_REASON);
		if p.animator != null && p.animator.state_machine != null {
			p.animator.state_machine.set_bool("mech_magnetized", true);
		}
	}

	clear :: proc(using this: Mech_Carried_Status) {
		if !active return;
		active = false;
		p := entity.get_component(Player);
		if p == null return;
		p.remove_disable_movement_input_reason(MECH_CARRY_REASON);
		// Hand prediction back to the (former) victim's own client — see rr_mech_update_carried.
		p.player_for_prediction = null;
		if p.animator != null && p.animator.state_machine != null {
			p.animator.state_machine.set_bool("mech_magnetized", false);
		}
	}

	ao_update :: method(dt: float) {
		if !active return;
		if get_time() < expires_at return;
		clear(this);
	}

	ao_end :: method() { clear(this); }
}

rr_mech_mark_carried :: proc(target: Player) {
	if target == null || !#alive(target.entity) return;
	s := target.entity.get_component(Mech_Carried_Status);
	if s == null { s = target.entity.add_component(Mech_Carried_Status); }
	s.refresh();
}

rr_mech_is_carried :: proc(target: Player) -> bool {
	if target == null || !#alive(target.entity) return false;
	s := target.entity.get_component(Mech_Carried_Status);
	return s != null && s.active;
}

// Frees `target` from whoever is carrying it: any Guardian or Mech holding it drops
// the grab (carried_player_id = 0), which stops Mech_Carried_Status being refreshed so
// the movement lock auto-clears. Used by Minion recall to pull it out of a Guardian's grab.
rr_mech_release_carried :: proc(target: Player) {
	if target == null || !#alive(target.entity) return;
	for g: component_iterator(Guardian_Module) {
		if g != null && g.carried_player_id == target.entity.id { g.carried_player_id = 0; }
	}
	for m: component_iterator(Mech_Module) {
		if m != null && m.carried_player_id == target.entity.id { m.carried_player_id = 0; }
	}
	s := target.entity.get_component(Mech_Carried_Status);
	if s != null { s.clear(); }
}

// True while `target` is carried by an alive Guardian — makes Civilian allies
// invincible while held (per spec).
rr_guardian_is_protecting :: proc(target: Player) -> bool {
	if target == null return false;
	if !#alive(target.entity) return false;
	// Only Civilians ride the protection rail — Traitors are "subdued", not invincible.
	if target.player_type != Player_Type.CIVILIAN return false;
	for g: component_iterator(Guardian_Module) {
		if g == null continue;
		if !#alive(g.entity) continue;
		if g.carried_player_id != target.entity.id continue;
		carrier := g.entity.get_component(Player);
		if carrier == null continue;
		if carrier.player_state != Player_State.ALIVE continue;
		return true;
	}
	return false;
}

// Draws the world-space aura on the held player.
// Allies: pulsing green shield bubble. Enemies: red restraint glow.
rr_guardian_draw_carry_aura :: proc(carrier: Player, target: Player) {
	if target == null || !#alive(target.entity) return;
	ally := target.player_type == Player_Type.CIVILIAN;
	pos := target.entity.world_position + v2.{0, 0.55};
	pulse := 0.85 + sin(get_time() * 6.0) * 0.15;

	UI.push_world_draw_context();
	defer UI.pop_draw_context();
	UI.push_z(target.entity.world_position.y - 0.02);
	defer UI.pop_z();

	glow := get_asset(Texture_Asset, "sprites/Shapes/shape_circle_gradient.png");

	// Outer soft halo.
	color := ally ? v4.{0.45, 1.0, 0.55, 0.55 * pulse} : v4.{1.0, 0.32, 0.32, 0.55 * pulse};
	size := ally ? 1.5 : 1.3;
	r := Rect{pos, pos}.grow(size, size, size, size);
	UI.quad(r, glow, color);

	// Bright inner core sells the "bubble shield" / restraint cuff feel.
	inner_color := ally ? v4.{0.85, 1.0, 0.9, 0.7 * pulse} : v4.{1.0, 0.7, 0.55, 0.55 * pulse};
	UI.quad(r.grow(-0.55, -0.55, -0.55, -0.55), glow, inner_color);

	// Allies get a bubble-shield overlay on top for the obvious "protected" read.
	if ally {
		shield := get_asset(Texture_Asset, "minigame/Bubble Shield_16bc73.png");
		if shield != null {
			scale := 1.6 + sin(get_time() * 3.0) * 0.08;
			bubble_r := Rect{pos, pos}.grow(scale, scale, scale, scale);
			UI.quad(bubble_r, shield, v4.{0.7, 1.0, 0.8, 0.65});
		}
	}
}

rr_mech_find_melee_target :: proc(player: Player, allow_traitor: bool, exclude_transformed: bool = false) -> Player {
	finder := make_finder(Player, player.entity.world_position, MECH_MELEE_RANGE);
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p == player continue;
		if p.player_state != Player_State.ALIVE continue;
		if !#alive(p.entity) continue;
		if !allow_traitor && p.player_type == Player_Type.TRAITOR continue;
		// Conversion can't claim a transformed titan (e.g. a Guardian in their guardian form) —
		// the two titans settle things through a Showdown, not conversion.
		if exclude_transformed && rr_mech_is_transformed(p) continue;
		finder.check(p, p.entity.world_position);
	}
	return finder.closest;
}

rr_mech_find_pickup_target :: proc(player: Player) -> Player {
	finder := make_finder(Player, player.entity.world_position, MECH_MELEE_RANGE);
	for i: 0..players.elements.count-1 {
		p := players.elements[i];
		if p == null continue;
		if p == player continue;
		if p.player_state != Player_State.ALIVE continue;
		if !#alive(p.entity) continue;
		if rr_mech_is_transformed(p) continue;
		finder.check(p, p.entity.world_position);
	}
	return finder.closest;
}

// A Mech and a Guardian can grab the SAME victim from each other. When a new carrier grabs a
// victim, any other titan already holding them must immediately let go — the steal is free, with
// no cooldown to the previous holder (grabbing never costs a cooldown; only throwing does).
// Clearing carried_player_id stops Mech_Carried_Status being refreshed, releasing the previous
// holder's carry movement-lock on its own (ref-counted, single owner).
rr_mech_steal_carried_from_others :: proc(new_carrier: Player, victim_id: u64) {
	if new_carrier == null || victim_id == 0 return;
	for mech: component_iterator(Mech_Module) {
		if mech == null || mech.entity == null continue;
		if mech.entity.id == new_carrier.entity.id continue;
		if mech.carried_player_id == victim_id { mech.carried_player_id = 0; }
	}
	for guard: component_iterator(Guardian_Module) {
		if guard == null || guard.entity == null continue;
		if guard.entity.id == new_carrier.entity.id continue;
		if guard.carried_player_id == victim_id { guard.carried_player_id = 0; }
	}
}

rr_mech_find_nearby_corpse :: proc(player: Player) -> Corpse {
	finder := make_finder(Corpse, player.entity.world_position, MECH_LOOT_RANGE);
	for corpse: component_iterator(Corpse) {
		if corpse == null continue;
		if !#alive(corpse.entity) continue;
		if corpse.mech_core_looted continue;
		finder.check(corpse, corpse.entity.world_position);
	}
	return finder.closest;
}

// Every real task panel in the world is wreckable by the Mech / its Minions.
rr_mech_task_is_smashable :: proc(task: Task_Interactable) -> bool {
	if task == null return false;
	if !#alive(task.entity) return false;
	return task.get_task_id().count > 0;
}

// Stable lexicographic ordering (x then y) on quantised coords, so tiny float jitter can't
// reorder two panels and clients/server all agree on the ordering.
rr_mech_task_pos_orders_before :: proc(a: v2, b: v2) -> bool {
	ax := (a.x * 16.0).(int); ay := (a.y * 16.0).(int);
	bx := (b.x * 16.0).(int); by := (b.y * 16.0).(int);
	if ax != bx return ax < bx;
	return ay < by;
}

// The component a smashed task drops. Rather than a raw position hash (which can leave some kinds
// scarce), we RANK every registered task panel by world position and round-robin the four kinds
// across that ordering. The ordering is client-agnostic, so every client/server agrees without a
// shared mutable RNG, and the even 1/4-each spread guarantees that smashing all the panels yields
// enough of each kind to build every Mech upgrade.
rr_mech_task_drop_kind_at_pos :: proc(pos: v2) -> int {
	rank := 0;
	for i: 0..rr_task_destination_entries.elements.count-1 {
		e := rr_task_destination_entries.elements[i];
		if e == null continue;
		if rr_mech_task_pos_orders_before(e.pos, pos) { rank += 1; }
	}
	return MECH_COMPONENT_POWER_CELL + (rank % 4);
}

rr_mech_task_drop_kind :: proc(task: Task_Interactable) -> int {
	if task == null return MECH_COMPONENT_POWER_CELL;
	return rr_mech_task_drop_kind_at_pos(task.entity.world_position);
}

// True if this component kind can still be spent on an upgrade the Mech hasn't bought yet.
// Each weapon upgrade consumes one specific kind; Wreckage Warp accepts ANY kind, so while
// it's unowned every kind remains useful. Once everything that could consume a kind is built,
// that kind is dead weight and we stop dropping it.
rr_mech_component_kind_needed :: proc(mech: Mech_Module, kind: int) -> bool {
	if mech == null return true;
	if !mech.wreckage_warp_unlocked return true; // Warp accepts any component
	for up: MECH_UPGRADE_HELMET_TRAP..MECH_UPGRADE_MISSILE_BARRAGE {
		if rr_mech_upgrade_comp_kind(up) != kind continue;
		if !rr_mech_upgrade_owned(mech, up) return true;
	}
	return false;
}

// The component a smashed task actually drops for this smasher. Honors the panel's
// deterministic base kind, but if the Mech no longer needs that kind it rotates to the next
// kind it does need (keeping drops varied per panel). Returns 0 — meaning drop nothing — once
// the Mech needs no more components at all.
rr_mech_task_drop_kind_for :: proc(task: Task_Interactable, smasher: Player) -> int {
	base := rr_mech_task_drop_kind(task);
	owner := rr_mech_get_owner(smasher);
	mech: Mech_Module = null;
	if owner != null { mech = owner.entity.get_component(Mech_Module); }
	if mech == null return base;
	for i: 0..3 {
		kind := MECH_COMPONENT_POWER_CELL + (((base - MECH_COMPONENT_POWER_CELL) + i) % 4);
		if rr_mech_component_kind_needed(mech, kind) return kind;
	}
	return 0;
}

rr_mech_add_component_part :: proc(player: Player, kind: int) {
	if player == null return;
	mech := player.entity.get_component(Mech_Module);
	minion := rr_mech_get_minion_effect(player);
	if mech != null {
		// Collecting a raw component only banks the material. The avatar's bolt-on parts
		// reflect UNLOCKED upgrades (built at the workbench), not raw stock — so we do NOT
		// re-skin here. (Re-skinning from this per-frame pickup path also crashed on remote
		// clients whose Mech rig wasn't loaded yet.)
		if kind == MECH_COMPONENT_POWER_CELL { mech.power_cells += 1; }
		if kind == MECH_COMPONENT_CIRCUIT { mech.circuits += 1; }
		if kind == MECH_COMPONENT_SCHEMATIC { mech.schematics += 1; }
		if kind == MECH_COMPONENT_GEAR { mech.gears += 1; }
		if kind == MECH_COMPONENT_MAGNET_CORE { mech.magnet_cores += 1; }
		return;
	}
	if minion != null {
		if kind == MECH_COMPONENT_POWER_CELL { minion.power_cells += 1; }
		if kind == MECH_COMPONENT_CIRCUIT { minion.circuits += 1; }
		if kind == MECH_COMPONENT_SCHEMATIC { minion.schematics += 1; }
		if kind == MECH_COMPONENT_GEAR { minion.gears += 1; }
	}
}

rr_mech_component_name :: proc(kind: int) -> string {
	if kind == MECH_COMPONENT_POWER_CELL return "Power Cell";
	if kind == MECH_COMPONENT_CIRCUIT return "Circuit";
	if kind == MECH_COMPONENT_SCHEMATIC return "Schematic";
	if kind == MECH_COMPONENT_GEAR return "Gear";
	if kind == MECH_COMPONENT_MAGNET_CORE return "Magnet Core";
	return "Component";
}

rr_mech_component_sprite_path :: proc(kind: int) -> string {
	if kind == MECH_COMPONENT_POWER_CELL return "sprites/power_cell.png";
	if kind == MECH_COMPONENT_CIRCUIT return "sprites/cables.png";
	if kind == MECH_COMPONENT_SCHEMATIC return "sprites/blueprint.png";
	if kind == MECH_COMPONENT_GEAR return "sprites/gears.png";
	if kind == MECH_COMPONENT_MAGNET_CORE return MECH_MAGNET_CORE_TEX;
	return "sprites/power_cell.png";
}

rr_mech_component_tint :: proc(kind: int) -> v4 {
	if kind == MECH_COMPONENT_POWER_CELL return v4.{1.0, 0.3, 0.25, 0.7};
	if kind == MECH_COMPONENT_CIRCUIT return v4.{1.0, 0.85, 0.2, 0.65};
	if kind == MECH_COMPONENT_SCHEMATIC return v4.{0.3, 0.7, 1.0, 0.65};
	if kind == MECH_COMPONENT_GEAR return v4.{0.85, 0.85, 0.9, 0.7};
	if kind == MECH_COMPONENT_MAGNET_CORE return v4.{0.3, 0.85, 1.0, 0.7};
	return v4.{1.0, 1.0, 1.0, 0.65};
}

rr_mech_is_valid_pickup_collector :: proc(p: Player) -> bool {
	if p == null return false;
	if !#alive(p.entity) return false;
	if p.player_state != Player_State.ALIVE return false;
	if p.player_role == Player_Role.THE_MECH return true;
	if rr_mech_is_minion_active(p) return true;
	return false;
}

rr_mech_find_nearest_collector :: proc(pos: v2, max_range: float) -> Player {
	finder := make_finder(Player, pos, max_range);
	for p: component_iterator(Player) {
		if !rr_mech_is_valid_pickup_collector(p) continue;
		finder.check(p, p.entity.world_position);
	}
	return finder.closest;
}

rr_mech_spawn_component_pickup :: proc(pos: v2, kind: int, smasher: Player) {
	if kind == 0 return;
	e := Scene.create_entity();
	e.set_local_position(pos + v2.{0, 0.55});
	e.set_local_scale(v2.{0.7, 0.7});
	sr := e.add_component(Sprite_Renderer);
	sr.set_texture(get_asset(Texture_Asset, rr_mech_component_sprite_path(kind)));
	// Positive layer so the dropped part / Minion delivery flies ABOVE the floor — at -3 it was
	// buried under the ground for the whole arc.
	sr.layer = 6;
	pickup := e.add_component(Mech_Component_Pickup);
	pickup.kind = kind;
	pickup.spawn_pos = pos + v2.{0, 0.55};
	pickup.spawn_time = get_time();

	// Immediately home toward the smasher (or any valid collector) so the
	// component smoothly flies to the mech instead of waiting on the floor.
	target := smasher;
	if !rr_mech_is_valid_pickup_collector(target) {
		target = rr_mech_get_owner(smasher);
	}
	if rr_mech_is_valid_pickup_collector(target) {
		pickup.target_id = target.entity.id;
		pickup.arc_start_pos = pickup.spawn_pos;
		pickup.arc_start_time = get_time();
		pickup.arcing = true;
	}
	rr_mech_spawn_flash(pos + v2.{0, 0.5}, 0.7, rr_mech_component_tint(kind), 0.32);
}

rr_mech_find_smashable_task :: proc(player: Player) -> Task_Interactable {
	finder := make_finder(Task_Interactable, player.entity.world_position, MECH_SMASH_RANGE);
	for t: component_iterator(Task_Interactable) {
		if t == null continue;
		if !#alive(t.entity) continue;
		if t.mech_smashed continue;
		if !rr_mech_task_is_smashable(t) continue;
		finder.check(t, t.entity.world_position);
	}
	return finder.closest;
}

// --- Smash cooldown + channel feedback (shared by the Mech and its Minions) ---

// Where the smasher's smash-cooldown clock lives (Mech_Module for the Mech, Mech_Minion_Effect for
// a converted Minion). Returns 0 — i.e. "ready" — for anyone who can't smash.
rr_mech_smash_cooldown_until :: proc(player: Player) -> float {
	if player == null return 0.0;
	mech := player.entity.get_component(Mech_Module);
	if mech != null return mech.smash_cooldown_until;
	minion := rr_mech_get_minion_effect(player);
	if minion != null return minion.smash_cooldown_until;
	return 0.0;
}

rr_mech_smash_on_cooldown :: proc(player: Player) -> bool {
	return get_time() < rr_mech_smash_cooldown_until(player);
}

// True if this player has the role/form to smash task panels right now — IGNORING the cooldown
// and the specific panel's state. Shared by the Smash prompt's can_use and its cooldown-countdown
// so both agree on who is a smasher.
rr_mech_player_can_smash :: proc(player: Player) -> bool {
	if player == null return false;
	if player.player_state != Player_State.ALIVE return false;
	if player.player_role == Player_Role.THE_MECH {
		mech := player.entity.get_component(Mech_Module);
		return mech != null && (mech.is_mech_form || mech.is_apex);
	}
	return rr_mech_is_minion_active(player);
}

rr_mech_arm_smash_cooldown :: proc(player: Player) {
	if player == null return;
	until := get_time() + MECH_SMASH_COOLDOWN;
	mech := player.entity.get_component(Mech_Module);
	if mech != null { mech.smash_cooldown_until = until; return; }
	minion := rr_mech_get_minion_effect(player);
	if minion != null { minion.smash_cooldown_until = until; }
}

// One swing of the smash channel — the avatar slam for the Mech, a body punch for a Minion — plus
// light per-loop feedback. Re-fired once per anim loop while the Smash prompt is held so the smasher
// visibly keeps swinging for the whole 3-loop channel.
rr_mech_play_smash_gesture :: proc(player: Player, pos: v2) {
	if player == null return;
	if !rr_mech_is_transformed(player) {
		player.set_trigger("punch");
	}
	rr_mech_play_avatar_anim(player, "009SG/Smash_Task", false); // no-op for a non-transformed Minion
	rr_mech_spawn_flash(pos, 0.7, v4.{1.0, 0.55, 0.08, 0.45}, 0.2);
	rr_mech_add_screenshake(player, 0.05, 0.12);
	rr_mech_play_sfx_at("sfx/ggg_explode.wav", pos, 0.16);
}

rr_mech_smash_task :: proc(player: Player, task: Task_Interactable) {
	if player == null || task == null return;
	if !rr_mech_task_is_smashable(task) return;
	kind := rr_mech_task_drop_kind_for(task, player);
	task.mech_smashed = true;

	w := Scene.create_entity();
	w.set_local_position(task.entity.world_position);
	w.set_local_scale(v2.{0.9, 0.9});
	w.add_component(Spine_Animator);
	wreck := w.add_component(Mech_Wreckage);
	wreck.owner_id = player.entity.id;
	task.mech_wreckage_entity = w;

	rr_mech_spawn_component_pickup(task.entity.world_position, kind, player);

	// Final break impact (heavier than the per-loop channel swings).
	if !rr_mech_is_transformed(player) {
		player.set_trigger("punch");
	}
	rr_mech_play_avatar_anim(player, "009SG/Smash_Task", false);
	rr_mech_spawn_flash(task.entity.world_position, 0.95, v4.{1.0, 0.55, 0.08, 0.65}, 0.28);
	rr_mech_add_screenshake(player, 0.08, 0.2);
	rr_mech_play_sfx_at("sfx/ggg_explode.wav", task.entity.world_position, 0.28);

	// Re-arm the per-smasher cooldown so they can't immediately smash the next panel.
	rr_mech_arm_smash_cooldown(player);
}

// Closest real task panel to a world point, broken OR intact (unlike rr_mech_find_smashable_task,
// which skips already-smashed ones). Used when a thrown player slams down onto a task.
rr_mech_find_task_near :: proc(pos: v2, range: float) -> Task_Interactable {
	best: Task_Interactable = null;
	best_d := range * range;
	for t: component_iterator(Task_Interactable) {
		if t == null || !#alive(t.entity) continue;
		if !rr_mech_task_is_smashable(t) continue;
		d := length_squared(t.entity.world_position - pos);
		if d <= best_d { best_d = d; best = t; }
	}
	return best;
}

// The Mech's SPENDABLE pool — only components the Mech itself holds. A Minion's collected parts
// are NOT counted until they physically deliver them to the Mech (rr_mech_update_minion_delivery),
// at which point they fly over and bank into these same Mech counts.
rr_mech_count_component_pool :: proc(owner: Player, kind: int) -> int {
	if owner == null return 0;
	total := 0;
	mech := owner.entity.get_component(Mech_Module);
	if mech != null {
		if kind == MECH_COMPONENT_POWER_CELL { total += mech.power_cells; }
		if kind == MECH_COMPONENT_CIRCUIT { total += mech.circuits; }
		if kind == MECH_COMPONENT_SCHEMATIC { total += mech.schematics; }
		if kind == MECH_COMPONENT_GEAR { total += mech.gears; }
	}
	return total;
}

rr_mech_total_component_pool :: proc(owner: Player) -> int {
	return rr_mech_count_component_pool(owner, MECH_COMPONENT_POWER_CELL) +
		rr_mech_count_component_pool(owner, MECH_COMPONENT_CIRCUIT) +
		rr_mech_count_component_pool(owner, MECH_COMPONENT_SCHEMATIC) +
		rr_mech_count_component_pool(owner, MECH_COMPONENT_GEAR);
}

rr_mech_spend_component_pool :: proc(owner: Player, kind: int, count: int) -> bool {
	if owner == null return false;
	if rr_mech_count_component_pool(owner, kind) < count return false;
	remaining := count;
	mech := owner.entity.get_component(Mech_Module);
	if mech != null {
		while remaining > 0 {
			if kind == MECH_COMPONENT_POWER_CELL && mech.power_cells > 0 { mech.power_cells -= 1; remaining -= 1; continue; }
			if kind == MECH_COMPONENT_CIRCUIT && mech.circuits > 0 { mech.circuits -= 1; remaining -= 1; continue; }
			if kind == MECH_COMPONENT_SCHEMATIC && mech.schematics > 0 { mech.schematics -= 1; remaining -= 1; continue; }
			if kind == MECH_COMPONENT_GEAR && mech.gears > 0 { mech.gears -= 1; remaining -= 1; continue; }
			break;
		}
	}
	return true;
}

// Auto-delivery: a Minion holding collected parts who walks within range of the Mech hands them
// over — each part flies over as an arcing pickup and banks into the Mech's spendable pool. Called
// each frame from the Mech's update (only the Mech owner runs it, so each part is delivered once).
rr_mech_update_minion_delivery :: proc(mech_player: Player) {
	if mech_player == null || !#alive(mech_player.entity) return;
	if mech_player.player_state != Player_State.ALIVE return;
	mech_pos := mech_player.entity.world_position;
	for p: component_iterator(Player) {
		if p == null || !#alive(p.entity) continue;
		if p.player_state != Player_State.ALIVE continue;
		minion := rr_mech_get_minion_effect(p);
		if minion == null continue;
		if minion.converted_by_mech_id != mech_player.entity.id continue;
		held := minion.power_cells + minion.circuits + minion.schematics + minion.gears;
		if held <= 0 continue;
		if !in_range(p.entity.world_position - mech_pos, MECH_MINION_DELIVER_RANGE) continue;
		// Fly each held part over to the Mech (it banks into the Mech pool on arrival), then clear
		// the Minion's stock. spawn_component_pickup arcs toward the smasher's owner = the Mech.
		rr_mech_deliver_minion_kind(p, mech_player, MECH_COMPONENT_POWER_CELL, minion.power_cells); minion.power_cells = 0;
		rr_mech_deliver_minion_kind(p, mech_player, MECH_COMPONENT_CIRCUIT, minion.circuits);       minion.circuits = 0;
		rr_mech_deliver_minion_kind(p, mech_player, MECH_COMPONENT_SCHEMATIC, minion.schematics);   minion.schematics = 0;
		rr_mech_deliver_minion_kind(p, mech_player, MECH_COMPONENT_GEAR, minion.gears);             minion.gears = 0;
		rr_mech_play_sfx_at("$AO/sfx/FUI Holo Mechanism Activate.wav", p.entity.world_position, 0.3);
	}
}

// Spawns `count` arcing component pickups flying from the Minion to the Mech (which banks them
// into its pool on arrival). The caller zeroes the Minion's stock for that kind after calling.
rr_mech_deliver_minion_kind :: proc(minion_player: Player, mech_player: Player, kind: int, count: int) {
	if count <= 0 return;
	for i: 0..count-1 {
		rr_mech_spawn_component_pickup(minion_player.entity.world_position, kind, mech_player);
	}
}

rr_mech_spend_any_components :: proc(owner: Player, count: int) -> bool {
	if rr_mech_total_component_pool(owner) < count return false;
	remaining := count;
	for kind: MECH_COMPONENT_POWER_CELL..MECH_COMPONENT_GEAR {
		while remaining > 0 && rr_mech_count_component_pool(owner, kind) > 0 {
			rr_mech_spend_component_pool(owner, kind, 1);
			remaining -= 1;
		}
	}
	return true;
}

MECH_UPGRADE_HELMET_TRAP :: 1;
MECH_UPGRADE_RAM_CHARGE :: 2;
MECH_UPGRADE_MAGNET_CANNON :: 3;
MECH_UPGRADE_MISSILE_BARRAGE :: 4;
MECH_UPGRADE_WRECKAGE_WARP :: 5;

rr_mech_upgrade_owned :: proc(mech: Mech_Module, upgrade_id: int) -> bool {
	if mech == null return false;
	if upgrade_id == MECH_UPGRADE_HELMET_TRAP return mech.helmet_trap_unlocked;
	if upgrade_id == MECH_UPGRADE_RAM_CHARGE return mech.ram_charge_unlocked;
	if upgrade_id == MECH_UPGRADE_MAGNET_CANNON return mech.magnet_cannon_unlocked;
	if upgrade_id == MECH_UPGRADE_MISSILE_BARRAGE return mech.missile_barrage_unlocked;
	if upgrade_id == MECH_UPGRADE_WRECKAGE_WARP return mech.wreckage_warp_unlocked;
	return false;
}

// Resolved cost of the NEXT upgrade for this Mech — (components, magnet cores), with the
// core portion already waived if the Magnet Cannon isn't owned yet. Shared by the afford
// check, the purchase, and every cost label so the UI and the spend can't disagree.
rr_mech_next_upgrade_cost :: proc(mech: Mech_Module, upgrade_id: int) -> int, int {
	if mech == null return 0, 0;
	// Wreckage Warp is a flat utility buy — its price never escalates with build order; it always
	// costs a single ANY component (no cores), regardless of how many upgrades are already owned.
	if upgrade_id == MECH_UPGRADE_WRECKAGE_WARP return 1, 0;
	comp_cost, raw_core_cost := rr_mech_upgrade_cost(rr_mech_upgrades_owned_total(mech));
	return comp_cost, rr_mech_upgrade_core_cost(mech, raw_core_cost);
}

// The component a given upgrade is built from. The four weapons each need their own themed
// component; Wreckage Warp (0) accepts any component.
rr_mech_upgrade_comp_kind :: proc(upgrade_id: int) -> int {
	_, _, comp_kind, _ := rr_mech_upgrade_info(upgrade_id);
	return comp_kind;
}

rr_mech_upgrade_can_afford :: proc(player: Player, upgrade_id: int) -> bool {
	if player == null return false;
	mech := player.entity.get_component(Mech_Module);
	if mech == null return false;
	qty, core_cost := rr_mech_next_upgrade_cost(mech, upgrade_id);
	comp_kind := rr_mech_upgrade_comp_kind(upgrade_id);
	have := comp_kind != 0 ? rr_mech_count_component_pool(player, comp_kind) : rr_mech_total_component_pool(player);
	if have < qty return false;
	if mech.magnet_cores < core_cost return false;
	return true;
}

rr_mech_buy_upgrade :: proc(player: Player, upgrade_id: int) {
	if player == null return;
	if upgrade_id < MECH_UPGRADE_HELMET_TRAP || upgrade_id > MECH_UPGRADE_WRECKAGE_WARP return;
	mech := player.entity.get_component(Mech_Module);
	if mech == null return;
	if rr_mech_upgrade_owned(mech, upgrade_id) return;
	if !rr_mech_upgrade_can_afford(player, upgrade_id) return;

	// Charge the escalating cost (affordability gated above). The QUANTITY + cores scale with
	// how many upgrades are owned; the component TYPE is this upgrade's own (any for Warp).
	qty, core_cost := rr_mech_next_upgrade_cost(mech, upgrade_id);
	comp_kind := rr_mech_upgrade_comp_kind(upgrade_id);
	if comp_kind != 0 { rr_mech_spend_component_pool(player, comp_kind, qty); }
	else { rr_mech_spend_any_components(player, qty); }
	mech.magnet_cores -= core_cost;

	// Body-part upgrades intentionally do NOT re-skin here — rr_mech_update detects the
	// new part and plays the reveal flourish (and re-skins on every client). They also
	// close the workbench so the player watches the part bolt on.
	adds_body_part := false;
	if upgrade_id == MECH_UPGRADE_HELMET_TRAP {
		mech.helmet_trap_unlocked = true; player.Notify("Unlocked Helmet Trap."); adds_body_part = true;
	} else if upgrade_id == MECH_UPGRADE_RAM_CHARGE {
		mech.ram_charge_unlocked = true; player.Notify("Unlocked Ram Charge."); adds_body_part = true;
	} else if upgrade_id == MECH_UPGRADE_MAGNET_CANNON {
		mech.magnet_cannon_unlocked = true; player.Notify("Unlocked Magnet Cannon."); adds_body_part = true;
	} else if upgrade_id == MECH_UPGRADE_MISSILE_BARRAGE {
		mech.missile_barrage_unlocked = true; player.Notify("Unlocked Missile Barrage."); adds_body_part = true;
	} else if upgrade_id == MECH_UPGRADE_WRECKAGE_WARP {
		mech.wreckage_warp_unlocked = true; player.Notify("Unlocked Wreckage Warp.");
	}

	rr_mech_play_sfx_at("$AO/sfx/FUI Holo Mechanism Activate.wav", player.entity.world_position, 0.4);
	// A body-part build closes the bench so the reveal is visible; otherwise just flash.
	if adds_body_part {
		mech.workbench_ui_open = false;
	} else {
		rr_mech_spawn_flash(player.entity.world_position + v2.{0, 0.7}, 0.9, v4.{0.4, 0.85, 1.0, 0.6}, 0.32);
	}
}

// Workbench card click: buy if affordable, otherwise tell the player which component they're
// short on and flash that component's wreck markers on the minimap for 40s so they know what
// to smash and where to find it. Owned upgrades are a no-op (the card already reads "OWNED").
MECH_MINIMAP_HINT_SECONDS :: 40.0;
rr_mech_workbench_click_upgrade :: proc(player: Player, upgrade_id: int) {
	if player == null return;
	mech := player.entity.get_component(Mech_Module);
	if mech == null return;
	if rr_mech_upgrade_owned(mech, upgrade_id) return;
	if rr_mech_upgrade_can_afford(player, upgrade_id) {
		rr_mech_buy_upgrade(player, upgrade_id);
		return;
	}

	// Can't afford: figure out the shortfall. A component shortage is map-findable (the parts
	// drop from wrecked panels), so we flash it on the minimap. A pure Magnet Core shortfall
	// isn't on the map (cores come from magnetised players), so it just gets a directional tip.
	qty, core_cost := rr_mech_next_upgrade_cost(mech, upgrade_id);
	comp_kind := rr_mech_upgrade_comp_kind(upgrade_id);
	have := comp_kind != 0 ? rr_mech_count_component_pool(player, comp_kind) : rr_mech_total_component_pool(player);

	if have < qty {
		name := comp_kind != 0 ? rr_mech_component_name(comp_kind) : "Components";
		player.Notify(format_string("You are missing %, use the map to find it!", .{name}));
		mech.minimap_hint_kind = comp_kind; // 0 == any component → all four flash
		mech.minimap_hint_until = get_time() + MECH_MINIMAP_HINT_SECONDS;
		rr_mech_play_sfx_at("sfx/ui_error.wav", player.entity.world_position, 0.3);
	} else if mech.magnet_cores < core_cost {
		player.Notify("You are missing Magnet Cores — magnetise players with the Magnet Cannon!");
		rr_mech_play_sfx_at("sfx/ui_error.wav", player.entity.world_position, 0.3);
	}
}

rr_mech_can_awaken_apex :: proc(player: Player) -> bool {
	mech := player.entity.get_component(Mech_Module);
	if mech == null return false;
	if mech.apex_used || mech.apex_lost || mech.is_apex return false;
	if !mech.helmet_trap_unlocked || !mech.ram_charge_unlocked || !mech.magnet_cannon_unlocked || !mech.missile_barrage_unlocked return false;
	return mech.power_cores >= 2;
}

// Whether the Mech may convert (another) Minion right now. Classic rule is once-per-game
// (mech.conversion_used); MECH_ALLOW_MULTIPLE_MINIONS lifts that cap so it can convert repeatedly.
rr_mech_conversion_available :: proc(mech: Mech_Module) -> bool {
	if mech == null return false;
	if MECH_ALLOW_MULTIPLE_MINIONS return true;
	return !mech.conversion_used;
}

rr_mech_convert_target :: proc(mech_player: Player, target: Player) {
	if mech_player == null || target == null return;
	mech := mech_player.entity.get_component(Mech_Module);
	if mech == null return;
	if target.player_role == Player_Role.GUARDIAN {
		mech_player.Notify("TARGET INVALID");
		mech_player.Notify(format_string("% is Guardian.", .{target.entity.get_name()}));
			// Denied reject: shield bounce + error sting, golden shield burst over the target.
			// Conveys the attempt was repelled and tips the Mech off (no charge consumed).
		rr_mech_play_sfx_at("minigame/shield_block_390d4b.wav", target.entity.world_position, 0.42);
		rr_mech_play_sfx_at("sfx/ui_error.wav", mech_player.entity.world_position, 0.32);
		rr_mech_spawn_flash(target.entity.world_position + v2.{0, 0.55}, 1.05, v4.{1.0, 0.95, 0.45, 0.75}, 0.3);
		rr_mech_spawn_flash(target.entity.world_position + v2.{0, 0.55}, 0.55, v4.{1.0, 1.0, 0.85, 0.85}, 0.2);
		rr_mech_add_screenshake(mech_player, 0.08, 0.2);
		return;
	}
	// Civilians and Anarchists are convertible (they keep their original role's powers as a
	// Minion); only fellow Traitors are off-limits.
	if target.player_type == Player_Type.TRAITOR {
		mech_player.Notify("TARGET INVALID");
		return;
	}
	if rr_mech_is_minion_active(target) return;
	minion := new(Mech_Minion_Effect);
	minion.converted_by_mech_id = mech_player.entity.id;
	minion.original_role = target.player_role;
	minion.original_type = target.player_type;
	minion.saved_skins.clear();
	if target.animator != null && target.animator.instance != null {
		skins := target.animator.instance.get_skins();
		for i: 0..skins.count-1 {
			minion.saved_skins.append(skins[i]);
		}
	}
	minion.saved_color = target.avatar_color;
	mech.conversion_used = true;
	target.entity.add_passive_effect(minion);
	rr_mech_play_avatar_anim(mech_player, "009SG/Convert", false);
	rr_mech_spawn_flash(target.entity.world_position + v2.{0, 0.55}, 0.75, v4.{0.35, 0.9, 1.0, 0.7}, 0.32);
	mech_player.Notify(format_string("Converted %.", .{target.entity.get_name()}));
	rr_mech_play_sfx_at("sfx/zap.wav", target.entity.world_position, 0.35);
}

rr_mech_get_throw_direction :: proc(player: Player) -> v2 {
	// Throw straight ahead in the facing direction (rr_mech_update_carried uses the same
	// scale sign), so it launches where they look rather than the last aim point.
	if player.entity.world_scale.x < 0.0 {
		return v2.{-1, 0};
	}
	return v2.{1, 0};
}

rr_mech_is_near_magnet_node :: proc(pos: v2) -> bool {
	for m: component_iterator(Mech_Magnet_Node) {
		if m == null || !#alive(m.entity) continue;
		if in_range(m.entity.world_position - pos, 1.15) return true;
	}
	return false;
}

rr_mech_find_throw_path_hit :: proc(carrier: Player, target: Player, start_pos: v2, dir: v2, end_pos: ref v2, killer_id: u64) -> bool {
	traveled := MECH_THROW_STEP;
	last_valid := start_pos;
	while traveled <= MECH_THROW_DISTANCE {
		sample := start_pos + dir * traveled;
		nav_point: v2;
		tri_hint: s64;
		if !try_find_closest_point_on_navmesh(sample, ref nav_point, ref tri_hint) || length(nav_point - sample) > MECH_THROW_WALL_TOLERANCE {
			end_pos = last_valid;
			rr_mech_apply_stun(target, MECH_STUN_SECONDS);
			rr_mech_spawn_flash(end_pos, 0.55, v4.{1.0, 0.7, 0.3, 0.55}, 0.22);
			rr_mech_play_sfx_at("minigame/bonk_staff_77864c.wav", end_pos, 0.24);
			return true;
		}
		last_valid = sample;

		for m: component_iterator(Mech_Magnet_Node) {
			if m == null || !#alive(m.entity) continue;
			if !in_range(m.entity.world_position - sample, 1.15) continue;
			end_pos = m.entity.world_position;
			rr_mech_apply_stun(target, MECH_MAGNET_PULL_SECONDS);
			rr_mech_spawn_flash(end_pos, 0.7, v4.{0.3, 0.8, 1.0, 0.6}, 0.28);
			rr_mech_play_sfx_at("sfx/zap.wav", end_pos, 0.34);
			return true;
		}

		// (Wreckage / broken-task hits used to insta-kill here; that interaction now resolves on
		// landing in Mech_Thrown_Arc.settle — electrocute the victim + drop a Magnet Core — so the
		// flight is no longer stopped/killed by wreckage along the path.)

		for p: component_iterator(Player) {
			if p == null || p == target || p == carrier continue;
			if p.player_state != Player_State.ALIVE continue;
			if !in_range(p.entity.world_position - sample, 1.15) continue;
			end_pos = p.entity.world_position;
			target_helmet := target.entity.get_component(Mech_Helmeted_Status);
			if target_helmet != null && target_helmet.active {
				p.kill_with_killer(killer_id);
				rr_mech_spawn_flash(end_pos, 0.85, v4.{1.0, 0.2, 0.1, 0.65}, 0.25);
				rr_mech_play_sfx_at("sfx/other_death.wav", end_pos, 0.36);
			} else {
				rr_mech_apply_stun(p, MECH_STUN_SECONDS);
				rr_mech_apply_stun(target, MECH_STUN_SECONDS);
				rr_mech_spawn_flash(end_pos, 0.75, v4.{1.0, 0.85, 0.35, 0.55}, 0.22);
				rr_mech_play_sfx_at("minigame/bonk_staff_77864c.wav", end_pos, 0.22);
			}
			return true;
		}

		traveled += MECH_THROW_STEP;
	}
	return false;
}

// Flies a thrown player along a parabolic arc, owning their position for the flight
// (locks input). Re-applied each frame so it survives reconciliation; lands into stun pose.
Mech_Thrown_Arc :: class : Component {
	active: bool;
	landed: bool;
	start_pos: v2;
	end_pos: v2;
	start_time: float; // time-based so server reconciliation can't stall the flight
	duration: float;
	height: float;
	land_fx: bool; // play a touchdown thud/dust (off when a wall/player hit already did)
	thrown_by_id: u64; // the Mech that threw them — attributes a task-slam wreck / core drop on landing

	arm :: proc(using this: Mech_Thrown_Arc, from: v2, to: v2, impact_fx: bool, by_id: u64) {
		start_pos = from;
		end_pos = to;
		thrown_by_id = by_id;
		start_time = get_time();
		dist := length(to - from);
		duration = clamp(dist / 22.0, 0.18, 0.55); // ~22 u/s, clamped so short tosses still arc
		height = clamp(dist * 0.22, 0.7, 2.4);
		active = true;
		landed = false;
		land_fx = impact_fx;
		p := entity.get_component(Player);
		if p != null {
			p.add_disable_movement_input_reason(MECH_THROW_REASON);
			p.set_trigger("hitman_fly_forward");
		}
	}

	settle :: proc(using this: Mech_Thrown_Arc) {
		p := entity.get_component(Player);
		if p == null || !#alive(p.entity) return;
		p.entity.set_local_position(end_pos);
		p.agent.velocity = v2.{0, 0};
		p.remove_disable_movement_input_reason(MECH_THROW_REASON);
		// Land into the stun pose if still stunned, otherwise a quick recovery.
		stun := p.entity.get_component(Mech_Stun_Status);
		if stun != null && stun.active {
			p.set_trigger("hitman_broken_leg_idle");
		} else {
			p.set_trigger("hitman_collide_midair_land");
		}
		// Touchdown impact for an open-space landing (wall/player hits already played
		// their own collision feedback on the way down).
		if land_fx {
			rr_mech_spawn_flash(end_pos + v2.{0, 0.1}, 0.85, v4.{0.95, 0.9, 0.7, 0.55}, 0.24);
			rr_mech_play_sfx_at("minigame/bonk_staff_77864c.wav", end_pos, 0.26);
			rr_mech_add_screenshake(p, 0.07, 0.16);
		}

		// Slammed down onto a task panel: WRECK an intact one; on an already-broken one ELECTROCUTE
		// the victim instead. Either way the impact knocks a Magnet Core loose for the throwing Mech.
		thrower := get_player_by_entity_id(thrown_by_id);
		if thrower != null {
			task := rr_mech_find_task_near(end_pos, MECH_THROW_SLAM_RANGE);
			if task != null {
				if !task.mech_smashed {
					rr_mech_smash_task(thrower, task);
				} else {
					vstun := p.entity.get_component(Mech_Stun_Status);
					if vstun == null { vstun = p.entity.add_component(Mech_Stun_Status); }
					vstun.arm(MECH_THROW_SLAM_ELECTROCUTE, true); // electric shock pose, shows its own timer
				}
				rr_mech_spawn_component_pickup(end_pos, MECH_COMPONENT_MAGNET_CORE, thrower);
				rr_mech_spawn_flash(end_pos + v2.{0, 0.3}, 0.7, v4.{0.3, 0.85, 1.0, 0.7}, 0.3, 6);
				rr_mech_play_sfx_at("sfx/zap.wav", end_pos, 0.34);
			}
		}
	}

	ao_update :: method(dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null || !#alive(p.entity) { active = false; return; }
		if p.player_state != Player_State.ALIVE {
			// Killed mid-flight (thrown into a hazard) — drop them on the spot.
			p.entity.set_local_position(end_pos);
			p.remove_disable_movement_input_reason(MECH_THROW_REASON);
			active = false;
			return;
		}
		t := (get_time() - start_time) / duration;
		if t >= 1.0 {
			// Land exactly once, then release control so movement isn't pinned.
			if !landed { landed = true; settle(this); }
			active = false;
			return;
		}
		pos := v2.{
			lerp(start_pos.x, end_pos.x, t),
			lerp(start_pos.y, end_pos.y, t),
		};
		pos.y += height * 4.0 * t * (1.0 - t); // parabola, peaks at mid-flight
		p.entity.set_local_position(pos);
		p.agent.velocity = v2.{0, 0};
	}

	ao_end :: method() {
		p := entity.get_component(Player);
		if p != null { p.remove_disable_movement_input_reason(MECH_THROW_REASON); }
	}
}

rr_mech_arc_throw :: proc(target: Player, from: v2, to: v2, land_fx: bool, by_id: u64) {
	if target == null || !#alive(target.entity) return;
	a := target.entity.get_component(Mech_Thrown_Arc);
	if a == null { a = target.entity.add_component(Mech_Thrown_Arc); }
	a.arm(from, to, land_fx, by_id);
}

rr_mech_throw_player :: proc(carrier: Player, target: Player, killer_id: u64, aim_dir: v2) {
	if carrier == null || target == null return;
	// Carry lock is released by Mech_Carried_Status when no longer refreshed; the throw
	// arc/stun keep movement locked, so don't touch the ref-counted reason here.
	// Throw toward the aimed direction; fall back to facing direction if the aim is degenerate
	// (e.g. mouse on top of the carrier) so the unit-length start/end math below stays valid.
	dir := aim_dir;
	if length(dir) < 0.01 { dir = rr_mech_get_throw_direction(carrier); }
	else { dir = normalize(dir); }
	start_pos := carrier.entity.world_position + dir * 0.8;
	end_pos := carrier.entity.world_position + dir * MECH_THROW_DISTANCE;
	path_hit := rr_mech_find_throw_path_hit(carrier, target, start_pos, dir, ref end_pos, killer_id);
	// Toss the victim along a natural arc from the carrier to the landing spot
	// instead of teleporting them. Dead targets (hit a hazard) just snap to the spot.
	if target.player_state == Player_State.ALIVE {
		// land_fx only on a clean open landing — wall/player hits already played their
		// own collision feedback in the path scan.
		rr_mech_arc_throw(target, start_pos, end_pos, !path_hit, killer_id);
	} else {
		target.entity.set_local_position(end_pos);
	}
	// Throw gesture rides the overlay track so the titan keeps locomoting underneath.
	rr_mech_play_overlay_oneshot(carrier, "009SG/Throw_Player_AL");
	rr_mech_play_sfx_at("sfx/killer_transform.wav", carrier.entity.world_position, 0.2);
	rr_mech_add_screenshake(carrier, 0.09, 0.18);
	if path_hit return;

	// Landing onto a task panel (intact -> wreck it; already-broken -> electrocute the victim, +
	// a Magnet Core either way) is handled at touchdown in Mech_Thrown_Arc.settle, so it lands with
	// the arc instead of resolving instantly here.

	for p: component_iterator(Player) {
		if p == null || p == target || p == carrier continue;
		if p.player_state != Player_State.ALIVE continue;
		if !in_range(p.entity.world_position - end_pos, 1.2) continue;
		target_helmet := target.entity.get_component(Mech_Helmeted_Status);
		if target_helmet != null && target_helmet.active {
			p.kill_with_killer(killer_id);
		} else {
			rr_mech_apply_stun(p, MECH_STUN_SECONDS);
			rr_mech_apply_stun(target, MECH_STUN_SECONDS);
		}
		return;
	}
	rr_mech_apply_stun(target, MECH_STUN_SECONDS);
}

rr_mech_apply_stun :: proc(target: Player, seconds: float) {
	if target == null return;
	stun := target.entity.get_component(Mech_Stun_Status);
	if stun == null { stun = target.entity.add_component(Mech_Stun_Status); }
	stun.arm(seconds);
}

rr_mech_release_guardian_pickup_if_needed :: proc(target: Player) {
	if target == null return;
	guard := target.entity.get_component(Guardian_Module);
	if guard == null return;
	if guard.carried_player_id != 0 {
		// Clearing carried_player_id stops Mech_Carried_Status being refreshed, which
		// releases the carry movement lock on its own (ref-counted, single owner).
		guard.carried_player_id = 0;
		target.Notify("Ram Charge broke your hold!");
	}
}

rr_mech_draw_abilities :: proc(player: Player, idx: int) -> int {
	abilityIndex := idx;
	mech := player.entity.get_component(Mech_Module);
	if mech == null return abilityIndex;
	// During a Showdown the kit is hidden — mashing is the big bottom-center button
	// (rr_mech_draw_showdown_hud), not an ability-bar slot.
	if mech.showdown_active return abilityIndex;
	// Downed (faked death) — the whole kit is hidden; the ONLY button is "Call Minion" (a distress
	// ping), and only while a living Minion can still revive it.
	if mech.showdown_downed {
		if !mech.minion_revive_used && rr_mech_get_living_minion(player) != null {
			draw_ability_button(player, Mech_Call_Minion_Ability, abilityIndex); abilityIndex += 1;
		}
		return abilityIndex;
	}
	// Schleem form — gathering / utility kit (well under the bar limit).
	if !mech.is_mech_form && !mech.is_apex {
		draw_ability_button(player, Kill_Ability, abilityIndex); abilityIndex += 1;
		draw_ability_button(player, Mech_Transform_Ability, abilityIndex); abilityIndex += 1;
		draw_ability_button(player, Drag_Body_Ability, abilityIndex); abilityIndex += 1;
		if mech.helmet_trap_unlocked { draw_ability_button(player, Mech_Helmet_Trap_Ability, abilityIndex); abilityIndex += 1; }
		// Recall Minion — only while a living Minion exists.
		if rr_mech_get_living_minion(player) != null && abilityIndex < 6 { draw_ability_button(player, Mech_Invoke_Minion_Ability, abilityIndex); abilityIndex += 1; }
		return abilityIndex;
	}

	// Driving the Ram car: the whole kit is swapped out for the drive. APEX gets a Boost button
	// (turbo fire); both forms get an Exit button to bail early. Returning here keeps us clear of
	// the 6-cap.
	if rr_mech_car_is_active(player) {
		if mech.is_apex && abilityIndex < 6 { draw_ability_button(player, Mech_Car_Boost_Ability, abilityIndex); abilityIndex += 1; }
		if abilityIndex < 6 { draw_ability_button(player, Mech_Car_Exit_Ability, abilityIndex); abilityIndex += 1; }
		return abilityIndex;
	}

	// Mech / APEX form. The engine ability bar holds at most 6 buttons (button_offsets is a
	// fixed [6]). The two "ultimate" buttons (APEX Awakening, End Game) live in a custom
	// bottom-middle widget instead (rr_mech_draw_titan_buttons), so the regular kit fits
	// comfortably here. Hard-cap kept as a safety net; target tools stay contextual.
	if abilityIndex < 6 { draw_ability_button(player, Kill_Ability, abilityIndex); abilityIndex += 1; }
	// Transform-back is hidden in APEX — it can't revert form (the toggle forces is_mech_form
	// back on), so the button would be a no-op.
	if !mech.is_apex && abilityIndex < 6 { draw_ability_button(player, Mech_Transform_Ability, abilityIndex); abilityIndex += 1; }
	if mech.ram_charge_unlocked && abilityIndex < 6 { draw_ability_button(player, Mech_Ram_Charge_Ability, abilityIndex); abilityIndex += 1; }
	if mech.magnet_cannon_unlocked && abilityIndex < 6 { draw_ability_button(player, Mech_Magnet_Cannon_Ability, abilityIndex); abilityIndex += 1; }
	if mech.missile_barrage_unlocked && abilityIndex < 6 { draw_ability_button(player, Mech_Missile_Barrage_Ability, abilityIndex); abilityIndex += 1; }

	// Recall Minion is intentionally NOT shown in Mech / APEX form — it only appears on the
	// schleem (human) kit. The Mech recalls its Minion before transforming.

	// Pickup/Throw — always shown; greyed out (via can_use) when nothing is carried and no
	// target/corpse is in reach. Subject to the 6-slot bar cap.
	if abilityIndex < 6 { draw_ability_button(player, Mech_Pickup_Throw_Ability, abilityIndex); abilityIndex += 1; }

	// Smash (above task panels) and Convert (hovers over nearest civ) are world
	// interactables now, not bar buttons — see Mech_Smash_Interactable / Mech_Convert_Interactable.
	// Wreckage Warp lives on the minimap buttons (rr_mech_draw_wreckage_warp_minimap_buttons).
	return abilityIndex;
}

// The Minion-SPECIFIC kit (drawn on top of the Minion's preserved original-role abilities, which
// rr_draw_traitor_abilities draws first via rr_draw_role_abilities). Kept to the Minion-only bits.
// The original kit is small (<=3) + this adds one, so the 6-slot bar is never exceeded.
rr_minion_draw_abilities :: proc(player: Player, idx: int) -> int {
	abilityIndex := idx;
	// Smash is a world interactable (Mech_Smash_Interactable) — minions use the same prompt.
	if abilityIndex < 6 { draw_ability_button(player, Drag_Body_Ability, abilityIndex); abilityIndex += 1; }
	// Reviving a downed master is a WORLD interact prompt on the master's body
	// (Mech_Downed_Revive_Interactable), not an ability button — walk up and hold to revive.
	// Wreckage Warp lives on the minimap node buttons (rr_mech_draw_wreckage_warp_minimap_buttons),
	// shared with the Mech — minions click a wreckage on the map to warp once it's unlocked.
	return abilityIndex;
}

rr_guardian_draw_abilities :: proc(player: Player, idx: int) -> int {
	abilityIndex := idx;
	guard := player.entity.get_component(Guardian_Module);
	if guard == null return abilityIndex;
	// During a Showdown the kit is hidden — mashing is the big bottom-center button.
	if guard.showdown_active return abilityIndex;
	draw_ability_button(player, Guardian_Transform_Ability, abilityIndex); abilityIndex += 1;
	if guard.is_guardian_form {
		draw_ability_button(player, Guardian_Pickup_Throw_Ability, abilityIndex); abilityIndex += 1;
		draw_ability_button(player, Guardian_Shockwave_Ability, abilityIndex); abilityIndex += 1;
		// Always shown in Guardian form: greyed when no titan-form Mech is in range (can_use),
		// greyed with a countdown while on the re-challenge cooldown (current_cooldown driven in
		// on_update), and normal/usable otherwise.
		if abilityIndex < 6 { draw_ability_button(player, Guardian_Showdown_Ability, abilityIndex); abilityIndex += 1; }
	}
	return abilityIndex;
}

Mech_Workbench_Interactable :: class : Interactable {
	ao_start :: method() {
		this.set_listener(this);
		this.set_text("R&D Workbench");
		this.set_hold_text("Opening...");
		required_hold_time = 0.3;
		radius = 3.5;
		prompt_offset = v2.{0, 1.4};
		priority = 200;
	}
	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if player.player_role != Player_Role.THE_MECH return false;
		if player.player_state != Player_State.ALIVE return false;
		return true;
	}
	on_interact :: method(player: Player) {
		mech := player.entity.get_component(Mech_Module);
		if mech != null {
			mech.workbench_ui_open = true;
			mech.visited_workbench = true; // completes the "Go to R&D Workbench" first objective
		}
		rr_mech_spawn_flash(entity.world_position + v2.{0, 0.55}, 0.75, v4.{0.25, 0.8, 1.0, 0.55}, 0.28);
		rr_mech_play_sfx_at("$AO/sfx/FUI Holo Mechanism Activate.wav", entity.world_position, 0.35);
	}
}

Mech_Loot_Corpse_Interactable :: class : Interactable {
	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Loot Core");
		this.set_hold_text("Extracting...");
		required_hold_time = 0.5;
		radius = 3.0;
		priority = 70;
	}
	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if player.player_role != Player_Role.THE_MECH return false;
		if player.player_state != Player_State.ALIVE return false;
		// Loot works in both forms (Schleem & Mech) — it's a world interactable, not a
		// bar button, so it doesn't compete for ability slots.
		corpse := entity.get_component(Corpse);
		if corpse == null return false;
		return !corpse.mech_core_looted;
	}
	on_interact :: method(player: Player) {
		corpse := entity.get_component(Corpse);
		if corpse == null || corpse.mech_core_looted return;
		mech := player.entity.get_component(Mech_Module);
		if mech == null return;
		corpse.mech_core_looted = true;
		mech.power_cores += 1;
		rr_mech_play_avatar_anim(player, "009SG/Loot_Body", false);
		rr_mech_spawn_flash(entity.world_position + v2.{0, 0.55}, 0.55, v4.{1.0, 0.15, 0.08, 0.65}, 0.35);
		rr_mech_play_sfx_at("sfx/pick_up_item_a973cc.wav", entity.world_position, 0.32);
		player.Notify(format_string("+1 Power Core (% total)", .{mech.power_cores}));
	}
}

// Loot a Magnet Core from a living, HELMETED player the Mech has magnetised to a Magnet Rod.
// This is the ONLY way to farm Magnet Cores — a player must be wearing a Magnet Helmet AND be
// pinned by a rod's field; grabbing/holding a player never yields a core. Lives on the victim's
// entity (added by Mech_Magnetised_Status).
Mech_Magnet_Loot_Interactable :: class : Interactable {
	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Loot Magnet Core");
		this.set_hold_text("Extracting...");
		required_hold_time = 0.5;
		radius = MECH_LOOT_RANGE;
		prompt_offset = v2.{0, 1.4};
		priority = 75;
	}
	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if player.player_role != Player_Role.THE_MECH return false;
		if player.player_state != Player_State.ALIVE return false;
		// Must still be wearing a Magnet Helmet — only helmeted rod victims drop cores.
		helmet := entity.get_component(Mech_Helmeted_Status);
		if helmet == null || !helmet.active return false;
		mag := entity.get_component(Mech_Magnetised_Status);
		if mag == null || !mag.active || mag.core_looted return false;
		return true;
	}
	on_interact :: method(player: Player) {
		helmet := entity.get_component(Mech_Helmeted_Status);
		if helmet == null || !helmet.active return;
		mag := entity.get_component(Mech_Magnetised_Status);
		if mag == null || !mag.active || mag.core_looted return;
		mech := player.entity.get_component(Mech_Module);
		if mech == null return;
		mag.core_looted = true;
		mech.magnet_cores += 1;
		rr_mech_play_avatar_anim(player, "009SG/Loot_Body", false);
		rr_mech_spawn_flash(entity.world_position + v2.{0, 0.55}, 0.6, v4.{0.3, 0.85, 1.0, 0.7}, 0.35);
		rr_mech_spawn_lightning_strike(entity.world_position, 0.7);
		rr_mech_play_sfx_at("sfx/zap.wav", entity.world_position, 0.34);
		player.Notify(format_string("+1 Magnet Core (% total)", .{mech.magnet_cores}));
	}
}

// The Mech's single living Minion (conversion is once per game), or null.
rr_mech_get_living_minion :: proc(mech_player: Player) -> Player {
	if mech_player == null return null;
	for p: component_iterator(Player) {
		if p == null || !#alive(p.entity) continue;
		if p.player_state != Player_State.ALIVE continue;
		minion := rr_mech_get_minion_effect(p);
		if minion == null continue;
		if minion.converted_by_mech_id != mech_player.entity.id continue;
		return p;
	}
	return null;
}

// A short-lived red recall portal VFX (reuses the Portal Maker rig + "red" skin): appear -> idle
// loop -> self-destruct. Purely cosmetic — the actual teleport is done by rr_mech_invoke_minion.
Mech_Recall_Portal :: class : Component {
	LIFETIME :: 1.6;
	APPEAR :: 0.5;
	spawn_time: float;
	looped: bool;
	ao_start :: method() { spawn_time = get_time(); }
	ao_update :: method(dt: float) {
		age := get_time() - spawn_time;
		spine := entity.get_component(Spine_Animator);
		if !looped && age >= APPEAR {
			if spine != null && spine.instance != null { spine.instance.set_animation("004RAND/portals/active/idleloop", true, 0); }
			looped = true;
		}
		if age >= LIFETIME { entity.destroy(); }
	}
}

rr_mech_spawn_recall_portal :: proc(pos: v2) {
	e := Scene.create_entity();
	e.set_local_position(pos);
	e.set_local_scale(v2.{1.0, 1.0});
	spine := e.add_component(Spine_Animator);
	spine.awaken();
	spine.layer = 0;
	spine.depth_offset = 1.0;
	if spine.instance != null {
		spine.instance.set_skeleton(get_asset(Spine_Asset, MECH_PORTAL_RIG));
		spine.instance.set_skin("red");
		spine.instance.refresh_skins();
		spine.instance.set_animation("004RAND/portals/active/appear", false, 0);
	}
	e.add_component(Mech_Recall_Portal);
}

// Invoke Minion: open a red portal at the Minion and at the Mech, and teleport the Minion to the
// Mech's side. Safe on client + server (the teleport is a synced position set, matching the
// Wreckage Warp). Only ever one Minion exists (conversion is once per game). Cooldown is owned by
// the ability (current_cooldown).
rr_mech_invoke_minion :: proc(mech_player: Player) {
	if mech_player == null || !#alive(mech_player.entity) return;
	minion := rr_mech_get_living_minion(mech_player);
	if minion == null return;

	// Recall yanks the Minion out of any Guardian's (or Mech's) grab — clearing the
	// carrier's carried_player_id stops Mech_Carried_Status being refreshed, so the
	// movement lock / magnetised pose auto-release within a frame.
	rr_mech_release_carried(minion);

	from := minion.entity.world_position;
	// Land the Minion just beside the Mech, clamped onto walkable navmesh.
	dest := rr_mech_clamp_to_ground(mech_player.entity.world_position + v2.{1.2, 0});
	rr_mech_spawn_recall_portal(from);
	rr_mech_spawn_recall_portal(dest);
	rr_mech_spawn_warp_vfx(from);
	rr_mech_spawn_warp_vfx(dest);
	minion.entity.set_local_position(dest);
	minion.agent.velocity = v2.{0, 0};
	rr_mech_play_sfx_at("sfx/zap.wav", from, 0.35);
	rr_mech_play_sfx_at("sfx/zap.wav", dest, 0.4);
	mech_player.Notify("Minion recalled!");
}

// Invoke Minion recall as a regular ability-bar button. Shown (in rr_mech_draw_abilities) only
// while the Mech has a living Minion to recall.
Mech_Invoke_Minion_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Invoke_Minion_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Convert_Player_Icon.png"); }
	can_use :: method() -> bool {
		if player.player_role != Player_Role.THE_MECH || player.player_state != Player_State.ALIVE return false;
		return rr_mech_get_living_minion(player) != null;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_mech_invoke_minion(player);
			current_cooldown = MECH_INVOKE_MINION_COOLDOWN;
		}
	}
	on_draw_button :: proc(instance: Mech_Invoke_Minion_Ability, rect: Rect) { draw_ability_name_label(rect, "Recall"); }
}

// Smash Task as a world interactable (prompt above the task panel) instead of an ability
// button. Shares the task entity with the civilian Task_Interactable; can_use gates by
// role so each side only sees its own prompt. Usable by the mech (mech form) and minions.
Mech_Smash_Interactable :: class : Interactable {
	// Throttles the per-loop swing in on_holding so the avatar re-swings once per anim loop
	// (instead of every frame) for the whole 3-loop channel.
	next_swing_at: float;

	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Smash");
		this.set_hold_text("Smashing...");
		// Smashing is a deliberate channel: hold for 3 loops of the smash animation.
		required_hold_time = MECH_SMASH_HOLD_TIME;
		radius = MECH_SMASH_RANGE;
		prompt_offset = v2.{0, 1.4};
		priority = 90;
	}
	ao_update :: method(dt: float) {
		// While the local smasher is on cooldown, keep the prompt visible but show a live
		// countdown instead of hiding it. Drop the hold time to 0 so the disabled prompt can't
		// fill a fake hold-bar (the on_interact guard blocks the smash regardless). Prompt text
		// renders per-client, so we key off the LOCAL player's own cooldown.
		lp, ok := Game.get_local_player();
		if ok && rr_mech_player_can_smash(lp) && rr_mech_smash_on_cooldown(lp) {
			remaining := (rr_mech_smash_cooldown_until(lp) - get_time()).(int) + 1;
			this.set_text(format_string("Smash (%s)", {remaining}));
			required_hold_time = 0.0;
		} else {
			this.set_text("Smash");
			required_hold_time = MECH_SMASH_HOLD_TIME;
		}
	}
	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if !rr_mech_player_can_smash(player) return false;
		task := entity.get_component(Task_Interactable);
		if task == null return false;
		if task.mech_smashed return false;
		// On cooldown: keep the prompt visible (ao_update shows the countdown); the on_interact
		// guard blocks the actual smash until it's ready.
		return rr_mech_task_is_smashable(task);
	}
	on_holding :: method(player: Player) {
		if player == null return;
		// Disabled mid-cooldown — no smash swing while the countdown prompt is showing.
		if rr_mech_smash_on_cooldown(player) return;
		// Re-fire the smash swing once per anim loop so it visibly loops during the hold.
		if get_time() < next_swing_at return;
		next_swing_at = get_time() + MECH_SMASH_ANIM_LOOP;
		rr_mech_play_smash_gesture(player, entity.world_position);
	}
	on_interact :: method(player: Player) {
		// Still cooling down — the prompt shows the countdown only, no smash.
		if rr_mech_smash_on_cooldown(player) return;
		task := entity.get_component(Task_Interactable);
		if task == null return;
		rr_mech_smash_task(player, task);
	}
}

// The player currently grabbed by this Mech, IF they're a valid conversion target (alive,
// non-traitor, non-guardian, not already a minion, conversion still available). Conversion now
// requires the Mech to be physically holding the victim — see Mech_Convert_Interactable.
rr_mech_carried_convert_target :: proc(mech_player: Player) -> Player {
	if mech_player == null return null;
	mech := mech_player.entity.get_component(Mech_Module);
	if mech == null || !rr_mech_conversion_available(mech) return null;
	if !mech.is_mech_form && !mech.is_apex return null;
	if mech.carried_player_id == 0 return null;
	t := get_player_by_entity_id(mech.carried_player_id);
	if t == null || !#alive(t.entity) return null;
	if t.player_state != Player_State.ALIVE return null;
	if t.player_role == Player_Role.GUARDIAN return null;
	// Civilians and Anarchists are convertible (they keep their original role's powers as a
	// Minion); only fellow Traitors are off-limits.
	if t.player_type == Player_Type.TRAITOR return null;
	if rr_mech_is_minion_active(t) return null;
	return t;
}

// Conversion as a world interactable that hovers over the player the Mech is GRABBING. The Mech
// must first grab a civilian (Mech_Pickup_Throw_Ability) — only then does the Convert prompt
// appear over the held victim. One per round; parks itself offscreen when there's no held target
// or after the once-per-game conversion has been used.
Mech_Convert_Interactable :: class : Interactable {
	target_id: u64;
	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Convert");
		this.set_hold_text("Converting...");
		required_hold_time = 0.6;
		// Generous radius: the grabbed victim floats ~1.8 units in front of the Mech.
		radius = 3.0;
		prompt_offset = v2.{0, 1.2};
		priority = 95;
	}
	ao_update :: method(dt: float) {
		target_id = 0;
		if game_state == Game_State.INGAME {
			for i: 0..players.elements.count-1 {
				mp := players.elements[i];
				if mp == null continue;
				if mp.player_role != Player_Role.THE_MECH continue;
				if mp.player_state != Player_State.ALIVE continue;
				// Hover the prompt over the held, convertible victim (if any).
				t := rr_mech_carried_convert_target(mp);
				if t != null {
					target_id = t.entity.id;
					entity.set_local_position(t.entity.world_position);
				}
				break;
			}
		}
		if target_id == 0 {
			entity.set_local_position(v2.{99999, 99999});
		}
	}
	can_use :: method(player: Player) -> bool {
		if player == null || player.player_role != Player_Role.THE_MECH return false;
		if player.player_state != Player_State.ALIVE return false;
		t := rr_mech_carried_convert_target(player);
		return t != null && t.entity.id == target_id;
	}
	on_interact :: method(player: Player) {
		t := get_player_by_entity_id(target_id);
		if t == null return;
		mech := player.entity.get_component(Mech_Module);
		rr_mech_convert_target(player, t);
		// Release the freshly-converted minion from the carry.
		if mech != null && mech.carried_player_id == t.entity.id { mech.carried_player_id = 0; }
	}
}

Mech_Flash_Vfx :: class : Component {
	start_time: float;
	duration: float;
	start_scale: float;
	end_scale: float;
	color: v4;
	ao_start :: method() {
		start_time = get_time();
		if duration <= 0.0 { duration = 0.2; }
	}
	ao_update :: method(dt: float) {
		t := clamp((get_time() - start_time) / duration, 0.0, 1.0);
		scale := lerp(start_scale, end_scale, t);
		entity.set_local_scale(v2.{scale, scale});
		sr := entity.get_component(Sprite_Renderer);
		if sr != null {
			sr.color = v4.{color.x, color.y, color.z, color.w * (1.0 - t)};
		}
		if t >= 1.0 {
			entity.destroy();
		}
	}
}

Mech_Transform_Vfx_Effect :: class : Effect_Base {
	effect_end :: method(interrupt: bool) {
		if #alive(entity) entity.destroy();
	}
}

Mech_Screenshake_Status :: class : Component {
	start_time: float;
	ends_at: float;
	intensity: float;
	arm :: proc(using this: Mech_Screenshake_Status, amount: float, seconds: float) {
		start_time = get_time();
		ends_at = start_time + seconds;
		intensity = max(intensity, amount);
	}
	ao_update :: method(dt: float) {
		p := entity.get_component(Player);
		if p == null || !p.is_local() return;
		if get_time() >= ends_at {
			intensity = 0.0;
			return;
		}
		// During the End Game cinematic the endgame camera owns the position (and layers in
		// this same shake on top of the cinematic framing). A raw override here would snap the
		// view down to the grounded body every missile wave, fighting the cinematic.
		mech := entity.get_component(Mech_Module);
		if mech != null && mech.endgame_active return;
		// Same deal during a Showdown: the showdown camera owns the (clash-centred) position
		// and layers this shake in on top. A raw override here would snap the view off the
		// clash onto the local body on every mash press.
		if rr_mech_any_showdown_active() return;
		// And during Missile Barrage placement / the post-fire cam hold: the free-cam owns the
		// position (parked over the strike zone). Without this, the launch shake (and nearby blast
		// shakes) would snap the view back onto the Mech, making it flicker between the Mech and the
		// landing point.
		if mech != null && (mech.missile_aim_active || get_time() < mech.missile_cam_hold_until) return;
		duration := ends_at - start_time;
		if duration <= 0.0 return;
		remaining := (ends_at - get_time()) / duration;
		amp := intensity * remaining;
		p.camera.position = p.entity.world_position + v2.{sin(get_time() * 80.0) * amp, cos(get_time() * 101.0) * amp * 0.7};
	}
}

// Generic throwaway VFX entity that self-destructs after a fixed lifetime (used for one-shot
// spine bursts like smoke puffs that have no built-in "end and vanish" trigger we drive).
Mech_Vfx_Lifetime :: class : Component {
	spawn_time: float;
	lifetime: float;
	ao_start :: method() {
		spawn_time = get_time();
		if lifetime <= 0.0 { lifetime = 1.0; }
	}
	ao_update :: method(dt: float) {
		if get_time() - spawn_time >= lifetime { entity.destroy(); }
	}
}

// One-shot lightning bolt VFX: plays the strike "start", then the "end" fade, then destroys.
Mech_Lightning_Strike :: class : Component {
	STRIKE_LEN :: 0.5333; // "start" anim length
	spawn_time: float;
	ended: bool;
	ao_start :: method() {
		spawn_time = get_time();
	}
	ao_update :: method(dt: float) {
		age := get_time() - spawn_time;
		spine := entity.get_component(Spine_Animator);
		if !ended && age >= STRIKE_LEN {
			if spine != null && spine.instance != null {
				spine.instance.set_animation("end", false, 0);
			}
			ended = true;
		}
		if age >= STRIKE_LEN + 0.6167 { entity.destroy(); }
	}
}

// Scorched ground crater left behind by a missile blast. Sequences appear -> idle loop ->
// disappear so the full lifetime matches what the caller asked for, then self-destructs.
Mech_Crater :: class : Component {
	CRATER_APPEAR :: 1.1667;
	CRATER_DISAPPEAR :: 1.1667;
	spawn_time: float;
	lifetime: float;
	looped: bool;
	disappearing: bool;
	ao_start :: method() {
		spawn_time = get_time();
		if lifetime <= 0.0 { lifetime = MECH_MISSILE_CRATER_SECONDS; }
		spine := entity.get_component(Spine_Animator);
		if spine != null {
			spine.awaken();
			// Ground-decal convention (matches mines/portals): layer 0 + a positive depth_offset
			// renders it ABOVE the floor but y-sorts it BENEATH the characters. A negative layer
			// gets buried under the map's floor detail.
			spine.layer = 0;
			spine.depth_offset = 1.0;
			if spine.instance != null {
				spine.instance.set_skeleton(get_asset(Spine_Asset, MECH_CRATER_RIG));
				spine.instance.set_animation("appear", false, 0);
			}
		}
	}
	ao_update :: method(dt: float) {
		age := get_time() - spawn_time;
		spine := entity.get_component(Spine_Animator);
		if !looped && !disappearing && age >= CRATER_APPEAR {
			if spine != null && spine.instance != null {
				spine.instance.set_animation("idle", true, 0);
			}
			looped = true;
		}
		if !disappearing && age >= lifetime - CRATER_DISAPPEAR {
			if spine != null && spine.instance != null {
				spine.instance.set_animation("disappear", false, 0);
			}
			disappearing = true;
		}
		if age >= lifetime { entity.destroy(); }
	}
}

// AOE on a ground-placed barrage detonation: stun every enemy caught in the blast (or kill them
// if they're pinned by a magnet node — preserving the Magnet Cannon combo). Skips the firing
// Mech and its own minion. Runs on client + server (deterministic).
rr_mech_missile_blast_aoe :: proc(using missile: Mech_Missile, at: v2) {
	for p: component_iterator(Player) {
		if p == null || !#alive(p.entity) continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.entity.id == owner_id continue;
		// Don't friendly-fire the Mech's own minion.
		m := rr_mech_get_minion_effect(p);
		if m != null && m.converted_by_mech_id == owner_id continue;
		if !in_range(p.entity.world_position - at, MECH_MISSILE_BLAST_STUN_RADIUS) continue;
		if rr_mech_is_near_magnet_node(p.entity.world_position) {
			rr_mech_release_guardian_pickup_if_needed(p);
			p.kill_with_killer(owner_id);
		} else {
			rr_mech_apply_stun(p, MECH_MISSILE_STUN_SECONDS);
		}
	}
}

rr_mech_spawn_fire_pillar :: proc(at: v2, scale := MECH_FIRE_PILLAR_SCALE) {
	e := Scene.create_entity();
	e.set_local_position(at);
	e.set_local_scale(v2.{scale, scale});
	e.add_component(Spine_Animator);
	fp := e.add_component(Mech_Fire_Pillar);
	fp.lifetime = MECH_FIRE_PILLAR_SECONDS;
	fp.block_radius = MECH_FIRE_PILLAR_BLOCK_RADIUS;
}

// Passage-blocking fire pillar planted in a missile crater. Burns for `lifetime`
// (intro -> loop -> outro) and physically blocks players from walking through its core: each
// frame any player whose centre is inside `block_radius` is shoved back out to the ring edge.
// (Walls in this game are baked into the navmesh and nothing spawns runtime colliders, so the
// block is done with deterministic per-frame pushback that runs identically on client + server.)
Mech_Fire_Pillar :: class : Component {
	PILLAR_INTRO :: 0.6667; // fire_column_intro length
	PILLAR_OUTRO :: 0.6667; // fire_column_outro length
	spawn_time: float;
	lifetime: float;
	block_radius: float;
	looped: bool;
	ending: bool;
	ao_start :: method() {
		spawn_time = get_time();
		if lifetime <= 0.0 { lifetime = MECH_FIRE_PILLAR_SECONDS; }
		if block_radius <= 0.0 { block_radius = MECH_FIRE_PILLAR_BLOCK_RADIUS; }
		spine := entity.get_component(Spine_Animator);
		if spine != null {
			spine.awaken();
			// Layer 0 so the flame y-sorts with characters, but depth_offset 0 (vs the crater's
			// +1.0, which pushes the crater BENEATH everything) so the flame renders ON TOP of the
			// scorched crater it sits in, rather than being buried under it.
			spine.layer = 0;
			spine.depth_offset = 0.0;
			if spine.instance != null {
				spine.instance.set_skeleton(get_asset(Spine_Asset, MECH_FIRE_PILLAR_RIG));
				spine.instance.set_animation("fire_column_intro", false, 0);
			}
		}
	}
	ao_update :: method(dt: float) {
		age := get_time() - spawn_time;
		spine := entity.get_component(Spine_Animator);
		if !looped && !ending && age >= PILLAR_INTRO {
			if spine != null && spine.instance != null { spine.instance.set_animation("fire_column_loop", true, 0); }
			looped = true;
		}
		if !ending && age >= lifetime - PILLAR_OUTRO {
			if spine != null && spine.instance != null { spine.instance.set_animation("fire_column_outro", false, 0); }
			ending = true;
		}
		if age >= lifetime { entity.destroy(); return; }

		// Block passage. Stop once the outro is playing so the fire visibly dies before it lets go.
		if ending return;
		center := entity.world_position;
		for p: component_iterator(Player) {
			if p == null || !#alive(p.entity) continue;
			if p.player_state != Player_State.ALIVE continue;
			delta := p.entity.world_position - center;
			d := length(delta);
			if d >= block_radius continue;
			dir := d > 0.01 ? normalize(delta) : v2.{1, 0};
			p.entity.set_local_position(center + dir * block_radius);
			p.agent.velocity = v2.{0, 0};
		}
	}
}

Mech_Wreckage :: class : Component {
	owner_id: u64;
	last_warp_at: float;
	spawn_time: float;
	loop_started: bool;
	exploding: bool;
	expires_at: float;
	// Short-circuit overlays: crackling electric arcs + rising overheated smoke, both looping.
	spark_anim: Spine_Animator;
	smoke_anim: Spine_Animator;
	crackle_sfx: u64;

	ao_start :: method() {
		spawn_time = get_time();
		// Sentinel "warp-ready": the warp cooldown is (last_warp_at + 10) - get_time(), so leaving
		// last_warp_at at its 0 default would read as "warped at t=0" and show a fresh wreckage as
		// on-cooldown for the first 10s of game time (get_time() is seconds since game start) —
		// blocking the click. Park it far in the past so a new wreckage is immediately warpable.
		last_warp_at = -1000.0;
		spine := entity.get_component(Spine_Animator);
		if spine != null {
			spine.awaken();
			spine.layer = 0;
			if spine.instance != null {
				spine.instance.set_skeleton(get_asset(Spine_Asset, MECH_WRECKAGE_RIG));
				spine.instance.set_animation("rubble_appear", false, 0);
			}
		}

		// Looping electric arcs across the panel + smoke billowing up from it, so the smashed
		// task reads as short-circuited / overheated. Parented to the wreckage so they ride
		// along and get torn down with it.
		spark_anim = rr_mech_spawn_wreckage_overlay(entity, MECH_WRECKAGE_SPARK_RIG, "loop", v2.{0, 0.1}, 0.8, 2);
		smoke_anim = rr_mech_spawn_wreckage_overlay(entity, MECH_WRECKAGE_SMOKE_RIG, "010WD2/Loop", v2.{0, 0.5}, 0.7, 1);

		desc := SFX.default_sfx_desc();
		desc.entity_to_follow = entity.id;
		desc.loop = true;
		desc.volume = 0.18;
		desc.volume_perturb = 0.05;
		desc.speed_perturb = 0.08;
		crackle_sfx = rr_play_sfx(MECH_WRECKAGE_SFX, desc);
	}

	stop_overlays :: proc(using this: Mech_Wreckage) {
		if crackle_sfx != 0 {
			SFX.stop(crackle_sfx);
			crackle_sfx = 0;
		}
	}

	explode :: proc(using this: Mech_Wreckage) {
		if exploding return;
		exploding = true;
		expires_at = get_time() + MECH_WRECKAGE_EXPLODE_DURATION;
		spine := entity.get_component(Spine_Animator);
		if spine != null && spine.instance != null {
			spine.instance.set_animation("explode", false, 0);
		}
		// Let the overlays dissipate instead of vanishing instantly.
		if spark_anim != null && #alive(spark_anim.entity) && spark_anim.instance != null {
			spark_anim.instance.set_animation("fades_away", false, 0);
		}
		if smoke_anim != null && #alive(smoke_anim.entity) && smoke_anim.instance != null {
			smoke_anim.instance.set_animation("010WD2/End", false, 0);
		}
		stop_overlays(this);
	}

	ao_update :: method(dt: float) {
		if !loop_started && !exploding && get_time() - spawn_time >= MECH_WRECKAGE_APPEAR_DURATION {
			spine := entity.get_component(Spine_Animator);
			if spine != null && spine.instance != null {
				spine.instance.set_animation("rubble_loop", true, 0);
			}
			loop_started = true;
		}
		if exploding && get_time() >= expires_at {
			entity.destroy();
			return;
		}
	}

	ao_end :: method() {
		stop_overlays(this);
	}
}

// Spawns a looping cosmetic spine overlay parented to a wreckage entity (electric arcs, smoke).
rr_mech_spawn_wreckage_overlay :: proc(parent: Entity, rig: string, anim: string, offset: v2, scale: float, layer: int) -> Spine_Animator {
	e := Scene.create_entity();
	e.set_parent(parent, false);
	e.set_local_position(offset);
	e.set_local_scale(v2.{scale, scale});
	a := e.add_component(Spine_Animator);
	a.awaken();
	a.layer = layer.(s32);
	if a.instance != null {
		a.instance.set_skeleton(get_asset(Spine_Asset, rig));
		a.instance.set_animation(anim, true, 0);
	}
	return a;
}

rr_mech_explode_wreckage :: proc(w: Mech_Wreckage) {
	if w == null || !#alive(w.entity) return;
	w.explode();
}

MECH_PICKUP_BOB_AMPLITUDE :: 0.12;
MECH_PICKUP_BOB_SPEED :: 3.4;
MECH_PICKUP_SEEK_RANGE :: 1.8;
MECH_PICKUP_ARC_DURATION :: 0.4;
MECH_PICKUP_ARC_HEIGHT :: 0.8;

Mech_Component_Pickup :: class : Component {
	kind: int;
	spawn_pos: v2;
	spawn_time: float;
	target_id: u64;
	arc_start_pos: v2;
	arc_start_time: float;
	arcing: bool;

	ao_update :: method(dt: float) {
		if kind == 0 { entity.destroy(); return; }

		if arcing {
			target := get_player_by_entity_id(target_id);
			if !rr_mech_is_valid_pickup_collector(target) {
				arcing = false;
				target_id = 0;
				spawn_pos = entity.world_position;
				spawn_time = get_time();
				return;
			}
			t := clamp((get_time() - arc_start_time) / MECH_PICKUP_ARC_DURATION, 0.0, 1.0);
			ease := 1.0 - (1.0 - t) * (1.0 - t);
			to := target.entity.world_position + v2.{0, 0.7};
			pos := lerp(arc_start_pos, to, ease);
			pos.y += sin(t * PI) * MECH_PICKUP_ARC_HEIGHT;
			scale := lerp(0.7, 0.35, ease);
			entity.set_local_position(pos);
			entity.set_local_scale(v2.{scale, scale});
			if t >= 1.0 {
				rr_mech_add_component_part(target, kind);
				target.Notify(format_string("+1 %", .{rr_mech_component_name(kind)}));
				rr_mech_spawn_flash(to, 0.7, rr_mech_component_tint(kind), 0.28);
				rr_mech_play_sfx_at("sfx/pick_up_item_a973cc.wav", to, 0.3);
				entity.destroy();
			}
			return;
		}

		bob := sin((get_time() - spawn_time) * MECH_PICKUP_BOB_SPEED) * MECH_PICKUP_BOB_AMPLITUDE;
		entity.set_local_position(spawn_pos + v2.{0, bob});

		// Brief grace period so it's visible before it homes in.
		if get_time() - spawn_time < 0.25 return;

		collector := rr_mech_find_nearest_collector(entity.world_position, MECH_PICKUP_SEEK_RANGE);
		if collector == null return;
		target_id = collector.entity.id;
		arc_start_pos = entity.world_position;
		arc_start_time = get_time();
		arcing = true;
		rr_mech_play_sfx_at("$AO/sfx/FUI Holo Mechanism Activate.wav", entity.world_position, 0.18);
	}
}

// One-shot world-position spine burst that cleans itself up after `life` seconds
// (reuses the transform-vfx effect for the timed self-destroy).
rr_mech_spawn_world_spine_burst :: proc(rig: string, anim: string, pos: v2, scale: float, life: float, layer: int) {
	e := Scene.create_entity();
	e.set_local_position(pos);
	e.set_local_scale(v2.{scale, scale});
	a := e.add_component(Spine_Animator);
	a.awaken();
	a.layer = layer.(s32);
	if a.instance != null {
		a.instance.set_skeleton(get_asset(Spine_Asset, rig));
		a.instance.set_animation(anim, false, 0);
	}
	fx := new(Mech_Transform_Vfx_Effect);
	fx.set_duration(life);
	e.add_passive_effect(fx);
}

// Electric teleport burst (machine-energy poof + crackling arcs + flash core).
rr_mech_spawn_warp_vfx :: proc(pos: v2) {
	rr_mech_spawn_world_spine_burst(MECH_TRANSFORM_VFX_RIG, "repairing", pos + v2.{0, 0.55}, 0.5, 0.7, 9);
	rr_mech_spawn_world_spine_burst(MECH_WRECKAGE_SPARK_RIG, "activates", pos + v2.{0, 0.5}, 0.8, 0.65, 10);
	rr_mech_spawn_flash(pos + v2.{0, 0.4}, 0.9, v4.{0.3, 0.8, 1.0, 0.6}, 0.3);
	rr_mech_spawn_flash(pos + v2.{0, 0.4}, 0.45, v4.{0.85, 0.97, 1.0, 0.85}, 0.2);
}

// Shared Wreckage Warp: VFX/SFX on both the departure spot and the destination, then
// teleport. Used by the ability and the minimap node buttons (Mech + Minion).
rr_mech_do_wreckage_warp :: proc(player: Player, wreckage: Mech_Wreckage) {
	if player == null || wreckage == null || !#alive(wreckage.entity) return;
	from := player.entity.world_position;
	dest := wreckage.entity.world_position + v2.{0, 0.7};

	// Clamp the destination onto the navmesh so the +0.7 offset (or a wreckage left
	// near a wall) can't drop the player outside walkable bounds and strand them.
	nav_dest: v2 = dest;
	nav_hint: s64;
	if try_find_closest_point_on_navmesh(dest, ref nav_dest, ref nav_hint) {
		dest = nav_dest;
	}

	// Vanish from where we are.
	rr_mech_spawn_warp_vfx(from);
	rr_mech_play_sfx_at("sfx/warp_a5b988.wav", from, 0.3);
	rr_mech_play_sfx_at("sfx/zap.wav", from, 0.26);

	player.entity.set_local_position(dest);
	wreckage.last_warp_at = get_time();

	// Reappear at the wreckage.
	rr_mech_play_avatar_anim(player, "009SG/Warp_Appear", false);
	rr_mech_spawn_warp_vfx(dest);
	rr_mech_play_sfx_at("sfx/warp_a5b988.wav", dest, 0.34);
	rr_mech_play_sfx_at("sfx/zap.wav", dest, 0.3);
	rr_mech_add_screenshake(player, 0.06, 0.18);
}

rr_mech_draw_wreckage_warp_minimap_buttons :: proc(player: Player, map_rect: Rect) {
	owner := rr_mech_get_owner(player);
	if owner == null return;
	mech := owner.entity.get_component(Mech_Module);
	if mech == null return;
	if player.player_state != Player_State.ALIVE return;
	// Warp is a map-traversal tool, not a combat ability — the Mech can use it in human form
	// too (no is_mech_form/is_apex gate), matching how Minions can warp whenever active.
	if player.player_role != Player_Role.THE_MECH && !rr_mech_is_minion_active(player) return;

	// Locked wreckages still render on the map (dimmed, with a lock badge + an unlock hint) so
	// the Mech/Minion can see the warp network exists and learns how to enable it, instead of
	// the map showing nothing at all after smashing tasks.
	unlocked := mech.wreckage_warp_unlocked;

	icon := get_asset(Texture_Asset, "sprites/icons/mech/Wreckage_Warp_Icon.png");
	lock_icon := get_asset(Texture_Asset, "sprites/icons/doors_lock.png");
	size := map_rect.height() * 0.045;
	if size < 24.0 { size = 24.0; }
	if size > 58.0 { size = 58.0; }

	any_wreckage := false;
	warp_idx := 0;
	for w: component_iterator(Mech_Wreckage) {
		this_idx := warp_idx;
		warp_idx += 1;
		if w == null continue;
		if !#alive(w.entity) continue;
		if w.exploding continue;
		any_wreckage = true;
		p_ui := rr_minimap_world_to_ui(map_rect, w.entity.world_position);
		r := Rect{p_ui, p_ui}.grow_unscaled(size, size, size, size);

		if !unlocked {
			// Dimmed marker + lock badge — informational only, not clickable.
			if icon != null {
				UI.quad(r.fit_aspect(icon.get_aspect()), icon, v4.{0.3, 0.85, 1.0, 0.35});
			} else {
				UI.quad(r, core_globals.white_sprite, v4.{0.3, 0.85, 1.0, 0.3});
			}
			if lock_icon != null {
				bsz := size * 0.55;
				badge := Rect{r.center(), r.center()}.grow_unscaled(bsz, bsz, bsz, bsz);
				UI.quad(badge.fit_aspect(lock_icon.get_aspect()), lock_icon, v4.{1.0, 0.95, 0.7, 0.95});
			}
			continue;
		}

		UI.push_id(format_string("mech_warp_%", .{this_idx}));
		warp_bs: Button_Settings = .{};
		rr_ui_apply_button_click_sound(ref warp_bs);
		interact := UI.button(r, warp_bs, .{}, "");
		if icon != null {
			UI.quad(r.fit_aspect(icon.get_aspect()), icon, v4.{0.3, 0.85, 1.0, 1.0});
		} else {
			UI.quad(r, core_globals.white_sprite, v4.{0.3, 0.85, 1.0, 0.85});
		}
		cooldown_left := (w.last_warp_at + MECH_WARP_COOLDOWN) - get_time();
		if cooldown_left > 0.0 {
			// No dim square — a big black-outlined number alone reads the cooldown cleanly on the marker.
			secs := cooldown_left.(int);
			if cooldown_left > secs.(float) { secs += 1; } // ceil so it counts 10 -> 1, never flashes "0" while locked
			cd_ts := UI.default_text_settings();
			cd_ts.size = size * 1.5;
			cd_ts.halign = .CENTER;
			cd_ts.valign = .CENTER;
			cd_ts.do_outline = true;
			cd_ts.outline_thickness = 5;
			cd_ts.outline_color = v4.{0, 0, 0, 1};
			cd_ts.color = v4.{1.0, 0.95, 0.8, 1.0};
			UI.text(r, cd_ts, "%", .{secs});
		}
		if interact.clicked && cooldown_left <= 0.0 {
			rr_mech_do_wreckage_warp(player, w);
			player.show_minimap = false;
		}
		UI.pop_id();
	}

	// Unlock hint, shown once near the bottom of the map when locked and there's somewhere to warp.
	if !unlocked && any_wreckage {
		hint: string;
		if rr_mech_upgrade_can_afford(owner, MECH_UPGRADE_WRECKAGE_WARP) {
			hint = "Build Wreckage Warp at the Workbench";
		} else {
			qty, kk := rr_mech_next_upgrade_cost(mech, MECH_UPGRADE_WRECKAGE_WARP);
			hint = format_string("Need % to unlock Warp", .{rr_mech_cost_label(0, qty, kk)});
		}
		cx := (map_rect.min.x + map_rect.max.x) * 0.5;
		band := Rect{v2.{cx - 300.0, map_rect.max.y - 56.0}, v2.{cx + 300.0, map_rect.max.y - 18.0}};
		UI.quad(band, core_globals.white_sprite, v4.{0.0, 0.0, 0.0, 0.55});
		ts := UI.default_text_settings();
		ts.size = 22;
		ts.halign = .CENTER;
		ts.valign = .CENTER;
		ts.color = v4.{1.0, 0.95, 0.7, 1.0};
		UI.text(band, ts, hint);
	}
}

Mech_Magnetised_Status :: class : Component {
	spine_entity: Entity;
	expires_at: float;
	current_skin: string;
	active: bool;
	// Set once a Magnet Core has been extracted from this player during the current
	// magnetisation. Reset on each fresh magnetisation (inactive->active edge) so the same
	// player can be looted again after breaking free and being re-trapped.
	core_looted: bool;

	ao_start :: method() {
		// The Mech extracts a Magnet Core from trapped players via this world prompt.
		if entity.get_component(Mech_Magnet_Loot_Interactable) == null {
			entity.add_component(Mech_Magnet_Loot_Interactable);
		}
	}

	refresh :: proc(using this: Mech_Magnetised_Status, danger: bool) {
		// Fresh magnetisation episode — allow a new core extraction.
		if !active { core_looted = false; }
		expires_at = get_time() + 0.25;
		active = true;
		ensure_spine(this);
		desired := danger ? "red" : "blue";
		if current_skin != desired {
			if spine_entity != null && #alive(spine_entity) {
				anim := spine_entity.get_component(Spine_Animator);
				if anim != null && anim.instance != null {
					anim.instance.disable_all_skins();
					anim.instance.enable_skin(desired);
					anim.instance.refresh_skins();
				}
			}
			current_skin = desired;
		}
	}

	ensure_spine :: proc(using this: Mech_Magnetised_Status) {
		if spine_entity != null && #alive(spine_entity) return;
		e := Scene.create_entity();
		e.set_parent(entity, false);
		e.set_local_position(v2.{0, 0.55});
		anim := e.add_component(Spine_Animator);
		anim.awaken();
		anim.layer = 9;
		if anim.instance != null {
			anim.instance.set_skeleton(get_asset(Spine_Asset, MECH_MAGNETISED_RIG));
			anim.instance.set_animation("Loop", true, 0);
		}
		spine_entity = e;
		current_skin = "";
	}

	ao_update :: method(dt: float) {
		if !active return;
		if get_time() >= expires_at {
			if spine_entity != null && #alive(spine_entity) { spine_entity.destroy(); }
			spine_entity = null;
			current_skin = "";
			active = false;
		}
	}

	ao_end :: method() {
		if spine_entity != null && #alive(spine_entity) { spine_entity.destroy(); }
		spine_entity = null;
	}
}

// Layer/strip the Magnet_Helmet skin on a victim's player rig. Additive — preserves
// their existing cosmetics (rr_player_set_skin_enabled rebuilds the skin list around it).
rr_mech_set_magnet_helmet :: proc(player: Player, enabled: bool) {
	if player == null return;
	if !#alive(player.entity) return;
	if player.animator == null || player.animator.instance == null return;
	Player.rr_player_set_skin_enabled(player, MECH_MAGNET_HELMET_SKIN, enabled);
}

rr_mech_mark_magnetised :: proc(player: Player, danger: bool) {
	if player == null return;
	if !#alive(player.entity) return;
	s := player.entity.get_component(Mech_Magnetised_Status);
	if s == null { s = player.entity.add_component(Mech_Magnetised_Status); }
	s.refresh(danger);
}

// Looping electric-arc overlay shown over a GUARDIAN caught in a live magnet rod's current. Refreshed
// each frame the Guardian is within shock range (the rod field loop); self-tears-down ~0.25s after it
// stops being refreshed, mirroring Mech_Magnetised_Status. Purely cosmetic — the rod's stun still applies.
Mech_Guardian_Shock_Vfx :: class : Component {
	spine_entity: Entity;
	expires_at: float;
	active: bool;

	refresh :: proc(using this: Mech_Guardian_Shock_Vfx) {
		expires_at = get_time() + 0.25;
		active = true;
		if spine_entity != null && #alive(spine_entity) return;
		e := Scene.create_entity();
		e.set_parent(entity, false);
		e.set_local_position(v2.{0, 0.6});
		anim := e.add_component(Spine_Animator);
		anim.awaken();
		anim.layer = 9;
		if anim.instance != null {
			anim.instance.set_skeleton(get_asset(Spine_Asset, MECH_WRECKAGE_SPARK_RIG));
			anim.instance.set_animation("loop", true, 0);
		}
		spine_entity = e;
	}

	ao_update :: method(dt: float) {
		if !active return;
		if get_time() >= expires_at {
			if spine_entity != null && #alive(spine_entity) { spine_entity.destroy(); }
			spine_entity = null;
			active = false;
		}
	}

	ao_end :: method() {
		if spine_entity != null && #alive(spine_entity) { spine_entity.destroy(); }
		spine_entity = null;
	}
}

rr_mech_mark_guardian_shocked :: proc(player: Player) {
	if player == null return;
	if !#alive(player.entity) return;
	s := player.entity.get_component(Mech_Guardian_Shock_Vfx);
	if s == null { s = player.entity.add_component(Mech_Guardian_Shock_Vfx); }
	s.refresh();
}

Mech_Stun_Status :: class : Component {
	active: bool;
	ends_at: float;
	// When set, the victim plays the electric "shock" pose — the rig's "electrocute" state-machine
	// bool (the same one the Hacker's electrocute drives) — instead of the broken-leg flail.
	electrocute: bool;
	// Set when the stun came from a Magnet Rod's field. The rod already shows its OWN countdown
	// (rr_mech_draw_rod_timers), so rr_draw_stun_timers hides the per-victim stun timer for these
	// to avoid a redundant double timer.
	from_rod: bool;

	set_shock_anim :: proc(p: Player, on: bool) {
		if p == null || p.animator == null || p.animator.instance == null return;
		if p.animator.instance.state_machine == null return;
		p.animator.instance.state_machine.set_bool("electrocute", on);
	}

	arm :: proc(using this: Mech_Stun_Status, seconds: float, shock: bool = false, rod: bool = false) {
		ends_at = get_time() + seconds;
		electrocute = shock;
		from_rod = rod;
		p := entity.get_component(Player);
		if p != null {
			// Only take the movement lock on the inactive->active edge — the reason is
			// ref-counted, so re-stunning an already-stunned player must not stack it.
			if !active {
				p.add_disable_movement_input_reason(MECH_STUN_REASON);
			}
			if shock {
				set_shock_anim(p, true);
			} else {
				// Switching off a prior shock — clear its pose bool before the flail.
				set_shock_anim(p, false);
				// If a throw arc is mid-flight, let it play the flight anim and settle
				// into the stun pose on landing; don't snap to the pose mid-air.
				arc := entity.get_component(Mech_Thrown_Arc);
				if arc == null || !arc.active {
					p.set_trigger("hitman_broken_leg_idle");
				}
			}
		}
		active = true;
	}
	ao_update :: method(dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null || p.player_state != Player_State.ALIVE || get_time() >= ends_at {
			if p != null {
				p.remove_disable_movement_input_reason(MECH_STUN_REASON);
				if electrocute { set_shock_anim(p, false); }
				p.set_trigger("RESET");
			}
			active = false;
			electrocute = false;
			from_rod = false;
			return;
		}
		// Re-assert the shock pose each frame so it survives animation-state resyncs.
		if electrocute { set_shock_anim(p, true); }
	}
}

Mech_Helmeted_Status :: class : Component {
	active: bool;
	// Tracks whether the visible Magnet_Helmet skin is layered on this victim, so we add/strip it
	// exactly once on the active edges. The helmet skin shows ONLY while a Helmet Trap is clamped
	// on the player (until it auto-releases) — never on grab or magnetise.
	helmet_on: bool;
	// A clamped helmet pops off on its own at this time. 0 when no helmet is on. There is no
	// manual removal — the only way out is to outlast the clamp.
	expires_at: float;

	// Clamp a fresh Magnet Helmet on, starting (or restarting) the auto-release countdown.
	arm :: proc(using this: Mech_Helmeted_Status) {
		active = true;
		expires_at = get_time() + MECH_HELMET_DURATION;
	}

	// Edge-trigger the visible helmet skin to track `active`. Runs on every client, so each one
	// independently keeps the skin matched to the trap state (survives server resyncs).
	sync_helmet_skin :: proc(using this: Mech_Helmeted_Status, p: Player, want: bool) {
		if want == helmet_on return;
		helmet_on = want;
		rr_mech_set_magnet_helmet(p, want);
	}
	ao_update :: method(dt: float) {
		p := entity.get_component(Player);
		if p == null || p.player_state != Player_State.ALIVE {
			active = false;
			if helmet_on && p != null { sync_helmet_skin(this, p, false); }
			helmet_on = false;
			return;
		}
		// Helmet auto-releases once its clamp times out. Runs on every client (each compares the
		// synced expiry against get_time()), so the pop-off stays in lockstep.
		if active && expires_at != 0.0 && get_time() >= expires_at {
			active = false;
			expires_at = 0.0;
			if p.is_local() {
				rr_mech_spawn_flash(p.entity.world_position + v2.{0, 0.65}, 0.5, v4.{0.7, 0.9, 1.0, 0.55}, 0.22);
			}
			rr_mech_play_sfx_at("$AO/sfx/FUI Holo Mechanism Activate.wav", p.entity.world_position, 0.22);
		}
		sync_helmet_skin(this, p, active);
		// Blind overlay while the helmet is clamped on. The fog of war is ALSO collapsed via
		// get_local_light_radii (MECH_HELMET_BLIND_LOS_*), so vision is genuinely cut — the
		// overlay just sells the "bucket over the head" darkness on top of the shrunk LOS.
		if active && p.is_local() {
			UI.push_screen_draw_context();
			defer UI.pop_draw_context();
			UI.push_layer(9800);
			defer UI.pop_layer();
			UI.quad(UI.get_screen_rect(), get_asset(Texture_Asset, "$AO/white.png"), v4.{0, 0, 0, 0.72});
			// Countdown on the dark overlay so the blinded victim knows when their vision returns.
			if expires_at != 0.0 {
				rem := expires_at - get_time();
				if rem < 0.0 { rem = 0.0; }
				secs_i := rem.(int);
				if rem - secs_i.(float) > 0.001 { secs_i += 1; }
				if secs_i < 1 { secs_i = 1; }
				cts := UI.default_text_settings();
				cts.size = 72;
				cts.halign = .CENTER;
				cts.valign = .CENTER;
				cts.do_outline = true;
				cts.outline_thickness = 6;
				cts.outline_color = v4.{0, 0, 0, 1};
				cts.color = v4.{0.75, 0.9, 1.0, 0.85};
				UI.text(UI.get_screen_rect(), cts, "%s", .{secs_i});
			}
		}
	}
	ao_end :: method() {
		if helmet_on {
			p := entity.get_component(Player);
			if p != null { rr_mech_set_magnet_helmet(p, false); }
			helmet_on = false;
		}
	}
}

Mech_Helmet_Trap :: class : Component {
	owner_id: u64;
	armed: bool;
	ao_start :: method() {
		armed = true;
		spine := entity.get_component(Spine_Animator);
		if spine != null {
			spine.awaken();
			spine.instance.set_skeleton(get_asset(Spine_Asset, MECH_HELMET_RIG));
			spine.instance.set_animation("appear", false, 0);
		}
	}
	ao_update :: method(dt: float) {
		if !armed return;
		for p: component_iterator(Player) {
			if p == null continue;
			if p.entity.id == owner_id continue;
			if p.player_type == Player_Type.TRAITOR continue;
			if p.player_state != Player_State.ALIVE continue;
			if !in_range(p.entity.world_position - entity.world_position, MECH_HELMET_TRAP_CATCH_RADIUS) continue;
			status := p.entity.get_component(Mech_Helmeted_Status);
			if status == null { status = p.entity.add_component(Mech_Helmeted_Status); }
			status.arm();
			armed = false;
			spine := entity.get_component(Spine_Animator);
			if spine != null && spine.instance != null { spine.instance.set_animation("activate", false, 0); }
			rr_mech_spawn_flash(p.entity.world_position + v2.{0, 0.75}, 0.55, v4.{0.7, 0.9, 1.0, 0.65}, 0.22);
			rr_mech_play_sfx_at("sfx/zap.wav", p.entity.world_position, 0.28);
			break;
		}
	}
}

// Shocks a non-helmeted player caught in a live magnet rod's field: applies the Mech stun
// (broken-leg flail) plus a zap flash/SFX on the inactive->active edge, then keeps the stun
// topped up while they stay in the current so the rod pins them where they stand.
rr_mech_rod_electrocute :: proc(p: Player) {
	if p == null || !#alive(p.entity) return;
	stun := p.entity.get_component(Mech_Stun_Status);
	if stun == null { stun = p.entity.add_component(Mech_Stun_Status); }
	if !stun.active {
		stun.arm(MECH_STUN_SECONDS, true, true); // shock pose + from_rod (rod shows its own timer)
		if p.is_local() {
			rr_mech_spawn_flash(p.entity.world_position + v2.{0, 0.7}, 0.55, v4.{0.55, 0.9, 1.0, 0.75}, 0.2);
		}
		rr_mech_play_sfx_at("sfx/zap.wav", p.entity.world_position, 0.32);
	} else {
		stun.ends_at = max(stun.ends_at, get_time() + 0.4);
		stun.from_rod = true; // a victim re-zapped by the rod keeps its timer hidden
	}
}

Mech_Magnet_Node :: class : Component {
	owner_id: u64;
	start_pos: v2;     // set by the cannon before add_component
	target_pos: v2;    // set by the cannon before add_component
	start_time: float;
	landed: bool;
	land_time: float;
	ends_at: float;
	active_idle_set: bool;
	hum_sfx: u64;

	// Stamp start_time HERE in ao_start (once, per context) so get_time()-based progress is
	// consistent — like Powder_Keg_Thrown. Horizontal lerp over the anim length; the rig's
	// "Arc" anim supplies the vertical up-then-down.
	ao_start :: method() {
		start_time = get_time();
		if length_squared(target_pos) < 0.0001 { target_pos = entity.world_position; }
		if length_squared(start_pos) < 0.0001 { start_pos = entity.world_position; }
		entity.set_local_rotation(0);
		spine := entity.get_component(Spine_Animator);
		if spine != null {
			spine.awaken();
			spine.layer = 0;
			if spine.instance != null {
				spine.instance.set_skeleton(get_asset(Spine_Asset, MECH_HARPOON_RIG));
				spine.instance.set_animation("Arc", false, 0);
			}
		}
	}

	land :: proc(using this: Mech_Magnet_Node) {
		landed = true;
		land_time = get_time();
		// Rods linger past the base pull window so trapped helmeted players stay magnetised longer:
		// +5s when fired in base Mech form, +10s in APEX form.
		owner := get_player_by_entity_id(owner_id);
		linger := 0.0;
		if owner != null {
			mech := owner.entity.get_component(Mech_Module);
			if mech != null { linger = mech.is_apex ? MECH_MAGNET_LINGER_APEX : MECH_MAGNET_LINGER_MECH; }
		}
		ends_at = get_time() + MECH_MAGNET_PULL_SECONDS + linger;
		// Settle onto solid ground ONLY if the navmesh is near the aimed spot (snaps the magnet
		// off a wall edge onto walkable ground). If the nearest navmesh point is far — e.g. the
		// spot is across a gap or out past the navmesh — DON'T yank it back to that distant point
		// (that was pulling far throws back to ~2 units in front); just land where it was aimed.
		nav_pt: v2;
		nav_tri: s64;
		if try_find_closest_point_on_navmesh(target_pos, ref nav_pt, ref nav_tri) {
			if length(nav_pt - target_pos) <= MECH_MAGNET_GROUND_SNAP_TOL { target_pos = nav_pt; }
		}
		entity.set_local_position(target_pos);
		entity.set_local_rotation(0);
		spine := entity.get_component(Spine_Animator);
		if spine != null && spine.instance != null {
			spine.instance.set_animation("Land", false, 0);
		}
		rr_mech_spawn_flash(target_pos, 0.85, v4.{0.25, 0.8, 1.0, 0.6}, 0.3);
		rr_mech_spawn_flash(target_pos, 0.4, v4.{0.8, 0.95, 1.0, 0.85}, 0.2);
		rr_mech_play_sfx_at("sfx/zap.wav", target_pos, 0.4);
		// Lightning bolt crashes down onto the rod as it plants into the ground.
		rr_mech_spawn_lightning_strike(target_pos);
		if owner != null { rr_mech_add_screenshake(owner, 0.07, 0.18); }
		// Looping electromagnet hum while the trap is live.
		desc := SFX.default_sfx_desc();
		desc.entity_to_follow = entity.id;
		desc.loop = true;
		desc.volume = 0.16;
		desc.volume_perturb = 0.04;
		desc.speed_perturb = 0.05;
		hum_sfx = rr_play_sfx(MECH_WRECKAGE_SFX, desc);
	}

	stop_hum :: proc(using this: Mech_Magnet_Node) {
		if hum_sfx != 0 { SFX.stop(hum_sfx); hum_sfx = 0; }
	}

	ao_update :: method(dt: float) {
		// --- Fly-in: lerp horizontally from start to target over the anim length, so it arrives
		// exactly as the "Arc" anim completes. The anim supplies the vertical up-then-down. ---
		if !landed {
			t := (get_time() - start_time) / MECH_MAGNET_FLIGHT_SECONDS;
			if t < 0.0 { t = 0.0; }
			if t > 1.0 { t = 1.0; }
			entity.set_local_position(lerp(start_pos, target_pos, t));
			if t >= 1.0 { land(this); }
			return;
		}

		if get_time() >= ends_at {
			stop_hum(this);
			entity.destroy();
			return;
		}
		if !active_idle_set && get_time() > land_time + 0.5 {
			spine := entity.get_component(Spine_Animator);
			if spine != null && spine.instance != null {
				spine.instance.set_animation("Active_idle", true, 0);
			}
			active_idle_set = true;
		}

		// --- Field effects within the rod's radius ---
		// • Helmeted victims get MAGNETISED to the rod: reeled in, locked at the rod, and marked
		//   so the Mech can extract a Magnet Core from them (the ONLY way to farm cores).
		// • Everyone else nearby gets ELECTROCUTED (stunned) by the live current.
		for p: component_iterator(Player) {
			if p == null continue;
			if p.player_state != Player_State.ALIVE continue;
			if p.entity.id == owner_id continue;
			if p.player_type == Player_Type.TRAITOR continue;
			to_node := entity.world_position - p.entity.world_position;
			dist := length(to_node);
			if dist > MECH_MAGNET_RADIUS continue;

			// Guardians caught in the rod's current get a looping electric-arc overlay while too
			// close (cosmetic only — the stun/magnetise effects below still apply as normal).
			if p.player_role == Player_Role.GUARDIAN && dist <= MECH_MAGNET_SHOCK_RADIUS {
				rr_mech_mark_guardian_shocked(p);
			}

			helmet := p.entity.get_component(Mech_Helmeted_Status);
			helmeted := helmet != null && helmet.active;
			if !helmeted {
				// No helmet — the rod's current shocks them where they stand, but only within the
				// tighter shock radius (the magnetise pull reaches further than the shock).
				if dist <= MECH_MAGNET_SHOCK_RADIUS { rr_mech_rod_electrocute(p); }
				continue;
			}

			rr_mech_mark_magnetised(p, true);
			// Put the victim in the held "grabbed" pose (same state the Mech's carry uses) and
			// lock their movement, so being reeled/trapped reads as being magnetically dragged.
			rr_mech_mark_carried(p);
			if dist <= MECH_MAGNET_TRAP_RADIUS {
				// Trapped at the magnet — held in place for the trap's lifetime.
				p.agent.velocity = v2.{0, 0};
			} else if dist > 0.05 {
				// Reel them in by FORCING position toward the node (setting velocity alone gets
				// overridden by the victim's own movement input, so they'd never arrive). Faster
				// the closer they get so it feels like a real yank; never overshoot the node.
				pull := clamp(MECH_MAGNET_PULL_SPEED * (1.0 - dist / (MECH_MAGNET_RADIUS + 2.0)), 5.0, MECH_MAGNET_PULL_SPEED);
				step := pull * dt;
				if step > dist { step = dist; }
				p.entity.set_local_position(p.entity.world_position + normalize(to_node) * step);
				p.agent.velocity = v2.{0, 0};
			}
		}
	}

	ao_end :: method() {
		stop_hum(this);
	}
}

MECH_TRUCK_SCALE :: 1.4;       // APEX car size
MECH_TRUCK_SCALE_MECH :: 1.15; // base Mech car — a bit smaller than APEX's

MECH_CAR_PUSH_REASON :: "mech_car_push";
MECH_CAR_PUSH_GRACE :: 0.35; // release the victim this long after the car last touched them (longer = sticks to the bumper through turns)

// Plow lock: while the car has a victim in front of it, the car PINS the victim to its front bumper
// each frame (see the plow loop in Mech_Ram_Charge_Status.ao_update) so they ride along instead of
// being launched. This component owns only the ref-counted movement lock + the short post-contact
// grace release — it doesn't move the victim itself; it just keeps their own input from fighting the
// pin and zeroes any residual velocity so they don't coast/fling once the car lets go.
Mech_Car_Push :: class : Component {
	active: bool;
	end_time: float;

	// Called each frame the car is plowing this victim: extends the grace window and takes the
	// movement lock on the inactive->active edge (the reason is ref-counted, so re-locking an
	// already-pushed victim would stack and leave them frozen).
	refresh :: proc(using this: Mech_Car_Push) {
		end_time = get_time() + MECH_CAR_PUSH_GRACE;
		p := entity.get_component(Player);
		if p != null {
			if !active {
				p.add_disable_movement_input_reason(MECH_CAR_PUSH_REASON);
				// Crumple into the broken-leg pose the moment the bumper scoops them up.
				p.set_trigger("hitman_broken_leg_idle");
			}
			p.agent.velocity = v2.{0, 0};
		}
		active = true;
	}

	release :: proc(using this: Mech_Car_Push) {
		if !active return;
		active = false;
		p := entity.get_component(Player);
		if p != null {
			p.remove_disable_movement_input_reason(MECH_CAR_PUSH_REASON);
			// Stand back up out of the broken-leg crumple, unless a stun is holding its own pose.
			stun := p.entity.get_component(Mech_Stun_Status);
			if stun == null || !stun.active { p.set_trigger("RESET"); }
		}
	}

	ao_update :: method(dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null { active = false; return; }
		if game_state != Game_State.INGAME || p.player_state != Player_State.ALIVE || get_time() >= end_time {
			release(this);
			return;
		}
		// Hold still between car contacts (no coast / fling); the car re-pins the position while
		// it's still touching them.
		p.agent.velocity = v2.{0, 0};
	}

	// Destroyed mid-push (round reset / meeting teardown) — release the lock so it can't
	// leak onto a player who keeps the component into the next round.
	ao_end :: method() {
		release(this);
	}
}

// APEX car combo: if `victim` (being plowed) is shoved onto one of the Mech's live Magnet Rods,
// detonate an electric blast that destroys the rod and kills the victim. Returns true if it fired
// (the caller then skips the normal push for that victim this frame). Mirrors the rod's own zap
// palette so it reads as the rod overloading.
rr_mech_car_try_rod_kill :: proc(driver: Player, victim: Player) -> bool {
	if driver == null || victim == null return false;
	// A transformed Guardian is a titan, not a magnetisable victim — the two titans settle things
	// through a Showdown, never a one-shot rod overload. Leave them out of the car/rod kill entirely.
	gvic := victim.entity.get_component(Guardian_Module);
	if gvic != null && gvic.is_guardian_form return false;
	for node: component_iterator(Mech_Magnet_Node) {
		if node == null || !#alive(node.entity) continue;
		if !node.landed continue;
		if !in_range(victim.entity.world_position - node.entity.world_position, MECH_CAR_ROD_KILL_RADIUS) continue;
		at := node.entity.world_position;
		// Electric overload blast — layered blue shockwave + white core.
		rr_mech_spawn_shockwave(at, 0.4, 5.0, v4.{0.4, 0.85, 1.0, 0.8}, 0.4);
		rr_mech_spawn_flash(at, 2.0, v4.{0.55, 0.9, 1.0, 0.85}, 0.32);
		rr_mech_spawn_flash(at, 1.0, v4.{0.95, 1.0, 1.0, 0.95}, 0.2);
		rr_mech_spawn_lightning_strike(at);
		rr_mech_play_sfx_at("sfx/zap.wav", at, 0.5);
		rr_mech_play_sfx_at("sfx/other_death.wav", victim.entity.world_position, 0.4);
		rr_mech_add_screenshake(driver, 0.18, 0.3);
		// Kill the victim and destroy the rod it overloaded.
		rr_mech_release_guardian_pickup_if_needed(victim);
		victim.kill_with_killer(driver.entity.id);
		node.stop_hum();
		node.entity.destroy();
		return true;
	}
	return false;
}

Mech_Ram_Charge_Status :: class : Component {
	owner_id: u64;
	dir: v2;
	facing_left: bool;  // persisted horizontal facing; only updated on a real horizontal heading
	ends_at: float;
	hit: bool;
	active: bool;
	truck_entity: Entity;
	truck_animator: Spine_Animator;
	truck_skin: string;
	next_aura_at: float;
	truck_swap_at: float;
	truck_swapped: bool;
	// APEX turbo boost: a temporary speed surge with a fire jet out the back.
	boosting: bool;
	boost_ends_at: float;
	boost_cd_until: float;
	boost_fire_entity: Entity;   // looped flame rig parented behind the car while boosting
	next_boost_flame_at: float;  // throttle for the trailing fire flashes

	arm :: proc(using this: Mech_Ram_Charge_Status, direction: v2, seconds: float) {
		dir = direction;
		if length_squared(dir) < 0.01 { dir = v2.{1, 0}; }
		dir = normalize(dir);
		if abs(dir.x) > 0.01 { facing_left = dir.x < 0.0; }
		ends_at = get_time() + seconds;
		hit = false;
		truck_swapped = false;
		boosting = false;
		boost_ends_at = 0.0;
		boost_cd_until = 0.0;
		p := entity.get_component(Player);
		if p != null {
			// NOTE: deliberately NO movement-input lock here — the car is steered with the driver's
			// move input, and a disable-movement reason zeroes agent.input_this_frame (see the drive
			// logic in ao_update). The body is instead held still (input/velocity 0) until the truck
			// reveal, then driven by writing input_this_frame.
			// Play the transform-in anim on the mech rig first; the rig is hidden and the
			// truck revealed only once that anim finishes (see ao_update).
			rr_mech_play_avatar_anim(p, "009SG/Transform_Truck_out", false);
			truck_swap_at = get_time() + rr_mech_anim_duration("009SG/Transform_Truck_out");
			// Only run the morph VFX until the truck appears — not the full default duration,
			// which would leave it sparking on the car for the rest of the charge.
			rr_mech_spawn_transform_vfx(p, rr_mech_anim_duration("009SG/Transform_Truck_out"));
			rr_mech_add_screenshake(p, 0.06, 0.2);
			// Engine ignition the instant the Ram is triggered.
			rr_mech_play_sfx_at("sfx/imposter_car_start_47c7ab.wav", p.entity.world_position, 0.5);
		}
		active = true;
	}

	// APEX turbo: kick the car into a brief fire-spewing speed surge. Gated by the caller
	// (Mech_Car_Boost_Ability) on apex + car-active; here we just stamp the window + cooldown.
	start_boost :: proc(using this: Mech_Ram_Charge_Status, p: Player) {
		if !active return;
		if get_time() < boost_cd_until return;
		boosting = true;
		boost_ends_at = get_time() + MECH_CAR_BOOST_SECONDS;
		boost_cd_until = get_time() + MECH_CAR_BOOST_SECONDS + MECH_CAR_BOOST_COOLDOWN;
		if p != null {
			rr_mech_play_sfx_at("sfx/car_rev_up_03ff05.wav", p.entity.world_position, 0.6);
			rr_mech_play_sfx_at("sfx/Whoosh_1e3125.wav", p.entity.world_position, 0.5);
			rr_mech_add_screenshake(p, 0.12, 0.25);
			// Burst of fire out the exhaust as the turbo lights.
			behind := p.entity.world_position - dir * 0.8 + v2.{0, 0.35};
			rr_mech_spawn_flash(behind, 1.4, v4.{1.0, 0.45, 0.08, 0.85}, 0.3);
			rr_mech_spawn_flash(behind, 0.8, v4.{1.0, 0.85, 0.4, 0.9}, 0.22);
		}
	}

	// Looped flame jet behind the car while boosting; torn down the instant the boost ends.
	update_boost_fire :: proc(using this: Mech_Ram_Charge_Status, p: Player) {
		if !boosting {
			if boost_fire_entity != null && #alive(boost_fire_entity) { boost_fire_entity.destroy(); }
			boost_fire_entity = null;
			return;
		}
		if boost_fire_entity == null || !#alive(boost_fire_entity) {
			e := Scene.create_entity();
			anim := e.add_component(Spine_Animator);
			anim.awaken();
			anim.layer = 0;
			if anim.instance != null {
				anim.instance.set_skeleton(get_asset(Spine_Asset, MECH_FIRE_PILLAR_RIG));
				anim.instance.set_animation("fire_column_loop", true, 0);
				rr_apply_shadow_mask(anim.instance);
			}
			boost_fire_entity = e;
		}
		// Anchor at the car's rear and ROTATE the flame so it shoots straight out the back instead of
		// pointing up. The rig's flame points +Y at rotation 0, so rotate +Y to align with -dir
		// (backwards along travel). Stretched along its length into a jet plume.
		rear := p.entity.world_position - dir * 0.35 + v2.{0, 0.1};
		boost_fire_entity.set_local_position(rear);
		boost_fire_entity.set_local_rotation(to_degrees(atan2(-dir.y, -dir.x)) - 90.0);
		boost_fire_entity.set_local_scale(v2.{0.8, 1.45}); // narrow + long = a jet plume
		// Dense ember trail streaming off the back, along the exhaust line.
		if get_time() >= next_boost_flame_at {
			tail := p.entity.world_position - dir * 1.2 + v2.{0, 0.15};
			rr_mech_spawn_flash(tail, 0.85, v4.{1.0, 0.4, 0.06, 0.6}, 0.22);
			rr_mech_spawn_flash(rear + v2.{0, 0.1}, 0.6, v4.{1.0, 0.78, 0.28, 0.5}, 0.16);
			next_boost_flame_at = get_time() + 0.04;
		}
	}

	ensure_truck :: proc(using this: Mech_Ram_Charge_Status, p: Player) {
		if truck_entity == null || !#alive(truck_entity) {
			e := Scene.create_entity();
			e.set_local_position(p.entity.world_position + v2.{0, 0.2});
			anim := e.add_component(Spine_Animator);
			anim.awaken();
			anim.layer = 0;
			if anim.instance != null {
				anim.instance.set_skeleton(get_asset(Spine_Asset, MECH_TRUCK_RIG));
				anim.instance.set_animation("Driving", true, 0);
				rr_apply_shadow_mask(anim.instance);
			}
			truck_entity = e;
			truck_animator = anim;
			truck_skin = "";
		} else {
			truck_entity.set_local_enabled(true);
		}
		update_truck(this, p);
	}

	// Follows the player and faces the charge direction. Truck rig has side/front/back
	// skins; side_view is mirrored via scale.x for left/right.
	update_truck :: proc(using this: Mech_Ram_Charge_Status, p: Player) {
		if truck_entity == null || !#alive(truck_entity) return;
		truck_entity.set_local_position(p.entity.world_position + v2.{0, 0.2});
		// Always the side view; just mirror it for left/right charges. Use the persisted facing so a
		// straight up/down heading (dir.x ~ 0) doesn't snap the truck back to its right-facing side.
		skin := "side_view";
		flip := facing_left;
		if truck_animator != null && truck_animator.instance != null && truck_skin != skin {
			truck_animator.instance.disable_all_skins();
			truck_animator.instance.enable_skin(skin);
			truck_animator.instance.refresh_skins();
			truck_skin = skin;
		}
		// APEX drives the full-size truck; the base Mech's car is a bit smaller.
		mech := p.entity.get_component(Mech_Module);
		s := (mech != null && mech.is_apex) ? MECH_TRUCK_SCALE : MECH_TRUCK_SCALE_MECH;
		sx := flip ? -s : s;
		truck_entity.set_local_scale(v2.{sx, s});
	}

	restore_mech :: proc(using this: Mech_Ram_Charge_Status, p: Player) {
		if truck_entity != null && #alive(truck_entity) { truck_entity.destroy(); }
		truck_entity = null;
		truck_animator = null;
		truck_swapped = false;
		boosting = false;
		if boost_fire_entity != null && #alive(boost_fire_entity) { boost_fire_entity.destroy(); }
		boost_fire_entity = null;
		if p == null return;
		// Hand back the normal walk speed + stop driving (the drive bumped movement_speed and wrote
		// input_this_frame every frame).
		if p.baseline_movement_speed_saved { p.agent.movement_speed = p.baseline_movement_speed; }
		p.agent.input_this_frame = v2.{0, 0};
		mech := p.entity.get_component(Mech_Module);
		if mech != null && mech.creature_entity != null && #alive(mech.creature_entity) {
			mech.creature_entity.set_local_enabled(mech.creature_visible);
		}
	}

	ao_update :: method(dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null { return; }
		if get_time() >= ends_at || p.player_state != Player_State.ALIVE {
			restore_mech(this, p);
			rr_mech_play_avatar_anim(p, "009SG/Transform_Truck_In", false);
			rr_mech_spawn_transform_vfx(p);
			rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", p.entity.world_position, 0.3);
			hit = true;
			active = false;
			return;
		}
		mech := p.entity.get_component(Mech_Module);

		// Once the transform-in anim has played out, hide the mech rig and reveal the truck.
		// Toggle the creature entity directly (not via show_avatar) so rr_mech_update — which
		// only re-syncs visibility on a creature_visible mismatch — won't fight us, and the
		// schleem body stays hidden throughout.
		if !truck_swapped && get_time() >= truck_swap_at {
			if mech != null && mech.creature_entity != null && #alive(mech.creature_entity) {
				mech.creature_entity.set_local_enabled(false);
			}
			ensure_truck(this, p);
			rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", p.entity.world_position, 0.25);
			// Engine revs up as the truck appears and barrels forward.
			rr_mech_play_sfx_at("sfx/car_rev_up_03ff05.wav", p.entity.world_position, 0.55);
			truck_swapped = true;
		}

		// Hold the body still during the brief transform-in, then start driving once the truck is out.
		if !truck_swapped {
			p.agent.input_this_frame = v2.{0, 0};
			p.agent.velocity = v2.{0, 0};
			return;
		}

		// Steer the car with the driver's MOVE input (joystick / WASD), read from input_this_frame
		// BEFORE we overwrite it below to drive. Heading snaps straight to the input direction (no
		// turn smoothing) so steering is instant; flip MECH_CAR_SMOOTH_STEER to restore the gradual
		// turn. BOTH forms steer; APEX is just faster + boostable.
		steer := p.agent.input_this_frame;
		steering := length_squared(steer) > 0.04;
		if steering {
			desired := normalize(steer);
			if MECH_CAR_SMOOTH_STEER {
				dir = normalize(lerp(dir, desired, clamp(dt * MECH_APEX_RAM_TURN_RATE, 0.0, 1.0)));
			} else {
				dir = desired;
			}
		}
		// Persist horizontal facing — only update on a real horizontal heading so driving straight
		// up/down keeps the current facing instead of snapping to a default side.
		if abs(dir.x) > 0.01 { facing_left = dir.x < 0.0; }
		update_truck(this, p);

		// Blast straight through linked portals (no standing channel) — keeps heading so the car
		// shoots out the far side still charging; pinned victims (plowed below off the new car_pos)
		// ride through with it. SFX + a poof at both mouths to sell the warp.
		if rr_portal_try_instant_teleport(p) {
			rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", p.entity.world_position, 0.3);
			rr_mech_spawn_flash(p.entity.world_position + v2.{0, 0.4}, 1.0, v4.{0.5, 0.4, 1.0, 0.7}, 0.25);
		}

		// --- APEX turbo boost: time out the surge, spew the fire jet. ---
		apex := mech != null && mech.is_apex;
		if boosting && (get_time() >= boost_ends_at || !apex) { boosting = false; }
		update_boost_fire(this, p);

		// APEX power aura: a pulsing energy trail around the truck.
		if apex && get_time() >= next_aura_at {
			rr_mech_spawn_flash(p.entity.world_position + v2.{0, 0.4}, 1.1, v4.{1.0, 0.35, 0.08, 0.5}, 0.22);
			next_aura_at = get_time() + 0.06;
		}

		// Drive: scale movement_speed off the player's baseline and FORCE the move input to the car's
		// heading, so the agent's own movement system carries the car forward (it ignores a directly
		// set velocity once input is non-zero). The plow pushes victims at this same world speed.
		base := p.baseline_movement_speed_saved ? p.baseline_movement_speed : p.agent.movement_speed;
		car_speed := base * MECH_CAR_SPEED_MULT;
		if boosting { car_speed = car_speed * MECH_CAR_BOOST_MULT; }
		p.agent.movement_speed = car_speed;
		// Auto-drive TEMP DISABLED: only carry the car forward while the driver is actually steering;
		// otherwise it sits still (flip MECH_CAR_AUTO_DRIVE to restore the always-forward behaviour).
		p.agent.input_this_frame = (MECH_CAR_AUTO_DRIVE || steering) ? dir : v2.{0, 0};
		// Keep the player facing in sync with the persisted car facing (preserved when going vertical).
		p.set_facing_right(!facing_left);
		// Continuous ground-rumble while driving (re-armed each frame with a short decay window so the
		// amplitude stays roughly steady; the per-hit jolts below still punch through on top).
		rr_mech_add_screenshake(p, boosting ? 0.08 : 0.05, 0.12);

		// --- Plow: scoop up every victim in front of the car and PIN them to the bumper so they ride
		// along with it (no longer a dash-kill, and no fling — they're held just in front, not given a
		// big velocity). A victim shoved into a Magnet Rod by an APEX car triggers an electric blast
		// that destroys the rod and kills them (the only lethal outcome of the drive). ---
		car_pos := p.entity.world_position;
		forward := dir;
		perp := v2.{-dir.y, dir.x};
		for target: component_iterator(Player) {
			if target == null || target == p continue;
			if target.player_state != Player_State.ALIVE continue;
			// Traitors (fellow traitors / Minions) get plowed too — the drive itself doesn't kill, it
			// just pins them to the bumper. They're only spared the lethal rod combo below.
			rel := target.entity.world_position - car_pos;
			fwd_dist := rel.x * forward.x + rel.y * forward.y;   // how far ahead along travel
			lat := rel.x * perp.x + rel.y * perp.y;               // signed sideways offset from the path
			// Only catch victims roughly in front of the car and within the plow lane.
			if fwd_dist < -0.4 || fwd_dist > MECH_RAM_HIT_RADIUS continue;
			if abs(lat) > MECH_RAM_PLOW_HALF_WIDTH continue;

			// APEX-only lethal combo: pushed into one of the Mech's own Magnet Rods. Traitors are
			// immune to this kill (it's the only lethal outcome of the drive) — they're still plowed.
			if apex && target.player_type != Player_Type.TRAITOR && rr_mech_car_try_rod_kill(p, target) continue;

			// Lock their input + grace (so they don't walk away or coast off), then pin them to the
			// bumper: a fixed standoff straight ahead, keeping their current sideways offset so a
			// cluster spreads across the front instead of stacking on the centre line.
			push := target.entity.get_component(Mech_Car_Push);
			if push == null { push = target.entity.add_component(Mech_Car_Push); }
			push.refresh();
			bumper := car_pos + forward * MECH_RAM_PLOW_STANDOFF + perp * clamp(lat, -MECH_RAM_PLOW_HALF_WIDTH, MECH_RAM_PLOW_HALF_WIDTH);
			target.entity.set_local_position(bumper);
			target.agent.velocity = v2.{0, 0};
		}
	}

	ao_end :: method() {
		// Cleanup if destroyed mid-drive (round end, etc.): restore_mech hands back the walk speed,
		// stops the driven input, and tears down the truck + boost fire.
		p := entity.get_component(Player);
		active = false;
		restore_mech(this, p);
	}
}

Mech_Missile :: class : Component {
	owner_id: u64;
	target_id: u64;
	speed: float;
	launch_time: float;
	launch_dir: v2;
	heading: v2;
	next_trail_at: float;
	exploding: bool;
	expires_at: float;
	// Master multiplier on the detonation spectacle (fireball / crater / shake). 1.0 = a
	// normal Mech missile; APEX barrages and the End Game finale push this far higher.
	blast_scale: float;
	// End Game barrage missiles are lethal: they kill outright instead of stunning,
	// and don't require the magnet-node combo.
	is_lethal: bool;
	// Ground-placement Missile Barrage missiles: detonate at a fixed point, stun every enemy
	// caught in the blast (AOE), leave a bigger crater, and plant a passage-blocking fire pillar.
	// Endgame finale missiles leave this false (they kill + rain in huge volume, so no pillars).
	leaves_fire_pillar: bool;
	// Last known target position — if the target dies mid-flight the missile keeps flying to
	// this spot and detonates there, rather than vanishing or blasting the launcher.
	last_target_pos: v2;
	has_target_pos: bool;
	// Ballistic (mortar) mode — used by the End Game finale. Instead of homing, the rocket lobs
	// on a parabolic arc from ballistic_start, up over arc_height, and back down onto
	// ballistic_target where it detonates. Endgame targets are frozen, so a fixed-point arc is
	// exact. travel_time controls how slow/floaty the lob is.
	ballistic: bool;
	ballistic_start: v2;
	ballistic_target: v2;
	travel_time: float;
	arc_height: float;
	ao_start :: method() {
		speed = MECH_MISSILE_SPEED;
		launch_time = get_time();
		next_trail_at = get_time();
		if blast_scale <= 0.0 { blast_scale = 1.0; }
		if length_squared(launch_dir) < 0.01 { launch_dir = v2.{0, 1}; }
		heading = normalize(launch_dir);
		t := get_player_by_entity_id(target_id);
		if t != null { last_target_pos = t.entity.world_position; has_target_pos = true; }
		spine := entity.get_component(Spine_Animator);
		if spine != null {
			spine.awaken();
			// Missiles fly above the map, so render them in front of world geometry (walls/roofs).
			spine.layer = 12;
			if spine.instance != null {
				spine.instance.set_skeleton(get_asset(Spine_Asset, MECH_MISSILE_RIG));
				spine.instance.set_animation("flying_loop", true, 0);
			}
		}
	}
	detonate :: proc(using this: Mech_Missile, at: v2) {
		// Master size knob: 1.0 = normal Mech missile, larger for APEX barrages and the End
		// Game finale. Every part of the blast scales off it so they all grow together.
		s := blast_scale;
		if s <= 0.0 { s = 1.0; }
		// Big layered fireball: a wide expanding shockwave, a fierce orange core, a hot inner
		// burst, and a white-yellow flash at the dead center.
		rr_mech_spawn_flash(at, 4.8 * s, v4.{1.0, 0.6, 0.2, 0.32}, 0.6);   // faint outer shockwave ring
		rr_mech_spawn_flash(at, 3.3 * s, v4.{1.0, 0.45, 0.1, 0.55}, 0.45);
		rr_mech_spawn_flash(at, 2.1 * s, v4.{1.0, 0.32, 0.05, 0.8}, 0.34);
		rr_mech_spawn_flash(at, 1.2 * s, v4.{1.0, 0.85, 0.4, 0.92}, 0.24);
		rr_mech_spawn_flash(at, 0.65 * s, v4.{1.0, 1.0, 0.88, 0.95}, 0.16);
		// Scorched crater on the ground that lingers after the blast. Ground-placement barrage
		// craters are deliberately bigger and longer-lived (they host the passage-blocking fire
		// pillar); APEX / finale craters stay compact and loosely tied to the blast size.
		if leaves_fire_pillar {
			rr_mech_spawn_crater(at, MECH_MISSILE_BARRAGE_CRATER_SECONDS, MECH_MISSILE_BARRAGE_CRATER_SCALE);
		} else {
			rr_mech_spawn_crater(at, MECH_MISSILE_CRATER_SECONDS, 0.6 + 0.06 * s);
		}
		// The spine-based smoke puff is gorgeous but expensive (a Spine instance per blast). The
		// finale rains HUNDREDS of missiles, so we skip the smoke there — the cheap sprite
		// fireball carries it — and keep the smoke for the lower-volume regular / APEX barrage.
		if !is_lethal {
			rr_mech_spawn_smoke_puff(at + v2.{0, 0.3 * s}, 0.9 * s, 1.6);
		}
		// Heavy screenshake felt by everyone near the blast, not just the launcher — radius and
		// amplitude both grow with the blast size.
		rr_mech_shake_players_near(at, MECH_EXPLOSION_SHAKE_RADIUS * (0.7 + 0.55 * s), 0.4 * (0.6 + 0.7 * s), 0.4 + 0.12 * s);
		// Finale blasts also pump the firing Mech's own shake — it's the Mech's shake status that
		// drives the synced cinematic camera wobble on every client during the End Game — and
		// stamp the impact time so the cinematic post-FX punches only on impacts.
		if is_lethal {
			owner := get_player_by_entity_id(owner_id);
			if owner != null {
				rr_mech_add_screenshake(owner, 0.4, 0.4);
				omech := owner.entity.get_component(Mech_Module);
				if omech != null { omech.endgame_last_impact_at = get_time(); }
			}
		}
		// Ground-placement barrage: stun every enemy caught in the blast (AOE) and plant a
		// passage-blocking fire pillar in the crater. Runs on client + server (deterministic).
		if leaves_fire_pillar {
			rr_mech_missile_blast_aoe(this, at);
			rr_mech_spawn_fire_pillar(at);
		}
		rr_mech_play_sfx_at("sfx/ggg_explode.wav", at, clamp(0.5 + 0.18 * s, 0.3, 1.0));
		spine := entity.get_component(Spine_Animator);
		if spine != null && spine.instance != null {
			spine.instance.set_animation("explode", false, 0);
		}
		exploding = true;
		expires_at = get_time() + MECH_MISSILE_EXPLODE_DURATION;
	}
	// Parabolic mortar lob (finale): rise up off ballistic_start, arc over, crash down onto
	// ballistic_target. Targets are frozen during the End Game so the endpoint is fixed.
	update_ballistic :: proc(using this: Mech_Missile, dt: float) {
		PI :: 3.14159265;
		tt := travel_time;
		if tt <= 0.0 { tt = 1.5; }
		t := clamp((get_time() - launch_time) / tt, 0.0, 1.0);
		horiz := lerp(ballistic_start, ballistic_target, t);
		pos := horiz + v2.{0, sin(t * PI) * arc_height};
		entity.set_local_position(pos);
		// Point the rocket along its path (sample slightly ahead so the nose tracks the arc —
		// up on the way out, straight down on the way in).
		t2 := clamp(t + 0.03, 0.0, 1.0);
		ahead := lerp(ballistic_start, ballistic_target, t2) + v2.{0, sin(t2 * PI) * arc_height};
		dir := ahead - pos;
		if length_squared(dir) > 0.00001 { entity.set_local_rotation(to_degrees(atan2(dir.y, dir.x))); }

		if get_time() >= next_trail_at {
			rr_mech_spawn_flash(pos, 0.22, v4.{1.0, 0.55, 0.1, 0.4}, 0.18);
			next_trail_at = get_time() + 0.05;
		}

		if t >= 1.0 {
			target := get_player_by_entity_id(target_id);
			if target != null && target.player_state == Player_State.ALIVE {
				if is_lethal || rr_mech_is_near_magnet_node(target.entity.world_position) {
					rr_mech_release_guardian_pickup_if_needed(target);
					target.kill_with_killer(owner_id);
				} else {
					rr_mech_apply_stun(target, MECH_STUN_SECONDS);
				}
			}
			detonate(this, ballistic_target);
		}
	}
	ao_update :: method(dt: float) {
		if exploding {
			if get_time() >= expires_at { entity.destroy(); }
			return;
		}
		if ballistic {
			update_ballistic(this, dt);
			return;
		}
		age := get_time() - launch_time;
		target := get_player_by_entity_id(target_id);
		target_alive := target != null && target.player_state == Player_State.ALIVE;

		// Steer toward the live target, or its last known position if it's already gone.
		aim_pos := last_target_pos;
		if target_alive {
			aim_pos = target.entity.world_position;
			last_target_pos = aim_pos;
			has_target_pos = true;
		} else if !has_target_pos {
			// Never locked a position (shouldn't happen) — nothing to fly to.
			entity.destroy();
			return;
		}

		// Burst out of the shoulder first, then curve onto the aim point so it reads as a
		// shoulder-mounted launcher rather than a bee-line dart.
		home := normalize(aim_pos - entity.world_position);
		desired := home;
		if age < MECH_MISSILE_LAUNCH_SECONDS {
			blend := clamp(age / MECH_MISSILE_LAUNCH_SECONDS, 0.0, 1.0);
			desired = normalize(lerp(launch_dir, home, blend));
		}
		// Smoothly steer the heading for a homing-missile arc.
		heading = normalize(lerp(heading, desired, clamp(dt * 9.0, 0.0, 1.0)));
		cur := speed;
		if age < MECH_MISSILE_LAUNCH_SECONDS { cur = speed * (0.55 + 0.45 * (age / MECH_MISSILE_LAUNCH_SECONDS)); }
		entity.set_local_position(entity.world_position + heading * cur * dt);
		entity.set_local_rotation(to_degrees(atan2(heading.y, heading.x)));

		if get_time() >= next_trail_at {
			rr_mech_spawn_flash(entity.world_position, 0.2, v4.{1.0, 0.55, 0.1, 0.4}, 0.18);
			next_trail_at = get_time() + 0.05;
		}

		if in_range(aim_pos - entity.world_position, MECH_MISSILE_HIT_RADIUS) {
			if target_alive {
				// Lethal (End Game barrage) or the magnet-node combo kills outright; else stun.
				if is_lethal || rr_mech_is_near_magnet_node(target.entity.world_position) {
					rr_mech_release_guardian_pickup_if_needed(target);
					target.kill_with_killer(owner_id);
				} else {
					rr_mech_apply_stun(target, MECH_STUN_SECONDS);
				}
				detonate(this, target.entity.world_position);
			} else {
				// Target already gone — just blow up at their last known position.
				detonate(this, aim_pos);
			}
		}
	}
}

Mech_Transform_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Transform_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/transform_evil.png"); }
	can_use :: method() -> bool {
		if player.player_role != Player_Role.THE_MECH || player.player_state != Player_State.ALIVE return false;
		// Can't revert while holding someone/something — throw or drop them first.
		mech := player.entity.get_component(Mech_Module);
		if mech != null && (mech.carried_player_id != 0 || mech.carried_corpse_id != 0) return false;
		return true;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			mech := player.entity.get_component(Mech_Module);
			if mech == null return;
			mech.is_mech_form = !mech.is_mech_form;
			if mech.is_apex { mech.is_mech_form = true; }
			showing := mech.is_mech_form || mech.is_apex;
			anim_name := showing ? "009SG/Transform_Truck_In" : "009SG/Transform_Truck_out";
			anim_duration := rr_mech_anim_duration(anim_name);
			// Keep avatar visible through the whole anim, even when transforming back.
			mech.transform_anim_ends_at = get_time() + anim_duration;
			if showing {
				rr_mech_show_avatar(player, true);
				rr_mech_spawn_transform_vfx(player);
			}
			rr_mech_play_avatar_anim(player, anim_name, false);
			mech.anim_lock_until = get_time() + anim_duration;
			rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", player.entity.world_position, 0.32);
			color := mech.is_mech_form ? v4.{1.0, 0.32, 0.12, 0.7} : v4.{0.6, 0.85, 1.0, 0.6};
			rr_mech_spawn_flash(player.entity.world_position + v2.{0, 0.55}, 0.95, color, 0.3);
			rr_mech_add_screenshake(player, 0.07, 0.2);
			current_cooldown = MECH_TRANSFORM_COOLDOWN;
		}
	}
	on_draw_button :: proc(instance: Mech_Transform_Ability, rect: Rect) { draw_ability_name_label(rect, "Transform"); }
}

// Drives a Guardian INTO their combat form with the full transform anim + reveal FX. Shared by the
// Guardian's own Transform ability and the forced reveal when the Mech attacks a still-human
// Guardian (the Mech can't kill them, so the swing flushes them out). No-op if already transformed.
rr_guardian_enter_guardian_form :: proc(player: Player) {
	if player == null return;
	if player.player_role != Player_Role.GUARDIAN return;
	guard := player.entity.get_component(Guardian_Module);
	if guard == null return;
	if guard.is_guardian_form return;
	if guard.carried_player_id != 0 return;

	guard.is_guardian_form = true;
	anim_name := "009SG/Transform_Truck_In";
	anim_duration := rr_mech_anim_duration(anim_name);
	guard.transform_anim_ends_at = get_time() + anim_duration;
	rr_mech_show_avatar(player, true);
	rr_mech_spawn_transform_vfx(player);
	rr_mech_play_avatar_anim(player, anim_name, false);
	guard.anim_lock_until = get_time() + anim_duration;
	// Heroic stinger + bright reveal pop.
	rr_mech_play_sfx_at("sfx/mim/UltimateTransform.wav", player.entity.world_position, 0.35);
	rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", player.entity.world_position, 0.28);
	rr_mech_spawn_flash(player.entity.world_position + v2.{0, 0.55}, 1.25, v4.{0.85, 0.95, 0.3, 0.75}, 0.42);
	rr_mech_spawn_flash(player.entity.world_position + v2.{0, 0.55}, 0.55, v4.{1.0, 1.0, 0.8, 0.85}, 0.22);
	rr_mech_add_screenshake(player, 0.12, 0.28);
}

Guardian_Transform_Ability :: class : Ability_Base {
	on_init :: proc(a: Guardian_Transform_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/transform_good.png"); }
	can_use :: method() -> bool {
		if player.player_role != Player_Role.GUARDIAN || player.player_state != Player_State.ALIVE return false;
		// Can't revert while holding someone — throw or drop them first.
		guard := player.entity.get_component(Guardian_Module);
		if guard != null && guard.carried_player_id != 0 return false;
		return true;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			guard := player.entity.get_component(Guardian_Module);
			if guard == null return;
			if !guard.is_guardian_form {
				// Heroic transform INTO Guardian (shared with the Mech-attack forced reveal).
				rr_guardian_enter_guardian_form(player);
			} else {
				// Soft poof when reverting to schleem/human form.
				guard.is_guardian_form = false;
				anim_name := "009SG/Transform_Truck_out";
				anim_duration := rr_mech_anim_duration(anim_name);
				guard.transform_anim_ends_at = get_time() + anim_duration;
				rr_mech_play_avatar_anim(player, anim_name, false);
				guard.anim_lock_until = get_time() + anim_duration;
				rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", player.entity.world_position, 0.3);
				rr_mech_spawn_flash(player.entity.world_position + v2.{0, 0.55}, 0.9, v4.{0.6, 0.85, 1.0, 0.6}, 0.28);
				rr_mech_add_screenshake(player, 0.05, 0.16);
			}
			current_cooldown = MECH_TRANSFORM_COOLDOWN;
		}
	}
	on_draw_button :: proc(instance: Guardian_Transform_Ability, rect: Rect) { draw_ability_name_label(rect, "Transform"); }
}

// ============================ Guardian Shockwave =============================
// The Guardian's anti-monster nuke. Slams the ground (009SG/Smash_Task) and electrocutes every
// transformed monster in an AOE around it — the Mech (mech/APEX), Werewolf, Mimicer, Big Charlie
// and Lily. Each caught monster is given a Guardian_Shock_Status: a red warning + countdown, all
// abilities locked (they can still run/escape), and after the warning they're forced out of their
// form and stay locked out for the cooldown.

// True if `p` is currently in a monster transform form the Guardian shockwave can disrupt.
rr_player_is_transformed_monster :: proc(p: Player) -> bool {
	if p == null || !#alive(p.entity) return false;
	if p.player_state != Player_State.ALIVE return false;
	mech := p.entity.get_component(Mech_Module);
	if mech != null && (mech.is_mech_form || mech.is_apex) return true;
	wm := p.entity.get_component(Werewolf_Module);
	if wm != null && wm.is_wolf_form return true;
	mm := p.entity.get_component(Mimicer_Module);
	if mm != null && (mm.is_monster_form || mm.is_ultimate_form) return true;
	bc := p.entity.get_component(Big_Charlie_Module);
	if bc != null && bc.is_big_charlie_form return true;
	lm := p.entity.get_component(Lily_Module);
	if lm != null && lm.is_lily_form return true;
	return false;
}

// Applied to a monster caught in the Guardian shockwave (APEX Mechs are immune — see
// rr_guardian_fire_shockwave). While active (the warning window) every ability is hard-locked but
// movement is free, so they can flee. At the warning's end they're forced out of their form, every
// ability is slapped on cooldown for a bit (the "lockout"), and the status releases.
Guardian_Shock_Status :: class : Component {
	active: bool;
	warning_ends_at: float;
	next_zap_at: float;

	arm :: proc(using this: Guardian_Shock_Status) {
		active = true;
		warning_ends_at = get_time() + MECH_GUARDIAN_SHOCK_WARNING;
		next_zap_at = 0.0;
	}

	deactivate :: proc(using this: Guardian_Shock_Status) {
		active = false;
	}

	// Force the monster out of whatever form it's in. Reuses each role's own revert path so the
	// teardown matches the meeting revert exactly. APEX Mechs are never here (immune), so the Mech
	// branch only handles the normal Mech form.
	do_revert :: proc(using this: Guardian_Shock_Status, p: Player) {
		if p == null return;
		mech := p.entity.get_component(Mech_Module);
		if mech != null && mech.is_mech_form && !mech.is_apex {
			// rr_mech_force_revert hides the avatar + tears down any Ram car but PRESERVES the form
			// flag; flip it off afterwards so the de-transform actually sticks.
			rr_mech_force_revert(p);
			mech.is_mech_form = false;
		}
		wm := p.entity.get_component(Werewolf_Module);
		if wm != null && wm.is_wolf_form {
			wm.is_wolf_form = false;
			wm.transform_ends_at = 0.0;
			p.set_trigger("RESET");
			rr_werewolf_disable_wolf_look(p);
		}
		mm := p.entity.get_component(Mimicer_Module);
		if mm != null && (mm.is_monster_form || mm.is_ultimate_form) { rr_mimicer_force_revert(p); }
		bc := p.entity.get_component(Big_Charlie_Module);
		if bc != null && bc.is_big_charlie_form { rr_bc_force_revert(p); }
		lm := p.entity.get_component(Lily_Module);
		if lm != null && lm.is_lily_form { rr_lily_force_revert(p); }
	}

	ao_update :: method(dt: float) {
		if !active return;
		p := entity.get_component(Player);
		if p == null { active = false; return; }
		if p.player_state != Player_State.ALIVE { deactivate(this); return; }
		if game_state != Game_State.INGAME { deactivate(this); return; }
		// APEX is immune: if the victim is (or awakened into) an APEX Mech, the shock just fizzles off.
		mech := p.entity.get_component(Mech_Module);
		if mech != null && mech.is_apex {
			rr_mech_spawn_flash(p.entity.world_position + v2.{0, 0.7}, 0.8, v4.{0.6, 0.9, 1.0, 0.55}, 0.25);
			deactivate(this);
			return;
		}
		// Electric arcs crackle over the victim through the warning.
		if get_time() >= next_zap_at {
			rr_mech_spawn_flash(p.entity.world_position + v2.{0, 0.7}, 0.55, v4.{0.55, 0.9, 1.0, 0.7}, 0.2);
			rr_mech_play_sfx_at("sfx/zap.wav", p.entity.world_position, 0.16);
			next_zap_at = get_time() + 0.45;
		}
		// Warning elapsed -> force them out of their form, drop the UI + hard-lock, and instead slap
		// every ability on cooldown for a bit so they can't immediately act / re-transform. Then release.
		if get_time() >= warning_ends_at {
			do_revert(this, p);
			rr_mech_put_all_abilities_on_cooldown(p, MECH_GUARDIAN_SHOCK_LOCKOUT);
			rr_mech_spawn_shockwave(p.entity.world_position, 0.4, 4.0, v4.{0.5, 0.85, 1.0, 0.8}, 0.45);
			rr_mech_spawn_flash(p.entity.world_position + v2.{0, 0.5}, 1.4, v4.{0.8, 0.95, 1.0, 0.85}, 0.3);
			rr_mech_play_sfx_at("sfx/zap.wav", p.entity.world_position, 0.4);
			rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", p.entity.world_position, 0.32);
			deactivate(this);
		}
	}

	ao_end :: method() {
		active = false;
	}
}

// Slam + electrocute every transformed monster within the shockwave AOE.
rr_guardian_fire_shockwave :: proc(player: Player) {
	if player == null return;
	origin := player.entity.world_position;
	// Guardian attack animation + the slam's electric shockwave.
	rr_mech_play_avatar_anim(player, "009SG/Smash_Task", false);
	rr_mech_spawn_shockwave(origin, 0.5, MECH_GUARDIAN_SHOCK_RADIUS * 2.0, v4.{0.45, 0.85, 1.0, 0.7}, 0.55);
	rr_mech_spawn_shockwave(origin, 0.3, MECH_GUARDIAN_SHOCK_RADIUS * 1.3, v4.{0.85, 0.95, 1.0, 0.6}, 0.45);
	rr_mech_spawn_flash(origin + v2.{0, 0.5}, 2.0, v4.{0.7, 0.9, 1.0, 0.7}, 0.3);
	rr_mech_play_sfx_at("sfx/zap.wav", origin, 0.5);
	rr_mech_play_sfx_at("sfx/killer_transform.wav", origin, 0.3);
	rr_mech_add_screenshake(player, 0.2, 0.35);
	for target: component_iterator(Player) {
		if target == null || target == player continue;
		if !rr_player_is_transformed_monster(target) continue;
		if !in_range(target.entity.world_position - origin, MECH_GUARDIAN_SHOCK_RADIUS) continue;
		// APEX Mechs are immune — the shockwave just arcs harmlessly off them (VFX only, no disrupt).
		tmech := target.entity.get_component(Mech_Module);
		if tmech != null && tmech.is_apex {
			rr_mech_spawn_shockwave(target.entity.world_position, 0.3, 3.0, v4.{0.5, 0.85, 1.0, 0.55}, 0.35);
			rr_mech_spawn_flash(target.entity.world_position + v2.{0, 0.8}, 1.2, v4.{0.7, 0.95, 1.0, 0.7}, 0.3);
			rr_mech_play_sfx_at("sfx/zap.wav", target.entity.world_position, 0.4);
			continue;
		}
		rr_guardian_apply_shock(target);
	}
}

// Mark a single monster as shocked (no-op if already disrupted, so it can't be re-triggered to
// extend the lock).
rr_guardian_apply_shock :: proc(target: Player) {
	if target == null || !#alive(target.entity) return;
	sh := target.entity.get_component(Guardian_Shock_Status);
	if sh == null { sh = target.entity.add_component(Guardian_Shock_Status); }
	if sh.active return;
	sh.arm();
	rr_mech_spawn_shockwave(target.entity.world_position, 0.3, 3.5, v4.{0.5, 0.85, 1.0, 0.7}, 0.4);
	rr_mech_spawn_flash(target.entity.world_position + v2.{0, 0.7}, 1.0, v4.{0.7, 0.95, 1.0, 0.8}, 0.28);
	rr_mech_play_sfx_at("sfx/zap.wav", target.entity.world_position, 0.4);
}

Guardian_Shockwave_Ability :: class : Ability_Base {
	on_init :: proc(a: Guardian_Shockwave_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Smash_Task_Icon.png"); }
	can_use :: method() -> bool {
		if player.player_role != Player_Role.GUARDIAN || player.player_state != Player_State.ALIVE return false;
		guard := player.entity.get_component(Guardian_Module);
		return guard != null && guard.is_guardian_form;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_guardian_fire_shockwave(player);
			current_cooldown = MECH_GUARDIAN_SHOCK_COOLDOWN;
		}
	}
	on_draw_button :: proc(instance: Guardian_Shockwave_Ability, rect: Rect) { draw_ability_name_label(rect, "Shock"); }
}

// Victim-side HUD: pulsing red hue + a warning banner counting down to the forced de-transform.
// Shown ONLY during the warning window — once the forced revert fires the UI vanishes (the lockout
// is then just ability cooldowns). Local viewer only.
rr_guardian_draw_shock_warning :: proc(player: Player) {
	if player == null return;
	if !player.is_local_or_server() return;
	if game_state != Game_State.INGAME return;
	sh := player.entity.get_component(Guardian_Shock_Status);
	if sh == null || !sh.active return;

	UI.push_screen_draw_context();
	defer UI.pop_draw_context();
	UI.push_layer(9700);
	defer UI.pop_layer();

	// Pulsing red hue over the whole screen.
	pulse := 0.5 + sin(get_time() * 5.0) * 0.5;
	UI.quad(UI.get_screen_rect(), core_globals.white_sprite, v4.{0.85, 0.08, 0.06, 0.16 + pulse * 0.12});

	_pushed_scale := rr_push_mobile_ui_scale(player);
	defer rr_pop_mobile_ui_scale(_pushed_scale);

	screen := UI.get_safe_screen_rect();
	cx := (screen.min.x + screen.max.x) * 0.5;
	band_w := clamp(screen.width() * 0.6, 320.0, 680.0);
	band_h := 120.0;
	top_y := screen.min.y + screen.height() * 0.18;
	half_w := band_w * 0.5;
	band := Rect{v2.{cx - half_w, top_y}, v2.{cx + half_w, top_y + band_h}};

	gp := 6.0 + pulse * 5.0;
	UI.quad(band.grow(gp, gp, gp, gp), core_globals.white_sprite, v4.{0.95, 0.16, 0.1, 0.4 + pulse * 0.2});
	UI.quad(band, core_globals.white_sprite, v4.{0.09, 0.05, 0.06, 0.96});

	inner := band.inset(18.0, 14.0, 18.0, 14.0);
	title_rect := inner.cut_top(inner.height() * 0.55);
	title_ts := UI.default_text_settings();
	title_ts.size = 30;
	title_ts.halign = .CENTER;
	title_ts.valign = .CENTER;
	title_ts.do_outline = true;
	title_ts.outline_thickness = 5;
	title_ts.outline_color = v4.{0, 0, 0, 1};
	title_ts.do_autofit = true;
	title_ts.autofit_min_size = 18;
	title_ts.autofit_max_size = 32;
	title_ts.color = v4.{1.0, 0.3, 0.24, 1.0};
	UI.text(title_rect, title_ts, "FORM DESTABILIZED");

	sub_ts := UI.default_text_settings();
	sub_ts.size = 22;
	sub_ts.halign = .CENTER;
	sub_ts.valign = .CENTER;
	sub_ts.do_outline = true;
	sub_ts.outline_thickness = 4;
	sub_ts.outline_color = v4.{0, 0, 0, 1};
	sub_ts.do_autofit = true;
	sub_ts.autofit_min_size = 14;
	sub_ts.autofit_max_size = 24;
	sub_ts.color = v4.{1.0, 0.92, 0.85, 1.0};
	secs := sh.warning_ends_at - get_time();
	if secs < 0.0 { secs = 0.0; }
	si := secs.(int);
	if secs - si.(float) > 0.001 { si += 1; }
	if si < 1 { si = 1; }
	UI.text(inner, sub_ts, "De-transforming in %... abilities locked", .{si});
}

Mech_Smash_Task_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Smash_Task_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Smash_Task_Icon.png"); }
	can_use :: method() -> bool {
		if player.player_state != Player_State.ALIVE || player.has_task_in_progress() return false;
		if player.player_role == Player_Role.THE_MECH {
			mech := player.entity.get_component(Mech_Module);
			if mech == null || (!mech.is_mech_form && !mech.is_apex) return false;
		} else if !rr_mech_is_minion_active(player) {
			return false;
		}
		if rr_mech_smash_on_cooldown(player) return false;
		return rr_mech_find_smashable_task(player) != null;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			task := rr_mech_find_smashable_task(player);
			rr_mech_smash_task(player, task);
		}
	}
	on_draw_button :: proc(instance: Mech_Smash_Task_Ability, rect: Rect) { draw_ability_name_label(rect, "Smash"); }
}

// Drops a Helmet Trap at a freely-aimed ground point (snapped to the navmesh). The trap then
// clamps a Magnet Helmet onto the first civilian who walks within MECH_HELMET_TRAP_CATCH_RADIUS.
rr_mech_place_helmet_trap :: proc(player: Player, spot: v2) {
	if player == null return;
	pos := rr_mech_clamp_to_ground(spot);
	e := Scene.create_entity();
	e.set_local_position(pos);
	e.add_component(Spine_Animator);
	trap := e.add_component(Mech_Helmet_Trap);
	trap.owner_id = player.entity.id;
	rr_mech_spawn_flash(pos, 0.5, v4.{0.7, 0.9, 1.0, 0.6}, 0.22);
	rr_mech_play_sfx_at("$AO/sfx/FUI Holo Mechanism Activate.wav", pos, 0.28);
}

// Free-placed trap (like the Hunter's campfire / the Magnet Cannon): aim a ground reticle and
// click to plant it, rather than dropping it on the Mech's own position.
Mech_Helmet_Trap_Ability :: class : Ability_Base {
	was_targeting: bool;
	activated_this_session: bool;
	on_init :: proc(a: Mech_Helmet_Trap_Ability) {
		a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Helmet_Trap_Icon.png");
		a.is_aimed_ability = true;
	}
	can_use :: method() -> bool {
		mech := player.entity.get_component(Mech_Module);
		return mech != null && mech.helmet_trap_unlocked && !mech.is_mech_form && !mech.is_apex && player.player_state == Player_State.ALIVE;
	}
	cleanup_targeting :: method() {
		was_targeting = false;
		activated_this_session = false;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;
		if targeting && !params.can_use { player.active_ability = null; cleanup_targeting(); return; }
		if targeting && !was_targeting { activated_this_session = false; was_targeting = true; }
		if !targeting { if was_targeting { cleanup_targeting(); } return; }

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel { player.active_ability = null; cleanup_targeting(); return; }

		// Clamp placement to a max range from the Mech (caps both the reticle and the spawn).
		target_pos := get_mouse_world_position();
		origin := player.entity.world_position;
		to_aim := target_pos - origin;
		aim_dist := length(to_aim);
		if aim_dist > MECH_HELMET_PLACE_RANGE { target_pos = origin + normalize(to_aim) * MECH_HELMET_PLACE_RANGE; }

		if player.is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			UI.push_z(target_pos.y);
			defer UI.pop_z();
			rr_mech_draw_ground_reticle(target_pos, MECH_HELMET_TRAP_CATCH_RADIUS, v4.{0.7, 0.9, 1.0, 0.9});
			preview := get_asset(Texture_Asset, "sprites/icons/mech/Helmet_Trap_Icon.png");
			pr := Rect{target_pos, target_pos}.grow(0.55, 0.55, 0.55, 0.55);
			UI.quad(pr.fit_aspect(preview.get_aspect()), preview, v4.{0.8, 0.95, 1.0, 0.6});
		}

		if activated_this_session return;
		if aiming.activate && params.can_use {
			activated_this_session = true;
			current_cooldown = 30.0; // matches the 30s the helmet stays on a victim's head
			rr_mech_place_helmet_trap(player, target_pos);
			player.active_ability = null;
			cleanup_targeting();
		}
	}
	on_draw_button :: proc(instance: Mech_Helmet_Trap_Ability, rect: Rect) { draw_ability_name_label(rect, "Helmet"); }
}

Mech_Conversion_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Conversion_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Convert_Player_Icon.png"); }
	can_use :: method() -> bool {
		mech := player.entity.get_component(Mech_Module);
		if mech == null || !rr_mech_conversion_available(mech) || (!mech.is_mech_form && !mech.is_apex) return false;
		return rr_mech_find_melee_target(player, true, true) != null;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			target := rr_mech_find_melee_target(player, true, true);
			rr_mech_convert_target(player, target);
		}
	}
	on_draw_button :: proc(instance: Mech_Conversion_Ability, rect: Rect) { draw_ability_name_label(rect, "Convert"); }
}

Mech_Pickup_Throw_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Pickup_Throw_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Loot_Icon.png"); }
	can_use :: method() -> bool {
		mech := player.entity.get_component(Mech_Module);
		if mech == null || (!mech.is_mech_form && !mech.is_apex) return false;
		if mech.carried_player_id != 0 || mech.carried_corpse_id != 0 return true;
		if rr_mech_find_pickup_target(player) != null return true;
		return rr_drag_body_get_closest_draggable_corpse(player) != null;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		mech := player.entity.get_component(Mech_Module);
		// Holding a live player: aim the throw. Click the button to enter aim mode, then
		// click/drag-release to hurl them in the chosen direction (right-click cancels).
		if mech != null && mech.carried_player_id != 0 {
			is_aimed_ability = true;
			activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);
			// Turn the Mech to face where it's aiming the throw. Set on client AND server (facing is
			// synced) so the body and the launched player agree on direction for everyone.
			if abs(activation.direction.x) > 0.01 { player.set_facing_right(activation.direction.x >= 0); }
			if activation.activate && params.can_use {
				target := get_player_by_entity_id(mech.carried_player_id);
				mech.carried_player_id = 0;
				rr_mech_throw_player(player, target, player.entity.id, activation.direction);
				current_cooldown = 30.0;
			}
			return;
		}
		is_aimed_ability = false;
		if params.clicked && params.can_use {
			if mech.carried_corpse_id != 0 {
				c := rr_drag_body_find_corpse_by_entity_id(mech.carried_corpse_id);
				if c != null { c.entity.set_local_position(player.entity.world_position + rr_mech_get_throw_direction(player) * MECH_THROW_DISTANCE); }
				mech.carried_corpse_id = 0;
				current_cooldown = 30.0;
				return;
			}
			target := rr_mech_find_pickup_target(player);
			if target != null {
				// Steal from any Guardian/other Mech already holding them — ends their grab instantly, no cd.
				rr_mech_steal_carried_from_others(player, target.entity.id);
				mech.carried_player_id = target.entity.id;
				// Movement lock comes from Mech_Carried_Status (edge-triggered). Grab plays
				// on overlay track 1 so track-0 locomotion keeps running; carry pose held after.
				rr_mech_play_overlay_oneshot(player, "009SG/cm_pick_up");
				return;
			}
			corpse := rr_drag_body_get_closest_draggable_corpse(player);
			if corpse != null { mech.carried_corpse_id = corpse.entity.id; }
		}
	}
	on_draw_button :: proc(instance: Mech_Pickup_Throw_Ability, rect: Rect) {
		label := "Grab";
		p := instance.player;
		if p != null {
			mech := p.entity.get_component(Mech_Module);
			if mech != null && (mech.carried_player_id != 0 || mech.carried_corpse_id != 0) { label = "Throw"; }
		}
		draw_ability_name_label(rect, label);
	}
}

Mech_Ram_Charge_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Ram_Charge_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Ram_Icon.png"); a.is_aimed_ability = true; }
	can_use :: method() -> bool {
		mech := player.entity.get_component(Mech_Module);
		return mech != null && mech.ram_charge_unlocked && (mech.is_mech_form || mech.is_apex);
	}
	on_update :: method(params: ref Ability_Update_Params) {
		// Targeted variant: only aim + draw the aiming line while Ram is the selected
		// ability. full_update_aimed_ability would draw the line whenever Ram is merely
		// available (active_ability == null), so the line showed permanently.
		activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);
		if activation.activate && params.can_use {
			mech := player.entity.get_component(Mech_Module);
			// Transforming into the Ram truck can't carry a victim/corpse — drop them first.
			// Clearing carried_player_id stops Mech_Carried_Status being refreshed, which
			// auto-releases the victim's carry movement lock (ref-counted, single owner).
			if mech != null { mech.carried_player_id = 0; mech.carried_corpse_id = 0; }
			st := player.entity.get_component(Mech_Ram_Charge_Status);
			if st == null { st = player.entity.add_component(Mech_Ram_Charge_Status); }
			st.owner_id = player.entity.id;
			st.arm(activation.direction, MECH_RAM_SECONDS);
			rr_mech_play_sfx_at("sfx/killer_transform.wav", player.entity.world_position, 0.35);
			current_cooldown = 60.0;
		}
	}
	on_draw_button :: proc(instance: Mech_Ram_Charge_Ability, rect: Rect) { draw_ability_name_label(rect, "Ram"); }
}

// True while this player's Ram car is actually driving (truck out, not the brief transform-in).
rr_mech_car_is_active :: proc(player: Player) -> bool {
	if player == null return false;
	st := player.entity.get_component(Mech_Ram_Charge_Status);
	return st != null && st.active;
}

// APEX-only turbo for the car: lights a fire jet and surges the car's speed for a short window.
// Only available while the car is driving (gated on the live Ram status).
Mech_Car_Boost_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Car_Boost_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/pyro/set_fire.png"); }
	can_use :: method() -> bool {
		mech := player.entity.get_component(Mech_Module);
		if mech == null || !mech.is_apex || player.player_state != Player_State.ALIVE return false;
		st := player.entity.get_component(Mech_Ram_Charge_Status);
		if st == null || !st.active || st.boosting return false;
		return get_time() >= st.boost_cd_until;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			st := player.entity.get_component(Mech_Ram_Charge_Status);
			if st == null return;
			st.start_boost(player);
			current_cooldown = MECH_CAR_BOOST_SECONDS + MECH_CAR_BOOST_COOLDOWN;
		}
	}
	on_draw_button :: proc(instance: Mech_Car_Boost_Ability, rect: Rect) { draw_ability_name_label(rect, "Boost"); }
}

// Bail out of the car early — ends the drive now (transforms back to the Mech). Available in both
// forms while driving. Setting ends_at to now lets the normal completion path in ao_update run the
// revert + transform-in anim next frame.
Mech_Car_Exit_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Car_Exit_Ability) { a.icon = get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_schleem.png"); }
	can_use :: method() -> bool {
		return rr_mech_car_is_active(player) && player.player_state == Player_State.ALIVE;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			st := player.entity.get_component(Mech_Ram_Charge_Status);
			if st != null { st.ends_at = get_time(); }
		}
	}
	on_draw_button :: proc(instance: Mech_Car_Exit_Ability, rect: Rect) { draw_ability_name_label(rect, "Exit"); }
}

// Driver HUD: a countdown of how long is left in the car, floating in WORLD space above the car
// (instead of a screen-edge panel) so it reads as part of the vehicle. Local driver only.
rr_mech_draw_car_hud :: proc(player: Player) {
	if player == null return;
	if !player.is_local_or_server() return;
	if game_state != Game_State.INGAME return;
	st := player.entity.get_component(Mech_Ram_Charge_Status);
	if st == null || !st.active return;

	rem := st.ends_at - get_time();
	if rem < 0.0 { rem = 0.0; }

	UI.push_world_draw_context();
	defer UI.pop_draw_context();
	// Float above the truck (the rig sits ~1.4 high); bias the sort key in front of it.
	car_pos := player.entity.world_position;
	rr_mech_draw_world_countdown(car_pos + v2.{0.0, 2.4}, car_pos.y - 2.0, rem, v4.{1.0, 0.78, 0.28, 1.0});
}

// Snaps a chosen point onto the navmesh so magnets always land on walkable ground.
rr_mech_clamp_to_ground :: proc(pos: v2) -> v2 {
	point: v2;
	tri: s64;
	if try_find_closest_point_on_navmesh(pos, ref point, ref tri) { return point; }
	return pos;
}

// Left/right shoulder muzzle for launching projectiles from the Mech's frame.
rr_mech_shoulder_pos :: proc(player: Player, right: bool) -> v2 {
	// APEX renders at ~1.55x scale, so its shoulder launchers sit higher and wider.
	mech := player.entity.get_component(Mech_Module);
	h := 1.0;
	w := 0.5;
	if mech != null && mech.is_apex { h = 1.7; w = 0.85; }
	off := right ? v2.{w, h} : v2.{-w, h};
	return player.entity.world_position + off;
}

// Ground placement reticle + a faint ring telegraphing the magnet's pull radius.
rr_mech_draw_ground_reticle :: proc(pos: v2, radius: float, color: v4, icon_radius := 0.7) {
	ring := get_asset(Texture_Asset, "sprites/Shapes/shape_circle_gradient.png");
	UI.quad(Rect{pos, pos}.grow(radius), ring, v4.{color.x, color.y, color.z, 0.16});
	reticle := get_asset(Texture_Asset, MECH_GROUND_RETICLE_TEX);
	UI.quad(Rect{pos, pos}.grow(icon_radius).fit_aspect(reticle.get_aspect()), reticle, color);
}

// Placement preview for a magnet rod: a translucent bullseye of its two ranges — large outer
// MAGNETISE pull (blue) and the smaller, hotter electric-SHOCK zone (orange) — with a reticle pin
// marking the exact drop point. Flat see-through fills so the ground/players stay readable through
// them. `alpha` dims the whole thing for already-placed APEX markers.
rr_mech_draw_magnet_ranges :: proc(pos: v2, alpha: float) {
	disc := get_asset(Texture_Asset, "sprites/Shapes/shape_circle.png");
	UI.quad(Rect{pos, pos}.grow(MECH_MAGNET_RADIUS),       disc, v4.{0.25, 0.65, 1.0, 0.22 * alpha});
	UI.quad(Rect{pos, pos}.grow(MECH_MAGNET_SHOCK_RADIUS), disc, v4.{1.0, 0.5, 0.12, 0.42 * alpha});
	reticle := get_asset(Texture_Asset, MECH_GROUND_RETICLE_TEX);
	UI.quad(Rect{pos, pos}.grow(0.7).fit_aspect(reticle.get_aspect()), reticle, v4.{0.75, 0.9, 1.0, alpha});
}

// Fires a single magnet javelin at the chosen point. APEX picks 3 points by calling this
// once per placement (see Mech_Magnet_Cannon_Ability); the base Mech fires once.
rr_mech_fire_magnet_cannon :: proc(player: Player, spot: v2) {
	if player == null return;
	from := player.entity.world_position + v2.{0, 1.0};
	// Aim/fly-in are UNCLAMPED so the harpoon can arc over gaps to the exact aimed point;
	// it clamps to the navmesh only on landing (see Mech_Magnet_Node.land). Set position +
	// fields BEFORE add_component (Powder_Keg_Thrown pattern), and stamp start_time in ao_start.
	e := Scene.create_entity();
	e.set_local_position(from);
	e.add_component(Spine_Animator);
	node := e.add_component(Mech_Magnet_Node);
	node.owner_id = player.entity.id;
	node.start_pos = from;
	node.target_pos = spot;
	rr_mech_spawn_flash(from, 0.4, v4.{0.4, 0.85, 1.0, 0.65}, 0.18);
	rr_mech_play_avatar_anim(player, "009SG/Magnet_Cannon_Shoot", false);
	rr_mech_play_sfx_at("sfx/shoot.wav", player.entity.world_position, 0.3);
	rr_mech_add_screenshake(player, 0.07, 0.2);
}

// Ground-placement barrage: lob one ballistic missile per chosen marker point. Each rocket
// arcs from a shoulder muzzle and crashes down on its fixed point, stunning every enemy caught
// in the blast (AOE) and planting a passage-blocking fire pillar in the crater.
rr_mech_fire_missile_barrage :: proc(player: Player, points: []v2) {
	if player == null return;
	if points.count == 0 return;
	mech := player.entity.get_component(Mech_Module);
	apex := mech != null && mech.is_apex;
	// APEX form fires noticeably bigger missiles with correspondingly bigger blasts.
	missile_scale := apex ? 0.8 : 0.45;
	blast := apex ? 1.7 : 1.0;
	for i: 0..points.count-1 {
		target := points[i];
		right := (i % 2) == 0;
		from := rr_mech_shoulder_pos(player, right);
		e := Scene.create_entity();
		e.set_local_position(from);
		e.set_local_scale(v2.{missile_scale, missile_scale});
		e.add_component(Spine_Animator);
		m := e.add_component(Mech_Missile);
		m.owner_id = player.entity.id;
		m.target_id = 0;
		m.blast_scale = blast;
		m.leaves_fire_pillar = true;
		m.launch_dir = right ? v2.{0.7, 1.0} : v2.{-0.7, 1.0};
		// Ballistic mortar lob onto the fixed ground point (exact endpoint + a nice arc).
		m.ballistic = true;
		m.ballistic_start = from;
		m.ballistic_target = target;
		m.travel_time = 1.0;
		m.arc_height = 4.5;
		// Fallback for the homing path (if ballistic is ever cleared) — fly to the fixed point.
		m.last_target_pos = target;
		m.has_target_pos = true;
	}
	rr_mech_play_avatar_anim(player, "009SG/Missile_Fire", false);
	rr_mech_play_sfx_at("sfx/Whoosh_1e3125.wav", player.entity.world_position, 0.4);
	rr_mech_play_sfx_at("sfx/shoot.wav", player.entity.world_position, 0.28);
	rr_mech_add_screenshake(player, 0.1, 0.22);
}

Mech_Magnet_Cannon_Ability :: class : Ability_Base {
	was_targeting: bool;
	// APEX fires 3 magnets, each placed at its own chosen point. shots_placed counts placements
	// this targeting session; placed_points remembers them so prior picks stay reticled while
	// you choose the next. was_activate edge-detects the click so one press places one magnet
	// (aiming.activate stays held on PC).
	shots_placed: int;
	placed_points: [3]v2;
	was_activate: bool;
	on_init :: proc(a: Mech_Magnet_Cannon_Ability) {
		a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Magnet_Cannon_Icon.png");
		a.is_aimed_ability = true;
	}
	can_use :: method() -> bool {
		mech := player.entity.get_component(Mech_Module);
		return mech != null && mech.magnet_cannon_unlocked && (mech.is_mech_form || mech.is_apex);
	}
	stop_targeting :: proc(using this: Mech_Magnet_Cannon_Ability) {
		// Restore on client AND server (camera is synced). Gating zoom behind is_local desyncs
		// get_mouse_world_position on the server → short placement. Restore to the saved engine
		// default, NOT a size captured on entry: the camera syncs server→client and the zoom is
		// re-applied every frame, so a captured value can snapshot the already-zoomed size and
		// leave the camera stuck zoomed out.
		// Skip the restore while a post-fire camera hold is active — rr_mech_update keeps the wide
		// framing for MECH_MAGNET_CAM_HOLD seconds, then eases it back to default itself.
		mech := player.entity.get_component(Mech_Module);
		holding := mech != null && get_time() < mech.magnet_cam_hold_until;
		if was_targeting && player.is_local_or_server() && player.camera_default_size_saved && !holding {
			player.camera.size = player.camera_default_size;
		}
		was_targeting = false;
		shots_placed = 0;
		was_activate = false;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;
		if targeting && !params.can_use { player.active_ability = null; stop_targeting(this); return; }
		if !targeting { stop_targeting(this); return; }

		// Enter targeting: zoom the camera out, strike the aim pose, and reset the placement run.
		if !was_targeting {
			rr_mech_play_avatar_anim(player, "009SG/Magnet_Cannon_Aim", true);
			shots_placed = 0;
			was_activate = false;
		}
		was_targeting = true;
		// Zoom on client AND server so get_mouse_world_position resolves to the same world point
		// on the authoritative server (camera is synced). is_local-only zoom = short server placement.
		if player.is_local_or_server() { player.camera.size = max(player.camera.size, MECH_AIM_CAMERA_SIZE); }

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel { player.active_ability = null; stop_targeting(this); return; }

		mech := player.entity.get_component(Mech_Module);
		shots_needed := (mech != null && mech.is_apex) ? 3 : 1;

		// Clamp placement to a max range from the Mech. Clamping target_pos here caps BOTH the
		// fire below AND the reticle preview drawn from it, so the two always agree.
		target_pos := get_mouse_world_position();
		origin := player.entity.world_position;
		to_aim := target_pos - origin;
		aim_dist := length(to_aim);
		if aim_dist > MECH_MAGNET_PLACE_RANGE {
			target_pos = origin + normalize(to_aim) * MECH_MAGNET_PLACE_RANGE;
		}
		// Turn the Mech to face the spot it's firing the magnet at. Set on client AND server
		// (facing is synced) so the body and the launched javelin agree on direction for everyone.
		if abs(target_pos.x - origin.x) > 0.01 { player.set_facing_right(target_pos.x >= origin.x); }
		if player.is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			// Range previews for points already locked in this run (dimmed), then the live aim.
			for i: 0..shots_placed-1 {
				UI.push_z(placed_points[i].y);
				rr_mech_draw_magnet_ranges(placed_points[i], 0.5);
				UI.pop_z();
			}
			UI.push_z(target_pos.y);
			rr_mech_draw_magnet_ranges(target_pos, 1.0);
			UI.pop_z();
		}

		// Edge-detect: place one magnet per click (aiming.activate is held on PC).
		fire := aiming.activate && !was_activate;
		was_activate = aiming.activate;
		if fire && params.can_use {
			rr_mech_fire_magnet_cannon(player, target_pos);
			if shots_placed < 3 { placed_points[shots_placed] = target_pos; }
			shots_placed += 1;
			if shots_placed >= shots_needed {
				current_cooldown = 45.0;
				// Linger on the wide aim framing for a beat before snapping the camera back.
				if mech != null { mech.magnet_cam_hold_until = get_time() + MECH_MAGNET_CAM_HOLD; }
				player.active_ability = null;
				stop_targeting(this);
			}
		}
	}
	on_draw_button :: proc(instance: Mech_Magnet_Cannon_Ability, rect: Rect) { draw_ability_name_label(rect, "Magnet"); }
}

// Drives the Missile Barrage free-cam while attached to the Mech during target placement: reads
// the player's movement input, ZEROES it so the avatar stays completely still (no teleport — only
// the camera roams), pans the detached aim camera by that input, and re-applies the camera every
// frame (camera syncs server->client and must be re-applied). Stays attached but fully passive
// (early-returns) whenever placement isn't active. Gated to is_local_or_server so only the
// controlling client + server drive it; the avatar's synced position is untouched everywhere.
// Holds the Mech in place while it free-cams missile placement. The body must NOT move (only the
// camera roams) and must be rock-steady on remote viewers. Everything runs on is_local_or_server
// (NOT is_local): the camera and missile_aim_center sync server->client every ~4 frames, so if the
// server doesn't run the identical roam/freeze the synced (server) values snap the client's camera
// back to the start (rubberband) and let the server's body drift (remote vibration). Both sides
// integrate from the same synced input, so they stay in agreement.
//   - roam: integrate missile_aim_center from input, then zero input/velocity so movement is a no-op
//   - freeze: pin the body to its anchor in BOTH ao_update and ao_late_update (before AND after the
//     movement step) so no drift survives into the network snapshot — mirrors the carried-player pin
//   - camera: re-assert the detached aim camera in both phases so the base follow / sync can't win
Mech_Missile_Aim_Controller :: class : Component {
	los_following: bool; // whether the recording-aid LOS is currently detached onto the aim camera
	apply_camera :: proc(using this: Mech_Missile_Aim_Controller, p: Player, mech: Mech_Module) {
		p.camera.follow_player = false;
		p.camera.position = mech.missile_aim_center;
		p.camera.size = MECH_AIM_CAMERA_SIZE;
	}
	// Pin the body to the synced anchor + kill input/velocity. Runs on EVERY client: each one
	// simulates or interpolates the Mech's position, so each must pin it to the anchor or that
	// client shows the Mech drifting/vibrating. set_local_position overrides whatever it would
	// otherwise display, so this is robust regardless of the netcode's prediction model.
	freeze_body :: proc(using this: Mech_Missile_Aim_Controller, p: Player, mech: Mech_Module) {
		p.entity.set_local_position(mech.missile_aim_anchor);
		p.agent.input_this_frame = v2.{0, 0};
		p.agent.velocity = v2.{0, 0};
	}
	// Recording aid (mech_missile_los_follows_camera): detach the Mech's local fog-of-war LOS from
	// its body and track the roaming aim camera, so the world reveals around the aim point during
	// placement + the post-fire hold. Managed every frame (even when inactive) so it re-attaches to
	// the body on exit. Local-only (the LOS is a per-client render concern).
	update_los_follow :: proc(using this: Mech_Missile_Aim_Controller, p: Player, mech: Mech_Module) {
		if p == null || !p.is_local() return;
		if p.local_light_entity == null || !#alive(p.local_light_entity) return;
		want := mech != null && mech_missile_los_follows_camera && p.player_state == Player_State.ALIVE &&
			(mech.missile_aim_active || get_time() < mech.missile_cam_hold_until);
		if want {
			p.local_light_entity.set_parent(null, true);
			p.local_light_entity.set_local_position(mech.missile_aim_center);
			los_following = true;
		} else if los_following {
			p.local_light_entity.set_parent(p.entity, false);
			p.local_light_entity.set_local_position(v2.{0, 0});
			los_following = false;
		}
	}
	ao_update :: method(dt: float) {
		p := entity.get_component(Player);
		if p == null return;
		mech := entity.get_component(Mech_Module);
		// Runs every frame so the LOS re-attaches when placement ends.
		update_los_follow(this, p, mech);
		if mech == null || !mech.missile_aim_active || p.player_state != Player_State.ALIVE return;
		// Roam the camera (local + server only — camera is a per-client concern) BEFORE the body
		// freeze zeros the input.
		if p.is_local_or_server() {
			input := p.agent.input_this_frame;
			mech.missile_aim_center = mech.missile_aim_center + input * MECH_MISSILE_PAN_SPEED * dt;
			apply_camera(this, p, mech);
		}
		freeze_body(this, p, mech);
	}
	ao_late_update :: method(dt: float) {
		p := entity.get_component(Player);
		if p == null return;
		mech := entity.get_component(Mech_Module);
		if mech == null || !mech.missile_aim_active || p.player_state != Player_State.ALIVE return;
		// Re-pin after the movement step (every client), and re-assert the camera (local + server).
		freeze_body(this, p, mech);
		if p.is_local_or_server() { apply_camera(this, p, mech); }
	}
	ao_end :: method() {
		// Safety: restore the LOS to the body if torn down mid-follow.
		p := entity.get_component(Player);
		if los_following && p != null && p.local_light_entity != null && #alive(p.local_light_entity) {
			p.local_light_entity.set_parent(p.entity, false);
			p.local_light_entity.set_local_position(v2.{0, 0});
			los_following = false;
		}
	}
}

Mech_Missile_Barrage_Ability :: class : Ability_Base {
	was_targeting: bool;
	was_activate: bool;
	on_init :: proc(a: Mech_Missile_Barrage_Ability) {
		a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Missile_Barrage_Icon.png");
		a.is_aimed_ability = true;
	}
	can_use :: method() -> bool {
		mech := player.entity.get_component(Mech_Module);
		return mech != null && mech.missile_barrage_unlocked && (mech.is_mech_form || mech.is_apex);
	}
	stop_targeting :: proc(using this: Mech_Missile_Barrage_Ability) {
		mech := player.entity.get_component(Mech_Module);
		if mech != null { mech.missile_aim_active = false; }
		// Restore the follow camera. Skip while a post-fire cam hold is live — rr_mech_update keeps
		// the strike-zone framing for MECH_MISSILE_CAM_HOLD seconds, then eases it back itself.
		holding := mech != null && get_time() < mech.missile_cam_hold_until;
		if was_targeting && player.is_local_or_server() && player.camera_default_size_saved && !holding {
			player.camera.follow_player = true;
			player.camera.size = player.camera_default_size;
		}
		was_targeting = false;
		was_activate = false;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		targeted := Ability_Utilities.update_targeted_ability(player, this, ref params);
		targeting := targeted.targeting;
		if targeting && !params.can_use { player.active_ability = null; stop_targeting(this); return; }
		if !targeting { stop_targeting(this); return; }

		mech := player.entity.get_component(Mech_Module);
		if mech == null { player.active_ability = null; stop_targeting(this); return; }

		// Enter placement: arm the free-cam, seed the aim cursor at the Mech, reset markers, and
		// make sure the roam controller is attached (it pans the camera + freezes the avatar).
		if !was_targeting {
			mech.missile_aim_active = true;
			mech.missile_aim_center = player.entity.world_position;
			// Pin the body here for the whole placement so it can't drift while the camera roams.
			// (The freeze controller is ensured on every client by rr_mech_update.)
			mech.missile_aim_anchor = player.entity.world_position;
			mech.missile_markers_placed = 0;
			was_activate = false;
		}
		was_targeting = true;

		aiming := Ability_Utilities.update_aiming_ability(player, ref params);
		if aiming.cancel { mech.missile_aim_active = false; player.active_ability = null; stop_targeting(this); return; }

		shots_needed := mech.is_apex ? 6 : 3; // APEX: double the salvo (markers array is [6])

		// Reticle at the current aim point + faint reticles (sized to the blast AOE) for the
		// markers already locked in this run.
		aim_point := get_mouse_world_position();
		if player.is_local() {
			UI.push_world_draw_context();
			defer UI.pop_draw_context();
			for i: 0..mech.missile_markers_placed-1 {
				if i >= 6 break;
				UI.push_z(mech.missile_markers[i].y);
				rr_mech_draw_ground_reticle(mech.missile_markers[i], MECH_MISSILE_BLAST_STUN_RADIUS, v4.{1.0, 0.4, 0.12, 0.45}, MECH_MISSILE_RETICLE_RADIUS);
				UI.pop_z();
			}
			UI.push_z(aim_point.y);
			rr_mech_draw_ground_reticle(aim_point, MECH_MISSILE_BLAST_STUN_RADIUS, v4.{1.0, 0.45, 0.12, 0.95}, MECH_MISSILE_RETICLE_RADIUS);
			UI.pop_z();
		}

		// Edge-detect: drop one marker per click anywhere on the map (no range clamp).
		fire := aiming.activate && !was_activate;
		was_activate = aiming.activate;
		if fire && params.can_use {
			if mech.missile_markers_placed < 6 { mech.missile_markers[mech.missile_markers_placed] = aim_point; }
			mech.missile_markers_placed += 1;
			rr_mech_play_sfx_at("$AO/sfx/FUI Holo Mechanism Activate.wav", aim_point, 0.3);
			if mech.missile_markers_placed >= shots_needed {
				// Launch one missile per marker.
				pts: [..]v2;
				centroid := v2.{0, 0};
				for i: 0..shots_needed-1 {
					if i >= 6 break;
					pts.append(mech.missile_markers[i]);
					centroid = centroid + mech.missile_markers[i];
				}
				rr_mech_fire_missile_barrage(player, pts);
				current_cooldown = 75.0;
				// Park the camera over the strike centroid for a beat so the player watches the
				// rockets crash down (held by rr_mech_update for MECH_MISSILE_CAM_HOLD seconds).
				inv := 1.0 / shots_needed.(float);
				mech.missile_aim_center = centroid * inv;
				mech.missile_cam_hold_until = get_time() + MECH_MISSILE_CAM_HOLD;
				mech.missile_aim_active = false;
				player.active_ability = null;
				stop_targeting(this);
			}
		}
	}
	on_draw_button :: proc(instance: Mech_Missile_Barrage_Ability, rect: Rect) { draw_ability_name_label(rect, "Missile"); }
}

// True while the local Mech is mid-APEX-transform — drives the awakening cinematic (HUD
// hidden, letterbox bars, camera punch-in). apex_transform_locked is a synced flag set in
// rr_mech_awaken_apex and cleared by rr_mech_update when the transform anim finishes.
rr_mech_in_apex_transform_cinematic :: proc(player: Player) -> bool {
	if player == null || player.player_role != Player_Role.THE_MECH return false;
	mech := player.entity.get_component(Mech_Module);
	return mech != null && mech.apex_transform_locked;
}

// APEX awakening action. Safe to run on client + server (guarded by can_awaken; the state
// it sets are synced Mech_Module fields). Triggered by the custom bottom-middle button.
rr_mech_awaken_apex :: proc(player: Player) {
	if player == null return;
	if !rr_mech_can_awaken_apex(player) return;
	mech := player.entity.get_component(Mech_Module);
	if mech == null return;
	mech.power_cores -= 2;
	mech.is_apex = true;
	mech.is_mech_form = true;
	mech.apex_used = true;
	// Clear any active Showdown cooldown so the Guardian always gets a fresh challenge against the
	// titan form. APEX is once per game, so this naturally fires only once.
	rr_mech_reset_guardian_showdown_cooldowns();
	// Hold the pre-APEX mech skin and morph into APEX partway through the transform anim
	// (rr_mech_update flips this at apex_reveal_at) so the body visibly transforms.
	mech.apex_skin_revealed = false;
	mech.apex_reveal_at = get_time() + MECH_APEX_SKIN_REVEAL_SECONDS;
	rr_mech_show_avatar(player, true); // renders the mech skin (not APEX yet) for the morph
	rr_mech_play_avatar_anim(player, "009SG/APEX_transform", false);
	// Lock movement (and hold the anim) for the duration of the transform; rr_mech_update
	// releases it when transform_anim_ends_at passes.
	anim_dur := rr_mech_anim_duration("009SG/APEX_transform");
	mech.transform_anim_ends_at = get_time() + anim_dur;
	mech.anim_lock_until = get_time() + anim_dur;
	player.add_disable_movement_input_reason(MECH_LOCK_REASON);
	mech.apex_transform_locked = true;
	rr_mech_spawn_flash(player.entity.world_position, 1.5, v4.{1.0, 0.25, 0.08, 0.75}, 0.45);
	// Ground shockwave ring rippling out as the transform kicks off.
	rr_mech_spawn_shockwave(player.entity.world_position, 0.6, 6.0, v4.{1.0, 0.45, 0.12, 0.85}, 0.6);
	rr_mech_add_screenshake(player, 0.18, 0.45);
	rr_mech_play_sfx_at("sfx/mim/UltimateTransform.wav", player.entity.world_position, 0.45);
}

// While in APEX form the Mech shrugs off the anti-traitor roles (Hacker / Hunter / Sheriff).
// Other deaths (Guardian Showdown, etc.) still apply. Checked centrally in kill_with_killer.
rr_mech_apex_blocks_kill :: proc(victim: Player, killer: Player) -> bool {
	if victim == null || killer == null return false;
	mech := victim.entity.get_component(Mech_Module);
	if mech == null || !mech.is_apex return false;
	role := killer.player_role;
	return role == Player_Role.HACKER || role == Player_Role.HUNTER || role == Player_Role.SHERIFF;
}

// End Game cinematic — begins the "float up + barrage the whole map" cutscene. The
// actual kills + round end happen at the end of the cinematic in rr_mech_finish_end_game.
// Self-guarded (endgame_active) so a held button or client+server double-entry is harmless.
// End Game is unlocked the instant the Mech wins a Showdown, but stays disarmed for a
// few seconds so a player still mashing the Showdown button can't immediately fumble the
// round-ending barrage. Gates both the titan button display and the trigger itself.
rr_mech_end_game_armed :: proc(mech: Mech_Module) -> bool {
	if mech == null || !mech.endgame_unlocked return false;
	return get_time() >= mech.endgame_unlocked_at + MECH_ENDGAME_UNLOCK_DELAY;
}

rr_mech_trigger_end_game :: proc(player: Player) {
	if player == null return;
	if game_state != Game_State.INGAME return;
	mech := player.entity.get_component(Mech_Module);
	if mech == null || !rr_mech_end_game_armed(mech) || !mech.is_apex return;
	if mech.endgame_active return;

	mech.endgame_active = true;
	mech.endgame_started_at = get_time();
	mech.endgame_anchor = player.entity.world_position;
	mech.endgame_next_wave_at = get_time() + MECH_ENDGAME_FOCUS_SECONDS + MECH_ENDGAME_FLOAT_SECONDS;
	mech.endgame_wave_index = 0;
	// Resurrect the entire lobby so the finale barrage annihilates EVERYONE — no player who
	// died earlier escapes the Mech's last stand. Revive before the freeze loop so the freshly
	// revived players get locked in place for the cutscene (and barraged) too.
	for p: component_iterator(Player) {
		if p == null continue;
		if !#alive(p.entity) continue;
		if p.player_state != Player_State.DEAD continue;
		destroy_corpses_for_player(p.entity.id);
		on_player_go_alive(p);
	}

	// Lock the whole lobby in place for the cutscene. Movement-lock reconciles from the
	// server, so applying it on the acting client+server propagates to everyone.
	player.add_disable_movement_input_reason(MECH_LOCK_REASON);
	for p: component_iterator(Player) {
		if p == null continue;
		if p.player_state != Player_State.ALIVE continue;
		p.add_freeze_reason(MECH_ENDGAME_FREEZE_REASON);
	}
	// Hold the flight pose for the whole cinematic so locomotion doesn't drag it back to Idle.
	mech.anim_lock_until = get_time() + MECH_ENDGAME_FOCUS_SECONDS + MECH_ENDGAME_FLOAT_SECONDS + MECH_ENDGAME_BARRAGE_SECONDS + MECH_ENDGAME_FINISH_SECONDS + 0.5;
	rr_mech_play_avatar_anim(player, "009SG/Fly_Idle", true);
	rr_mech_play_sfx_at("sfx/mim/UltimateTransform.wav", player.entity.world_position, 0.5);
	rr_mech_spawn_flash(player.entity.world_position + v2.{0, 0.6}, 1.6, v4.{1.0, 0.45, 0.1, 0.7}, 0.45);
	rr_mech_add_screenshake(player, 0.16, 0.5);
}

// True while any Mech's End Game cutscene is playing — drives the lobby-wide letterbox bars.
rr_mech_any_endgame_active :: proc() -> bool {
	for mech: component_iterator(Mech_Module) {
		if mech != null && mech.endgame_active return true;
	}
	return false;
}

// Spawns one lethal homing missile per remaining victim, launched from the floating Mech's
// shoulders so the volley reads on the Mech's (camera-locked) screen, then homes out across
// the map onto each target. As victims die the wave naturally thins out.
rr_mech_fire_endgame_wave :: proc(player: Player) {
	if player == null return;
	mech := player.entity.get_component(Mech_Module);
	// Launch from the floating mech body, not the grounded player entity. The APEX rig is
	// ~1.55x scale, so its shoulder launchers sit higher and wider than the base mech.
	shoulder_h := 0.8;
	spread := 0.6;
	if mech != null && mech.is_apex { shoulder_h = 1.7; spread = 0.95; }
	body := player.entity.world_position + v2.{0, MECH_ENDGAME_FLOAT_HEIGHT};
	wave := mech != null ? mech.endgame_wave_index : 0;
	fired := 0;
	// Several homing missiles PER victim — a saturating volley, not a single dart each.
	for p: component_iterator(Player) {
		if p == null || p == player continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.player_type == Player_Type.TRAITOR continue;
		for k: 0..MECH_ENDGAME_MISSILES_PER_VICTIM-1 {
			right := (fired % 2) == 0;
			from := body + (right ? v2.{spread, shoulder_h} : v2.{-spread, shoulder_h});
			e := Scene.create_entity();
			e.set_local_position(from);
			e.set_local_scale(v2.{0.85, 0.85});
			e.add_component(Spine_Animator);
			m := e.add_component(Mech_Missile);
			m.owner_id = player.entity.id;
			m.target_id = p.entity.id;
			m.blast_scale = MECH_ENDGAME_BLAST_SCALE;
			m.is_lethal = true;
			// Lob it: arc high off the shoulder and rain back down onto the (frozen) victim.
			// Fan the impact points apart so a victim's volley doesn't stack on one spot, and
			// stagger travel time so they don't all land on the same frame.
			fan := (k.(float) - (MECH_ENDGAME_MISSILES_PER_VICTIM - 1).(float) * 0.5) * 0.8;
			m.ballistic = true;
			m.ballistic_start = from;
			m.ballistic_target = p.entity.world_position + v2.{fan, 0};
			m.travel_time = MECH_ENDGAME_MISSILE_TRAVEL + k.(float) * 0.18;
			m.arc_height = MECH_ENDGAME_MISSILE_ARC;
			fired += 1;
		}
	}
	// Carpet-bomb the surrounding map with cosmetic ground-strike missiles (no target — they
	// just rain down and blow up for spectacle). Deterministically seeded off the wave index so
	// every client rains them on the same spots.
	rng: u64 = rng_root_seed() + wave.(u64);
	for i: 0..MECH_ENDGAME_SATURATION_PER_WAVE-1 {
		ang := rng_range_float(ref rng, 0.0, 6.2831853);
		dist := rng_range_float(ref rng, 3.0, MECH_ENDGAME_SATURATION_RADIUS);
		ground := mech.endgame_anchor + v2.{cos(ang) * dist, sin(ang) * dist};
		right := (i % 2) == 0;
		from := body + (right ? v2.{spread, shoulder_h} : v2.{-spread, shoulder_h});
		e := Scene.create_entity();
		e.set_local_position(from);
		e.set_local_scale(v2.{0.8, 0.8});
		e.add_component(Spine_Animator);
		m := e.add_component(Mech_Missile);
		m.owner_id = player.entity.id;
		m.blast_scale = MECH_ENDGAME_BLAST_SCALE * 0.85;
		m.is_lethal = true;
		// No target player — lob up and rain down onto the ground point. Vary the arc and
		// timing (deterministically, off the same seed) so they don't fall in lockstep.
		m.ballistic = true;
		m.ballistic_start = from;
		m.ballistic_target = ground;
		m.travel_time = MECH_ENDGAME_MISSILE_TRAVEL + rng_range_float(ref rng, 0.0, 0.6);
		m.arc_height = MECH_ENDGAME_MISSILE_ARC + rng_range_float(ref rng, -1.5, 2.0);
		fired += 1;
	}
	if mech != null { mech.endgame_wave_index = wave + 1; }
	if fired > 0 {
		// Shoot_AL is an arm-layer overlay (track 1), so the Fly_Idle on track 0 keeps playing.
		rr_mech_play_overlay_oneshot(player, "009SG/Shoot_AL");
		rr_mech_play_sfx_at("sfx/shoot.wav", player.entity.world_position, 0.4);
		rr_mech_play_sfx_at("sfx/Whoosh_1e3125.wav", player.entity.world_position, 0.42);
		rr_mech_spawn_flash(body + v2.{0, shoulder_h}, 1.3, v4.{1.0, 0.55, 0.15, 0.8}, 0.2);
		// Heavy launch kick — this is what drives the synced cinematic camera shake on every client.
		rr_mech_add_screenshake(player, 0.32, 0.26);
	}
}

// Drives the End Game cutscene each frame (runs on every client via rr_mech_update).
rr_mech_update_endgame :: proc(player: Player, mech: Mech_Module, dt: float) {
	if player == null || mech == null || !mech.endgame_active return;
	elapsed := get_time() - mech.endgame_started_at;

	// Float the avatar up off the ground — but only AFTER the camera-focus beat, so the
	// camera locks onto the Mech first, then it rises. (Avatar is parented at {0,0}; we lift
	// its local y. Raising world-Y would sort it BEHIND walls, so push the rig in front.)
	if mech.creature_entity != null && #alive(mech.creature_entity) {
		rise := clamp((elapsed - MECH_ENDGAME_FOCUS_SECONDS) / MECH_ENDGAME_FLOAT_SECONDS, 0.0, 1.0);
		eased := 1.0 - (1.0 - rise) * (1.0 - rise); // ease-out
		mech.creature_entity.set_local_position(v2.{0, eased * MECH_ENDGAME_FLOAT_HEIGHT});
		if mech.creature_animator != null { mech.creature_animator.layer = 10; }
	}

	// Hold the flight pose on track 0 the whole cutscene; the shoot anim rides overlay
	// track 1 (see rr_mech_fire_endgame_wave) so flying continues while it fires.
	if mech.last_anim != "009SG/Fly_Idle" {
		rr_mech_play_avatar_anim(player, "009SG/Fly_Idle", true);
	}
	mech.anim_lock_until = max(mech.anim_lock_until, get_time() + 0.5);
	// Camera + lighting are driven globally for all clients in rr_mech_update_endgame_camera.

	barrage_start := MECH_ENDGAME_FOCUS_SECONDS + MECH_ENDGAME_FLOAT_SECONDS;
	barrage_end := barrage_start + MECH_ENDGAME_BARRAGE_SECONDS;
	if elapsed >= barrage_start && elapsed < barrage_end {
		if get_time() >= mech.endgame_next_wave_at {
			rr_mech_fire_endgame_wave(player);
			mech.endgame_next_wave_at = get_time() + MECH_ENDGAME_WAVE_INTERVAL;
		}
	}

	if elapsed >= barrage_end + MECH_ENDGAME_FINISH_SECONDS {
		rr_mech_finish_end_game(player, mech);
	}
}

// Cleans up the cutscene, kills any survivors, and ends the round as a Mech win.
rr_mech_finish_end_game :: proc(player: Player, mech: Mech_Module) {
	if player == null || mech == null return;
	mech.endgame_active = false;
	if mech.creature_entity != null && #alive(mech.creature_entity) {
		mech.creature_entity.set_local_position(v2.{0, 0});
	}
	if mech.creature_animator != null { mech.creature_animator.layer = 0; }
	player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
	if game_state != Game_State.INGAME return;
	winners: List(Player);
	append(ref winners, player);
	for p: component_iterator(Player) {
		if p == null continue;
		rr_remove_freeze_reason_all(p, MECH_ENDGAME_FREEZE_REASON);
		if p == player continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.player_type == Player_Type.TRAITOR continue;
		p.kill_with_killer(player.entity.id);
	}
	rr_mech_play_sfx_at("sfx/ggg_explode.wav", player.entity.world_position, 0.45);
	end_game_with_winners(Player_Type.TRAITOR, winners);
}

// Global cinematic camera for the End Game finale — runs for EVERY client (called from the
// Player late_update) so all players watch the Mech rise and barrage, not just the Mech.
// Zooms in tight on the Mech as it raises to the sky, then pulls out for the barrage.
rr_mech_update_endgame_camera :: proc(player: Player, dt: float) {
	if player == null return;
	if !player.is_local_or_server() return;

	if game_state != Game_State.INGAME {
		if player.mech_endgame_cam_overriding {
			rr_player_restore_default_camera(player, true);
			player.mech_endgame_cam_overriding = false;
		}
		return;
	}

	for mp: component_iterator(Player) {
		if mp == null continue;
		mech := mp.entity.get_component(Mech_Module);
		if mech == null || !mech.endgame_active continue;

		elapsed := get_time() - mech.endgame_started_at;
		// The rig only starts climbing after the camera-focus beat.
		rise := clamp((elapsed - MECH_ENDGAME_FOCUS_SECONDS) / MECH_ENDGAME_FLOAT_SECONDS, 0.0, 1.0);
		eased := 1.0 - (1.0 - rise) * (1.0 - rise);
		// The APEX rig is taller and flies higher, so raise the focus a bit more for it.
		focus_extra := mech.is_apex ? 2.0 : 1.0;
		// Focus on the captured anchor, NOT the live (frozen, but per-frame jittery) player
		// position — otherwise the whole view bobs up/down with reconciliation noise.
		focus := mech.endgame_anchor + v2.{0, eased * MECH_ENDGAME_FLOAT_HEIGHT + focus_extra};

		base := player.camera_default_size_saved ? player.camera_default_size : MECH_ENDGAME_BARRAGE_CAMERA_SIZE;
		barrage_start := MECH_ENDGAME_FOCUS_SECONDS + MECH_ENDGAME_FLOAT_SECONDS;
		target_size := MECH_ENDGAME_RAISE_CAMERA_SIZE;
		if elapsed < MECH_ENDGAME_FOCUS_SECONDS {
			// Focus beat: snap-zoom IN onto the (still grounded) Mech before it rises.
			ft := clamp(elapsed / MECH_ENDGAME_FOCUS_SECONDS, 0.0, 1.0);
			fe := 1.0 - (1.0 - ft) * (1.0 - ft);
			target_size = lerp(base, MECH_ENDGAME_RAISE_CAMERA_SIZE, fe);
		} else if elapsed >= barrage_start {
			// Once it starts firing, pull out to frame the map-wide barrage.
			t := clamp((elapsed - barrage_start) / 0.6, 0.0, 1.0);
			target_size = lerp(MECH_ENDGAME_RAISE_CAMERA_SIZE, MECH_ENDGAME_BARRAGE_CAMERA_SIZE, t);
		}

		// Missile-wave shake, layered ON TOP of the cinematic framing instead of letting
		// Mech_Screenshake_Status snap the camera to the grounded body (which read as the
		// camera "resetting" mid-barrage). Sampled from the Mech's shake status so every
		// client's cinematic shakes in sync.
		shake_off := v2.{0, 0};
		ss := mp.entity.get_component(Mech_Screenshake_Status);
		if ss != null && get_time() < ss.ends_at {
			sdur := ss.ends_at - ss.start_time;
			if sdur > 0.0 {
				samp := ss.intensity * ((ss.ends_at - get_time()) / sdur);
				shake_off = v2.{sin(get_time() * 80.0) * samp, cos(get_time() * 101.0) * samp * 0.7};
			}
		}

		// Cinematic post-processing for the finale — local screen only (it's a fullscreen FX).
		// Only punches BRIEFLY on missile impacts (not a continuous look), and kept very soft.
		if player.is_local() {
			since := get_time() - mech.endgame_last_impact_at;
			impact := clamp(1.0 - since / 0.3, 0.0, 1.0); // short decay after each impact
			if impact > 0.0 {
				bloom: Post_Processing.Bloom_Config;
				bloom.bloom_amount = 0.2 * impact;
				Post_Processing.bloom(bloom);

				ca: Post_Processing.Chromatic_Aberration_Config;
				amt := 0.0014 * impact;
				ca.channel_offsets = v3.{-amt, 0.0, amt};
				ca.focal_point     = v2.{0.5, 0.5};
				Post_Processing.chromatic_aberration(ca);
			}
		}

		// Smoothly ease the camera toward the target so any residual jitter is damped and the
		// zoom/move reads as a deliberate cinematic push rather than a rigid snap. The shake is
		// added on top of the eased focus so it wobbles around the framing rather than dragging
		// it to the body (the offset is tiny, so feeding back through next frame's ease is moot).
		k := clamp(dt * 9.0, 0.0, 1.0);
		player.camera.follow_player = false;
		player.camera.size = lerp(player.camera.size, target_size, k);
		player.camera.position = lerp(player.camera.position, focus, k) + shake_off;
		player.mech_endgame_cam_overriding = true;
		// Vision is blown out separately in update_local_vision_light so the whole map is lit.
		return;
	}

	if player.mech_endgame_cam_overriding {
		rr_player_restore_default_camera(player, true);
		player.mech_endgame_cam_overriding = false;
	}
}

Mech_Apex_Awakening_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Apex_Awakening_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Apex_Awakening_Icon.png"); }
	can_use :: method() -> bool { return rr_mech_can_awaken_apex(player); }
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use { rr_mech_awaken_apex(player); }
	}
	on_draw_button :: proc(instance: Mech_Apex_Awakening_Ability, rect: Rect) { draw_ability_name_label(rect, "APEX"); }
}

Mech_End_Game_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_End_Game_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Missile_Barrage_Icon.png"); }
	can_use :: method() -> bool {
		mech := player.entity.get_component(Mech_Module);
		return rr_mech_end_game_armed(mech) && mech.is_apex;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use { rr_mech_trigger_end_game(player); }
	}
	on_draw_button :: proc(instance: Mech_End_Game_Ability, rect: Rect) { draw_ability_name_label(rect, "End"); }
}

Guardian_Pickup_Throw_Ability :: class : Ability_Base {
	on_init :: proc(a: Guardian_Pickup_Throw_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Loot_Icon.png"); }
	can_use :: method() -> bool {
		guard := player.entity.get_component(Guardian_Module);
		if guard == null || !guard.is_guardian_form return false;
		if guard.carried_player_id != 0 return true;
		target := rr_mech_find_melee_target(player, true);
		if target == null return false;
		// Transformed Mech/Guardian can't be grabbed by the Guardian — the two
		// titans go through Showdown, not the grab/throw path.
		if rr_mech_is_transformed(target) return false;
		return true;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		guard := player.entity.get_component(Guardian_Module);
		// Holding a player: aim the throw. Click to enter aim mode, then click/drag-release
		// to hurl them in the chosen direction (right-click cancels).
		if guard != null && guard.carried_player_id != 0 {
			is_aimed_ability = true;
			activation := Ability_Utilities.full_update_targeted_aimed_ability(player, this, ref params);
			// Turn the Guardian to face where it's aiming the throw (facing is synced, set on both).
			if abs(activation.direction.x) > 0.01 { player.set_facing_right(activation.direction.x >= 0); }
			if activation.activate && params.can_use {
				target := get_player_by_entity_id(guard.carried_player_id);
				guard.carried_player_id = 0;
				rr_guardian_throw_player(player, target, player.entity.id, activation.direction);
				current_cooldown = 30.0;
			}
			return;
		}
		is_aimed_ability = false;
		if params.clicked && params.can_use {
			target := rr_mech_find_melee_target(player, true);
			if target != null {
				if rr_mech_is_transformed(target) return;
				// Steal from any Mech/other Guardian already holding them — ends their grab instantly, no cd.
				rr_mech_steal_carried_from_others(player, target.entity.id);
				guard.carried_player_id = target.entity.id;
				// Movement lock comes from Mech_Carried_Status (edge-triggered). Grab plays on
				// overlay track 1 so track-0 locomotion keeps going; carry pose held after.
				rr_mech_play_overlay_oneshot(player, "009SG/cm_pick_up");
				// Tactile grab: ally-tinted vs enemy-tinted flash at the target + SFX.
				ally := target.player_type == Player_Type.CIVILIAN;
				color := ally ? v4.{0.45, 1.0, 0.55, 0.7} : v4.{1.0, 0.42, 0.32, 0.7};
				rr_mech_spawn_flash(target.entity.world_position + v2.{0, 0.55}, 0.9, color, 0.28);
				rr_mech_play_sfx_at("sfx/swing_net_catch.wav", target.entity.world_position, 0.32);
				rr_mech_play_sfx_at("sfx/pick_up_item_a973cc.wav", player.entity.world_position, 0.3);
				rr_mech_add_screenshake(player, 0.08, 0.18);
				if target.is_local() {
					target.Notify(ally ? "Guardian has you safe!" : "Subdued by the Guardian!");
				}
			}
		}
	}
	on_draw_button :: proc(instance: Guardian_Pickup_Throw_Ability, rect: Rect) {
		label := "Grab";
		p := instance.player;
		if p != null {
			guard := p.entity.get_component(Guardian_Module);
			if guard != null && guard.carried_player_id != 0 { label = "Throw"; }
		}
		draw_ability_name_label(rect, label);
	}
}

// Heroic Guardian throw — same physics/path as the Mech's throw, but with a
// brighter color flash and SFX appropriate to a protector hurling someone clear.
rr_guardian_throw_player :: proc(carrier: Player, target: Player, killer_id: u64, aim_dir: v2) {
	if carrier == null || target == null return;
	rr_mech_play_sfx_at("sfx/swing_net.wav", carrier.entity.world_position, 0.4);
	rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", carrier.entity.world_position, 0.25);
	rr_mech_spawn_flash(carrier.entity.world_position + v2.{0, 0.7}, 0.7, v4.{0.85, 0.95, 0.3, 0.65}, 0.22);
	rr_mech_add_screenshake(carrier, 0.12, 0.22);
	rr_mech_throw_player(carrier, target, killer_id, aim_dir);
}

// A Mech is a valid Showdown target while in a titan form (regular Mech OR APEX) and not already
// downed. The is_apex split only matters at resolution: an APEX loss strips the form (survive),
// a regular Mech-form loss downs (then kills) it. Schleem/human form is never challengeable.
rr_mech_is_showdown_target :: proc(mech: Mech_Module) -> bool {
	if mech == null return false;
	if mech.showdown_downed return false;
	return mech.is_apex || mech.is_mech_form;
}

// Guardian form + a valid Mech target in melee range. Does NOT consider the re-challenge cooldown:
// that's surfaced as the Showdown button's current_cooldown so it stays visible and greys with a
// countdown like every other ability (rather than vanishing).
rr_guardian_has_showdown_target :: proc(player: Player) -> bool {
	guard := player.entity.get_component(Guardian_Module);
	if guard == null || !guard.is_guardian_form return false;
	for p: component_iterator(Player) {
		if p == null || p.player_state != Player_State.ALIVE continue;
		mech := p.entity.get_component(Mech_Module);
		if !rr_mech_is_showdown_target(mech) continue;
		if in_range(p.entity.world_position - player.entity.world_position, MECH_MELEE_RANGE) return true;
	}
	return false;
}

// True while any mech player is in the APEX form. Used to lock down meetings and
// body reports — once the colossal APEX TITAN is loose, the game is in its final
// showdown and players can no longer call meetings or report bodies to interrupt it.
rr_any_mech_apex_active :: proc() -> bool {
	for p: component_iterator(Player) {
		if p == null continue;
		mech := p.entity.get_component(Mech_Module);
		if mech != null && mech.is_apex return true;
	}
	return false;
}

rr_guardian_find_showdown_target :: proc(player: Player) -> Player {
	finder := make_finder(Player, player.entity.world_position, MECH_MELEE_RANGE);
	for p: component_iterator(Player) {
		if p == null || p.player_state != Player_State.ALIVE continue;
		mech := p.entity.get_component(Mech_Module);
		if !rr_mech_is_showdown_target(mech) continue;
		finder.check(p, p.entity.world_position);
	}
	return finder.closest;
}

Guardian_Showdown_Ability :: class : Ability_Base {
	on_init :: proc(a: Guardian_Showdown_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Showdown_Icon.png"); }
	can_use :: method() -> bool {
		guard := player.entity.get_component(Guardian_Module);
		if guard == null || guard.showdown_active return false;
		return rr_guardian_has_showdown_target(player);
	}
	on_update :: method(params: ref Ability_Update_Params) {
		guard := player.entity.get_component(Guardian_Module);
		// Surface the long re-challenge cooldown as the standard greyed button + countdown, so the
		// Showdown button stays visible (next to the Mech) instead of vanishing during the cooldown.
		if guard != null {
			rem := guard.showdown_cooldown_until - get_time();
			current_cooldown = rem > 0.0 ? rem : 0.0;
		}
		if params.clicked && params.can_use {
			if guard == null || guard.showdown_active return;
			if get_time() < guard.showdown_cooldown_until return; // still on cooldown
			apex := rr_guardian_find_showdown_target(player);
			if apex == null return;
			mech := apex.entity.get_component(Mech_Module);
			if mech == null return;
			guard.showdown_active = true;
			guard.showdown_opponent_id = apex.entity.id;
			guard.showdown_mashes = 0;
			guard.showdown_ends_at = get_time() + MECH_SHOWDOWN_SECONDS;
			mech.showdown_active = true;
			mech.showdown_opponent_id = player.entity.id;
			mech.showdown_mashes = 0;
			mech.showdown_ends_at = guard.showdown_ends_at;
			player.add_disable_movement_input_reason(MECH_LOCK_REASON);
			apex.add_disable_movement_input_reason(MECH_LOCK_REASON);

			// Square the two titans up side-by-side at the SAME ground level (the Guardian's Y —
			// it never flies), separated horizontally so they don't clip and the airborne APEX is
			// pulled down to the ground for the clash.
			mid_x := (player.entity.world_position.x + apex.entity.world_position.x) * 0.5;
			ground_y := player.entity.world_position.y;
			guard_left := player.entity.world_position.x <= apex.entity.world_position.x;
			gx := guard_left ? mid_x - MECH_SHOWDOWN_SEPARATION : mid_x + MECH_SHOWDOWN_SEPARATION;
			ax := guard_left ? mid_x + MECH_SHOWDOWN_SEPARATION : mid_x - MECH_SHOWDOWN_SEPARATION;
			player.entity.set_local_position(v2.{gx, ground_y});
			apex.entity.set_local_position(v2.{ax, ground_y});
			clash_pos := v2.{mid_x, ground_y};
			// Capture the clash midpoint once so the camera/crowd frame a stable point
			// (live fighter positions jitter from server reconciliation).
			guard.showdown_anchor = clash_pos;
			// Turn the two titans to face each other across the clash (reapplied each
			// frame in rr_mech_update_showdown_for_guardian so server sync can't reset it).
			player.set_facing_right(guard_left);
			apex.set_facing_right(!guard_left);

			rr_mech_play_avatar_anim(player, "009SG/Showdown_Start", false);
			rr_mech_play_avatar_anim(apex, "009SG/Showdown_Start", false);
			// Big square-up clash: dual roars, twin clash flash between the fighters,
			// heavy screenshake on both sides.
			rr_mech_play_sfx_at("sfx/roar_f23931.wav", player.entity.world_position, 0.45);
			rr_mech_play_sfx_at("sfx/mim/UltimateTransform.wav", clash_pos, 0.42);
			rr_mech_play_sfx_at("sfx/killer_transform.wav", clash_pos, 0.32);
			// Cyan Guardian aura vs red-magenta APEX aura, white clash core between them.
			rr_mech_spawn_flash(player.entity.world_position + v2.{0, 0.7}, 1.3, v4.{0.45, 0.85, 1.0, 0.8}, 0.45);
			rr_mech_spawn_flash(apex.entity.world_position + v2.{0, 0.7}, 1.3, v4.{1.0, 0.25, 0.45, 0.8}, 0.45);
			rr_mech_spawn_flash(clash_pos + v2.{0, 0.6}, 1.6, v4.{1.0, 1.0, 0.95, 0.9}, 0.32);
			rr_mech_add_screenshake(player, 0.22, 0.55);
			rr_mech_add_screenshake(apex, 0.22, 0.55);
		}
	}
	on_draw_button :: proc(instance: Guardian_Showdown_Ability, rect: Rect) { draw_ability_name_label(rect, "Showdown"); }
}

// Slap the loser's entire kit on cooldown so they can't immediately act after the clash.
rr_mech_put_all_abilities_on_cooldown :: proc(p: Player, seconds: float) {
	if p == null return;
	for i: 0..p.abilities.count-1 {
		a := p.abilities[i];
		if a != null { a.current_cooldown = max(a.current_cooldown, seconds); }
	}
}

rr_mech_update_showdown_for_guardian :: proc(player: Player, guard: Guardian_Module) {
	if guard == null return;
	// A lost Showdown is fatal: kill fires at the end of the lose-death anim (set in the
	// resolution branch below). Checked before the showdown_active gate since the showdown
	// is already resolved by the time this lands.
	if guard.showdown_death_at > 0.0 && get_time() >= guard.showdown_death_at {
		guard.showdown_death_at = 0.0;
		player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
		player.kill_with_killer(guard.showdown_death_killer_id);
		return;
	}
	if !guard.showdown_active return;
	// Lock is applied once at showdown start and released once on resolution; the reason
	// is ref-counted, so re-adding it every frame would leak and freeze the fighter.
	// (Cinematic HUD — letterbox, top winner bar, mash button — is rr_mech_draw_showdown_hud.)
	// Once the start anim has played out, loop the dedicated Showdown_Loop on
	// both fighters so the cinematic doesn't sag back to Idle during the mash.
	if get_time() >= guard.anim_lock_until && guard.last_anim != "009SG/Showdown_Loop" {
		rr_mech_play_avatar_anim(player, "009SG/Showdown_Loop", true);
		guard.anim_lock_until = guard.showdown_ends_at;
	}
	mech_opp := get_player_by_entity_id(guard.showdown_opponent_id);
	if mech_opp != null {
		mech_state := mech_opp.entity.get_component(Mech_Module);
		if mech_state != null && get_time() >= mech_state.anim_lock_until && mech_state.last_anim != "009SG/Showdown_Loop" {
			rr_mech_play_avatar_anim(mech_opp, "009SG/Showdown_Loop", true);
			mech_state.anim_lock_until = mech_state.showdown_ends_at;
		}
		// Keep both fighters squared up facing each other for the duration of the clash.
		guard_is_left := player.entity.world_position.x <= mech_opp.entity.world_position.x;
		player.set_facing_right(guard_is_left);
		mech_opp.set_facing_right(!guard_is_left);
	}
	if get_time() < guard.showdown_ends_at return;
	// Re-arm the long re-challenge cooldown the instant the Showdown resolves (any outcome).
	// Only an APEX awaken clears it early (rr_mech_awaken_apex), guaranteeing the Guardian a
	// fresh crack at the titan form.
	guard.showdown_cooldown_until = get_time() + MECH_SHOWDOWN_COOLDOWN;
	mech_player := get_player_by_entity_id(guard.showdown_opponent_id);
	mech_mashes := 0;
	if mech_player != null {
		mech := mech_player.entity.get_component(Mech_Module);
		if mech != null { mech_mashes = mech.showdown_mashes; }
	}
	clash_pos := player.entity.world_position;
	if mech_player != null { clash_pos = (player.entity.world_position + mech_player.entity.world_position) * 0.5; }
	if guard.showdown_mashes >= mech_mashes {
		// The Guardian won — the Mech loses. Its fate depends on the form it lost in.
		mech_was_apex := false; mech_went_down := false;
		if mech_player != null {
			mech := mech_player.entity.get_component(Mech_Module);
			if mech != null {
				mech_was_apex = mech.is_apex;
				mech.showdown_active = false;
				if mech.is_apex {
					// APEX loss — the titan form is broken but the Mech SURVIVES (it had a buffer).
					mech.is_apex = false;
					// Stay a REGULAR mech (NOT schleem); the human body only returns later when the player Transforms back.
					mech.apex_skin_revealed = false;
					mech.apex_lost = true;
					rr_mech_show_avatar(mech_player, true); // force the regular-mech avatar visible (re-enables rig + mech skin; human stays hidden)
					rr_mech_play_avatar_anim(mech_player, "009SG/Showdown_Lose_Survive", false);
					mech_player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
					rr_mech_put_all_abilities_on_cooldown(mech_player, MECH_SHOWDOWN_LOSER_COOLDOWN);
					mech_player.Notify("APEX form lost!");
				} else {
					// Regular Mech-form loss — no buffer. The Mech is FAKE-killed: it plays the
					// lose-death and freezes on the last frame (downed), NOT an immediate real death.
					// Movement stays LOCKED (the body is frozen on the death pose). From here a living
					// Minion can revive it once per game; if no revive is possible (no Minion, or the
					// revive was already spent on an earlier down) it bleeds out to a REAL death —
					// rr_mech_update_showdown_for_mech drives both outcomes.
					rr_mech_show_avatar(mech_player, true);
					rr_mech_play_avatar_anim(mech_player, "009SG/Showdown_Lose_Death", false);
					// Also hold the death pose on the arm-overlay track (track 1). Without this,
					// rr_mech_update_overlay mirrors the base anim onto track 1 as a LOOP and replays
					// the death over and over instead of freezing on the last frame.
					rr_mech_play_overlay_oneshot(mech_player, "009SG/Showdown_Lose_Death");
					mech.showdown_death_killer_id = player.entity.id; // the winning Guardian
					mech.showdown_downed = true;
					// World "Revive Master" interact prompt on the body (add once; can_use self-gates).
					if mech_player.entity.get_component(Mech_Downed_Revive_Interactable) == null {
						mech_player.entity.add_component(Mech_Downed_Revive_Interactable);
					}
					mech_went_down = true;
					if !mech.minion_revive_used && rr_mech_get_living_minion(mech_player) != null {
						mech_player.Notify("Downed! Call your Minion — it can revive you once.");
					} else {
						mech_player.Notify("Downed by the Guardian — no one left to revive you...");
					}
				}
			}
		}
		rr_mech_play_avatar_anim(player, "009SG/Showdown_Win", false);
		// Briefly lock the winner's kit so residual mash taps can't fire an ability.
		rr_mech_put_all_abilities_on_cooldown(player, MECH_SHOWDOWN_WINNER_LOCK);
		// Heroic Guardian victory burst — cyan + gold + white.
		rr_mech_play_sfx_at("sfx/end_game_victory.wav", player.entity.world_position, 0.4);
		rr_mech_play_sfx_at("minigame/shield_block_390d4b.wav", clash_pos, 0.45);
		rr_mech_spawn_flash(clash_pos, 2.0, v4.{0.45, 0.85, 1.0, 0.8}, 0.5);
		rr_mech_spawn_flash(clash_pos, 1.2, v4.{1.0, 0.85, 0.35, 0.85}, 0.36);
		rr_mech_spawn_flash(clash_pos, 0.7, v4.{1.0, 1.0, 1.0, 0.95}, 0.3);
		rr_mech_add_screenshake(player, 0.18, 0.45);
		if mech_player != null { rr_mech_add_screenshake(mech_player, 0.18, 0.45); }
		if mech_was_apex { player.Notify("You broke APEX!"); }
		else if mech_went_down { player.Notify("You downed the Mech!"); }
		else { player.Notify("You slew the Mech!"); }
	} else if mech_player != null {
		mech := mech_player.entity.get_component(Mech_Module);
		if mech != null {
			mech.showdown_active = false;
			mech_player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
			// Briefly lock the winner's kit so residual mash taps can't fire an ability.
			rr_mech_put_all_abilities_on_cooldown(mech_player, MECH_SHOWDOWN_WINNER_LOCK);
			// End Game is an APEX-only finisher (the button stays hidden until is_apex — see show_end).
			// It only unlocks when the Showdown is won while in APEX form. A regular-form win no longer banks
			// the unlock for later; the Mech must reach APEX and win a Showdown in that form.
			if mech.is_apex {
				mech.endgame_unlocked = true;
				mech.endgame_unlocked_at = get_time();
				mech_player.Notify("End Game Ability unlocked.");
			} else {
				mech_player.Notify("You defeated the Guardian!");
			}
		}
		death_anim_dur := rr_mech_anim_duration("009SG/Showdown_Lose_Death");
		rr_mech_play_avatar_anim(player, "009SG/Showdown_Lose_Death", false);
		// Losing the Showdown is fatal — the Guardian is killed at the end of the death anim.
		// Keep the lock held (don't release it below) so it can't move during the death throes.
		guard.showdown_death_at = get_time() + death_anim_dur;
		guard.showdown_death_killer_id = mech_player != null ? mech_player.entity.id : 0;
		guard.anim_lock_until = guard.showdown_death_at;
		// Brutal APEX defeat burst — red-magenta + purple.
		rr_mech_play_sfx_at("sfx/ggg_explode.wav", clash_pos, 0.45);
		rr_mech_play_sfx_at("sfx/other_death.wav", player.entity.world_position, 0.4);
		rr_mech_spawn_flash(clash_pos, 2.0, v4.{1.0, 0.22, 0.42, 0.85}, 0.5);
		rr_mech_spawn_flash(clash_pos, 1.2, v4.{0.75, 0.3, 1.0, 0.85}, 0.36);
		rr_mech_spawn_flash(clash_pos, 0.7, v4.{1.0, 0.95, 1.0, 0.95}, 0.3);
		rr_mech_add_screenshake(player, 0.22, 0.55);
		rr_mech_add_screenshake(mech_player, 0.22, 0.55);
		player.Notify("APEX overpowered you...");
		guard.showdown_active = false;
		return;
	}
	guard.showdown_active = false;
	player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
}

// ── Cinematic Showdown HUD (screen-space) ──────────────────────────────────────
// Letterbox bars + a top "who's winning" tug-of-war bar for everyone watching, and a
// big bottom-center MASH button for the two fighters. Replaces the old world gauge.

rr_mech_find_showdown_guardian :: proc() -> Player {
	for p: component_iterator(Player) {
		if p == null continue;
		g := p.entity.get_component(Guardian_Module);
		if g != null && g.showdown_active return p;
	}
	return null;
}

rr_mech_any_showdown_active :: proc() -> bool {
	return rr_mech_find_showdown_guardian() != null;
}

// The dramatic centre of the clash — the midpoint captured once at Showdown start (it
// doesn't jitter with reconciliation like the live fighter positions do).
rr_mech_showdown_clash_center :: proc(guard_p: Player) -> v2 {
	if guard_p == null return v2.{0, 0};
	guard := guard_p.entity.get_component(Guardian_Module);
	if guard == null return guard_p.entity.world_position;
	return guard.showdown_anchor;
}

// Centre the camera on the clash midpoint for EVERY client (fighters and spectators alike)
// so the whole lobby watches the square-up, then restore the default follow camera once the
// Showdown resolves. Mirrors rr_mech_update_endgame_camera's structure.
rr_mech_update_showdown_camera :: proc(player: Player, dt: float) {
	if player == null return;
	if !player.is_local_or_server() return;

	guard_p := rr_mech_find_showdown_guardian();
	if guard_p != null && game_state == Game_State.INGAME {
		focus := rr_mech_showdown_clash_center(guard_p) + v2.{0, MECH_SHOWDOWN_CAMERA_Y_OFFSET};
		// Zoom IN to frame the clash, but never zoom further out than the player's default.
		base := player.camera_default_size_saved ? player.camera_default_size : MECH_SHOWDOWN_CAMERA_SIZE;
		target_size := min(base, MECH_SHOWDOWN_CAMERA_SIZE);

		// Layer the mash screenshake ON TOP of the fixed clash framing rather than letting
		// Mech_Screenshake_Status snap the camera to the local body (which jumped the view
		// off the clash on every mash press). Sampled from the local player's shake status.
		shake_off := v2.{0, 0};
		ss := player.entity.get_component(Mech_Screenshake_Status);
		if ss != null && get_time() < ss.ends_at {
			sdur := ss.ends_at - ss.start_time;
			if sdur > 0.0 {
				samp := ss.intensity * ((ss.ends_at - get_time()) / sdur);
				shake_off = v2.{sin(get_time() * 80.0) * samp, cos(get_time() * 101.0) * samp * 0.7};
			}
		}

		k := clamp(dt * 9.0, 0.0, 1.0);
		player.camera.follow_player = false;
		player.camera.size = lerp(player.camera.size, target_size, k);
		player.camera.position = lerp(player.camera.position, focus, k) + shake_off;
		player.mech_showdown_cam_overriding = true;
		return;
	}

	if player.mech_showdown_cam_overriding {
		rr_player_restore_default_camera(player, true);
		player.mech_showdown_cam_overriding = false;
	}
}

// Ring every other surviving player around the clash and set them crying, so the duel plays
// to an audience. Self-healing: the moment no Showdown is active (resolved, round reset, etc.)
// anyone gathered is released back to normal movement. Runs as gameplay on all clients/server.
rr_mech_update_showdown_crowd :: proc(player: Player) {
	if player == null return;

	guard_p := rr_mech_find_showdown_guardian();
	is_active := guard_p != null && game_state == Game_State.INGAME;
	// Resolve the Mech opponent so the two fighters are excluded from the crowd.
	mech_p := guard_p; // placeholder of type Player; only read when is_active
	if is_active {
		guard := guard_p.entity.get_component(Guardian_Module);
		if guard != null { mech_p = get_player_by_entity_id(guard.showdown_opponent_id); }
	}

	eligible := is_active && player != guard_p && player != mech_p && player.player_state == Player_State.ALIVE;

	if eligible {
		if !player.mech_showdown_crowd {
			player.mech_showdown_crowd = true;
			// Deterministic ring slot: index among the crowd sorted by entity id, so every
			// client agrees on placement. Snapped onto the navmesh so nobody is forced off
			// the walkable area — that left frozen spectators vibrating against the edge.
			clash_center := rr_mech_showdown_clash_center(guard_p);
			idx := 0;
			total := 0;
			for p: component_iterator(Player) {
				if p == null || p == guard_p || p == mech_p continue;
				if p.player_state != Player_State.ALIVE continue;
				total += 1;
				if p.entity.id < player.entity.id { idx += 1; }
			}
			if total < 1 { total = 1; }
			angle := (idx.(float) / total.(float)) * 2.0 * PI;
			offset := v2.{cos(angle), sin(angle)} * MECH_SHOWDOWN_CROWD_RADIUS;
			slot := rr_mech_clamp_to_ground(clash_center + offset);
			player.entity.set_local_position(slot);
			player.set_facing_right(clash_center.x > slot.x);
			// Fully FREEZE (not just disable input) and place once — re-applying position
			// every frame fought collision and made them jitter near navmesh edges.
			player.add_freeze_reason(MECH_SHOWDOWN_CROWD_REASON);
			player.set_trigger("hacker_crying_loop");
		}
	} else {
		if player.mech_showdown_crowd {
			player.mech_showdown_crowd = false;
			rr_remove_freeze_reason_all(player, MECH_SHOWDOWN_CROWD_REASON);
			player.set_trigger("RESET");
		}
	}
}

// Top-center tug-of-war bar: green Guardian fills from the left, red APEX from the right,
// split by their relative mash counts, with a "who's winning" call-out + countdown.
rr_mech_draw_showdown_top_bar :: proc(player: Player, guard_mashes: int, apex_mashes: int, time_left: float) {
	// Mech / Guardian palette: Guardian = cyan, APEX = hot red-magenta.
	G_COL :: v4.{0.45, 0.85, 1.0, 1.0};
	A_COL :: v4.{1.0, 0.22, 0.42, 1.0};

	safe := UI.get_safe_screen_rect();
	cx := (safe.min.x + safe.max.x) * 0.5;
	top := safe.max.y;
	win := Rect{ v2.{cx - 430.0, top - 230.0}, v2.{cx + 430.0, top - 28.0} };

	win_desc := UIK.window(win);
	win_desc.layer = 2100; // above the letterbox bars (drawn at ~2000)
	UIK.begin(win_desc);

	col := UIK.layout_column();
	col.width = UIK.flex(1);
	col.height = UIK.flex(1);
	col.gap = 8;
	col.cross_align = .CENTER;
	col.main_align = .START;
	col.show_background = false;
	UIK.panel_begin(col);

	// Countdown.
	cd := UIK.text_title();
	cd.set_size_mult(0.62);
	cd.color = v4.{1.0, 0.92, 0.7, 1.0};
	cd.override_flags |= UIK.Text_Override_COLOR | UIK.Text_Override_SIZE_MULT;
	UIK.text(format_string("% s", .{format_float(time_left, decimals=1)}), cd);

	// Tug-of-war split bar: guardian (cyan) vs APEX (red), split by mash counts. +1 on each
	// weight keeps both sides visible at 0-0 (a flex weight of 0 would collapse that half).
	// The split is free to run all the way to either edge — the labels ride on TOP as
	// edge-pinned overlays (below), so a lopsided bar never clips the name/count text.
	g_weight := guard_mashes.(float) + 1.0;
	a_weight := apex_mashes.(float) + 1.0;

	bar := UIK.layout_row(UIK.pixels(780), UIK.pixels(48), 0);
	bar.cross_align = .CENTER;
	bar.show_background = false;
	UIK.panel_begin(bar);

	g_half := UIK.panel_styled(.INTERIOR_WHITE);
	g_half.width = UIK.flex(g_weight);
	g_half.height = UIK.flex(1);
	g_half.tint = G_COL;
	UIK.panel_begin(g_half);
	UIK.panel_end();

	// Bright seam at the balance point.
	seam := UIK.panel_styled(.INTERIOR_WHITE);
	seam.width = UIK.pixels(4);
	seam.height = UIK.flex(1);
	seam.tint = v4.{1, 1, 1, 1};
	UIK.panel_begin(seam);
	UIK.panel_end();

	a_half := UIK.panel_styled(.INTERIOR_WHITE);
	a_half.width = UIK.flex(a_weight);
	a_half.height = UIK.flex(1);
	a_half.tint = A_COL;
	UIK.panel_begin(a_half);
	UIK.panel_end();

	// Labels overlaid on top of the bar, pinned to each edge (outside layout flow) with a
	// black outline so they stay readable wherever the colored split happens to land.
	g_lbl := UIK.text_button();
	g_lbl.set_size_mult(0.85);
	g_lbl.set_color(v4.{0.88, 0.98, 1.0, 1.0});
	g_lbl.set_outline(true, 3.0, v4.{0, 0, 0, 1});
	UIK.overlay_begin(.CENTER_LEFT, v2.{16, 0});
	UIK.text(format_string("GUARDIAN  %", .{guard_mashes}), g_lbl);
	UIK.overlay_end();

	a_lbl := UIK.text_button();
	a_lbl.set_size_mult(0.85);
	a_lbl.set_color(v4.{1.0, 0.88, 0.93, 1.0});
	a_lbl.set_outline(true, 3.0, v4.{0, 0, 0, 1});
	UIK.overlay_begin(.CENTER_RIGHT, v2.{-16, 0});
	UIK.text(format_string("%  APEX", .{apex_mashes}), a_lbl);
	UIK.overlay_end();

	UIK.panel_end(); // bar

	// "Who's winning" call-out.
	status := "DEAD EVEN";
	scol := v4.{1, 1, 1, 1};
	if guard_mashes > apex_mashes { status = "GUARDIAN WINNING"; scol = G_COL; }
	else if apex_mashes > guard_mashes { status = "APEX WINNING"; scol = A_COL; }
	st := UIK.text_title();
	st.set_size_mult(0.8);
	st.color = scol;
	st.override_flags |= UIK.Text_Override_COLOR | UIK.Text_Override_SIZE_MULT;
	UIK.text(status, st);

	UIK.panel_end(); // col
	UIK.end();
}

// Big bottom-center MASH button, tinted to the fighter (Guardian blue / APEX red).
// Returns true on each click. Drawn under is_local_or_server so the click counts on the server.
rr_mech_draw_showdown_mash_button :: proc(player: Player, am_guard: bool) -> bool {
	safe := UI.get_safe_screen_rect();
	cx := (safe.min.x + safe.max.x) * 0.5;
	base_y := safe.min.y;
	win := Rect{ v2.{cx - 200.0, base_y + 40.0}, v2.{cx + 200.0, base_y + 360.0} };

	win_desc := UIK.window(win);
	win_desc.layer = 2100;
	UIK.begin(win_desc);

	col := UIK.layout_column();
	col.width = UIK.flex(1);
	col.height = UIK.flex(1);
	col.cross_align = .CENTER;
	col.main_align = .CENTER;
	col.show_background = false;
	UIK.panel_begin(col);

	style := UIK.Panel_Background_Kind.BUTTON_SHINY_RED;
	if am_guard { style = UIK.Panel_Background_Kind.BUTTON_SHINY_BLUE; }
	bd := UIK.widget_desc_button_default(style);
	bd.panel.width = UIK.pixels(240);
	bd.panel.height = UIK.pixels(150);
	bd.label_text.set_size_mult(1.8);
	bd.label_text.override_flags |= UIK.Text_Override_SIZE_MULT;
	// Unique id per fighter — the server runs this for BOTH fighters in one frame, so a shared
	// id would conflate the two buttons' click state.
	btn_id := am_guard ? "showdown_mash_guardian" : "showdown_mash_apex";
	res := UIK.button(btn_id, "MASH!", bd);

	UIK.panel_end();
	UIK.end();
	return res.clicked;
}

// Orchestrates the cinematic Showdown HUD. Called for every local player so spectators
// get the framing too; only the two fighters get the mash button.
rr_mech_draw_showdown_hud :: proc(player: Player) {
	if player == null || !player.is_local_or_server() return;
	if game_state != Game_State.INGAME return;
	guard_p := rr_mech_find_showdown_guardian();
	if guard_p == null return;
	guard := guard_p.entity.get_component(Guardian_Module);
	if guard == null return;
	apex_p := get_player_by_entity_id(guard.showdown_opponent_id);
	apex_mech: Mech_Module = null;
	apex_mashes := 0;
	if apex_p != null {
		apex_mech = apex_p.entity.get_component(Mech_Module);
		if apex_mech != null { apex_mashes = apex_mech.showdown_mashes; }
	}
	time_left := guard.showdown_ends_at - get_time();
	if time_left < 0.0 { time_left = 0.0; }

	// Only the two fighters get the HUD (letterbox framing, tug-of-war slider + text, mash
	// button). Everyone else still sees the world-space clash anims, just no UI overlay.
	am_guard := player == guard_p;
	am_apex := apex_p != null && player == apex_p;
	if !am_guard && !am_apex return;

	// Cinematic framing — letterbox + top winner bar — for the fighter watching locally.
	if player.is_local() {
		player.draw_letterbox_bars();
		rr_mech_draw_showdown_top_bar(player, guard.showdown_mashes, apex_mashes, time_left);
	}

	// MASH button; click increments THIS fighter's mash count.
	if rr_mech_draw_showdown_mash_button(player, am_guard) {
		if am_guard { guard.showdown_mashes += 1; }
		else if apex_mech != null { apex_mech.showdown_mashes += 1; }
		if player.is_local() {
			rr_mech_play_sfx_at("sfx/metal_hit_827869.wav", player.entity.world_position, 0.35);
			flash_col := am_guard ? v4.{0.5, 0.9, 1.0, 0.7} : v4.{1.0, 0.3, 0.5, 0.7};
			rr_mech_spawn_flash(player.entity.world_position + v2.{0, 0.8}, 0.4, flash_col, 0.12);
			rr_mech_add_screenshake(player, 0.05, 0.09);
		}
	}
}

rr_mech_update_showdown_for_mech :: proc(player: Player, mech: Mech_Module) {
	if mech == null return;

	// Pending lost-Showdown death (regular Mech-form loss with no revive available): the kill
	// fires at the end of the lose-death anim. Mirrors the Guardian's showdown_death_at path,
	// and is checked first since the showdown itself is already resolved by the time this lands.
	if mech.showdown_death_at > 0.0 && get_time() >= mech.showdown_death_at {
		mech.showdown_death_at = 0.0;
		mech.showdown_downed = false;
		player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
		player.kill_with_killer(mech.showdown_death_killer_id);
		return;
	}

	// Faked death (downed): hold the lose-death pose frozen on its last frame by keeping the
	// locomotion anim-lock ahead, and stay movement-locked. A living Minion can revive it once per
	// game (see Mech_Downed_Revive_Interactable). If NO revive is possible — the once-per-game revive is
	// already spent, or there's no living Minion to reach it — the faked death becomes a REAL death
	// after a brief hold on the pose (showdown_death_at, fired by the kill check above).
	if mech.showdown_downed {
		// Keep BOTH spine tracks frozen on the lose-death last frame: anim_lock_until gates the
		// track-0 locomotion, overlay_clear_at gates the track-1 arm overlay (rr_mech_update_overlay
		// returns early while this is ahead) so neither resumes/loops over the held pose.
		mech.anim_lock_until = get_time() + 1.0;
		mech.overlay_clear_at = get_time() + 1.0;
		revive_possible := !mech.minion_revive_used && rr_mech_get_living_minion(player) != null;
		if revive_possible {
			mech.showdown_death_at = 0.0; // a revive is on the table — cancel any pending bleed-out
		} else if mech.showdown_death_at == 0.0 {
			mech.showdown_death_at = get_time() + MECH_SHOWDOWN_FAKEDEATH_HOLD;
		}
		return;
	}

	if !mech.showdown_active return;
	// Lock applied once at showdown start, released on resolution — don't re-add per
	// frame (ref-counted reason would leak and freeze the Mech after the showdown).
	if get_time() >= mech.showdown_ends_at {
		// Guardian updater resolves the result. If it is gone, fail open to Mech.
		guardian := get_player_by_entity_id(mech.showdown_opponent_id);
		if guardian == null {
			// End Game only unlocks from an APEX Showdown win (see the win path above).
			if mech.is_apex {
				mech.endgame_unlocked = true;
				mech.endgame_unlocked_at = get_time();
			}
			mech.showdown_active = false;
			player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
		}
	}
}

// Clears the Showdown re-challenge cooldown on every Guardian. Called once when a Mech awakens APEX
// (rr_mech_awaken_apex) so the Guardian always gets a fresh challenge against the new titan form.
rr_mech_reset_guardian_showdown_cooldowns :: proc() {
	for p: component_iterator(Player) {
		if p == null continue;
		guard := p.entity.get_component(Guardian_Module);
		if guard != null { guard.showdown_cooldown_until = 0.0; }
	}
}

// "Call Minion" distress ping fired by a downed (faked-death) Mech: a desperate roar + a red pulse
// flash at the Mech, plus a direct notification to its living Minion to come revive it. There is NO
// teleport — the Minion travels over on its own, guided by the world-space arrow drawn in
// rr_mech_draw_downed_revive_ui.
rr_mech_call_minion :: proc(mech_player: Player) {
	if mech_player == null || !#alive(mech_player.entity) return;
	pos := mech_player.entity.world_position;
	rr_mech_play_sfx_at("sfx/roar_f23931.wav", pos, 0.45);
	// Positive layers so the call-Minion burst/rings render ABOVE the floor (were buried at -7).
	rr_mech_spawn_flash(pos + v2.{0, 0.7}, 1.3, v4.{1.0, 0.3, 0.3, 0.7}, 0.4, 6);
	// Red distress shockwave rippling out from the downed Mech so everyone sees the call go up.
	rr_mech_spawn_shockwave(pos, 0.7, 8.0, v4.{1.0, 0.2, 0.25, 0.8}, 0.6, 6);
	rr_mech_spawn_shockwave(pos, 0.45, 5.5, v4.{1.0, 0.4, 0.4, 0.65}, 0.45, 6);
	rr_mech_add_screenshake(mech_player, 0.1, 0.25);
	mech_player.Notify("Your minion has been called");
	minion := rr_mech_get_living_minion(mech_player);
	if minion != null { minion.Notify("The Mech is DOWN — get to them and revive!"); }
}

// "Call Minion" — the ONLY button a downed Mech can use (its kit is hidden while downed). Fires the
// distress ping. Drawn by rr_mech_draw_abilities only while downed with a living Minion.
Mech_Call_Minion_Ability :: class : Ability_Base {
	on_init :: proc(a: Mech_Call_Minion_Ability) { a.icon = get_asset(Texture_Asset, "sprites/icons/mech/Convert_Player_Icon.png"); }
	can_use :: method() -> bool {
		if player.player_role != Player_Role.THE_MECH || player.player_state != Player_State.ALIVE return false;
		mech := player.entity.get_component(Mech_Module);
		if mech == null || !mech.showdown_downed return false;
		return rr_mech_get_living_minion(player) != null;
	}
	on_update :: method(params: ref Ability_Update_Params) {
		if params.clicked && params.can_use {
			rr_mech_call_minion(player);
			current_cooldown = MECH_CALL_MINION_COOLDOWN;
		}
	}
	on_draw_button :: proc(instance: Mech_Call_Minion_Ability, rect: Rect) { draw_ability_name_label(rect, "Call Minion"); }
}

// Minion revives its downed master: clears the faked-death/downed state, unlocks movement, and
// stands the Mech back up in its regular Mech form. Consumes the once-per-game revive. VFX + SFX.
rr_mech_revive_downed :: proc(mech_player: Player) {
	if mech_player == null || !#alive(mech_player.entity) return;
	mech := mech_player.entity.get_component(Mech_Module);
	if mech == null || !mech.showdown_downed return;
	mech.showdown_downed = false;
	mech.showdown_death_at = 0.0;
	mech.minion_revive_used = true;
	mech_player.remove_disable_movement_input_reason(MECH_LOCK_REASON);
	// Release both frozen-pose gates so the avatar stands up: track-0 locomotion resumes (Idle/Run)
	// and the track-1 arm overlay re-mirrors it again instead of holding the death pose.
	mech.anim_lock_until = get_time();
	mech.overlay_clear_at = 0.0;
	mech.last_overlay_anim = "";
	// Brief kit lock so the Mech can't act on the very frame it gets back up.
	rr_mech_put_all_abilities_on_cooldown(mech_player, MECH_SHOWDOWN_WINNER_LOCK);
	pos := mech_player.entity.world_position;
	rr_mech_spawn_flash(pos + v2.{0, 0.7}, 1.4, v4.{0.4, 1.0, 0.5, 0.8}, 0.45); // healing green
	rr_mech_spawn_shockwave(pos, 0.6, 6.0, v4.{0.4, 1.0, 0.5, 0.7}, 0.5);
	rr_mech_add_screenshake(mech_player, 0.14, 0.35);
	rr_mech_play_sfx_at("sfx/transform_poof_2da056.wav", pos, 0.4);
	mech_player.Notify("Your Minion revived you!");
}

// Revive Master — a world interact prompt on a DOWNED Mech's body. Its living Minion walks up and
// holds to revive it (once per game). Lives on the Mech's entity (added when it goes down); can_use
// fully self-gates so the prompt only shows to the right Minion, in range, while a revive is owed.
Mech_Downed_Revive_Interactable :: class : Interactable {
	ao_start :: method() {
		this.set_listener(this);
		this.set_text("Revive Mech");
		this.set_hold_text("Reviving...");
		required_hold_time = 1.5;
		radius = MECH_SHOWDOWN_REVIVE_RANGE;
		prompt_offset = v2.{0, 1.4};
		priority = 220;
	}
	can_use :: method(player: Player) -> bool {
		if player == null || player.player_state != Player_State.ALIVE return false;
		mech := entity.get_component(Mech_Module);
		if mech == null || !mech.showdown_downed || mech.minion_revive_used return false;
		// Only this Mech's own living Minion can revive it.
		if !rr_mech_is_minion_active(player) return false;
		owner := rr_mech_get_owner(player);
		return owner != null && owner.entity == entity;
	}
	on_interact :: method(player: Player) {
		rr_mech_revive_downed(entity.get_component(Player));
	}
}

// World-space distress arrow drawn for a Minion whose master Mech is downed (faked death) — points
// the Minion to the body so it can revive. Drawn per local player from player.csl late_update.
rr_mech_draw_downed_revive_ui :: proc(player: Player) {
	if player == null || !player.is_local() return;
	if game_state != Game_State.INGAME return;
	if !rr_mech_is_minion_active(player) return;
	owner := rr_mech_get_owner(player);
	if owner == null || !#alive(owner.entity) return;
	mech := owner.entity.get_component(Mech_Module);
	if mech == null || !mech.showdown_downed || mech.minion_revive_used return;
	options := Tutorial_Arrow.default_options();
	options.alpha = 0.7;
	options.far = true;
	options.near = false; // only guide the Minion in while the body is off-screen; the in-range Revive button takes over up close
	UI.push_color_multiplier(v4.{1.0, 0.35, 0.4, 1.0}); // urgent red
	defer UI.pop_color_multiplier();
	rr_draw_tutorial_arrow(player, owner.entity.world_position, options);
}

// =====================================================================
// Workbench UI (UIK modal). Opened by the Mech_Workbench_Interactable.
// =====================================================================

rr_mech_apex_status_text :: proc(player: Player, mech: Mech_Module) -> string {
	if mech.is_apex return "APEX ACTIVE — weapons upgraded.";
	if mech.apex_lost return "Lost in Showdown — cannot reawaken.";
	if mech.apex_used return "Already awakened this game.";
	if rr_mech_can_awaken_apex(player) return "READY — use the APEX ability in Mech form.";
	missing := 0;
	if !mech.helmet_trap_unlocked     missing += 1;
	if !mech.ram_charge_unlocked      missing += 1;
	if !mech.magnet_cannon_unlocked   missing += 1;
	if !mech.missile_barrage_unlocked missing += 1;
	cores_needed := 2 - mech.power_cores;
	if cores_needed < 0 { cores_needed = 0; }
	if missing > 0 && cores_needed > 0 return format_string("Need % more weapons + % Power Cores.", .{missing, cores_needed});
	if missing > 0 return format_string("Need % more weapons.", .{missing});
	return format_string("Need % more Power Cores.", .{cores_needed});
}

// Lookup for a workbench upgrade: name, icon path, cost component (0 == 2-of-any),
// and theme tint. Shared by the workbench cards and the progression checklist.
rr_mech_upgrade_info :: proc(upgrade_id: int) -> string, string, int, v4 {
	if upgrade_id == MECH_UPGRADE_HELMET_TRAP     return "Helmet Trap",     "sprites/icons/mech/Helmet_Trap_Icon.png",     MECH_COMPONENT_GEAR,       v4.{0.42, 0.42, 0.48, 1};
	if upgrade_id == MECH_UPGRADE_RAM_CHARGE      return "Ram Charge",      "sprites/icons/mech/Ram_Icon.png",             MECH_COMPONENT_POWER_CELL, v4.{0.55, 0.18, 0.14, 1};
	if upgrade_id == MECH_UPGRADE_MAGNET_CANNON   return "Magnet Cannon",   "sprites/icons/mech/Magnet_Cannon_Icon.png",   MECH_COMPONENT_SCHEMATIC,  v4.{0.16, 0.38, 0.6, 1};
	if upgrade_id == MECH_UPGRADE_MISSILE_BARRAGE return "Missile Barrage", "sprites/icons/mech/Missile_Barrage_Icon.png", MECH_COMPONENT_CIRCUIT,    v4.{0.55, 0.45, 0.12, 1};
	if upgrade_id == MECH_UPGRADE_WRECKAGE_WARP   return "Wreckage Warp",   "sprites/icons/mech/Wreckage_Warp_Icon.png",   0,                         v4.{0.25, 0.5, 0.28, 1};
	return "", "", 0, v4.{1, 1, 1, 1};
}

// Draws a build's cost on the right of an upgrade row: [component icon] xN ( + [core] xM ).
// Weapons show their themed component; the utility build (comp_kind 0) shows an "ANY" tag.
rr_mech_draw_row_cost :: proc(slot: Rect, comp_kind: int, qty: int, cores: int, base_ts: Text_Settings) {
	rc := slot;
	isz := rc.height();
	if isz > 22.0 { isz = 22.0; }

	ts := base_ts;
	ts.size = 16;
	ts.halign = .LEFT;
	ts.valign = .CENTER;
	ts.color = v4.{0.95, 0.97, 1.0, 1.0};

	if comp_kind != 0 {
		comp_icon := get_asset(Texture_Asset, rr_mech_component_sprite_path(comp_kind));
		// isz comes from height() (already scaled) — cut unscaled so the square icon slot isn't scaled twice.
		c_slot := rc.cut_left_unscaled(isz);
		if comp_icon != null { UI.quad(c_slot.fit_aspect(comp_icon.get_aspect()), comp_icon, v4.{1, 1, 1, 1}); }
	} else {
		at := base_ts;
		at.size = 14;
		at.halign = .LEFT;
		at.valign = .CENTER;
		at.color = v4.{0.82, 0.86, 0.96, 1.0};
		UI.text(rc.cut_left(isz + 8.0), at, "ANY");
	}
	rc.cut_left(2.0);
	UI.text(rc.cut_left(26.0), ts, format_string("x%", .{qty}));

	if cores > 0 {
		rc.cut_left(4.0);
		UI.text(rc.cut_left(12.0), ts, "+");
		rc.cut_left(2.0);
		core_icon := get_asset(Texture_Asset, MECH_MAGNET_CORE_TEX);
		k_slot := rc.cut_left_unscaled(isz);
		if core_icon != null { UI.quad(k_slot.fit_aspect(core_icon.get_aspect()), core_icon, v4.{1, 1, 1, 1}); }
		rc.cut_left(2.0);
		UI.text(rc.cut_left(26.0), ts, format_string("x%", .{cores}));
	}
}

// One upgrade row for the checklist: [checkbox] [icon] [name] .... [cost icons / BUILT].
// Shows which weapons/utilities are built and, for unbuilt ones, exactly which component
// (and how many + cores) the next build needs.
rr_mech_draw_upgrade_row :: proc(row: Rect, mech: Mech_Module, upgrade_id: int, base_ts: Text_Settings, checkbox: Texture_Asset, checkbox_filled: Texture_Asset) {
	name, icon_path, comp_kind, _ := rr_mech_upgrade_info(upgrade_id);
	owned := rr_mech_upgrade_owned(mech, upgrade_id);
	rc := row.inset(2.0, 3.0, 2.0, 3.0);

	// height() is already scaled — cut square slots unscaled so they aren't scaled a second time
	// (a double-scale here pushes the row content sideways on higher-scale screens).
	cb_slot := rc.cut_left_unscaled(rc.height());
	cb_tex := owned ? checkbox_filled : checkbox;
	if cb_tex != null { UI.quad(cb_slot.fit_aspect(cb_tex.get_aspect()), cb_tex, v4.{1, 1, 1, 1}); }
	rc.cut_left(4.0);

	icon := get_asset(Texture_Asset, icon_path);
	if icon != null {
		icon_slot := rc.cut_left_unscaled(rc.height());
		UI.quad(icon_slot.fit_aspect(icon.get_aspect()), icon, owned ? v4.{1, 1, 1, 1} : v4.{0.72, 0.72, 0.78, 1});
		rc.cut_left(3.0);
	}

	// Right side: "BUILT" once owned, else the specific component cost for the next build.
	if owned {
		sts := base_ts;
		sts.size = 16;
		sts.halign = .RIGHT;
		sts.color = v4.{0.6, 1.0, 0.5, 1.0};
		UI.text(rc.cut_right(58.0), sts, "BUILT");
	} else {
		qty, cores := rr_mech_next_upgrade_cost(mech, upgrade_id);
		cost_w := cores > 0 ? 120.0 : 54.0;
		if comp_kind == 0 { cost_w += 8.0; }
		rr_mech_draw_row_cost(rc.cut_right(cost_w), comp_kind, qty, cores, base_ts);
	}

	nts := base_ts;
	nts.size = 20;
	nts.do_autofit = true;
	nts.autofit_min_size = 16;
	nts.autofit_max_size = 20;
	nts.color = owned ? v4.{0.6, 1.0, 0.55, 1.0} : v4.{0.92, 0.94, 1.0, 1.0};
	UI.text(rc, nts, name);
}

// Renders an upgrade's build cost as ICONS for a workbench card footer — [component icon] N
// (+ [core icon] M) — instead of the old "Need 3 Schematics + 2 Magnet Cores" text.
rr_mech_draw_card_cost_icons :: proc(comp_kind: int, qty: int, cores: int) {
	row := UIK.layout_row(UIK.flex(1), UIK.fit(), 6);
	row.main_align = .CENTER;
	row.cross_align = .CENTER;
	row.show_background = false;
	UIK.panel_begin(row);

	if comp_kind != 0 {
		UIK.currency(get_asset(Texture_Asset, rr_mech_component_sprite_path(comp_kind)), qty, UIK.text_body());
	} else {
		// Wreckage Warp accepts any component, so there's no single icon — keep a compact text tag.
		// Disable word wrap so "x1" stays on the same line as "ANY" in the narrow footer.
		// Must use set_word_wrap (sets the override flag) — assigning .word_wrap alone is ignored.
		any_ts := UIK.text_body();
		any_ts.set_word_wrap(false);
		UIK.text(format_string("ANY x%", .{qty}), any_ts);
	}

	if cores > 0 {
		UIK.text("+", UIK.text_body());
		UIK.currency(get_asset(Texture_Asset, MECH_MAGNET_CORE_TEX), cores, UIK.text_body());
	}

	UIK.panel_end();
}

rr_mech_draw_upgrade_card :: proc(player: Player, mech: Mech_Module, upgrade_id: int, orient: UIK.Card_Orientation, height: UIK.Size) -> Interact_Result {
	name, icon_path, comp_kind, tint := rr_mech_upgrade_info(upgrade_id);
	// Dynamic, order-based cost: the QUANTITY + cores scale with how many upgrades are owned,
	// but each weapon is built from its OWN component type (any for Wreckage Warp, which is a flat cost).
	qty, core_cost := rr_mech_next_upgrade_cost(mech, upgrade_id);

	owned := rr_mech_upgrade_owned(mech, upgrade_id);
	affordable := rr_mech_upgrade_can_afford(player, upgrade_id);

	display_tint := tint;
	if owned {
		display_tint = v4.{0.16, 0.45, 0.24, 1};
	} else if !affordable {
		display_tint = v4.{0.18, 0.18, 0.22, 1};
	}

	media_f := 0.5; header_f := 0.2; footer_f := 0.24;
	if orient == .LANDSCAPE { media_f = 0.26; header_f = 0.34; footer_f = 0.32; }
	card_desc := UIK.card_desc(UIK.flex(1), height, display_tint, orient, media_f, header_f, footer_f);
	UIK.card_begin(format_string("mech_wb_card_%", .{upgrade_id}), card_desc);

	UIK.card_zone(.MEDIA);
	UIK.image_fitted(get_asset(Texture_Asset, icon_path), UIK.image_desc(.CONTAIN));
	UIK.card_zone_end();

	if orient == .LANDSCAPE {
		// header_fraction/footer_fraction are portrait-only, so a landscape card must put its
		// text in a single BODY zone. Center it (name above cost) so it reads cleanly.
		UIK.card_zone(.BODY);
		body_col := UIK.layout_column();
		body_col.width = UIK.flex(1);
		body_col.height = UIK.flex(1);
		body_col.main_align = .CENTER;
		body_col.cross_align = .CENTER;
		body_col.gap = 4;
		body_col.show_background = false;
		UIK.panel_begin(body_col);
		nm := UIK.text_button_auto();
		nm.set_halign(.CENTER);
		UIK.text(name, nm);
		if owned {
			ft := UIK.text_button_auto();
			ft.set_halign(.CENTER);
			UIK.text("OWNED", ft);
		} else {
			rr_mech_draw_card_cost_icons(comp_kind, qty, core_cost);
		}
		UIK.panel_end();
		UIK.card_zone_end();
	} else {
		// Auto-shrink so long names ("Missile Barrage") fit the narrow quarter-width cards instead
		// of spilling past the edge; the cost shows as component/core icons rather than text.
		UIK.card_zone(.HEADER);
		nm := UIK.text_button_auto();
		nm.set_halign(.CENTER);
		UIK.text(name, nm);
		UIK.card_zone_end();

		UIK.card_zone(.FOOTER);
		if owned {
			ft := UIK.text_button_auto();
			ft.set_halign(.CENTER);
			UIK.text("OWNED", ft);
		} else {
			rr_mech_draw_card_cost_icons(comp_kind, qty, core_cost);
		}
		UIK.card_zone_end();
	}

	return UIK.card_end();
}

// Once every upgrade is built there's nothing left to buy, so the workbench collapses to
// this single full-screen APEX panel (the arsenal/utility cards are hidden). Awakening
// itself still happens via the bottom-center titan button in Mech form — the status line
// tells the player what's left (cores) or that it's ready.
rr_mech_draw_workbench_apex_takeover :: proc(player: Player, mech: Mech_Module) {
	ready := rr_mech_can_awaken_apex(player);

	// State-driven accent: gold (active), red (lost), grey (spent), green (ready),
	// pale blue (all built, still grinding the Power Cores).
	accent: v4;
	if mech.is_apex        { accent = v4.{1.0, 0.72, 0.3, 1.0}; }
	else if mech.apex_lost { accent = v4.{0.85, 0.45, 0.45, 1.0}; }
	else if mech.apex_used { accent = v4.{0.65, 0.65, 0.7, 1.0}; }
	else if ready          { accent = v4.{0.5, 1.0, 0.7, 1.0}; }
	else                   { accent = v4.{0.82, 0.9, 0.97, 1.0}; }

	panel := UIK.panel_styled(.INTERIOR_INSET);
	panel.width = UIK.flex(1);
	panel.height = UIK.flex(1);
	panel.cross_align = .CENTER;
	panel.main_align = .CENTER;
	panel.gap = 16;
	panel.padding = v4{28, 28, 28, 28};
	UIK.panel_begin(panel);

	// Big APEX sigil — gently pulses while it's actually awakenable.
	icon_px := 150.0;
	if ready { icon_px += sin(get_time() * 5.0) * 10.0; }
	icon_box := UIK.layout_centered(UIK.pixels(icon_px), UIK.pixels(icon_px));
	UIK.panel_begin(icon_box);
	UIK.image_fitted(get_asset(Texture_Asset, "sprites/icons/mech/Apex_Awakening_Icon.png"), UIK.image_desc(.CONTAIN), accent);
	UIK.panel_end();

	title := UIK.text_title();
	title.size_multiplier = 1.5;
	title.color = accent;
	title.override_flags |= UIK.Text_Override_SIZE_MULT | UIK.Text_Override_COLOR;
	UIK.text("APEX AWAKENING", title);

	status := UIK.text_body();
	status.color = v4.{0.92, 0.94, 1.0, 1.0};
	status.override_flags |= UIK.Text_Override_COLOR;
	UIK.text(rr_mech_apex_status_text(player, mech), status);

	UIK.panel_end();
}

rr_mech_draw_workbench_ui :: proc(player: Player) {
	if player == null return;
	mech := player.entity.get_component(Mech_Module);
	if mech == null return;
	if !mech.workbench_ui_open return;
	if game_state != Game_State.INGAME { mech.workbench_ui_open = false; return; }
	if player.player_state != Player_State.ALIVE { mech.workbench_ui_open = false; return; }

	UIK.begin(UIK.modal(UIK.rect_window(), 1000));

	// Red shell (the Mech's industrial theme) with black interior sections.
	// Dark (black) shell with red accents — industrial theme without a big bright-red frame.
	shell := UIK.panel_modal(.BLACK_WITH_FOOTER);
	shell.padding = v4{16, 12, 16, 16};
	shell.gap = 10;
	UIK.panel_begin(shell);

	title_desc := UIK.title_area_desc("R&D WORKBENCH");
	title_desc.tint = v4.{0.62, 0.14, 0.1, 1.0};
	exit_handle := UIK.title_area(title_desc);

	// Red-tinted section-header style, reused below.
	hdr := UIK.text_title();
	hdr.color = v4.{1.0, 0.42, 0.32, 1.0};
	hdr.override_flags |= UIK.Text_Override_COLOR;

	// Component / core counts strip (recessed inset). Stays pinned above the body in both
	// modes — the Power Core count still gates APEX even after every upgrade is built.
	counts_row := UIK.layout_row();
	counts_row.width = UIK.flex(1);
	counts_row.height = UIK.pixels(54);
	counts_row.background = .INTERIOR_INSET;
	counts_row.padding = v4{10, 14, 10, 14};
	counts_row.gap = 16;
	counts_row.cross_align = .CENTER;
	UIK.panel_begin(counts_row);
	UIK.currency(get_asset(Texture_Asset, "sprites/power_cell.png"), rr_mech_count_component_pool(player, MECH_COMPONENT_POWER_CELL), UIK.text_body());
	UIK.currency(get_asset(Texture_Asset, "sprites/cables.png"),     rr_mech_count_component_pool(player, MECH_COMPONENT_CIRCUIT), UIK.text_body());
	UIK.currency(get_asset(Texture_Asset, "sprites/blueprint.png"),  rr_mech_count_component_pool(player, MECH_COMPONENT_SCHEMATIC), UIK.text_body());
	UIK.currency(get_asset(Texture_Asset, "sprites/gears.png"),      rr_mech_count_component_pool(player, MECH_COMPONENT_GEAR), UIK.text_body());
	UIK.spacer(UIK.flex(1), UIK.pixels(1));
	UIK.currency(get_asset(Texture_Asset, MECH_MAGNET_CORE_TEX), mech.magnet_cores, UIK.text_body());
	UIK.currency(get_asset(Texture_Asset, "sprites/icons/mech/Loot_Icon.png"), mech.power_cores, UIK.text_body());
	UIK.panel_end();

	// Once all five upgrades are built there's nothing left to buy: collapse to the
	// full-screen APEX panel and hide the arsenal/utility cards entirely.
	all_built := rr_mech_upgrades_owned_total(mech) >= 5;

	// Card click handles default to a no-op result so the post-end() dispatch is a no-op
	// in APEX-takeover mode (the cards aren't drawn there).
	h_handle  := Interact_Result.{};
	r_handle  := Interact_Result.{};
	m_handle  := Interact_Result.{};
	ms_handle := Interact_Result.{};
	w_handle  := Interact_Result.{};

	if all_built {
		rr_mech_draw_workbench_apex_takeover(player, mech);
	} else {
		// Everything fits on one page, so this is a plain full-width column — no scroll area. The
		// scroll area's auto scrollbar was clipping/offsetting the rightmost card on the right edge.
		body := UIK.layout_column();
		body.width = UIK.flex(1);
		body.height = UIK.flex(1);
		body.gap = 10;
		UIK.panel_begin(body);

		UIK.text("ARSENAL", hdr);

		// 4 weapon cards (the parts that feed APEX) — fixed height so they never squish.
		weapons_row := UIK.layout_row(UIK.flex(1), UIK.pixels(220), 10);
		UIK.panel_begin(weapons_row);
		h_handle  = rr_mech_draw_upgrade_card(player, mech, MECH_UPGRADE_HELMET_TRAP,     .PORTRAIT, UIK.flex(1));
		r_handle  = rr_mech_draw_upgrade_card(player, mech, MECH_UPGRADE_RAM_CHARGE,      .PORTRAIT, UIK.flex(1));
		m_handle  = rr_mech_draw_upgrade_card(player, mech, MECH_UPGRADE_MAGNET_CANNON,   .PORTRAIT, UIK.flex(1));
		ms_handle = rr_mech_draw_upgrade_card(player, mech, MECH_UPGRADE_MISSILE_BARRAGE, .PORTRAIT, UIK.flex(1));
		UIK.panel_end();

		UIK.divider(1.0, v4.{1, 1, 1, 0.2});
		UIK.text("UTILITY", hdr);

		// Wreckage Warp as a portrait tile matching the arsenal cards (the landscape card rendered
		// the icon tiny and jammed to the left). Centered at one arsenal-card width via flex spacers.
		warp_row := UIK.layout_row(UIK.flex(1), UIK.pixels(220), 0);
		UIK.panel_begin(warp_row);
		UIK.spacer(UIK.flex(1.5), UIK.pixels(1));
		w_handle = rr_mech_draw_upgrade_card(player, mech, MECH_UPGRADE_WRECKAGE_WARP, .PORTRAIT, UIK.flex(1));
		UIK.spacer(UIK.flex(1.5), UIK.pixels(1));
		UIK.panel_end();

		UIK.panel_end(); // body
	}

	UIK.panel_end(); // shell
	UIK.end();

	if UIK.clicked(exit_handle) { mech.workbench_ui_open = false; }
	if UIK.clicked(h_handle)  { rr_mech_workbench_click_upgrade(player, MECH_UPGRADE_HELMET_TRAP); }
	if UIK.clicked(r_handle)  { rr_mech_workbench_click_upgrade(player, MECH_UPGRADE_RAM_CHARGE); }
	if UIK.clicked(m_handle)  { rr_mech_workbench_click_upgrade(player, MECH_UPGRADE_MAGNET_CANNON); }
	if UIK.clicked(ms_handle) { rr_mech_workbench_click_upgrade(player, MECH_UPGRADE_MISSILE_BARRAGE); }
	if UIK.clicked(w_handle)  { rr_mech_workbench_click_upgrade(player, MECH_UPGRADE_WRECKAGE_WARP); }
}

// World-space countdown above each live Magnet Rod, showing the seconds until it disappears
// (same style as the Hunter campfire / stun timers). LOS-gated to the viewer.
rr_mech_draw_rod_timers :: proc(viewer: Player) {
	if game_state != Game_State.INGAME return;
	UI.push_world_draw_context();
	defer UI.pop_draw_context();

	for node: component_iterator(Mech_Magnet_Node) {
		if node == null || !#alive(node.entity) continue;
		if !node.landed continue;
		remaining := node.ends_at - get_time();
		if remaining <= 0.0 continue;
		if viewer != null {
			radii := viewer.get_local_light_radii();
			if length(node.entity.world_position - viewer.entity.world_position) > radii.y continue;
		}
		// Bias the sort key well in FRONT of the rod's base so the timer pill isn't occluded by the
		// tall harpoon sprite (its base y alone tied with the rod and lost, drawing behind it).
		rr_mech_draw_world_countdown(node.entity.world_position + v2.{0.0, 1.6}, node.entity.world_position.y - 2.0, remaining, v4.{0.55, 0.9, 1.0, 1.0});
	}
}

// World-space countdown above each helmeted victim's head, showing the seconds until the
// Magnet Helmet auto-releases. The blinded victim also gets a centered countdown on their own
// blind overlay (see Mech_Helmeted_Status.ao_update), since this world label sits under it.
rr_mech_draw_helmet_timers :: proc(viewer: Player) {
	if game_state != Game_State.INGAME return;
	UI.push_world_draw_context();
	defer UI.pop_draw_context();

	for helm: component_iterator(Mech_Helmeted_Status) {
		if helm == null || !#alive(helm.entity) continue;
		if !helm.active || helm.expires_at == 0.0 continue;
		remaining := helm.expires_at - get_time();
		if remaining <= 0.0 continue;
		if viewer != null {
			radii := viewer.get_local_light_radii();
			if length(helm.entity.world_position - viewer.entity.world_position) > radii.y continue;
		}
		rr_mech_draw_world_countdown(helm.entity.world_position + v2.{0.0, 1.9}, helm.entity.world_position.y, remaining, v4.{0.7, 0.9, 1.0, 1.0});
	}
}

// Shared world-space countdown pill (ceiled seconds + "s"), matching rr_draw_stun_timers.
// `z` is the sort key: pass the anchor entity's BASE y (NOT the elevated label_pos.y) so the
// pill draws in FRONT of a tall sprite like the Magnet Rod instead of being occluded by it.
rr_mech_draw_world_countdown :: proc(label_pos: v2, z: float, remaining: float, color: v4) {
	secs_i := remaining.(int);
	if remaining - secs_i.(float) > 0.001 { secs_i += 1; }
	if secs_i < 1 { secs_i = 1; }

	UI.push_z(z);
	defer UI.pop_z();

	bg_rect := Rect{label_pos, label_pos}.grow(0.18, 0.45, 0.18, 0.45);
	UI.quad(bg_rect, core_globals.white_sprite, v4.{0.0, 0.0, 0.0, 0.55});

	ts := UI.default_text_settings();
	ts.size = 0.30; // world-space text size
	ts.color = color;
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 0.05;
	ts.outline_color = v4.{0.0, 0.0, 0.0, 1.0};
	text_rect := Rect{label_pos, label_pos}.grow(0.16, 0.43, 0.16, 0.43);
	UI.text(text_rect, ts, "%s", .{secs_i});
}

// One resource readout in the checklist panel: an icon followed by its count.
rr_mech_draw_resource_chip :: proc(slot: Rect, icon: Texture_Asset, count: int, ts: Text_Settings) {
	r := slot;
	// Square icon ~22 design units wide. Use the SCALED cut so it grows with the UI scale factor —
	// cutting a fixed unscaled size would leave the icon a constant pixel size (looking smaller and
	// smaller) as the row/text scale up on larger screens. fit_aspect keeps it square within the row.
	icon_slot := r.cut_left(22.0);
	if icon != null { UI.quad(icon_slot.fit_aspect(icon.get_aspect()), icon, v4.{1, 1, 1, 1}); }
	r.cut_left(3.0);
	UI.text(r, ts, format_string("%", .{count}));
}

// Draws the Mech's 6 resource chips (4 components + Magnet Cores + Power Cores) across `row` — the
// shared component + core pool the Mech and its Minions draw from. Used by both the full checklist
// panel and the compact collapsed resource bar.
rr_mech_draw_resource_row :: proc(owner: Player, mech: Mech_Module, row: Rect, base_ts: Text_Settings) {
	num_ts := base_ts;
	num_ts.size = 20;
	num_ts.halign = .LEFT;
	num_ts.valign = .CENTER;
	num_ts.color = v4.{0.95, 0.97, 1.0, 1.0};
	// chip_w comes from width() (already in scaled/screen space), so cut it with the UNSCALED cut —
	// cut_left() would re-apply the UI scale factor and the 6 chips would overrun on phones/tablets.
	chip_w := row.width() / 6.0;
	rr_mech_draw_resource_chip(row.cut_left_unscaled(chip_w), get_asset(Texture_Asset, rr_mech_component_sprite_path(MECH_COMPONENT_POWER_CELL)), rr_mech_count_component_pool(owner, MECH_COMPONENT_POWER_CELL), num_ts);
	rr_mech_draw_resource_chip(row.cut_left_unscaled(chip_w), get_asset(Texture_Asset, rr_mech_component_sprite_path(MECH_COMPONENT_CIRCUIT)),   rr_mech_count_component_pool(owner, MECH_COMPONENT_CIRCUIT),   num_ts);
	rr_mech_draw_resource_chip(row.cut_left_unscaled(chip_w), get_asset(Texture_Asset, rr_mech_component_sprite_path(MECH_COMPONENT_SCHEMATIC)), rr_mech_count_component_pool(owner, MECH_COMPONENT_SCHEMATIC), num_ts);
	rr_mech_draw_resource_chip(row.cut_left_unscaled(chip_w), get_asset(Texture_Asset, rr_mech_component_sprite_path(MECH_COMPONENT_GEAR)),      rr_mech_count_component_pool(owner, MECH_COMPONENT_GEAR),      num_ts);
	rr_mech_draw_resource_chip(row.cut_left_unscaled(chip_w), get_asset(Texture_Asset, MECH_MAGNET_CORE_TEX), mech.magnet_cores, num_ts);
	rr_mech_draw_resource_chip(row.cut_left_unscaled(chip_w), get_asset(Texture_Asset, "sprites/icons/mech/Loot_Icon.png"), mech.power_cores, num_ts);
}

// Side checklist HUD for The Mech AND its Minions — drawn from draw_mech_role_hud in
// player.csl. Minions read the exact same checklist as their master: it's driven entirely
// by the owner's Mech_Module and the shared (mech + minions) component pool, so they can
// see which task panels to smash and how close the Mech is to APEX.
rr_mech_draw_checklist_panel :: proc(player: Player) {
	if player == null return;
	if !player.is_local_or_server() return;
	is_mech := player.player_role == Player_Role.THE_MECH;
	is_minion := rr_mech_is_minion_active(player);
	if !is_mech && !is_minion return;

	owner := rr_mech_get_owner(player);
	if owner == null return;
	mech := owner.entity.get_component(Mech_Module);
	if mech == null return;
	if is_mech && mech.workbench_ui_open return;
	// Hide the progression checklist while the Showdown HUD owns the screen, or while the Mech is
	// downed (faked death) — nothing to track until it's revived or dies.
	if mech.showdown_active || mech.showdown_downed return;

	// First objective: guide the Mech to the R&D Workbench with a world-space arrow until it's
	// first used. Local Mech only (minions don't build); drawn outside task_list_open so it shows
	// even with the checklist collapsed.
	if is_mech && player.is_local() && !mech.visited_workbench && mech_workbench_entity != null && #alive(mech_workbench_entity) {
		wb_pos := mech_workbench_entity.world_position;
		arrow_opts := Tutorial_Arrow.default_options();
		dist := length(player.entity.world_position - wb_pos);
		arrow_opts.alpha = clamp(1.0 - (dist - 3.0) / 22.0, 0.25, 1.0);
		arrow_opts.far = true;
		arrow_opts.near = true;
		arrow_opts.bob_scale = 0.5;
		arrow_opts.bob_bias = 1.5;
		rr_draw_tutorial_arrow(player, wb_pos, arrow_opts);
	}

	UI.push_layer(1600);
	defer UI.pop_layer();

	// Mech's task-style checklist panel — 1.25x, resolution-dependent (matches the task UI).
	_pushed_scale := rr_push_task_ui_scale(player);
	defer rr_pop_mobile_ui_scale(_pushed_scale);

	safe := UI.get_safe_screen_rect();
	PANEL_W  :: 300.0;
	LIST_PAD :: 12.0;
	DROPDOWN_SLICE_PX :: 16.0;

	LABEL_H :: 20.0;
	UPG_H   :: 32.0;
	RES_H   :: 28.0;
	APEX_H  :: 38.0;
	GAP     :: 6.0;

	upgrades_owned := rr_mech_upgrades_owned(mech);
	cores := min(mech.power_cores, MECH_LOOT_CORES_GOAL);
	apex_ready := rr_mech_can_awaken_apex(owner);

	// +1 row (UPG_H) + a GAP for the "Go to R&D Workbench" first objective at the top.
	list_h := UPG_H + GAP + LABEL_H + 5.0 * UPG_H + GAP + LABEL_H + RES_H + GAP + APEX_H + LIST_PAD * 2.0;

	header_rect := rr_draw_task_list_header(safe, false, player);

	list_bg := get_asset(Texture_Asset, "ui/task list/task_list_dropdown_area.png");

	base_ts := UI.default_text_settings();
	base_ts.size = 20;
	base_ts.halign = .LEFT;
	base_ts.valign = .CENTER;
	base_ts.do_outline = true;
	base_ts.outline_thickness = 4;
	base_ts.outline_color = v4.{0, 0, 0, 1};

	// Task list collapsed — still surface the resource bar so the Mech (and Minions) can always read
	// their component + core pool at a glance, without having to expand the full checklist.
	if !player.task_list_open {
		bar_h := RES_H + LIST_PAD * 2.0;
		bar_rect := header_rect.bottom_left_rect().grow(0.0, PANEL_W, bar_h, 0.0);
		rr_ui_draw_nine_slice_panel(bar_rect, list_bg, DROPDOWN_SLICE_PX);
		bar_content := bar_rect.inset(LIST_PAD, LIST_PAD, LIST_PAD, LIST_PAD);
		rr_mech_draw_resource_row(owner, mech, bar_content.cut_top(RES_H), base_ts);
		return;
	}

	list_rect := header_rect.bottom_left_rect().grow(0.0, PANEL_W, list_h, 0.0);
	checkbox := get_asset(Texture_Asset, "ui/task list/checkbox.png");
	checkbox_filled := get_asset(Texture_Asset, "ui/task list/checkbox_filled.png");

	rr_ui_draw_nine_slice_panel(list_rect, list_bg, DROPDOWN_SLICE_PX);

	content := list_rect.inset(LIST_PAD, LIST_PAD, LIST_PAD, LIST_PAD);

	// --- First objective: get to the R&D Workbench (where every weapon is built). Checks off the
	// first time the Mech opens it; the world-space arrow above guides them there until then. ---
	{
		row := content.cut_top(UPG_H);
		rc := row.inset(2.0, 3.0, 2.0, 3.0);
		cb_tex := mech.visited_workbench ? checkbox_filled : checkbox;
		cb_slot := rc.cut_left_unscaled(rc.height());
		if cb_tex != null { UI.quad(cb_slot.fit_aspect(cb_tex.get_aspect()), cb_tex, v4.{1, 1, 1, 1}); }
		rc.cut_left(4.0);
		nts := base_ts;
		nts.size = 20;
		nts.do_autofit = true;
		nts.autofit_min_size = 16;
		nts.autofit_max_size = 20;
		nts.color = mech.visited_workbench ? v4.{0.6, 1.0, 0.55, 1.0} : v4.{0.45, 0.85, 1.0, 1.0};
		UI.text(rc, nts, "Go to R&D Workbench");
	}
	content.cut_top(GAP);

	// --- Upgrades: which weapons / utilities are built, and the specific component cost of
	// each unbuilt one (quantity + cores escalate with build order). ---
	{
		lbl := content.cut_top(LABEL_H);
		ts := base_ts;
		ts.size = 16;
		ts.color = v4.{0.45, 0.85, 1.0, 1.0};
		UI.text(lbl, ts, "UPGRADES");
	}
	rr_mech_draw_upgrade_row(content.cut_top(UPG_H), mech, MECH_UPGRADE_HELMET_TRAP,     base_ts, checkbox, checkbox_filled);
	rr_mech_draw_upgrade_row(content.cut_top(UPG_H), mech, MECH_UPGRADE_RAM_CHARGE,      base_ts, checkbox, checkbox_filled);
	rr_mech_draw_upgrade_row(content.cut_top(UPG_H), mech, MECH_UPGRADE_MAGNET_CANNON,   base_ts, checkbox, checkbox_filled);
	rr_mech_draw_upgrade_row(content.cut_top(UPG_H), mech, MECH_UPGRADE_MISSILE_BARRAGE, base_ts, checkbox, checkbox_filled);
	rr_mech_draw_upgrade_row(content.cut_top(UPG_H), mech, MECH_UPGRADE_WRECKAGE_WARP,   base_ts, checkbox, checkbox_filled);

	content.cut_top(GAP);

	// --- Resources: the shared component + core pool the Mech (and its Minions) draw from ---
	{
		lbl := content.cut_top(LABEL_H);
		ts := base_ts;
		ts.size = 16;
		ts.color = v4.{0.45, 0.85, 1.0, 1.0};
		UI.text(lbl, ts, "RESOURCES");
	}
	rr_mech_draw_resource_row(owner, mech, content.cut_top(RES_H), base_ts);

	content.cut_top(GAP);

	// --- APEX goal line (flat fill) ---
	{
		row := content.cut_top(APEX_H);
		fill: v4;
		apex_color: v4;
		apex_text: string;
		if mech.is_apex {
			fill = v4.{0.42, 0.2, 0.04, 0.6};  apex_color = v4.{1.0, 0.72, 0.3, 1.0};  apex_text = "APEX AWAKENED";
		} else if mech.apex_used {
			fill = v4.{0.14, 0.14, 0.16, 0.6}; apex_color = v4.{0.65, 0.65, 0.7, 1.0};  apex_text = "APEX SPENT";
		} else if mech.apex_lost {
			fill = v4.{0.22, 0.08, 0.08, 0.6}; apex_color = v4.{0.85, 0.45, 0.45, 1.0}; apex_text = "APEX LOST";
		} else if apex_ready {
			pulse := 0.45 + sin(get_time() * 5.0) * 0.25;
			fill = v4.{0.05, 0.4, 0.32, pulse}; apex_color = v4.{0.5, 1.0, 0.7, 1.0}; apex_text = "APEX READY — Awaken!";
		} else {
			fill = v4.{0.1, 0.13, 0.18, 0.6}; apex_color = v4.{0.82, 0.9, 0.97, 1.0};
			needed_parts := max(MECH_BOLT_PARTS_GOAL - upgrades_owned, 0);
			needed_cores := max(MECH_LOOT_CORES_GOAL - cores, 0);
			apex_text = format_string("APEX: % weapons + % cores left", .{needed_parts, needed_cores});
		}
		UI.quad(row, core_globals.white_sprite, fill);
		ts := base_ts;
		ts.size = 20;
		ts.halign = .CENTER;
		ts.do_autofit = true;
		ts.autofit_min_size = 16;
		ts.autofit_max_size = 20;
		ts.color = apex_color;
		UI.text(row.inset(8, 0, 8, 0), ts, apex_text);
	}
}

// Big pulsing "ultimate" button drawn bottom-middle. Returns true on click.
// locked_seconds > 0 draws it disarmed: greyed out, no glow, with a big arming countdown
// over the icon, and the click is swallowed so it can't fire while still locked.
rr_mech_draw_titan_button :: proc(player: Player, rect: Rect, id: string, icon: Texture_Asset, label: string, glow_color: v4, locked_seconds: float) -> bool {
	locked := locked_seconds > 0.0;
	pulse := 0.55 + sin(get_time() * 5.0) * 0.45;
	glow := get_asset(Texture_Asset, "sprites/Shapes/shape_circle_gradient.png");
	if glow != null && !locked {
		UI.quad(rect.grow(20.0 + pulse * 16.0), glow, v4.{glow_color.x, glow_color.y, glow_color.z, 0.45 * pulse});
	}

	UI.push_id(id);
	defer UI.pop_id();
	bs := UI.default_button_settings();
	bs.sprite = core_globals.ability_bg_big;
	bs.sprite_pressed = core_globals.ability_pressed_bg_big;
	bs.press_scaling = 1.0;
	rr_ui_apply_button_click_sound(ref bs);
	interact := UI.button(rect, bs, .{}, "");
	icon_tint := locked ? v4.{0.55, 0.55, 0.55, 0.6} : v4.{1, 1, 1, 1};
	if icon != null {
		UI.quad(rect.inset(22, 22, 22, 22).fit_aspect(icon.get_aspect()), icon, icon_tint);
	}

	if locked {
		// Dim scrim + ceil'd countdown so the player sees the button arming, not missing.
		UI.quad(rect, core_globals.white_sprite, v4.{0.0, 0.0, 0.0, 0.5});
		secs_i := locked_seconds.(int);
		if locked_seconds - secs_i.(float) > 0.001 { secs_i += 1; }
		if secs_i < 1 { secs_i = 1; }
		cs := UI.default_text_settings();
		cs.size = 44;
		cs.halign = .CENTER;
		cs.valign = .CENTER;
		cs.do_outline = true;
		cs.outline_thickness = 5;
		cs.outline_color = v4.{0, 0, 0, 1};
		cs.color = v4.{1.0, 0.92, 0.7, 1.0};
		UI.text(rect, cs, format_string("%", .{secs_i}));
	}

	ts := UI.default_text_settings();
	ts.size = 20;
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 4;
	ts.outline_color = v4.{0, 0, 0, 1};
	ts.color = locked ? v4.{0.7, 0.66, 0.55, 1.0} : v4.{1.0, 0.92, 0.7, 1.0};
	label_rect := rect.top_center_rect().grow(34.0, 150.0, 0.0, 150.0).offset(0.0, 14.0);
	UI.text(label_rect, ts, label);
	return interact.clicked && !locked;
}

// Custom bottom-middle widget for the once-per-game "ultimate" buttons (APEX Awakening,
// End Game). Kept off the 6-slot ability bar so the rest of the kit always fits. Drawn for
// is_local_or_server so the click runs on both client and server.
rr_mech_draw_titan_buttons :: proc(player: Player) {
	if player == null return;
	if !player.is_local_or_server() return;
	if player.player_role != Player_Role.THE_MECH return;
	if player.player_state != Player_State.ALIVE return;
	if game_state != Game_State.INGAME return;
	// Hide the ultimate buttons once the End Game cutscene is rolling.
	if rr_mech_any_endgame_active() return;
	mech := player.entity.get_component(Mech_Module);
	if mech == null return;
	// Hide the normal kit (incl. the End Game / APEX buttons) while the Showdown HUD owns the
	// screen — only the mash button should be live during the clash — and while downed (faked
	// death), where only "Call Minion" is allowed.
	if mech.showdown_active || mech.showdown_downed return;
	// Hide the Awaken APEX / End Game buttons while driving the Ram car — the drive owns the kit.
	if rr_mech_car_is_active(player) return;

	show_apex := rr_mech_can_awaken_apex(player) && mech.is_mech_form;
	// Show End Game as soon as it's unlocked, but keep it visibly locked (countdown over
	// the icon) for the arm delay so the player can see when it becomes usable.
	show_end := mech.endgame_unlocked && mech.is_apex;
	end_locked := mech.endgame_unlocked ? max(0.0, mech.endgame_unlocked_at + MECH_ENDGAME_UNLOCK_DELAY - get_time()) : 0.0;
	if !show_apex && !show_end return;

	UI.push_screen_draw_context();
	defer UI.pop_draw_context();
	UI.push_layer(1650);
	defer UI.pop_layer();
	_scale := rr_push_mobile_ui_scale(player);
	defer rr_pop_mobile_ui_scale(_scale);

	safe := UI.get_safe_screen_rect();
	HALF :: 64.0;
	UP   :: 156.0;
	GAP  :: 96.0;

	apex_icon := get_asset(Texture_Asset, "sprites/icons/mech/Apex_Awakening_Icon.png");
	end_icon := get_asset(Texture_Asset, "sprites/icons/mech/Missile_Barrage_Icon.png");

	if show_apex && show_end {
		if rr_mech_draw_titan_button(player, safe.bottom_center_rect().grow(HALF).offset(-GAP, UP), "mech_titan_apex", apex_icon, "AWAKEN APEX", v4.{1.0, 0.45, 0.12, 1.0}, 0.0) {
			rr_mech_awaken_apex(player);
		}
		if rr_mech_draw_titan_button(player, safe.bottom_center_rect().grow(HALF).offset(GAP, UP), "mech_titan_end", end_icon, "END GAME", v4.{1.0, 0.16, 0.1, 1.0}, end_locked) {
			rr_mech_trigger_end_game(player);
		}
	} else if show_apex {
		if rr_mech_draw_titan_button(player, safe.bottom_center_rect().grow(HALF).offset(0.0, UP), "mech_titan_apex", apex_icon, "AWAKEN APEX", v4.{1.0, 0.45, 0.12, 1.0}, 0.0) {
			rr_mech_awaken_apex(player);
		}
	} else {
		if rr_mech_draw_titan_button(player, safe.bottom_center_rect().grow(HALF).offset(0.0, UP), "mech_titan_end", end_icon, "END GAME", v4.{1.0, 0.16, 0.1, 1.0}, end_locked) {
			rr_mech_trigger_end_game(player);
		}
	}
}

// World-space readout floating above every Minion's head showing the task parts they're hauling,
// so the whole traitor team can see who's carrying what for the Mech. Visible ONLY to traitors
// (the Mech, its Minions, fellow traitors). Drawn per local player from late_update.
rr_mech_draw_minion_carried_items :: proc(viewer: Player) {
	if viewer == null return;
	if game_state != Game_State.INGAME return;
	// Only the traitor team can see a Minion's haul.
	if viewer.player_type != Player_Type.TRAITOR return;

	UI.push_world_draw_context();
	defer UI.pop_draw_context();

	for p: component_iterator(Player) {
		if p == null || !#alive(p.entity) continue;
		if p.player_state != Player_State.ALIVE continue;
		minion := rr_mech_get_minion_effect(p);
		if minion == null || minion.converted_by_mech_id == 0 continue;

		// Collect the held kinds (count > 0) into a compact list.
		kinds: [4]int;
		counts: [4]int;
		n := 0;
		if minion.power_cells > 0 { kinds[n] = MECH_COMPONENT_POWER_CELL; counts[n] = minion.power_cells; n += 1; }
		if minion.circuits   > 0 { kinds[n] = MECH_COMPONENT_CIRCUIT;    counts[n] = minion.circuits;   n += 1; }
		if minion.schematics > 0 { kinds[n] = MECH_COMPONENT_SCHEMATIC;  counts[n] = minion.schematics; n += 1; }
		if minion.gears      > 0 { kinds[n] = MECH_COMPONENT_GEAR;       counts[n] = minion.gears;      n += 1; }
		if n == 0 continue;

		// Hidden in shadow / outside the viewer's LOS, like the other world labels.
		radii := viewer.get_local_light_radii();
		if length(p.entity.world_position - viewer.entity.world_position) > radii.y continue;

		base := p.entity.world_position;
		UI.push_z(base.y);

		ICON :: 0.4;
		PAD :: 0.34;  // width budget for the count text after each icon
		GAP :: 0.14;
		slot_w := ICON + PAD;
		total_w := slot_w * n.(float) + GAP * (n.(float) - 1.0);
		start_x := base.x - total_w * 0.5;
		y := base.y + 2.05;

		// No backdrop — the count reads off its own outline so the icons float clean over the world.
		ts := UI.default_text_settings();
		ts.size = 0.34;
		ts.halign = .LEFT;
		ts.valign = .CENTER;
		ts.do_outline = true;
		ts.outline_thickness = 0.08;
		ts.outline_color = v4.{0.0, 0.0, 0.0, 1.0};
		ts.color = v4.{1.0, 0.9, 0.55, 1.0};

		x := start_x;
		for i: 0..n-1 {
			icon := get_asset(Texture_Asset, rr_mech_component_sprite_path(kinds[i]));
			icon_rect := Rect{v2.{x, y - ICON * 0.5}, v2.{x + ICON, y + ICON * 0.5}};
			if icon != null { UI.quad(icon_rect.fit_aspect(icon.get_aspect()), icon, v4.{1, 1, 1, 1}); }
			text_rect := Rect{v2.{x + ICON + 0.04, y - 0.3}, v2.{x + slot_w, y + 0.3}};
			UI.text(text_rect, ts, format_string("%", .{counts[i]}));
			x += slot_w + GAP;
		}

		UI.pop_z();
	}
}

MINION_WARNING_DURATION :: 5.0;

// Small persistent HUD chip shown to a Minion carrying collected task parts — reminds them to
// walk the parts back to the Mech (they auto-deliver once in range). Hidden when carrying none.
rr_mech_draw_minion_carry_indicator :: proc(player: Player) {
	if player == null return;
	if !player.is_local_or_server() return;
	if game_state != Game_State.INGAME return;
	if player.player_state != Player_State.ALIVE return;
	minion := rr_mech_get_minion_effect(player);
	if minion == null || minion.converted_by_mech_id == 0 return;
	held := minion.power_cells + minion.circuits + minion.schematics + minion.gears;
	if held <= 0 return;

	UI.push_screen_draw_context();
	defer UI.pop_draw_context();
	UI.push_layer(1600);
	defer UI.pop_layer();
	_scale := rr_push_mobile_ui_scale(player);
	defer rr_pop_mobile_ui_scale(_scale);

	screen := UI.get_safe_screen_rect();
	cx := (screen.min.x + screen.max.x) * 0.5;
	w := 420.0;
	h := 44.0;
	top := screen.min.y + screen.height() * 0.12;
	chip := Rect{v2.{cx - w * 0.5, top}, v2.{cx + w * 0.5, top + h}};

	pulse := 0.6 + sin(get_time() * 5.0) * 0.4;
	UI.quad(chip.grow(4.0), core_globals.white_sprite, v4.{0.95, 0.6, 0.12, 0.25 * pulse});
	UI.quad(chip, core_globals.white_sprite, v4.{0.08, 0.06, 0.05, 0.9});

	ts := UI.default_text_settings();
	ts.size = 22;
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 4;
	ts.outline_color = v4.{0, 0, 0, 1};
	ts.color = v4.{1.0, 0.85, 0.4, 1.0};
	UI.text(chip, ts, format_string("Deliver % parts to the Mech", .{held}));
}

// One-shot full-screen alert shown to a freshly converted Minion, for a fixed window
// (timestamped on the synced effect so it survives reconciliation).
rr_mech_draw_minion_warning :: proc(player: Player) {
	if player == null return;
	if !player.is_local_or_server() return;
	if game_state != Game_State.INGAME return;

	minion := rr_mech_get_minion_effect(player);
	if minion == null || minion.converted_by_mech_id == 0 return;
	if minion.warning_started_at <= 0.0 return;

	t := get_time() - minion.warning_started_at;
	if t < 0.0 || t > MINION_WARNING_DURATION return;

	// Fade in fast, hold, fade out near the end.
	alpha := 1.0;
	if t < 0.4 { alpha = t / 0.4; }
	else if t > MINION_WARNING_DURATION - 0.7 { alpha = (MINION_WARNING_DURATION - t) / 0.7; }
	alpha = clamp(alpha, 0.0, 1.0);

	UI.push_screen_draw_context();
	defer UI.pop_draw_context();
	UI.push_layer(9700);
	defer UI.pop_layer();

	_pushed_scale := rr_push_mobile_ui_scale(player);
	defer rr_pop_mobile_ui_scale(_pushed_scale);

	screen := UI.get_safe_screen_rect();
	cx := (screen.min.x + screen.max.x) * 0.5;

	band_w := clamp(screen.width() * 0.72, 360.0, 760.0);
	band_h := 132.0;
	// Slide down a touch as it fades in.
	top_y := screen.min.y + screen.height() * 0.20 - (1.0 - alpha) * 24.0;
	half_w := band_w * 0.5;
	band := Rect{v2.{cx - half_w, top_y}, v2.{cx + half_w, top_y + band_h}};

	// Pulsing red danger glow + dark body. Flat fills scale identically at any res.
	glow_pulse := 0.5 + sin(get_time() * 6.0) * 0.5;
	gp := 6.0 + glow_pulse * 5.0;
	border := band.grow(gp, gp, gp, gp);
	UI.quad(border, core_globals.white_sprite, v4.{0.95, 0.16, 0.1, (0.3 + glow_pulse * 0.22) * alpha});
	UI.quad(band, core_globals.white_sprite, v4.{0.09, 0.05, 0.06, 0.96 * alpha});

	inner := band.inset(18.0, 16.0, 18.0, 16.0);

	// Mech emblem on the left — "serve this master".
	emblem := get_asset(Texture_Asset, "sprites/icons/roles_small/Mecha_Icon.png");
	emblem_slot := inner.cut_left(inner.height());
	if emblem != null {
		UI.quad(emblem_slot.fit_aspect(emblem.get_aspect()), emblem, v4.{1, 1, 1, alpha});
	}
	inner.cut_left(16.0);

	// Title.
	title_rect := inner.cut_top(inner.height() * 0.52);
	title_ts := UI.default_text_settings();
	title_ts.size = 30;
	title_ts.halign = .LEFT;
	title_ts.valign = .CENTER;
	title_ts.do_outline = true;
	title_ts.outline_thickness = 5;
	title_ts.outline_color = v4.{0, 0, 0, alpha};
	title_ts.do_autofit = true;
	title_ts.autofit_min_size = 18;
	title_ts.autofit_max_size = 32;
	title_ts.color = v4.{1.0, 0.28, 0.22, alpha};
	UI.text(title_rect, title_ts, "YOU ARE NOW A MINION");

	// Subtitle.
	sub_ts := UI.default_text_settings();
	sub_ts.size = 19;
	sub_ts.halign = .LEFT;
	sub_ts.valign = .CENTER;
	sub_ts.do_outline = true;
	sub_ts.outline_thickness = 4;
	sub_ts.outline_color = v4.{0, 0, 0, alpha};
	sub_ts.do_autofit = true;
	sub_ts.autofit_min_size = 13;
	sub_ts.autofit_max_size = 20;
	sub_ts.color = v4.{1.0, 0.92, 0.85, alpha};
	UI.text(inner, sub_ts, "You're a TRAITOR now — help The Mech win!");
}
