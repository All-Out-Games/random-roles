MECH_STUN_SECONDS :: 3.0;
// Ram is a drivable CAR: the Mech transforms into a truck and drives for this whole window,
// plowing any victim it runs into forward along with it (rather than a quick dash-kill). The driver
// STEERS with their normal move input (joystick / WASD) — so the car is driven by writing
// agent.input_this_frame, NOT by a movement lock (a lock zeroes input_this_frame, killing steering).
MECH_RAM_SECONDS :: 15.0;
MECH_CAR_SPEED_MULT :: 2.0;    // car drive speed = baseline_movement_speed * this
MECH_RAM_HIT_RADIUS :: 2.2;    // forward reach in front of the car that scoops victims up to be plowed
