import "core:ao"

players: List(Player);

rr_ambience_sfx_id: u64;
rr_restart_ambience :: proc() {
	// Server-authoritative loop (replicated to clients).
	if !Game.is_server() return;

	if rr_ambience_sfx_id != 0 {
		SFX.stop(rr_ambience_sfx_id);
		rr_ambience_sfx_id = 0;
	}

	sfx := SFX.default_sfx_desc();
	sfx.channel = SFX_Channel.MUSIC;
	sfx.loop = true;
	sfx.loop_timeout = 0.0;
	sfx.volume = 0.35;
	sfx.volume_perturb = 0.0;
	sfx.speed_perturb = 0.0;
	rr_ambience_sfx_id = rr_play_sfx("sfx/ambience_v3.wav", sfx);
}

// --- Voice chat channels ---
// Bitmask-based channels for voice routing.
ALIVE_CHANNEL :: 1u64 << 0;
DEAD_CHANNEL  :: 1u64 << 1;
ALL_VOICE_CHANNELS :: ALIVE_CHANNEL | DEAD_CHANNEL;

// --- Local vision / LOS ---
PLAYER_LIGHT_BASE_INNER_RADIUS :: 9;
PLAYER_LIGHT_BASE_OUTER_RADIUS :: 12;
PLAYER_LIGHT_POWER_OUTAGE_MULTIPLIER :: 0.15;
PLAYER_LIGHT_POWER_OUTAGE_TRAITOR_MULTIPLIER :: 0.5;
PLAYER_LIGHT_PIRATE_FOG_MULTIPLIER :: 0.3;
PLAYER_LIGHT_MIN_INNER_RADIUS :: 0.75;
PLAYER_LIGHT_MIN_OUTER_RADIUS :: 1.25;
PLAYER_LIGHT_INTENSITY :: 1.0;
PLAYER_LIGHT_COLOR := v4.{1.0, 1.0, 1.0, 1.0};
PIRATE_DIRT_PILE_TEXTURE_PATH :: "sprites/dirt_pile.png";
PIRATE_DIRT_PILE_FALLBACK_TEXTURE_PATH :: "sprites/icons/pirate/dig_for_treasure.png";
RR_HUB_GAME_ID :: "692f424cd0b237adf50fdab0";

Player :: class : Player_Base {
    player_type: Player_Type;
    player_state: Player_State;
    player_role: Player_Role;
	// Optional admin cheat: force a role for the next round only.
	forced_role_next_round: Player_Role;
    voted_for: Player;  // Who this player voted for (null if no vote yet)
    has_voted: bool;    // True if this player has cast a ballot this meeting (including skip)
    voted_skip: bool;   // True if this player voted to skip
    votes_received: int;  // How many votes this player has received

    active_tasks : List(Task_Base);

	// Local UI state
	show_minimap: bool;
	chat_mode_inited: bool;
	chat_mode_last_applied: Chat.Mode;
	task_list_inited: bool;
	task_list_open: bool;
	task_help_open: bool;
	task_help_page: int;
	lobby_waiting_since_time: float;

	// Local-only LOS light (viewer-specific).
	local_light_entity: Entity;
	local_light: Light;
	local_light_caster: LOS_Caster;


	// --- Camera ---
	// Saved once at start so we can restore it at the beginning of each round.
	camera_default_size: float;
	camera_default_size_saved: bool;

	// --- Ghost QoL ---
	// Local-only camera zoom so dead players can see more of the map.
	ghost_camera_zoom_active: bool;
	ghost_camera_original_size: float;
	// Server-side speed override applied while dead (spectator).
	ghost_speed_override_active: bool;
	ghost_speed_original_movement_speed: float;
	
	// --- Pyromaniac (cross-player: any player can be on fire) ---
	pyro_on_fire: bool;

	// Jester / vote eject camera (kept on Player for now)
	sm_inited: bool;
	jester_win_camera_override_active: bool;
	vote_eject_camera_override_active: bool;
	vote_eject_camera_original_size: float;

	// --- Doctor (cross-player: any player can be resurrected) ---
	is_temporarily_resurrected: bool;
	temporarily_resurrected_until: float;
	was_corpse_reported_before_resurrect: bool;

	// Per-player portal interaction (anyone can use portals)
	portal_standing_on_portal: Entity;
	portal_standing_seconds: float;
	portal_blocked_portal: Entity;

	// Door unlock interactable (1 per player, repositioned to nearest closed door)
	door_unlock_entity: Entity;
	door_unlock_interactable: Door_Unlock_Interactable;

	// --- Werewolf (Traitor role) ---
	// Gameplay fields (kills, wolf form, speed) live in Werewolf_Module (only on werewolf player).
	werewolf_infected: bool;          // infected "small werewolf" curse
	werewolf_infected_from_id: u64;   // original werewolf entity id (0 = unknown)
	// When infected, we temporarily replace the player's task list with a single objective.
	werewolf_saved_tasks_active: bool;
	werewolf_saved_tasks: List(Task_Base);
	// Cosmetic: skin switching timing (used for transform animations — cross-player due to infection).
	werewolf_skin_enable_at: float;   // 0 = none, otherwise game-time to enable werewolf skin
	werewolf_skin_disable_at: float;  // 0 = none, otherwise game-time to disable werewolf skin
	werewolf_skin_active: bool;       // cached flag – avoids get_skins() every frame
	// Saved cosmetic skins before wolf form (restored on revert).
	werewolf_saved_cosmetic_skins: [..]string;
	// Round-start cosmetic baseline (captured once each round).
	werewolf_round_start_cosmetic_skins: [..]string;
	werewolf_saved_avatar_color: Color_Replace_Color;
	werewolf_round_start_avatar_color: Color_Replace_Color;
	// Delayed infected transform: game-time at which to fire the "werewolf_infected_transform" trigger.
	// 0 = no pending trigger.
	werewolf_infected_transform_trigger_at: float;

	// --- Goo Goo Gaga (Traitor role) ---
	// All GGG fields live in GGG_Module (only on GGG player).

	// --- Meeting cooldown pause ---
	// Saved ability cooldowns when a meeting starts so they can be restored afterwards.
	meeting_saved_cooldowns: [..]float;

	// --- Drag Body (traitor utility) ---
	// Entity id of the corpse currently being dragged (0 = none).
	dragging_corpse_entity_id: u64;
	// True when the player is facing right (used by corpse side offset + drag anim selection).
	drag_body_is_right: bool;
	// Server-authoritative looping SFX while dragging.
	drag_body_sfx_id: u64;
	// Client/local movement sampling for drag animation direction.
	drag_body_last_pos_inited: bool;
	drag_body_last_pos: v2;
	// Movement speed override while dragging.
	drag_body_speed_active: bool;
	drag_body_speed_original: float;
	// Track drag end to reset animations.
	drag_body_was_dragging: bool;

    is_frozen: bool;

	// True when the local player has any task attempt currently open/in progress.
	// Used to suppress ability input while interacting with task UI.
	has_task_in_progress :: proc(using this: Player) -> bool {
		for i: 0..this.active_tasks.elements.count-1 {
			task := this.active_tasks.elements[i];
			if task == null continue;
			if task.started && !task.completed {
				return true;
			}
		}
		return false;
	}

	// Global ability gate (called after cooldown + ability can_use).
	ao_can_use_ability :: proc(using this: Player, ability: Ability_Base) -> bool {
		// While on fire, you can only move.
		if pyro_on_fire return false;
		return true;
	}

	// Global interact gate (called before interactable can_use).
	ao_can_use_interactable :: proc(using this: Player, interactable: Interactable) -> bool {
		if pyro_on_fire return false;
		// Basic sanity: passive players can't use interactables.
		if player_state == Player_State.PASSIVE return false;
		// Ghost tasks: dead civilians are allowed to interact (Task_Interactable.can_use does the task gating).
		if player_state != Player_State.ALIVE {
			return player_state == Player_State.DEAD && player_type == Player_Type.CIVILIAN && !werewolf_infected && !is_temporarily_resurrected;
		}
		return true;
	}

    update_freeze_reasons :: proc(using this: Player) {
        // Prevent player movement while global popups are on-screen, and while the local
        // player is actively working on a task.
        //
        // We use separate reasons so popups and tasks don't accidentally unfreeze each other.
        should_freeze_for_popup :=
            game_state == Game_State.ANIM_INTRO ||
			game_state == Game_State.ANIM_VOTE_EJECT ||
			game_state == Game_State.ANIM_JESTER_WIN ||
            game_state == Game_State.ANIM_VICTORY;

        should_check_tasks :=
            game_state == Game_State.INGAME &&
            this.player_type == Player_Type.CIVILIAN &&
			!this.werewolf_infected &&
			!this.is_temporarily_resurrected &&
			(this.player_state == Player_State.ALIVE || this.player_state == Player_State.DEAD);

        has_task_in_progress := false;
        if should_check_tasks {
			has_task_in_progress = this->has_task_in_progress();
        }

        should_be_frozen := should_freeze_for_popup || has_task_in_progress;

        if(is_frozen == should_be_frozen) {
            return;
        }

        if should_be_frozen {
            this->add_disable_movement_input_reason("frozen");
        } else {
            this->remove_disable_movement_input_reason("frozen");
        }

        is_frozen = should_be_frozen;
    }

    Notify :: proc(using this: Player, message: string) {
        if this->is_local_or_server() {
            Notifier.notify(message);
        }
    }
    
    //Server Only!
    ao_start :: proc(using this: Player) {
		// Restart ambience so late-joiners hear it (single loop).
		rr_restart_ambience();
        append(ref players, this);

		this->ensure_anim_state_machine();

		// Voice chat: ensure late-joiners get the correct routing immediately.
		this->apply_voice_chat_masks_for_current_state();

		// If a new player joins while in solo test mode (mid-round), end the stale
		// round and return to lobby so everyone starts fresh.
		if rr_started_solo_test_mode && game_state != Game_State.LOBBY && game_state != Game_State.ANIM_VICTORY {
			setup_lobby();
			return;
		}

        if game_state == Game_State.LOBBY {
			// Lobby should always use the player navmesh/state (never ghost navmesh).
			on_player_go_passive(this);
        } else if game_state == Game_State.ANIM_VICTORY {
			// Victory screen: round is over, treat as passive (not ghost).
			on_player_go_passive(this);
        } else if game_state == Game_State.INGAME {
            on_player_go_dead(this);
        } else if game_state == Game_State.VOTING {
            on_player_go_dead(this);
            world_references->teleport_to_voting(this);
        } else {
			// Any other state (ANIM_INTRO, ANIM_BODY_FOUND, ANIM_MEETING_CALLED,
			// ANIM_VOTE_EJECT, ANIM_JESTER_WIN, ANIM_PYRO_WIN):
			// the round is already in progress so late-joiners must be ghosts.
			on_player_go_dead(this);
        }
    }

	apply_voice_chat_masks_for_current_state :: proc(using this: Player) {
		// In-match: alive speaks to alive; ghosts/spectators speak to dead (but listen to all)
		if this.player_state == Player_State.ALIVE {
			this->apply_voice_chat_masks_alive();
		} else {
			this->apply_voice_chat_masks_ghost_or_passive();
		}
	}

	apply_voice_chat_masks_alive :: proc(using this: Player) {
        log_info("apply_voice_chat_masks_alive");
		// Comms sabotage: alive players cannot hear/speak.
		if rr_comms_outage_active {
			comms_channel_listen_mask = 0;
			comms_channel_speak_mask  = 0;
			return;
		}

		// Alive can hear & speak on alive channel.
		comms_channel_listen_mask = ALIVE_CHANNEL;
		comms_channel_speak_mask  = ALIVE_CHANNEL;
	}

	apply_voice_chat_masks_ghost_or_passive :: proc(using this: Player) {
        log_info("apply_voice_chat_masks_ghost_or_passive");
		// Ghosts/spectators can hear everyone, but only speak to other ghosts.
		comms_channel_listen_mask = ALL_VOICE_CHANNELS;
		comms_channel_speak_mask  = DEAD_CHANNEL;
	}

    ao_end :: proc(using this: Player) {
		// Release any corpse this player was dragging (disconnect cleanup).
		rr_drag_body_force_drop_for_player(this);
		// Clean up portal maker portals on disconnect.
		rr_portal_maker_cleanup_for_player(this);
        // Player entity is being destroyed (typically disconnect). Clean up any corpses they spawned.
        destroy_corpses_for_player(this.entity.id);
		// Clean up any pirate dig-spots they spawned.
		destroy_pirate_dig_spots_for_player(this.entity.id);
		// Clean up door unlock interactable.
		rr_cleanup_door_unlock_interactable(this);
        unordered_remove_by_value(ref players, this);

		// Local-only: destroy LOS light.
		if this->is_local() {
			if local_light_entity != null && #alive(local_light_entity) {
				local_light_entity->destroy();
			}
			local_light_entity = null;
			local_light = null;
			local_light_caster = null;
		}
    }

    ao_update :: proc(using this: Player, delta_time: float) {
        if this->is_local_or_server() {
            this->update_freeze_reasons();
			// Cosmetic-only: name coloring is per-viewer. Do this only on the local client.
			if this->is_local() {
            	this->setup_player_colors();
				this->update_chat_mode();
				this->update_local_vision_light();
			}
			// Cosmetic: blackout overlay first so tasks UI/minigames can draw above it.
			rr_draw_power_outage_overlay_if_needed(this);
			// Global civilian progress bar – always visible at top-center (except lobby/cinematics).
			rr_draw_civilian_progress_bar(this);
            update_tasks_ui(this);
			update_minimap_ui(this);
			rr_draw_pirate_treasure_guidance_if_needed(this);
			rr_draw_comms_deaf_icons_if_needed(this, rr_comms_outage_active);
			draw_player_role_hud(this);
			// Draw resurrection timer above any temporarily resurrected players' heads.
			if this->is_local() {
				rr_draw_temp_resurrect_timers();
				// Draw fiery-room exposure countdown above the local player's head.
				rr_pyro_draw_room_exposure_timer(this);
			}
			if game_state == Game_State.ANIM_VOTE_EJECT || game_state == Game_State.ANIM_JESTER_WIN || game_state == Game_State.ANIM_PYRO_WIN {
				this->draw_letterbox_bars();
			}
			if game_state == Game_State.ANIM_VOTE_EJECT {
				this->draw_vote_eject_cinematic_ui();
			}
            if game_state == Game_State.ANIM_INTRO {
                intro_popup->set_local_player(this);
                intro_popup->update(delta_time);
            }
        }
        update_tasks(this);
		rr_update_portal_teleport_for_player(this, delta_time);
		rr_update_door_unlock_interactable(this);

		// Server-authoritative werewolf transform timing.
		if Game.is_server() {
			rr_werewolf_update_transform(this, delta_time);
			rr_ggg_update_transform(this, delta_time);
		}

		// Cosmetic: apply scheduled skin toggles on all clients.
		rr_werewolf_update_skins(this);

		// GGG creature animation controller (runs on all clients).
		rr_ggg_update_creature_anims(this, delta_time);

		// Drag body animation state (runs on all clients).
		rr_drag_body_update_anim_state(this, delta_time);

		// Server-authoritative: fiery room exposure countdown.
		rr_pyro_update_room_exposure(this, delta_time);
    }

	update_chat_mode :: proc(using this: Player) {
		desired := Chat.Mode.DEFAULT;
		// In-game: bubble-only chat for alive players (ghosts stay in default chat).
		if game_state == Game_State.INGAME && this.player_state == Player_State.ALIVE {
			desired = Chat.Mode.BUBBLE_ONLY;
		}

		if chat_mode_inited && desired == chat_mode_last_applied return;

		Chat.set_mode(desired);
		chat_mode_last_applied = desired;
		chat_mode_inited = true;
	}

	is_in_pirate_fog :: proc(using this: Player) -> bool {
		if game_state != Game_State.INGAME return false;
		if player_state != Player_State.ALIVE return false;
		if !this->is_local() return false;

		foreach fog: component_iterator(Black_Flag) {
			if fog == null continue;
			if !#alive(fog.entity) continue;
			distance := length(this.entity.world_position - fog.entity.world_position);
			if distance < BLACK_FLAG_RADIUS {
				is_owner := #alive(fog.owner_entity) && fog.owner_entity == this.entity;
				if !is_owner {
					return true;
				}
			}
		}
		return false;
	}

	get_local_light_radii :: proc(using this: Player) -> v2 {
		// During animations/cinematics, expand radii so LOS shadows don't hide content.
		is_anim_state :=
			game_state == Game_State.ANIM_INTRO ||
			game_state == Game_State.ANIM_BODY_FOUND ||
			game_state == Game_State.ANIM_MEETING_CALLED ||
			game_state == Game_State.ANIM_VOTE_EJECT ||
			game_state == Game_State.ANIM_JESTER_WIN ||
			game_state == Game_State.ANIM_PYRO_WIN ||
			game_state == Game_State.ANIM_VICTORY;
		if is_anim_state {
			return v2.{999.0, 999.0};
		}

		radii := v2.{PLAYER_LIGHT_BASE_INNER_RADIUS, PLAYER_LIGHT_BASE_OUTER_RADIUS};

		// Power outage reduces visibility for everyone, but traitors keep better sight.
		if game_state == Game_State.INGAME && player_state == Player_State.ALIVE {
			if rr_power_outage_active {
				if this.player_type == Player_Type.TRAITOR {
					radii.x *= PLAYER_LIGHT_POWER_OUTAGE_TRAITOR_MULTIPLIER;
					radii.y *= PLAYER_LIGHT_POWER_OUTAGE_TRAITOR_MULTIPLIER;
				} else if rr_power_outage_affects_player(this) {
					radii.x *= PLAYER_LIGHT_POWER_OUTAGE_MULTIPLIER;
					radii.y *= PLAYER_LIGHT_POWER_OUTAGE_MULTIPLIER;
				}
			}
			if this->is_in_pirate_fog() {
				radii.x *= PLAYER_LIGHT_PIRATE_FOG_MULTIPLIER;
				radii.y *= PLAYER_LIGHT_PIRATE_FOG_MULTIPLIER;
			}
		}

		// Clamp to avoid a zero/negative radius.
		radii.x = max(radii.x, PLAYER_LIGHT_MIN_INNER_RADIUS);
		radii.y = max(radii.y, PLAYER_LIGHT_MIN_OUTER_RADIUS);
		if radii.x > radii.y {
			radii.x = radii.y;
		}
		return radii;
	}

	ensure_local_vision_light :: proc(using this: Player) {
		if local_light_entity != null && #alive(local_light_entity) return;

		local_light_entity = Scene.create_entity();
		local_light_entity->set_parent(this.entity, false);
		local_light_entity->set_local_enabled(true);
		local_light_entity->set_local_position(v2.{0.0, 0.0});
		local_light_entity->set_local_rotation(0.0);
		local_light_entity->set_local_scale(v2.{1.0, 1.0});

		local_light = local_light_entity->add_component(Light);
		local_light.color = PLAYER_LIGHT_COLOR;
		local_light.intensity = PLAYER_LIGHT_INTENSITY;
		local_light.radii = v2.{PLAYER_LIGHT_BASE_INNER_RADIUS, PLAYER_LIGHT_BASE_OUTER_RADIUS};

		local_light_caster = local_light_entity->add_component(LOS_Caster);
		local_light_caster.radii = local_light.radii;
	}

	update_local_vision_light :: proc(using this: Player) {
		if !this->is_local() return;
		if !#alive(this.entity) return;

		this->ensure_local_vision_light();

		if local_light == null && local_light_entity != null {
			local_light = local_light_entity->get_component(Light);
		}
		if local_light_caster == null && local_light_entity != null {
			local_light_caster = local_light_entity->get_component(LOS_Caster);
		}
		if local_light == null || local_light_caster == null return;

		radii := this->get_local_light_radii();
		local_light.radii = radii;
		local_light_caster.radii = radii;
		// Disable LOS occlusion during lights-out so players are not fully hidden by shadows.
		disable_los_occlusion :=
			rr_power_outage_disable_los_occlusion &&
			rr_power_outage_active &&
			game_state == Game_State.INGAME &&
			player_state == Player_State.ALIVE &&
			player_type == Player_Type.TRAITOR;
		local_light_caster.enabled = !disable_los_occlusion;
	}

    ao_late_update :: proc(using this: Player, delta_time: float) {
        if this->is_local_or_server() {
			// Ghost QoL: zoom the local dead player's camera out a bit so they can
			// see more of the map while spectating.
			//
			// Important:
			// - Only the local player has a camera.
			// - Avoid fighting win cinematics (handled by the early return below).
			if this->is_local() {
				// Save the engine-default camera size once so we can restore it each round.
				if !camera_default_size_saved {
					camera_default_size = this.camera.size;
					camera_default_size_saved = true;
				}

				// Reset camera zoom to default at the start of each round (intro or lobby).
				if game_state == Game_State.ANIM_INTRO || game_state == Game_State.LOBBY {
					if ghost_camera_zoom_active {
						ghost_camera_zoom_active = false;
					}
					if vote_eject_camera_override_active {
						vote_eject_camera_override_active = false;
					}
					if jester_win_camera_override_active {
						jester_win_camera_override_active = false;
					}
					this.camera.follow_player = true;
					this.camera.size = camera_default_size;
				}

				in_cinematic :=
					game_state == Game_State.ANIM_JESTER_WIN ||
					game_state == Game_State.ANIM_PYRO_WIN;
				should_ghost_zoom :=
					!in_cinematic &&
					this.player_state == Player_State.DEAD &&
					(game_state == Game_State.INGAME || game_state == Game_State.VOTING);

				if should_ghost_zoom {
					if !ghost_camera_zoom_active {
						ghost_camera_original_size = this.camera.size;
						ghost_camera_zoom_active = true;
					}
					this.camera.size = GHOST_CAMERA_ZOOMED_OUT_SIZE;
				} else {
					if ghost_camera_zoom_active {
						this.camera.size = ghost_camera_original_size;
						ghost_camera_zoom_active = false;
					}
				}
			}

			// If we were overriding the camera for a win cinematic and it ended,
			// restore the normal follow behavior.
			if jester_win_camera_override_active && game_state != Game_State.ANIM_JESTER_WIN && game_state != Game_State.ANIM_PYRO_WIN {
				this.camera.follow_player = true;
				jester_win_camera_override_active = false;
			}

			// Restore camera after vote ejection cinematic.
			if vote_eject_camera_override_active && game_state != Game_State.ANIM_VOTE_EJECT {
				this.camera.follow_player = true;
				this.camera.size = vote_eject_camera_original_size;
				vote_eject_camera_override_active = false;
			}

			// During vote ejection, lock camera to the ejected player and zoom in.
			if game_state == Game_State.ANIM_VOTE_EJECT {
				elapsed := get_time() - rr_vote_eject_start_time;
				if elapsed >= RR_VOTE_EJECT_TEXT_SECONDS && this->is_local() {
					if !vote_eject_camera_override_active {
						vote_eject_camera_original_size = this.camera.size;
						this.camera.follow_player = false;
						vote_eject_camera_override_active = true;
					}
					target := get_player_by_entity_id(rr_vote_eject_player_id);
					if target != null && #alive(target.entity) {
						this.camera.position = target.entity.world_position;
					}
					t := clamp((elapsed - RR_VOTE_EJECT_TEXT_SECONDS) / RR_VOTE_EJECT_CAMERA_ZOOM_SECONDS, 0.0, 1.0);
					this.camera.size = lerp(vote_eject_camera_original_size, VOTE_EJECT_CAMERA_ZOOMED_IN_SIZE, t);
				}
				return;
			}

			// During win cinematics, keep the camera locked to the cinematic actor every frame.
			if game_state == Game_State.ANIM_JESTER_WIN || game_state == Game_State.ANIM_PYRO_WIN {
				// Turn off camera follow and set position ONCE to reduce per-frame camera work.
				if !jester_win_camera_override_active {
					if this->try_begin_jester_win_camera_override() {
						jester_win_camera_override_active = true;
					}
				}
				return;
			}
            if this.player_state == Player_State.ALIVE {
                abilityIndex := 0;
                
                if game_state == Game_State.VOTING {
                    // During voting, only show the vote ability
                    draw_ability_button(this, Vote_Ability, abilityIndex);
                } else if game_state == Game_State.INGAME {
					// Mini-werewolf infection: suppress ALL normal abilities until they pass the bite.
					// Only show after the transformation has revealed (skin active = wolf look applied).
					// During the 10s delay the player keeps their normal abilities so nothing looks different.
					if this.werewolf_infected && this.werewolf_skin_active {
						draw_ability_button(this, Werewolf_Pass_Bite_Ability, 0);
						return;
					}

                    // During gameplay, show abilities based on type and role
                    if player_type == Player_Type.TRAITOR {
						// Hitman replaces the default kill with Neck Snap.
						if player_role == Player_Role.HITMAN {
							draw_ability_button(this, Hitman_Neck_Snap_Ability, abilityIndex);
							abilityIndex += 1;
						} else if player_role == Player_Role.WEREWOLF {
							wm := this.entity->get_component(Werewolf_Module);
							if wm != null && wm.is_wolf_form {
								// Wolf form: Devour + Transform (no Drag).
								draw_ability_button(this, Werewolf_Devour_Ability, abilityIndex);
								abilityIndex += 1;
								draw_ability_button(this, Werewolf_Transform_Ability, abilityIndex);
								abilityIndex += 1;
							} else {
								// Human form: Drag + Transform (no Devour).
								draw_ability_button(this, Drag_Body_Ability, abilityIndex);
								abilityIndex += 1;
								draw_ability_button(this, Werewolf_Transform_Ability, abilityIndex);
								abilityIndex += 1;
							}
						} else if player_role == Player_Role.GOO_GOO_GAGA {
							ggm := this.entity->get_component(GGG_Module);
							if ggm != null && ggm.is_creature_form {
								// Creature form: Kill + Transform + Wrap + Crawl/Trap/Swarm (progressive unlock).
								draw_ability_button(this, Kill_Ability, abilityIndex);
								abilityIndex += 1;
								draw_ability_button(this, GGG_Transform_Ability, abilityIndex);
								abilityIndex += 1;
								draw_ability_button(this, GGG_Wrap_Ability, abilityIndex);
								abilityIndex += 1;
								draw_ability_button(this, GGG_Crawl_Ability, abilityIndex);
								abilityIndex += 1;
								draw_ability_button(this, GGG_Chocolate_Trap_Ability, abilityIndex);
								abilityIndex += 1;
								draw_ability_button(this, GGG_Swarm_Ability, abilityIndex);
								abilityIndex += 1;
							} else {
								// Human form: Kill + Drag + Transform.
								draw_ability_button(this, Kill_Ability, abilityIndex);
								abilityIndex += 1;
								draw_ability_button(this, Drag_Body_Ability, abilityIndex);
								abilityIndex += 1;
								draw_ability_button(this, GGG_Transform_Ability, abilityIndex);
								abilityIndex += 1;
							}
						} else {
                        	draw_ability_button(this, Kill_Ability, abilityIndex);
							abilityIndex += 1;
						}

						// All traitors (except werewolf and GGG, handled above) can drag bodies.
						if player_role != Player_Role.WEREWOLF && player_role != Player_Role.GOO_GOO_GAGA {
							draw_ability_button(this, Drag_Body_Ability, abilityIndex);
							abilityIndex += 1;
						}
                        
                        // Pirate progression: Black Flag default, Shoot at 1 treasure, Keg at 2.
                        if player_role == Player_Role.PIRATE {
							draw_ability_button(this, Black_Flag_Ability, abilityIndex);
							abilityIndex += 1;
							pm := this.entity->get_component(Pirate_Module);
							// Only show Shoot once unlocked.
							if pm != null && pm.treasure >= PIRATE_SHOOT_UNLOCK_TREASURE_COST {
								draw_ability_button(this, Shoot_Ability, abilityIndex);
								abilityIndex += 1;
							}
							// Only show Powder Keg once unlocked.
							if pm != null && pm.treasure >= PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST {
								draw_ability_button(this, Powder_Keg_Ability, abilityIndex);
								abilityIndex += 1;
							}
							draw_ability_button(this, Pirate_Treasure_Map_Ability, abilityIndex);
							abilityIndex += 1;
                        }

						// Hitman gets Mine + Sniper (only show once unlocked).
						if player_role == Player_Role.HITMAN {
							hm := this.entity->get_component(Hitman_Module);
							if hm != null && hm.kills >= HITMAN_MINE_UNLOCK_KILLS {
								draw_ability_button(this, Hitman_Mine_Ability, abilityIndex);
								abilityIndex += 1;
							}
							if hm != null && hm.kills >= HITMAN_SNIPER_UNLOCK_KILLS {
								draw_ability_button(this, Hitman_Sniper_Ability, abilityIndex);
								abilityIndex += 1;
							}
						}

						// Werewolf gets Infect (any form) + Claw (wolf form only), once unlocked.
						if player_role == Player_Role.WEREWOLF {
							wm2 := this.entity->get_component(Werewolf_Module);
							if wm2 != null && wm2.kills >= WEREWOLF_INFECT_UNLOCK_KILLS {
								draw_ability_button(this, Werewolf_Infecting_Bite_Ability, abilityIndex);
								abilityIndex += 1;
							}
							if wm2 != null && wm2.is_wolf_form && wm2.kills >= WEREWOLF_CLAW_UNLOCK_KILLS {
								draw_ability_button(this, Werewolf_Claw_Slash_Ability, abilityIndex);
								abilityIndex += 1;
							}
						}

						// Traitor quick-access map (sabotage icon) above abilities.
						draw_traitor_sabotage_map_button(this);
                    }
                    if player_type == Player_Type.CIVILIAN && player_role == Player_Role.SHERIFF {
                        draw_ability_button(this, Shoot_Ability, abilityIndex);
                        abilityIndex += 1;
                    }
					if player_type == Player_Type.CIVILIAN && player_role == Player_Role.DOCTOR {
						draw_ability_button(this, Resurrect_Ability, abilityIndex);
						abilityIndex += 1;
					}
					if player_type == Player_Type.CIVILIAN && player_role == Player_Role.MOVIE_STAR {
						draw_ability_button(this, Autograph_Ability, abilityIndex);
						abilityIndex += 1;
					}
					if player_type == Player_Type.CIVILIAN && player_role == Player_Role.CORONER {
						draw_ability_button(this, DNA_Sample_Ability, abilityIndex);
						abilityIndex += 1;
						draw_ability_button(this, DNA_Match_Ability, abilityIndex);
						abilityIndex += 1;
					}
					if player_type == Player_Type.CIVILIAN && player_role == Player_Role.PORTAL_MAKER {
						draw_ability_button(this, Red_Portal_Ability, abilityIndex);
						abilityIndex += 1;
						draw_ability_button(this, Blue_Portal_Ability, abilityIndex);
						abilityIndex += 1;
					}
					if player_type == Player_Type.ANARCHIST && player_role == Player_Role.PRANKSTER {
						draw_ability_button(this, Prank_Ability, abilityIndex);
						abilityIndex += 1;
						draw_ability_button(this, Fake_Meeting_Ability, abilityIndex);
						abilityIndex += 1;
						// Only show Jester Win once unlocked.
						prk := this.entity->get_component(Prankster_Module);
						if prk != null && prk.jester_unlocked_time > 0.0 {
							draw_ability_button(this, Jester_Win_Ability, abilityIndex);
							abilityIndex += 1;
						}
					}
					if player_type == Player_Type.ANARCHIST && player_role == Player_Role.PYROMANIAC {
						draw_ability_button(this, Pyromaniac_Light_Fire_Ability, abilityIndex);
						abilityIndex += 1;
						draw_ability_button(this, Pyromaniac_Light_Corpse_Ability, abilityIndex);
						abilityIndex += 1;
						// Only show World Fire once unlocked.
						pyro := this.entity->get_component(Pyro_Module);
						if pyro != null && pyro.world_fire_unlocked_time > 0.0 {
							draw_ability_button(this, Pyromaniac_World_Fire_Ability, abilityIndex);
							abilityIndex += 1;
						}
					}
					}
				} else if game_state == Game_State.LOBBY {
					required_players := rr_get_lobby_required_player_count();
					if !waiting_for_restart && players.elements.count < required_players {
						if lobby_waiting_since_time <= 0.0 {
							lobby_waiting_since_time = get_time();
						}

						elapsed := get_time() - lobby_waiting_since_time;
						if elapsed < 0.0 { elapsed = 0.0; }
						elapsed_i := elapsed.(int);
						if elapsed_i < 0 { elapsed_i = 0; }
						minutes := elapsed_i / 60;
						seconds := elapsed_i - minutes * 60;

						t := get_time();
						screen := UI.get_safe_screen_rect();
						area_rect := screen->bottom_center_rect()->offset(0, 230);

						// --- Elapsed timer (top) ---
						timer_rect := area_rect->grow(20, 240, 0, 240)->offset(0, 40);
						timer_ts := UI.default_text_settings();
						timer_ts.size = 30;
						timer_ts.color = .{0.55, 0.55, 0.65, 1};
						timer_ts.halign = .CENTER;
						timer_ts.valign = .CENTER;
						timer_ts.do_outline = true;
						timer_ts.outline_thickness = 4;
						timer_ts.outline_color = .{0, 0, 0, 1};
						timer_ts.spacing_multiplier = 1.1;
						UI.text(timer_rect, timer_ts, "%:%", {format_int(minutes, leading_zeroes=2), format_int(seconds, leading_zeroes=2)});

						// --- Animated title (middle): color-cycling + gentle bob ---
						title_r := sin(t * 1.8) * 0.3 + 0.7;
						title_g := sin(t * 1.8 + 2.094) * 0.3 + 0.7;
						title_b := sin(t * 1.8 + 4.189) * 0.3 + 0.7;
						bob_y := sin(t * 2.0) * 4.0;

						title_rect := area_rect->grow(30, 240, 0, 240)->offset(0, -15.0 + bob_y);
						title_ts := UI.default_text_settings();
						title_ts.size = 48;
						title_ts.color = .{title_r, title_g, title_b, 1};
						title_ts.halign = .CENTER;
						title_ts.valign = .CENTER;
						title_ts.do_outline = true;
						title_ts.outline_thickness = 6;
						title_ts.outline_color = .{0, 0, 0, 1};
						title_ts.spacing_multiplier = 1.2;

						// Animated dots cycling: (none) . .. ...
						dot_time := (t * 2.0).(int);
						dot_phase := dot_time - (dot_time / 4) * 4;
						dots := "";
						if dot_phase == 1 { dots = "."; }
						else if dot_phase == 2 { dots = ".."; }
						else if dot_phase == 3 { dots = "..."; }
						UI.text(title_rect, title_ts, "WAITING FOR PLAYERS%", {dots});

						// --- Player count (bottom): X / MAX ---
						player_count := players.elements.count;
						pulse := sin(t * 3.0) * 0.15 + 0.85;
						count_rect := area_rect->grow(25, 240, 0, 240)->offset(0, -75);
						count_ts := UI.default_text_settings();
						count_ts.size = 44;
						count_ts.color = .{pulse, pulse * 0.85, 0.25, 1};
						count_ts.halign = .CENTER;
						count_ts.valign = .CENTER;
						count_ts.do_outline = true;
						count_ts.outline_thickness = 5;
						count_ts.outline_color = .{0, 0, 0, 1};
						count_ts.spacing_multiplier = 1.1;
						UI.text(count_rect, count_ts, "% / %", {player_count, required_players});

						// Return-to-hub action while waiting for enough players.
						// Only show this after players have waited in lobby for 30s.
						if elapsed >= 15.0 {
							button_pulse := sin(t * 3.2) * 0.07 + 0.93;
							return_btn_rect := area_rect->grow(26, 160, 12, 160)->offset(0, -148);
							return_bs := UI.default_button_settings();
							return_bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png");
							return_bs.press_scaling = 0.96;
							return_bs.hover_offset = v2.{0, 2};
							return_bs.background_color_multiplier = v4.{button_pulse * 0.92, button_pulse * 0.96, button_pulse, 1.0};
							rr_ui_apply_button_click_sound(ref return_bs);

							return_ts := UI.default_text_settings();
							return_ts.size = 29;
							return_ts.color = v4.{1, 1, 1, 1};
							return_ts.halign = .CENTER;
							return_ts.valign = .CENTER;
							return_ts.do_outline = true;
							return_ts.outline_thickness = 4;
							return_ts.outline_color = v4.{0, 0, 0, 1};

							if UI.button(return_btn_rect, return_bs, return_ts, "Return to Hub").clicked {
								// Server-authoritative transfer.
								if Game.is_server() {
									Server.transfer_player_to_game(this, RR_HUB_GAME_ID);
								}
							}
						}
					} else {
						lobby_waiting_since_time = 0.0;
					}
                } else {
					lobby_waiting_since_time = 0.0;
				}
        }
    }

    setup_player_colors :: proc(using this: Player) {
		// Per-viewer name coloring:
		// - If the local player is an impostor (traitor), all impostors show red.
		// - Otherwise, everyone is white.
		//
		// IMPORTANT: run this only on the local client (see ao_update).
		local_is_impostor := this.player_type == Player_Type.TRAITOR;
		foreach p: component_iterator(Player) {
			p.do_name_color_override = true;
			if local_is_impostor && p.player_type == Player_Type.TRAITOR {
				p.name_color_override = .{1, 0, 0, 1};
			} else {
				p.name_color_override = .{1, 1, 1, 1};
			}
		}
    }

    clear_player_colors :: proc(using this: Player) {
		// Reset to default (used when leaving gameplay contexts).
		foreach p: component_iterator(Player) {
			p.do_name_color_override = false;
		}
    }

    kill :: proc(using this: Player) {
		this->kill_with_killer(0);
    }

	kill_with_killer :: proc(using this: Player, killer_player_entity_id: u64) {
		this->kill_with_killer_and_corpse(killer_player_entity_id, true);
    }

	kill_with_killer_no_corpse :: proc(using this: Player, killer_player_entity_id: u64) {
		this->kill_with_killer_and_corpse(killer_player_entity_id, false);
	}

	kill_with_killer_and_corpse :: proc(using this: Player, killer_player_entity_id: u64, spawn_corpse: bool) {
        //freeze_player = true;
		// If we were dragging a body, drop it immediately.
		rr_drag_body_force_drop_for_player(this);
		// If this player was temporarily resurrected, clear the flag so tasks/UI don't get stuck.
		this.is_temporarily_resurrected = false;
		this.temporarily_resurrected_until = 0.0;
		// Werewolf infection should never persist through death.
		// Restore original tasks before clearing infection state.
		rr_werewolf_clear_infected_task_override(this);
		this.werewolf_infected = false;
		this.werewolf_infected_from_id = 0;
		// Ensure visuals revert immediately.
		this.werewolf_skin_enable_at = 0.0;
		this.werewolf_skin_disable_at = get_time();
		this.werewolf_infected_transform_trigger_at = 0.0;

		// Track death for the next meeting's recap UI.
		rr_register_player_death(this.entity.id);
        on_player_go_dead(this);
		if spawn_corpse {
        	world_references->spawn_corpse(this, killer_player_entity_id);
		}
		rr_hitman_on_player_killed(killer_player_entity_id, this.entity.id);
		rr_werewolf_on_player_killed(killer_player_entity_id, this.entity.id);
		rr_ggg_on_player_killed(killer_player_entity_id, this.entity.id);
        log(format_string("Player % killed (killer=%)", .{this.entity.id, killer_player_entity_id}));
	}

player_role_to_string :: proc(player: Player) -> string {
	if player == null return "UNKNOWN";
	switch player.player_role {
		case .NONE:       return "CREW";
		case .SHERIFF:    return "SHERIFF";
		case .DOCTOR:     return "DOCTOR";
		case .PRESIDENT:  return "PRESIDENT";
		case .MOVIE_STAR: return "MOVIE STAR";
		case .CORONER:    return "CORONER";
		case .PORTAL_MAKER: return "WARPER";
		case .PRANKSTER:  return "PRANKSTER";
		case .PYROMANIAC: return "PYROMANIAC";
		case .PIRATE:     return "PIRATE";
		case .HITMAN:     return "HITMAN";
		case .WEREWOLF:      return "WEREWOLF";
		case .GOO_GOO_GAGA:  return "GOO GOO GAGA";
	}
	return "CREW";
}

player_role_to_icon_texture :: proc(role: Player_Role) -> Texture_Asset {
	switch role {
		case .SHERIFF:      return get_asset(Texture_Asset, "sprites/icons/roles/sheriff_icon.png");
		case .DOCTOR:       return get_asset(Texture_Asset, "sprites/icons/roles/doctor_icon.png");
		case .PRESIDENT:    return get_asset(Texture_Asset, "sprites/icons/roles/president_icon.png");
		case .MOVIE_STAR:   return get_asset(Texture_Asset, "sprites/icons/roles/moviestar_icon.png");
		case .CORONER:      return get_asset(Texture_Asset, "sprites/icons/roles/coroner_icon.png");
		case .PORTAL_MAKER: return get_asset(Texture_Asset, "sprites/icons/roles/portalmaker_icon.png");
		case .PRANKSTER:    return get_asset(Texture_Asset, "sprites/icons/roles/trickster_icon.png");
		case .PYROMANIAC:   return get_asset(Texture_Asset, "sprites/icons/roles/pyromaniac_icon.png");
		case .PIRATE:       return get_asset(Texture_Asset, "sprites/icons/roles/pirate_icon.png");
		case .HITMAN:       return get_asset(Texture_Asset, "sprites/icons/roles/hitman_icon.png");
		case .WEREWOLF:      return get_asset(Texture_Asset, "sprites/icons/roles/werewolf_icon.png");
		case .GOO_GOO_GAGA:  return get_asset(Texture_Asset, "sprites/icons/roles/werewolf_icon.png"); // TODO: replace with GGG icon
	}
	return null;
}

// Draw a countdown timer above every temporarily resurrected player's head.
// Called once per frame from the local player's ao_update.
rr_draw_temp_resurrect_timers :: proc() {
	if game_state != Game_State.INGAME return;

	UI.push_world_draw_context();
	defer UI.pop_draw_context();

	foreach p: component_iterator(Player) {
		if p == null continue;
		if !#alive(p.entity) continue;
		if !p.is_temporarily_resurrected continue;
		if p.player_state != Player_State.ALIVE continue;
		if p.temporarily_resurrected_until <= 0.0 continue;

		remaining := p.temporarily_resurrected_until - get_time();
		if remaining < 0.0 { remaining = 0.0; }
		remaining_i := (remaining + 0.999).(int);
		if remaining_i < 0 { remaining_i = 0; }

		text_pos := p.entity.world_position + v2.{0, 1.8};

		UI.push_z(text_pos.y);
		defer UI.pop_z();

		text_rect := Rect{text_pos, text_pos}->grow(0.15, 1.5, 0.15, 1.5);

		ts := UI.default_text_settings();
		ts.size = 0.30;
		ts.halign = .CENTER;
		ts.valign = .CENTER;
		ts.do_outline = true;
		ts.outline_thickness = 3;
		ts.outline_color = v4.{0, 0, 0, 1};
		// Pulsing red when running low.
		if remaining < 3.0 {
			ts.color = v4.{1.0, 0.3, 0.3, 1.0};
		} else {
			ts.color = v4.{0.3, 1.0, 0.5, 1.0};
		}

		UI.text(text_rect, ts, format_string("%s", .{remaining_i}));
	}
}

draw_player_role_hud :: proc(player: Player) {
	if player == null return;
	// Don't show role UI in lobby or during voting (voting has its own fullscreen UI).
	if game_state == Game_State.LOBBY return;
	if game_state == Game_State.VOTING return;

	screen := UI.get_safe_screen_rect();
	UI.push_layer(1500);
	defer UI.pop_layer();

	bg := get_asset(Texture_Asset, "$AO/white.png");

	// Color accent by team
	accent := v4.{1, 1, 1, 1};
	if player.player_type == Player_Type.TRAITOR {
		accent = v4.{1, 0.2, 0.2, 1};
	} else if player.player_type == Player_Type.ANARCHIST {
		accent = v4.{1.0, 0.55, 0.25, 1};
	}

	// Role icon is now drawn inside the task list header (rr_draw_task_list_header).

	// Hitman contract HUD.
	if player.player_role == Player_Role.HITMAN && player->is_local_or_server() {
		UI.push_layer(1600);
		defer UI.pop_layer();

		// Mobile scale boost (no-op on PC).
		_pushed_scale := rr_push_mobile_ui_scale(player);
		defer rr_pop_mobile_ui_scale(_pushed_scale);

		safe := UI.get_safe_screen_rect();

		PANEL_W :: 300.0;
		ROW_H :: 32.0;
		LIST_PAD :: 10.0;
		DROPDOWN_SLICE_PX :: 16.0;

		row_count := 4;
		list_h := (row_count.(float)) * ROW_H + (LIST_PAD * 2.0);

		header_rect := rr_draw_task_list_header(safe, false, player);

		if player.task_list_open {
		list_rect := header_rect->bottom_left_rect()->grow(0.0, PANEL_W, list_h, 0.0);

		list_bg := get_asset(Texture_Asset, "ui/task list/task_list_dropdown_area.png");
		checkbox := get_asset(Texture_Asset, "ui/task list/checkbox.png");
		checkbox_filled := get_asset(Texture_Asset, "ui/task list/checkbox_filled.png");

		rr_ui_draw_nine_slice_panel(list_rect, list_bg, DROPDOWN_SLICE_PX);

		hm := player.entity->get_component(Hitman_Module);
		hm_kills : int = 0;
		hm_contract_target_id : u64 = 0;
		if hm != null {
			hm_kills = hm.kills;
			hm_contract_target_id = hm.contract_target_id;
		}

		target_name := "None";
		if hm_contract_target_id != 0 {
			t := get_player_by_entity_id(hm_contract_target_id);
			if t != null && t.player_state == Player_State.ALIVE {
				target_name = t.entity->get_name();
			}
		}

		base_ts := UI.default_text_settings();
		base_ts.size = 24;
		base_ts.halign = .LEFT;
		base_ts.valign = .CENTER;
		base_ts.do_outline = true;
		base_ts.outline_thickness = 4;
		base_ts.outline_color = v4.{0.15, 0.15, 0.215, 1};
		base_ts.do_autofit = true;
		base_ts.autofit_min_size = 14;
		base_ts.autofit_max_size = 24;

		list_content := list_rect->inset(LIST_PAD, 10.0, LIST_PAD, 10.0);
		{
			entry_rect := list_content->cut_top(ROW_H);
			list_content->cut_top(2.0);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			entry_content->cut_left(24.0);
			row_ts := base_ts;
			row_ts.color = v4.{1, 1, 1, 1};
			UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Target: %", .{target_name}));
		}
		{
			entry_rect := list_content->cut_top(ROW_H);
			list_content->cut_top(2.0);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			entry_content->cut_left(24.0);
			row_ts := base_ts;
			row_ts.color = v4.{1, 1, 1, 1};
			UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Kills: %", .{hm_kills}));
		}
		{
			entry_rect := list_content->cut_top(ROW_H);
			list_content->cut_top(2.0);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			checkbox_slot := entry_content->cut_left(24.0);
			checkbox_rect := checkbox_slot->center_rect()->grow(9.0);
			mine_unlocked := hm_kills >= HITMAN_MINE_UNLOCK_KILLS;
			if mine_unlocked {
				UI.quad(checkbox_rect->fit_aspect(checkbox_filled->get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
			} else {
				UI.quad(checkbox_rect->fit_aspect(checkbox->get_aspect()), checkbox, v4.{1, 1, 1, 1});
			}
			row_ts := base_ts;
			row_ts.color = mine_unlocked ? v4.{0.6, 1.0, 0.4, 1.0} : v4.{1, 1, 1, 1};
			UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Mine: %/%", .{min(hm_kills, HITMAN_MINE_UNLOCK_KILLS), HITMAN_MINE_UNLOCK_KILLS}));
		}
		{
			entry_rect := list_content->cut_top(ROW_H);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			checkbox_slot := entry_content->cut_left(24.0);
			checkbox_rect := checkbox_slot->center_rect()->grow(9.0);
			sniper_unlocked := hm_kills >= HITMAN_SNIPER_UNLOCK_KILLS;
			if sniper_unlocked {
				UI.quad(checkbox_rect->fit_aspect(checkbox_filled->get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
			} else {
				UI.quad(checkbox_rect->fit_aspect(checkbox->get_aspect()), checkbox, v4.{1, 1, 1, 1});
			}
			row_ts := base_ts;
			row_ts.color = sniper_unlocked ? v4.{0.6, 1.0, 0.4, 1.0} : v4.{1, 1, 1, 1};
			UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Sniper: %/%", .{min(hm_kills, HITMAN_SNIPER_UNLOCK_KILLS), HITMAN_SNIPER_UNLOCK_KILLS}));
		}
		} // end task_list_open
	}

	// Coroner vial count: right side around mid-screen (local-only).
	if player.player_role == Player_Role.CORONER && player->is_local() {
		UI.push_layer(1600);
		defer UI.pop_layer();

		vial := get_asset(Texture_Asset, "sprites/icons/coroner/dna_vial.png");
		anchor := screen->right_center_rect()->offset(-70.0, 0.0);
		icon_rect := anchor->grow(60.0); // big icon
		UI.quad(icon_rect->fit_aspect(vial->get_aspect()), vial, v4.{1, 1, 1, 1});

		// Count overlaid on the vial
		count_ts := UI.default_text_settings();
		count_ts.size = 44;
		count_ts.color = v4.{1, 1, 1, 1};
		count_ts.halign = .CENTER;
		count_ts.valign = .CENTER;
		count_ts.do_outline = true;
		count_ts.outline_thickness = 3;
		count_ts.outline_color = v4.{0, 0, 0, 1};
		cm := player.entity->get_component(Coroner_Module);
		vial_count := 0;
		if cm != null { vial_count = cm.dna_vials.count; }
		UI.text(icon_rect, count_ts, format_string("%", .{vial_count}));
	}

	// Pirate unlock progress.
	if player.player_role == Player_Role.PIRATE && player->is_local_or_server() {
		UI.push_layer(1600);
		defer UI.pop_layer();

		// Mobile scale boost (no-op on PC).
		_pushed_scale := rr_push_mobile_ui_scale(player);
		defer rr_pop_mobile_ui_scale(_pushed_scale);

		// Left-side panel with unlock progress (task list style).
		safe := UI.get_safe_screen_rect();

		PANEL_W :: 300.0;
		ROW_H :: 32.0;
		LIST_PAD :: 10.0;
		DROPDOWN_SLICE_PX :: 16.0;

		row_count := 3;
		list_h := (row_count.(float)) * ROW_H + (LIST_PAD * 2.0);

		header_rect := rr_draw_task_list_header(safe, false, player);

		if player.task_list_open {
		list_rect := header_rect->bottom_left_rect()->grow(0.0, PANEL_W, list_h, 0.0);

		list_bg := get_asset(Texture_Asset, "ui/task list/task_list_dropdown_area.png");
		checkbox := get_asset(Texture_Asset, "ui/task list/checkbox.png");
		checkbox_filled := get_asset(Texture_Asset, "ui/task list/checkbox_filled.png");

		rr_ui_draw_nine_slice_panel(list_rect, list_bg, DROPDOWN_SLICE_PX);

		base_ts := UI.default_text_settings();
		base_ts.size = 24;
		base_ts.halign = .LEFT;
		base_ts.valign = .CENTER;
		base_ts.do_outline = true;
		base_ts.outline_thickness = 4;
		base_ts.outline_color = v4.{0.15, 0.15, 0.215, 1};
		base_ts.do_autofit = true;
		base_ts.autofit_min_size = 14;
		base_ts.autofit_max_size = 24;

		list_content := list_rect->inset(LIST_PAD, 10.0, LIST_PAD, 10.0);
		pm := player.entity->get_component(Pirate_Module);
		pirate_treasure := pm != null ? pm.treasure : 0;
		{
			entry_rect := list_content->cut_top(ROW_H);
			list_content->cut_top(2.0);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			entry_content->cut_left(24.0);
			row_ts := base_ts;
			row_ts.color = v4.{1, 1, 1, 1};
			UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Treasure: %", .{pirate_treasure}));
		}
		{
			entry_rect := list_content->cut_top(ROW_H);
			list_content->cut_top(2.0);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			checkbox_slot := entry_content->cut_left(24.0);
			checkbox_rect := checkbox_slot->center_rect()->grow(9.0);
			shoot_unlocked := pirate_treasure >= PIRATE_SHOOT_UNLOCK_TREASURE_COST;
			if shoot_unlocked {
				UI.quad(checkbox_rect->fit_aspect(checkbox_filled->get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
			} else {
				UI.quad(checkbox_rect->fit_aspect(checkbox->get_aspect()), checkbox, v4.{1, 1, 1, 1});
			}
			row_ts := base_ts;
			row_ts.color = shoot_unlocked ? v4.{0.6, 1.0, 0.4, 1.0} : v4.{1, 1, 1, 1};
			if shoot_unlocked {
				UI.text(entry_content->inset(0, 4, 0, 4), row_ts, "Unlock Shoot: UNLOCKED");
			} else {
				UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Unlock Shoot: %/%", .{min(pirate_treasure, PIRATE_SHOOT_UNLOCK_TREASURE_COST), PIRATE_SHOOT_UNLOCK_TREASURE_COST}));
			}
		}
		{
			entry_rect := list_content->cut_top(ROW_H);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			checkbox_slot := entry_content->cut_left(24.0);
			checkbox_rect := checkbox_slot->center_rect()->grow(9.0);
			powder_keg_unlocked := pirate_treasure >= PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST;
			if powder_keg_unlocked {
				UI.quad(checkbox_rect->fit_aspect(checkbox_filled->get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
			} else {
				UI.quad(checkbox_rect->fit_aspect(checkbox->get_aspect()), checkbox, v4.{1, 1, 1, 1});
			}
			row_ts := base_ts;
			row_ts.color = powder_keg_unlocked ? v4.{0.6, 1.0, 0.4, 1.0} : v4.{1, 1, 1, 1};
			if powder_keg_unlocked {
				UI.text(entry_content->inset(0, 4, 0, 4), row_ts, "Unlock Powder Keg: UNLOCKED");
			} else {
				UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Unlock Powder Keg: %/%", .{min(pirate_treasure, PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST), PIRATE_POWDER_KEG_UNLOCK_TREASURE_COST}));
			}
		}
		} // end task_list_open
	}

	// Werewolf ability unlock progress: left side.
	if player.player_role == Player_Role.WEREWOLF && player->is_local_or_server() {
		UI.push_layer(1600);
		defer UI.pop_layer();

		// Mobile scale boost (no-op on PC).
		_pushed_scale := rr_push_mobile_ui_scale(player);
		defer rr_pop_mobile_ui_scale(_pushed_scale);

		safe := UI.get_safe_screen_rect();

		PANEL_W :: 300.0;
		ROW_H :: 32.0;
		LIST_PAD :: 10.0;
		DROPDOWN_SLICE_PX :: 16.0;

		row_count := 4;
		list_h := (row_count.(float)) * ROW_H + (LIST_PAD * 2.0);

		header_rect := rr_draw_task_list_header(safe, false, player);

		if player.task_list_open {
		list_rect := header_rect->bottom_left_rect()->grow(0.0, PANEL_W, list_h, 0.0);

		list_bg := get_asset(Texture_Asset, "ui/task list/task_list_dropdown_area.png");
		checkbox := get_asset(Texture_Asset, "ui/task list/checkbox.png");
		checkbox_filled := get_asset(Texture_Asset, "ui/task list/checkbox_filled.png");

		rr_ui_draw_nine_slice_panel(list_rect, list_bg, DROPDOWN_SLICE_PX);

		base_ts := UI.default_text_settings();
		base_ts.size = 24;
		base_ts.halign = .LEFT;
		base_ts.valign = .CENTER;
		base_ts.do_outline = true;
		base_ts.outline_thickness = 4;
		base_ts.outline_color = v4.{0.15, 0.15, 0.215, 1};
		base_ts.do_autofit = true;
		base_ts.autofit_min_size = 14;
		base_ts.autofit_max_size = 24;

		list_content := list_rect->inset(LIST_PAD, 10.0, LIST_PAD, 10.0);
		wm := player.entity->get_component(Werewolf_Module);
		wm_kills := 0;
		wm_is_wolf := false;
		wm_transform_ends := 0.0;
		if wm != null {
			wm_kills = wm.kills;
			wm_is_wolf = wm.is_wolf_form;
			wm_transform_ends = wm.transform_ends_at;
		}
		{
			entry_rect := list_content->cut_top(ROW_H);
			list_content->cut_top(2.0);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			entry_content->cut_left(24.0);
			row_ts := base_ts;
			if wm_is_wolf {
				remaining := wm_transform_ends - get_time();
				if remaining < 0.0 { remaining = 0.0; }
				remaining_s := (remaining + 0.999).(int);
				row_ts.color = v4.{1.0, 0.25, 0.25, 1.0};
				UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("WOLF: %s", .{remaining_s}));
			} else {
				row_ts.color = v4.{0.9, 0.9, 0.9, 1.0};
				UI.text(entry_content->inset(0, 4, 0, 4), row_ts, "Schleem");
			}
		}
		{
			entry_rect := list_content->cut_top(ROW_H);
			list_content->cut_top(2.0);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			entry_content->cut_left(24.0);
			row_ts := base_ts;
			row_ts.color = v4.{1, 1, 1, 1};
			UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Kills: %", .{wm_kills}));
		}
		{
			entry_rect := list_content->cut_top(ROW_H);
			list_content->cut_top(2.0);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			checkbox_slot := entry_content->cut_left(24.0);
			checkbox_rect := checkbox_slot->center_rect()->grow(9.0);
			infect_unlocked := wm_kills >= WEREWOLF_INFECT_UNLOCK_KILLS;
			if infect_unlocked {
				UI.quad(checkbox_rect->fit_aspect(checkbox_filled->get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
			} else {
				UI.quad(checkbox_rect->fit_aspect(checkbox->get_aspect()), checkbox, v4.{1, 1, 1, 1});
			}
			row_ts := base_ts;
			row_ts.color = infect_unlocked ? v4.{0.6, 1.0, 0.4, 1.0} : v4.{1, 1, 1, 1};
			UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Infect: %/%", .{min(wm_kills, WEREWOLF_INFECT_UNLOCK_KILLS), WEREWOLF_INFECT_UNLOCK_KILLS}));
		}
		{
			entry_rect := list_content->cut_top(ROW_H);
			entry_content := entry_rect->inset(0.0, 6.0, 0.0, 6.0);
			checkbox_slot := entry_content->cut_left(24.0);
			checkbox_rect := checkbox_slot->center_rect()->grow(9.0);
			claw_unlocked := wm_kills >= WEREWOLF_CLAW_UNLOCK_KILLS;
			if claw_unlocked {
				UI.quad(checkbox_rect->fit_aspect(checkbox_filled->get_aspect()), checkbox_filled, v4.{1, 1, 1, 1});
			} else {
				UI.quad(checkbox_rect->fit_aspect(checkbox->get_aspect()), checkbox, v4.{1, 1, 1, 1});
			}
			row_ts := base_ts;
			row_ts.color = claw_unlocked ? v4.{0.6, 1.0, 0.4, 1.0} : v4.{1, 1, 1, 1};
			UI.text(entry_content->inset(0, 4, 0, 4), row_ts, format_string("Claw: %/%", .{min(wm_kills, WEREWOLF_CLAW_UNLOCK_KILLS), WEREWOLF_CLAW_UNLOCK_KILLS}));
		}
		} // end task_list_open
	}
}

// --- Werewolf transform (ability-driven, server authoritative) ---
// Constants defined in abilities.csl: WEREWOLF_TRANSFORM_MAX_DURATION_SECONDS, WEREWOLF_TRANSFORM_COOLDOWN_SECONDS

// --- Werewolf skins (merged player rig) ---
WEREWOLF_SKIN_NAME :: "004RAND/werewolf";
WEREWOLF_NAME_INVIS_REASON :: "werewolf_transform";
WEREWOLF_WOLF_FORM_SPEED_MULTIPLIER :: 1.35;
WEREWOLF_HOWL_TOTAL_SECONDS :: 2.0;
WEREWOLF_HOWL_HALF_SECONDS :: WEREWOLF_HOWL_TOTAL_SECONDS * 0.5;
WEREWOLF_INFECTED_TRANSFORM_TOTAL_SECONDS :: 2.0;
WEREWOLF_INFECTED_TRANSFORM_HALF_SECONDS :: WEREWOLF_INFECTED_TRANSFORM_TOTAL_SECONDS * 0.5;

rr_player_set_skin_enabled :: proc(player: Player, skin: string, enabled: bool) {
	if player == null return;
	if player.animator == null return;
	if player.animator.instance == null return;
	if skin.count <= 0 return;

	// Rebuild skin list without clobbering the rest of the cosmetics.
	skins := player.animator.instance->get_skins();
	player.animator.instance->disable_all_skins();

	found := false;
	for i: 0..skins.count-1 {
		s := skins[i];
		if s == skin {
			found = true;
			// Skip here; we'll add it back once if enabled.
			continue;
		}
		player.animator.instance->enable_skin(s);
	}
	if enabled {
		player.animator.instance->enable_skin(skin);
	}
	// If skin wasn't previously present and enabled=false, nothing to do beyond rebuild.
	player.animator.instance->refresh_skins();
}

rr_player_has_skin :: proc(player: Player, skin: string) -> bool {
	if player == null return false;
	if player.animator == null return false;
	if player.animator.instance == null return false;
	if skin.count <= 0 return false;
	skins := player.animator.instance->get_skins();
	for i: 0..skins.count-1 {
		if skins[i] == skin return true;
	}
	return false;
}

rr_werewolf_capture_round_start_look :: proc(player: Player) {
	if player == null return;
	if player.animator == null return;
	if player.animator.instance == null return;

	player.werewolf_round_start_cosmetic_skins->clear();
	skins := player.animator.instance->get_skins();
	for i: 0..skins.count-1 {
		if skins[i] != WEREWOLF_SKIN_NAME {
			player.werewolf_round_start_cosmetic_skins->append(skins[i]);
		}
	}
	player.werewolf_round_start_avatar_color = player.avatar_color;
}

// Enables the full werewolf look: saves current cosmetic skins, strips them, enables only the
// werewolf skin, and forces dark brown color.
rr_werewolf_enable_wolf_look :: proc(player: Player) {
	if player == null return;
	if player.animator == null return;
	if player.animator.instance == null return;
	// Idempotence guard: avoid clobbering the saved skin snapshot if a stale schedule
	// causes enable to run again while wolf look is already active.
	if player.werewolf_skin_active return;

	// Save current skins so we can restore later.
	player.werewolf_saved_cosmetic_skins->clear();
	skins := player.animator.instance->get_skins();
	for i: 0..skins.count-1 {
		if skins[i] != WEREWOLF_SKIN_NAME {
			player.werewolf_saved_cosmetic_skins->append(skins[i]);
		}
	}
	player.werewolf_saved_avatar_color = player.avatar_color;

	// Extra safety: refresh our long-lived fallback baseline whenever we enter
	// werewolf look from a valid non-werewolf snapshot.
	if player.werewolf_saved_cosmetic_skins.count > 0 {
		player.werewolf_round_start_cosmetic_skins->clear();
		for i: 0..player.werewolf_saved_cosmetic_skins.count-1 {
			player.werewolf_round_start_cosmetic_skins->append(player.werewolf_saved_cosmetic_skins[i]);
		}
		player.werewolf_round_start_avatar_color = player.werewolf_saved_avatar_color;
	}

	// Strip all skins and enable only the werewolf skin.
	player.animator.instance->disable_all_skins();
	player.animator.instance->enable_skin(WEREWOLF_SKIN_NAME);
	player.animator.instance->refresh_skins();

	// Force dark color (server-only so it replicates to all clients).
	if Game.is_server() {
		player.animator.instance->set_color_replace_color(Color_Replace_Color.BLACK);
	}

	// Hide the player's name tag while in wolf form.
	player->add_name_invisibility_reason(WEREWOLF_NAME_INVIS_REASON);

	player.werewolf_skin_active = true;
}

// Restores the player's original cosmetic skins and avatar color after wolf form ends.
rr_werewolf_disable_wolf_look :: proc(player: Player) {
	if player == null return;
	if player.animator == null return;
	if player.animator.instance == null return;

	// Safety: if wolf look was never enabled, don't strip skins (nothing to restore from).
	if !player.werewolf_skin_active return;

	// Disable werewolf skin and restore saved cosmetics.
	// Safety: if the per-transform snapshot is unexpectedly empty, fall back to the
	// round-start baseline captured at game start.
	if player.werewolf_saved_cosmetic_skins.count > 0 {
		player.animator.instance->disable_all_skins();
		for i: 0..player.werewolf_saved_cosmetic_skins.count-1 {
			player.animator.instance->enable_skin(player.werewolf_saved_cosmetic_skins[i]);
		}
		player.animator.instance->refresh_skins();
	} else if player.werewolf_round_start_cosmetic_skins.count > 0 {
		player.animator.instance->disable_all_skins();
		for i: 0..player.werewolf_round_start_cosmetic_skins.count-1 {
			player.animator.instance->enable_skin(player.werewolf_round_start_cosmetic_skins[i]);
		}
		player.animator.instance->refresh_skins();
	} else {
		log_warning("rr_werewolf_disable_wolf_look: missing both saved and round-start cosmetic snapshots for player %.", {player.entity.id});
	}

	// Restore original avatar color (server-only so it replicates to all clients).
	if Game.is_server() {
		restore_color := player.werewolf_saved_avatar_color;
		if player.werewolf_saved_cosmetic_skins.count <= 0 {
			restore_color = player.werewolf_round_start_avatar_color;
		}
		player.animator.instance->set_color_replace_color(restore_color);
	}

	// Restore name tag visibility.
	player->remove_name_invisibility_reason(WEREWOLF_NAME_INVIS_REASON);

	player.werewolf_skin_active = false;
	player.werewolf_saved_cosmetic_skins->clear();
}

rr_werewolf_should_look_werewolf :: proc(player: Player) -> bool {
	if player == null return false;
	if player.entity == null return false;
	if !#alive(player.entity) return false;
	if player.player_state != Player_State.ALIVE return false;
	// Infected players look werewolf only during gameplay (revert to human during meetings).
	if player.werewolf_infected && game_state == Game_State.INGAME return true;
	// Werewolf player looks werewolf only during wolf form while in game.
	if player.player_role == Player_Role.WEREWOLF && player.player_type == Player_Type.TRAITOR && game_state == Game_State.INGAME {
		wm := player.entity->get_component(Werewolf_Module);
		if wm != null return wm.is_wolf_form;
	}
	return false;
}

rr_werewolf_update_skins :: proc(player: Player) {
	if player == null return;
	if player.entity == null return;
	if !#alive(player.entity) return;

	now := get_time();

	// Process delayed infected-transform animation trigger.
	// This is the moment the infection "reveals" — everything before this is invisible.
	if player.werewolf_infected_transform_trigger_at > 0.0 && now >= player.werewolf_infected_transform_trigger_at {
		player.werewolf_infected_transform_trigger_at = 0.0;
		player->set_trigger("werewolf_infected_transform");

		// Server-authoritative: apply all the reveal effects now (notification, task swap, stun).
		if Game.is_server() {
			player->Notify("You were bitten! Pass it on to return to normal.");
			rr_werewolf_apply_infected_task_override(player);

			stun := player.entity->get_component(Werewolf_Infection_Stun);
			if stun == null {
				stun = player.entity->add_component(Werewolf_Infection_Stun);
			}
			stun->arm(WEREWOLF_INFECTION_STUN_SECONDS);
		}
	}

	// Hard-forces back to schleem look if we're not supposed to be werewolf-looking.
	if !rr_werewolf_should_look_werewolf(player) {
		player.werewolf_skin_enable_at = 0.0;
		player.werewolf_skin_disable_at = 0.0;
		player.werewolf_infected_transform_trigger_at = 0.0;
		if player.werewolf_skin_active {
			rr_werewolf_disable_wolf_look(player);
		}
		// Always clear name invisibility even if skin wasn't active (safety for lobby/reset).
		player->remove_name_invisibility_reason(WEREWOLF_NAME_INVIS_REASON);
		return;
	}

	// Process scheduled disable first (explicit "back to schleem immediately").
	if player.werewolf_skin_disable_at > 0.0 && now >= player.werewolf_skin_disable_at {
		player.werewolf_skin_disable_at = 0.0;
		player.werewolf_skin_enable_at = 0.0;
		rr_werewolf_disable_wolf_look(player);
		return;
	}

	// Process scheduled enable (strips cosmetics, forces dark brown + werewolf-only skin).
	if player.werewolf_skin_enable_at > 0.0 && now >= player.werewolf_skin_enable_at {
		player.werewolf_skin_enable_at = 0.0;
		rr_werewolf_enable_wolf_look(player);
	}

	// Safety: if we should look werewolf but no enable is pending and skin isn't on, force it on.
	if player.werewolf_skin_enable_at <= 0.0 && !player.werewolf_skin_active {
		rr_werewolf_enable_wolf_look(player);
	}
}

rr_werewolf_update_transform :: proc(player: Player, dt: float) {
	if player == null return;
	now := get_time();

	// Non-werewolf: just manage skin schedules for infected civilians.
	if player.player_role != Player_Role.WEREWOLF || player.player_type != Player_Type.TRAITOR {
		if !player.werewolf_infected {
			player.werewolf_skin_enable_at = 0.0;
			player.werewolf_skin_disable_at = now;
		}
		return;
	}

	wm := player.entity->get_component(Werewolf_Module);
	if wm == null return;

	prev_is_wolf := wm.is_wolf_form;

	// Dead werewolves revert.
	if player.player_state != Player_State.ALIVE {
		if prev_is_wolf {
			player->set_trigger("RESET");
		}
		wm.is_wolf_form = false;
		wm.transform_ends_at = 0.0;
		player.werewolf_skin_enable_at = 0.0;
		player.werewolf_skin_disable_at = now;
		return;
	}

	// Meetings / cutscenes: force schleem form and cancel transform.
	if game_state != Game_State.INGAME {
		if prev_is_wolf {
			player->set_trigger("RESET");
		}
		wm.is_wolf_form = false;
		wm.transform_ends_at = 0.0;
		player.werewolf_skin_enable_at = 0.0;
		player.werewolf_skin_disable_at = now;
		return;
	}

	// Check if wolf form duration expired.
	if wm.is_wolf_form && wm.transform_ends_at > 0.0 && now >= wm.transform_ends_at {
		wm.is_wolf_form = false;
		wm.transform_ends_at = 0.0;
		player->set_trigger("RESET");
		player.werewolf_skin_enable_at = 0.0;
		player.werewolf_skin_disable_at = now;
	}

	// Speed boost: apply on enter, remove on exit.
	if wm.is_wolf_form && !wm.speed_boost_active {
		wm.speed_original = player.agent.movement_speed;
		wm.speed_boost_active = true;
		player.agent.movement_speed = wm.speed_original * WEREWOLF_WOLF_FORM_SPEED_MULTIPLIER;
	} else if !wm.is_wolf_form && wm.speed_boost_active {
		player.agent.movement_speed = wm.speed_original;
		wm.speed_boost_active = false;
	}
}

    revive :: proc(using this: Player) {
        //freeze_player = false;
        this->set_trigger("RESET");
    }

	// Immediately restores werewolf visuals + clears all skin/transform state.
	// Safe to call even if the player is not in wolf form (no-ops if skin not active).
	reset_werewolf_visuals :: proc(using this: Player) {
		rr_werewolf_disable_wolf_look(this);
		this->remove_name_invisibility_reason(WEREWOLF_NAME_INVIS_REASON);
		this.werewolf_infected = false;
		this.werewolf_infected_from_id = 0;
		this.werewolf_skin_enable_at = 0.0;
		this.werewolf_skin_disable_at = 0.0;
		this.werewolf_infected_transform_trigger_at = 0.0;
		wm := this.entity->get_component(Werewolf_Module);
		if wm != null {
			wm.is_wolf_form = false;
			wm.transform_ends_at = 0.0;
			if wm.speed_boost_active {
				this.agent.movement_speed = wm.speed_original;
				wm.speed_boost_active = false;
			}
		}
	}

	capture_werewolf_round_start_look :: proc(using this: Player) {
		rr_werewolf_capture_round_start_look(this);
	}

    set_trigger :: proc(using this: Player, trigger: string) {
        if this.animator.instance != null {
            this.animator.instance.state_machine->set_trigger(trigger);
        }
    }

	// Adds the animation state machine.
	ensure_anim_state_machine :: proc(using this: Player) {
		if sm_inited {
			return;
		}
		if this.animator.instance == null {
            log_error("No animator instance found");
			return;
		}
		sm := this.animator.instance.state_machine;
		if sm == null {
            log_error("No state machine found");
			return;
		}

		layer := sm->try_get_layer("main");
		if layer == null {
			log_error("No 'main' state machine layer found");
			return;
		}
        idle_state := layer->try_get_state("Idle");
		if idle_state == null {
			log_error("No 'Idle' state found on 'main' layer");
			return;
		}

		// prank_slip (trigger var -> one-shot anim state -> back to Idle)
		prank_slip_var := sm->create_variable("prank_slip", State_Machine_Variable.Kind.TRIGGER);
		prank_slip_state := layer->create_state("004RAND_trickster/Slip_On_Banana", false, 2.0);
		layer->create_global_transition(prank_slip_state, false)->create_trigger_condition(prank_slip_var);
		layer->create_transition(prank_slip_state, idle_state, true);

		// jester_win (trigger var -> end-game anim state -> back to Idle)
		jester_win_var := sm->create_variable("jester_win", State_Machine_Variable.Kind.TRIGGER);
		jester_win_state := layer->create_state("004RAND_trickster/Trickster_End_Game", false, 5.0);
		layer->create_global_transition(jester_win_state, false)->create_trigger_condition(jester_win_var);
		layer->create_transition(jester_win_state, idle_state, true);

		// vote_eject (trigger var -> one-shot anim state -> back to Idle)
		vote_eject_var := sm->create_variable("death_vote2", State_Machine_Variable.Kind.TRIGGER);
		vote_eject_state := layer->create_state("004RAND/death_vote2", false, RR_VOTE_EJECT_ANIM_SECONDS);
		layer->create_global_transition(vote_eject_state, false)->create_trigger_condition(vote_eject_var);
		layer->create_transition(vote_eject_state, idle_state, true);

		// --- Movie Star ---
		// write_place_autograph (trigger var -> one-shot anim state -> back to Idle)
		write_autograph_var := sm->create_variable("write_place_autograph", State_Machine_Variable.Kind.TRIGGER);
		write_autograph_state := layer->create_state("004RAND_movie_star/Write_Place_Autograph", false, 2.1);
		layer->create_global_transition(write_autograph_state, false)->create_trigger_condition(write_autograph_var);
		layer->create_transition(write_autograph_state, idle_state, true);

		// stunned_by_autograph_loop (trigger var -> looping anim state -> back to Idle)
		stunned_autograph_var := sm->create_variable("stunned_by_autograph_loop", State_Machine_Variable.Kind.TRIGGER);
		stunned_autograph_state := layer->create_state("004RAND_movie_star/stunned_by_autograph_loop", true, 15.0);
		layer->create_global_transition(stunned_autograph_state, false)->create_trigger_condition(stunned_autograph_var);
		// This is a loop; exit via RESET (or another explicit transition), not state completion.

		// --- Hitman ---
		// Neck snap (killer animation)
		hitman_kill_snap_neck_var := sm->create_variable("hitman_kill_snap_neck", State_Machine_Variable.Kind.TRIGGER);
		// Keep this short so the hitman regains control right as the animation ends.
		hitman_kill_snap_neck_state := layer->create_state("004RAND_hitman/Kill_Snap_Neck", false, 1.1);
		layer->create_global_transition(hitman_kill_snap_neck_state, false)->create_trigger_condition(hitman_kill_snap_neck_var);
		layer->create_transition(hitman_kill_snap_neck_state, idle_state, true);

		// Sniper (killer animation)
		hitman_shoot_sniper_var := sm->create_variable("hitman_shoot_sniper", State_Machine_Variable.Kind.TRIGGER);
		hitman_shoot_sniper_state := layer->create_state("004RAND_hitman/Shoot_Sniper", false, 0.9);
		layer->create_global_transition(hitman_shoot_sniper_state, false)->create_trigger_condition(hitman_shoot_sniper_var);
		layer->create_transition(hitman_shoot_sniper_state, idle_state, true);

		// Mine victim (fly -> collide -> broken leg idle while stunned)
		hitman_fly_forward_var := sm->create_variable("hitman_fly_forward", State_Machine_Variable.Kind.TRIGGER);
		// Loop while the fling component is active; we explicitly transition via collide + RESET.
		hitman_fly_forward_state := layer->create_state("004RAND_hitman/Fly_Forward_Loop", true, 0.0);
		layer->create_global_transition(hitman_fly_forward_state, false)->create_trigger_condition(hitman_fly_forward_var);

		hitman_collide_midair_land_var := sm->create_variable("hitman_collide_midair_land", State_Machine_Variable.Kind.TRIGGER);
		hitman_collide_midair_land_state := layer->create_state("004RAND_hitman/Collide_Midair_Land", false, 0.8);
		layer->create_global_transition(hitman_collide_midair_land_state, false)->create_trigger_condition(hitman_collide_midair_land_var);
		layer->create_transition(hitman_collide_midair_land_state, idle_state, true);

		hitman_broken_leg_idle_var := sm->create_variable("hitman_broken_leg_idle", State_Machine_Variable.Kind.TRIGGER);
		hitman_broken_leg_idle_state := layer->create_state("004RAND_hitman/Broken_Leg_Idle", true, 10.0);
		layer->create_global_transition(hitman_broken_leg_idle_state, false)->create_trigger_condition(hitman_broken_leg_idle_var);
		// This is a loop; we exit it via the existing RESET trigger (fired when stun ends).

		// --- Werewolf ---
		// werewolf_howl (trigger -> one-shot -> back to Idle)
		werewolf_howl_var := sm->create_variable("werewolf_howl", State_Machine_Variable.Kind.TRIGGER);
		werewolf_howl_state := layer->create_state("004RAND_werewolf/howl", false, 2.0);
		layer->create_global_transition(werewolf_howl_state, false)->create_trigger_condition(werewolf_howl_var);
		layer->create_transition(werewolf_howl_state, idle_state, true);

		// werewolf_infection_bite (attacker one-shot -> back to Idle)
		werewolf_infection_bite_var := sm->create_variable("werewolf_infection_bite", State_Machine_Variable.Kind.TRIGGER);
		werewolf_infection_bite_state := layer->create_state("004RAND_werewolf/Infection_Bite", false, 1.2);
		layer->create_global_transition(werewolf_infection_bite_state, false)->create_trigger_condition(werewolf_infection_bite_var);
		layer->create_transition(werewolf_infection_bite_state, idle_state, true);

		// werewolf_infected_transform (victim one-shot -> back to Idle)
		werewolf_infected_transform_var := sm->create_variable("werewolf_infected_transform", State_Machine_Variable.Kind.TRIGGER);
		werewolf_infected_transform_state := layer->create_state("004RAND_werewolf/Infected_Bitten_Transform", false, 2.0);
		layer->create_global_transition(werewolf_infected_transform_state, false)->create_trigger_condition(werewolf_infected_transform_var);
		layer->create_transition(werewolf_infected_transform_state, idle_state, true);

		// --- Pyromaniac ---
		// Snap fingers (one-shot) for Light Fire.
		pyro_snap_fingers_var := sm->create_variable("pyro_snap_fingers", State_Machine_Variable.Kind.TRIGGER);
		pyro_snap_fingers_state := layer->create_state("004RAND_pyromaniac/Snap_Fingers", false, 1.0);
		layer->create_global_transition(pyro_snap_fingers_state, false)->create_trigger_condition(pyro_snap_fingers_var);
		layer->create_transition(pyro_snap_fingers_state, idle_state, true);

		// On-fire idle loop (explicitly entered; exits via RESET or Blow_Out_Fire).
		pyro_on_fire_idle_var := sm->create_variable("pyro_on_fire_idle", State_Machine_Variable.Kind.TRIGGER);
		pyro_on_fire_idle_state := layer->create_state("004RAND_pyromaniac/Idle_On_Fire", true, 0.0);
		layer->create_global_transition(pyro_on_fire_idle_state, false)->create_trigger_condition(pyro_on_fire_idle_var);

		// Extinguish (one-shot) -> back to normal Idle.
		pyro_blow_out_fire_var := sm->create_variable("pyro_blow_out_fire", State_Machine_Variable.Kind.TRIGGER);
		pyro_blow_out_fire_state := layer->create_state("004RAND_pyromaniac/Blow_Out_Fire", false, 1.0);
		layer->create_global_transition(pyro_blow_out_fire_state, false)->create_trigger_condition(pyro_blow_out_fire_var);
		layer->create_transition(pyro_blow_out_fire_state, idle_state, true);

		// End-game (one-shot) -> back to Idle.
		pyro_end_game_var := sm->create_variable("pyro_end_game", State_Machine_Variable.Kind.TRIGGER);
		pyro_end_game_state := layer->create_state("004RAND_pyromaniac/End_Game", false, 5.0);
		layer->create_global_transition(pyro_end_game_state, false)->create_trigger_condition(pyro_end_game_var);
		layer->create_transition(pyro_end_game_state, idle_state, true);

		// --- Pirate ---
		// Dig for treasure (one-shot) -> back to normal Idle.
		pirate_dig_for_treasure_var := sm->create_variable("pirate_dig_for_treasure", State_Machine_Variable.Kind.TRIGGER);
		pirate_dig_for_treasure_state := layer->create_state("004RAND_pirate/dig_for_treasure", false, 2.0);
		layer->create_global_transition(pirate_dig_for_treasure_state, false)->create_trigger_condition(pirate_dig_for_treasure_var);
		layer->create_transition(pirate_dig_for_treasure_state, idle_state, true);

		// --- Goo Goo Gaga (player rig only; creature rig uses direct set_animation) ---
		// Transform into creature (one-shot, 2s) -> back to Idle (skeleton swap happens during anim).
		ggg_transform_var := sm->create_variable("ggg_transform", State_Machine_Variable.Kind.TRIGGER);
		ggg_transform_state := layer->create_state("004RAND_GOOGOOGAGA/Transform_Monster_Start", false, 2.0);
		layer->create_global_transition(ggg_transform_state, false)->create_trigger_condition(ggg_transform_var);
		layer->create_transition(ggg_transform_state, idle_state, true);

		// Revert from creature (one-shot, 1s) -> back to Idle.
		ggg_revert_var := sm->create_variable("ggg_revert", State_Machine_Variable.Kind.TRIGGER);
		ggg_revert_state := layer->create_state("004RAND_GOOGOOGAGA/Transform_Player_End", false, 1.0);
		layer->create_global_transition(ggg_revert_state, false)->create_trigger_condition(ggg_revert_var);
		layer->create_transition(ggg_revert_state, idle_state, true);

		// Tinfoil trap: start (one-shot, 0.5s) -> loop (exits via ggg_trapped_end trigger).
		ggg_trapped_start_var := sm->create_variable("ggg_trapped_start", State_Machine_Variable.Kind.TRIGGER);
		ggg_trapped_start_state := layer->create_state("004RAND_GOOGOOGAGA/Tinfoil_Trapped_Start", false, 0.5);
		layer->create_global_transition(ggg_trapped_start_state, false)->create_trigger_condition(ggg_trapped_start_var);

		ggg_trapped_loop_state := layer->create_state("004RAND_GOOGOOGAGA/Tinfoil_Trapped_Loop", true, 0.0);
		layer->create_transition(ggg_trapped_start_state, ggg_trapped_loop_state, true);

		// Tinfoil trap end (one-shot, 0.5s) -> back to Idle.
		ggg_trapped_end_var := sm->create_variable("ggg_trapped_end", State_Machine_Variable.Kind.TRIGGER);
		ggg_trapped_end_state := layer->create_state("004RAND_GOOGOOGAGA/Tinfoil_Trapped_End", false, 0.5);
		layer->create_global_transition(ggg_trapped_end_state, false)->create_trigger_condition(ggg_trapped_end_var);
		layer->create_transition(ggg_trapped_end_state, idle_state, true);

		// --- Drag Body (traitor utility) ---
		// Inject drag locomotion states; driven by bools set in `Drag_Body_Ability`.
		drag_enabled_var := sm->create_variable("drag_body_enabled", State_Machine_Variable.Kind.BOOL);
		drag_moving_var := sm->create_variable("drag_body_moving", State_Machine_Variable.Kind.BOOL);
		drag_right_var := sm->create_variable("drag_body_right", State_Machine_Variable.Kind.BOOL);

		drag_idle_left := layer->create_state("004RAND/drag_body_idle", true, 0.0);
		drag_idle_right := layer->create_state("004RAND/drag_body_idle_right", true, 0.0);
		drag_walk_left := layer->create_state("004RAND/drag_body_walk", true, 0.0);
		drag_walk_right := layer->create_state("004RAND/drag_body_walk_right", true, 0.0);

		// Mutually-exclusive global transitions (enter drag states).
		to_drag_idle_left := layer->create_global_transition(drag_idle_left, false);
		to_drag_idle_left->create_bool_condition(drag_enabled_var, true);
		to_drag_idle_left->create_bool_condition(drag_moving_var, false);
		to_drag_idle_left->create_bool_condition(drag_right_var, false);

		to_drag_idle_right := layer->create_global_transition(drag_idle_right, false);
		to_drag_idle_right->create_bool_condition(drag_enabled_var, true);
		to_drag_idle_right->create_bool_condition(drag_moving_var, false);
		to_drag_idle_right->create_bool_condition(drag_right_var, true);

		to_drag_walk_left := layer->create_global_transition(drag_walk_left, false);
		to_drag_walk_left->create_bool_condition(drag_enabled_var, true);
		to_drag_walk_left->create_bool_condition(drag_moving_var, true);
		to_drag_walk_left->create_bool_condition(drag_right_var, false);

		to_drag_walk_right := layer->create_global_transition(drag_walk_right, false);
		to_drag_walk_right->create_bool_condition(drag_enabled_var, true);
		to_drag_walk_right->create_bool_condition(drag_moving_var, true);
		to_drag_walk_right->create_bool_condition(drag_right_var, true);

		// Exit transitions: return to idle when drag ends.
		exit_drag_idle_left := layer->create_transition(drag_idle_left, idle_state, false);
		exit_drag_idle_left->create_bool_condition(drag_enabled_var, false);

		exit_drag_idle_right := layer->create_transition(drag_idle_right, idle_state, false);
		exit_drag_idle_right->create_bool_condition(drag_enabled_var, false);

		exit_drag_walk_left := layer->create_transition(drag_walk_left, idle_state, false);
		exit_drag_walk_left->create_bool_condition(drag_enabled_var, false);

		exit_drag_walk_right := layer->create_transition(drag_walk_right, idle_state, false);
		exit_drag_walk_right->create_bool_condition(drag_enabled_var, false);

		sm_inited = true;
        log_info("State machine initialized");
	}

	draw_letterbox_bars :: proc(using this: Player) {
		screen := UI.get_screen_rect();
		bg := get_asset(Texture_Asset, "$AO/white.png");
		UI.push_layer(2000);
		defer UI.pop_layer();
		UI.quad(screen->subrect(0.0, 0.85, 1.0, 1.0), bg, .{0, 0, 0, 1});
		UI.quad(screen->subrect(0.0, 0.0, 1.0, 0.15), bg, .{0, 0, 0, 1});
	}

	draw_vote_eject_cinematic_ui :: proc(using this: Player) {
		if rr_vote_eject_start_time <= 0.0 return;
		elapsed := get_time() - rr_vote_eject_start_time;
		if elapsed > RR_VOTE_EJECT_TEXT_SECONDS return;

		screen := UI.get_safe_screen_rect();
		UI.push_layer(20010);
		defer UI.pop_layer();

		panel_rect := screen->center_rect()->grow(90, 320, 90, 320);
		rr_ui_draw_modal_panel(panel_rect);

		name := "Someone";
		target := get_player_by_entity_id(rr_vote_eject_player_id);
		if target != null {
			name = target.entity->get_name();
		}
		message := format_string("% got voted out", .{name});

		ts := UI.default_text_settings();
		ts.size = 52;
		ts.color = v4.{1, 1, 1, 1};
		ts.halign = .CENTER;
		ts.valign = .CENTER;
		ts.do_outline = true;
		ts.outline_thickness = 3;
		ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(panel_rect->inset(18), ts, message);
	}

	try_focus_camera_on_jester :: proc(using this: Player) {
		// Deprecated: replaced by `try_begin_jester_win_camera_override` which avoids
		// per-frame camera position writes.
	}

	try_begin_jester_win_camera_override :: proc(using this: Player) -> bool {
		// Supports both Jester and Pyro win cinematics.
		target_id: u64 = 0;
		if game_state == Game_State.ANIM_JESTER_WIN {
			target_id = jester_win_player_id;
		} else if game_state == Game_State.ANIM_PYRO_WIN {
			target_id = pyro_win_player_id;
		}
		if target_id == 0 {
			return false;
		}
		for i: 0..players.elements.count-1 {
			p := players.elements[i];
			if p != null && #alive(p.entity) && p.entity.id == target_id {
				// Force the cinematic actor to face right and lock the camera once.
				p->set_facing_right(true);
				this.camera.follow_player = false;
				this.camera.position = p.entity.world_position;
				return true;
			}
		}
		return false;
	}
}

rr_drag_body_force_drop_for_player :: proc(player: Player) {
	if player == null return;
	if player.dragging_corpse_entity_id == 0 return;

	// Clear corpse ownership if it still exists.
	foreach corpse: component_iterator(Corpse) {
		if corpse == null continue;
		if !#alive(corpse.entity) continue;
		if corpse.entity.id != player.dragging_corpse_entity_id continue;
		if corpse.dragged_by_player_entity_id == player.entity.id {
			corpse.dragged_by_player_entity_id = 0;
		}
		break;
	}

	player.dragging_corpse_entity_id = 0;
	// Stop loop SFX if active.
	if Game.is_server() && player.drag_body_sfx_id != 0 {
		SFX.stop(player.drag_body_sfx_id);
		player.drag_body_sfx_id = 0;
	}
	// Ensure we snap back to base locomotion immediately.
	player->set_trigger("RESET");
}

rr_drag_body_update_anim_state :: proc(player: Player, dt: float) {
	if player == null return;
	if player.animator == null || player.animator.instance == null || player.animator.instance.state_machine == null {
		return;
	}
	if player.agent == null return;

	dragging := player.dragging_corpse_entity_id != 0;
	moving := false;
	// Use facing from scale sign (positive = right, negative = left).
	desired_right := player.drag_body_is_right;
	scale_x := player.entity.world_scale.x;
	if abs(scale_x) > 0.0001 {
		desired_right = scale_x > 0.0;
	}

	// Movement detection from position delta.
	pos := player.entity.world_position;
	if player.drag_body_last_pos_inited {
		delta := pos - player.drag_body_last_pos;
		if dragging {
			moving = abs(delta.x) > 0.01 || abs(delta.y) > 0.01;
		}
	} else {
		player.drag_body_last_pos_inited = true;
	}
	player.drag_body_last_pos = pos;

	// Apply 50% movement speed while dragging.
	if dragging {
		if !player.drag_body_speed_active {
			player.drag_body_speed_original = player.agent.movement_speed;
			player.drag_body_speed_active = true;
		}
		player.agent.movement_speed = player.drag_body_speed_original * 0.5;
	} else if player.drag_body_speed_active {
		player.agent.movement_speed = player.drag_body_speed_original;
		player.drag_body_speed_active = false;
	}

	// Server-authoritative side used by corpse follow.
	if Game.is_server() {
		player.drag_body_is_right = desired_right;
	}

	// Update state machine bools BEFORE firing RESET so the exit transitions
	// (drag_body_enabled == false) are already active when the state machine evaluates.
	player.animator.instance.state_machine->set_bool("drag_body_enabled", dragging);
	player.animator.instance.state_machine->set_bool("drag_body_moving", moving);
	player.animator.instance.state_machine->set_bool("drag_body_right", true);

	// If drag just ended, reset to base locomotion state.
	if player.drag_body_was_dragging && !dragging {
		player->set_trigger("RESET");
	}
	player.drag_body_was_dragging = dragging;
}

Task_Interactable :: class : Component {
    interactable: Interactable @ao_serialize;
	// Optional override so runtime-spawned interactables can use the task system
	// without relying on the entity name.
	task_id_override: string @ao_serialize;

	get_task_id :: proc(using this: Task_Interactable) -> string {
		if task_id_override.count > 0 {
			return task_id_override;
		}
		return this.entity->get_name();
	}

    ao_start :: proc(using this: Task_Interactable) {
		if interactable == null {
			return;
		}
        interactable->set_listener(this);

		// Register this interactable's world position as a destination for its task id.
		rr_register_task_destination(this->get_task_id(), this.entity.world_position);
    }

    on_interact :: proc(using this: Task_Interactable, player: Player) {
		task_id := this->get_task_id();
        for i: 0..player.active_tasks.elements.count-1 {
            task := player.active_tasks.elements[i];
            if task.id == task_id && !task.started && !task.completed {
                task->start_attempt(player);
                break;
            }
        }
    }

    can_use :: proc(using this: Task_Interactable, player: Player) -> bool {
		task_id := this->get_task_id();

		// Mini-werewolf infection blocks normal task completion until cured.
		if player != null && player.werewolf_infected {
			return false;
		}

		// During power outage, allow non-traitors to complete the generator task.
		if task_id == RR_RESTART_GENERATOR_TASK_ID {
			if game_state != Game_State.INGAME return false;
			if !rr_power_outage_active return false;
			if player == null return false;
			if player.player_state != Player_State.ALIVE return false;
			// Traitors should not be able to fix sabotages.
			if player.player_type == Player_Type.TRAITOR return false;
			// Temporarily resurrected players can move/talk, but cannot do tasks.
			if player.is_temporarily_resurrected return false;

			for i: 0..player.active_tasks.elements.count-1 {
				task := player.active_tasks.elements[i];
				if task.id == task_id && !task.started && !task.completed {
					return true;
				}
			}
			return false;
		}

		// During comms outage, allow non-traitors to complete the comms restore task.
		if task_id == RR_ENABLE_COMMUNICATIONS_TASK_ID {
			if game_state != Game_State.INGAME return false;
			if !rr_comms_outage_active return false;
			if player == null return false;
			if player.player_state != Player_State.ALIVE return false;
			// Traitors should not be able to fix sabotages.
			if player.player_type == Player_Type.TRAITOR return false;
			// Temporarily resurrected players can move/talk, but cannot do tasks.
			if player.is_temporarily_resurrected return false;

			for i: 0..player.active_tasks.elements.count-1 {
				task := player.active_tasks.elements[i];
				if task.id == task_id && !task.started && !task.completed {
					return true;
				}
			}
			return false;
		}

		can_do_tasks := player.player_state == Player_State.ALIVE || player.player_state == Player_State.DEAD;
        can_use_base := can_do_tasks && player.player_type == Player_Type.CIVILIAN;
        if !can_use_base {
            return false;
        }
		// Temporarily resurrected players can move/talk, but cannot do tasks.
		if player.is_temporarily_resurrected {
			return false;
		}
        for i: 0..player.active_tasks.elements.count-1 {
            task := player.active_tasks.elements[i];
            if task.id == task_id && !task.started && !task.completed {
                return true;
            }
        }
        return false;
    }
}

Call_Meeting_Interactable :: class : Component {
    interactable: Interactable @ao_serialize;
    
    ao_start :: proc(using this: Call_Meeting_Interactable) {
        interactable->set_listener(this);
    }

    ao_update :: proc(using this: Call_Meeting_Interactable, dt: float) {
        now := get_time();
        if now < meeting_cooldown_ends_at {
            remaining := (meeting_cooldown_ends_at - now).(int) + 1;
            interactable->set_text(format_string("Call Meeting (%s)", {remaining}));
        } else {
            interactable->set_text("Call Meeting");
        }
    }

    on_interact :: proc(using this: Call_Meeting_Interactable, player: Player) {
        // Block interaction while on cooldown.
        if get_time() < meeting_cooldown_ends_at return;
		// Block meetings while any sabotage is active.
		if rr_power_outage_active || rr_comms_outage_active || rr_lockdown_active {
			player->Notify("Can't call a meeting during a sabotage!");
			return;
		}
        start_meeting(false, player);
    }

    can_use :: proc(using this: Call_Meeting_Interactable, player: Player) -> bool {
        if player.player_state != Player_State.ALIVE return false;
		// Temporarily resurrected players should not be able to call meetings.
		if player.is_temporarily_resurrected return false;
		// Infected players should not be able to call meetings.
		if player.werewolf_infected return false;
		// Disable when any sabotage is active.
		if rr_power_outage_active || rr_comms_outage_active || rr_lockdown_active return false;
        // Always show the interactable; cooldown text + on_interact guard handle the rest.
        return true;
    }
}

// Spawned on corpse entities so reporting is an in-world interaction, not an ability.
Report_Corpse_Interactable :: class : Interactable {
	ao_start :: method() {
		this->set_listener(this);
		this->set_text("Report");
		this->set_hold_text("Reporting...");
		// Match the old report ability's feel (range ~5m, but prompt shouldn't be huge).
		radius = 3.0;
		prompt_offset = v2.{0, 1.0};
		required_hold_time = 0.0;
		priority = 50;
	}

	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if game_state != Game_State.INGAME return false;
		// Only alive players can report bodies.
		if player.player_state != Player_State.ALIVE return false;
		// Infected players cannot report bodies (they can't call meetings).
		if player.werewolf_infected return false;

		corpse := entity->get_component(Corpse);
		if corpse == null return false;

		// Wrapped corpses must be unwrapped before they can be reported.
		if corpse.ggg_is_wrapped return false;

		// Already-reported bodies should not show the report prompt at all.
		if corpse.has_been_reported return false;

		// If only 1 player is alive, don't allow reporting — the game should end naturally.
		alive_count := 0;
		for i: 0..players.elements.count-1 {
			p := players.elements[i];
			if p == null continue;
			if !#alive(p.entity) continue;
			if p.player_state == Player_State.ALIVE {
				alive_count += 1;
			}
		}
		if alive_count <= 1 return false;

		return true;
	}

	on_interact :: method(player: Player) {
		// If already reported, just notify the player and don't start a meeting.
		corpse := entity->get_component(Corpse);
		if corpse != null && corpse.has_been_reported {
			player->Notify("This body has already been reported.");
			return;
		}

		// Mark ALL existing corpses as reported so they can't trigger another meeting.
		foreach c: component_iterator(Corpse) {
			if c == null continue;
			if !#alive(c.entity) continue;
			c.has_been_reported = true;
		}
		// Body stays in the world after reporting (shows "Already reported" when approached).
		// Start the meeting.
		start_meeting(true, player);
	}
}

GGG_UNWRAP_HOLD_TIME :: 2.0;
GGG_UNWRAP_COOLDOWN :: 5.0;

Unwrap_Corpse_Interactable :: class : Interactable {
	cooldown_ends_at: float;

	ao_start :: method() {
		this->set_listener(this);
		this->set_text("Unwrap");
		this->set_hold_text("Unwrapping...");
		radius = 3.0;
		required_hold_time = GGG_UNWRAP_HOLD_TIME;
		prompt_offset = v2.{0, 1.0};
		priority = 60;
	}

	can_use :: method(player: Player) -> bool {
		if player == null return false;
		if game_state != Game_State.INGAME return false;
		if player.player_state != Player_State.ALIVE return false;
		if get_time() < cooldown_ends_at return false;
		corpse := entity->get_component(Corpse);
		if corpse == null return false;
		if !corpse.ggg_is_wrapped return false;
		if corpse.has_been_reported return false;
		return true;
	}

	on_interact :: method(player: Player) {
		corpse := entity->get_component(Corpse);
		if corpse == null return;
		corpse.ggg_is_wrapped = false;
		cooldown_ends_at = get_time() + GGG_UNWRAP_COOLDOWN;
	}
}

destroy_corpses_for_player :: proc(player_entity_id: u64) {
    corpses_to_destroy: List(Entity);
    foreach corpse: component_iterator(Corpse) {
        if corpse.owner_player_entity_id == player_entity_id {
            append(ref corpses_to_destroy, corpse.entity);
        }
    }

    for i: 0..corpses_to_destroy.elements.count-1 {
        e := corpses_to_destroy.elements[i];
        if #alive(e) {
            e->destroy();
        }
    }
}

Corpse :: class : Component {
    has_been_reported: bool;
    owner_player_entity_id: u64;
	// 0 means unknown / non-player source.
	killer_player_entity_id: u64;
	// Coroner can only sample once per corpse.
	has_dna_been_sampled: bool;
	// Pyromaniac can only burn once per corpse.
	pyro_has_been_burned: bool;
	// Pirate can only loot one treasure map per corpse.
	pirate_map_taken: bool;
	// GGG: true once the corpse has been wrapped in foil.
	ggg_is_wrapped: bool;

	// --- Drag Body ---
	// 0 = not being dragged; otherwise entity id of the dragging player.
	dragged_by_player_entity_id: u64;
	// Original death animation chosen at spawn (so we can restore after dragging).
	death_anim: string;

	// Local state (synced but small) used to avoid restarting animations every frame.
	last_dragged_by_player_entity_id: u64;

	ao_update :: method(dt: float) {
		if !#alive(entity) return;

		// Show "Already reported" world-space text when the local player is nearby.
		if has_been_reported {
			foreach p: component_iterator(Player) {
				if p == null continue;
				if !#alive(p.entity) continue;
				if !p->is_local() continue;
				if p.player_state != Player_State.ALIVE continue;

				dist := length(p.entity.world_position - entity.world_position);
				if dist < 3.0 {
					UI.push_world_draw_context();
					defer UI.pop_draw_context();

					text_pos := entity.world_position + v2.{0, 1.0};
					UI.push_z(text_pos.y);
					defer UI.pop_z();

					text_rect := Rect{text_pos, text_pos}->grow(0.15, 1.5, 0.15, 1.5);
					ts := UI.default_text_settings();
					ts.size = 0.30;
					ts.color = v4.{1.0, 0.85, 0.25, 1.0};
					ts.halign = .CENTER;
					ts.valign = .CENTER;
					ts.do_outline = true;
					ts.outline_thickness = 3;
					ts.outline_color = v4.{0, 0, 0, 1};
					UI.text(text_rect, ts, "Already reported");
				}
				break;
			}
		}

		spine := entity->get_component(Spine_Animator);
		if spine == null return;
		spine->awaken();
		if spine.instance == null return;

		// Detect drag state changes to avoid restarting the drag animation every frame.
		if dragged_by_player_entity_id != last_dragged_by_player_entity_id {
			if dragged_by_player_entity_id != 0 {
				// Dragging: play the dedicated drag-loop.
				spine.instance->set_animation("004RAND/dead_body_drag", true, 0);
			} else {
				// Dropped: restore the original corpse pose by fast-forwarding the death anim.
				restore := death_anim.count > 0 ? death_anim : "Death_No_HP";
				spine.instance->set_animation(restore, false, 0, 1000.0);
			}
			last_dragged_by_player_entity_id = dragged_by_player_entity_id;
		}

		// Follow with slight smoothing to avoid jitter.
		if dragged_by_player_entity_id != 0 {
			dragger := get_player_by_entity_id(dragged_by_player_entity_id);
			if dragger == null || !#alive(dragger.entity) {
				// Dragging player vanished; drop the corpse.
				dragged_by_player_entity_id = 0;
				return;
			}

			scale_x := dragger.entity.world_scale.x;
			// Keep corpse on the "grab side" (opposite facing).
			sign := scale_x >= 0.0 ? -1.0 : 1.0;
			target := dragger.entity.world_position + v2.{sign * DRAG_BODY_FOLLOW_DISTANCE, -0.15};
			cur := entity.world_position;
			alpha := clamp(dt * 6.0, 0.0, 1.0); // smoother follow (less jitter)
			new_pos := v2.{lerp(cur.x, target.x, alpha), lerp(cur.y, target.y, alpha)};

			entity->set_local_position(new_pos);
			entity->set_local_rotation(dragger.entity.world_rotation);
			// Flip corpse via scale instead of rotation.
			corpse_scale := dragger.entity.world_scale;
			corpse_scale.x = -corpse_scale.x;
			entity->set_local_scale(corpse_scale);
		}
	}
}

draw_minimap_close_button :: proc(window_rect: Rect) -> bool {
	// Size scales with the window so it stays readable across resolutions.
	size := window_rect->height() * 0.065;
	if size < 34.0 { size = 34.0; }
	if size > 78.0 { size = 78.0; }
	pad := size * 0.45;

	anchor := window_rect->top_right_rect()->offset_unscaled(-pad, -pad);
	btn := anchor->grow_unscaled(size * 0.5, size * 0.5, size * 0.5, size * 0.5);

	UI.push_id("minimap_close");
	defer UI.pop_id();

	btn_bs: Button_Settings = .{};
	rr_ui_apply_button_click_sound(ref btn_bs);
	interact := UI.button(btn, btn_bs, .{}, "");

	close_icon := get_asset(Texture_Asset, "sprites/icons/close_icon.png");
	if close_icon != null {
		// Icon is the button (no background). Draw it big.
		icon_rect := btn->inset(max(2.0, size * 0.06));
		UI.quad(icon_rect->fit_aspect(close_icon->get_aspect()), close_icon, v4.{1, 1, 1, 1});
	} else {
		ts := UI.default_text_settings();
		ts.size = size * 0.8;
		ts.color = v4.{1, 1, 1, 1};
		ts.halign = .CENTER;
		ts.valign = .CENTER;
		ts.do_outline = true;
		ts.outline_thickness = 2;
		ts.outline_color = v4.{0, 0, 0, 1};
		UI.text(btn, ts, "X");
	}

	return interact.clicked;
}

rr_rects_overlap :: proc(a: Rect, b: Rect) -> bool {
	// Axis-aligned overlap check in UI space.
	if a.max.x <= b.min.x return false;
	if a.min.x >= b.max.x return false;
	if a.max.y <= b.min.y return false;
	if a.min.y >= b.max.y return false;
	return true;
}

rr_draw_task_marker_on_minimap :: proc(map_rect: Rect, world_pos: v2, color: v4) {
	p_ui := rr_minimap_world_to_ui(map_rect, world_pos);
	size := map_rect->height() * 0.022;
	if size < 10.0 { size = 10.0; }
	if size > 26.0 { size = 26.0; }

	icon := get_asset(Texture_Asset, "sprites/task_icon.png");
	r := Rect{p_ui, p_ui}->grow_unscaled(size, size, size, size);
	if icon != null {
		UI.quad(r->fit_aspect(icon->get_aspect()), icon, color);
	} else {
		UI.quad(r, core_globals.white_sprite, color);
	}
}

// Draw minimap markers for every prop the Pyromaniac can still ignite
// (i.e. props that are not already actively burning).
// Returns one of 12 vivid hues by sequential index (mod 12).
// Hues span the blue-green-purple-magenta arc, avoiding yellow/orange/red
// so they don't clash with the "burning" red flash or "fully burned" deep-orange.
rr_pyro_room_color :: proc(idx: int) -> v4 {
	switch idx % 12 {
		case 0:  return v4.{0.0,  1.0,  0.15, 1.0}; // pure green      (~120°)
		case 1:  return v4.{0.0,  0.9,  0.3,  1.0}; // mint green      (~140°)
		case 2:  return v4.{0.0,  0.85, 0.75, 1.0}; // teal            (~175°)
		case 3:  return v4.{0.0,  0.8,  1.0,  1.0}; // cyan            (~195°)
		case 4:  return v4.{0.0,  0.55, 1.0,  1.0}; // sky blue        (~210°)
		case 5:  return v4.{0.15, 0.5,  1.0,  1.0}; // cornflower      (~220°)
		case 6:  return v4.{0.1,  0.15, 1.0,  1.0}; // blue            (~240°)
		case 7:  return v4.{0.55, 0.1,  1.0,  1.0}; // violet          (~265°)
		case 8:  return v4.{0.5,  0.3,  1.0,  1.0}; // lavender        (~270°)
		case 9:  return v4.{0.85, 0.0,  1.0,  1.0}; // purple          (~290°)
		case 10: return v4.{1.0,  0.1,  0.65, 1.0}; // magenta         (~320°)
		case:    return v4.{1.0,  0.05, 0.45, 1.0}; // hot pink/rose   (~340°)
	}
}

rr_draw_pyro_prop_markers_on_minimap :: proc(player: Player, map_rect: Rect) {
	if player == null return;
	if world_references == null return;

	icon        := get_asset(Texture_Asset, "sprites/pyro_task_icon.png");
	icon_fire   := get_asset(Texture_Asset, "sprites/pyro_task_icon_fire.png");
	burned_col  := v4.{1.0, 0.15, 0.0, 1.0}; // deep orange-red for fully burned rooms

	// Pulsing red for props that are currently burning (room not yet fully burned).
	flash_alpha := sin(get_time() * 7.0) * 0.4 + 0.6; // oscillates 0.2–1.0
	burning_col := v4.{1.0, 0.08, 0.05, flash_alpha};

	// Assign each room a color by its encounter order in entity_iterator().
	// entity_iterator() is stable for scene entities, so this is consistent every frame.
	room_idx := 0;

	foreach e: entity_iterator() {
		if e == null continue;
		if !#alive(e) continue;
		if e->get_name() != "Props" continue;

		// Only show rooms that have Min/Max bounds markers (eligible for fire).
		has_bounds := false;
		bounds_check := e.first_child;
		while bounds_check != null {
			if #alive(bounds_check) {
				bc_name := bounds_check->get_name();
				if bc_name == "MIN" || bc_name == "MAX" {
					has_bounds = true;
					break;
				}
			}
			bounds_check = bounds_check.next_sibling;
		}
		if !has_bounds continue;

		// Only show rooms that are part of the pyro's current objectives on the map.
		is_objective_room := false;
		for ti: 0..player.active_tasks.elements.count-1 {
			t := player.active_tasks.elements[ti];
			if t == null continue;
			if t.#type != RR_Pyro_Room_Task continue;
			rt := t.(RR_Pyro_Room_Task);
			if rt.room_entity == e {
				is_objective_room = true;
				break;
			}
		}
		if !is_objective_room continue;

		room_state   := e->get_component(RR_Pyro_Room_Fire_State);
		fiery_locked := room_state != null && room_state.fiery_locked;

		room_col: v4;
		if fiery_locked {
			room_col = burned_col;
		} else {
			room_col = rr_pyro_room_color(room_idx);
		}
		room_idx += 1;

		// Walk direct children; only actual props carry a Sprite_Renderer here.
		child := e.first_child;
		while child != null {
			next := child.next_sibling;

			if #alive(child) {
				sprite := child->get_component(Sprite_Renderer);
				if sprite != null {
					col: v4;

					if fiery_locked {
						col = burned_col;
					} else {
						fire := child->get_component(RR_Prop_Fire_Target);
						if fire != null && fire.active {
							// Prop is actively burning: flash red.
							col = burning_col;
						} else {
							// Prop is unlit: use this room's unique color.
							col = room_col;
						}
					}

					p_ui := rr_minimap_world_to_ui(map_rect, child.world_position);
					size := map_rect->height() * 0.022;
					if size < 10.0 { size = 10.0; }
					if size > 26.0 { size = 26.0; }

					r := Rect{p_ui, p_ui}->grow_unscaled(size, size, size, size);
					if icon != null {
						UI.quad(r->fit_aspect(icon->get_aspect()), icon, col);
					} else {
						UI.quad(r, core_globals.white_sprite, col);
					}
					// Fire overlay on top, uncolored.
					if icon_fire != null {
						UI.quad(r->fit_aspect(icon_fire->get_aspect()), icon_fire, v4.{1.0, 1.0, 1.0, 1.0});
					}
				}
			}

			child = next;
		}
	}
}

rr_draw_task_markers_on_minimap :: proc(player: Player, map_rect: Rect) {
	if player == null return;
	if !player->is_local() return;

	// Pyromaniac: show all igniteable prop locations with the pyro icon.
	if player.player_role == Player_Role.PYROMANIAC {
		rr_draw_pyro_prop_markers_on_minimap(player, map_rect);
		return;
	}

	if rr_power_outage_active && player.player_type != Player_Type.TRAITOR {
		rr_draw_task_marker_on_minimap(map_rect, rr_get_power_outage_generator_pos(), v4.{1.0, 0.3, 0.3, 1.0});
		return;
	}

	if rr_comms_outage_active && player.player_type != Player_Type.TRAITOR {
		if world_references != null && world_references.rr_comms_lever_entity != null && #alive(world_references.rr_comms_lever_entity) {
			rr_draw_task_marker_on_minimap(map_rect, world_references.rr_comms_lever_entity.world_position, v4.{1.0, 0.3, 0.3, 1.0});
		}
		return;
	}

	is_civilian_like := player.player_type == Player_Type.CIVILIAN ||
		player.player_role == Player_Role.PRANKSTER ||
		player.player_role == Player_Role.PYROMANIAC ||
		player.werewolf_infected;

	if is_civilian_like {
		// Civilians see only their own incomplete task destinations.
		for t: 0..player.active_tasks.elements.count-1 {
			task := player.active_tasks.elements[t];
			if task == null continue;
			if task.completed || task.started continue;

			rr_refresh_task_destinations_for_task(task);

			for d: 0..task.destinations.elements.count-1 {
				rr_draw_task_marker_on_minimap(map_rect, task.destinations.elements[d], v4.{1, 1, 1, 1});
			}
		}
	} else {
		// Non-civilians see ALL task locations to help identify where players might be.
		for i: 0..rr_task_destination_entries.elements.count-1 {
			e := rr_task_destination_entries.elements[i];
			if e == null continue;
			rr_draw_task_marker_on_minimap(map_rect, e.pos, v4.{1, 1, 1, 1});
		}
	}
}

update_minimap_ui :: proc(player: Player) {
	// Allow minimap during voting and for ghosts (after reveal).
	if game_state != Game_State.INGAME && game_state != Game_State.VOTING {
		player.show_minimap = false;
		return;
	}

	is_alive := player.player_state == Player_State.ALIVE;
	is_ghost := player.player_state == Player_State.DEAD;
	if !is_alive && !is_ghost {
		player.show_minimap = false;
		return;
	}

	// Don't show the minimap while a living player is in a task attempt.
	// (Ghosts can always use the map; voting can always use the map.)
	if game_state == Game_State.INGAME && is_alive && player->has_task_in_progress() {
		player.show_minimap = false;
		return;
	}

	safe := UI.get_safe_screen_rect();

	// Top-right "MAP" button
	// Keep minimap UI above the comms "deaf" icons (layer 5200).
	UI.push_layer(5600);
	defer UI.pop_layer();
	
	// Map button should be about the same size as the role icon.
	MAP_HALF_SIZE :: 55.0; // role icon uses 50.0
	MAP_PAD_X :: 20;
	MAP_PAD_Y :: 250;
	btn_center := safe->top_right_rect()->offset(-MAP_HALF_SIZE - MAP_PAD_X, -MAP_HALF_SIZE - MAP_PAD_Y);
	btn_rect := btn_center->grow(MAP_HALF_SIZE);

	if game_state == Game_State.INGAME && player->is_chat_open() {
		// Mirror `update_tasks_ui` panel layout (see `scripts/tasks.csl`).
		should_show_task_panel := false;
		if rr_power_outage_active || rr_comms_outage_active {
			should_show_task_panel = true;
		} else {
			// Normal tasks/objectives.
			if !player.is_temporarily_resurrected {
				is_civilian_like := player.player_type == Player_Type.CIVILIAN ||
					player.player_role == Player_Role.PRANKSTER ||
					player.player_role == Player_Role.PYROMANIAC ||
					player.werewolf_infected;
				if is_civilian_like && player.active_tasks.elements.count > 0 {
					// Dead non-civilians don't get the task panel.
					if player.player_state == Player_State.ALIVE || player.player_type == Player_Type.CIVILIAN {
						should_show_task_panel = true;
					}
				}
			}
		}

		layout_safe := safe;

		// Always consider the civilian progress bar overlap (it is always visible).
		{
			PANEL_W :: 300.0;
			PROGRESS_H :: 52.0;
			HEADER_H :: 36.0;
			PROGRESS_EXTRA_W :: 120.0;
			PANEL_Y_OFFSET :: -20.0;

			panel_anchor := layout_safe->cut_left(PANEL_W)->inset(350, 0, 300, 20)->top_left_rect()->offset(0.0, PANEL_Y_OFFSET);
			header_rect := panel_anchor->grow(0.0, PANEL_W, HEADER_H, 0.0);
			progress_rect := header_rect->top_left_rect()->offset(0.0, 48.0)->grow(0.0, PANEL_W + PROGRESS_EXTRA_W, PROGRESS_H, 0.0);

			if rr_rects_overlap(btn_rect, progress_rect) {
				btn_rect = btn_rect->offset(295.0, -54.0);
			}
		}

		if should_show_task_panel {
			task_panel_rect: Rect;
			if rr_power_outage_active || rr_comms_outage_active {
				task_panel_rect = layout_safe->cut_left(320)->inset(250, 0, 250, 10);
			} else {
				// Mirror `update_tasks_ui` layout for overlap checks.
				PANEL_W :: 300.0;
				HEADER_H :: 36.0;
				ROW_H :: 32.0;
				LIST_PAD :: 10.0;
				PROGRESS_EXTRA_W :: 120.0;
				PANEL_Y_OFFSET :: -20.0;

				list_h := (player.active_tasks.elements.count.(float)) * ROW_H + (LIST_PAD * 2.0);
				panel_anchor := layout_safe->cut_left(PANEL_W)->inset(350, 0, 300, 20)->top_left_rect()->offset(0.0, PANEL_Y_OFFSET);

				header_rect := panel_anchor->grow(0.0, PANEL_W, HEADER_H, 0.0);
				list_rect := header_rect->bottom_left_rect()->grow(0.0, PANEL_W, list_h, 0.0);

				// Bounding box for overlap.
				task_panel_rect = Rect{
					v2.{panel_anchor.min.x, list_rect.min.y},
					v2.{panel_anchor.min.x + PANEL_W + PROGRESS_EXTRA_W, header_rect.max.y}
				};
			}

			if rr_rects_overlap(btn_rect, task_panel_rect) {
				btn_rect = btn_rect->offset(295.0, -54.0);
			}
		}

		// Role-specific panels (hitman/pirate/werewolf) use task-list style panels.
		if player.player_state == Player_State.ALIVE {
			PANEL_W :: 300.0;
			HEADER_H :: 36.0;
			ROW_H :: 32.0;
			LIST_PAD :: 10.0;
			PANEL_Y_OFFSET :: -20.0;

			role_panel_rect: Rect;
			has_role_panel := false;

			if player.player_role == Player_Role.HITMAN {
				row_count := 4;
				list_h := (row_count.(float)) * ROW_H + (LIST_PAD * 2.0);
				panel_anchor := layout_safe->cut_left(PANEL_W)->inset(350, 0, 300, 20)->top_left_rect()->offset(0.0, PANEL_Y_OFFSET);
				header_rect := panel_anchor->grow(0.0, PANEL_W, HEADER_H, 0.0);
				list_rect := header_rect->bottom_left_rect()->grow(0.0, PANEL_W, list_h, 0.0);
				role_panel_rect = Rect{v2.{panel_anchor.min.x, list_rect.min.y}, v2.{panel_anchor.min.x + PANEL_W, header_rect.max.y}};
				has_role_panel = true;
			} else if player.player_role == Player_Role.PIRATE {
				row_count := 3;
				list_h := (row_count.(float)) * ROW_H + (LIST_PAD * 2.0);
				panel_anchor := layout_safe->cut_left(PANEL_W)->inset(350, 0, 300, 20)->top_left_rect()->offset(0.0, PANEL_Y_OFFSET);
				header_rect := panel_anchor->grow(0.0, PANEL_W, HEADER_H, 0.0);
				list_rect := header_rect->bottom_left_rect()->grow(0.0, PANEL_W, list_h, 0.0);
				role_panel_rect = Rect{v2.{panel_anchor.min.x, list_rect.min.y}, v2.{panel_anchor.min.x + PANEL_W, header_rect.max.y}};
				has_role_panel = true;
			} else if player.player_role == Player_Role.WEREWOLF {
				row_count := 4;
				list_h := (row_count.(float)) * ROW_H + (LIST_PAD * 2.0);
				panel_anchor := layout_safe->cut_left(PANEL_W)->inset(350, 0, 300, 20)->top_left_rect()->offset(0.0, PANEL_Y_OFFSET);
				header_rect := panel_anchor->grow(0.0, PANEL_W, HEADER_H, 0.0);
				list_rect := header_rect->bottom_left_rect()->grow(0.0, PANEL_W, list_h, 0.0);
				role_panel_rect = Rect{v2.{panel_anchor.min.x, list_rect.min.y}, v2.{panel_anchor.min.x + PANEL_W, header_rect.max.y}};
				has_role_panel = true;
			}

			if has_role_panel && rr_rects_overlap(btn_rect, role_panel_rect) {
				btn_rect = btn_rect->offset(295.0, -54.0);
			}
		}
	}

	UI.push_id("minimap_toggle");
	defer UI.pop_id();

	// Tab key toggle (raw input, works regardless of UI layers).
	if player.device_kind == .PC && get_input_down(Input.TAB, true) {
		player.show_minimap = !player.show_minimap;
	}

	map_icon := get_asset(Texture_Asset, "sprites/icons/map_icon.png");
	btn_bs: Button_Settings = .{};
	rr_ui_apply_button_click_sound(ref btn_bs);
	interact := UI.button(btn_rect, btn_bs, .{}, ""); // no background; icon is the button
	if map_icon != null {
		icon_rect := btn_rect->inset(4);
		UI.quad(icon_rect->fit_aspect(map_icon->get_aspect()), map_icon, v4.{1, 1, 1, 1});
	} else {
		// Fallback
		ts := UI.default_text_settings();
		ts.size = 30;
		ts.halign = .CENTER;
		ts.valign = .CENTER;
		UI.text(btn_rect, ts, "MAP");
	}
	if interact.clicked {
		player.show_minimap = !player.show_minimap;
	}

	if !player.show_minimap {
		return;
	}

	// Fullscreen modal with the map image
	// Keep minimap modal above the comms "deaf" icons (layer 5200).
	UI.push_layer(5700);
	defer UI.pop_layer();

	screen := UI.get_screen_rect();
	bg := get_asset(Texture_Asset, "$AO/white.png");
	UI.quad(screen, bg, v4.{0.0, 0.0, 0.0, 0.75});

	// Tap anywhere on the dark overlay to dismiss the map (drawn first so map
	// buttons drawn later take priority for clicks).
	{
		UI.push_id("minimap_dismiss");
		defer UI.pop_id();
		dismiss_bs: Button_Settings = .{};
		dismiss_bs.sprite = core_globals.white_sprite;
		dismiss_bs.color = v4.{0, 0, 0, 0};
		dismiss_bs.hovered_color = v4.{0, 0, 0, 0};
		dismiss_bs.pressed_color = v4.{0, 0, 0, 0};
		dismiss_bs.background_color_multiplier = v4.{0, 0, 0, 0};
		if UI.button(screen, dismiss_bs, .{}, "").clicked {
			player.show_minimap = false;
		}
	}

	map_tex := get_asset(Texture_Asset, "sprites/map.png");
	content := screen->inset(40.0, 80.0, 120.0, 80.0);
	map_rect := content->fit_aspect(map_tex->get_aspect());
	UI.quad(map_rect, map_tex, v4.{1, 1, 1, 1});

	// Local player marker
	{
		p_ui := rr_minimap_world_to_ui(map_rect, player.entity.world_position);
		dot_size := map_rect->height() * 0.018;
		if dot_size < 10.0 { dot_size = 10.0; }
		if dot_size > 22.0 { dot_size = 22.0; }
		dot := Rect{p_ui, p_ui}->grow_unscaled(dot_size, dot_size, dot_size, dot_size);
		player_icon := get_asset(Texture_Asset, "sprites/tasks/cypher/icons/icon_schleem.png");
		if player_icon != null {
			UI.quad(dot->fit_aspect(player_icon->get_aspect()), player_icon, v4.{1, 1, 1, 0.95});
		} else {
			// Fallback if the asset is missing.
			UI.quad(dot, core_globals.white_sprite, v4.{0.2, 0.9, 0.3, 0.95});
		}
	}

	// Task markers for the local player (when map is open).
	rr_draw_task_markers_on_minimap(player, map_rect);

	// Pirate treasure dig spots (local-only).
	if player->is_local() && player.player_role == Player_Role.PIRATE {
		icon := get_asset(Texture_Asset, "sprites/icons/pirate/dig_for_treasure.png");
		if icon != null {
			size := map_rect->height() * 0.030;
			if size < 14.0 { size = 14.0; }
			if size > 42.0 { size = 42.0; }

			foreach spot: component_iterator(Pirate_Treasure_Dig_Spot) {
				if spot == null continue;
				if spot.owner_player_entity_id != player.entity.id continue;
				if spot.is_dug continue;

				p_ui := rr_minimap_world_to_ui(map_rect, spot.entity.world_position);
				r := Rect{p_ui, p_ui}->grow_unscaled(size, size, size, size);
				UI.quad(r->fit_aspect(icon->get_aspect()), icon, v4.{1, 1, 1, 1});
			}
		}
	}

	// --- Sabotage buttons (traitors only): to the right of the minimap ---
	power_clicked := false;
	comms_clicked := false;
	lockdown_clicked := false;
	rr_draw_sabotages_next_to_minimap(
		player,
		map_rect,
		ref power_clicked,
		ref comms_clicked,
		ref lockdown_clicked,
		rr_comms_outage_active,
		rr_comms_outage_cooldown_ends_at
	);
	if power_clicked {
		rr_try_start_power_outage(player);
	}
	if comms_clicked {
		rr_try_start_comms_outage(player);
	}
	if lockdown_clicked {
		rr_try_start_lockdown(player);
	}

	if draw_minimap_close_button(map_rect) {
		player.show_minimap = false;
	}
}

draw_traitor_sabotage_map_button :: proc(player: Player) {
	if player == null return;
	if !player->is_local_or_server() return;
	if game_state != Game_State.INGAME return;
	if player.player_state != Player_State.ALIVE return;
	if player.player_type != Player_Type.TRAITOR return;

	safe := UI.get_safe_screen_rect();

	SABOTAGE_HALF_SIZE :: 48.0;
	SABOTAGE_PAD :: 18.0;
	ABILITY_STACK_Y_OFFSET :: 420.0;

	center := safe->bottom_right_rect()->offset(-SABOTAGE_HALF_SIZE - SABOTAGE_PAD, SABOTAGE_HALF_SIZE + SABOTAGE_PAD + ABILITY_STACK_Y_OFFSET);
	btn_rect := center->grow(SABOTAGE_HALF_SIZE);

	UI.push_id("sabotage_map");
	defer UI.pop_id();

	bs: Button_Settings = .{};
	rr_ui_apply_button_click_sound(ref bs);
	interact := UI.button(btn_rect, bs, .{}, "");

	icon := get_asset(Texture_Asset, "ui/sabotage.png");
	if icon == null {
		icon = get_asset(Texture_Asset, "sprites/icons/doors_lock.png");
	}
	if icon != null {
		icon_rect := btn_rect->inset(6);
		UI.quad(icon_rect->fit_aspect(icon->get_aspect()), icon, v4.{1, 1, 1, 1});
	}

	label_rect := btn_rect->bottom_center_rect()->offset(0.0, -10.0)->grow(12.0, 80.0, 12.0, 80.0);
	label_ts := UI.default_text_settings();
	label_ts.size = 22;
	label_ts.color = v4.{1, 1, 1, 1};
	label_ts.halign = .CENTER;
	label_ts.valign = .CENTER;
	label_ts.do_outline = true;
	label_ts.outline_thickness = 2;
	label_ts.outline_color = v4.{0, 0, 0, 1};
	UI.text(label_rect, label_ts, "Sabotage");

	if interact.clicked {
		player.show_minimap = true;
	}
}

// --- Pirate treasure guidance (local-only arrows + cleanup) ---

rr_find_nearest_pirate_dig_spot_pos :: proc(player: Player) -> v2, bool {
	if player == null return {}, false;

	best_dist_sq := 0.0;
	best_pos: v2;
	found := false;

	foreach spot: component_iterator(Pirate_Treasure_Dig_Spot) {
		if spot == null continue;
		if spot.owner_player_entity_id != player.entity.id continue;
		if spot.is_dug continue;

		d := spot.entity.world_position - player.entity.world_position;
		dist_sq := length_squared(d);
		if !found || dist_sq < best_dist_sq {
			best_dist_sq = dist_sq;
			best_pos = spot.entity.world_position;
			found = true;
		}
	}

	return best_pos, found;
}

rr_draw_pirate_treasure_guidance_if_needed :: proc(player: Player) {
	if player == null return;
	if !player->is_local() return;
	if game_state != Game_State.INGAME return;
	if player.player_state != Player_State.ALIVE return;
	if player.player_role != Player_Role.PIRATE return;

	target_pos, ok := rr_find_nearest_pirate_dig_spot_pos(player);
	if !ok return;

	dirt_texture := get_asset(Texture_Asset, PIRATE_DIRT_PILE_TEXTURE_PATH);
	if dirt_texture == null {
		dirt_texture = get_asset(Texture_Asset, PIRATE_DIRT_PILE_FALLBACK_TEXTURE_PATH);
	}
	if dirt_texture != null {
		UI.push_world_draw_context();
		defer UI.pop_draw_context();
		UI.push_z(target_pos.y);
		defer UI.pop_z();

		// Local-only marker at the active dig spot so pirates can quickly identify it.
		dirt_pos := target_pos + v2.{0.0, -0.08};
		dirt_rect := Rect{dirt_pos, dirt_pos}->grow(0.58, 0.38, 0.58, 0.38);
		pulse := 0.9 + 0.1 * sin(get_time() * 4.0);
		UI.quad(dirt_rect->fit_aspect(dirt_texture->get_aspect()), dirt_texture, v4.{1, 1, 1, pulse});
	}

	tutorial_arrow_options := Tutorial_Arrow.default_options();
	tutorial_arrow_options.far = true;
	tutorial_arrow_options.near = true;
	tutorial_arrow_options.bob_scale = 0.5;
	tutorial_arrow_options.bob_bias = 1.5;

	dist := length(player.entity.world_position - target_pos);
	tutorial_arrow_options.alpha = clamp(1.0 - (dist - 3.0) / 22.0, 0.25, 1.0);
	rr_draw_tutorial_arrow(player, target_pos, tutorial_arrow_options);
}

destroy_pirate_dig_spots_for_player :: proc(player_entity_id: u64) {
	to_destroy: List(Entity);
	foreach spot: component_iterator(Pirate_Treasure_Dig_Spot) {
		if spot == null continue;
		if spot.owner_player_entity_id != player_entity_id continue;
		append(ref to_destroy, spot.entity);
	}

	for i: 0..to_destroy.elements.count-1 {
		e := to_destroy.elements[i];
		if #alive(e) {
			e->destroy();
		}
	}
}

// --- Door Unlock Interactable: per-player update ---
// Creates the interactable entity if needed, then repositions it to the nearest
// closed door each frame. When no closed door is nearby the entity is parked
// off-screen so the engine won't show a prompt.
rr_update_door_unlock_interactable :: proc(player: Player) {
	if player == null return;
	if !#alive(player.entity) return;

	// Lazy-create the entity + component once.
	if player.door_unlock_entity == null || !#alive(player.door_unlock_entity) {
		player.door_unlock_entity = Scene.create_entity();
		player.door_unlock_entity->set_local_position(v2.{-9999, -9999});
		player.door_unlock_interactable = player.door_unlock_entity->add_component(Door_Unlock_Interactable);
		player.door_unlock_interactable.owner_player = player;
	}

	interactable := player.door_unlock_interactable;
	if interactable == null return;

	// Only snap to doors during active gameplay.
	if game_state != Game_State.INGAME || player.player_state != Player_State.ALIVE {
		interactable.target_door = null;
		player.door_unlock_entity->set_local_position(v2.{-9999, -9999});
		return;
	}

	// Find the nearest closed door within search radius.
	player_pos := player.entity.world_position;
	best_door: Door = null;
	best_dist_sq := DOOR_UNLOCK_SEARCH_RADIUS * DOOR_UNLOCK_SEARCH_RADIUS;

	foreach door: component_iterator(Door) {
		if door == null continue;
		if !#alive(door.entity) continue;
		if door.is_open continue;

		dist_sq := length_squared(door.entity.world_position - player_pos);
		if dist_sq < best_dist_sq {
			best_dist_sq = dist_sq;
			best_door = door;
		}
	}

	if best_door != null {
		interactable.target_door = best_door;
		player.door_unlock_entity->set_local_position(best_door.entity.world_position);
	} else {
		interactable.target_door = null;
		player.door_unlock_entity->set_local_position(v2.{-9999, -9999});
	}
}

rr_cleanup_door_unlock_interactable :: proc(player: Player) {
	if player == null return;
	if player.door_unlock_entity != null && #alive(player.door_unlock_entity) {
		player.door_unlock_entity->destroy();
	}
	player.door_unlock_entity = null;
	player.door_unlock_interactable = null;
}

